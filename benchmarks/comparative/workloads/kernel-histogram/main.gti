extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}

int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed();
  bench_begin();
  mut uint64_t digest = 0;
  mut uint64_t bins[256] = {};
  mut uint64_t x = seed;
  for (mut uint64_t i = 0; i < rounds * 100000; i++) {
    x = (x * 48271) % 2147483647;
    bins[x % 256]++;
  }
  for (mut int i = 0; i < 256; i++) {
    digest += bins[i] * uint64_t(i + 1);
  }
  bench_end(digest);
  return 0;
}
