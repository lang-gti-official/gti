extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}

int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed();
  bench_begin();
  mut uint64_t digest = 0;
  mut uint64_t a[4096] = {};
  mut uint64_t b[4096] = {};
  for (mut int i = 0; i < 4096; i++) {
    a[i] = (uint64_t(i) + seed) % 251;
  }
  for (mut uint64_t r = 0; r < rounds * 32; r++) {
    for (mut int i = 1; i < 4095; i++) {
      b[i] = (a[i - 1] + a[i] + a[i + 1]) / 3;
    }
    for (mut int i = 1; i < 4095; i++) {
      a[i] = b[i];
    }
  }
  for (mut int i = 0; i < 4096; i++) {
    digest += a[i];
  }
  bench_end(digest);
  return 0;
}
