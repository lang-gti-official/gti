extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}
uint64_t step(uint64_t x) { return (x * 31 + 7) % 1000000007; }
int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed();
  bench_begin();
  mut uint64_t digest = 0;
  mut uint64_t x = seed;
  for (mut uint64_t i = 0; i < rounds * 100000; i++) {
    x = step(step(x) + i % 17);
  }
  digest = x;
  bench_end(digest);
  return 0;
}
