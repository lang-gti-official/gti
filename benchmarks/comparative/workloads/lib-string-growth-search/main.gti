import std.string;
extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}

int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed() % uint64_t(65536);
  mut uint64_t digest = 0;
  bench_begin();
  for (mut uint64_t round = 0; round < rounds; round++) {
    std::string_view alphabet = "abcdefghijklmnopqrstuvwxyz";
    mut std::string text{};
    for (mut int32_t i = 0; i < 65536; i++) {
      text.push_back(alphabet[std::size_t(
          (uint64_t(i) * uint64_t(7) + seed + round) % uint64_t(26))]);
    }
    mut std::size_t position = text.find('q');
    while (position != std::string::npos) {
      digest += uint64_t(position);
      position = text.find('q', position + std::size_t(1));
    }
    digest += uint64_t(text.size());
  }
  bench_end(digest);
  return 0;
}
