import std.algorithm;
import std.vector;
extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}

int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed() % uint64_t(65536);
  mut uint64_t digest = 0;
  bench_begin();
  for (mut uint64_t round = 0; round < rounds; round++) {
    mut std::vector<uint64_t> values{};
    values.reserve(std::size_t(32768));
    for (mut int32_t i = 0; i < 32768; i++) {
      values.push_back(uint64_t(32768 - i) + seed + round);
    }
    std::sort(values);
    for (mut std::size_t i = 0; i < values.size(); i++) {
      digest +=
          (values[i] * (uint64_t(i) + uint64_t(1))) % uint64_t(1000000007);
    }
  }
  bench_end(digest);
  return 0;
}
