import std.atomic;
extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}

int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed() % uint64_t(65536);
  mut uint64_t digest = 0;
  bench_begin();
  for (mut uint64_t round = 0; round < rounds; round++) {
    std::atomic<uint64_t> value{seed + round};
    for (mut int32_t i = 0; i < 1000000; i++) {
      digest +=
          value.fetch_add_wrapping(uint64_t(1), std::memory_order_relaxed());
    }
    digest += value.load(std::memory_order_relaxed());
  }
  bench_end(digest);
  return 0;
}
