import std.memory;
import std.vector;
extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}

int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed() % uint64_t(65536);
  mut uint64_t digest = 0;
  bench_begin();
  for (mut uint64_t round = 0; round < rounds; round++) {
    mut std::vector<std::unique_ptr<uint64_t>> values{};
    values.reserve(std::size_t(8192));
    for (mut int32_t i = 0; i < 8192; i++) {
      values.push_back(std::make_unique<uint64_t>((uint64_t(i) + seed + round) %
                                                  uint64_t(65521)));
    }
    for (std::unique_ptr<uint64_t> &value : values) {
      digest += *value;
    }
  }
  bench_end(digest);
  return 0;
}
