import std.optional;
extern "C" {
uint64_t bench_rounds();
uint64_t bench_seed();
void bench_begin();
void bench_end(uint64_t digest);
}
std::optional<int32_t> lookup(int32_t index) {
  if (index % 4 == 0)
    return std::optional<int32_t>();
  return std::optional<int32_t>(index);
}
int main() {
  uint64_t rounds = bench_rounds();
  uint64_t seed = bench_seed() % uint64_t(65536);
  mut uint64_t digest = 0;
  bench_begin();
  for (mut uint64_t round = 0; round < rounds; round++) {
    for (mut int32_t i = 0; i < 1000000; i++) {
      auto value =
          lookup(int32_t((uint64_t(i) + seed + round) % uint64_t(1000003)));
      if (value.has_value()) {
        digest += uint64_t(value.value());
      }
    }
  }
  bench_end(digest);
  return 0;
}
