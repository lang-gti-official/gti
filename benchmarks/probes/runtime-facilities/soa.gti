#include <std/vector>
void output(std::vector<int32_t>& state) {
  // Publish every final lane, not merely a success predicate.
  for (auto& value : state) { std::println(value); }
}
int32_t step(int32_t value, int32_t bias) {
  return (value * 17 + bias) % 65521;
}
void update(mut std::vector<int32_t>& state, std::vector<int32_t>& bias) {
  for (mut std::size_t i = 0; i < state.size(); i++) { state[i] = step(state[i], bias[i]); }
}
int main() {
  mut std::vector<int32_t> state = std::vector<int32_t>(std::size_t(1024));
  mut std::vector<int32_t> bias = std::vector<int32_t>(std::size_t(1024));
  for (mut std::size_t i = 0; i < state.size(); i++) { state[i] = int32_t(i); bias[i] = int32_t(i % std::size_t(127)); }
  for (mut int32_t tick = 0; tick < 240000; tick++) { update(state, bias); }
  output(state);
  return 0;
}
