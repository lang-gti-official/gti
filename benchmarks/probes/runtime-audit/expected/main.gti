import std.string;
enum class parse_error { invalid };
expected<int32_t, parse_error> digit(int32_t code) {
  if (code < 48 || code > 57) { return unexpected(parse_error::invalid); }
  return code - 48;
}
expected<int32_t, parse_error> two_digits(int32_t high, int32_t low) {
  int32_t first = ?digit(high);
  int32_t second = ?digit(low);
  return first * 10 + second;
}
int main() {
  mut int64_t total = 0;
  mut int64_t errors = 0;
  for (mut int32_t i = 0; i < 100000000; i++) {
    int32_t high = 48 + i % 11;
    int32_t low = 48 + (i / 11) % 10;
    auto parsed = two_digits(high, low);
    if (parsed.has_value()) { total += int64_t(parsed.value()); } else { errors++; }
  }
  std::print("checksum ");
  std::println(std::to_string(total + errors));
  return 0;
}
