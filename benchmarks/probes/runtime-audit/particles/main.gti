#include <std/string>
#include <std/vector>
struct particle {
  mut float x;
  mut float y;
  mut float vx;
  mut float vy;
  particle(float x, float y, float vx, float vy) : x(x), y(y), vx(vx), vy(vy) {}
};
int main() {
  mut std::vector<particle> particles{};
  for (mut int32_t i = 0; i < 100000; i++) {
    float f = float(i % 100);
    particles.push_back(particle(f, f * 0.5, 1.0, -0.5));
  }
  for (mut int32_t frame = 0; frame < 2000; frame++) {
    for (mut particle& p : particles) {
      p.vy += 0.01;
      p.x += p.vx * 0.016;
      p.y += p.vy * 0.016;
      if (p.y > 100.0) { p.vy = -p.vy * 0.5; }
    }
  }
  mut double total = 0.0d;
  for (particle& p : particles) { total += double(p.x) + double(p.y); }
  std::print("checksum ");
  std::println(std::to_string(int64_t(total)));
  return 0;
}
