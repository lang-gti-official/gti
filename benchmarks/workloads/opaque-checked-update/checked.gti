import "kernel.gti";
import std.string;
import std.vector;

int main(int argc, std::vector<std::string> argv) {
  mut int32_t value = argc;
  for (mut int32_t round = 0; round < 50000000; round++) {
    value = (value + argc) % 1000003;
    value = (value + argc) % 1000003;
    value = (value + argc) % 1000003;
    value = (value + argc) % 1000003;
  }
  return finish(uint64_t(value));
}
