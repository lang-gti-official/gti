#include <std/string>

constexpr int32_t image_width = 1000;
constexpr int32_t image_height = 700;
constexpr int32_t maximum_iterations = 600;

int32_t escape_iterations(double coordinate_real,
                          double coordinate_imaginary) {
  mut double value_real = 0.0d;
  mut double value_imaginary = 0.0d;
  mut int32_t iteration = 0;

  while (iteration < maximum_iterations) {
    double real_squared = value_real * value_real;
    double imaginary_squared = value_imaginary * value_imaginary;
    if (real_squared + imaginary_squared > 4.0d) {
      break;
    }

    double next_imaginary =
        2.0d * value_real * value_imaginary + coordinate_imaginary;
    value_real = real_squared - imaginary_squared + coordinate_real;
    value_imaginary = next_imaginary;
    iteration++;
  }
  return iteration;
}

uint64_t render_checksum() {
  mut uint64_t checksum = uint64_t(0);
  for (mut int32_t pixel_y = 0; pixel_y < image_height; pixel_y++) {
    double coordinate_imaginary =
        (double(pixel_y) / double(image_height)) * 2.4d - 1.2d;
    for (mut int32_t pixel_x = 0; pixel_x < image_width; pixel_x++) {
      double coordinate_real =
          (double(pixel_x) / double(image_width)) * 3.5d - 2.5d;
      int32_t iterations =
          escape_iterations(coordinate_real, coordinate_imaginary);
      uint64_t column_weight =
          uint64_t((pixel_x % int32_t(251)) + int32_t(1));
      uint64_t row_tag =
          uint64_t((pixel_y % int32_t(257)) + int32_t(1));
      checksum += uint64_t(iterations) * column_weight + row_tag;
    }
  }
  return checksum;
}

void print_hex_digit(uint64_t digit) {
  switch (digit) {
  case uint64_t(0): std::print("0"); break;
  case uint64_t(1): std::print("1"); break;
  case uint64_t(2): std::print("2"); break;
  case uint64_t(3): std::print("3"); break;
  case uint64_t(4): std::print("4"); break;
  case uint64_t(5): std::print("5"); break;
  case uint64_t(6): std::print("6"); break;
  case uint64_t(7): std::print("7"); break;
  case uint64_t(8): std::print("8"); break;
  case uint64_t(9): std::print("9"); break;
  case uint64_t(10): std::print("a"); break;
  case uint64_t(11): std::print("b"); break;
  case uint64_t(12): std::print("c"); break;
  case uint64_t(13): std::print("d"); break;
  case uint64_t(14): std::print("e"); break;
  case uint64_t(15): std::print("f"); break;
  default: std::print("?"); break;
  }
}

void print_digest(uint64_t digest) {
  mut uint64_t divisor = 0x1000000000000000;
  while (divisor > 0) {
    print_hex_digit((digest / divisor) % uint64_t(16));
    divisor /= uint64_t(16);
  }
}

int main() {
  uint64_t checksum = render_checksum();
  if (checksum != uint64_t(10183699723)) {
    return 1;
  }
  std::print("GTI-BENCH-1 digest:");
  print_digest(checksum);
  std::println(" work-units:700000");
  return 0;
}
