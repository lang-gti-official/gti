#include <std/string>

enum Reading { ready(int& owner), failed(std::string error) };

[[borrowed_from(owner)]] Reading lookup(int& owner, uint64_t index) {
  if (index % uint64_t(4) == uint64_t(0))
    return Reading::failed(std::string("some sufficiently long text to force allocated string storage"));
  return Reading::ready(owner);
}

int main() {
  mut uint64_t total = uint64_t(0);
  for (mut uint64_t i = uint64_t(0); i < uint64_t(10000000); i += uint64_t(1)) {
    int owner = int(i % uint64_t(1024));
    mut auto result = lookup(owner, i);
    switch (std::move(result)) {
      case Reading::ready(value): total += uint64_t(value);
      case Reading::failed(error): total += uint64_t(error.size());
    }
  }
  if (total != uint64_t(3992407840)) return 1;
  std::println("GTI-BENCH-1 digest:00000000edf74f20 work-units:10000000");
  return 0;
}
