T maximum<std::ordered T>(T left, T right) {
  if (left > right && right != left or left == right || false and true) {
    return left;
  } else {
    return right;
  }
}

void relay<Args...>(Args... values) {
  for (mut uint64_t index = 0; index < 1; index++) {
    consume(values...);
  }
}

enum class State : uint8_t {
  idle,
  running = 4,
};

State state = State::running;

int classify(State value) {
  switch (value) {
  case State::idle:
    return 0;
  default:
    return 1;
  }
}

[[no_transfer, unsafe_share]] class Counter {
  int value = 0;
public:
  int read() { int self = 1; return this.value + self; }
};

Counter counter{};

static int file_value = 1;

class Registry {
public:
  static mut int count = 0;
  static int current() { return count; }
};

mut uint32_t pixels[64 * (0x20 + 0b10)] = {};

class Fixed<T, uint64_t N> {};
class LegacyFixed<T, uint64 N> {};

interface Renderable {
  int render(int frame);
};

class Base {
public:
  Base(int value) {}
  virtual int tick(int frame) { return frame; }
};

class Sprite : public Base, public Renderable {
public:
  Sprite(int value) : Base(value) {}
  int tick(int frame) override { return frame; }
  int render(int frame) override { return this.tick(frame); }
};

class Iterator {
  mut int value = 0;
public:
  int& operator*() { return this.value; }
  void operator++() mut { this.value++; }
  bool operator!=(Iterator& other) { return this.value != other.value; }
};

class Range {
public:
  Iterator begin() { return Iterator(); }
  Iterator end() { return Iterator(); }
};

int sum(Range& values) {
  mut int result = 0;
  for (auto& value : values) {
    result += value;
  }
  return result;
}

class LifecycleValue {
public:
  LifecycleValue(LifecycleValue& other) = default;
  LifecycleValue(LifecycleValue&& other) = delete;
};

#if target.os == "unsupported"
#error "Unsupported target."
#endif

#include <std/array>

int decompose(Pair value) {
  auto [first, second] = value;
  return first;
}

concept sortable<T> = std::totally_ordered<T> && std::movable<T>;

T choose_lower<sortable T>(T left, T right) {
  return left;
}

void poll() {
  do {
    tick();
  } while (ready());
}

int choose(bool condition, int left, int right) {
  return condition ? left : right;
}

void compound(mut int value) {
  value *= 2;
  value /= 2;
  value %= 3;
  value &= 1;
  value |= 2;
  value ^= 3;
  value <<= 1;
  value >>= 1;
}

extern "C" {
  int32_t native_close(int32_t descriptor);
}

int invoke_native_close(int32_t descriptor) {
  return native_close(descriptor);
}

void raw(mut uint8_t* writable, const uint8_t* readable) {
  unsafe {
    mut uint8_t* alias = &writable[0];
    *alias = readable[0];
    uint8_t member = writable->value;
  }
}

@compiler_constraint("smoke")
concept compiler_only<T>;

void discard_value() {
  [[discard]] choose_lower<int>(1, 2);
}

constexpr uint64_t compile_extent = 4;

class CompileLimits {
public:
  static constexpr uint64_t count = compile_extent;
  constexpr uint64_t deferred() { return count; }
};

constexpr uint64_t deferred_twice(uint64_t value) { return value * 2; }

int32_t compile_choice() {
  if constexpr (compile_extent == 4) {
    return 1;
  } else {
    return 0;
  }
}

concept compatible<Left, Right> = std::same_pair<Left, Right>;

T constrain<Left, Right>(Left left, Right right)
  requires std::input_iterator<Left>
        && std::sentinel_for<Right, Left>;

constexpr uint64_t scalar_layout = sizeof(int32_t);
constexpr uint64_t pointer_layout = alignof(const uint8_t*);
constexpr double precise_decimal = 0.1d;

[[c_abi]] struct NativePoint {
  float x;
  float y;
};

[[c_opaque]] struct NativeHandle;

class ConsumingCallable {
public:
  int operator()() && { return 1; }
};

int capture_owned(int value) {
  auto operation = [owned = std::move(value)]() -> int { return owned; };
  return operation();
}

union Bits {
  mut uint32_t integer;
  float real;
};

enum class Event {
  idle,
  point(int32_t x, int32_t y),
};

int inspect_event(Event event) {
  switch (event) {
  case Event::idle:
    return 0;
  case Event::point(x, y):
    return x + y;
  }
}

void fold_values<Values...>(Values... values) {
  (consume(values), ...);
}

void call_member_generic<Owner, Base>(Owner& owner) {
  owner.upcast<Base>();
}
