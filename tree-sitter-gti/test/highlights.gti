T maximum<std::ordered T>(T left, T right) {
  if (left > right && right != left or left == right || false and true) {
    return left;
  } else {
    return right;
  }
}

void relay<Args...>(Args... values) {
  for (mut uint64_t index = 0; index < 1; index++) {
    consume(values...);
  }
}

enum class State : uint8_t {
  idle,
  running = 4,
};

State state = State::running;

int classify(State value) {
  switch (value) {
  case State::idle:
    return 0;
  default:
    return 1;
  }
}

class Counter {
  int value = 0;
public:
  int read() { int self = 1; return this.value + self; }
};

Counter counter{};

static int file_value = 1;

class Registry {
public:
  static mut int count = 0;
  static int current() { return count; }
};

mut uint32_t pixels[64 * (0x20 + 0b10)] = {};

class Fixed<T, uint64_t N> {};
class LegacyFixed<T, uint64 N> {};

interface Renderable {
  int render(int frame) = 0;
};

class Base {
public:
  Base(int value) {}
  virtual int tick(int frame) { return frame; }
};

class Sprite : public Base, public Renderable {
public:
  Sprite(int value) : Base(value) {}
  int tick(int frame) override { return frame; }
  int render(int frame) override { return this.tick(frame); }
};

class Iterator {
  mut int value = 0;
public:
  int& operator*() { return this.value; }
  void operator++() mut { this.value++; }
  bool operator!=(Iterator& other) { return this.value != other.value; }
};

class Range {
public:
  Iterator begin() { return Iterator(); }
  Iterator end() { return Iterator(); }
};

int sum(Range& values) {
  mut int result = 0;
  for (auto& value : values) {
    result += value;
  }
  return result;
}
