// C++-familiar API scaffold for <std/cmath>.
// The eventual definitions must specify GTI edge behavior independently of
// whichever native math library the active backend uses.

namespace std {
float abs(float value);

float floor(float value);
float ceil(float value);
float round(float value);
float trunc(float value);

float sqrt(float value);
float cbrt(float value);
float pow(float base, float exponent);
float fmod(float numerator, float denominator);

float exp(float value);
float log(float value);
float log10(float value);

float sin(float value);
float cos(float value);
float tan(float value);
float asin(float value);
float acos(float value);
float atan(float value);
float atan2(float y, float x);

bool isfinite(float value);
bool isinf(float value);
bool isnan(float value);
}
