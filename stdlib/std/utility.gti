// C++-familiar API scaffold for <std/utility>.
// std::move is compiler-defined and implicitly available through the prelude;
// it is intentionally not redeclared here.

namespace std {
  namespace detail {
    // A mutable entry still has an immutable key: changing a stored key would
    // invalidate an ordered tree or hash table's lookup invariant.
    struct map_entry<K, V> {
      K first;
      mut V second;

      map_entry(K key, V value)
          : first(std::move(key)), second(std::move(value)) {}
    };
  }

  struct pair<T, U> {
    mut T first;
    mut U second;

    pair(T first_value, U second_value) : first(std::move(first_value)), second(std::move(second_value)) {}
  };

  pair<T, U> make_pair<T, U>(T first, U second) {
    return pair<T, U>(std::move(first), std::move(second));
  }

  void swap<T>(mut T& left, mut T& right);
  T exchange<T, U>(mut T& object, U new_value);
}
