// C++-familiar API scaffold for <std/utility>.
// std::move is compiler-defined and implicitly available through the prelude;
// it is intentionally not redeclared here.

namespace std {
  concept member_cloneable<T> =
      requires (T& value) { { value.clone() } -> T; };

  concept cloneable<T> = std::member_cloneable<T> || std::copy_constructible<T>;

  /// Explicit duplication: use an exact read-only clone member when present,
  /// otherwise ordinary copy construction. Shared owners retain sharing.
  T clone<T>(T& value) requires std::cloneable<T> {
    if constexpr (requires (T& candidate) { { candidate.clone() } -> T; }) {
      return value.clone();
    } else {
      return value;
    }
  }

  namespace detail {
    // Owning storage record. Its key field is read-only, but an ordinary local
    // record may still be moved or replaced as a whole. Dictionaries therefore
    // never expose a mutable reference to this owning record: mutable cursors
    // publish checked key/mapped projections instead.
    struct map_entry<K, V> {
      K first;
      mut V second;

      map_entry(K key, V value)
          : first(std::move(key)), second(std::move(value)) {}
    };
  }

  struct pair<T, U> {
    mut T first;
    mut U second;

    constexpr pair(T first_value, U second_value) : first(std::move(first_value)), second(std::move(second_value)) {}
  };

  constexpr pair<T, U> make_pair<T, U>(T first, U second) {
    return pair<T, U>(std::move(first), std::move(second));
  }

  /// Exchange disjoint initialized places without copying or running cleanup.
  void swap<T>(mut T& left, mut T& right) requires std::relocatable<T> {
    gti_internal::restoring_swap(left, right);
  }

  /// Prepare the replacement first; return the old value with its ownership.
  T exchange<T>(mut T& object, T new_value) requires std::relocatable<T> {
    T previous = gti_internal::restoring_exchange(object, std::move(new_value));
    return std::move(previous);
  }
}
