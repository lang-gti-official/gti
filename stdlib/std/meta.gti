// <std/meta> -- compile-time reflection over GTI declarations.
//
// A metaobject is an ordinary empty value whose generic arguments are the
// canonical identity of what it describes: `type<T>` for a type and
// `field<T, I>` for instance field `I` of `T` in declaration order. Every
// query is an ordinary method that calls a compiler-private operation on those
// arguments. The compiler folds each answer to a constant as soon as the
// arguments are concrete, so a program that consumes reflection at compile
// time carries no reflection data at run time; a name used at run time is an
// ordinary string literal.
//
// `@compiler_type` binds a class to the compiler by its binding name, never by
// its public spelling: `list` and `field` are the classes the compiler builds
// a field list from, and `field_list`/`field_type` are computed types whose
// concrete instances the compiler rewrites.

namespace gti_internal {
uint64_t meta_field_count<T>();
std::string_view meta_field_name<T, uint64_t I>();
bool meta_field_is_public<T, uint64_t I>();
bool meta_field_has_default<T, uint64_t I>();
std::string_view meta_type_name<T>();
uint64_t meta_type_kind<T>();
uint64_t meta_field_attribute_count<T, uint64_t I>();
bool meta_field_has_attribute<T, A, uint64_t I>();
uint64_t meta_type_attribute_count<T>();
bool meta_type_has_attribute<T, A>();
bool meta_type_trait<T, uint64_t Trait>();
bool meta_type_relation<T, U, uint64_t Relation>();
uint64_t meta_enumerator_count<E>();
std::string_view meta_enumerator_name<E, uint64_t I>();
E meta_enumerator_value<E, uint64_t I>();
uint64_t meta_payload_count<E, uint64_t I>();
std::string_view meta_payload_name<E, uint64_t I, uint64_t P>();
uint64_t meta_base_count<T>();
uint64_t meta_argument_count<T>();
uint64_t meta_method_count<T>();
std::string_view meta_method_name<T, uint64_t I>();
bool meta_method_trait<T, uint64_t I, uint64_t Trait>();
uint64_t meta_method_parameter_count<T, uint64_t I>();
std::string_view meta_parameter_name<T, uint64_t I, uint64_t P>();
uint64_t meta_constructor_count<T>();
uint64_t meta_constructor_parameter_count<T, uint64_t I>();
std::string_view meta_constructor_parameter_name<T, uint64_t I, uint64_t P>();
uint64_t meta_declaration_line<T, uint64_t Kind, uint64_t I>();
std::string_view meta_declaration_file<T>();
std::string_view meta_type_primary_name<T>();
T meta_construct<T, Values...>(Values... values);
}

namespace std {
namespace meta {

/// The categories used by the reflection classification predicates.
enum class kind {
  unknown = 0,
  structure = 1,
  class_type = 2,
  interface_type = 3,
  union_type = 4,
  enumeration = 5,
  integral = 6,
  floating_point = 7,
  boolean = 8,
  character = 9,
  text = 10,
  reference = 11,
  array = 12,
  raw_pointer = 13,
  unique_owner = 14,
  shared_owner = 15,
  callable = 16,
  void_type = 17,
};

/// A finite compile-time sequence of types; `constexpr for` iterates its
/// elements, binding each as a default-constructed value.
@compiler_type("meta_list") struct list<Elements...> {
public:
  constexpr list() {}
};

/// The exact type of instance field `I` of `T`: a computed type the compiler
/// rewrites to the field's type wherever `T` and `I` are concrete, so it can
/// be spelled in any type position.
@compiler_type("meta_field_type") struct field_type<T, uint64_t I> {};

/// `list<field<T, 0>, field<T, 1>, ...>` over the instance fields of `T`, in
/// declaration order; a computed type like `field_type`.
@compiler_type("meta_field_list") struct field_list<T> {};

/// `list<A, B, ...>` over the attribute types applied to instance field `I`
/// of `T`, in application order; a computed type like `field_type`.
@compiler_type("meta_field_attributes") struct field_attributes<T, uint64_t I> {};

/// `list<A, B, ...>` over the attribute types applied to `T` itself.
@compiler_type("meta_type_attributes") struct type_attributes<T> {};

/// `list<enumerator<E, 0>, enumerator<E, 1>, ...>` over the enumerators of
/// `E`, in declaration order; a computed type like `field_list`.
@compiler_type("meta_enumerator_list") struct enumerator_list<E> {};

/// `list<payload_field<E, I, 0>, ...>` over the payload fields of enumerator
/// `I` of `E`; empty for an integral enumerator.
@compiler_type("meta_payload_list") struct payload_list<E, uint64_t I> {};

/// The exact type of payload field `P` of enumerator `I` of `E`.
@compiler_type("meta_payload_type") struct payload_type<E, uint64_t I, uint64_t P> {};

/// `list<type<B>, ...>` over the direct bases of `T`, in declaration order.
@compiler_type("meta_base_list") struct base_list<T> {};

/// `list<type<Arg>, ...>` over the type arguments of a generic class or enum
/// instance `T`; empty for a non-generic type.
@compiler_type("meta_argument_list") struct argument_list<T> {};

/// The first element type of a non-empty `list`, and the `list` of the rest:
/// computed types that let generic code peel a sequence one element at a time.
@compiler_type("meta_list_first") struct list_first<L> {};
@compiler_type("meta_list_rest") struct list_rest<L> {};

/// `list<method<T, 0>, ...>` over the methods of `T` in declaration order:
/// operators and static methods included, constructors and destructors not.
@compiler_type("meta_method_list") struct method_list<T> {};

/// The subset of `method_list<T>` whose methods are overloaded operators.
@compiler_type("meta_operator_list") struct operator_list<T> {};

/// `list<parameter<T, I, 0>, ...>` over the parameters of method `I`.
@compiler_type("meta_parameter_list") struct parameter_list<T, uint64_t I> {};

/// The exact type of parameter `P` of method `I` of `T`.
@compiler_type("meta_parameter_type") struct parameter_type<T, uint64_t I, uint64_t P> {};

/// The exact return type of method `I` of `T`.
@compiler_type("meta_return_type") struct return_type<T, uint64_t I> {};

/// Exact result type of a function signature, selected GTI function item,
/// native function pointer or lambda. This is metadata only: it neither calls
/// the function nor grants unsafe access or a borrowed-result lifetime.
/// Callable classes use method/operator reflection to select a declaration.
@compiler_type("meta_callable_return_type") struct callable_return_type<F> {};

/// `list<constructor<T, 0>, ...>` over the declared constructors of `T`.
@compiler_type("meta_constructor_list") struct constructor_list<T> {};

/// `list<constructor_parameter<T, I, 0>, ...>` over constructor `I`'s
/// parameters.
@compiler_type("meta_constructor_parameter_list") struct constructor_parameter_list<T, uint64_t I> {};

/// The exact type of parameter `P` of constructor `I` of `T`.
@compiler_type("meta_constructor_parameter_type") struct constructor_parameter_type<T, uint64_t I, uint64_t P> {};

/// Satisfied when every instance field of `T` is readable through
/// reflection: `T` is a struct or class whose instance fields are all public,
/// or one declared `[[reflect_private]]`.
concept reflectable<T> = std::meta::is_reflectable<T>();

/// Describes the type `T`.
@compiler_type("meta_type") struct type<T> {
public:
  constexpr type() {}
  /// The qualified spelling of `T`.
  constexpr std::string_view name() { return gti_internal::meta_type_name<T>(); }
  constexpr bool is_struct() { return gti_internal::meta_type_kind<T>() == uint64_t(1); }
  constexpr bool is_class() { return gti_internal::meta_type_kind<T>() == uint64_t(2); }
  constexpr bool is_interface() { return gti_internal::meta_type_kind<T>() == uint64_t(3); }
  constexpr bool is_union() { return gti_internal::meta_type_kind<T>() == uint64_t(4); }
  constexpr bool is_enum() { return gti_internal::meta_type_kind<T>() == uint64_t(5); }
  constexpr bool is_integral() { return gti_internal::meta_type_trait<T, 17>(); }
  constexpr bool is_floating_point() { return gti_internal::meta_type_trait<T, 18>(); }
  constexpr bool is_bool() { return gti_internal::meta_type_trait<T, 19>(); }
  constexpr bool is_char() { return gti_internal::meta_type_kind<T>() == uint64_t(9); }
  constexpr bool is_text() { return gti_internal::meta_type_kind<T>() == uint64_t(10); }
  /// Whether T is a checked reference (the access mode is not changed).
  constexpr bool is_reference() { return gti_internal::meta_type_kind<T>() == uint64_t(11); }
  /// A raw data address, not an owning pointer or a callable address.
  constexpr bool is_raw_pointer() { return gti_internal::meta_type_kind<T>() == uint64_t(13); }
  /// Whether T denotes absence of a result, rather than an object type.
  constexpr bool is_void() { return gti_internal::meta_type_kind<T>() == uint64_t(17); }
  /// The number of instance fields when `T` is a struct or class, else 0.
  constexpr uint64_t field_count() { return gti_internal::meta_field_count<T>(); }
  /// The number of `[[attribute]]` applications on the declaration of `T`.
  constexpr uint64_t attribute_count() { return gti_internal::meta_type_attribute_count<T>(); }
  /// Whether the declaration of `T` applies the attribute type `A`.
  constexpr bool has_attribute<A>() { return gti_internal::meta_type_has_attribute<T, A>(); }
  /// The constant `A` value the declaration of `T` applies; an error when it
  /// applies none (test with `has_attribute<A>()` first).
  A attribute<A>();
  /// The attribute types applied to `T`, as a `list`.
  constexpr type_attributes<T> attributes() { return type_attributes<T>(); }
  /// Whether `T` is an enum whose enumerators carry payload fields.
  constexpr bool is_payload_enum() { return gti_internal::meta_type_trait<T, 0>(); }
  /// Whether `T` is an instance of a generic class or enum.
  constexpr bool is_generic_instance() { return gti_internal::meta_type_trait<T, 1>(); }
  /// Whether `T` satisfies `reflectable`: every instance field is readable
  /// through reflection.
  constexpr bool is_reflectable() { return gti_internal::meta_type_trait<T, 2>(); }
  /// Whether `T` is a signed fixed-width integer type.
  constexpr bool is_signed_integral() { return gti_internal::meta_type_trait<T, 3>(); }
  /// Exact GTI lifecycle and safety facts; these do not authorize a move,
  /// raw-memory operation, lifetime extension or cross-thread access.
  constexpr bool is_copy_constructible() { return gti_internal::meta_type_trait<T, 4>(); }
  constexpr bool is_move_constructible() { return gti_internal::meta_type_trait<T, 5>(); }
  constexpr bool is_copyable() { return gti_internal::meta_type_trait<T, 6>(); }
  constexpr bool is_movable() { return gti_internal::meta_type_trait<T, 7>(); }
  constexpr bool is_relocatable() { return gti_internal::meta_type_trait<T, 8>(); }
  constexpr bool is_bitwise_relocatable() { return gti_internal::meta_type_trait<T, 9>(); }
  constexpr bool is_transferable() { return gti_internal::meta_type_trait<T, 10>(); }
  constexpr bool is_shareable() { return gti_internal::meta_type_trait<T, 11>(); }
  constexpr bool is_default_initializable() { return gti_internal::meta_type_trait<T, 12>(); }
  constexpr bool is_integral_enum() { return gti_internal::meta_type_trait<T, 13>(); }
  constexpr bool is_unsigned_integral() { return gti_internal::meta_type_trait<T, 14>(); }
  constexpr bool is_numeric() { return gti_internal::meta_type_trait<T, 15>(); }
  constexpr bool is_signed_numeric() { return gti_internal::meta_type_trait<T, 16>(); }
  /// Whether a complete object representation is available for lifetime operations.
  constexpr bool has_object_layout() { return gti_internal::meta_type_trait<T, 20>(); }
  /// Whether the value retains no checked external-owner borrow (not raw-pointer validity).
  constexpr bool is_borrow_free() { return gti_internal::meta_type_trait<T, 21>(); }
  /// Exact type identity, not conversion compatibility.
  constexpr bool is_same<U>() { return gti_internal::meta_type_relation<T, U, 0>(); }
  /// Exact declared integral-enum representation, false for other types.
  constexpr bool has_underlying_type<U>() { return gti_internal::meta_type_relation<T, U, 1>(); }
  /// The number of enumerators when `T` is an enum, else 0.
  constexpr uint64_t enumerator_count() { return gti_internal::meta_enumerator_count<T>(); }
  /// The enumerators of `T`, as a `list` of `enumerator` metaobjects.
  constexpr enumerator_list<T> enumerators() { return enumerator_list<T>(); }
  /// The number of direct bases when `T` is a class, else 0.
  constexpr uint64_t base_count() { return gti_internal::meta_base_count<T>(); }
  /// The direct bases of `T`, as a `list` of `type` metaobjects.
  constexpr base_list<T> bases() { return base_list<T>(); }
  /// The number of type arguments of a generic instance `T`, else 0.
  constexpr uint64_t argument_count() { return gti_internal::meta_argument_count<T>(); }
  /// The type arguments of `T`, as a `list` of `type` metaobjects.
  constexpr argument_list<T> arguments() { return argument_list<T>(); }
  /// The number of methods declared by `T` (operators and static methods
  /// included; constructors and destructors not).
  constexpr uint64_t method_count() { return gti_internal::meta_method_count<T>(); }
  /// The methods of `T`, as a `list` of `method` metaobjects.
  constexpr method_list<T> methods() { return method_list<T>(); }
  /// The overloaded operators of `T`, as a `list` of `method` metaobjects.
  constexpr operator_list<T> operators() { return operator_list<T>(); }
  /// The number of constructors `T` declares (generated ones excluded).
  constexpr uint64_t constructor_count() { return gti_internal::meta_constructor_count<T>(); }
  /// The declared constructors of `T`, as a `list` of `constructor`
  /// metaobjects.
  constexpr constructor_list<T> constructors() { return constructor_list<T>(); }
  /// The source line of the declaration of `T`; 0 when the frontend retains
  /// none.
  constexpr uint64_t line() { return gti_internal::meta_declaration_line<T, 0, 0>(); }
  /// The source file of the declaration of `T`, as the compiler names it.
  constexpr std::string_view file() { return gti_internal::meta_declaration_file<T>(); }
  /// The qualified name of the declaration `T` is an instance of, without
  /// arguments (`std::vector` for `std::vector<int>`); the type's own
  /// spelling for a non-generic type.
  constexpr std::string_view primary_name() { return gti_internal::meta_type_primary_name<T>(); }
};

/// Describes parameter `P` of method `I` of `T`.
@compiler_type("meta_parameter") struct parameter<T, uint64_t I, uint64_t P> {
public:
  constexpr parameter() {}
  constexpr std::string_view name() { return gti_internal::meta_parameter_name<T, I, P>(); }
  constexpr uint64_t index() { return P; }
  constexpr type<parameter_type<T, I, P>> type() {
    return std::meta::type<parameter_type<T, I, P>>();
  }
};

/// Describes method `I`, in declaration order, of `T`: metadata only.
/// Invocation through a metaobject is a separate capability.
@compiler_type("meta_method") struct method<T, uint64_t I> {
public:
  constexpr method() {}
  /// The declared name, or the operator spelling (`operator+`).
  constexpr std::string_view name() { return gti_internal::meta_method_name<T, I>(); }
  constexpr uint64_t index() { return I; }
  constexpr bool is_static() { return gti_internal::meta_method_trait<T, I, 0>(); }
  constexpr bool is_operator() { return gti_internal::meta_method_trait<T, I, 1>(); }
  constexpr bool is_constexpr() { return gti_internal::meta_method_trait<T, I, 2>(); }
  constexpr bool is_virtual() { return gti_internal::meta_method_trait<T, I, 3>(); }
  /// Whether the method takes its receiver mutably.
  constexpr bool is_mutating() { return gti_internal::meta_method_trait<T, I, 4>(); }
  constexpr bool is_public() { return gti_internal::meta_method_trait<T, I, 5>(); }
  /// Declaration facts; none of these predicates authorizes an invocation.
  constexpr bool is_consuming() { return gti_internal::meta_method_trait<T, I, 6>(); }
  constexpr bool is_unsafe() { return gti_internal::meta_method_trait<T, I, 7>(); }
  constexpr bool is_generic() { return gti_internal::meta_method_trait<T, I, 8>(); }
  constexpr bool is_constrained() { return gti_internal::meta_method_trait<T, I, 9>(); }
  constexpr uint64_t parameter_count() { return gti_internal::meta_method_parameter_count<T, I>(); }
  constexpr parameter_list<T, I> parameters() { return parameter_list<T, I>(); }
  constexpr type<return_type<T, I>> result() {
    return std::meta::type<return_type<T, I>>();
  }
  constexpr uint64_t line() { return gti_internal::meta_declaration_line<T, 3, I>(); }
};

/// Describes parameter `P` of constructor `I` of `T`.
@compiler_type("meta_constructor_parameter") struct constructor_parameter<T, uint64_t I, uint64_t P> {
public:
  constexpr constructor_parameter() {}
  constexpr std::string_view name() { return gti_internal::meta_constructor_parameter_name<T, I, P>(); }
  constexpr uint64_t index() { return P; }
  constexpr type<constructor_parameter_type<T, I, P>> type() {
    return std::meta::type<constructor_parameter_type<T, I, P>>();
  }
};

/// Describes declared constructor `I` of `T`: metadata only.
@compiler_type("meta_constructor") struct constructor<T, uint64_t I> {
public:
  constexpr constructor() {}
  constexpr uint64_t index() { return I; }
  constexpr uint64_t parameter_count() { return gti_internal::meta_constructor_parameter_count<T, I>(); }
  constexpr constructor_parameter_list<T, I> parameters() {
    return constructor_parameter_list<T, I>();
  }
  constexpr uint64_t line() { return gti_internal::meta_declaration_line<T, 4, I>(); }
};

/// Describes payload field `P` of enumerator `I` of the payload enum `E`.
@compiler_type("meta_payload_field") struct payload_field<E, uint64_t I, uint64_t P> {
public:
  constexpr payload_field() {}
  /// The payload field's declared name.
  constexpr std::string_view name() { return gti_internal::meta_payload_name<E, I, P>(); }
  /// The payload field's position within its enumerator.
  constexpr uint64_t index() { return P; }
  /// The exact payload field type as a type metaobject.
  constexpr type<payload_type<E, I, P>> type() {
    return std::meta::type<payload_type<E, I, P>>();
  }
};

/// Describes enumerator `I`, in declaration order, of the enum `E`.
@compiler_type("meta_enumerator") struct enumerator<E, uint64_t I> {
public:
  constexpr enumerator() {}
  /// The enumerator's declared name.
  constexpr std::string_view name() { return gti_internal::meta_enumerator_name<E, I>(); }
  /// The enumerator's position in declaration order.
  constexpr uint64_t index() { return I; }
  /// The enumerator as a value of `E`; rejected for a payload enum
  /// (`GTI-S2117`), whose alternatives are not integer constants.
  constexpr E value() { return gti_internal::meta_enumerator_value<E, I>(); }
  /// The number of payload fields; 0 for an integral enumerator.
  constexpr uint64_t payload_count() { return gti_internal::meta_payload_count<E, I>(); }
  /// The payload fields, as a `list` of `payload_field` metaobjects.
  constexpr payload_list<E, I> payload_fields() { return payload_list<E, I>(); }
  /// The source line of the enumerator's declaration.
  constexpr uint64_t line() { return gti_internal::meta_declaration_line<E, 2, I>(); }
};

/// Describes instance field `I`, in declaration order, of `T`.
@compiler_type("meta_field") struct field<T, uint64_t I> {
public:
  constexpr field() {}
  /// The field's declared name.
  constexpr std::string_view name() { return gti_internal::meta_field_name<T, I>(); }
  /// The field's position in declaration order.
  constexpr uint64_t index() { return I; }
  constexpr bool is_public() { return gti_internal::meta_field_is_public<T, I>(); }
  /// Whether the field's declaration has a default initializer.
  constexpr bool has_default() { return gti_internal::meta_field_has_default<T, I>(); }
  /// A fresh value of the field's declared default initializer, evaluated
  /// where `default_value` is called; an error when the declaration has none
  /// (test with `has_default()` first).
  field_type<T, I> default_value();
  /// The exact field type as a type metaobject; pass it to a generic
  /// function to deduce the type (`decode(field.type(), input)`).
  constexpr type<field_type<T, I>> type() {
    return std::meta::type<field_type<T, I>>();
  }
  /// The field of `owner`, as the place `owner.<name>` with the same access,
  /// borrowing and visibility rules as writing it directly where `get` is
  /// called. A private field is accessible only where direct access is.
  field_type<T, I>& get(T& owner);
  mut field_type<T, I>& get_mut(mut T& owner) mut;
  /// The number of `[[attribute]]` applications on this field.
  constexpr uint64_t attribute_count() { return gti_internal::meta_field_attribute_count<T, I>(); }
  /// Whether this field applies the attribute type `A`.
  constexpr bool has_attribute<A>() { return gti_internal::meta_field_has_attribute<T, A, I>(); }
  /// The constant `A` value this field applies; an error when it applies
  /// none (test with `has_attribute<A>()` first).
  A attribute<A>();
  /// The attribute types applied to this field, as a `list`.
  constexpr field_attributes<T, I> attributes() { return field_attributes<T, I>(); }
  /// The source line of the field's declaration.
  constexpr uint64_t line() { return gti_internal::meta_declaration_line<T, 1, I>(); }
};

/// The instance fields of `T`, in declaration order.
constexpr field_list<T> fields_of<T>() {
  return field_list<T>();
}

/// The enumerators of `E`, in declaration order.
constexpr enumerator_list<E> enumerators_of<E>() {
  return enumerator_list<E>();
}

/// The alternatives of a payload enum `E`; the same enumerator metaobjects as
/// `enumerators_of`, named for the payload reading.
constexpr enumerator_list<E> alternatives_of<E>() {
  return enumerator_list<E>();
}

/// The direct bases of `T`, in declaration order, as `type` metaobjects.
constexpr base_list<T> bases_of<T>() { return base_list<T>(); }

/// The type arguments of a generic instance `T`, as `type` metaobjects.
constexpr argument_list<T> arguments_of<T>() { return argument_list<T>(); }

/// The methods and declared constructors of `T`, as metaobjects.
constexpr method_list<T> methods_of<T>() { return method_list<T>(); }
constexpr operator_list<T> operators_of<T>() { return operator_list<T>(); }
constexpr constructor_list<T> constructors_of<T>() { return constructor_list<T>(); }

namespace detail {
/// Produces the fields in declaration order, peeling `Remaining` (a `list` of
/// field metaobjects) one element at a time and prepending each value to the
/// collected pack (a pack grows only at its front), so the compiler-private
/// construction receives the values last field first.
expected<T, E> construct_fields<T, E, Producer, Remaining, Values...>(
    mut Producer& producer, Values... collected) {
  if constexpr (std::meta::type<Remaining>().argument_count() == uint64_t(0)) {
    return gti_internal::meta_construct<T>(true, collected...);
  } else {
    auto produced = ?producer.produce(list_first<Remaining>());
    return construct_fields<T, E, Producer, list_rest<Remaining>>(
        producer, std::move(produced), collected...);
  }
}
}

/// Structural construction: `producer.produce(field)` yields
/// `expected<field_type, E>` for every instance field of `T` in declaration
/// order, and the values construct one `T` under ordinary initialization.
/// The first failure stops production and is returned; values produced so
/// far are cleaned up by the ordinary rollback. `T` must be eligible for
/// designated construction (`GTI-S2118` otherwise); constructors and
/// invariants are never bypassed.
expected<T, E> construct<T, E, Producer>(mut Producer& producer) {
  return detail::construct_fields<T, E, Producer, field_list<T>>(producer);
}

constexpr type<T> type_of<T>() { return type<T>(); }
constexpr std::string_view name_of<T>() { return gti_internal::meta_type_name<T>(); }
constexpr std::string_view primary_name_of<T>() { return gti_internal::meta_type_primary_name<T>(); }
constexpr bool is_struct<T>() { return gti_internal::meta_type_kind<T>() == uint64_t(1); }
constexpr bool is_class<T>() { return gti_internal::meta_type_kind<T>() == uint64_t(2); }
constexpr bool is_enum<T>() { return gti_internal::meta_type_kind<T>() == uint64_t(5); }
constexpr bool is_integral<T>() { return gti_internal::meta_type_trait<T, 17>(); }
constexpr bool is_floating_point<T>() { return gti_internal::meta_type_trait<T, 18>(); }
constexpr bool is_bool<T>() { return gti_internal::meta_type_trait<T, 19>(); }
constexpr bool is_raw_pointer<T>() { return gti_internal::meta_type_kind<T>() == uint64_t(13); }
constexpr bool is_text<T>() { return gti_internal::meta_type_kind<T>() == uint64_t(10); }
constexpr bool is_payload_enum<T>() { return gti_internal::meta_type_trait<T, 0>(); }
constexpr bool is_generic_instance<T>() { return gti_internal::meta_type_trait<T, 1>(); }
constexpr bool is_reflectable<T>() { return gti_internal::meta_type_trait<T, 2>(); }
constexpr bool is_signed_integral<T>() { return gti_internal::meta_type_trait<T, 3>(); }

/// Query GTI's selected lifecycle and structural safety facts. These queries
/// describe a type; ordinary expression-level ownership, borrowing and unsafe
/// checks still apply when an operation is performed.
constexpr bool is_copy_constructible<T>() { return gti_internal::meta_type_trait<T, 4>(); }
constexpr bool is_move_constructible<T>() { return gti_internal::meta_type_trait<T, 5>(); }
constexpr bool is_copyable<T>() { return gti_internal::meta_type_trait<T, 6>(); }
constexpr bool is_movable<T>() { return gti_internal::meta_type_trait<T, 7>(); }
constexpr bool is_relocatable<T>() { return gti_internal::meta_type_trait<T, 8>(); }
constexpr bool is_bitwise_relocatable<T>() { return gti_internal::meta_type_trait<T, 9>(); }
constexpr bool is_transferable<T>() { return gti_internal::meta_type_trait<T, 10>(); }
constexpr bool is_shareable<T>() { return gti_internal::meta_type_trait<T, 11>(); }
constexpr bool is_default_initializable<T>() { return gti_internal::meta_type_trait<T, 12>(); }
constexpr bool is_integral_enum<T>() { return gti_internal::meta_type_trait<T, 13>(); }
constexpr bool is_unsigned_integral<T>() { return gti_internal::meta_type_trait<T, 14>(); }
constexpr bool is_numeric<T>() { return gti_internal::meta_type_trait<T, 15>(); }
constexpr bool is_signed_numeric<T>() { return gti_internal::meta_type_trait<T, 16>(); }
/// Whether a complete object representation is available for lifetime operations.
constexpr bool has_object_layout<T>() { return gti_internal::meta_type_trait<T, 20>(); }
/// Whether the value retains no checked external-owner borrow. This does not
/// establish validity, provenance, or ownership of any raw pointer it stores.
constexpr bool is_borrow_free<T>() { return gti_internal::meta_type_trait<T, 21>(); }
/// Exact type identity, without widening, implicit conversion or inheritance.
constexpr bool is_same<T, U>() { return gti_internal::meta_type_relation<T, U, 0>(); }
/// Whether E is a payload-free enum with exactly U as its declared domain.
constexpr bool is_enum_underlying<E, U>() { return gti_internal::meta_type_relation<E, U, 1>(); }

}
}
