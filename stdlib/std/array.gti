export module array;

import std.memory;
import "detail/iterator.gti";
// The value and indexed core is implemented without pointer decay or hidden
// allocation. Nominal cursors borrow the array owner, never decay its storage.
namespace std {
namespace detail {
class array_sentinel {
  size_t length;
public:
  array_sentinel(size_t length) : length(length) {}
  size_t position() { return this.length; }
};
class array_iterator<T, uint64_t N, uint64_t Reverse = 0> {
  array<T, N>& owner;
  mut size_t position;
public:
  array_iterator(array<T, N>& owner, size_t position) : owner(owner), position(position) {}
  T& operator*() {
    size_t selected = checked_iterator_element(this.position, size_t(0), N, ptrdiff_t(0), Reverse != 0);
    unsafe { return this.owner.get_unchecked(selected); }
  }
  T& operator->() { return *this; }
  T& operator[](ptrdiff_t offset) {
    size_t index = checked_iterator_element(this.position, size_t(0), N, offset, Reverse != 0);
    return this.owner[index];
  }
  void operator++() mut { this.position = checked_iterator_step<Reverse>(this.position, size_t(0), N); }
  void operator--() mut { this.position = checked_iterator_step<Reverse, 1>(this.position, size_t(0), N); }
  void operator+=(ptrdiff_t offset) mut { this.position = checked_iterator_position(this.position, size_t(0), N, offset, Reverse != 0); }
  void operator-=(ptrdiff_t offset) mut { this.position = checked_iterator_position(this.position, size_t(0), N, offset, Reverse == 0); }
  bool operator!=(array_sentinel end) { return this.position != end.position(); }
  bool operator!=(array_iterator<T, N, Reverse>& other) { return this.position != other.position; }
  bool operator==(array_sentinel end) { return this.position == end.position(); }
  bool operator==(array_iterator<T, N, Reverse>& other) { return this.position == other.position; }
  ptrdiff_t operator-(array_sentinel end) {
    if constexpr (Reverse != 0) { return checked_iterator_difference(end.position(), this.position); }
    return checked_iterator_difference(this.position, end.position());
  }
  ptrdiff_t operator-(array_iterator<T, N, Reverse>& other) {
    if constexpr (Reverse != 0) { return checked_iterator_difference(other.position, this.position); }
    return checked_iterator_difference(this.position, other.position);
  }
};
class array_mut_iterator<T, uint64_t N, uint64_t Reverse = 0> {
  mut array<T, N>& owner;
  mut size_t position;
public:
  array_mut_iterator(mut array<T, N>& owner, size_t position = 0) : owner(owner), position(position) {}
  T& operator*() {
    size_t selected = checked_iterator_element(this.position, size_t(0), N, ptrdiff_t(0), Reverse != 0);
    unsafe { return this.owner.get_unchecked(selected); }
  }
  mut T& operator*() mut {
    size_t selected = checked_iterator_element(this.position, size_t(0), N, ptrdiff_t(0), Reverse != 0);
    unsafe { return this.owner.get_unchecked_mut(selected); }
  }
  T& operator->() { return *this; }
  mut T& operator->() mut { return *this; }
  T& operator[](ptrdiff_t offset) {
    size_t index = checked_iterator_element(this.position, size_t(0), N, offset, Reverse != 0);
    return this.owner[index];
  }
  mut T& operator[](ptrdiff_t offset) mut {
    size_t index = checked_iterator_element(this.position, size_t(0), N, offset, Reverse != 0);
    return this.owner[index];
  }
  void operator++() mut { this.position = checked_iterator_step<Reverse>(this.position, size_t(0), N); }
  void operator--() mut { this.position = checked_iterator_step<Reverse, 1>(this.position, size_t(0), N); }
  void operator+=(ptrdiff_t offset) mut { this.position = checked_iterator_position(this.position, size_t(0), N, offset, Reverse != 0); }
  void operator-=(ptrdiff_t offset) mut { this.position = checked_iterator_position(this.position, size_t(0), N, offset, Reverse == 0); }
  bool operator!=(array_sentinel end) { return this.position != end.position(); }
  bool operator==(array_sentinel end) { return this.position == end.position(); }
  ptrdiff_t operator-(array_sentinel end) {
    if constexpr (Reverse != 0) { return checked_iterator_difference(end.position(), this.position); }
    return checked_iterator_difference(this.position, end.position());
  }
  ptrdiff_t operator-(array_mut_iterator<T, N, Reverse>& other) {
    if constexpr (Reverse != 0) { return checked_iterator_difference(other.position, this.position); }
    return checked_iterator_difference(this.position, other.position);
  }
};
}
export class array<T, uint64_t N> {
  mut T values[N];

public:
  using iterator = detail::array_mut_iterator<T, N>;
  using const_iterator = detail::array_iterator<T, N>;
  using sentinel = detail::array_sentinel;
  using reverse_iterator = detail::array_mut_iterator<T, N, 1>;
  using const_reverse_iterator = detail::array_iterator<T, N, 1>;

  constexpr array() : values({}) {}

  constexpr array(T initial[N]) : values(std::move(initial)) {}

  constexpr size_t size() {
    return N;
  }

  constexpr bool empty() {
    return N == 0;
  }

  detail::array_iterator<T, N> begin() {
    return detail::array_iterator<T, N>(this, size_t(0));
  }
  detail::array_mut_iterator<T, N> begin_mut() mut {
    return detail::array_mut_iterator<T, N>(this);
  }
  detail::array_sentinel end() { return detail::array_sentinel(N); }
  const_iterator end_iterator() { return const_iterator(this, N); }
  iterator end_mut() mut { return iterator(this, N); }
  const_iterator cbegin() { return this.begin(); }
  sentinel cend() { return this.end(); }
  const_reverse_iterator rbegin() { return const_reverse_iterator(this, N); }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  sentinel rend() { return sentinel(size_t(0)); }
  sentinel crend() { return this.rend(); }
  reverse_iterator rbegin_mut() mut { return reverse_iterator(this, N); }
  reverse_iterator rend_mut() mut { return reverse_iterator(this, size_t(0)); }

  constexpr T& at(int index) {
    return this.values[index];
  }

  constexpr mut T& at(int index) mut {
    return this.values[index];
  }

  constexpr T& at(size_t index) {
    return this.values[index];
  }

  constexpr mut T& at(size_t index) mut {
    return this.values[index];
  }

  constexpr T& front() {
    return this.values[0];
  }

  constexpr mut T& front() mut {
    return this.values[0];
  }

  constexpr T& back() {
    return this.values[N - 1];
  }

  constexpr mut T& back() mut {
    return this.values[N - 1];
  }

  constexpr T& operator[](int index) {
    return this.values[index];
  }

  constexpr mut T& operator[](int index) mut {
    return this.values[index];
  }

  constexpr T& operator[](size_t index) {
    return this.values[index];
  }

  constexpr mut T& operator[](size_t index) mut {
    return this.values[index];
  }

  /// The caller proves index < N; forming the reference retains this owner.
  unsafe T& get_unchecked(size_t index) {
    unsafe {
      mut const T* address = nullptr;
      if constexpr (N > 0) { address = &this.values[0]; }
      return std::assume_ref(address + index, this);
    }
  }

  unsafe mut T& get_unchecked_mut(size_t index) mut {
    unsafe {
      mut T* address = nullptr;
      if constexpr (N > 0) { address = &this.values[0]; }
      return std::assume_mut(address + index, this);
    }
  }

  constexpr void fill(T value) mut
    requires std::copyable<T> {
    for (mut size_t index = 0; index < N; index++) {
      this.values[index] = value;
    }
  }

  void swap(mut array<T, N>& other) mut
    requires std::relocatable<T> {
    gti_internal::restoring_swap(this.values, other.values);
  }

  /// Check both indices before mutation; equal valid indices are a no-op.
  void swap_elements(size_t left, size_t right) mut
    requires std::relocatable<T> {
    gti_internal::index_bounds_check(left, N);
    gti_internal::index_bounds_check(right, N);
    gti_internal::restoring_indexed_swap(this.values, left, right);
  }
};
}
