// The indexed core below is implemented. Bodyless members mark the remaining
// first-wave surface that current GTI semantics can describe without pointer
// decay or an owner-dependent iterator.
namespace std {
class array<T, uint64_t N> {
  mut T values[N];

public:
  array() : values({}) {}

  array(T initial[N]) : values(initial) {}

  size_t size() {
    return N;
  }

  bool empty() {
    return N == 0;
  }

  T& at(int index) {
    return this.values[index];
  }

  mut T& at(int index) mut;

  T& at(size_t index) {
    return this.values[index];
  }

  mut T& at(size_t index) mut;

  T& front();
  mut T& front() mut;

  T& back();
  mut T& back() mut;

  T& operator[](int index) {
    return this.values[index];
  }

  mut T& operator[](int index) mut {
    return this.values[index];
  }

  T& operator[](size_t index) {
    return this.values[index];
  }

  mut T& operator[](size_t index) mut {
    return this.values[index];
  }

  void fill(T value) mut
    requires std::copyable<T>;

  void swap(mut array<T, N>& other) mut
    requires std::movable<T>;
};
}
