export module assert;

// Assertions are source policy over the general typed macro facility.
// NDEBUG disables only debug_assert; assert is always checked.
import std.panic;
import std.source_location;
// Declare this optional configuration switch without changing its value.
#ifdef NDEBUG
#define NDEBUG
#endif

export namespace std {
  /// Source configuration, independent of optimizer success.
#ifdef NDEBUG
  constexpr bool debug_assertions_enabled = false;
#else
  constexpr bool debug_assertions_enabled = true;
#endif
  /// Checks condition once and panics at the caller if it is false.
  [[track_caller]]
  #macro assert(bool condition) {
    std::string_view condition_text =
        std::expression_text(condition, "assertion condition");
    if (!condition) {
      std::panic("Assertion failed: {}", condition_text);
    }
  }

  /// The pattern and formatting arguments are evaluated only on failure.
  [[track_caller]]
  #macro assert<Args...>(bool condition, std::string_view pattern, Args... args) {
    if (!condition) {
      std::panic(pattern, args...);
    }
  }

  /// Like assert, but NDEBUG skips every argument's runtime evaluation.
  [[track_caller]]
  #macro debug_assert(bool condition) {
    if (std::debug_assertions_enabled) {
      std::string_view condition_text =
          std::expression_text(condition, "assertion condition");
      if (!condition) {
        std::panic("Debug assertion failed: {}", condition_text);
      }
    }
  }

  /// Disabled debug assertions still require well-typed arguments.
  [[track_caller]]
  #macro debug_assert<Args...>(bool condition, std::string_view pattern, Args... args) {
    if (std::debug_assertions_enabled) {
      if (!condition) {
        std::panic(pattern, args...);
      }
    }
  }
}
