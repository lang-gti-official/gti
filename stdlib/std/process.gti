export module process;

// <std/process> — exact argument vectors for child execution and replacement.
//
// This first public process slice deliberately does not invoke a shell. A
// command owns one executable plus its exact argument vector, inherits the
// caller's environment and waits for the child. run() inherits stdio/cwd;
// output() captures both streams with bounded time/bytes and optional cwd.
// Environment overrides and asynchronous child ownership remain later work.

#if target.os == "windows"
#error "std/process is not yet available on Windows."
#endif

#if target.os == "unknown"
#error "std/process requires a supported POSIX target."
#endif
import std.string;
export namespace gti_internal {
namespace process_runtime {
extern "C" {
uint32_t gti_rt_process_exec_v1(
    gti_internal::text_view arguments, int32_t* native_code);
uint32_t gti_rt_process_output_v1(gti_internal::text_view arguments,
    gti_internal::text_view working_directory, uint64_t timeout_ms,
    uint64_t output_limit, int64_t* result, int32_t* native_code);
int64_t gti_rt_process_output_info_v1(int64_t result, uint32_t selector);
uint64_t gti_rt_process_output_read_v1(int64_t result, uint32_t stream,
    uint64_t offset, uint8_t* output, uint64_t capacity);
void gti_rt_process_output_destroy_v1(int64_t result);
uint32_t gti_rt_process_run_v1(
    gti_internal::text_view arguments, int32_t* termination_kind,
    int32_t* termination_value, int32_t* native_code);
}
}
}

namespace gti_internal {
export [[no_transfer, no_share]] class process_output_owner {
  int64_t handle;
public:
  process_output_owner(int64_t value) : handle(value) {}
  process_output_owner(process_output_owner&) = delete;
  process_output_owner(process_output_owner&&) = default;
  ~process_output_owner() { process_runtime::gti_rt_process_output_destroy_v1(this.handle); }
  int64_t info(uint32_t selector) { return process_runtime::gti_rt_process_output_info_v1(this.handle, selector); }
  std::string text(uint32_t stream) {
    mut std::string value{};
    uint64_t length = uint64_t(this.info(stream + uint32_t(2)));
    value.reserve(std::size_t(length));
    mut uint64_t offset = 0;
    mut uint8_t buffer[4096] = {};
    while (offset < length) {
      mut uint64_t count = 0;
      unsafe { count = process_runtime::gti_rt_process_output_read_v1(this.handle, stream, offset, &buffer[0], uint64_t(4096)); }
      for (mut uint64_t i = 0; i < count; i++) { value.push_back(char(buffer[std::size_t(i)])); }
      offset += count;
    }
    return std::move(value);
  }
};
}

export namespace std {
namespace process {

/// Recoverable failures before a child termination status is available.
enum class errc {
  invalid_argument,
  unsupported,
  spawn_failed,
  execute_failed,
  wait_failed,
};

/// A failed process-image replacement. Success never returns this value.
class exec_error {
  errc category;
  int32_t native_value;
public:
  exec_error(errc code, int32_t native_code)
      : category(code), native_value(native_code) {}
  /// Portable failure category.
  errc code() { return this.category; }
  /// Captured POSIX errno, or zero for source validation/unsupported failures.
  int32_t native_code() { return this.native_value; }
};

/// The completed termination state of one child process.
class exit_status {
  bool exited_value;
  int32_t value;

public:
  exit_status(bool exited, int32_t status_value)
      : exited_value(exited), value(status_value) {}

  /// True when the child returned or called an ordinary exit operation.
  bool exited() {
    return this.exited_value;
  }

  /// True when the host reports termination by a signal.
  bool signaled() {
    return !this.exited_value;
  }

  /// Returns the child exit code, or -1 for signal termination.
  int32_t exit_code() {
    return this.exited_value ? this.value : int32_t(-1);
  }

  /// Returns the terminating signal number, or 0 for ordinary exit.
  int32_t terminating_signal() {
    return this.exited_value ? int32_t(0) : this.value;
  }

  /// True only for ordinary exit with status zero.
  bool success() {
    return this.exited_value && this.value == int32_t(0);
  }
};

/// Bounded capture options. Limits apply to the whole child process group.
struct output_options {
  output_options() = default;
  mut uint64_t timeout_ms = 5000;
  mut uint64_t output_limit = uint64_t(1024 * 1024);
  mut std::string working_directory{};
};

/// Captured bytes and the actual termination status, with limit outcomes kept
/// separate from normal exit codes or signals. Strings preserve embedded NUL.
class output {
  exit_status child_status;
  int32_t stop_reason;
  std::string out;
  std::string err;
public:
  output(exit_status status, int32_t reason, std::string standard_output, std::string standard_error)
      : child_status(status), stop_reason(reason), out(std::move(standard_output)), err(std::move(standard_error)) {}
  output(output&) = delete;
  output(output&&) = default;
  exit_status status() { return this.child_status; }
  bool timed_out() { return this.stop_reason == int32_t(1); }
  bool output_limited() { return this.stop_reason == int32_t(2); }
  bool success() { return this.stop_reason == int32_t(0) && this.child_status.success(); }
  std::string_view stdout_text() { return this.out.view(); }
  std::string_view stderr_text() { return this.err.view(); }
};

/// One exact argv command. No shell parsing, expansion, or interpolation is
/// performed. Empty arguments are preserved; the executable must be nonempty,
/// and no element may contain an embedded zero byte.
class command {
  mut std::string encoded;
  mut bool valid_value;
  mut std::size_t count_value;

  void append(std::string_view value, bool executable) mut {
    if ((executable && value.empty()) || !this.valid_value) {
      this.valid_value = false;
      return;
    }
    for (mut std::size_t index = std::size_t(0); index < value.size();
         index++) {
      if (value[index] == '\0') {
        this.valid_value = false;
        return;
      }
    }
    this.encoded.append(value);
    this.encoded.push_back('\0');
    this.count_value++;
  }

public:
  command(std::string_view executable)
      : encoded(std::string("")), valid_value(true), count_value(0) {
    this.append(executable, true);
  }

  command(command& other) = delete;
  command(command&& other) = default;

  /// Appends one exact argument. Empty arguments are valid and preserved.
  void arg(std::string_view value) mut {
    this.append(value, false);
  }

  bool valid() {
    return this.valid_value && this.count_value > std::size_t(0);
  }

  std::size_t argument_count() {
    return this.count_value;
  }

  /// Replaces this process using the exact executable path (no PATH search).
  /// Success does not return or run GTI destructors; failure leaves this
  /// command intact and returns its category and captured native error.
  exec_error exec() {
    if (!this.valid()) {
      return exec_error(errc::invalid_argument, int32_t(0));
    }
    mut int32_t native_code = int32_t(0);
    mut uint32_t result = uint32_t(0);
    unsafe {
      result = gti_internal::process_runtime::gti_rt_process_exec_v1(
          this.encoded.view(), &native_code);
    }
    switch (result) {
    case uint32_t(1):
      return exec_error(errc::invalid_argument, native_code);
    case uint32_t(2):
      return exec_error(errc::unsupported, native_code);
    default:
      return exec_error(errc::execute_failed, native_code);
    }
  }

  /// Executes with /dev/null stdin, captured stdout/stderr, inherited environment
  /// and optional child-only working directory. Never interpolates a shell.
  expected<std::process::output, errc> output(output_options& options) {
    if (!this.valid()) { return unexpected(errc::invalid_argument); }
    mut int64_t handle = 0;
    mut int32_t native_code = 0;
    mut uint32_t result = 0;
    unsafe {
      result = gti_internal::process_runtime::gti_rt_process_output_v1(
          this.encoded.view(), options.working_directory.view(), options.timeout_ms,
          options.output_limit, &handle, &native_code);
    }
    if (result != uint32_t(0)) {
      switch (result) {
      case uint32_t(1): return unexpected(errc::invalid_argument);
      case uint32_t(2): return unexpected(errc::unsupported);
      case uint32_t(4): return unexpected(errc::execute_failed);
      case uint32_t(5): return unexpected(errc::wait_failed);
      default: return unexpected(errc::spawn_failed);
      }
    }
    auto owned = gti_internal::process_output_owner(handle);
    auto status = exit_status(owned.info(uint32_t(0)) == int64_t(0), int32_t(owned.info(uint32_t(1))));
    return std::process::output(status, int32_t(owned.info(uint32_t(4))), owned.text(uint32_t(0)), owned.text(uint32_t(1)));
  }
  expected<std::process::output, errc> output() {
    auto options = output_options();
    return this.output(options);
  }

  /// Executes and waits for the child while inheriting the caller's current
  /// environment, working directory, stdin, stdout, and stderr.
  expected<exit_status, errc> run() {
    if (!this.valid()) {
      return unexpected(errc::invalid_argument);
    }

    mut int32_t termination_kind = int32_t(-1);
    mut int32_t termination_value = int32_t(-1);
    mut int32_t native_code = int32_t(0);
    mut uint32_t result = uint32_t(0);
    unsafe {
      result = gti_internal::process_runtime::gti_rt_process_run_v1(
          this.encoded.view(), &termination_kind, &termination_value,
          &native_code);
    }

    switch (result) {
    case uint32_t(0):
      if (termination_kind == int32_t(0)) {
        return exit_status(true, termination_value);
      }
      if (termination_kind == int32_t(1)) {
        return exit_status(false, termination_value);
      }
      return unexpected(errc::wait_failed);
    case uint32_t(1):
      return unexpected(errc::invalid_argument);
    case uint32_t(2):
      return unexpected(errc::unsupported);
    case uint32_t(3):
      return unexpected(errc::spawn_failed);
    case uint32_t(4):
      return unexpected(errc::execute_failed);
    default:
      return unexpected(errc::wait_failed);
    }
  }
};

}
}
