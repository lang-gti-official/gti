// Ownership and typed allocation are ordinary GTI policy over
// declaration-bound private capabilities.

#include <std/detail/iterator>
#include <std/meta>

namespace gti_internal {
namespace runtime {
extern "C" {
  const uint8_t* gti_rt_c_string_bytes_v1(c_string text);
}
}
class unique_owner<T> {};
class shared_owner<T> {
public:
  shared_owner() = default;
};
// Layout-only capability: no engagement bit and no automatic payload drop.
class uninitialized_storage<T> {
public:
  uninitialized_storage() = default;
};
// An opaque referent identity, never an object GTI source may construct/read.
class erased_object {};
erased_object& erase_reference<T>(T& object);
mut erased_object& erase_reference_mut<T>(mut T& object);
unsafe T& restore_reference<T>(erased_object& object);
unsafe mut T& restore_reference_mut<T>(mut erased_object& object);

uint64_t object_size<T>();
uint64_t object_alignment<T>();
void object_destroy<T>(T* address);
void object_construct<T, Args...>(T* address, Args... args);
void object_relocate<T>(T* destination, T* source);
void object_relocate_range<T>(T* destination, T* source, uint64_t count);
gti_internal::text_view text_view_from_address<Owner>(
    const char* address, uint64_t count, Owner& owner);
gti_internal::c_string c_string_from_address<Owner>(
    const char* address, Owner& owner);

gti_internal::shared_owner<T> shared_owner_empty<T>();
gti_internal::shared_owner<T> shared_owner_from_unique<T>(gti_internal::unique_owner<T> owner);
gti_internal::shared_owner<T> shared_owner_clone<T>(gti_internal::shared_owner<T>& owner);
T& shared_owner_borrow<T>(gti_internal::shared_owner<T>& owner);
bool shared_owner_is_null<T>(gti_internal::shared_owner<T>& owner);
uint64_t shared_owner_use_count<T>(gti_internal::shared_owner<T>& owner);
void shared_owner_swap<T>(mut gti_internal::shared_owner<T>& left,
                         mut gti_internal::shared_owner<T>& right);
gti_internal::shared_owner<Base> shared_owner_upcast<Base, Derived>(
    gti_internal::shared_owner<Derived> owner);

gti_internal::unique_owner<T> allocate_unique_owner<T, Args...>(Args... args);
T & unique_owner_borrow<T>(gti_internal::unique_owner<T>& owner);
mut T & unique_owner_borrow_mut<T>(mut gti_internal::unique_owner<T>& owner);
bool unique_owner_is_null<T>(gti_internal::unique_owner<T>& owner);
void unique_owner_swap<T>(mut gti_internal::unique_owner<T>& left,
                          mut gti_internal::unique_owner<T>& right);
gti_internal::unique_owner<Base> unique_owner_upcast<Base, Derived>(gti_internal::unique_owner<Derived> owner);

/// Seals adoption of freshly allocated, wholly uninitialized typed storage.
///
/// This is ordinary source-defined standard-library policy, not a compiler
/// intrinsic. Application source cannot name the compiler-private namespace,
/// so only trusted library factories can establish the adoption precondition.
enum class empty_storage_adoption {
  trusted,
};
}

namespace std {
/// Checked type erasure retains the original object's lifetime and access.
/// Erasure does not make an object transferable or concurrently shareable.
using erased_object = gti_internal::erased_object;

erased_object& erase_ref<T>(T& object) {
  return gti_internal::erase_reference(object);
}
mut erased_object& erase_mut<T>(mut T& object) {
  return gti_internal::erase_reference_mut(object);
}
/// The caller must restore precisely the original referent type. Lifetime
/// and shared/exclusive access remain checked even inside unsafe.
unsafe T& restore_ref<T>(erased_object& object) {
  unsafe { return gti_internal::restore_reference<T>(object); }
}
unsafe mut T& restore_mut<T>(mut erased_object& object) {
  unsafe { return gti_internal::restore_reference_mut<T>(object); }
}
/// Complete object types supported by the runtime representation query.
[[unsatisfied("The type must have a complete object representation; copying and moving are not required.")]]
concept layout_queryable<T> = std::meta::has_object_layout<T>();
/// Complete storage elements that retain no checked external owner borrow.
[[unsatisfied("The element must be a complete object type without checked borrowed state. Raw pointers retain their unsafe validity obligations; copying or moving is not required.")]]
concept storage_element<T> = layout_queryable<T> && std::meta::is_borrow_free<T>();

/// End one live object's lifetime without releasing its storage.
/// The caller guarantees a live, writable, correctly aligned complete object,
/// exclusive access, and that no later cleanup will destroy that object again.
unsafe void destroy_at<T>(T* address) requires layout_queryable<T> {
  unsafe { gti_internal::object_destroy(address); }
}

/// Construct at a vacant final address, without allocating backing storage.
/// The caller guarantees writable extent/alignment and nonconflicting access.
/// On failure no complete object is published; GTI rolls back initialized
/// subobjects and prepared owning arguments using its ordinary cleanup rules.
/// Argument construction selects only safe constructors. For an unsafe
/// constructor, explicitly construct an owned value first and move it here.
[[discardable]]
unsafe T* construct_at<T, Args...>(T* address, Args... args)
    requires layout_queryable<T> {
  unsafe { gti_internal::object_construct(address, args...); }
  return address;
}

// A completed owned value has an ordinary exact T parameter, not a pack
// element. This also preserves payload-enum transport through normal source
// helpers without introducing a container-specific compiler exception.
namespace detail {
[[discardable]]
unsafe T* construct_value_at<T>(T* address, T value) requires layout_queryable<T> {
  unsafe { gti_internal::object_construct(address, std::move(value)); }
  return address;
}
}

/// Runtime layout of the compiler-selected GTI object representation.
/// This is neither a stable foreign ABI nor a compile-time layout promise.
struct layout {
  size_t bytes;
  size_t alignment;
  layout(size_t bytes, size_t alignment) : bytes(bytes), alignment(alignment) {}
};

/// Queries a complete object type without constructing or moving an object.
layout layout_of<T>() requires std::layout_queryable<T> {
  layout result{gti_internal::object_size<T>(),
                gti_internal::object_alignment<T>()};
  return result;
}

namespace detail {
Target convert_address<Target, T>(T* address) {
  return Target(address);
}
Target convert_address<Target, T>(const T* address) {
  return Target(address);
}
}

/// Erases only the pointee spelling; preserves constness and known origins.
void* erase_address<T>(T* address) {
  return detail::convert_address<void*, T>(address);
}

const void* erase_address<T>(const T* address) {
  return detail::convert_address<const void*, T>(address);
}

/// Selects a pointee spelling, without establishing initialization, alignment,
/// lifetime, ownership or permission to access the pointee.
T* typed_address<T>(void* address) {
  return detail::convert_address<T*, void>(address);
}

const T* typed_address<T>(const void* address) {
  return detail::convert_address<const T*, void>(address);
}

/// Inline bytes with T's size/alignment, but no initial live T. Destruction
/// never destroys a payload. Ordinary movement is available only for bitwise
/// relocatable T; copying additionally requires copyable T. Other carriers
/// remain fixed-address even while empty. A live owning payload must instead
/// be explicitly destroyed or relocated before its carrier goes out of scope.
class uninitialized<layout_queryable T> {
  mut gti_internal::uninitialized_storage<T> bytes{};
public:
  uninitialized() = default;
  const T* data() {
    unsafe { return std::typed_address<T>(std::erase_address(&this.bytes)); }
  }
  T* data() mut {
    unsafe { return std::typed_address<T>(std::erase_address(&this.bytes)); }
  }
};

/// Transfers one live object into distinct vacant storage without allocation.
/// Both pointers must denote writable, aligned complete regions for T. The
/// source must be live and exclusively accessible; the destination must be
/// vacant and nonoverlapping. Success ends the source lifetime without running
/// its GTI destructor and leaves exactly one live destination. Eligibility is
/// the existing failure-free generated relocation contract, never custom moves.
unsafe void relocate_at<T>(T* destination, T* source)
    requires layout_queryable<T> && relocatable<T> {
  unsafe { gti_internal::object_relocate(destination, source); }
}

/// Bulk transfer of count live bitwise-relocatable objects into vacant storage.
/// The caller guarantees nonoverlapping regions of at least count complete T
/// objects, valid alignment, exclusive access and a representable byte extent.
/// All source lifetimes end without cleanup; exactly count destination objects
/// become live. A zero count accesses neither pointer (null is then permitted).
unsafe void relocate_range_at<T>(T* destination, T* source, size_t count)
    requires layout_queryable<T> && bitwise_relocatable<T> {
  unsafe { gti_internal::object_relocate_range(destination, source, count); }
}

/// Asserts that address denotes a live T whose lifetime is covered by owner.
/// The caller proves alignment, initialization and aliasing. The returned
/// reference is checked against owner; the raw pointer itself remains nonowning.
[[borrowed_from(owner)]]
unsafe T& assume_ref<T, Owner>(const T* address, Owner& owner) {
  unsafe { return *address; }
}

/// Asserts exclusive access to a live T for the checked borrow of owner.
[[borrowed_from(owner)]]
unsafe mut T& assume_mut<T, Owner>(T* address, mut Owner& owner) {
  unsafe { return *address; }
}

/// Assert that count readable character objects at address remain valid for
/// the checked owner borrow. The caller proves extent, initialization and
/// aliasing; the result retains owner even when count is zero.
unsafe string_view assume_string_view<Owner>(
    const char* address, size_t count, Owner& owner) {
  unsafe { return gti_internal::text_view_from_address(address, count, owner); }
}

/// Assert that address is null or points to a readable NUL-terminated sequence
/// protected by owner. The checked owner dependency cannot be bypassed by the
/// unsafe validity assertion. No scan or character allocation happens here.
unsafe c_string assume_c_string<Owner>(const char* address, Owner& owner) {
  unsafe { return gti_internal::c_string_from_address(address, owner); }
}

/// Exposes a non-owning byte address without scanning or extending its lifetime.
/// The caller must preserve the original storage and prove every subsequent
/// read's validity; null remains null. No checked reference is created.
unsafe const uint8_t* c_string_bytes(c_string text) {
  unsafe { return gti_internal::runtime::gti_rt_c_string_bytes_v1(text); }
}

/// Exclusive ownership of one dynamically allocated `T`.
class unique_ptr<T> {
  mut gti_internal::unique_owner<T> owner = nullptr;

public:
  unique_ptr() = default;
  constexpr unique_ptr(nullptr_t empty) : owner(nullptr) {}

  constexpr unique_ptr(gti_internal::unique_owner<T> value)
      : owner(std::move(value)) {}

  constexpr void reset() mut {
    // Detach before cleanup. The local owns destruction and propagates any
    // failure through ordinary MIR scope cleanup; the receiver stays empty.
    unique_ptr<T> previous = unique_ptr<T>(std::move(this.owner));
    this.owner = nullptr;
  }

  constexpr void operator=(nullptr_t empty) mut {
    this.reset();
  }

  constexpr void swap(mut unique_ptr<T>& other) mut {
    gti_internal::unique_owner_swap(this.owner, other.owner);
  }

  unique_ptr<Base> upcast<Base>() mut {
    mut gti_internal::unique_owner<Base> converted =
        gti_internal::unique_owner_upcast<Base>(std::move(this.owner));
    this.owner = nullptr;
    return unique_ptr<Base>(std::move(converted));
  }

  constexpr T& operator*() {
    return gti_internal::unique_owner_borrow(this.owner);
  }

  constexpr mut T& operator*() mut {
    return gti_internal::unique_owner_borrow_mut(this.owner);
  }

  constexpr T& operator->() {
    return gti_internal::unique_owner_borrow(this.owner);
  }

  constexpr mut T& operator->() mut {
    return gti_internal::unique_owner_borrow_mut(this.owner);
  }

  constexpr operator bool() {
    return !gti_internal::unique_owner_is_null(this.owner);
  }

  constexpr bool operator==(nullptr_t other) {
    return gti_internal::unique_owner_is_null(this.owner);
  }

  constexpr bool operator!=(nullptr_t other) {
    return !gti_internal::unique_owner_is_null(this.owner);
  }
};

/// Allocates a `T` from `args` and returns its exclusive owner.
constexpr unique_ptr<T> make_unique<T, Args...>(Args... args) {
  return unique_ptr<T>(gti_internal::allocate_unique_owner<T>(args...));
}

unique_ptr<Base> upcast_unique<Base, Derived>(mut unique_ptr<Derived> owner) {
  return owner.upcast<Base>();
}

/// Recoverable failures from typed storage allocation.
enum class alloc_errc {
  invalid_alignment,
  size_overflow,
  resource_exhausted,
  invalid_region,
  invalid_state,
};

/// A requested minimum byte alignment for typed storage.
///
/// Allocation accepts nonzero powers of two. Keeping validation in the
/// fallible allocation operation makes invalid runtime input recoverable.
class alignment {
  size_t amount;

public:
  alignment(size_t bytes) : amount(bytes) {}

  /// Returns the requested minimum byte alignment.
  size_t bytes() {
    return this.amount;
  }
};

} // namespace std

namespace gti_internal {
// Source policy seal: no public spelling establishes allocator trust.
enum class resource_binding { trusted };
namespace runtime {
extern "C" {
uint64_t gti_rt_native_size_max_v1();
int32_t gti_rt_address_is_aligned_v1(const void* address, uint64_t alignment);
}
#if target.os == "windows"
extern "C" {
void* gti_rt_aligned_malloc_v1(uint64_t bytes, uint64_t alignment);
void gti_rt_aligned_free_v1(void* address);
}
#else
extern "C" {
uint64_t gti_rt_posix_pointer_size_v1();
int32_t gti_rt_posix_enomem_v1();
int32_t gti_rt_posix_einval_v1();
void* gti_rt_posix_memalign_v1(uint64_t bytes, uint64_t alignment, int32_t* status);
void gti_rt_posix_free_v1(void* address);
}
#endif
}
}


namespace std::detail {
/// Passive provider descriptor. Ownership belongs to a lease, not this value.
/// Copying it copies metadata only: it neither retains a region nor authorizes
/// a second release. The provider defines id; the process resource uses zero.
struct raw_allocation {
  void* address = nullptr;
  uint64_t bytes = 0;
  uint64_t alignment = 0;
  uint64_t id = 0;
  raw_allocation() {}
  raw_allocation(void* address, uint64_t bytes, uint64_t alignment, uint64_t id)
      : address(address), bytes(bytes), alignment(alignment), id(id) {}
};

} // namespace std::detail

namespace gti_internal {
// Infallible source policy distinguishes exhaustion from a malformed or
// overflowing request. Fallible callers keep the original alloc_errc value.
[[noreturn, track_caller]]
void fail_allocation(std::alloc_errc error) {
  if (error == std::alloc_errc::resource_exhausted) {
    gti_internal::require_allocation(false);
  }
  if (error == std::alloc_errc::size_overflow) {
    gti_internal::panic("Allocation size overflow");
  }
  gti_internal::panic("Invalid allocation request or resource region");
}

class process_resource {
public:
  process_resource() {}
  unsafe expected<std::detail::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    if (request.alignment == uint64_t(0) or
        (request.alignment & (request.alignment - uint64_t(1))) != uint64_t(0)) {
      return unexpected(std::alloc_errc::invalid_alignment);
    }
    uint64_t maximum = gti_internal::runtime::gti_rt_native_size_max_v1();
    if (request.bytes > maximum or request.alignment > maximum) {
      return unexpected(std::alloc_errc::size_overflow);
    }
    if (request.bytes == uint64_t(0)) {
      return std::detail::raw_allocation(nullptr, request.bytes, request.alignment, uint64_t(0));
    }
    unsafe {
#if target.os == "windows"
      void* address = gti_internal::runtime::gti_rt_aligned_malloc_v1(
          request.bytes, request.alignment);
#else
      mut uint64_t selected = request.alignment;
      uint64_t native_minimum = gti_internal::runtime::gti_rt_posix_pointer_size_v1();
      if (selected < native_minimum) { selected = native_minimum; }
      mut int32_t status = 0;
      void* address = gti_internal::runtime::gti_rt_posix_memalign_v1(
          request.bytes, selected, &status);
      if (status == gti_internal::runtime::gti_rt_posix_einval_v1()) {
        return unexpected(std::alloc_errc::invalid_alignment);
      }
      if (status == gti_internal::runtime::gti_rt_posix_enomem_v1()) {
        return unexpected(std::alloc_errc::resource_exhausted);
      }
      if (status != 0) { return unexpected(std::alloc_errc::invalid_region); }
#endif
      if (address == nullptr) { return unexpected(std::alloc_errc::resource_exhausted); }
      return std::detail::raw_allocation(address, request.bytes, request.alignment, uint64_t(0));
    }
  }
  unsafe void release(std::detail::raw_allocation allocation) {
    if (allocation.address == nullptr) { return; }
    unsafe {
#if target.os == "windows"
      gti_internal::runtime::gti_rt_aligned_free_v1(allocation.address);
#else
      gti_internal::runtime::gti_rt_posix_free_v1(allocation.address);
#endif
    }
  }
};
} // namespace gti_internal
namespace std::detail {
// No external owner borrow: this lease owns one process allocation outright.
// Shared observation cannot release or mutate its bytes. Its exclusive methods
// transfer the descriptor, and generated movement suppresses source cleanup.
[[unsafe_transfer, unsafe_share]]
class process_lease {
  mut std::detail::raw_allocation allocation;
public:
  process_lease()
      : allocation(std::detail::raw_allocation()) {}
  process_lease(gti_internal::empty_storage_adoption token, std::detail::raw_allocation allocation) : allocation(allocation) {}
  process_lease(process_lease& other) = delete;
  process_lease(process_lease&& other) = default;
  unsafe expected<std::detail::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    gti_internal::process_resource process{};
    unsafe { return process.allocate(request); }
  }
  std::detail::raw_allocation take() mut {
    std::detail::raw_allocation previous = this.allocation;
    this.allocation = std::detail::raw_allocation();
    return previous;
  }
  unsafe void attach(std::detail::raw_allocation allocation) mut { this.allocation = allocation; }
  uint64_t alignment() { return this.allocation.alignment; }
  void release() mut {
    std::detail::raw_allocation previous = this.take();
    gti_internal::process_resource process{};
    unsafe { process.release(previous); }
  }
  ~process_lease() { this.release(); }
};

class bulk_relocation_probe<T> {
public:
  bool available() requires std::bitwise_relocatable<T> { return true; }
};

}

namespace gti_internal {
concept sparse_element<T> = std::storage_element<T>;
concept movable_sparse_element<T> = sparse_element<T> && std::movable<T>;

// Source-defined initialized-prefix policy. The enclosing owner supplies one
// lease; these slots own object lifetimes, never the allocation itself.
class prefix_drain<std::layout_queryable T> {
  T* objects = nullptr;
  uint64_t* live = nullptr;
public:
  prefix_drain(T* objects, uint64_t* live) : objects(objects), live(live) {}
  void finish() mut {
    unsafe {
      while (*this.live > uint64_t(0)) {
        // The positive guard establishes this subtraction locally. Spell the
        // failure-free arithmetic explicitly so cleanup of a passive element
        // does not acquire an artificial unsigned-underflow failure edge.
        *this.live = integer_wrapping_sub(*this.live, uint64_t(1));
        std::destroy_at(this.objects + *this.live);
      }
    }
  }
  ~prefix_drain() { this.finish(); }
};

// Erasure retires the removed slot before its destructor executes. If that
// destructor fails, drain the detached suffix before the enclosing prefix.
class prefix_suffix_drain<std::layout_queryable T> {
  T* objects = nullptr;
  uint64_t first;
  mut uint64_t next;
public:
  prefix_suffix_drain(T* objects, uint64_t first, uint64_t next)
      : objects(objects), first(first), next(next) {}
  void disarm() mut { this.next = this.first; }
  void finish() mut {
    unsafe {
      while (this.next > this.first) {
        this.next = integer_wrapping_sub(this.next, uint64_t(1));
        std::destroy_at(this.objects + this.next);
      }
    }
  }
  ~prefix_suffix_drain() { this.finish(); }
};

// Byte ownership has no knowledge of initialized objects. A sequence supplies
// its one live length; every raw operation requires that sequence's proof.
class raw_buffer<sparse_element T, byte_lease Lease> {
public:
  // Compiler-private namespace visibility seals these source-only fields.
  // Direct field projection preserves the resource's original checked loan.
  mut Lease lease;
private:
  mut T* objects = nullptr;
  mut uint64_t slots = 0;
public:
  raw_buffer() requires std::default_initializable<Lease> : lease(Lease()) {}
  raw_buffer(Lease lease) : lease(std::move(lease)) {}
  raw_buffer(raw_buffer<T, Lease>& other) = delete;
  raw_buffer(raw_buffer<T, Lease>&& other) = default;
  uint64_t capacity() { return this.slots; }
  unsafe const T* address() { return this.objects; }
  unsafe T* address() mut { return this.objects; }
  // Both leases must refer to the same resource. Their checked bindings stay
  // in place; only allocation authority and its passive shape are exchanged.
  unsafe void swap_allocation(mut raw_buffer<T, Lease>& other) mut {
    std::detail::raw_allocation previous = this.lease.take();
    unsafe {
      this.lease.attach(other.lease.take());
      other.lease.attach(previous);
    }
    T* previous_objects = this.objects;
    this.objects = other.objects;
    other.objects = previous_objects;
    uint64_t previous_slots = this.slots;
    this.slots = other.slots;
    other.slots = previous_slots;
  }
  expected<void, std::alloc_errc> try_allocate(uint64_t count) mut {
    return this.try_allocate(count, std::layout_of<T>().alignment);
  }
  expected<void, std::alloc_errc> try_allocate(uint64_t count, uint64_t minimum) mut {
    if (this.slots != uint64_t(0)) {
      return unexpected(std::alloc_errc::invalid_state);
    }
    mut T* address = nullptr;
    {
      auto allocated = try_allocate_objects<T, Lease>(this.lease, count, minimum);
      if (!allocated) { return unexpected(allocated.error()); }
      if (count != uint64_t(0)) {
        std::detail::raw_allocation region = std::move(allocated).value();
        address = std::typed_address<T>(region.address);
      }
    }
    this.objects = address;
    this.slots = count;
    return;
  }
  // Both buffers are distinct; count live source objects fit in vacant
  // destination storage. Relocation cannot fail or call custom movement.
  unsafe void relocate_to(mut raw_buffer<T, Lease>& destination, uint64_t count) mut
      requires std::relocatable<T> {
    if (count == uint64_t(0)) { return; }
    unsafe {
      if constexpr (requires(std::detail::bulk_relocation_probe<T>& probe) {
        { probe.available() } -> bool;
      }) {
        std::relocate_range_at(destination.objects, this.objects, count);
      } else {
        for (mut uint64_t index = 0; index < count;
             index = integer_wrapping_add(index, uint64_t(1))) {
          std::relocate_at(destination.objects + index, this.objects + index);
        }
      }
    }
  }
};

class prefix_slots<sparse_element T, byte_lease Lease> {
public:
  mut raw_buffer<T, Lease> buffer;
private:
  mut uint64_t live = 0;
public:
  prefix_slots() requires std::default_initializable<Lease>
      : buffer(raw_buffer<T, Lease>()) {}
  prefix_slots(Lease lease) : buffer(raw_buffer<T, Lease>(std::move(lease))) {}
  prefix_slots(prefix_slots<T, Lease>& other) = delete;
  prefix_slots(prefix_slots<T, Lease>&& other) = default;
  uint64_t capacity() { return this.buffer.capacity(); }
  uint64_t length() { return this.live; }
  expected<void, std::alloc_errc> try_allocate(uint64_t count) mut {
    return this.try_allocate(count, std::layout_of<T>().alignment);
  }
  expected<void, std::alloc_errc> try_allocate(uint64_t count, uint64_t minimum) mut {
    {
      auto allocated = this.buffer.try_allocate(count, minimum);
      if (!allocated) { return unexpected(allocated.error()); }
    }
    // Publish the empty initialized prefix after allocation and temporary
    // cleanup. Failed/rejected allocation leaves the existing prefix intact.
    this.live = uint64_t(0);
    return;
  }
  unsafe const T* address() { unsafe { return this.buffer.address(); } }
  unsafe T* address() mut { unsafe { return this.buffer.address(); } }
  T& read(uint64_t index) {
    index_bounds_check(index, this.live);
    unsafe { return this.read_unchecked(index); }
  }
  mut T& read_mut(uint64_t index) mut {
    index_bounds_check(index, this.live);
    unsafe { return this.read_mut_unchecked(index); }
  }
  unsafe T& read_unchecked(uint64_t index) {
    unsafe { return std::assume_ref(this.buffer.address() + index, this); }
  }
  unsafe mut T& read_mut_unchecked(uint64_t index) mut {
    unsafe { return std::assume_mut(this.buffer.address() + index, this); }
  }
  void append<Args...>(Args... args) mut {
    require_relocation_capacity(this.live < this.capacity());
    unsafe { this.append_unchecked(args...); }
  }
  unsafe void append_unchecked<Args...>(Args... args) mut {
    unsafe { std::construct_at(this.buffer.address() + this.live, args...); }
    this.live = integer_wrapping_add(this.live, uint64_t(1));
  }
  void append_value(T value) mut {
    require_relocation_capacity(this.live < this.capacity());
    unsafe { this.append_value_unchecked(std::move(value)); }
  }
  unsafe void append_value_unchecked(T value) mut {
    unsafe { std::detail::construct_value_at(this.buffer.address() + this.live, std::move(value)); }
    this.live = integer_wrapping_add(this.live, uint64_t(1));
  }
  void pop() mut {
    require_live_storage(this.live > uint64_t(0));
    unsafe { this.pop_unchecked(); }
  }
  unsafe void pop_unchecked() mut {
    this.live = integer_wrapping_sub(this.live, uint64_t(1));
    unsafe { std::destroy_at(this.buffer.address() + this.live); }
  }
  void clear() mut {
    unsafe {
      mut prefix_drain<T> pending{this.buffer.address(), &this.live};
      pending.finish();
    }
  }
  void relocate_to(mut prefix_slots<T, Lease>& destination) mut
      requires std::relocatable<T> {
    require_relocation_destination(destination.live == uint64_t(0));
    require_relocation_capacity(destination.capacity() >= this.live);
    unsafe { this.relocate_to_unchecked(destination); }
  }
  unsafe void relocate_to_unchecked(mut prefix_slots<T, Lease>& destination) mut
      requires std::relocatable<T> {
    unsafe { this.buffer.relocate_to(destination.buffer, this.live); }
    destination.live = this.live;
    this.live = uint64_t(0);
  }
  void insert(uint64_t index, T value) mut requires std::relocatable<T> {
    if (index > this.live) index_bounds_check(index, this.live);
    require_relocation_capacity(this.live < this.capacity());
    unsafe { this.insert_unchecked(index, std::move(value)); }
  }
  unsafe void insert_unchecked(uint64_t index, T value) mut requires std::relocatable<T> {
    unsafe {
      T* objects = this.buffer.address();
      mut uint64_t destination = this.live;
      while (destination > index) {
        uint64_t source = integer_wrapping_sub(destination, uint64_t(1));
        std::relocate_at(objects + destination, objects + source);
        destination = source;
      }
      std::detail::construct_value_at(objects + index, std::move(value));
    }
    this.live = integer_wrapping_add(this.live, uint64_t(1));
  }
  void erase(uint64_t index) mut requires std::relocatable<T> {
    index_bounds_check(index, this.live);
    unsafe { this.erase_unchecked(index); }
  }
  unsafe void erase_unchecked(uint64_t index) mut requires std::relocatable<T> {
    uint64_t previous = this.live;
    this.live = index;
    unsafe {
      T* objects = this.buffer.address();
      uint64_t next = integer_wrapping_add(index, uint64_t(1));
      mut prefix_suffix_drain<T> pending{objects, next, previous};
      std::destroy_at(objects + index);
      pending.disarm();
      for (mut uint64_t source = next; source < previous;
           source = integer_wrapping_add(source, uint64_t(1))) {
        std::relocate_at(objects + integer_wrapping_sub(source, uint64_t(1)), objects + source);
        this.live = integer_wrapping_add(this.live, uint64_t(1));
      }
    }
  }
  void swap_elements(uint64_t left, uint64_t right) mut
      requires std::relocatable<T> {
    index_bounds_check(left, this.live);
    index_bounds_check(right, this.live);
    unsafe { this.swap_elements_unchecked(left, right); }
  }
  unsafe void swap_elements_unchecked(uint64_t left, uint64_t right) mut
      requires std::relocatable<T> {
    if (left == right) { return; }
    mut std::uninitialized<T> temporary{};
    unsafe {
      T* objects = this.buffer.address();
      std::relocate_at(temporary.data(), objects + left);
      std::relocate_at(objects + left, objects + right);
      std::relocate_at(objects + right, temporary.data());
    }
  }
  unsafe void swap(mut prefix_slots<T, Lease>& other) mut {
    unsafe { this.buffer.swap_allocation(other.buffer); }
    uint64_t previous_live = this.live;
    this.live = other.live;
    other.live = previous_live;
  }
  ~prefix_slots() { this.clear(); }
};

// Ordinary GTI cleanup policy. A local guard resumes the remaining reverse
// traversal if the first destructor fails; it never retries a retired slot.
class sparse_drain<std::layout_queryable T> {
  T* objects = nullptr;
  uint8_t* live = nullptr;
  mut uint64_t next;
public:
  sparse_drain(T* objects, uint8_t* live, uint64_t count)
      : objects(objects), live(live), next(count) {}
  void finish() mut {
    unsafe {
      while (this.next > uint64_t(0)) {
        this.next--;
        if (this.live[this.next] != uint8_t(0)) {
          this.live[this.next] = uint8_t(0);
          std::destroy_at(this.objects + this.next);
        }
      }
    }
  }
  ~sparse_drain() { this.finish(); }
};

// Owns element lifetimes only. Enclosing leases keep both disjoint regions
// alive until after this object is destroyed, and alone release their bytes.
// This is source policy, not a compiler-recognized capability or public type.
[[unsafe_transfer(T), unsafe_share(T)]]
class sparse_slots<gti_internal::sparse_element T> {
  mut T* objects = nullptr;
  mut uint8_t* live = nullptr;
  mut uint64_t slots = 0;
public:
  sparse_slots() {}
  sparse_slots(sparse_slots<T>& other) = delete;
  sparse_slots(sparse_slots<T>&& other) = default;

  // The caller supplies exclusive vacant object storage and writable metadata
  // with sufficient extent/alignment; neither region may move or be released
  // until the element owner dies. Metadata initialization cannot invoke T.
  unsafe void attach(T* objects, uint8_t* live, uint64_t count) mut {
    require_relocation_capacity(this.slots == uint64_t(0));
    unsafe {
      for (mut uint64_t index = 0; index < count; index++) {
        std::construct_at(live + index, uint8_t(0));
      }
    }
    this.objects = objects;
    this.live = live;
    this.slots = count;
  }
  uint64_t capacity() { return this.slots; }
  bool initialized(uint64_t index) {
    if (index >= this.slots) { return false; }
    unsafe { return this.live[index] != uint8_t(0); }
  }
  [[discardable]]
  mut T& emplace<Args...>(uint64_t index, Args... args) mut {
    index_bounds_check(index, this.slots);
    require_vacant_storage(!this.initialized(index));
    unsafe {
      std::construct_at(this.objects + index, args...);
      this.live[index] = uint8_t(1);
      return std::assume_mut(this.objects + index, this);
    }
  }
  T& read(uint64_t index) {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe { return std::assume_ref(this.objects + index, this); }
  }
  mut T& read_mut(uint64_t index) mut {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe { return std::assume_mut(this.objects + index, this); }
  }
  void destroy(uint64_t index) mut {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe {
      this.live[index] = uint8_t(0);
      std::destroy_at(this.objects + index);
    }
  }
  void clear() mut {
    mut sparse_drain<T> pending{this.objects, this.live, this.slots};
    pending.finish();
  }
  void relocate_to(mut sparse_slots<T>& destination, uint64_t count) mut
      requires std::relocatable<T> {
    require_relocation_capacity(count <= this.slots && count <= destination.slots);
    for (mut uint64_t index = 0; index < count; index++) {
      require_relocation_source(this.initialized(index));
      require_relocation_destination(!destination.initialized(index));
    }
    unsafe {
      for (mut uint64_t index = 0; index < count; index++) {
        std::relocate_at(destination.objects + index, this.objects + index);
        this.live[index] = uint8_t(0);
        destination.live[index] = uint8_t(1);
      }
    }
  }
  void shift_right(uint64_t first, uint64_t last) mut
      requires std::relocatable<T> {
    require_relocation_capacity(first <= last && last < this.slots);
    require_relocation_destination(!this.initialized(last));
    for (mut uint64_t index = first; index < last; index++) {
      require_relocation_source(this.initialized(index));
    }
    unsafe {
      mut uint64_t destination = last;
      while (destination > first) {
        uint64_t source = destination - uint64_t(1);
        std::relocate_at(this.objects + destination, this.objects + source);
        this.live[source] = uint8_t(0);
        this.live[destination] = uint8_t(1);
        destination--;
      }
    }
  }
  void shift_left(uint64_t first, uint64_t last) mut
      requires std::relocatable<T> {
    require_relocation_capacity(first < last && last <= this.slots);
    require_relocation_destination(!this.initialized(first));
    for (mut uint64_t index = first + uint64_t(1); index < last; index++) {
      require_relocation_source(this.initialized(index));
    }
    unsafe {
      for (mut uint64_t source = first + uint64_t(1); source < last; source++) {
        uint64_t destination = source - uint64_t(1);
        std::relocate_at(this.objects + destination, this.objects + source);
        this.live[source] = uint8_t(0);
        this.live[destination] = uint8_t(1);
      }
    }
  }
  ~sparse_slots() { this.clear(); }
};

// Defensive descriptor checks are not proof of the unsafe provider contract.
// The native seam observes pointer alignment; all allocation policy stays here.
expected<void, std::alloc_errc> validate_region(
    std::detail::raw_allocation allocation, std::layout requested) {
  if (allocation.alignment < requested.alignment) {
    return unexpected(std::alloc_errc::invalid_region);
  }
  if (allocation.alignment == uint64_t(0) ||
      (allocation.alignment & (allocation.alignment - uint64_t(1))) != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_alignment);
  }
  uint64_t maximum = runtime::gti_rt_native_size_max_v1();
  if (allocation.bytes > maximum || allocation.alignment > maximum) {
    return unexpected(std::alloc_errc::size_overflow);
  }
  if (allocation.address == nullptr || allocation.bytes < requested.bytes) {
    return unexpected(std::alloc_errc::invalid_region);
  }
  unsafe {
    if (runtime::gti_rt_address_is_aligned_v1(allocation.address, allocation.alignment) == 0) {
      return unexpected(std::alloc_errc::invalid_alignment);
    }
  }
  return;
}

// A lease retains an original byte descriptor and its selected provider.
concept byte_lease<L> = requires(L& lease, std::layout request) {
  unsafe { lease.allocate(request) } -> expected<std::detail::raw_allocation, std::alloc_errc>;
} && requires(mut L& lease, std::detail::raw_allocation allocation) {
  unsafe { lease.attach(allocation) } -> void;
} && requires(mut L& lease) {
  { lease.release() } -> void;
} && requires(mut L& lease) {
  { lease.take() } -> std::detail::raw_allocation;
};

// Internal owner operation: the supplied lease must be empty. Callers retain
// it through all object cleanup and publish slots only after this succeeds.
// A malformed provider descriptor is attached before validation so release
// receives that exact original descriptor, not a repaired request-sized one.
expected<std::detail::raw_allocation, std::alloc_errc> try_allocate_objects<T, Lease>(
    mut Lease& objects,
    uint64_t count, uint64_t minimum) requires sparse_element<T> && byte_lease<Lease> {
  if (minimum == uint64_t(0) || (minimum & (minimum - uint64_t(1))) != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_alignment);
  }
  std::layout object = std::layout_of<T>();
  mut uint64_t selected = object.alignment;
  if (minimum > selected) { selected = minimum; }
  uint64_t maximum = runtime::gti_rt_native_size_max_v1();
  if (selected > maximum || count > maximum / object.bytes) {
    return unexpected(std::alloc_errc::size_overflow);
  }
  if (count == uint64_t(0)) { return std::detail::raw_allocation(); }
  std::layout request{count * object.bytes, selected};
  unsafe {
    auto attempt = objects.allocate(request);
    if (!attempt) { return unexpected(attempt.error()); }
    std::detail::raw_allocation region = std::move(attempt).value();
    objects.attach(region);
    auto valid = validate_region(region, request);
    if (!valid) {
      objects.release();
      return unexpected(valid.error());
    }
    return std::move(region);
  }
}

expected<void, std::alloc_errc> try_allocate_sparse<T, Lease>(
    mut Lease& objects, mut Lease& metadata, mut sparse_slots<T>& destination,
    uint64_t count, uint64_t minimum) requires sparse_element<T> && byte_lease<Lease> {
  // Sparse ownership needs two regions. Publication is last; a failed second
  // request returns the first region through its own lease.
  if (destination.capacity() != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_state);
  }
  if (minimum == uint64_t(0) || (minimum & (minimum - uint64_t(1))) != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_alignment);
  }
  std::layout object = std::layout_of<T>();
  mut uint64_t selected = object.alignment;
  if (minimum > selected) { selected = minimum; }
  uint64_t maximum = runtime::gti_rt_native_size_max_v1();
  if (selected > maximum || count > maximum / object.bytes) {
    return unexpected(std::alloc_errc::size_overflow);
  }
  if (count == uint64_t(0)) { return; }
  std::layout request{count * object.bytes, selected};
  unsafe {
    auto attempt = objects.allocate(request);
    if (!attempt) { return unexpected(attempt.error()); }
    std::detail::raw_allocation region = std::move(attempt).value();
    objects.attach(region);
    auto valid = validate_region(region, request);
    if (!valid) {
      objects.release();
      return unexpected(valid.error());
    }
    // uint8_t is exactly one byte; no hidden heap or bitmap allocation occurs.
    std::layout metadata_request{count, std::layout_of<uint8_t>().alignment};
    auto flags_attempt = metadata.allocate(metadata_request);
    if (!flags_attempt) {
      objects.release();
      return unexpected(flags_attempt.error());
    }
    std::detail::raw_allocation flags = std::move(flags_attempt).value();
    metadata.attach(flags);
    auto valid_flags = validate_region(flags, metadata_request);
    if (!valid_flags) {
      metadata.release();
      objects.release();
      return unexpected(valid_flags.error());
    }
    destination.attach(std::typed_address<T>(region.address),
                       std::typed_address<uint8_t>(flags.address), count);
  }
  return;
}
}

namespace std {
namespace detail {
// Source owner: one process region and one initialized length, no slot map.
[[unsafe_transfer(T), unsafe_share(T)]]
class prefix_owner<std::storage_element T> {
  mut gti_internal::prefix_slots<T, process_lease> data;
public:
  prefix_owner() {}
  prefix_owner(uint64_t count) {
    auto allocated = this.data.try_allocate(count);
    if (!allocated) { gti_internal::fail_allocation(allocated.error()); }
  }
  prefix_owner(prefix_owner<T>& other) = delete;
  prefix_owner(prefix_owner<T>&& other) = default;
  expected<void, alloc_errc> try_allocate(uint64_t count) mut {
    return this.data.try_allocate(count);
  }
  uint64_t capacity() { return this.data.capacity(); }
  uint64_t length() { return this.data.length(); }
  unsafe const T* address() { unsafe { return this.data.address(); } }
  unsafe T* address() mut { unsafe { return this.data.address(); } }
  T& read(uint64_t index) { return this.data.read(index); }
  mut T& read_mut(uint64_t index) mut { return this.data.read_mut(index); }
  unsafe T& read_unchecked(uint64_t index) {
    unsafe { return this.data.read_unchecked(index); }
  }
  unsafe mut T& read_mut_unchecked(uint64_t index) mut {
    unsafe { return this.data.read_mut_unchecked(index); }
  }
  void append<Args...>(Args... args) mut { this.data.append(args...); }
  void append_value(T value) mut { this.data.append_value(std::move(value)); }
  unsafe void append_unchecked<Args...>(Args... args) mut {
    unsafe { this.data.append_unchecked(args...); }
  }
  unsafe void append_value_unchecked(T value) mut {
    unsafe { this.data.append_value_unchecked(std::move(value)); }
  }
  void pop() mut { this.data.pop(); }
  unsafe void pop_unchecked() mut { unsafe { this.data.pop_unchecked(); } }
  void clear() mut { this.data.clear(); }
  void relocate_to(mut prefix_owner<T>& destination) mut
      requires std::relocatable<T> { this.data.relocate_to(destination.data); }
  unsafe void relocate_to_unchecked(mut prefix_owner<T>& destination) mut
      requires std::relocatable<T> {
    unsafe { this.data.relocate_to_unchecked(destination.data); }
  }
  void insert(uint64_t index, T value) mut requires std::relocatable<T> {
    this.data.insert(index, std::move(value));
  }
  void erase(uint64_t index) mut requires std::relocatable<T> { this.data.erase(index); }
  unsafe void insert_unchecked(uint64_t index, T value) mut requires std::relocatable<T> {
    unsafe { this.data.insert_unchecked(index, std::move(value)); }
  }
  unsafe void erase_unchecked(uint64_t index) mut requires std::relocatable<T> {
    unsafe { this.data.erase_unchecked(index); }
  }
  void swap_elements(uint64_t left, uint64_t right) mut requires std::relocatable<T> {
    this.data.swap_elements(left, right);
  }
  unsafe void swap_elements_unchecked(uint64_t left, uint64_t right) mut requires std::relocatable<T> {
    unsafe { this.data.swap_elements_unchecked(left, right); }
  }
};
}

namespace detail {
/// A slot endpoint is not an element. Sparse cursors skip vacant positions.
class memory_slot_sentinel {
  size_t limit;
public:
  memory_slot_sentinel(size_t limit) : limit(limit) {}
  size_t position() { return this.limit; }
};

class sparse_iterator<std::storage_element T, uint64_t Reverse = 0> {
  gti_internal::sparse_slots<T>& slots;
  mut size_t position;
public:
  sparse_iterator(gti_internal::sparse_slots<T>& slots, size_t position)
      : slots(slots), position(position) {
    gti_internal::require_container_argument(position <= slots.capacity());
    if constexpr (Reverse != 0) {
      mut size_t previous = this.position;
      this.position = size_t(0);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); break; }
      }
    } else {
      while (this.position < this.slots.capacity() && !this.slots.initialized(this.position)) {
        this.position++;
      }
    }
  }
  T& operator*() {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.slots.capacity(), ptrdiff_t(-1));
      return this.slots.read(selected);
    }
    return this.slots.read(this.position);
  }
  T& operator->() { return *this; }
  void operator++() mut {
    if constexpr (Reverse != 0) {
      gti_internal::require_container_argument(this.position > size_t(0));
      mut size_t previous = this.position - size_t(1);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); return; }
      }
      this.position = size_t(0);
      return;
    }
    gti_internal::require_container_argument(this.position < this.slots.capacity());
    mut size_t next = this.position + size_t(1);
    while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
    this.position = next;
  }
  void operator--() mut {
    if constexpr (Reverse != 0) {
      mut size_t next = this.position;
      while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
      gti_internal::require_container_argument(next < this.slots.capacity());
      this.position = next + size_t(1);
      return;
    }
    mut size_t previous = this.position;
    mut bool found = false;
    while (previous > size_t(0)) {
      previous--;
      if (this.slots.initialized(previous)) { found = true; break; }
    }
    gti_internal::require_container_argument(found);
    this.position = previous;
  }
  bool operator!=(memory_slot_sentinel end) { return this.position != end.position(); }
  bool operator==(memory_slot_sentinel end) { return this.position == end.position(); }
  bool operator!=(sparse_iterator<T, Reverse>& other) { return this.position != other.position; }
  bool operator==(sparse_iterator<T, Reverse>& other) { return this.position == other.position; }
};

class sparse_mut_iterator<std::storage_element T, uint64_t Reverse = 0> {
  mut gti_internal::sparse_slots<T>& slots;
  mut size_t position;
public:
  sparse_mut_iterator(mut gti_internal::sparse_slots<T>& slots, size_t position)
      : slots(slots), position(position) {
    gti_internal::require_container_argument(position <= slots.capacity());
    if constexpr (Reverse != 0) {
      mut size_t previous = this.position;
      this.position = size_t(0);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); break; }
      }
    } else {
      while (this.position < this.slots.capacity() && !this.slots.initialized(this.position)) {
        this.position++;
      }
    }
  }
  T& operator*() {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.slots.capacity(), ptrdiff_t(-1));
      return this.slots.read(selected);
    }
    return this.slots.read(this.position);
  }
  mut T& operator*() mut {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.slots.capacity(), ptrdiff_t(-1));
      return this.slots.read_mut(selected);
    }
    return this.slots.read_mut(this.position);
  }
  T& operator->() { return *this; }
  mut T& operator->() mut { return *this; }
  void operator++() mut {
    if constexpr (Reverse != 0) {
      gti_internal::require_container_argument(this.position > size_t(0));
      mut size_t previous = this.position - size_t(1);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); return; }
      }
      this.position = size_t(0);
      return;
    }
    gti_internal::require_container_argument(this.position < this.slots.capacity());
    mut size_t next = this.position + size_t(1);
    while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
    this.position = next;
  }
  void operator--() mut {
    if constexpr (Reverse != 0) {
      mut size_t next = this.position;
      while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
      gti_internal::require_container_argument(next < this.slots.capacity());
      this.position = next + size_t(1);
      return;
    }
    mut size_t previous = this.position;
    mut bool found = false;
    while (previous > size_t(0)) {
      previous--;
      if (this.slots.initialized(previous)) { found = true; break; }
    }
    gti_internal::require_container_argument(found);
    this.position = previous;
  }
  bool operator!=(memory_slot_sentinel end) { return this.position != end.position(); }
  bool operator==(memory_slot_sentinel end) { return this.position == end.position(); }
};
}

/// A move-only owner of partially initialized typed storage.
///
/// `T` must not contain borrowed state. Final-address emplacement supports
/// immovable objects; moving this owner never moves its elements.
/// Each slot is independently uninitialized or contains one live `T`.
/// Construction, access, and destruction are checked. Destruction of the
/// owner drops every remaining live slot once in reverse slot order and then
/// releases the allocation. `release()` performs that cleanup early and
/// leaves an empty owner; it never detaches an unmanaged allocation address.
[[unsafe_transfer(T), unsafe_share(T)]]
class storage<gti_internal::sparse_element T> {
  mut std::detail::process_lease objects;
  mut std::detail::process_lease metadata;
  mut gti_internal::sparse_slots<T> data;

public:
  using const_iterator = detail::sparse_iterator<T>;
  using iterator = detail::sparse_mut_iterator<T>;
  using const_reverse_iterator = detail::sparse_iterator<T, 1>;
  using reverse_iterator = detail::sparse_mut_iterator<T, 1>;
  using sentinel = detail::memory_slot_sentinel;

  // Source factory token prevents unchecked adoption by application code.
  storage(gti_internal::empty_storage_adoption token,
          std::detail::process_lease objects,
          std::detail::process_lease metadata,
          gti_internal::sparse_slots<T> data)
      : objects(std::move(objects)), metadata(std::move(metadata)),
        data(std::move(data)) {}

  storage(storage<T>& other) = delete;
  storage(storage<T>&& other) = default;

  /// Traverses live slots in increasing slot order, never vacant capacity.
  const_iterator begin() { return const_iterator(this.data, size_t(0)); }
  const_iterator cbegin() { return this.begin(); }
  sentinel end() { return sentinel(this.capacity()); }
  sentinel cend() { return this.end(); }
  const_iterator end_iterator() { return const_iterator(this.data, this.capacity()); }
  iterator begin_mut() mut { return iterator(this.data, size_t(0)); }
  iterator end_mut() mut { return iterator(this.data, this.capacity()); }
  const_reverse_iterator rbegin() { return const_reverse_iterator(this.data, this.capacity()); }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  sentinel rend() { return sentinel(size_t(0)); }
  sentinel crend() { return this.rend(); }
  reverse_iterator rbegin_mut() mut { return reverse_iterator(this.data, this.capacity()); }
  reverse_iterator rend_mut() mut { return reverse_iterator(this.data, size_t(0)); }

  /// Returns the number of owned `T` slots.
  size_t capacity() {
    return this.data.capacity();
  }

  /// Returns whether the checked slot currently contains a live `T`.
  bool initialized(size_t index) {
    gti_internal::index_bounds_check(index, this.capacity());
    return this.data.initialized(index);
  }

  /// Moves one completed `T` into an uninitialized checked slot.
  ///
  /// Construction of the argument completes before this operation begins, so
  /// any failure in that construction follows ordinary MIR cleanup without
  /// publishing a new slot lifetime. Duplicate construction is a defined
  /// runtime failure.
  void construct(size_t index, T value) mut requires std::movable<T> {
    gti_internal::index_bounds_check(index, this.capacity());
    this.data.emplace(index, std::move(value));
  }

  /// Constructs directly in the final slot and borrows the completed object.
  /// Failed construction cleans up its initialized members and leaves the
  /// slot uninitialized; it propagates the constructor's original failure.
  [[discardable]]
  mut T& emplace<Args...>(size_t index, Args... args) mut {
    return this.data.emplace(index, args...);
  }

  /// Destroys the live value in one checked slot.
  void destroy(size_t index) mut {
    gti_internal::index_bounds_check(index, this.capacity());
    this.data.destroy(index);
  }

  /// Consumes the live prefix [0, count) into the same empty destination slots.
  /// Both allocations are retained. All capacity and liveness checks finish
  /// before the transfer begins; the source prefix becomes uninitialized.
  /// Outstanding element loans forbid this exclusive operation. Replacement
  /// of an already-live destination is deliberately not supported.
  void relocate_to(mut storage<T>& destination, size_t count) mut
      requires std::movable<T> && std::relocatable<T> {
    this.data.relocate_to(destination.data, count);
  }

  /// Returns a checked read-only reference to a live slot.
  T& get(size_t index) {
    gti_internal::index_bounds_check(index, this.capacity());
    return this.data.read(index);
  }

  /// Returns a checked exclusive reference to a live slot.
  mut T& get_mut(size_t index) mut {
    gti_internal::index_bounds_check(index, this.capacity());
    return this.data.read_mut(index);
  }

  /// Destroys every live slot once in reverse slot order.
  void clear() mut { this.data.clear(); }

  /// Destroys remaining live slots and releases the backing allocation.
  /// The receiver becomes empty before cleanup begins, including when an
  /// element destructor raises defined failure. Releasing an empty owner is
  /// harmless. Live element borrows prevent this exclusive operation.
  void release() mut {
    std::detail::process_lease previous_objects{gti_internal::empty_storage_adoption::trusted, this.objects.take()};
    std::detail::process_lease previous_metadata{gti_internal::empty_storage_adoption::trusted, this.metadata.take()};
    gti_internal::sparse_slots<T> previous = std::move(this.data);
    this.data = gti_internal::sparse_slots<T>();
  }
};

/// The process allocator capability used to create typed storage owners.
///
/// The initial allocator is stateless. The returned storage carries all
/// release authority, so it never borrows this object and remains valid after
/// the allocator value is destroyed.
class allocator {
  expected<storage<T>, alloc_errc>
  try_storage_impl<T>(size_t count, uint64_t minimum_alignment)
      requires gti_internal::sparse_element<T> {
    mut std::detail::process_lease objects{};
    mut std::detail::process_lease metadata{};
    mut gti_internal::sparse_slots<T> candidate{};
    mut uint64_t selected = minimum_alignment;
    if (selected == uint64_t(0)) { selected = layout_of<T>().alignment; }
    auto attempt = gti_internal::try_allocate_sparse(objects, metadata, candidate,
                                                    count, selected);
    if (!attempt) { return unexpected(attempt.error()); }
    return storage<T>(gti_internal::empty_storage_adoption::trusted,
                      std::move(objects), std::move(metadata), std::move(candidate));
  }

public:
  allocator() {}

  /// Attempts to create naturally aligned typed storage.
  expected<storage<T>, alloc_errc>
  try_storage<T>(size_t count) requires gti_internal::sparse_element<T> {
    return this.try_storage_impl<T>(count, uint64_t(0));
  }

  /// Attempts to create typed storage with a minimum byte alignment.
  expected<storage<T>, alloc_errc>
  try_storage<T>(size_t count, alignment requested) requires gti_internal::sparse_element<T> {
    size_t bytes = requested.bytes();
    if (bytes == size_t(0) or
        (bytes & (bytes - size_t(1))) != size_t(0)) {
      return unexpected(alloc_errc::invalid_alignment);
    }
    return this.try_storage_impl<T>(count, bytes);
  }
};

/// Recoverable insertion outcomes for a fixed-capacity arena.
enum class arena_errc {
  full,
};

namespace detail {
// A monotonic arena has a live prefix; unlike sparse traversal, movement and
// distance are constant-time and refer only to that prefix, not spare slots.
class arena_iterator<std::storage_element T, uint64_t Reverse = 0> {
  storage<T>& slots;
  size_t limit;
  mut size_t position;
public:
  arena_iterator(storage<T>& slots, size_t limit, size_t position)
      : slots(slots), limit(limit), position(position) {
    gti_internal::require_container_argument(position <= limit && limit <= slots.capacity());
  }
  T& operator*() {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.limit, ptrdiff_t(-1));
      return this.slots.get(selected);
    }
    gti_internal::index_bounds_check(this.position, this.limit);
    return this.slots.get(this.position);
  }
  T& operator->() { return *this; }
  T& operator[](ptrdiff_t offset) {
    mut size_t selected = checked_iterator_position(this.position, size_t(0), this.limit, offset, Reverse != 0);
    if constexpr (Reverse != 0) { selected = checked_iterator_position(selected, size_t(0), this.limit, ptrdiff_t(-1)); }
    gti_internal::index_bounds_check(selected, this.limit);
    return this.slots.get(selected);
  }
  void operator++() mut {
    this.position = checked_iterator_step<Reverse>(this.position, size_t(0), this.limit);
  }
  void operator--() mut {
    this.position = checked_iterator_step<Reverse, 1>(this.position, size_t(0), this.limit);
  }
  void operator+=(ptrdiff_t offset) mut {
    this.position = checked_iterator_position(this.position, size_t(0), this.limit, offset, Reverse != 0);
  }
  void operator-=(ptrdiff_t offset) mut {
    this.position = checked_iterator_position(this.position, size_t(0), this.limit, offset, Reverse == 0);
  }
  ptrdiff_t operator-(memory_slot_sentinel end) {
    if constexpr (Reverse != 0) { return checked_iterator_difference(end.position(), this.position); }
    return checked_iterator_difference(this.position, end.position());
  }
  ptrdiff_t operator-(arena_iterator<T, Reverse>& other) {
    if constexpr (Reverse != 0) { return checked_iterator_difference(other.position, this.position); }
    return checked_iterator_difference(this.position, other.position);
  }
  bool operator!=(memory_slot_sentinel end) { return this.position != end.position(); }
  bool operator==(memory_slot_sentinel end) { return this.position == end.position(); }
  bool operator!=(arena_iterator<T, Reverse>& other) { return this.position != other.position; }
  bool operator==(arena_iterator<T, Reverse>& other) { return this.position == other.position; }
};

class arena_mut_iterator<std::storage_element T, uint64_t Reverse = 0> {
  mut storage<T>& slots;
  size_t limit;
  mut size_t position;
public:
  arena_mut_iterator(mut storage<T>& slots, size_t limit, size_t position)
      : slots(slots), limit(limit), position(position) {
    gti_internal::require_container_argument(position <= limit && limit <= slots.capacity());
  }
  T& operator*() {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.limit, ptrdiff_t(-1));
      return this.slots.get(selected);
    }
    gti_internal::index_bounds_check(this.position, this.limit);
    return this.slots.get(this.position);
  }
  mut T& operator*() mut {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.limit, ptrdiff_t(-1));
      return this.slots.get_mut(selected);
    }
    gti_internal::index_bounds_check(this.position, this.limit);
    return this.slots.get_mut(this.position);
  }
  T& operator->() { return *this; }
  mut T& operator->() mut { return *this; }
  T& operator[](ptrdiff_t offset) {
    mut size_t selected = checked_iterator_position(this.position, size_t(0), this.limit, offset, Reverse != 0);
    if constexpr (Reverse != 0) { selected = checked_iterator_position(selected, size_t(0), this.limit, ptrdiff_t(-1)); }
    gti_internal::index_bounds_check(selected, this.limit);
    return this.slots.get(selected);
  }
  mut T& operator[](ptrdiff_t offset) mut {
    mut size_t selected = checked_iterator_position(this.position, size_t(0), this.limit, offset, Reverse != 0);
    if constexpr (Reverse != 0) { selected = checked_iterator_position(selected, size_t(0), this.limit, ptrdiff_t(-1)); }
    gti_internal::index_bounds_check(selected, this.limit);
    return this.slots.get_mut(selected);
  }
  void operator++() mut {
    this.position = checked_iterator_step<Reverse>(this.position, size_t(0), this.limit);
  }
  void operator--() mut {
    this.position = checked_iterator_step<Reverse, 1>(this.position, size_t(0), this.limit);
  }
  void operator+=(ptrdiff_t offset) mut {
    this.position = checked_iterator_position(this.position, size_t(0), this.limit, offset, Reverse != 0);
  }
  void operator-=(ptrdiff_t offset) mut {
    this.position = checked_iterator_position(this.position, size_t(0), this.limit, offset, Reverse == 0);
  }
  ptrdiff_t operator-(memory_slot_sentinel end) {
    if constexpr (Reverse != 0) { return checked_iterator_difference(end.position(), this.position); }
    return checked_iterator_difference(this.position, end.position());
  }
  bool operator!=(memory_slot_sentinel end) { return this.position != end.position(); }
  bool operator==(memory_slot_sentinel end) { return this.position == end.position(); }
};
}

/// A move-only homogeneous monotonic arena over checked typed storage.
///
/// Positions are ordinary indexes, not owning handles. `reset()` invalidates
/// every prior position and destroys every live value before the positions
/// may be reused. A retained element reference prevents reset, insertion, or
/// movement through the normal receiver-borrow rules.
class arena<gti_internal::movable_sparse_element T> {
  mut storage<T> values;
  mut size_t next = 0;

public:
  using const_iterator = detail::arena_iterator<T>;
  using iterator = detail::arena_mut_iterator<T>;
  using const_reverse_iterator = detail::arena_iterator<T, 1>;
  using reverse_iterator = detail::arena_mut_iterator<T, 1>;
  using sentinel = detail::memory_slot_sentinel;

  // The private token makes this constructor available to the source-defined
  // factory without exposing unchecked storage adoption to applications.
  arena(gti_internal::empty_storage_adoption token, storage<T> backing)
      : values(std::move(backing)) {}

  arena(arena<T>& other) = delete;
  arena(arena<T>&& other) = default;

  const_iterator begin() { return const_iterator(this.values, this.next, size_t(0)); }
  const_iterator cbegin() { return this.begin(); }
  sentinel end() { return sentinel(this.next); }
  sentinel cend() { return this.end(); }
  const_iterator end_iterator() { return const_iterator(this.values, this.next, this.next); }
  iterator begin_mut() mut { return iterator(this.values, this.next, size_t(0)); }
  iterator end_mut() mut { return iterator(this.values, this.next, this.next); }
  const_reverse_iterator rbegin() { return const_reverse_iterator(this.values, this.next, this.next); }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  sentinel rend() { return sentinel(size_t(0)); }
  sentinel crend() { return this.rend(); }
  reverse_iterator rbegin_mut() mut { return reverse_iterator(this.values, this.next, this.next); }
  reverse_iterator rend_mut() mut { return reverse_iterator(this.values, this.next, size_t(0)); }

  /// Returns the fixed allocation extent.
  size_t capacity() {
    return this.values.capacity();
  }

  /// Returns the number of monotonically occupied positions.
  size_t size() {
    return this.next;
  }

  bool empty() {
    return this.next == size_t(0);
  }

  bool full() {
    return this.next == this.values.capacity();
  }

  /// Moves one completed value into the next position.
  expected<size_t, arena_errc> try_insert(T value) mut {
    if (this.full()) {
      return unexpected(arena_errc::full);
    }
    size_t index = this.next;
    this.values.construct(index, std::move(value));
    this.next++;
    return index;
  }

  /// Returns a checked read-only reference to an occupied position.
  T& get(size_t index) {
    gti_internal::index_bounds_check(index, this.next);
    return this.values.get(index);
  }

  /// Returns a checked exclusive reference to an occupied position.
  mut T& get_mut(size_t index) mut {
    gti_internal::index_bounds_check(index, this.next);
    return this.values.get_mut(index);
  }

  /// Destroys every live value and restarts monotonic allocation at zero.
  void reset() mut {
    this.values.clear();
    this.next = size_t(0);
  }
};

/// Recoverable insertion outcomes for a fixed-capacity pool.
enum class pool_errc {
  full,
};

/// A move-only homogeneous pool with checked reusable positions.
///
/// A returned position identifies a slot, not a particular slot lifetime.
/// Erasing and then reusing a position can therefore make that same numeric
/// position name a new value. References remain tied to the pool receiver and
/// statically prevent overlapping erase, insertion, clearing, or movement.
class pool<gti_internal::movable_sparse_element T> {
  mut storage<T> values;
  mut size_t live = 0;

public:
  using const_iterator = detail::sparse_iterator<T>;
  using iterator = detail::sparse_mut_iterator<T>;
  using const_reverse_iterator = detail::sparse_iterator<T, 1>;
  using reverse_iterator = detail::sparse_mut_iterator<T, 1>;
  using sentinel = detail::memory_slot_sentinel;

  // The private token makes this constructor available to the source-defined
  // factory without exposing unchecked storage adoption to applications.
  pool(gti_internal::empty_storage_adoption token, storage<T> backing)
      : values(std::move(backing)) {}

  pool(pool<T>& other) = delete;
  pool(pool<T>&& other) = default;

  const_iterator begin() { return this.values.begin(); }
  const_iterator cbegin() { return this.begin(); }
  sentinel end() { return this.values.end(); }
  sentinel cend() { return this.end(); }
  const_iterator end_iterator() { return this.values.end_iterator(); }
  iterator begin_mut() mut { return this.values.begin_mut(); }
  iterator end_mut() mut { return this.values.end_mut(); }
  const_reverse_iterator rbegin() { return this.values.rbegin(); }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  sentinel rend() { return this.values.rend(); }
  sentinel crend() { return this.rend(); }
  reverse_iterator rbegin_mut() mut { return this.values.rbegin_mut(); }
  reverse_iterator rend_mut() mut { return this.values.rend_mut(); }

  /// Returns the fixed allocation extent.
  size_t capacity() {
    return this.values.capacity();
  }

  /// Returns the number of currently live values.
  size_t size() {
    return this.live;
  }

  bool empty() {
    return this.live == size_t(0);
  }

  bool full() {
    return this.live == this.values.capacity();
  }

  /// Returns whether an in-bounds position currently contains a live value.
  bool contains(size_t index) {
    if (index >= this.values.capacity()) {
      return false;
    }
    return this.values.initialized(index);
  }

  /// Moves one completed value into the lowest available position.
  expected<size_t, pool_errc> try_insert(T value) mut {
    if (this.full()) {
      return unexpected(pool_errc::full);
    }
    mut size_t index = 0;
    while (this.values.initialized(index)) {
      index++;
    }
    this.values.construct(index, std::move(value));
    this.live++;
    return index;
  }

  /// Destroys one live position and makes it available for reuse.
  void erase(size_t index) mut {
    this.values.destroy(index);
    this.live--;
  }

  /// Returns a checked read-only reference to a live position.
  T& get(size_t index) {
    return this.values.get(index);
  }

  /// Returns a checked exclusive reference to a live position.
  mut T& get_mut(size_t index) mut {
    return this.values.get_mut(index);
  }

  /// Destroys every live value and makes every position available.
  void clear() mut {
    this.values.clear();
    this.live = size_t(0);
  }
};

/// Attempts to allocate one fixed-capacity homogeneous arena.
expected<arena<T>, alloc_errc>
try_make_arena<T>(size_t capacity) requires gti_internal::movable_sparse_element<T> {
  allocator source = allocator();
  mut storage<T> backing = ?source.try_storage<T>(capacity);
  gti_internal::empty_storage_adoption token =
      gti_internal::empty_storage_adoption::trusted;
  mut arena<T> result = arena<T>(std::move(token), std::move(backing));
  return std::move(result);
}

/// Attempts to allocate one fixed-capacity homogeneous pool.
expected<pool<T>, alloc_errc>
try_make_pool<T>(size_t capacity) requires gti_internal::movable_sparse_element<T> {
  allocator source = allocator();
  mut storage<T> backing = ?source.try_storage<T>(capacity);
  gti_internal::empty_storage_adoption token =
      gti_internal::empty_storage_adoption::trusted;
  mut pool<T> result = pool<T>(std::move(token), std::move(backing));
  return std::move(result);
}

/// A move-only strong handle granting read-only access to one shared object.
///
/// Explicit clone() retains the same object. A mutable handle allows reset or
/// swap, not mutable pointee access. A borrow protects the handle that supplied
/// it; another handle may be reset independently. Strong cycles are not broken
/// automatically. Cross-thread use requires both sharing and transfer
/// permission from T, including permission for last-owner cleanup.
class shared_ptr<T> {
  mut gti_internal::shared_owner<T> owner =
      gti_internal::shared_owner_empty<T>();

public:
  shared_ptr() {}
  shared_ptr(nullptr_t empty) {}
  shared_ptr(gti_internal::shared_owner<T> value) : owner(std::move(value)) {}

  shared_ptr(shared_ptr<T>& other) = delete;
  shared_ptr(shared_ptr<T>&& other) = default;

  /// Adds a strong owner of the same object; does not copy the pointee.
  shared_ptr<T> clone() {
    return shared_ptr<T>(gti_internal::shared_owner_clone(this.owner));
  }

  T& operator*() {
    return gti_internal::shared_owner_borrow(this.owner);
  }

  T& operator->() {
    return gti_internal::shared_owner_borrow(this.owner);
  }

  operator bool() {
    return !gti_internal::shared_owner_is_null(this.owner);
  }
  bool operator==(nullptr_t other) {
    return gti_internal::shared_owner_is_null(this.owner);
  }
  bool operator!=(nullptr_t other) {
    return !gti_internal::shared_owner_is_null(this.owner);
  }
  size_t use_count() {
    return gti_internal::shared_owner_use_count(this.owner);
  }
  /// Releases this handle and leaves it empty before last-owner destruction.
  void reset() mut {
    shared_ptr<T> previous = shared_ptr<T>(std::move(this.owner));
    this.owner = gti_internal::shared_owner_empty<T>();
  }
  void operator=(nullptr_t empty) mut {
    this.reset();
  }
  void swap(mut shared_ptr<T>& other) mut {
    gti_internal::shared_owner_swap(this.owner, other.owner);
  }

  /// Consumes this handle and preserves its control block while viewing the
  /// allocation through one public polymorphic base.
  shared_ptr<Base> upcast<Base>() mut {
    mut gti_internal::shared_owner<Base> converted =
        gti_internal::shared_owner_upcast<Base>(std::move(this.owner));
    this.owner = gti_internal::shared_owner_empty<T>();
    return shared_ptr<Base>(std::move(converted));
  }
};

/// Consumes one shared handle and preserves all existing aliases while
/// converting this handle to a public polymorphic base view.
shared_ptr<Base> upcast_shared<Base, Derived>(mut shared_ptr<Derived> owner) {
  return owner.upcast<Base>();
}

class weak_ptr<T> {
public:
  weak_ptr() {}

  bool expired();
  size_t use_count();
  shared_ptr<T> lock();
  void reset() mut;
  void swap(mut weak_ptr<T>& other) mut;
};

/// Constructs one owned object and its strong-reference control block.
///
/// Construction uses the same scalar/class family as make_unique. Infallible
/// object or control-block exhaustion reports allocation failure and aborts
/// without cleanup. Ordinary constructor failure retains verified rollback.
/// This factory is not recoverable.
shared_ptr<T> make_shared<T, Args...>(Args... args) {
  return shared_ptr<T>(gti_internal::shared_owner_from_unique(
      gti_internal::allocate_unique_owner<T>(args...)));
}
}
