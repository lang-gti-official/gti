// Ownership and typed allocation are ordinary GTI policy over
// declaration-bound private capabilities. Shared ownership remains
// declaration-only until its separate compiler-private owner capability and
// lifetime rules exist.

namespace gti_internal {
class unique_owner<T> {};
class storage<T> {};

gti_internal::unique_owner<T> allocate_unique_owner<T, Args...>(Args... args);
T & unique_owner_borrow<T>(gti_internal::unique_owner<T>& owner);
mut T & unique_owner_borrow_mut<T>(mut gti_internal::unique_owner<T>& owner);
bool unique_owner_is_null<T>(gti_internal::unique_owner<T>& owner);
gti_internal::unique_owner<Base> unique_owner_upcast<Base, Derived>(gti_internal::unique_owner<Derived> owner);

gti_internal::storage<T> allocate_storage<T>(uint64_t count);
int32_t storage_try_allocate<T>(mut gti_internal::storage<T>& destination,
                                uint64_t count,
                                uint64_t minimum_alignment);
uint64_t storage_capacity<T>(gti_internal::storage<T>& storage);
bool storage_initialized<T>(gti_internal::storage<T>& storage,
                            uint64_t index);
void storage_construct<T, Args...>(mut gti_internal::storage<T>& storage, uint64_t index, Args... args);
T & storage_read<T>(gti_internal::storage<T>& storage, uint64_t index);
mut T & storage_read_mut<T>(mut gti_internal::storage<T>& storage, uint64_t index);
void storage_destroy<T>(mut gti_internal::storage<T>& storage, uint64_t index);
void storage_relocate<T>(mut gti_internal::storage<T>& source, mut gti_internal::storage<T>& destination, uint64_t count);
void storage_shift_right<T>(mut gti_internal::storage<T>& storage, uint64_t first, uint64_t last);
void storage_shift_left<T>(mut gti_internal::storage<T>& storage, uint64_t first, uint64_t last);

/// Seals adoption of freshly allocated, wholly uninitialized typed storage.
///
/// This is ordinary source-defined standard-library policy, not a compiler
/// intrinsic. Application source cannot name the compiler-private namespace,
/// so only trusted library factories can establish the adoption precondition.
enum class empty_storage_adoption {
  trusted,
};
}

namespace std {
/// Exclusive ownership of one dynamically allocated `T`.
class unique_ptr<T> {
  mut gti_internal::unique_owner<T> owner = nullptr;

public:
  unique_ptr(nullptr_t empty) : owner(nullptr) {}

  unique_ptr(gti_internal::unique_owner<T> value)
      : owner(std::move(value)) {}

  void reset() mut {
    this.owner = nullptr;
  }

  void operator=(nullptr_t empty) mut {
    this.reset();
  }

  unique_ptr<Base> upcast<Base>() mut {
    mut gti_internal::unique_owner<Base> converted =
        gti_internal::unique_owner_upcast<Base>(std::move(this.owner));
    this.owner = nullptr;
    return unique_ptr<Base>(std::move(converted));
  }

  T& operator*() {
    return gti_internal::unique_owner_borrow(this.owner);
  }

  mut T& operator*() mut {
    return gti_internal::unique_owner_borrow_mut(this.owner);
  }

  T& operator->() {
    return gti_internal::unique_owner_borrow(this.owner);
  }

  mut T& operator->() mut {
    return gti_internal::unique_owner_borrow_mut(this.owner);
  }

  operator bool() {
    return !gti_internal::unique_owner_is_null(this.owner);
  }

  bool operator==(nullptr_t other) {
    return gti_internal::unique_owner_is_null(this.owner);
  }

  bool operator!=(nullptr_t other) {
    return !gti_internal::unique_owner_is_null(this.owner);
  }
};

/// Allocates a `T` from `args` and returns its exclusive owner.
unique_ptr<T> make_unique<T, Args...>(Args... args) {
  return unique_ptr<T>(gti_internal::allocate_unique_owner<T>(args...));
}

unique_ptr<Base> upcast_unique<Base, Derived>(mut unique_ptr<Derived> owner) {
  return owner.upcast<Base>();
}

/// Recoverable failures from typed storage allocation.
enum class alloc_errc {
  invalid_alignment,
  size_overflow,
  resource_exhausted,
};

/// A requested minimum byte alignment for typed storage.
///
/// Allocation accepts nonzero powers of two. Keeping validation in the
/// fallible allocation operation makes invalid runtime input recoverable.
class alignment {
  size_t amount;

public:
  alignment(size_t bytes) : amount(bytes) {}

  /// Returns the requested minimum byte alignment.
  size_t bytes() {
    return this.amount;
  }
};

/// A move-only owner of partially initialized typed storage.
///
/// `T` must satisfy `std::movable` and must not contain borrowed state.
/// Each slot is independently uninitialized or contains one live `T`.
/// Construction, access, and destruction are checked. Destruction of the
/// owner drops every remaining live slot once in reverse slot order and then
/// releases the allocation. No address or manual deallocation operation is
/// exposed.
class storage<std::movable T> {
  mut gti_internal::storage<T> data;

public:
  // This constructor is compiler-private despite its access label because its
  // parameter exposes a declaration-bound capability. It is callable by the
  // trusted allocator implementation and withheld from application lookup.
  storage(gti_internal::storage<T> value)
      : data(std::move(value)) {}

  storage(storage<T>& other) = delete;
  storage(storage<T>&& other) = default;

  /// Returns the number of owned `T` slots.
  size_t capacity() {
    return gti_internal::storage_capacity(this.data);
  }

  /// Returns whether the checked slot currently contains a live `T`.
  bool initialized(size_t index) {
    gti_internal::index_bounds_check(index, this.capacity());
    return gti_internal::storage_initialized(this.data, index);
  }

  /// Moves one completed `T` into an uninitialized checked slot.
  ///
  /// Construction of the argument completes before this operation begins, so
  /// any failure in that construction follows ordinary MIR cleanup without
  /// publishing a new slot lifetime. Duplicate construction is a defined
  /// runtime failure.
  void construct(size_t index, T value) mut {
    gti_internal::index_bounds_check(index, this.capacity());
    gti_internal::storage_construct(this.data, index, std::move(value));
  }

  /// Destroys the live value in one checked slot.
  void destroy(size_t index) mut {
    gti_internal::index_bounds_check(index, this.capacity());
    gti_internal::storage_destroy(this.data, index);
  }

  /// Returns a checked read-only reference to a live slot.
  T& get(size_t index) {
    gti_internal::index_bounds_check(index, this.capacity());
    return gti_internal::storage_read(this.data, index);
  }

  /// Returns a checked exclusive reference to a live slot.
  mut T& get_mut(size_t index) mut {
    gti_internal::index_bounds_check(index, this.capacity());
    return gti_internal::storage_read_mut(this.data, index);
  }

  /// Destroys every live slot once in reverse slot order.
  void clear() mut {
    mut size_t index = this.capacity();
    while (index > size_t(0)) {
      index--;
      if (gti_internal::storage_initialized(this.data, index)) {
        gti_internal::storage_destroy(this.data, index);
      }
    }
  }
};

/// The process allocator capability used to create typed storage owners.
///
/// The initial allocator is stateless. The returned storage carries all
/// release authority, so it never borrows this object and remains valid after
/// the allocator value is destroyed.
class allocator {
  expected<storage<T>, alloc_errc>
  try_storage_impl<std::movable T>(size_t count,
                                   uint64_t minimum_alignment) {
    mut gti_internal::storage<T> candidate =
        gti_internal::allocate_storage<T>(uint64_t(0));
    int32_t status = gti_internal::storage_try_allocate(
        candidate, count, minimum_alignment);
    if (status == 1) {
      return unexpected(alloc_errc::invalid_alignment);
    }
    if (status == 2) {
      return unexpected(alloc_errc::size_overflow);
    }
    if (status != 0) {
      return unexpected(alloc_errc::resource_exhausted);
    }
    mut storage<T> result = storage<T>(std::move(candidate));
    return std::move(result);
  }

public:
  allocator() {}

  /// Attempts to create naturally aligned typed storage.
  expected<storage<T>, alloc_errc>
  try_storage<std::movable T>(size_t count) {
    return this.try_storage_impl<T>(count, uint64_t(0));
  }

  /// Attempts to create typed storage with a minimum byte alignment.
  expected<storage<T>, alloc_errc>
  try_storage<std::movable T>(size_t count, alignment requested) {
    size_t bytes = requested.bytes();
    if (bytes == size_t(0) or
        (bytes & (bytes - size_t(1))) != size_t(0)) {
      return unexpected(alloc_errc::invalid_alignment);
    }
    return this.try_storage_impl<T>(count, bytes);
  }
};

/// Recoverable insertion outcomes for a fixed-capacity arena.
enum class arena_errc {
  full,
};

/// A move-only homogeneous monotonic arena over checked typed storage.
///
/// Positions are ordinary indexes, not owning handles. `reset()` invalidates
/// every prior position and destroys every live value before the positions
/// may be reused. A retained element reference prevents reset, insertion, or
/// movement through the normal receiver-borrow rules.
class arena<std::movable T> {
  mut storage<T> values;
  mut size_t next = 0;

public:
  // The private token makes this constructor available to the source-defined
  // factory without exposing unchecked storage adoption to applications.
  arena(gti_internal::empty_storage_adoption token, storage<T> backing)
      : values(std::move(backing)) {}

  arena(arena<T>& other) = delete;
  arena(arena<T>&& other) = default;

  /// Returns the fixed allocation extent.
  size_t capacity() {
    return this.values.capacity();
  }

  /// Returns the number of monotonically occupied positions.
  size_t size() {
    return this.next;
  }

  bool empty() {
    return this.next == size_t(0);
  }

  bool full() {
    return this.next == this.values.capacity();
  }

  /// Moves one completed value into the next position.
  expected<size_t, arena_errc> try_insert(T value) mut {
    if (this.full()) {
      return unexpected(arena_errc::full);
    }
    size_t index = this.next;
    this.values.construct(index, std::move(value));
    this.next++;
    return index;
  }

  /// Returns a checked read-only reference to an occupied position.
  T& get(size_t index) {
    gti_internal::index_bounds_check(index, this.next);
    return this.values.get(index);
  }

  /// Returns a checked exclusive reference to an occupied position.
  mut T& get_mut(size_t index) mut {
    gti_internal::index_bounds_check(index, this.next);
    return this.values.get_mut(index);
  }

  /// Destroys every live value and restarts monotonic allocation at zero.
  void reset() mut {
    this.values.clear();
    this.next = size_t(0);
  }
};

/// Recoverable insertion outcomes for a fixed-capacity pool.
enum class pool_errc {
  full,
};

/// A move-only homogeneous pool with checked reusable positions.
///
/// A returned position identifies a slot, not a particular slot lifetime.
/// Erasing and then reusing a position can therefore make that same numeric
/// position name a new value. References remain tied to the pool receiver and
/// statically prevent overlapping erase, insertion, clearing, or movement.
class pool<std::movable T> {
  mut storage<T> values;
  mut size_t live = 0;

public:
  // The private token makes this constructor available to the source-defined
  // factory without exposing unchecked storage adoption to applications.
  pool(gti_internal::empty_storage_adoption token, storage<T> backing)
      : values(std::move(backing)) {}

  pool(pool<T>& other) = delete;
  pool(pool<T>&& other) = default;

  /// Returns the fixed allocation extent.
  size_t capacity() {
    return this.values.capacity();
  }

  /// Returns the number of currently live values.
  size_t size() {
    return this.live;
  }

  bool empty() {
    return this.live == size_t(0);
  }

  bool full() {
    return this.live == this.values.capacity();
  }

  /// Returns whether an in-bounds position currently contains a live value.
  bool contains(size_t index) {
    if (index >= this.values.capacity()) {
      return false;
    }
    return this.values.initialized(index);
  }

  /// Moves one completed value into the lowest available position.
  expected<size_t, pool_errc> try_insert(T value) mut {
    if (this.full()) {
      return unexpected(pool_errc::full);
    }
    mut size_t index = 0;
    while (this.values.initialized(index)) {
      index++;
    }
    this.values.construct(index, std::move(value));
    this.live++;
    return index;
  }

  /// Destroys one live position and makes it available for reuse.
  void erase(size_t index) mut {
    this.values.destroy(index);
    this.live--;
  }

  /// Returns a checked read-only reference to a live position.
  T& get(size_t index) {
    return this.values.get(index);
  }

  /// Returns a checked exclusive reference to a live position.
  mut T& get_mut(size_t index) mut {
    return this.values.get_mut(index);
  }

  /// Destroys every live value and makes every position available.
  void clear() mut {
    this.values.clear();
    this.live = size_t(0);
  }
};

/// Attempts to allocate one fixed-capacity homogeneous arena.
expected<arena<T>, alloc_errc>
try_make_arena<std::movable T>(size_t capacity) {
  allocator source = allocator();
  mut expected<storage<T>, alloc_errc> allocated =
      source.try_storage<T>(capacity);
  if (!allocated) {
    return unexpected(allocated.error());
  }
  mut storage<T> backing = std::move(allocated).value();
  gti_internal::empty_storage_adoption token =
      gti_internal::empty_storage_adoption::trusted;
  mut arena<T> result = arena<T>(std::move(token), std::move(backing));
  return std::move(result);
}

/// Attempts to allocate one fixed-capacity homogeneous pool.
expected<pool<T>, alloc_errc>
try_make_pool<std::movable T>(size_t capacity) {
  allocator source = allocator();
  mut expected<storage<T>, alloc_errc> allocated =
      source.try_storage<T>(capacity);
  if (!allocated) {
    return unexpected(allocated.error());
  }
  mut storage<T> backing = std::move(allocated).value();
  gti_internal::empty_storage_adoption token =
      gti_internal::empty_storage_adoption::trusted;
  mut pool<T> result = pool<T>(std::move(token), std::move(backing));
  return std::move(result);
}

class shared_ptr<T> {
public:
  shared_ptr() {}
  shared_ptr(nullptr_t value) {}

  T& operator*();
  mut T& operator*() mut;
  T& operator->();
  mut T& operator->() mut;

  operator bool();
  bool operator==(nullptr_t other);
  bool operator!=(nullptr_t other);

  size_t use_count();
  void reset() mut;
  void swap(mut shared_ptr<T>& other) mut;
};

class weak_ptr<T> {
public:
  weak_ptr() {}

  bool expired();
  size_t use_count();
  shared_ptr<T> lock();
  void reset() mut;
  void swap(mut weak_ptr<T>& other) mut;
};

shared_ptr<T> make_shared<T, Args...>(Args... args);
}
