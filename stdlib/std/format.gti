#include <std/string>

namespace std {
enum class format_errc {
  invalid_format,
  argument_count_mismatch,
  unsupported_argument,
};

namespace detail {
void count_format_argument<T>(mut size_t& count, T& value) {
  count++;
}

/// Closed built-in argument adapter used by the heterogeneous pack walker.
/// The primary reports an unsupported argument without publishing the partly
/// formatted string. Exact standard-library specializations below own the
/// admitted representations; the compiler does not recognize this class.
class format_argument_writer<T> {
public:
  bool append(mut string& output, T& value) {
    return false;
  }
};

void append_integral<std::integral T>(mut string& output, T& value) {
  mut string replacement = to_string(value);
  output.append(replacement.view());
}

}
}

class std::detail::format_argument_writer<int8_t> {
public:
  bool append(mut std::string& output, int8_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<uint8_t> {
public:
  bool append(mut std::string& output, uint8_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<int16_t> {
public:
  bool append(mut std::string& output, int16_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<uint16_t> {
public:
  bool append(mut std::string& output, uint16_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<int32_t> {
public:
  bool append(mut std::string& output, int32_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<uint32_t> {
public:
  bool append(mut std::string& output, uint32_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<int64_t> {
public:
  bool append(mut std::string& output, int64_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<uint64_t> {
public:
  bool append(mut std::string& output, uint64_t& value) {
    std::detail::append_integral(output, value);
    return true;
  }
};

class std::detail::format_argument_writer<bool> {
public:
  bool append(mut std::string& output, bool& value) {
    if (value) {
      output.append("true");
    } else {
      output.append("false");
    }
    return true;
  }
};

class std::detail::format_argument_writer<char> {
public:
  bool append(mut std::string& output, char& value) {
    output.push_back(value);
    return true;
  }
};

class std::detail::format_argument_writer<float> {
public:
  bool append(mut std::string& output, float& value) {
    mut std::string replacement = std::to_string(value);
    output.append(replacement.view());
    return true;
  }
};

class std::detail::format_argument_writer<std::string_view> {
public:
  bool append(mut std::string& output, std::string_view& value) {
    output.append(value);
    return true;
  }
};

class std::detail::format_argument_writer<std::string> {
public:
  bool append(mut std::string& output, std::string& value) {
    output.append(value.view());
    return true;
  }
};

namespace std {
namespace detail {

expected<void, format_errc> validate_format_pattern(string_view pattern,
                                                     size_t argument_count) {
  mut size_t cursor = 0;
  mut size_t field_count = 0;
  while (cursor < pattern.size()) {
    char current = pattern[cursor];
    if (current == '{') {
      if (cursor + 1 >= pattern.size()) {
        return unexpected(format_errc::invalid_format);
      }
      char next = pattern[cursor + 1];
      if (next == '{') {
        cursor += 2;
        continue;
      }
      if (next == '}') {
        field_count++;
        cursor += 2;
        continue;
      }
      return unexpected(format_errc::invalid_format);
    }
    if (current == '}') {
      if (cursor + 1 >= pattern.size() or pattern[cursor + 1] != '}') {
        return unexpected(format_errc::invalid_format);
      }
      cursor += 2;
      continue;
    }
    cursor++;
  }

  if (field_count != argument_count) {
    return unexpected(format_errc::argument_count_mismatch);
  }
  return;
}

void append_format_argument<T>(mut string& output, string_view pattern,
                               mut size_t& cursor, mut bool& supported,
                               T& value) {
  if (!supported) {
    return;
  }
  while (cursor < pattern.size()) {
    char current = pattern[cursor];
    if (current == '{') {
      char next = pattern[cursor + 1];
      if (next == '{') {
        output.push_back('{');
        cursor += 2;
        continue;
      }

      cursor += 2;
      format_argument_writer<T> writer{};
      supported = writer.append(output, value);
      return;
    }
    if (current == '}') {
      output.push_back('}');
      cursor += 2;
      continue;
    }
    output.push_back(current);
    cursor++;
  }
}

void append_format_tail(mut string& output, string_view pattern,
                        mut size_t& cursor) {
  while (cursor < pattern.size()) {
    char current = pattern[cursor];
    if (current == '{') {
      output.push_back('{');
      cursor += 2;
      continue;
    }
    if (current == '}') {
      output.push_back('}');
      cursor += 2;
      continue;
    }
    output.push_back(current);
    cursor++;
  }
}
}

expected<string, format_errc> format(string_view pattern) {
  expected<void, format_errc> validation =
      detail::validate_format_pattern(pattern, size_t(0));
  if (!validation) {
    return unexpected(validation.error());
  }

  mut string output = string();
  mut size_t cursor = 0;
  detail::append_format_tail(output, pattern, cursor);
  return std::move(output);
}

expected<string, format_errc>
format<First, Args...>(string_view pattern, First first, Args... args) {
  mut size_t argument_count = 1;
  (detail::count_format_argument(argument_count, args), ...);

  expected<void, format_errc> validation =
      detail::validate_format_pattern(pattern, argument_count);
  if (!validation) {
    return unexpected(validation.error());
  }

  mut string output = string();
  mut size_t cursor = 0;
  mut bool supported = true;
  detail::append_format_argument(output, pattern, cursor, supported, first);
  (detail::append_format_argument(output, pattern, cursor, supported, args),
   ...);
  if (!supported) {
    return unexpected(format_errc::unsupported_argument);
  }
  detail::append_format_tail(output, pattern, cursor);
  return std::move(output);
}

expected<void, format_errc>
try_print(string_view pattern) {
  mut expected<string, format_errc> formatted = format(pattern);
  if (!formatted) {
    return unexpected(formatted.error());
  }
  print(formatted.value());
  return;
}

expected<void, format_errc>
try_print<First, Args...>(string_view pattern, First first, Args... args) {
  mut expected<string, format_errc> formatted =
      format(pattern, std::move(first), args...);
  if (!formatted) {
    return unexpected(formatted.error());
  }
  print(formatted.value());
  return;
}

expected<void, format_errc>
try_println(string_view pattern) {
  mut expected<string, format_errc> formatted = format(pattern);
  if (!formatted) {
    return unexpected(formatted.error());
  }
  print(formatted.value());
  print('\n');
  return;
}

expected<void, format_errc>
try_println<First, Args...>(string_view pattern, First first, Args... args) {
  mut expected<string, format_errc> formatted =
      format(pattern, std::move(first), args...);
  if (!formatted) {
    return unexpected(formatted.error());
  }
  print(formatted.value());
  print('\n');
  return;
}
}
