class std::formatter<std::string> {
public:
  expected<void, std::format_errc> format(std::string& value, mut std::string& output, std::format_spec& spec) {
    return std::detail::format_result(this.append(output, value, spec));
  }

private:
  std::detail::format_argument_status append(mut std::string& output,
                                              std::string& value,
                                              std::format_spec& spec) {
    if ((spec.type != '\0' && spec.type != 's') || spec.sign != '-' ||
        spec.alternate || spec.zero_pad) {
      return std::detail::format_argument_status::invalid_specifier;
    }
    std::detail::append_text(output, value.view(), spec, '<');
    return std::detail::format_argument_status::appended;
  }
};

namespace std {
expected<string, format_errc> try_format(string_view pattern) {
  expected<void, format_errc> validation =
      detail::validate_format_pattern(pattern, size_t(0));
  if (!validation) {
    return unexpected(validation.error());
  }

  mut string output = string();
  output.reserve(pattern.size());
  mut size_t cursor = 0;
  while (cursor < pattern.size()) {
    detail::append_format_literal(output, pattern, cursor);
  }
  return std::move(output);
}

expected<string, format_errc>
try_format<First, Args...>(string_view pattern, First first, Args... args) requires formattable<First> {
  mut size_t argument_count = 1;
  (detail::count_format_argument(argument_count, args), ...);
  expected<void, format_errc> validation =
      detail::validate_format_pattern(pattern, argument_count);
  if (!validation) {
    return unexpected(validation.error());
  }

  // One allocation covers the literal text and typical short arguments;
  // longer results grow geometrically.
  mut string output = string();
  output.reserve(pattern.size() + argument_count * size_t(16));
  mut size_t cursor = 0;
  mut size_t next_automatic = 0;
  mut uint8_t indexing_mode = uint8_t(0);
  while (cursor < pattern.size()) {
    if (pattern[cursor] != '{' ||
        (cursor + 1 < pattern.size() && pattern[cursor + 1] == '{')) {
      detail::append_format_literal(output, pattern, cursor);
      continue;
    }

    mut detail::format_field field{};
    if (!detail::parse_format_field(pattern, cursor, next_automatic,
                                    indexing_mode, field)) {
      return unexpected(format_errc::invalid_format);
    }
    mut size_t candidate = 0;
    size_t requested = field.argument_index;
    format_spec selected_spec = field.spec;
    mut detail::format_argument_status status =
        detail::format_argument_status::appended;
    detail::append_selected_format_argument(output, requested,
                                            candidate, status, selected_spec,
                                            first);
    (detail::append_selected_format_argument(output, requested,
                                             candidate, status, selected_spec,
                                             args), ...);
    if (status == detail::format_argument_status::unsupported) {
      return unexpected(format_errc::unsupported_argument);
    }
    if (status == detail::format_argument_status::argument_count_mismatch) {
      return unexpected(format_errc::argument_count_mismatch);
    }
    if (status == detail::format_argument_status::invalid_specifier) {
      return unexpected(format_errc::invalid_format);
    }
    cursor = field.end;
  }
  return std::move(output);
}

/// Appends one fully formatted result. Failure leaves `output` unchanged.
expected<void, format_errc> try_format_to(mut string& output,
                                      string_view pattern) {
  mut expected<string, format_errc> formatted = try_format(pattern);
  if (!formatted) {
    return unexpected(formatted.error());
  }
  output.append(formatted.value().view());
  return;
}

/// Appends one fully formatted result. Failure leaves `output` unchanged.
expected<void, format_errc>
try_format_to<First, Args...>(mut string& output, string_view pattern, First first,
                          Args... args) requires formattable<First> {
  mut expected<string, format_errc> formatted =
      try_format(pattern, std::move(first), args...);
  if (!formatted) {
    return unexpected(formatted.error());
  }
  output.append(formatted.value().view());
  return;
}

namespace detail {
[[noreturn, track_caller]]
void panic_format_error(format_errc error) {
  switch (error) {
  case format_errc::invalid_format:
    panic("Formatting failed: invalid format");
  case format_errc::argument_count_mismatch:
    panic("Formatting failed: argument count mismatch");
  case format_errc::unsupported_argument:
    panic("Formatting failed: unsupported argument; convert the value to a supported type");
  }
  panic("Formatting failed: unknown error");
}

print_errc print_format_error(format_errc error) {
  switch (error) {
  case format_errc::invalid_format:
    return print_errc::invalid_format;
  case format_errc::argument_count_mismatch:
    return print_errc::argument_count_mismatch;
  case format_errc::unsupported_argument:
    return print_errc::unsupported_argument;
  }
  return print_errc::invalid_format;
}

[[noreturn, track_caller]]
void panic_print_error(print_errc error) {
  switch (error) {
  case print_errc::invalid_format:
    panic_format_error(format_errc::invalid_format);
  case print_errc::argument_count_mismatch:
    panic_format_error(format_errc::argument_count_mismatch);
  case print_errc::unsupported_argument:
    panic_format_error(format_errc::unsupported_argument);
  case print_errc::write_failed:
    panic("Output failed: stdout write failed");
  }
  panic("Output failed: unknown error");
}

expected<void, print_errc> submit_print(string_view text) {
  // The prelude's counted stdout entry checks complete submission already.
  // Avoid importing the unrelated FILE/descriptor layer just for its status.
  if (gti_internal::runtime::gti_rt_write_stdout(text) != 0) {
    return unexpected(print_errc::write_failed);
  }
  return;
}
}

/// Formats an owning result, panicking at the caller on formatting failure.
[[track_caller]]
string format(string_view pattern) {
  mut auto result = try_format(pattern);
  if (!result) {
    detail::panic_format_error(result.error());
  }
  return std::move(result).expect("Formatting succeeded without a value");
}

[[track_caller]]
string format<First, Args...>(string_view pattern, First first, Args... args) requires formattable<First> {
  mut auto result = try_format(pattern, std::move(first), args...);
  if (!result) {
    detail::panic_format_error(result.error());
  }
  return std::move(result).expect("Formatting succeeded without a value");
}

[[track_caller]]
void format_to(mut string& output, string_view pattern) {
  auto result = try_format_to(output, pattern);
  if (!result) {
    detail::panic_format_error(result.error());
  }
}

[[track_caller]]
void format_to<First, Args...>(mut string& output, string_view pattern,
                              First first, Args... args) requires formattable<First> {
  auto result = try_format_to(output, pattern, std::move(first), args...);
  if (!result) {
    detail::panic_format_error(result.error());
  }
}

/// With no format arguments, output is literal, like the prelude print API.
expected<void, print_errc> try_print(string_view text) {
  return detail::submit_print(text);
}

expected<void, print_errc>
try_print<First, Args...>(string_view pattern, First first, Args... args) requires formattable<First> {
  mut auto formatted = try_format(pattern, std::move(first), args...);
  if (!formatted) {
    return unexpected(detail::print_format_error(formatted.error()));
  }
  return detail::submit_print(formatted.value().view());
}

expected<void, print_errc> try_println(string_view text) {
  mut string line = string(text);
  line.push_back('\n');
  return detail::submit_print(line.view());
}

expected<void, print_errc>
try_println<First, Args...>(string_view pattern, First first, Args... args) requires formattable<First> {
  mut auto formatted = try_format(pattern, std::move(first), args...);
  if (!formatted) {
    return unexpected(detail::print_format_error(formatted.error()));
  }
  formatted.value().push_back('\n');
  return detail::submit_print(formatted.value().view());
}

[[track_caller]]
void print<First, Args...>(string_view pattern, First first, Args... args) requires formattable<First> {
  auto result = try_print(pattern, std::move(first), args...);
  if (!result) {
    detail::panic_print_error(result.error());
  }
}

[[track_caller]]
void println<First, Args...>(string_view pattern, First first, Args... args) requires formattable<First> {
  auto result = try_println(pattern, std::move(first), args...);
  if (!result) {
    detail::panic_print_error(result.error());
  }
}
}
