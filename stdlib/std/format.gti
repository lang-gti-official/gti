class std::formatter<bool> {
public:
  expected<void, std::format_errc> format(bool& value, mut std::string& output, std::format_spec& spec) {
    return std::detail::format_result(this.append(output, value, spec));
  }

private:
  std::detail::format_argument_status append(mut std::string& output,
                                              bool& value,
                                              std::format_spec& spec) {
    if (spec.type == '\0' || spec.type == 's') {
      if (spec.sign != '-' || spec.alternate || spec.zero_pad) {
        return std::detail::format_argument_status::invalid_specifier;
      }
      std::detail::append_text(output, value ? "true" : "false", spec, '<');
      return std::detail::format_argument_status::appended;
    }
    mut uint8_t numeric = value ? uint8_t(1) : uint8_t(0);
    return std::detail::append_integral(output, numeric, spec);
  }
};

class std::formatter<char> {
public:
  expected<void, std::format_errc> format(char& value, mut std::string& output, std::format_spec& spec) {
    return std::detail::format_result(this.append(output, value, spec));
  }

private:
  std::detail::format_argument_status append(mut std::string& output,
                                              char& value,
                                              std::format_spec& spec) {
    if (spec.type != '\0' && spec.type != 'c') {
      mut uint8_t numeric = uint8_t(value);
      return std::detail::append_integral(output, numeric, spec);
    }
    if (spec.sign != '-' || spec.alternate || spec.zero_pad ||
        spec.has_precision) {
      return std::detail::format_argument_status::invalid_specifier;
    }
    std::detail::append_character(output, value, spec);
    return std::detail::format_argument_status::appended;
  }
};

