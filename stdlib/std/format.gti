#include <std/charconv>
#include <std/string>
#include <std/detail/panic>

namespace gti_internal {
namespace runtime {
extern "C" {
uint32_t gti_rt_format_f32_v1(
    float value, uint32_t format, int32_t precision, uint32_t flags,
    uint32_t fill, uint32_t alignment, uint32_t sign, uint32_t zero_pad,
    uint64_t width, uint8_t* output, uint64_t capacity, uint64_t* size);
uint32_t gti_rt_format_f64_v1(double value, uint32_t format,
                             int32_t precision, uint32_t flags,
                             uint32_t fill, uint32_t alignment,
                             uint32_t sign, uint32_t zero_pad, uint64_t width,
                             uint8_t* output, uint64_t capacity,
                             uint64_t* size);
}
}
}

namespace std {
enum class format_errc {
  invalid_format,
  argument_count_mismatch,
  unsupported_argument,
};

/// Formatting errors and stdout submission failure are distinct recoverable
/// outcomes. Allocation still follows GTI's defined allocation-failure policy.
enum class print_errc {
  invalid_format,
  argument_count_mismatch,
  unsupported_argument,
  write_failed,
};

/// Parsed replacement-field presentation. A zero type means the default
/// presentation for the selected argument type.
struct format_spec {
  mut char fill;
  mut char alignment;
  mut char sign;
  mut bool alternate;
  mut bool zero_pad;
  mut size_t width;
  mut bool has_precision;
  mut size_t precision;
  mut char type;

  format_spec()
      : fill(' '), alignment('\0'), sign('-'), alternate(false),
        zero_pad(false), width(0), has_precision(false), precision(0),
        type('\0') {}
};

namespace detail {
struct enum_underlying_probe<T, U> {
  bool matches() requires std::enum_underlying<T, U> { return true; }
};
}

/// Specialize this class for an application-owned type. A specialization
/// supplies a public safe read-only format method with the formattable contract.
/// The primary formats integral enums using their exact underlying integer.
class formatter<T> {
public:
  expected<void, format_errc> format(T& value, mut string& output,
                                    format_spec& spec)
      requires std::integral_enum<T> {
    if constexpr (requires(detail::enum_underlying_probe<T, int8_t>& probe) {
      { probe.matches() } -> bool;
    }) {
      return this.format_integral<int8_t>(value, output, spec);
    } else if constexpr (requires(detail::enum_underlying_probe<T, uint8_t>& probe) {
      { probe.matches() } -> bool;
    }) {
      return this.format_integral<uint8_t>(value, output, spec);
    } else if constexpr (requires(detail::enum_underlying_probe<T, int16_t>& probe) {
      { probe.matches() } -> bool;
    }) {
      return this.format_integral<int16_t>(value, output, spec);
    } else if constexpr (requires(detail::enum_underlying_probe<T, uint16_t>& probe) {
      { probe.matches() } -> bool;
    }) {
      return this.format_integral<uint16_t>(value, output, spec);
    } else if constexpr (requires(detail::enum_underlying_probe<T, int32_t>& probe) {
      { probe.matches() } -> bool;
    }) {
      return this.format_integral<int32_t>(value, output, spec);
    } else if constexpr (requires(detail::enum_underlying_probe<T, uint32_t>& probe) {
      { probe.matches() } -> bool;
    }) {
      return this.format_integral<uint32_t>(value, output, spec);
    } else if constexpr (requires(detail::enum_underlying_probe<T, int64_t>& probe) {
      { probe.matches() } -> bool;
    }) {
      return this.format_integral<int64_t>(value, output, spec);
    } else {
      return this.format_integral<uint64_t>(value, output, spec);
    }
  }

private:
  expected<void, format_errc> format_integral<U>(T& value, mut string& output,
                                                format_spec& spec)
      requires std::enum_underlying<T, U> && std::integral<U> {
    U underlying = std::to_underlying<U, T>(value);
    return detail::format_result(
        detail::append_integral(output, underlying, spec));
  }
};

concept formattable<T> =
    std::default_initializable<formatter<T>> &&
    requires(formatter<T>& writer, T& value, mut string& output, format_spec& spec) {
      { writer.format(value, output, spec) } -> expected<void, format_errc>;
    };

namespace detail {
enum class format_argument_status {
  appended,
  invalid_specifier,
  argument_count_mismatch,
  unsupported,
};

expected<void, format_errc> format_result(format_argument_status status) {
  if (status == format_argument_status::invalid_specifier) {
    return unexpected(format_errc::invalid_format);
  }
  if (status == format_argument_status::unsupported) {
    return unexpected(format_errc::unsupported_argument);
  }
  if (status == format_argument_status::argument_count_mismatch) {
    return unexpected(format_errc::argument_count_mismatch);
  }
  return;
}

void count_format_argument<T>(mut size_t& count, T& value) {
  count++;
}

struct format_field {
  mut size_t argument_index;
  mut size_t end;
  mut format_spec spec;

  format_field() : argument_index(0), end(0), spec(format_spec()) {}
};

bool format_digit(char value) {
  uint8_t code = uint8_t(value);
  return code >= uint8_t('0') && code <= uint8_t('9');
}

bool format_alignment(char value) {
  return value == '<' || value == '>' || value == '^';
}

bool format_type(char value) {
  return value == 's' || value == 'c' || value == 'd' || value == 'x' ||
         value == 'X' || value == 'o' || value == 'b' || value == 'B' ||
         value == 'f' || value == 'F' || value == 'e' || value == 'E' ||
         value == 'g' || value == 'G';
}

bool parse_format_number(string_view pattern, mut size_t& cursor,
                         mut size_t& value) {
  if (cursor >= pattern.size() || !format_digit(pattern[cursor])) {
    return false;
  }
  value = 0;
  while (cursor < pattern.size() && format_digit(pattern[cursor])) {
    uint64_t digit = uint64_t(uint8_t(pattern[cursor]) - uint8_t('0'));
    if (value >
        (uint64_t(18446744073709551615) - digit) / uint64_t(10)) {
      return false;
    }
    value = value * size_t(10) + size_t(digit);
    cursor++;
  }
  return true;
}

/// Parses one field beginning at `open`. `indexing_mode` is zero before the
/// first field, one for automatic fields, and two for explicit numeric fields.
bool parse_format_field(string_view pattern, size_t open,
                        mut size_t& next_automatic,
                        mut uint8_t& indexing_mode,
                        mut format_field& field) {
  mut size_t cursor = open + 1;
  if (cursor >= pattern.size()) {
    return false;
  }

  if (pattern[cursor] == '}' || pattern[cursor] == ':') {
    if (indexing_mode == uint8_t(2)) {
      return false;
    }
    indexing_mode = uint8_t(1);
    field.argument_index = next_automatic;
    next_automatic++;
  } else if (format_digit(pattern[cursor])) {
    if (indexing_mode == uint8_t(1)) {
      return false;
    }
    indexing_mode = uint8_t(2);
    if (!parse_format_number(pattern, cursor, field.argument_index)) {
      return false;
    }
  } else {
    return false;
  }

  if (cursor >= pattern.size()) {
    return false;
  }
  if (pattern[cursor] == '}') {
    field.end = cursor + 1;
    return true;
  }
  if (pattern[cursor] != ':') {
    return false;
  }
  cursor++;

  if (cursor + 1 < pattern.size() &&
      format_alignment(pattern[cursor + 1])) {
    if (pattern[cursor] == '{' || pattern[cursor] == '}') {
      return false;
    }
    field.spec.fill = pattern[cursor];
    field.spec.alignment = pattern[cursor + 1];
    cursor += 2;
  } else if (cursor < pattern.size() && format_alignment(pattern[cursor])) {
    field.spec.alignment = pattern[cursor];
    cursor++;
  }

  if (cursor < pattern.size() &&
      (pattern[cursor] == '+' || pattern[cursor] == '-' ||
       pattern[cursor] == ' ')) {
    field.spec.sign = pattern[cursor];
    cursor++;
  }
  if (cursor < pattern.size() && pattern[cursor] == '#') {
    field.spec.alternate = true;
    cursor++;
  }
  if (cursor < pattern.size() && pattern[cursor] == '0') {
    field.spec.zero_pad = true;
    cursor++;
  }
  if (cursor < pattern.size() && format_digit(pattern[cursor])) {
    if (!parse_format_number(pattern, cursor, field.spec.width)) {
      return false;
    }
  }
  if (cursor < pattern.size() && pattern[cursor] == '.') {
    cursor++;
    field.spec.has_precision = true;
    if (!parse_format_number(pattern, cursor, field.spec.precision)) {
      return false;
    }
  }
  if (cursor < pattern.size() && pattern[cursor] != '}') {
    if (!format_type(pattern[cursor])) {
      return false;
    }
    field.spec.type = pattern[cursor];
    cursor++;
  }
  if (cursor >= pattern.size() || pattern[cursor] != '}') {
    return false;
  }
  field.end = cursor + 1;
  return true;
}

expected<void, format_errc> validate_format_pattern(string_view pattern,
                                                     size_t argument_count) {
  mut size_t cursor = 0;
  mut size_t next_automatic = 0;
  mut uint8_t indexing_mode = uint8_t(0);
  while (cursor < pattern.size()) {
    char current = pattern[cursor];
    if (current == '{') {
      if (cursor + 1 < pattern.size() && pattern[cursor + 1] == '{') {
        cursor += 2;
        continue;
      }
      mut format_field field{};
      if (!parse_format_field(pattern, cursor, next_automatic, indexing_mode,
                              field)) {
        return unexpected(format_errc::invalid_format);
      }
      if (field.argument_index >= argument_count) {
        return unexpected(format_errc::argument_count_mismatch);
      }
      cursor = field.end;
      continue;
    }
    if (current == '}') {
      if (cursor + 1 >= pattern.size() || pattern[cursor + 1] != '}') {
        return unexpected(format_errc::invalid_format);
      }
      cursor += 2;
      continue;
    }
    cursor++;
  }

  // Automatic indexing preserves the existing exact-arity contract. Explicit
  // indexing permits reuse and intentionally does not require every supplied
  // argument to be referenced.
  if ((indexing_mode == uint8_t(0) && argument_count != 0) ||
      (indexing_mode == uint8_t(1) && next_automatic != argument_count)) {
    return unexpected(format_errc::argument_count_mismatch);
  }
  return;
}

/// Makes room for `additional` more bytes. Capacity grows at least
/// geometrically, so a sequence of formatted appends reallocates an amortized
/// constant number of times instead of once per append.
void reserve_additional(mut string& output, size_t additional) {
  size_t capacity = output.capacity();
  if (additional <= capacity - output.size()) {
    return;
  }
  size_t required = output.size() + additional;
  mut size_t grown = required;
  if (capacity > required - capacity) {
    grown = capacity + capacity;
  }
  output.reserve(grown);
}

/// Splits the padding for `count` content bytes into fill before and after.
void split_padding(format_spec& spec, size_t count, char default_alignment,
                   mut size_t& left, mut size_t& right) {
  mut size_t padding = 0;
  if (spec.width > count) {
    padding = spec.width - count;
  }
  mut char alignment = spec.alignment;
  if (alignment == '\0') {
    alignment = default_alignment;
  }
  left = 0;
  right = 0;
  if (alignment == '<') {
    right = padding;
  } else if (alignment == '^') {
    left = padding / size_t(2);
    right = padding - left;
  } else {
    left = padding;
  }
}

void append_repeat(mut string& output, char value, size_t count) {
  reserve_additional(output, count);
  for (mut size_t index = 0; index < count; index++) {
    output.push_back(value);
  }
}

void append_text(mut string& output, string_view value, format_spec& spec,
                 char default_alignment) {
  mut size_t count = value.size();
  if (spec.has_precision && spec.precision < count) {
    count = spec.precision;
  }
  mut size_t left = 0;
  mut size_t right = 0;
  split_padding(spec, count, default_alignment, left, right);
  reserve_additional(output, left + count + right);
  append_repeat(output, spec.fill, left);
  for (mut size_t index = 0; index < count; index++) {
    output.push_back(value[index]);
  }
  append_repeat(output, spec.fill, right);
}

/// One character with text padding and precision, without a temporary string.
void append_character(mut string& output, char value, format_spec& spec) {
  mut size_t count = 1;
  if (spec.has_precision && spec.precision < count) {
    count = spec.precision;
  }
  mut size_t left = 0;
  mut size_t right = 0;
  split_padding(spec, count, '<', left, right);
  reserve_additional(output, left + count + right);
  append_repeat(output, spec.fill, left);
  if (count == size_t(1)) {
    output.push_back(value);
  }
  append_repeat(output, spec.fill, right);
}

char format_digit_character(uint8_t digit, bool uppercase) {
  if (digit < uint8_t(10)) {
    switch (digit) {
    case uint8_t(0): return '0';
    case uint8_t(1): return '1';
    case uint8_t(2): return '2';
    case uint8_t(3): return '3';
    case uint8_t(4): return '4';
    case uint8_t(5): return '5';
    case uint8_t(6): return '6';
    case uint8_t(7): return '7';
    case uint8_t(8): return '8';
    default: return '9';
    }
  }
  if (uppercase) {
    switch (digit) {
    case uint8_t(10): return 'A';
    case uint8_t(11): return 'B';
    case uint8_t(12): return 'C';
    case uint8_t(13): return 'D';
    case uint8_t(14): return 'E';
    default: return 'F';
    }
  }
  switch (digit) {
  case uint8_t(10): return 'a';
  case uint8_t(11): return 'b';
  case uint8_t(12): return 'c';
  case uint8_t(13): return 'd';
  case uint8_t(14): return 'e';
  default: return 'f';
  }
}

format_argument_status append_integral<std::integral T>(mut string& output,
                                                         T& value,
                                                         format_spec& spec) {
  if (spec.has_precision) {
    return format_argument_status::invalid_specifier;
  }
  mut char presentation = spec.type;
  if (presentation == '\0') {
    presentation = 'd';
  }
  if (presentation == 'c') {
    if (spec.sign != '-' || spec.alternate || spec.zero_pad || value < T(0) ||
        uint64_t(value) > uint64_t(255)) {
      return format_argument_status::invalid_specifier;
    }
    append_character(output, char(uint8_t(value)), spec);
    return format_argument_status::appended;
  }

  mut uint8_t base = uint8_t(10);
  mut bool uppercase = false;
  if (presentation == 'x' || presentation == 'X') {
    base = uint8_t(16);
    uppercase = presentation == 'X';
  } else if (presentation == 'o') {
    base = uint8_t(8);
  } else if (presentation == 'b' || presentation == 'B') {
    base = uint8_t(2);
    uppercase = presentation == 'B';
  } else if (presentation != 'd') {
    return format_argument_status::invalid_specifier;
  }

  // A sign and a two-character base marker at most; digits stay in the
  // reversed buffer, so formatting an integer allocates no temporary string.
  mut char prefix[3] = {' ', ' ', ' '};
  mut size_t prefix_count = 0;
  bool negative = value < T(0);
  if (negative) {
    prefix[prefix_count] = '-';
    prefix_count++;
  } else if (spec.sign == '+') {
    prefix[prefix_count] = '+';
    prefix_count++;
  } else if (spec.sign == ' ') {
    prefix[prefix_count] = ' ';
    prefix_count++;
  }
  if (spec.alternate) {
    if (base == uint8_t(16) || base == uint8_t(2)) {
      prefix[prefix_count] = '0';
      prefix_count++;
      if (base == uint8_t(16)) {
        prefix[prefix_count] = uppercase ? 'X' : 'x';
      } else {
        prefix[prefix_count] = uppercase ? 'B' : 'b';
      }
      prefix_count++;
    } else if (base == uint8_t(8) && value != T(0)) {
      prefix[prefix_count] = '0';
      prefix_count++;
    }
  }

  mut uint8_t[65] reversed = {};
  mut size_t count = 0;
  mut T remaining = value;
  if (remaining == T(0)) {
    reversed[0] = uint8_t(0);
    count = 1;
  } else {
    while (remaining != T(0)) {
      mut int64_t digit = int64_t(remaining % T(base));
      if (digit < 0) {
        digit = -digit;
      }
      reversed[count] = uint8_t(digit);
      count++;
      remaining = T(remaining / T(base));
    }
  }
  size_t content = prefix_count + count;
  mut size_t zeros = 0;
  mut size_t left = 0;
  mut size_t right = 0;
  if (spec.zero_pad && spec.alignment == '\0') {
    if (spec.width > content) {
      zeros = spec.width - content;
    }
  } else {
    split_padding(spec, content, '>', left, right);
  }
  reserve_additional(output, left + content + zeros + right);
  append_repeat(output, spec.fill, left);
  for (mut size_t index = 0; index < prefix_count; index++) {
    output.push_back(prefix[index]);
  }
  append_repeat(output, '0', zeros);
  while (count > 0) {
    count--;
    output.push_back(format_digit_character(reversed[count], uppercase));
  }
  append_repeat(output, spec.fill, right);
  return format_argument_status::appended;
}

struct floating_format_selection {
  mut chars_format style;
  mut bool uppercase;
  mut bool general;
  mut int32_t precision;

  floating_format_selection()
      : style(chars_format::general), uppercase(false), general(false),
        precision(int32_t(-1)) {}
};

bool select_floating_format(format_spec& spec,
                            mut floating_format_selection& selection) {
  mut char presentation = spec.type;
  if (presentation == '\0') {
    selection.general = true;
    if (spec.has_precision) {
      if (spec.precision > size_t(2048)) {
        return false;
      }
      selection.precision =
          int32_t(spec.precision == size_t(0) ? size_t(1) : spec.precision);
    }
  } else if (presentation == 'f' || presentation == 'F') {
    selection.style = chars_format::fixed;
    selection.uppercase = presentation == 'F';
    if (spec.has_precision && spec.precision > size_t(2048)) {
      return false;
    }
    selection.precision =
        int32_t(spec.has_precision ? spec.precision : size_t(6));
  } else if (presentation == 'e' || presentation == 'E') {
    selection.style = chars_format::scientific;
    selection.uppercase = presentation == 'E';
    if (spec.has_precision && spec.precision > size_t(2048)) {
      return false;
    }
    selection.precision =
        int32_t(spec.has_precision ? spec.precision : size_t(6));
  } else if (presentation == 'g' || presentation == 'G') {
    selection.general = true;
    selection.uppercase = presentation == 'G';
    if (spec.has_precision && spec.precision > size_t(2048)) {
      return false;
    }
    selection.precision = int32_t(
        spec.has_precision
            ? (spec.precision == size_t(0) ? size_t(1) : spec.precision)
            : size_t(6));
  } else {
    return false;
  }
  return true;
}

format_argument_status append_float32(mut string& output, float& value,
                                      format_spec& spec) {
  mut floating_format_selection selection{};
  if (!select_floating_format(spec, selection)) {
    return format_argument_status::invalid_specifier;
  }
  mut uint8_t buffer[4096] = {};
  mut uint64_t count = uint64_t(0);
  mut uint32_t code = uint32_t(0);
  mut uint32_t flags = uint32_t(0);
  if (selection.uppercase) { flags += uint32_t(1); }
  if (spec.alternate) { flags += uint32_t(2); }
  if (selection.general) { flags += uint32_t(4); }
  unsafe {
    code = gti_internal::runtime::gti_rt_format_f32_v1(
        value, numeric_format(selection.style), selection.precision,
        flags, uint32_t(uint8_t(spec.fill)),
        uint32_t(uint8_t(spec.alignment)), uint32_t(uint8_t(spec.sign)),
        spec.zero_pad ? uint32_t(1) : uint32_t(0), uint64_t(spec.width),
        &buffer[0], uint64_t(4096), &count);
  }
  if (code != uint32_t(0) || count > uint64_t(4096)) {
    return format_argument_status::invalid_specifier;
  }
  reserve_additional(output, size_t(count));
  for (mut uint64_t index = uint64_t(0); index < count; index++) {
    output.push_back(char(buffer[index]));
  }
  return format_argument_status::appended;
}

format_argument_status append_float64(mut string& output, double& value,
                                      format_spec& spec) {
  mut floating_format_selection selection{};
  if (!select_floating_format(spec, selection)) {
    return format_argument_status::invalid_specifier;
  }
  mut uint8_t buffer[4096] = {};
  mut uint64_t count = uint64_t(0);
  mut uint32_t code = uint32_t(0);
  mut uint32_t flags = uint32_t(0);
  if (selection.uppercase) { flags += uint32_t(1); }
  if (spec.alternate) { flags += uint32_t(2); }
  if (selection.general) { flags += uint32_t(4); }
  unsafe {
    code = gti_internal::runtime::gti_rt_format_f64_v1(
        value, numeric_format(selection.style), selection.precision,
        flags, uint32_t(uint8_t(spec.fill)),
        uint32_t(uint8_t(spec.alignment)), uint32_t(uint8_t(spec.sign)),
        spec.zero_pad ? uint32_t(1) : uint32_t(0), uint64_t(spec.width),
        &buffer[0], uint64_t(4096), &count);
  }
  if (code != uint32_t(0) || count > uint64_t(4096)) {
    return format_argument_status::invalid_specifier;
  }
  reserve_additional(output, size_t(count));
  for (mut uint64_t index = uint64_t(0); index < count; index++) {
    output.push_back(char(buffer[index]));
  }
  return format_argument_status::appended;
}

void append_selected_format_argument<T>(mut string& output,
                                        size_t requested,
                                        mut size_t& candidate,
                                        mut format_argument_status& status,
                                        format_spec& spec, T& value)
    requires formattable<T> {
  if (status != format_argument_status::appended) {
    candidate++;
    return;
  }
  if (candidate == requested) {
    formatter<T> writer{};
    auto formatted = writer.format(value, output, spec);
    if (!formatted) {
      switch (formatted.error()) {
      case format_errc::unsupported_argument:
        status = format_argument_status::unsupported;
        break;
      case format_errc::argument_count_mismatch:
        status = format_argument_status::argument_count_mismatch;
        break;
      case format_errc::invalid_format:
        status = format_argument_status::invalid_specifier;
        break;
      }
    }
  }
  candidate++;
}

void append_format_literal(mut string& output, string_view pattern,
                           mut size_t& cursor) {
  char current = pattern[cursor];
  if ((current == '{' || current == '}') &&
      cursor + 1 < pattern.size() && pattern[cursor + 1] == current) {
    output.push_back(current);
    cursor += 2;
    return;
  }
  output.push_back(current);
  cursor++;
}
}
}

class std::formatter<int8_t> {
public:
  expected<void, std::format_errc> format(int8_t& value, mut std::string& output, std::format_spec& spec) {
    return std::detail::format_result(this.append(output, value, spec));
  }

private:
  std::detail::format_argument_status append(mut std::string& output,
                                              int8_t& value,
                                              std::format_spec& spec) {
    return std::detail::append_integral(output, value, spec);
  }
};
class std::formatter<uint8_t> {
public:
  expected<void, std::format_errc> format(uint8_t& value, mut std::string& output, std::format_spec& spec) {
    return std::detail::format_result(this.append(output, value, spec));
  }

private:
  std::detail::format_argument_status append(mut std::string& output,
                                              uint8_t& value,
                                              std::format_spec& spec) {
    return std::detail::append_integral(output, value, spec);
  }
};
