export module span;
import "detail/memory_storage.gti";

import std.memory;
import "detail/iterator.gti";
namespace std {
namespace detail {
class span_sentinel {
  size_t final_position;

public:
  constexpr span_sentinel(size_t position) : final_position(position) {}

  constexpr size_t position() {
    return this.final_position;
  }
};

// Keep the source's checked dependency even when the view has no address.
class span_owner<lifetime source> {
  std::erased_object&<source> witness;

public:
  constexpr span_owner<Owner>(Owner&<source> owner)
      : witness(std::erase_ref(owner)) {}
};

class span_iterator<std::storage_element T, uint64_t Reverse, lifetime source> {
  span_owner<source> owner;
  const T* address = nullptr;
  mut size_t current_position;
  size_t first_position;
  size_t final_position;

public:
  constexpr span_iterator(span_owner<source> owner, const T* address, size_t begin,
                          size_t position, size_t end)
      : owner(owner), address(address), current_position(position),
        first_position(begin), final_position(end) {}

  constexpr T& operator*() {
    mut size_t position = this.current_position;
    if constexpr (Reverse != 0) {
      position = detail::checked_iterator_position(position, this.first_position,
                                                   this.final_position, ptrdiff_t(-1));
    }
    gti_internal::index_bounds_check(position, this.final_position);
    unsafe { return std::assume_ref(this.address + position, this); }
  }

  constexpr T& operator->() { return *this; }

  constexpr void operator++() mut {
    this.current_position = detail::checked_iterator_step<Reverse>(
        this.current_position, this.first_position, this.final_position);
  }

  constexpr void operator--() mut {
    this.current_position = detail::checked_iterator_step<Reverse, 1>(
        this.current_position, this.first_position, this.final_position);
  }

  constexpr void operator+=(ptrdiff_t offset) mut {
    this.current_position = detail::checked_iterator_position(
        this.current_position, this.first_position, this.final_position, offset, Reverse != 0);
  }

  constexpr void operator-=(ptrdiff_t offset) mut {
    this.current_position = detail::checked_iterator_position(
        this.current_position, this.first_position, this.final_position, offset, Reverse == 0);
  }

  constexpr T& operator[](ptrdiff_t offset) {
    mut size_t position = detail::checked_iterator_position(
        this.current_position, this.first_position, this.final_position, offset, Reverse != 0);
    if constexpr (Reverse != 0) {
      position = detail::checked_iterator_position(position, this.first_position,
                                                   this.final_position, ptrdiff_t(-1));
    }
    gti_internal::index_bounds_check(position, this.final_position);
    unsafe { return std::assume_ref(this.address + position, this); }
  }

  constexpr ptrdiff_t operator-(span_sentinel sentinel) {
    if constexpr (Reverse != 0) { return detail::checked_iterator_difference(sentinel.position(), this.current_position); }
    return detail::checked_iterator_difference(this.current_position, sentinel.position());
  }

  constexpr ptrdiff_t operator-(span_iterator<T, Reverse>& other) {
    if constexpr (Reverse != 0) { return detail::checked_iterator_difference(other.current_position, this.current_position); }
    return detail::checked_iterator_difference(this.current_position, other.current_position);
  }

  constexpr bool operator!=(span_sentinel sentinel) {
    return this.current_position != sentinel.position();
  }

  constexpr bool operator!=(span_iterator<T, Reverse>& other) {
    return this.current_position != other.current_position;
  }

  constexpr bool operator==(span_sentinel sentinel) {
    return this.current_position == sentinel.position();
  }

  constexpr bool operator==(span_iterator<T, Reverse>& other) {
    return this.current_position == other.current_position;
  }
};

constexpr span_iterator<T, Reverse, source>
make_prefix_span_iterator<std::storage_element T, uint64_t Reverse, lifetime source>(
    prefix_owner<T>&<source> prefix, size_t begin, size_t position, size_t end) {
  unsafe {
    return span_iterator<T, Reverse, source>(span_owner<source>(prefix),
                                            prefix.address(), begin, position, end);
  }
}

class mutable_span_iterator<std::storage_element T, uint64_t Reverse = 0> {
  mut std::detail::prefix_owner<T>& data;
  mut size_t current_position;
  size_t first_position;
  size_t final_position;
public:
  constexpr mutable_span_iterator(mut std::detail::prefix_owner<T>& source,
                        size_t begin, size_t end)
      : data(source), current_position(begin), first_position(begin), final_position(end) {
    if (begin > end) { gti_internal::index_bounds_check(begin, end); }
    if (end > source.length()) { gti_internal::index_bounds_check(end, source.length()); }
  }
  constexpr mutable_span_iterator(mut std::detail::prefix_owner<T>& source,
                        size_t begin, size_t position, size_t end)
      : data(source), current_position(position), first_position(begin), final_position(end) {
    if (begin > position) { gti_internal::index_bounds_check(begin, position); }
    if (position > end) { gti_internal::index_bounds_check(position, end); }
    if (end > source.length()) { gti_internal::index_bounds_check(end, source.length()); }
  }
  constexpr T& operator*() {
    mut size_t position = this.current_position;
    if constexpr (Reverse != 0) {
      position = detail::checked_iterator_position(position, this.first_position,
                                                   this.final_position, ptrdiff_t(-1));
    }
    gti_internal::index_bounds_check(position, this.final_position);
    unsafe { return this.data.read_unchecked(position); }
  }
  constexpr mut T& operator*() mut {
    mut size_t position = this.current_position;
    if constexpr (Reverse != 0) {
      position = detail::checked_iterator_position(position, this.first_position,
                                                   this.final_position, ptrdiff_t(-1));
    }
    gti_internal::index_bounds_check(position, this.final_position);
    unsafe { return this.data.read_mut_unchecked(position); }
  }
  constexpr T& operator->() { return *this; }
  constexpr mut T& operator->() mut { return *this; }
  constexpr void operator++() mut {
    this.current_position = detail::checked_iterator_step<Reverse>(
        this.current_position, this.first_position, this.final_position);
  }
  constexpr void operator--() mut {
    this.current_position = detail::checked_iterator_step<Reverse, 1>(
        this.current_position, this.first_position, this.final_position);
  }
  constexpr void operator+=(ptrdiff_t offset) mut {
    this.current_position = detail::checked_iterator_position(
        this.current_position, this.first_position, this.final_position, offset, Reverse != 0);
  }
  constexpr void operator-=(ptrdiff_t offset) mut {
    this.current_position = detail::checked_iterator_position(
        this.current_position, this.first_position, this.final_position, offset, Reverse == 0);
  }
  constexpr T& operator[](ptrdiff_t offset) {
    mut size_t position = detail::checked_iterator_position(
        this.current_position, this.first_position, this.final_position, offset, Reverse != 0);
    if constexpr (Reverse != 0) {
      position = detail::checked_iterator_position(position, this.first_position,
                                                   this.final_position, ptrdiff_t(-1));
    }
    gti_internal::index_bounds_check(position, this.final_position);
    unsafe { return this.data.read_unchecked(position); }
  }
  constexpr mut T& operator[](ptrdiff_t offset) mut {
    mut size_t position = detail::checked_iterator_position(
        this.current_position, this.first_position, this.final_position, offset, Reverse != 0);
    if constexpr (Reverse != 0) {
      position = detail::checked_iterator_position(position, this.first_position,
                                                   this.final_position, ptrdiff_t(-1));
    }
    gti_internal::index_bounds_check(position, this.final_position);
    unsafe { return this.data.read_mut_unchecked(position); }
  }
  constexpr ptrdiff_t operator-(span_sentinel sentinel) {
    if constexpr (Reverse != 0) { return detail::checked_iterator_difference(sentinel.position(), this.current_position); }
    return detail::checked_iterator_difference(this.current_position, sentinel.position());
  }
  constexpr ptrdiff_t operator-(mutable_span_iterator<T, Reverse>& other) {
    if constexpr (Reverse != 0) { return detail::checked_iterator_difference(other.current_position, this.current_position); }
    return detail::checked_iterator_difference(this.current_position, other.current_position);
  }
  constexpr bool operator!=(span_sentinel sentinel) {
    return this.current_position != sentinel.position();
  }
  constexpr bool operator==(span_sentinel sentinel) {
    return this.current_position == sentinel.position();
  }
  constexpr bool operator!=(mutable_span_iterator<T, Reverse>& other) {
    return this.current_position != other.current_position;
  }
  constexpr bool operator==(mutable_span_iterator<T, Reverse>& other) {
    return this.current_position == other.current_position;
  }
};
}

/// A checked read-only view over one source-defined contiguous owner.
export class span<std::storage_element T, lifetime source> {
  detail::span_owner<source> owner;
  const T* address = nullptr;
  size_t first_position;
  size_t element_count;

  constexpr void validate_subspan(size_t offset, size_t count) {
    if (offset > this.element_count) {
      gti_internal::index_bounds_check(offset, this.element_count);
    }
    size_t remaining = this.element_count - offset;
    if (count > remaining) {
      gti_internal::index_bounds_check(count, remaining);
    }
  }

public:
  using const_iterator = detail::span_iterator<T, 0, source>;
  using const_reverse_iterator = detail::span_iterator<T, 1, source>;
  using sentinel = detail::span_sentinel;

  // Trusted source factories and subviews supply a validated range within
  // the borrow. Only the library can construct the opaque owner witness.
  constexpr span(detail::span_owner<source> owner, const T* address, size_t offset, size_t count)
      : owner(owner), address(address), first_position(offset), element_count(count) {}

  /// Returns the number of elements in this view.
  constexpr size_t size() {
    return this.element_count;
  }

  /// Returns whether this view contains no elements.
  constexpr bool empty() {
    return this.element_count == 0;
  }

  constexpr T& front() {
    return this.at(size_t(0));
  }

  constexpr T& back() {
    mut size_t index = size_t(0);
    if (this.element_count > 0) {
      index = this.element_count - 1;
    }
    return this.at(index);
  }

  constexpr T& at(size_t index) {
    gti_internal::index_bounds_check(index, this.element_count);
    unsafe { return this.get_unchecked(index); }
  }

  /// The caller proves index < size(); the view's owner loan is retained.
  unsafe constexpr T& get_unchecked(size_t index) {
    unsafe {
      size_t position = gti_internal::integer_wrapping_add(this.first_position, index);
      return std::assume_ref(this.address + position, this);
    }
  }

  constexpr T& operator[](size_t index) {
    return this.at(index);
  }

  constexpr span<T, source> first(size_t count) {
    this.validate_subspan(size_t(0), count);
    return span<T, source>(this.owner, this.address, this.first_position, count);
  }

  constexpr span<T, source> last(size_t count) {
    this.validate_subspan(size_t(0), count);
    return span<T, source>(this.owner, this.address,
                          this.first_position + (this.element_count - count), count);
  }

  constexpr span<T, source> subspan(size_t offset, size_t count) {
    this.validate_subspan(offset, count);
    return span<T, source>(this.owner, this.address, this.first_position + offset, count);
  }

  constexpr const_iterator begin() {
    return const_iterator(this.owner, this.address, this.first_position,
                          this.first_position, this.first_position + this.element_count);
  }

  constexpr detail::span_sentinel end() {
    return detail::span_sentinel(this.first_position + this.element_count);
  }

  constexpr const_iterator end_iterator() {
    size_t end = this.first_position + this.element_count;
    return const_iterator(this.owner, this.address, this.first_position, end, end);
  }

  constexpr const_iterator cbegin() { return this.begin(); }
  constexpr detail::span_sentinel cend() { return this.end(); }

  constexpr const_reverse_iterator rbegin() {
    size_t end = this.first_position + this.element_count;
    return const_reverse_iterator(this.owner, this.address, this.first_position, end, end);
  }
  constexpr detail::span_sentinel rend() { return detail::span_sentinel(this.first_position); }
  constexpr const_reverse_iterator crbegin() { return this.rbegin(); }
  constexpr detail::span_sentinel crend() { return this.rend(); }
};

}

export namespace gti_internal {
// The caller supplies an initialized contiguous range covered by the owner
// loan. A null address is valid for an empty range.
constexpr std::span<T, source> make_span<std::storage_element T, Owner, lifetime source>(
    Owner&<source> owner, const T* address, std::size_t offset, std::size_t count) {
  return std::span<T, source>(std::detail::span_owner<source>(owner), address, offset, count);
}

/// Views the entire fixed array while retaining its read-only owner borrow.
constexpr std::span<T, source> array_as_span<std::storage_element T, uint64_t N, lifetime source>(
    T[N]&<source> values) {
  if constexpr (N == 0) {
    const T* address = nullptr;
    unsafe { return make_span(values, address, std::size_t(0), std::size_t(0)); }
  } else {
    unsafe { return make_span(values, &values[0], std::size_t(0), std::size_t(N)); }
  }
}
}

namespace std {

/// An exclusive, move-only view of initialized contiguous elements.
/// Reborrowing a subspan suspends access through its parent until the child ends.
export class mutable_span<std::storage_element T> {
  mut std::detail::prefix_owner<T>& data;
  size_t first_position;
  size_t element_count;

  constexpr void validate_subspan(size_t offset, size_t count) {
    if (offset > this.element_count) {
      gti_internal::index_bounds_check(offset, this.element_count);
    }
    if (count > this.element_count - offset) {
      gti_internal::index_bounds_check(count, this.element_count - offset);
    }
  }

public:
  using iterator = detail::mutable_span_iterator<T>;
  using const_iterator = detail::span_iterator<T, 0>;
  using reverse_iterator = detail::mutable_span_iterator<T, 1>;
  using const_reverse_iterator = detail::span_iterator<T, 1>;
  using sentinel = detail::span_sentinel;

  constexpr mutable_span(mut std::detail::prefix_owner<T>& source,
               size_t offset, size_t count)
      : data(source), first_position(offset), element_count(count) {
    if (offset > source.length()) { gti_internal::index_bounds_check(offset, source.length()); }
    size_t remaining = source.length() - offset;
    if (count > remaining) { gti_internal::index_bounds_check(count, remaining); }
  }

  constexpr size_t size() { return this.element_count; }
  constexpr bool empty() { return this.element_count == 0; }

  constexpr T& at(size_t index) {
    gti_internal::index_bounds_check(index, this.element_count);
    unsafe { return this.get_unchecked(index); }
  }
  constexpr mut T& at(size_t index) mut {
    gti_internal::index_bounds_check(index, this.element_count);
    unsafe { return this.get_unchecked_mut(index); }
  }
  /// The caller proves index < size(); the view's owner loan is retained.
  unsafe constexpr T& get_unchecked(size_t index) {
    unsafe {
      return this.data.read_unchecked(
          gti_internal::integer_wrapping_add(this.first_position, index));
    }
  }
  unsafe constexpr mut T& get_unchecked_mut(size_t index) mut {
    unsafe {
      return this.data.read_mut_unchecked(
          gti_internal::integer_wrapping_add(this.first_position, index));
    }
  }
  constexpr T& operator[](size_t index) { return this.at(index); }
  constexpr mut T& operator[](size_t index) mut { return this.at(index); }
  constexpr T& front() { return this.at(size_t(0)); }
  constexpr mut T& front() mut { return this.at(size_t(0)); }
  constexpr T& back() {
    mut size_t index = 0;
    if (this.element_count > 0) { index = this.element_count - 1; }
    return this.at(index);
  }
  constexpr mut T& back() mut {
    mut size_t index = 0;
    if (this.element_count > 0) { index = this.element_count - 1; }
    return this.at(index);
  }

  constexpr mutable_span<T> subspan(size_t offset, size_t count) mut {
    this.validate_subspan(offset, count);
    return mutable_span<T>(this.data, this.first_position + offset, count);
  }
  constexpr mutable_span<T> first(size_t count) mut {
    this.validate_subspan(size_t(0), count);
    return mutable_span<T>(this.data, this.first_position, count);
  }
  constexpr mutable_span<T> last(size_t count) mut {
    this.validate_subspan(size_t(0), count);
    return mutable_span<T>(this.data, this.first_position + (this.element_count - count), count);
  }
  constexpr span<T> as_span() {
    unsafe {
      return gti_internal::make_span(this.data, this.data.address(),
                                     this.first_position, this.element_count);
    }
  }
  constexpr const_iterator begin() {
    return detail::make_prefix_span_iterator<T, 0>(this.data, this.first_position,
        this.first_position, this.first_position + this.element_count);
  }
  constexpr detail::mutable_span_iterator<T> begin_mut() mut {
    return detail::mutable_span_iterator<T>(this.data, this.first_position,
                                           this.first_position + this.element_count);
  }
  constexpr detail::span_sentinel end() {
    return detail::span_sentinel(this.first_position + this.element_count);
  }
  constexpr const_iterator end_iterator() {
    size_t end = this.first_position + this.element_count;
    return detail::make_prefix_span_iterator<T, 0>(this.data, this.first_position, end, end);
  }
  constexpr detail::mutable_span_iterator<T> end_mut() mut {
    size_t end = this.first_position + this.element_count;
    return detail::mutable_span_iterator<T>(this.data, this.first_position, end, end);
  }
  constexpr const_iterator cbegin() { return this.begin(); }
  constexpr detail::span_sentinel cend() { return this.end(); }
  constexpr const_reverse_iterator rbegin() {
    size_t end = this.first_position + this.element_count;
    return detail::make_prefix_span_iterator<T, 1>(this.data, this.first_position, end, end);
  }
  constexpr detail::span_sentinel rend() { return detail::span_sentinel(this.first_position); }
  constexpr const_reverse_iterator crbegin() { return this.rbegin(); }
  constexpr detail::span_sentinel crend() { return this.rend(); }
  constexpr reverse_iterator rbegin_mut() mut {
    size_t end = this.first_position + this.element_count;
    return reverse_iterator(this.data, this.first_position, end, end);
  }
  constexpr reverse_iterator rend_mut() mut {
    return reverse_iterator(this.data, this.first_position, this.first_position,
                            this.first_position + this.element_count);
  }
};
}
