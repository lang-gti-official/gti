// C++-familiar API scaffold for <std/span>.
//
// The first safe span is a move-only, read-only owner-dependent view. Source
// constructors, mutable access, iteration, and data() remain omitted until GTI
// can retain the source owner's lifetime and invalidation state without
// exposing a pointer-and-length pair. Bodyless members are not implemented.

namespace std {
class span<T> {
public:
  span() {}

  span(span<T>& other) = delete;
  span(span<T>&& other) = default;

  size_t size();
  bool empty();

  T& front();
  T& back();
  T& at(size_t index);
  T& operator[](size_t index);

  span<T> first(size_t count);
  span<T> last(size_t count);
  span<T> subspan(size_t offset, size_t count);
};
}
