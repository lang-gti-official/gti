// C++-familiar API scaffold for <std/span>.
// This intentionally omits data() until GTI has a safe contiguous-address
// representation and owner-tied lifetime model.

namespace std {
class span<T> {
public:
  span() {}

  size_t size();
  bool empty();

  T& front();
  mut T& front() mut;
  T& back();
  mut T& back() mut;
  T& at(size_t index);
  mut T& at(size_t index) mut;
  T& operator[](size_t index);
  mut T& operator[](size_t index) mut;

  span<T> first(size_t count);
  span<T> last(size_t count);
  span<T> subspan(size_t offset, size_t count);
};
}
