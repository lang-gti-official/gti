#include <std/memory>

namespace gti_internal {
// Ordinary GTI cleanup policy. A local guard resumes the remaining reverse
// traversal if the first destructor fails; it never retries a retired slot.
class sparse_drain<std::layout_queryable T> {
  T* objects = nullptr;
  uint8_t* live = nullptr;
  mut uint64_t next;
public:
  sparse_drain(T* objects, uint8_t* live, uint64_t count)
      : objects(objects), live(live), next(count) {}
  void finish() mut {
    unsafe {
      while (this.next > uint64_t(0)) {
        this.next--;
        if (this.live[this.next] != uint8_t(0)) {
          this.live[this.next] = uint8_t(0);
          std::destroy_at(this.objects + this.next);
        }
      }
    }
  }
  ~sparse_drain() { this.finish(); }
};

// Owns element lifetimes only. Enclosing leases keep both disjoint regions
// alive until after this object is destroyed, and alone release their bytes.
// This is source policy, not a compiler-recognized capability or public type.
[[unsafe_transfer(T), unsafe_share(T)]]
class sparse_slots<std::layout_queryable T> {
  mut T* objects = nullptr;
  mut uint8_t* live = nullptr;
  mut uint64_t slots = 0;
public:
  sparse_slots() {}
  sparse_slots(sparse_slots<T>& other) = delete;
  sparse_slots(sparse_slots<T>&& other) = default;

  // The caller supplies exclusive vacant object storage and writable metadata
  // with sufficient extent/alignment; neither region may move or be released
  // until the element owner dies. Metadata initialization cannot invoke T.
  unsafe void attach(T* objects, uint8_t* live, uint64_t count) mut {
    require_relocation_capacity(this.slots == uint64_t(0));
    unsafe {
      for (mut uint64_t index = 0; index < count; index++) {
        std::construct_at(live + index, uint8_t(0));
      }
    }
    this.objects = objects;
    this.live = live;
    this.slots = count;
  }
  uint64_t capacity() { return this.slots; }
  bool initialized(uint64_t index) {
    if (index >= this.slots) { return false; }
    unsafe { return this.live[index] != uint8_t(0); }
  }
  [[discardable]]
  mut T& emplace<Args...>(uint64_t index, Args... args) mut {
    index_bounds_check(index, this.slots);
    require_vacant_storage(!this.initialized(index));
    unsafe {
      std::construct_at(this.objects + index, args...);
      this.live[index] = uint8_t(1);
      return std::assume_mut(this.objects + index, this);
    }
  }
  T& read(uint64_t index) {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe { return std::assume_ref(this.objects + index, this); }
  }
  mut T& read_mut(uint64_t index) mut {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe { return std::assume_mut(this.objects + index, this); }
  }
  void destroy(uint64_t index) mut {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe {
      this.live[index] = uint8_t(0);
      std::destroy_at(this.objects + index);
    }
  }
  void clear() mut {
    mut sparse_drain<T> pending{this.objects, this.live, this.slots};
    pending.finish();
  }
  void relocate_to(mut sparse_slots<T>& destination, uint64_t count) mut
      requires std::relocatable<T> {
    require_relocation_capacity(count <= this.slots && count <= destination.slots);
    for (mut uint64_t index = 0; index < count; index++) {
      require_relocation_source(this.initialized(index));
      require_relocation_destination(!destination.initialized(index));
    }
    unsafe {
      for (mut uint64_t index = 0; index < count; index++) {
        std::relocate_at(destination.objects + index, this.objects + index);
        this.live[index] = uint8_t(0);
        destination.live[index] = uint8_t(1);
      }
    }
  }
  void shift_right(uint64_t first, uint64_t last) mut
      requires std::relocatable<T> {
    require_relocation_capacity(first <= last && last < this.slots);
    require_relocation_destination(!this.initialized(last));
    for (mut uint64_t index = first; index < last; index++) {
      require_relocation_source(this.initialized(index));
    }
    unsafe {
      mut uint64_t destination = last;
      while (destination > first) {
        uint64_t source = destination - uint64_t(1);
        std::relocate_at(this.objects + destination, this.objects + source);
        this.live[source] = uint8_t(0);
        this.live[destination] = uint8_t(1);
        destination--;
      }
    }
  }
  void shift_left(uint64_t first, uint64_t last) mut
      requires std::relocatable<T> {
    require_relocation_capacity(first < last && last <= this.slots);
    require_relocation_destination(!this.initialized(first));
    for (mut uint64_t index = first + uint64_t(1); index < last; index++) {
      require_relocation_source(this.initialized(index));
    }
    unsafe {
      for (mut uint64_t source = first + uint64_t(1); source < last; source++) {
        uint64_t destination = source - uint64_t(1);
        std::relocate_at(this.objects + destination, this.objects + source);
        this.live[source] = uint8_t(0);
        this.live[destination] = uint8_t(1);
      }
    }
  }
  ~sparse_slots() { this.clear(); }
};
}
