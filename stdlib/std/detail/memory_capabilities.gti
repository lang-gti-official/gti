export module detail.memory_capabilities;

namespace gti_internal {
namespace runtime {
export extern "C" {
  const uint8_t* gti_rt_c_string_bytes_v1(c_string text);
}
}
export class unique_owner<T> {};
export class shared_owner<T> {
public:
  shared_owner() = default;
};
// Layout-only capability: no engagement bit and no automatic payload drop.
export class uninitialized_storage<T> {
public:
  uninitialized_storage() = default;
};
// An opaque referent identity, never an object GTI source may construct/read.
export class erased_object {};
export erased_object& erase_reference<T>(T& object);
export mut erased_object& erase_reference_mut<T>(mut T& object);
export unsafe T& restore_reference<T>(erased_object& object);
export unsafe mut T& restore_reference_mut<T>(mut erased_object& object);

export uint64_t object_size<T>();
export uint64_t object_alignment<T>();
export void object_destroy<T>(T* address);
export void object_construct<T, Args...>(T* address, Args... args);
export void object_relocate<T>(T* destination, T* source);
export void object_relocate_range<T>(T* destination, T* source, uint64_t count);
export gti_internal::text_view text_view_from_address<Owner>(
    const char* address, uint64_t count, Owner& owner);
export gti_internal::c_string c_string_from_address<Owner>(
    const char* address, Owner& owner);

export gti_internal::shared_owner<T> shared_owner_empty<T>();
export gti_internal::shared_owner<T> shared_owner_from_unique<T>(gti_internal::unique_owner<T> owner);
export gti_internal::shared_owner<T> shared_owner_clone<T>(gti_internal::shared_owner<T>& owner);
export T& shared_owner_borrow<T>(gti_internal::shared_owner<T>& owner);
export bool shared_owner_is_null<T>(gti_internal::shared_owner<T>& owner);
export uint64_t shared_owner_use_count<T>(gti_internal::shared_owner<T>& owner);
export void shared_owner_swap<T>(mut gti_internal::shared_owner<T>& left,
                         mut gti_internal::shared_owner<T>& right);
export gti_internal::shared_owner<Base> shared_owner_upcast<Base, Derived>(
    gti_internal::shared_owner<Derived> owner);

export gti_internal::unique_owner<T> allocate_unique_owner<T, Args...>(Args... args);
export T & unique_owner_borrow<T>(gti_internal::unique_owner<T>& owner);
export mut T & unique_owner_borrow_mut<T>(mut gti_internal::unique_owner<T>& owner);
export bool unique_owner_is_null<T>(gti_internal::unique_owner<T>& owner);
export void unique_owner_swap<T>(mut gti_internal::unique_owner<T>& left,
                          mut gti_internal::unique_owner<T>& right);
export gti_internal::unique_owner<Base> unique_owner_upcast<Base, Derived>(gti_internal::unique_owner<Derived> owner);

/// Seals adoption of freshly allocated, wholly uninitialized typed storage.
///
/// This is ordinary source-defined standard-library policy, not a compiler
/// intrinsic. Application source cannot name the compiler-private namespace,
/// so only trusted library factories can establish the adoption precondition.
export enum class empty_storage_adoption {
  trusted,
};
}

namespace gti_internal {
namespace runtime {
export extern "C" {
uint64_t gti_rt_native_size_max_v1();
int32_t gti_rt_address_is_aligned_v1(const void* address, uint64_t alignment);
}
#if target.os == "windows"
export extern "C" {
void* gti_rt_aligned_malloc_v1(uint64_t bytes, uint64_t alignment);
void gti_rt_aligned_free_v1(void* address);
}
#else
export extern "C" {
uint64_t gti_rt_posix_pointer_size_v1();
int32_t gti_rt_posix_enomem_v1();
int32_t gti_rt_posix_einval_v1();
void* gti_rt_posix_memalign_v1(uint64_t bytes, uint64_t alignment, int32_t* status);
void gti_rt_posix_free_v1(void* address);
}
#endif
}
}
