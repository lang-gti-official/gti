export module detail.memory_storage;

import std.meta;
import "memory_capabilities.gti";
import "memory_core.gti";
import "iterator.gti";

namespace std {
namespace detail {
[[discardable]]
unsafe T* construct_value_at<T>(T* address, T value) requires layout_queryable<T> {
  unsafe { gti_internal::object_construct(address, std::move(value)); }
  return address;
}
}
}

namespace gti_internal {
// Source policy seal: no public spelling establishes allocator trust.
export enum class resource_binding { trusted };

}

namespace std::detail {
/// Passive provider descriptor. Ownership belongs to a lease, not this value.
/// Copying it copies metadata only: it neither retains a region nor authorizes
/// a second release. The provider defines id; the process resource uses zero.
export struct raw_allocation {
  void* address = nullptr;
  uint64_t bytes = 0;
  uint64_t alignment = 0;
  uint64_t id = 0;
  raw_allocation() {}
  raw_allocation(void* address, uint64_t bytes, uint64_t alignment, uint64_t id)
      : address(address), bytes(bytes), alignment(alignment), id(id) {}
};

}

namespace gti_internal {
// Infallible source policy distinguishes exhaustion from a malformed or
// overflowing request. Fallible callers keep the original alloc_errc value.
export [[noreturn, track_caller]]
void fail_allocation(std::alloc_errc error) {
  if (error == std::alloc_errc::resource_exhausted) {
    gti_internal::require_allocation(false);
  }
  if (error == std::alloc_errc::size_overflow) {
    gti_internal::panic("Allocation size overflow");
  }
  gti_internal::panic("Invalid allocation request or resource region");
}

export class process_resource {
public:
  process_resource() {}
  unsafe expected<std::detail::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    if (request.alignment == uint64_t(0) or
        (request.alignment & (request.alignment - uint64_t(1))) != uint64_t(0)) {
      return unexpected(std::alloc_errc::invalid_alignment);
    }
    // The byte-provider ABI carries at most 64 bits; c_size_t retains the
    // target C size type's exact layout. These bounds fold with target layout.
    uint64_t size_bytes = std::layout_of<c_size_t>().bytes;
    uint64_t maximum = uint64_t(18446744073709551615) >>
        ((uint64_t(8) - size_bytes) * uint64_t(8));
    if (request.bytes > maximum or request.alignment > maximum) {
      return unexpected(std::alloc_errc::size_overflow);
    }
    if (request.bytes == uint64_t(0)) {
      return std::detail::raw_allocation(nullptr, request.bytes, request.alignment, uint64_t(0));
    }
    unsafe {
#if target.os == "windows"
      void* address = gti_internal::runtime::gti_rt_aligned_malloc_v1(
          request.bytes, request.alignment);
#else
      mut uint64_t selected = request.alignment;
      uint64_t native_minimum = std::layout_of<void*>().bytes;
      if (selected < native_minimum) { selected = native_minimum; }
      mut int32_t status = 0;
      void* address = gti_internal::runtime::gti_rt_posix_memalign_v1(
          request.bytes, selected, &status);
      // Platform error constants matter only on the failure path.
      if (status != 0) {
        if (status == gti_internal::runtime::gti_rt_posix_einval_v1()) {
          return unexpected(std::alloc_errc::invalid_alignment);
        }
        if (status == gti_internal::runtime::gti_rt_posix_enomem_v1()) {
          return unexpected(std::alloc_errc::resource_exhausted);
        }
        return unexpected(std::alloc_errc::invalid_region);
      }
#endif
      if (address == nullptr) { return unexpected(std::alloc_errc::resource_exhausted); }
      return std::detail::raw_allocation(address, request.bytes, request.alignment, uint64_t(0));
    }
  }
  unsafe void release(std::detail::raw_allocation allocation) {
    if (allocation.address == nullptr) { return; }
    unsafe {
#if target.os == "windows"
      gti_internal::runtime::gti_rt_aligned_free_v1(allocation.address);
#else
      gti_internal::runtime::gti_rt_posix_free_v1(allocation.address);
#endif
    }
  }
};
}

namespace std::detail {
// No external owner borrow: this lease owns one process allocation outright.
// Shared observation cannot release or mutate its bytes. Its exclusive methods
// transfer the descriptor, and generated movement suppresses source cleanup.
export [[unsafe_transfer, unsafe_share]]
class process_lease {
  mut std::detail::raw_allocation allocation;
public:
  process_lease()
      : allocation(std::detail::raw_allocation()) {}
  process_lease(gti_internal::empty_storage_adoption token, std::detail::raw_allocation allocation) : allocation(allocation) {}
  process_lease(process_lease& other) = delete;
  process_lease(process_lease&& other) = default;
  unsafe expected<std::detail::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    gti_internal::process_resource process{};
    unsafe { return process.allocate(request); }
  }
  std::detail::raw_allocation take() mut {
    std::detail::raw_allocation previous = this.allocation;
    this.allocation = std::detail::raw_allocation();
    return previous;
  }
  unsafe void attach(std::detail::raw_allocation allocation) mut { this.allocation = allocation; }
  uint64_t alignment() { return this.allocation.alignment; }
  void release() mut {
    std::detail::raw_allocation previous = this.take();
    gti_internal::process_resource process{};
    unsafe { process.release(previous); }
  }
  ~process_lease() { this.release(); }
};

class bulk_relocation_probe<T> {
public:
  bool available() requires std::bitwise_relocatable<T> { return true; }
};

}

namespace gti_internal {
export concept sparse_element<T> = std::storage_element<T>;
export concept movable_sparse_element<T> = sparse_element<T> && std::movable<T>;

// Source-defined initialized-prefix policy. The enclosing owner supplies one
// lease; these slots own object lifetimes, never the allocation itself.
export class prefix_drain<std::layout_queryable T> {
  T* objects = nullptr;
  uint64_t* live = nullptr;
public:
  prefix_drain(T* objects, uint64_t* live) : objects(objects), live(live) {}
  void finish() mut {
    unsafe {
      while (*this.live > uint64_t(0)) {
        // The positive guard establishes this subtraction locally. Spell the
        // failure-free arithmetic explicitly so cleanup of a passive element
        // does not acquire an artificial unsigned-underflow failure edge.
        *this.live = integer_wrapping_sub(*this.live, uint64_t(1));
        std::destroy_at(this.objects + *this.live);
      }
    }
  }
  ~prefix_drain() { this.finish(); }
};

// Erasure retires the removed slot before its destructor executes. If that
// destructor fails, drain the detached suffix before the enclosing prefix.
export class prefix_suffix_drain<std::layout_queryable T> {
  T* objects = nullptr;
  uint64_t first;
  mut uint64_t next;
public:
  prefix_suffix_drain(T* objects, uint64_t first, uint64_t next)
      : objects(objects), first(first), next(next) {}
  void disarm() mut { this.next = this.first; }
  void finish() mut {
    unsafe {
      while (this.next > this.first) {
        this.next = integer_wrapping_sub(this.next, uint64_t(1));
        std::destroy_at(this.objects + this.next);
      }
    }
  }
  ~prefix_suffix_drain() { this.finish(); }
};

// Byte ownership has no knowledge of initialized objects. A sequence supplies
// its one live length; every raw operation requires that sequence's proof.
export class raw_buffer<sparse_element T, byte_lease Lease> {
public:
  // Compiler-private namespace visibility seals these source-only fields.
  // Direct field projection preserves the resource's original checked loan.
  mut Lease lease;
private:
  mut T* objects = nullptr;
  mut uint64_t slots = 0;
public:
  raw_buffer() requires std::default_initializable<Lease> : lease(Lease()) {}
  raw_buffer(Lease lease) : lease(std::move(lease)) {}
  raw_buffer(raw_buffer<T, Lease>& other) = delete;
  raw_buffer(raw_buffer<T, Lease>&& other) = default;
  uint64_t capacity() { return this.slots; }
  unsafe const T* address() { return this.objects; }
  unsafe T* address() mut { return this.objects; }
  // Both leases must refer to the same resource. Their checked bindings stay
  // in place; only allocation authority and its passive shape are exchanged.
  unsafe void swap_allocation(mut raw_buffer<T, Lease>& other) mut {
    std::detail::raw_allocation previous = this.lease.take();
    unsafe {
      this.lease.attach(other.lease.take());
      other.lease.attach(previous);
    }
    T* previous_objects = this.objects;
    this.objects = other.objects;
    other.objects = previous_objects;
    uint64_t previous_slots = this.slots;
    this.slots = other.slots;
    other.slots = previous_slots;
  }
  expected<void, std::alloc_errc> try_allocate(uint64_t count) mut {
    return this.try_allocate(count, std::layout_of<T>().alignment);
  }
  expected<void, std::alloc_errc> try_allocate(uint64_t count, uint64_t minimum) mut {
    if (this.slots != uint64_t(0)) {
      return unexpected(std::alloc_errc::invalid_state);
    }
    mut T* address = nullptr;
    {
      auto allocated = try_allocate_objects<T, Lease>(this.lease, count, minimum);
      if (!allocated) { return unexpected(allocated.error()); }
      if (count != uint64_t(0)) {
        std::detail::raw_allocation region = std::move(allocated).value();
        address = std::typed_address<T>(region.address);
      }
    }
    this.objects = address;
    this.slots = count;
    return;
  }
  // Both buffers are distinct; count live source objects fit in vacant
  // destination storage. Relocation cannot fail or call custom movement.
  unsafe void relocate_to(mut raw_buffer<T, Lease>& destination, uint64_t count) mut
      requires std::relocatable<T> {
    if (count == uint64_t(0)) { return; }
    unsafe {
      if constexpr (requires(std::detail::bulk_relocation_probe<T>& probe) {
        { probe.available() } -> bool;
      }) {
        std::relocate_range_at(destination.objects, this.objects, count);
      } else {
        for (mut uint64_t index = 0; index < count;
             index = integer_wrapping_add(index, uint64_t(1))) {
          std::relocate_at(destination.objects + index, this.objects + index);
        }
      }
    }
  }
};

export class prefix_slots<sparse_element T, byte_lease Lease> {
public:
  mut raw_buffer<T, Lease> buffer;
private:
  mut uint64_t live = 0;
public:
  prefix_slots() requires std::default_initializable<Lease>
      : buffer(raw_buffer<T, Lease>()) {}
  prefix_slots(Lease lease) : buffer(raw_buffer<T, Lease>(std::move(lease))) {}
  prefix_slots(prefix_slots<T, Lease>& other) = delete;
  prefix_slots(prefix_slots<T, Lease>&& other) = default;
  uint64_t capacity() { return this.buffer.capacity(); }
  uint64_t length() { return this.live; }
  // Publishes a caller-constructed contiguous prefix without touching objects.
  // The caller owns the exclusive lease, count <= capacity(), every newly
  // included slot is initialized, and every removed slot is already destroyed.
  // A fallible construction loop must publish each completed element (or use
  // its own rollback guard) before another operation can fail.
  unsafe void set_initialized_length_unchecked(uint64_t count) mut {
    this.live = count;
  }
  expected<void, std::alloc_errc> try_allocate(uint64_t count) mut {
    return this.try_allocate(count, std::layout_of<T>().alignment);
  }
  expected<void, std::alloc_errc> try_allocate(uint64_t count, uint64_t minimum) mut {
    {
      auto allocated = this.buffer.try_allocate(count, minimum);
      if (!allocated) { return unexpected(allocated.error()); }
    }
    // Publish the empty initialized prefix after allocation and temporary
    // cleanup. Failed/rejected allocation leaves the existing prefix intact.
    this.live = uint64_t(0);
    return;
  }
  unsafe const T* address() { unsafe { return this.buffer.address(); } }
  unsafe T* address() mut { unsafe { return this.buffer.address(); } }
  T& read(uint64_t index) {
    index_bounds_check(index, this.live);
    unsafe { return this.read_unchecked(index); }
  }
  mut T& read_mut(uint64_t index) mut {
    index_bounds_check(index, this.live);
    unsafe { return this.read_mut_unchecked(index); }
  }
  unsafe T& read_unchecked(uint64_t index) {
    unsafe { return std::assume_ref(this.buffer.address() + index, this); }
  }
  unsafe mut T& read_mut_unchecked(uint64_t index) mut {
    unsafe { return std::assume_mut(this.buffer.address() + index, this); }
  }
  void append<Args...>(Args... args) mut {
    require_relocation_capacity(this.live < this.capacity());
    unsafe { this.append_unchecked(args...); }
  }
  unsafe void append_unchecked<Args...>(Args... args) mut {
    unsafe { std::construct_at(this.buffer.address() + this.live, args...); }
    this.live = integer_wrapping_add(this.live, uint64_t(1));
  }
  void append_value(T value) mut {
    require_relocation_capacity(this.live < this.capacity());
    unsafe { this.append_value_unchecked(std::move(value)); }
  }
  unsafe void append_value_unchecked(T value) mut {
    unsafe { std::detail::construct_value_at(this.buffer.address() + this.live, std::move(value)); }
    this.live = integer_wrapping_add(this.live, uint64_t(1));
  }
  void pop() mut {
    require_live_storage(this.live > uint64_t(0));
    unsafe { this.pop_unchecked(); }
  }
  unsafe void pop_unchecked() mut {
    this.live = integer_wrapping_sub(this.live, uint64_t(1));
    unsafe { std::destroy_at(this.buffer.address() + this.live); }
  }
  void clear() mut {
    unsafe {
      mut prefix_drain<T> pending{this.buffer.address(), &this.live};
      pending.finish();
    }
  }
  void relocate_to(mut prefix_slots<T, Lease>& destination) mut
      requires std::relocatable<T> {
    require_relocation_destination(destination.live == uint64_t(0));
    require_relocation_capacity(destination.capacity() >= this.live);
    unsafe { this.relocate_to_unchecked(destination); }
  }
  unsafe void relocate_to_unchecked(mut prefix_slots<T, Lease>& destination) mut
      requires std::relocatable<T> {
    unsafe { this.buffer.relocate_to(destination.buffer, this.live); }
    destination.live = this.live;
    this.live = uint64_t(0);
  }
  void insert(uint64_t index, T value) mut requires std::relocatable<T> {
    if (index > this.live) index_bounds_check(index, this.live);
    require_relocation_capacity(this.live < this.capacity());
    unsafe { this.insert_unchecked(index, std::move(value)); }
  }
  unsafe void insert_unchecked(uint64_t index, T value) mut requires std::relocatable<T> {
    unsafe {
      T* objects = this.buffer.address();
      mut uint64_t destination = this.live;
      while (destination > index) {
        uint64_t source = integer_wrapping_sub(destination, uint64_t(1));
        std::relocate_at(objects + destination, objects + source);
        destination = source;
      }
      std::detail::construct_value_at(objects + index, std::move(value));
    }
    this.live = integer_wrapping_add(this.live, uint64_t(1));
  }
  void erase(uint64_t index) mut requires std::relocatable<T> {
    index_bounds_check(index, this.live);
    unsafe { this.erase_unchecked(index); }
  }
  unsafe void erase_unchecked(uint64_t index) mut requires std::relocatable<T> {
    uint64_t previous = this.live;
    this.live = index;
    unsafe {
      T* objects = this.buffer.address();
      uint64_t next = integer_wrapping_add(index, uint64_t(1));
      mut prefix_suffix_drain<T> pending{objects, next, previous};
      std::destroy_at(objects + index);
      pending.disarm();
      for (mut uint64_t source = next; source < previous;
           source = integer_wrapping_add(source, uint64_t(1))) {
        std::relocate_at(objects + integer_wrapping_sub(source, uint64_t(1)), objects + source);
        this.live = integer_wrapping_add(this.live, uint64_t(1));
      }
    }
  }
  void swap_elements(uint64_t left, uint64_t right) mut
      requires std::relocatable<T> {
    index_bounds_check(left, this.live);
    index_bounds_check(right, this.live);
    unsafe { this.swap_elements_unchecked(left, right); }
  }
  unsafe void swap_elements_unchecked(uint64_t left, uint64_t right) mut
      requires std::relocatable<T> {
    if (left == right) { return; }
    mut std::uninitialized<T> temporary{};
    unsafe {
      T* objects = this.buffer.address();
      std::relocate_at(temporary.data(), objects + left);
      std::relocate_at(objects + left, objects + right);
      std::relocate_at(objects + right, temporary.data());
    }
  }
  unsafe void swap(mut prefix_slots<T, Lease>& other) mut {
    unsafe { this.buffer.swap_allocation(other.buffer); }
    uint64_t previous_live = this.live;
    this.live = other.live;
    other.live = previous_live;
  }
  ~prefix_slots() { this.clear(); }
};

// Ordinary GTI cleanup policy. A local guard resumes the remaining reverse
// traversal if the first destructor fails; it never retries a retired slot.
export class sparse_drain<std::layout_queryable T> {
  T* objects = nullptr;
  uint8_t* live = nullptr;
  mut uint64_t next;
public:
  sparse_drain(T* objects, uint8_t* live, uint64_t count)
      : objects(objects), live(live), next(count) {}
  void finish() mut {
    unsafe {
      while (this.next > uint64_t(0)) {
        this.next--;
        if (this.live[this.next] != uint8_t(0)) {
          this.live[this.next] = uint8_t(0);
          std::destroy_at(this.objects + this.next);
        }
      }
    }
  }
  ~sparse_drain() { this.finish(); }
};

// Owns element lifetimes only. Enclosing leases keep both disjoint regions
// alive until after this object is destroyed, and alone release their bytes.
// This is source policy, not a compiler-recognized capability or public type.
export [[unsafe_transfer(T), unsafe_share(T)]]
class sparse_slots<gti_internal::sparse_element T> {
  mut T* objects = nullptr;
  mut uint8_t* live = nullptr;
  mut uint64_t slots = 0;
public:
  sparse_slots() {}
  sparse_slots(sparse_slots<T>& other) = delete;
  sparse_slots(sparse_slots<T>&& other) = default;

  // The caller supplies exclusive vacant object storage and writable metadata
  // with sufficient extent/alignment; neither region may move or be released
  // until the element owner dies. Metadata initialization cannot invoke T.
  unsafe void attach(T* objects, uint8_t* live, uint64_t count) mut {
    require_relocation_capacity(this.slots == uint64_t(0));
    unsafe {
      for (mut uint64_t index = 0; index < count; index++) {
        std::construct_at(live + index, uint8_t(0));
      }
    }
    this.objects = objects;
    this.live = live;
    this.slots = count;
  }
  uint64_t capacity() { return this.slots; }
  bool initialized(uint64_t index) {
    if (index >= this.slots) { return false; }
    unsafe { return this.live[index] != uint8_t(0); }
  }
  [[discardable]]
  mut T& emplace<Args...>(uint64_t index, Args... args) mut {
    index_bounds_check(index, this.slots);
    require_vacant_storage(!this.initialized(index));
    unsafe {
      std::construct_at(this.objects + index, args...);
      this.live[index] = uint8_t(1);
      return std::assume_mut(this.objects + index, this);
    }
  }
  T& read(uint64_t index) {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe { return std::assume_ref(this.objects + index, this); }
  }
  mut T& read_mut(uint64_t index) mut {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe { return std::assume_mut(this.objects + index, this); }
  }
  void destroy(uint64_t index) mut {
    index_bounds_check(index, this.slots);
    require_live_storage(this.initialized(index));
    unsafe {
      this.live[index] = uint8_t(0);
      std::destroy_at(this.objects + index);
    }
  }
  void clear() mut {
    mut sparse_drain<T> pending{this.objects, this.live, this.slots};
    pending.finish();
  }
  void relocate_to(mut sparse_slots<T>& destination, uint64_t count) mut
      requires std::relocatable<T> {
    require_relocation_capacity(count <= this.slots && count <= destination.slots);
    for (mut uint64_t index = 0; index < count; index++) {
      require_relocation_source(this.initialized(index));
      require_relocation_destination(!destination.initialized(index));
    }
    unsafe {
      for (mut uint64_t index = 0; index < count; index++) {
        std::relocate_at(destination.objects + index, this.objects + index);
        this.live[index] = uint8_t(0);
        destination.live[index] = uint8_t(1);
      }
    }
  }
  void shift_right(uint64_t first, uint64_t last) mut
      requires std::relocatable<T> {
    require_relocation_capacity(first <= last && last < this.slots);
    require_relocation_destination(!this.initialized(last));
    for (mut uint64_t index = first; index < last; index++) {
      require_relocation_source(this.initialized(index));
    }
    unsafe {
      mut uint64_t destination = last;
      while (destination > first) {
        uint64_t source = destination - uint64_t(1);
        std::relocate_at(this.objects + destination, this.objects + source);
        this.live[source] = uint8_t(0);
        this.live[destination] = uint8_t(1);
        destination--;
      }
    }
  }
  void shift_left(uint64_t first, uint64_t last) mut
      requires std::relocatable<T> {
    require_relocation_capacity(first < last && last <= this.slots);
    require_relocation_destination(!this.initialized(first));
    for (mut uint64_t index = first + uint64_t(1); index < last; index++) {
      require_relocation_source(this.initialized(index));
    }
    unsafe {
      for (mut uint64_t source = first + uint64_t(1); source < last; source++) {
        uint64_t destination = source - uint64_t(1);
        std::relocate_at(this.objects + destination, this.objects + source);
        this.live[source] = uint8_t(0);
        this.live[destination] = uint8_t(1);
      }
    }
  }
  ~sparse_slots() { this.clear(); }
};

// Defensive descriptor checks are not proof of the unsafe provider contract.
// The native seam observes pointer alignment; all allocation policy stays here.
export expected<void, std::alloc_errc> validate_region(
    std::detail::raw_allocation allocation, std::layout requested) {
  if (allocation.alignment < requested.alignment) {
    return unexpected(std::alloc_errc::invalid_region);
  }
  if (allocation.alignment == uint64_t(0) ||
      (allocation.alignment & (allocation.alignment - uint64_t(1))) != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_alignment);
  }
  uint64_t maximum = runtime::gti_rt_native_size_max_v1();
  if (allocation.bytes > maximum || allocation.alignment > maximum) {
    return unexpected(std::alloc_errc::size_overflow);
  }
  if (allocation.address == nullptr || allocation.bytes < requested.bytes) {
    return unexpected(std::alloc_errc::invalid_region);
  }
  unsafe {
    if (runtime::gti_rt_address_is_aligned_v1(allocation.address, allocation.alignment) == 0) {
      return unexpected(std::alloc_errc::invalid_alignment);
    }
  }
  return;
}

// A lease retains an original byte descriptor and its selected provider.
export concept byte_lease<L> = requires(L& lease, std::layout request) {
  unsafe { lease.allocate(request) } -> expected<std::detail::raw_allocation, std::alloc_errc>;
} && requires(mut L& lease, std::detail::raw_allocation allocation) {
  unsafe { lease.attach(allocation) } -> void;
} && requires(mut L& lease) {
  { lease.release() } -> void;
} && requires(mut L& lease) {
  { lease.take() } -> std::detail::raw_allocation;
};

// Internal owner operation: the supplied lease must be empty. Callers retain
// it through all object cleanup and publish slots only after this succeeds.
// A malformed provider descriptor is attached before validation so release
// receives that exact original descriptor, not a repaired request-sized one.
export expected<std::detail::raw_allocation, std::alloc_errc> try_allocate_objects<T, Lease>(
    mut Lease& objects,
    uint64_t count, uint64_t minimum) requires sparse_element<T> && byte_lease<Lease> {
  if (minimum == uint64_t(0) || (minimum & (minimum - uint64_t(1))) != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_alignment);
  }
  std::layout object = std::layout_of<T>();
  mut uint64_t selected = object.alignment;
  if (minimum > selected) { selected = minimum; }
  uint64_t maximum = runtime::gti_rt_native_size_max_v1();
  if (selected > maximum || count > maximum / object.bytes) {
    return unexpected(std::alloc_errc::size_overflow);
  }
  if (count == uint64_t(0)) { return std::detail::raw_allocation(); }
  std::layout request{count * object.bytes, selected};
  unsafe {
    auto attempt = objects.allocate(request);
    if (!attempt) { return unexpected(attempt.error()); }
    std::detail::raw_allocation region = std::move(attempt).value();
    objects.attach(region);
    auto valid = validate_region(region, request);
    if (!valid) {
      objects.release();
      return unexpected(valid.error());
    }
    return std::move(region);
  }
}

export expected<void, std::alloc_errc> try_allocate_sparse<T, Lease>(
    mut Lease& objects, mut Lease& metadata, mut sparse_slots<T>& destination,
    uint64_t count, uint64_t minimum) requires sparse_element<T> && byte_lease<Lease> {
  // Sparse ownership needs two regions. Publication is last; a failed second
  // request returns the first region through its own lease.
  if (destination.capacity() != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_state);
  }
  if (minimum == uint64_t(0) || (minimum & (minimum - uint64_t(1))) != uint64_t(0)) {
    return unexpected(std::alloc_errc::invalid_alignment);
  }
  std::layout object = std::layout_of<T>();
  mut uint64_t selected = object.alignment;
  if (minimum > selected) { selected = minimum; }
  uint64_t maximum = runtime::gti_rt_native_size_max_v1();
  if (selected > maximum || count > maximum / object.bytes) {
    return unexpected(std::alloc_errc::size_overflow);
  }
  if (count == uint64_t(0)) { return; }
  std::layout request{count * object.bytes, selected};
  unsafe {
    auto attempt = objects.allocate(request);
    if (!attempt) { return unexpected(attempt.error()); }
    std::detail::raw_allocation region = std::move(attempt).value();
    objects.attach(region);
    auto valid = validate_region(region, request);
    if (!valid) {
      objects.release();
      return unexpected(valid.error());
    }
    // uint8_t is exactly one byte; no hidden heap or bitmap allocation occurs.
    std::layout metadata_request{count, std::layout_of<uint8_t>().alignment};
    auto flags_attempt = metadata.allocate(metadata_request);
    if (!flags_attempt) {
      objects.release();
      return unexpected(flags_attempt.error());
    }
    std::detail::raw_allocation flags = std::move(flags_attempt).value();
    metadata.attach(flags);
    auto valid_flags = validate_region(flags, metadata_request);
    if (!valid_flags) {
      metadata.release();
      objects.release();
      return unexpected(valid_flags.error());
    }
    destination.attach(std::typed_address<T>(region.address),
                       std::typed_address<uint8_t>(flags.address), count);
  }
  return;
}
}

namespace std {
namespace detail {
// Source owner: one process region and one initialized length, no slot map.
export [[unsafe_transfer(T), unsafe_share(T)]]
class prefix_owner<std::storage_element T> {
  mut gti_internal::prefix_slots<T, process_lease> data;
public:
  prefix_owner() {}
  prefix_owner(uint64_t count) {
    auto allocated = this.data.try_allocate(count);
    if (!allocated) { gti_internal::fail_allocation(allocated.error()); }
  }
  prefix_owner(prefix_owner<T>& other) = delete;
  prefix_owner(prefix_owner<T>&& other) = default;
  expected<void, alloc_errc> try_allocate(uint64_t count) mut {
    return this.data.try_allocate(count);
  }
  uint64_t capacity() { return this.data.capacity(); }
  uint64_t length() { return this.data.length(); }
  unsafe void set_initialized_length_unchecked(uint64_t count) mut {
    unsafe { this.data.set_initialized_length_unchecked(count); }
  }
  unsafe const T* address() { unsafe { return this.data.address(); } }
  unsafe T* address() mut { unsafe { return this.data.address(); } }
  T& read(uint64_t index) { return this.data.read(index); }
  mut T& read_mut(uint64_t index) mut { return this.data.read_mut(index); }
  unsafe T& read_unchecked(uint64_t index) {
    unsafe { return this.data.read_unchecked(index); }
  }
  unsafe mut T& read_mut_unchecked(uint64_t index) mut {
    unsafe { return this.data.read_mut_unchecked(index); }
  }
  void append<Args...>(Args... args) mut { this.data.append(args...); }
  void append_value(T value) mut { this.data.append_value(std::move(value)); }
  unsafe void append_unchecked<Args...>(Args... args) mut {
    unsafe { this.data.append_unchecked(args...); }
  }
  unsafe void append_value_unchecked(T value) mut {
    unsafe { this.data.append_value_unchecked(std::move(value)); }
  }
  void pop() mut { this.data.pop(); }
  unsafe void pop_unchecked() mut { unsafe { this.data.pop_unchecked(); } }
  void clear() mut { this.data.clear(); }
  void relocate_to(mut prefix_owner<T>& destination) mut
      requires std::relocatable<T> { this.data.relocate_to(destination.data); }
  unsafe void relocate_to_unchecked(mut prefix_owner<T>& destination) mut
      requires std::relocatable<T> {
    unsafe { this.data.relocate_to_unchecked(destination.data); }
  }
  void insert(uint64_t index, T value) mut requires std::relocatable<T> {
    this.data.insert(index, std::move(value));
  }
  void erase(uint64_t index) mut requires std::relocatable<T> { this.data.erase(index); }
  unsafe void insert_unchecked(uint64_t index, T value) mut requires std::relocatable<T> {
    unsafe { this.data.insert_unchecked(index, std::move(value)); }
  }
  unsafe void erase_unchecked(uint64_t index) mut requires std::relocatable<T> {
    unsafe { this.data.erase_unchecked(index); }
  }
  void swap_elements(uint64_t left, uint64_t right) mut requires std::relocatable<T> {
    this.data.swap_elements(left, right);
  }
  unsafe void swap_elements_unchecked(uint64_t left, uint64_t right) mut requires std::relocatable<T> {
    unsafe { this.data.swap_elements_unchecked(left, right); }
  }
};
}

namespace detail {
/// A slot endpoint is not an element. Sparse cursors skip vacant positions.
export class memory_slot_sentinel {
  size_t limit;
public:
  memory_slot_sentinel(size_t limit) : limit(limit) {}
  size_t position() { return this.limit; }
};

export class sparse_iterator<std::storage_element T, uint64_t Reverse = 0> {
  gti_internal::sparse_slots<T>& slots;
  mut size_t position;
public:
  sparse_iterator(gti_internal::sparse_slots<T>& slots, size_t position)
      : slots(slots), position(position) {
    gti_internal::require_container_argument(position <= slots.capacity());
    if constexpr (Reverse != 0) {
      mut size_t previous = this.position;
      this.position = size_t(0);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); break; }
      }
    } else {
      while (this.position < this.slots.capacity() && !this.slots.initialized(this.position)) {
        this.position++;
      }
    }
  }
  T& operator*() {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.slots.capacity(), ptrdiff_t(-1));
      return this.slots.read(selected);
    }
    return this.slots.read(this.position);
  }
  T& operator->() { return *this; }
  void operator++() mut {
    if constexpr (Reverse != 0) {
      gti_internal::require_container_argument(this.position > size_t(0));
      mut size_t previous = this.position - size_t(1);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); return; }
      }
      this.position = size_t(0);
      return;
    }
    gti_internal::require_container_argument(this.position < this.slots.capacity());
    mut size_t next = this.position + size_t(1);
    while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
    this.position = next;
  }
  void operator--() mut {
    if constexpr (Reverse != 0) {
      mut size_t next = this.position;
      while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
      gti_internal::require_container_argument(next < this.slots.capacity());
      this.position = next + size_t(1);
      return;
    }
    mut size_t previous = this.position;
    mut bool found = false;
    while (previous > size_t(0)) {
      previous--;
      if (this.slots.initialized(previous)) { found = true; break; }
    }
    gti_internal::require_container_argument(found);
    this.position = previous;
  }
  bool operator!=(memory_slot_sentinel end) { return this.position != end.position(); }
  bool operator==(memory_slot_sentinel end) { return this.position == end.position(); }
  bool operator!=(sparse_iterator<T, Reverse>& other) { return this.position != other.position; }
  bool operator==(sparse_iterator<T, Reverse>& other) { return this.position == other.position; }
};

export class sparse_mut_iterator<std::storage_element T, uint64_t Reverse = 0> {
  mut gti_internal::sparse_slots<T>& slots;
  mut size_t position;
public:
  sparse_mut_iterator(mut gti_internal::sparse_slots<T>& slots, size_t position)
      : slots(slots), position(position) {
    gti_internal::require_container_argument(position <= slots.capacity());
    if constexpr (Reverse != 0) {
      mut size_t previous = this.position;
      this.position = size_t(0);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); break; }
      }
    } else {
      while (this.position < this.slots.capacity() && !this.slots.initialized(this.position)) {
        this.position++;
      }
    }
  }
  T& operator*() {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.slots.capacity(), ptrdiff_t(-1));
      return this.slots.read(selected);
    }
    return this.slots.read(this.position);
  }
  mut T& operator*() mut {
    if constexpr (Reverse != 0) {
      size_t selected = checked_iterator_position(this.position, size_t(0), this.slots.capacity(), ptrdiff_t(-1));
      return this.slots.read_mut(selected);
    }
    return this.slots.read_mut(this.position);
  }
  T& operator->() { return *this; }
  mut T& operator->() mut { return *this; }
  void operator++() mut {
    if constexpr (Reverse != 0) {
      gti_internal::require_container_argument(this.position > size_t(0));
      mut size_t previous = this.position - size_t(1);
      while (previous > size_t(0)) {
        previous--;
        if (this.slots.initialized(previous)) { this.position = previous + size_t(1); return; }
      }
      this.position = size_t(0);
      return;
    }
    gti_internal::require_container_argument(this.position < this.slots.capacity());
    mut size_t next = this.position + size_t(1);
    while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
    this.position = next;
  }
  void operator--() mut {
    if constexpr (Reverse != 0) {
      mut size_t next = this.position;
      while (next < this.slots.capacity() && !this.slots.initialized(next)) { next++; }
      gti_internal::require_container_argument(next < this.slots.capacity());
      this.position = next + size_t(1);
      return;
    }
    mut size_t previous = this.position;
    mut bool found = false;
    while (previous > size_t(0)) {
      previous--;
      if (this.slots.initialized(previous)) { found = true; break; }
    }
    gti_internal::require_container_argument(found);
    this.position = previous;
  }
  bool operator!=(memory_slot_sentinel end) { return this.position != end.position(); }
  bool operator==(memory_slot_sentinel end) { return this.position == end.position(); }
};
}
}
