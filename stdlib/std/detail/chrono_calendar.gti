for concept std::chrono::detail::temporal_components<std::chrono::timestamp> {
  constexpr bool has_date() { return true; }
  constexpr bool has_time() { return true; }
  constexpr bool has_zone() { return true; }
  expected<std::chrono::detail::time_fields, std::chrono::format_error> fields(std::chrono::timestamp& value) {
    mut std::chrono::detail::time_fields result{};
    auto converted = std::chrono::local_datetime::try_from_unix_seconds(value.unix_seconds(), value.subsecond_nanoseconds());
    if (!converted) { return unexpected(std::chrono::format_error(converted.error(), 0)); }
    auto local = converted.value();
    std::chrono::detail::local_fields(result, local);
    result.abbreviation = std::string("UTC"); result.zone = std::string("UTC");
    return std::move(result);
  }
};
class std::formatter<std::chrono::timestamp> {
  mut std::chrono::detail::temporal_formatter<std::chrono::timestamp> implementation{};
public:
  constexpr formatter() {}
  constexpr bool parse(std::format_parse_context& spec) mut { return this.implementation.parse(spec); }
  expected<void, std::format_errc> format(std::chrono::timestamp& value, mut std::string& output, std::format_parse_context& spec) {
    return this.implementation.format(value, output, spec);
  }
};
