  constexpr bool has_date() { return false; }
  constexpr bool has_time() { return true; }
  constexpr bool has_zone() { return false; }
  expected<std::chrono::detail::time_fields, std::chrono::format_error> fields(std::chrono::time_of_day& value) {
    mut std::chrono::detail::time_fields result{};
    std::chrono::detail::clock_fields(result, value);
    return std::move(result);
  }
};
