export module detail_chrono_discovery_impl;
import "chrono_calendar.gti";
import "environment_snapshot.gti";
import "filesystem_result.gti";
import std.string;
import "panic.gti";

namespace std::chrono {
namespace detail {
// Only identifiers are accepted; POSIX rule strings and arbitrary paths are
// deliberately not treated as IANA names. Lookup in an explicit db is separate.
bool zone_identifier(std::string_view value) {
  if (value.empty() || value[0] == '/' || value.contains("..")) { return false; }
  for (auto c : value) {
    if (!((uint8_t(c) >= uint8_t('A') && uint8_t(c) <= uint8_t('Z')) || (uint8_t(c) >= uint8_t('a') && uint8_t(c) <= uint8_t('z')) ||
          (uint8_t(c) >= uint8_t('0') && uint8_t(c) <= uint8_t('9')) || c == '_' || c == '-' || c == '+' || c == '/')) {
      return false;
    }
  }
  return true;
}
}
/// Observes an explicit TZ identifier or the host's localtime zoneinfo link.
/// Never changes process state or guesses an identifier from an abbreviation.
export expected<std::string, errc> try_current_zone_id() {
#if target.os == "windows" || target.os == "unknown"
  return unexpected(errc::unavailable);
#else
  mut int64_t handle = 0;
  mut uint32_t status = 0;
  unsafe {
    status = gti_internal::environment_runtime::gti_rt_environment_get_v1("TZ", &handle);
  }
  if (status != uint32_t(0)) { return unexpected(errc::unavailable); }
  if (handle != 0) {
    auto snapshot = gti_internal::environment_snapshot(handle);
    auto text = std::string(snapshot.view());
    mut std::size_t start = 0;
    if (!text.empty() && text[0] == ':') { start = 1; }
    auto name = text.view().substr(start);
    if (!detail::zone_identifier(name)) { return unexpected(errc::unknown_zone); }
    return std::string(name);
  }
  mut int64_t path_handle = 0;
  mut uint32_t path_status = 0;
  unsafe {
    path_status = gti_internal::filesystem_runtime::gti_rt_fs_path_v1(uint32_t(2), "/etc/localtime", &path_handle);
  }
  if (path_status != uint32_t(0)) { return unexpected(errc::unavailable); }
  auto path = gti_internal::filesystem_result(path_handle);
  auto name = path.text();
  std::size_t position = name.find("/zoneinfo/");
  if (position == std::string::npos) { return unexpected(errc::unknown_zone); }
  auto suffix = name.view().substr(position + 10);
  if (!detail::zone_identifier(suffix)) { return unexpected(errc::unknown_zone); }
  return std::string(suffix);
#endif
}
export std::string current_zone_id() {
  auto result = try_current_zone_id();
  if (!result) { std::detail::panic("Cannot discover local time-zone identifier"); }
  return std::move(result).value();
}
}
