export module fstream;

export import std.cstdio;
export import std.iostream;
import std.filesystem;
import std.memory;
import std.io;
import std.span;
import std.vector;
import std.utility;
import std.panic;

export namespace std {
namespace ios {
  using openmode = uint32_t;
  constexpr openmode in = uint32_t(1);
  constexpr openmode out = uint32_t(2);
  constexpr openmode app = uint32_t(4);
  constexpr openmode ate = uint32_t(8);
  constexpr openmode trunc = uint32_t(16);
  constexpr openmode binary = uint32_t(32);
  constexpr openmode noreplace = uint32_t(64);
}
}

namespace std::detail {
expected<file_mode, io_errc> file_access_mode(ios::openmode flags) {
  auto mode = flags & ~(ios::binary | ios::ate);
  if (mode == ios::in) { return file_mode::read; }
  if (mode == ios::out || mode == (ios::out | ios::trunc)) { return file_mode::write; }
  if (mode == ios::app || mode == (ios::out | ios::app)) { return file_mode::append; }
  if (mode == (ios::in | ios::out)) { return file_mode::read_write; }
  if (mode == (ios::in | ios::out | ios::trunc)) { return file_mode::read_write_truncate; }
  if (mode == (ios::in | ios::app) || mode == (ios::in | ios::out | ios::app)) {
    return file_mode::read_append;
  }
  if (mode == (ios::out | ios::noreplace) || mode == (ios::out | ios::trunc | ios::noreplace)) {
    return file_mode::write_exclusive;
  }
  if (mode == (ios::in | ios::out | ios::trunc | ios::noreplace)) {
    return file_mode::read_write_exclusive;
  }
  return unexpected(io_errc::unsupported_mode);
}
}

export namespace std {
/// A byte file buffer with one logical cursor shared by input and output.
/// Switching to output reconciles unread lookahead. Switching to input drains pending writes.
class filebuf {
  mut unique_ptr<FILE> file = nullptr;
  mut byte_buffer storage{};
  mut size_t first = 0;
  mut size_t last = 0;
  mut ios::openmode mode = 0;
  mut bool writing = false;

  void forget_window() mut {
    this.first = 0;
    this.last = 0;
  }

  expected<void, io_errc> drain_writes() mut {
    while (this.first < this.last) {
      auto all = this.storage.as_span();
      auto pending = all.subspan(this.first, this.last - this.first);
      size_t count = ?this.file->write_some(pending);
      if (count == 0 || count > this.last - this.first) { return unexpected(io_errc::write_failed); }
      this.first += count;
    }
    this.forget_window();
    return;
  }

  expected<void, io_errc> rewind_unread() mut {
    size_t unread = this.last - this.first;
    if (unread > 0) { ?this.file->seek(-int64_t(unread), seek_origin::current); }
    this.forget_window();
    return;
  }

  expected<void, io_errc> prepare_read() mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    if ((this.mode & ios::in) == 0) { return unexpected(io_errc::read_failed); }
    if (this.writing) {
      ?this.drain_writes();
      this.writing = false;
    }
    return;
  }

  expected<void, io_errc> prepare_write() mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    if ((this.mode & (ios::out | ios::app)) == 0) { return unexpected(io_errc::write_failed); }
    if (!this.writing) {
      ?this.rewind_unread();
      this.writing = true;
    }
    if (this.last == this.storage.size()) { ?this.drain_writes(); }
    return;
  }

public:
  filebuf() {}
  filebuf(filebuf& source) = delete;

  ~filebuf() {
    if (this.is_open()) { [[discard]] this.close(); }
  }

  bool is_open() { return this.file != nullptr; }

  expected<void, io_errc> open(string_view path, ios::openmode flags) mut {
    if (this.is_open()) { return unexpected(io_errc::open_failed); }
    file_mode access = ?std::detail::file_access_mode(flags);
    mut auto handle = ?std::fopen(path, access);
    if ((flags & ios::ate) != 0) { ?handle->seek(int64_t(0), seek_origin::end); }
    this.storage.resize(size_t(4096));
    this.file = std::move(handle);
    this.mode = flags;
    this.writing = false;
    this.forget_window();
    return;
  }

  expected<void, io_errc> open(filesystem::path& path, ios::openmode flags) mut {
    return this.open(path.view(), flags);
  }

  expected<void, io_errc> close() mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    // Close even after a flush error. The first failure is the one the caller sees.
    auto flushed = this.flush();
    auto closed = this.file->close();
    this.file.reset();
    this.forget_window();
    this.mode = 0;
    this.writing = false;
    if (!flushed) { return unexpected(flushed.error()); }
    return closed;
  }

  size_t available() {
    if (this.writing) { return size_t(0); }
    return this.last - this.first;
  }

  expected<size_t, io_errc> fill_buffer() mut {
    ?this.prepare_read();
    if (this.first < this.last) { return this.last - this.first; }
    mut auto bytes = this.storage.as_mutable_span();
    size_t n = ?this.file->read_some(bytes);
    // Preserve the previous byte after an unsuccessful EOF probe for putback/unget.
    if (n != 0) {
      this.first = 0;
      this.last = n;
    }
    return n;
  }

  span<uint8_t> buffered() {
    auto bytes = this.storage.as_span();
    return bytes.subspan(this.first, this.available());
  }

  void consume(size_t count) mut {
    if (count > this.available()) { std::panic("cannot consume past the file buffer"); }
    this.first += count;
  }

  expected<size_t, io_errc> read_some(mut mutable_span<uint8_t>& output) mut {
    if (output.empty()) { return size_t(0); }
    if (this.available() == 0 && output.size() >= this.storage.size()) {
      ?this.prepare_read();
      size_t n = ?this.file->read_some(output);
      if (n != 0) {
        // Retain the last byte for unget, including on a non-seekable file.
        this.storage[0] = output[n - 1];
        this.first = 1;
        this.last = 1;
      }
      return n;
    }
    mut size_t count = ?this.fill_buffer();
    if (count > output.size()) { count = output.size(); }
    for (mut size_t i = 0; i < count; i++) { output[i] = this.storage[this.first + i]; }
    this.first += count;
    return count;
  }

  expected<int32_t, io_errc> peek_byte() mut {
    size_t count = ?this.fill_buffer();
    if (count == 0) { return unexpected(io_errc::end_of_file); }
    return int32_t(this.storage[this.first]);
  }

  expected<int32_t, io_errc> take_byte() mut {
    int32_t byte = ?this.peek_byte();
    this.first++;
    return byte;
  }

  expected<void, io_errc> unget_byte() mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    if ((this.mode & ios::in) == 0) { return unexpected(io_errc::read_failed); }
    if (!this.writing && this.first > 0) {
      this.first--;
      return;
    }
    return this.seek(int64_t(-1), seek_origin::current);
  }

  expected<void, io_errc> putback_byte(char byte) mut {
    ?this.unget_byte();
    size_t count = ?this.fill_buffer();
    if (count == 0) { return unexpected(io_errc::end_of_file); }
    this.storage[this.first] = uint8_t(byte);
    return;
  }

  expected<size_t, io_errc> write_some(span<uint8_t>& input) mut {
    if (input.empty()) { return size_t(0); }
    ?this.prepare_write();
    if (input.size() >= this.storage.size()) {
      ?this.drain_writes();
      return this.file->write_some(input);
    }
    mut size_t count = this.storage.size() - this.last;
    if (count > input.size()) { count = input.size(); }
    for (mut size_t i = 0; i < count; i++) { this.storage[this.last + i] = input[i]; }
    this.last += count;
    return count;
  }

  expected<void, io_errc> flush() mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    if (this.writing) { ?this.drain_writes(); }
    return this.file->flush();
  }

  expected<void, io_errc> sync() mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    if (this.writing) { return this.flush(); }
    return this.rewind_unread();
  }

  expected<int64_t, io_errc> tell() mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    // In append mode only the host knows where an actual write landed.
    if (this.writing) { ?this.drain_writes(); }
    int64_t position = ?this.file->tell();
    return position - int64_t(this.available());
  }

  expected<void, io_errc> seek(int64_t offset, seek_origin origin) mut {
    if (!this.is_open()) { return unexpected(io_errc::invalid_stream); }
    if (this.writing) { ?this.drain_writes(); }
    mut int64_t relative = offset;
    if (origin == seek_origin::current) {
      int64_t unread = int64_t(this.available());
      if (relative < (int64_t(-9223372036854775807) - int64_t(1)) + unread) {
        return unexpected(io_errc::seek_failed);
      }
      relative -= unread;
    }
    ?this.file->seek(relative, origin);
    this.forget_window();
    this.writing = false;
    return;
  }

  // Familiar stream-buffer access uses counted, bounds-checked GTI byte spans.
  size_t in_avail() { return this.available(); }
  expected<int32_t, io_errc> sgetc() mut { return this.peek_byte(); }
  expected<int32_t, io_errc> sbumpc() mut { return this.take_byte(); }
  expected<int32_t, io_errc> snextc() mut {
    ?this.take_byte();
    return this.peek_byte();
  }
  expected<int32_t, io_errc> sputbackc(char value) mut {
    ?this.putback_byte(value);
    return this.peek_byte();
  }
  expected<int32_t, io_errc> sungetc() mut {
    ?this.unget_byte();
    return this.peek_byte();
  }
  expected<int32_t, io_errc> sputc(char value) mut {
    ?this.prepare_write();
    this.storage[this.last] = uint8_t(value);
    this.last++;
    return int32_t(uint8_t(value));
  }
  expected<size_t, io::error> sgetn(mut mutable_span<uint8_t>& destination) mut {
    mut size_t done = 0;
    while (done < destination.size()) {
      mut auto remaining = destination.subspan(done, destination.size() - done);
      auto read = this.read_some(remaining);
      if (!read) { return unexpected(io::error(read.error(), done)); }
      if (read.value() == 0) { break; }
      done += read.value();
    }
    return done;
  }
  expected<size_t, io::error> sputn(span<uint8_t>& source) mut {
    return io::write_all(this, source);
  }
  expected<void, io_errc> pubsync() mut { return this.sync(); }
  expected<int64_t, io_errc> pubseekoff(int64_t offset, seek_origin origin) mut {
    ?this.seek(offset, origin);
    return this.tell();
  }
  expected<int64_t, io_errc> pubseekpos(int64_t position) mut {
    return this.pubseekoff(position, seek_origin::begin);
  }

  // All owners and window offsets move together; no view of our own storage is retained.
  void swap(mut filebuf& other) mut {
    this.file.swap(other.file);
    this.storage.swap(other.storage);
    std::swap(this.first, other.first);
    std::swap(this.last, other.last);
    std::swap(this.mode, other.mode);
    std::swap(this.writing, other.writing);
  }
};

}

namespace std::detail {
/// Both file-stream construction forms use try_open and preserve its exact failure.
expected<S, io_errc> create_file_stream<S>(string_view path, ios::openmode mode)
    requires std::default_initializable<S> && requires(mut S& s, string_view p, ios::openmode m) {
      { s.try_open(p, m) } -> expected<void, io_errc>;
    } {
  mut S stream = S();
  auto opened = stream.try_open(path, mode);
  if (!opened) { return unexpected(opened.error()); }
  return std::move(stream);
}
}

export namespace std {
class ifstream : public basic_istream<filebuf> {
public:
  ifstream() : basic_istream<filebuf>(filebuf()) {}
  ifstream(string_view path, ios::openmode mode = ios::in)
      : basic_istream<filebuf>(filebuf()) {
    [[discard]] this.try_open(path, mode);
  }
  ifstream(filesystem::path& path, ios::openmode mode = ios::in)
      : basic_istream<filebuf>(filebuf()) {
    [[discard]] this.try_open(path.view(), mode);
  }

  static expected<ifstream, io_errc> open(string_view path, ios::openmode mode = ios::in) {
    return detail::create_file_stream<ifstream>(path, mode);
  }
  static expected<ifstream, io_errc> open(filesystem::path& path, ios::openmode mode = ios::in) {
    return ifstream::open(path.view(), mode);
  }

  expected<void, io_errc> try_open(string_view path, ios::openmode mode = ios::in) mut {
    auto opened = this.buffer.open(path, mode | ios::in);
    if (!opened) {
      this.set_error(opened.error());
      return unexpected(opened.error());
    }
    this.clear();
    return;
  }
  expected<void, io_errc> try_open(filesystem::path& path, ios::openmode mode = ios::in) mut {
    return this.try_open(path.view(), mode);
  }

  bool is_open() { return this.buffer.is_open(); }
  [[discardable]] expected<void, io_errc> close() mut {
    auto closed = this.buffer.close();
    if (!closed) { this.set_error(closed.error()); }
    return closed;
  }
  void swap(mut ifstream& other) mut { std::swap(this, other); }
};

class ofstream : public basic_ostream<filebuf> {
public:
  ofstream() : basic_ostream<filebuf>(filebuf()) {}
  ofstream(string_view path, ios::openmode mode = ios::out)
      : basic_ostream<filebuf>(filebuf()) {
    [[discard]] this.try_open(path, mode);
  }
  ofstream(filesystem::path& path, ios::openmode mode = ios::out)
      : basic_ostream<filebuf>(filebuf()) {
    [[discard]] this.try_open(path.view(), mode);
  }

  static expected<ofstream, io_errc> open(string_view path, ios::openmode mode = ios::out) {
    return detail::create_file_stream<ofstream>(path, mode);
  }
  static expected<ofstream, io_errc> open(filesystem::path& path, ios::openmode mode = ios::out) {
    return ofstream::open(path.view(), mode);
  }

  expected<void, io_errc> try_open(string_view path, ios::openmode mode = ios::out) mut {
    auto opened = this.buffer.open(path, mode | ios::out);
    if (!opened) {
      this.set_error(opened.error());
      return unexpected(opened.error());
    }
    this.clear();
    return;
  }
  expected<void, io_errc> try_open(filesystem::path& path, ios::openmode mode = ios::out) mut {
    return this.try_open(path.view(), mode);
  }

  bool is_open() { return this.buffer.is_open(); }
  [[discardable]] expected<void, io_errc> close() mut {
    auto closed = this.buffer.close();
    if (!closed) { this.set_error(closed.error()); }
    return closed;
  }
  void swap(mut ofstream& other) mut { std::swap(this, other); }
};

class fstream : public basic_iostream<filebuf> {
public:
  fstream() : basic_iostream<filebuf>(filebuf()) {}
  fstream(string_view path, ios::openmode mode = ios::in | ios::out)
      : basic_iostream<filebuf>(filebuf()) {
    [[discard]] this.try_open(path, mode);
  }
  fstream(filesystem::path& path, ios::openmode mode = ios::in | ios::out)
      : basic_iostream<filebuf>(filebuf()) {
    [[discard]] this.try_open(path.view(), mode);
  }

  static expected<fstream, io_errc> open(string_view path, ios::openmode mode = ios::in | ios::out) {
    return detail::create_file_stream<fstream>(path, mode);
  }
  static expected<fstream, io_errc> open(filesystem::path& path, ios::openmode mode = ios::in | ios::out) {
    return fstream::open(path.view(), mode);
  }

  expected<void, io_errc> try_open(string_view path, ios::openmode mode = ios::in | ios::out) mut {
    auto opened = this.buffer.open(path, mode);
    if (!opened) {
      this.set_error(opened.error());
      return unexpected(opened.error());
    }
    this.clear();
    return;
  }
  expected<void, io_errc> try_open(filesystem::path& path, ios::openmode mode = ios::in | ios::out) mut {
    return this.try_open(path.view(), mode);
  }

  bool is_open() { return this.buffer.is_open(); }
  [[discardable]] expected<void, io_errc> close() mut {
    auto closed = this.buffer.close();
    if (!closed) { this.set_error(closed.error()); }
    return closed;
  }
  void swap(mut fstream& other) mut { std::swap(this, other); }
};
}
