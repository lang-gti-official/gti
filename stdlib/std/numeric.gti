export module numeric;

// C++-familiar API scaffold for <std/numeric>.
import std.iterator;
import std.functional;
export namespace gti_internal {
T integer_wrapping_mul<T>(T left, T right);
T integer_saturating_add<T>(T left, T right);
T integer_saturating_sub<T>(T left, T right);
T integer_saturating_mul<T>(T left, T right);
bool integer_add_overflows<T>(T left, T right);
bool integer_sub_overflows<T>(T left, T right);
bool integer_mul_overflows<T>(T left, T right);
}

export namespace std {
  // Fixed-width integer limits. `MIN_INTn` is the most negative value and
  // `MAX_INTn`/`MAX_UINTn` the largest; unsigned minimums are zero.
  constexpr int8_t MIN_INT8 = int8_t(-128);
  constexpr int8_t MAX_INT8 = int8_t(127);
  constexpr int16_t MIN_INT16 = int16_t(-32768);
  constexpr int16_t MAX_INT16 = int16_t(32767);
  constexpr int32_t MIN_INT32 = int32_t(-2147483648);
  constexpr int32_t MAX_INT32 = int32_t(2147483647);
  constexpr int64_t MIN_INT64 = int64_t(-9223372036854775807) - int64_t(1);
  constexpr int64_t MAX_INT64 = int64_t(9223372036854775807);
  constexpr uint8_t MAX_UINT8 = uint8_t(255);
  constexpr uint16_t MAX_UINT16 = uint16_t(65535);
  constexpr uint32_t MAX_UINT32 = uint32_t(4294967295);
  constexpr uint64_t MAX_UINT64 = uint64_t(18446744073709551615);

  // IEEE-754 limits for `float` (binary32) and `double` (binary64). As in
  // C++, `MIN_FLOAT`/`MIN_DOUBLE` are the smallest positive normal values;
  // `LOWEST_FLOAT`/`LOWEST_DOUBLE` are the most negative finite values. The
  // literals are exact or shortest round-trip decimals; GTI has no exponent
  // notation.

  /// Largest finite `float`, (2 - 2^-23) * 2^127 (about 3.4028235e+38).
  constexpr float MAX_FLOAT = 340282346638528859811704183484516925440.0;
  /// Smallest positive normal `float`, 2^-126 (about 1.1754944e-38).
  constexpr float MIN_FLOAT = 0.000000000000000000000000000000000000011754944;
  /// Smallest positive subnormal `float`, 2^-149 (about 1e-45).
  constexpr float TRUE_MIN_FLOAT = 0.000000000000000000000000000000000000000000001;
  /// Distance from 1 to the next larger `float`, 2^-23 (about 1.1920929e-07).
  constexpr float EPSILON_FLOAT = 0.00000011920929;
  /// Largest finite `double`, (2 - 2^-52) * 2^1023 (about 1.7976931348623157e+308).
  constexpr double MAX_DOUBLE = .0d;
  /// Smallest positive normal `double`, 2^-1022 (about 2.2250738585072014e-308).
  constexpr double MIN_DOUBLE = 0.;
  /// Smallest positive subnormal `double`, 2^-1074 (about 5e-324).
  constexpr double TRUE_MIN_DOUBLE = 0.;
  /// Distance from 1 to the next larger `double`, 2^-52 (about 2.220446049250313e-16).
  constexpr double EPSILON_DOUBLE = 0.0000000000000002220446049250313d;
  /// Most negative finite `float` and `double`.
  constexpr float LOWEST_FLOAT = -MAX_FLOAT;
  constexpr double LOWEST_DOUBLE = -MAX_DOUBLE;

  enum class arithmetic_errc {
    result_out_of_range,
  };

  concept accumulates_into<Iterator, T> = std::dereferences_to<Iterator, T>;

  /// Linear interpolation over any vector space: `from` when `t` is zero and
  /// `to` when `t` is one. Evaluated as `from + (to - from) * t`, so a domain
  /// type needs only the ordinary member operators the concept names, and a
  /// built-in numeric type satisfies it for its own scalar. Unlike the C++
  /// overload this is not restricted to floating point and does not promise a
  /// monotonic or exactly-`to` endpoint: it performs exactly the three named
  /// domain operations.
  T lerp<T, Scalar>(T& from, T& to, Scalar t)
    requires std::vector_space<T, Scalar> {
    T delta = to - from;
    T scaled = delta * t;
    return from + scaled;
  }

  /// The additive inverse of a vector-space value.
  T negated<T>(T& value) requires std::negatable<T> {
    return -value;
  }

  /// Built-in floating point keeps its own arithmetic rather than the
  /// member-operator family, so it gets exact overloads of the same name.
  constexpr float lerp(float from, float to, float t) {
    return from + (to - from) * t;
  }

  constexpr double lerp(double from, double to, double t) {
    return from + (to - from) * t;
  }

