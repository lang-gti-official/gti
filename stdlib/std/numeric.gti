  constexpr expected<int8_t, arithmetic_errc> checked_add(int8_t left, int8_t right) {
    if (gti_internal::integer_add_overflows(left, right)) {
      return unexpected(arithmetic_errc::result_out_of_range);
    }
    return gti_internal::integer_wrapping_add(left, right);
  }
