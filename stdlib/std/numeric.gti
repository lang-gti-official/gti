  T accumulate<Iterator, Sentinel, std::numeric T>(mut Iterator first, Sentinel last, mut T init) requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> && std::accumulates_into<Iterator, T> {
    for (; first != last; ++first) {
      init = T(std::move(init) + *first);
    }

    return init;
  }

  T inner_product<InputIterator1, InputIterator2, T>(InputIterator1 first1, InputIterator1 last1, InputIterator2 first2, T initial);

  T gcd<std::integral T>(mut T left, mut T right) {
    if (left == T(0) && right == T(0)) {
      return T(0);
    }
    while (right != T(0)) {
      T remainder = T(left % right);
      left = right;
      right = remainder;
    }

    return left;
  }

  T lcm<std::integral T>(T left, T right) {
    return(left / std::gcd(left, right)) * right;
  }

  T midpoint<std::numeric T>(T left, T right) {
    return(left + right) / 2;
  }
}
