  T accumulate<Iterator, Sentinel, std::numeric T>(mut Iterator first, Sentinel last, mut T init)
    requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> && std::accumulates_into<Iterator, T> {
    for (; first != last; ++first) {
      init = T(std::move(init) + *first);
    }

    return init;
  }

  T accumulate<Iterator, Sentinel, std::numeric T, BinaryOperation>(mut Iterator first, Sentinel last, mut T init, mut BinaryOperation operation)
    requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> && std::accumulates_into<Iterator, T> && std::binary_operation<BinaryOperation, T, T, T> {
    for (; first != last; ++first) {
      init = operation(init, *first);
    }

    return init;
  }

  T inner_product<InputIterator1, InputIterator2, std::numeric T>(mut InputIterator1 first1, InputIterator1 last1, mut InputIterator2 first2, mut T initial)
    requires std::input_iterator<InputIterator1> && std::sentinel_for<InputIterator1, InputIterator1> && std::input_iterator<InputIterator2> && std::accumulates_into<InputIterator1, T> && std::accumulates_into<InputIterator2, T> {
    while (first1 != last1) {
      T product = T(*first1 * *first2);
      initial = T(std::move(initial) + product);
      ++first1;
      ++first2;
    }

    return initial;
  }

  T inner_product<InputIterator1, InputIterator2, std::numeric T, BinaryOperation1, BinaryOperation2>(mut InputIterator1 first1, InputIterator1 last1, mut InputIterator2 first2, mut T initial, mut BinaryOperation1 accumulate_operation, mut BinaryOperation2 product_operation)
    requires std::input_iterator<InputIterator1> && std::sentinel_for<InputIterator1, InputIterator1> && std::input_iterator<InputIterator2> && std::accumulates_into<InputIterator1, T> && std::accumulates_into<InputIterator2, T> && std::binary_operation<BinaryOperation1, T, T, T> && std::binary_operation<BinaryOperation2, T, T, T> {
    while (first1 != last1) {
      T product = product_operation(*first1, *first2);
      initial = accumulate_operation(initial, product);
      ++first1;
      ++first2;
    }

    return initial;
  }

  T transform_reduce<Iterator, Sentinel, std::numeric T, BinaryOperation, UnaryOperation>(mut Iterator first, Sentinel last, mut T initial, mut BinaryOperation reduce, mut UnaryOperation transform)
    requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> && std::accumulates_into<Iterator, T> && std::binary_operation<BinaryOperation, T, T, T> && std::operation<UnaryOperation, T, T> {
    for (; first != last; ++first) {
      T transformed = transform(*first);
      initial = reduce(initial, transformed);
    }

    return initial;
  }

  /// Nonnegative greatest common divisor; gcd(0, 0) is zero. The result must
  /// fit T. Keep signed remainders until the end so a minimum signed input
  /// does not fail when its greatest common divisor is representable.
  constexpr T gcd<std::integral T>(mut T left, mut T right) {
    while (right != T(0)) {
      T remainder = T(left % right);
      left = right;
      right = remainder;
    }

    if (left < T(0)) { return T(T(0) - left); }
    return left;
  }

  /// Nonnegative least common multiple; either zero input gives zero.
  /// A result outside T takes the ordinary checked numeric failure path.
  constexpr T lcm<std::integral T>(T left, T right) {
    if (left == T(0) || right == T(0)) { return T(0); }
    T product = T((left / std::gcd(left, right)) * right);
    if (product < T(0)) { return T(T(0) - product); }
    return product;
  }

  /// Overflow-free halfway value. Integral ties round toward left. Floating
  /// inputs follow GTI IEEE arithmetic, including signed zero and nonfinites.
  constexpr T midpoint<std::numeric T>(T left, T right) {
    // Remainder exists exactly for the fixed-width integers, so this selects
    // the integer path at compile time for every numeric T.
    if constexpr (requires (T value) { { T(value % value) } -> T; }) {
      // Halves and remainders are exact, the remainder sum lies in [-2, 2],
      // and the sum of the halves lies in [MIN, MAX - 1], so no step can
      // leave T: wrapping arithmetic is exact here and keeps the integer
      // path free of overflow exits.
      T remainder = gti_internal::integer_wrapping_add(T(left % 2), T(right % 2));
      T result = gti_internal::integer_wrapping_add(
          gti_internal::integer_wrapping_add(T(left / 2), T(right / 2)),
          T(remainder / 2));
      T odd = T(remainder % 2);
      if (odd > 0 && left > right) { return gti_internal::integer_wrapping_add(result, T(1)); }
      if (odd < 0 && left < right) { return gti_internal::integer_wrapping_sub(result, T(1)); }
      return result;
    } else {
      // A finite sum can be halved directly, preserving subnormal accuracy.
      // If addition overflows, halving each finite input is exact. Floating
      // status flags are not observable GTI state.
      T sum = T(left + right);
      if (T(sum - sum) == 0) { return T(sum / 2); }
      return T(left / 2 + right / 2);
    }
  }

