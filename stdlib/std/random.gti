export module random;

import "detail/random_engine.gti";
export namespace gti_internal {
namespace runtime {
extern "C" {
int32_t gti_rt_random_bytes(uint8_t* out, uint64_t count);
}

// The prelude pairs each extern "C" line with a safe GTI wrapper, but those
// wrappers are safe because text_view carries its own length. A wrapper over a
// raw pointer and a count could not check anything, so it would only launder
// the unsafety behind a safe-looking name. Callers use the C declaration
// directly inside the unsafe block that establishes the buffer's validity.
}
}

export namespace std {
  class random_device {
    mut uint8_t buffer[32] = {};
    mut uint64_t position = 32;
  public:
    random_device() {} // note the explicit spelling

    expected<uint32_t, int> operator()() mut {
      if (this.position >= 32) {
        unsafe {
          int status = gti_internal::runtime::gti_rt_random_bytes(&this.buffer[0], uint64_t(32));
          if (status != 0) {
            return unexpected(status);
          }
        }
        this.position = 0;
      }
      mut uint32_t value = 0;
      for (mut uint64_t i = 0; i<4; i++) {
        value = (value << uint32_t(8)) | uint32_t(this.buffer[this.position]);
        this.position = this.position + 1;
      }
      return value;
    }
  };

  class random_engine {
  public:
    random_engine(uint64_t seed) : state(std::detail::seed_random_engine(seed)) {}

    ~random_engine() {}

    uint64_t operator()() mut {
      // Keep the xoshiro256++ transition visible to callers so a release
      // loop can carry all four words in registers across draws.
      uint64_t sum = gti_internal::integer_wrapping_add(this.state.s0, this.state.s3);
      uint64_t result = gti_internal::integer_wrapping_add(this.rol64(sum, uint64_t(23)), this.state.s0);
      uint64_t t = this.state.s1 << uint64_t(17);
      this.state.s2 = this.state.s2 ^ this.state.s0;
      this.state.s3 = this.state.s3 ^ this.state.s1;
      this.state.s1 = this.state.s1 ^ this.state.s2;
      this.state.s0 = this.state.s0 ^ this.state.s3;
      this.state.s2 = this.state.s2 ^ t;
      this.state.s3 = this.rol64(this.state.s3, uint64_t(45));
      return result;
    }

  private:
    uint64_t rol64(uint64_t x, uint64_t k) {
      return (x << (k & uint64_t(63))) | (x >> ((uint64_t(64) - k) & uint64_t(63)));
    }

    mut std::detail::random_engine_state state;
  };
}
