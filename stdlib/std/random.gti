#include <std/numeric>

namespace gti_internal {
namespace runtime {
extern "C" {
int32_t gti_rt_random_bytes(uint8_t* out, uint64_t count);
}

// The prelude pairs each extern "C" line with a safe GTI wrapper, but those
// wrappers are safe because text_view carries its own length. A wrapper over a
// raw pointer and a count could not check anything, so it would only launder
// the unsafety behind a safe-looking name. Callers use the C declaration
// directly inside the unsafe block that establishes the buffer's validity.
}
}

namespace std {
  class random_device {
    mut uint8_t buffer[32] = {};
    mut uint64_t position = 32;
  public:
    random_device() {} // note the explicit spelling

    expected<uint32_t, int> operator()() mut {
      if (this.position >= 32) {
        unsafe {
          int status = gti_internal::runtime::gti_rt_random_bytes(&this.buffer[0], uint64_t(32));
          if (status != 0) {
            return unexpected(status);
          }
        }
        this.position = 0;
      }
      mut uint32_t value = 0;
      for (mut uint64_t i = 0; i<4; i++) {
        value = (value << uint32_t(8)) | uint32_t(this.buffer[this.position]);
        this.position = this.position + 1;
      }
      return value;
    }
  };

  class random_engine {
  public:
    // splitmix64 expands the seed across all four state words. Running it once
    random_engine(uint64_t seed) {
      mut uint64_t z = seed;
      for (mut uint64_t i = uint64_t(0); i<uint64_t(4); i++) {
        z = std::wrapping_add(z, uint64_t(0x9e3779b97f4a7c15));
        mut uint64_t x = z;
        x = std::wrapping_mul(x ^ (x>> uint64_t(30)), uint64_t(0xbf58476d1ce4e5b9));
        x = std::wrapping_mul(x ^ (x >> uint64_t(27)), uint64_t(0x94d049bb133111eb));
        this.state[i] = x ^ (x >> uint64_t(31));
      }
    }

    ~random_engine() {}

    // xoshiro256++. `mut` because the call advances the state, and the state is
    uint64_t operator()() mut {
      uint64_t result = std::wrapping_add(this.rol64(std::wrapping_add(this.state[0], this.state[3]), uint64_t(23)), this.state[0]);
      uint64_t t = this.state[1] << uint64_t(17);

      this.state[2] = this.state[2] ^ this.state[0];
      this.state[3] = this.state[3] ^ this.state[1];
      this.state[1] = this.state[1] ^ this.state[2];
      this.state[0] = this.state[0] ^ this.state[3];
      this.state[2] = this.state[2] ^ t;
      this.state[3] = this.rol64(this.state[3], uint64_t(45));

      return result;
    }

  private:
    // Masked so a count of 0 or 64 cannot raise shift_count_out_of_range.
    uint64_t rol64(uint64_t x, uint64_t k) {
      return (x << (k & uint64_t(63))) | (x >> ((uint64_t(64) - k) & uint64_t(63)));
    }

    mut uint64_t state[4] = {};
  };
}
