export module syntax;

// Immutable, request-local syntax capabilities for verified-MIR procedural
// execution. No syntax value can be stored or called at runtime.
namespace std {
namespace syntax {
export @compiler_type("syntax_tokens") struct tokens {};
export @compiler_type("syntax_expr") struct expr {};
export @compiler_type("syntax_span") struct span {};
export @compiler_type("syntax_binding") struct binding {};

export uint64_t size(tokens input);
export std::string_view text(tokens input);
export uint32_t kind(tokens input, uint64_t index);
export bool adjacent(tokens input, uint64_t left);
export tokens slice(tokens input, uint64_t begin, uint64_t end);
export tokens group(tokens input, uint64_t opening);
export span location(tokens input, uint64_t begin, uint64_t end);
export tokens literal(std::string_view spelling, span origin);
export tokens punctuation(std::string_view spelling, span origin);
export tokens identifier(std::string_view spelling, span origin);
export binding fresh(std::string_view spelling, span origin);
export tokens reference(binding name);
export tokens join(tokens left, tokens right);
export expr parse(tokens input);
export tokens splice(expr input);
export expr fail(span primary, std::string_view message);
export expr fail_related(span primary, std::string_view message, span related);
}
}
