export module http;

import std.string;
import std.vector;
import std.io;
import std.tcp;
import std.span;
import std.cstdio;
import std.optional;
import std.chrono;
import "detail/panic.gti";
import std.format;

namespace std {
  namespace http {
    /// Recoverable absolute-URL parsing and construction outcomes. Declared
    /// ahead of the shared parser, which reports them at compile time too.
    export enum class url_errc {
      invalid_scheme,
      missing_host,
      invalid_host,
      invalid_port,
      invalid_percent_encoding,
      credentials_not_allowed,
      fragment_not_allowed,
    };
  }
}
namespace gti_internal {
  namespace runtime {
    export extern "C" {
      uint32_t gti_rt_http_client_create_v1(int64_t* output_client);
      void gti_rt_http_client_destroy_v1(int64_t client);
      uint32_t gti_rt_http_client_send_v1(int64_t client, uint32_t method, gti_internal::text_view url, gti_internal::text_view encoded_headers, uint64_t header_count, gti_internal::text_view body, uint64_t connect_timeout_ms, uint64_t request_timeout_ms, uint64_t max_response_bytes, gti_internal::text_view ca_bundle_path, int64_t* output_response, int32_t* output_native_code);
      uint32_t gti_rt_http_client_stream_v1(int64_t client, uint32_t method, gti_internal::text_view url, gti_internal::text_view encoded_headers, uint64_t header_count, gti_internal::text_view body, uint64_t connect_timeout_ms, uint64_t request_timeout_ms, uint64_t max_response_bytes, gti_internal::text_view ca_bundle_path, int64_t* output_stream, int32_t* output_native_code);
      void gti_rt_http_stream_destroy_v1(int64_t stream);
      int64_t gti_rt_http_stream_metadata_v1(int64_t stream);
      uint32_t gti_rt_http_stream_read_v1(int64_t stream, uint8_t* output, uint64_t capacity, uint64_t* count);
      void gti_rt_http_stream_cancel_v1(int64_t stream);
      uint64_t gti_rt_http_stream_bytes_read_v1(int64_t stream);
      uint32_t gti_rt_http_stream_error_v1(int64_t stream);
      int32_t gti_rt_http_stream_native_code_v1(int64_t stream);
      uint64_t gti_rt_http_client_error_size_v1(int64_t client);
      int64_t gti_rt_http_client_error_read_v1(int64_t client, uint64_t offset, uint8_t* output, uint64_t capacity);
      void gti_rt_http_response_destroy_v1(int64_t response);
      uint32_t gti_rt_http_response_status_v1(int64_t response);
      uint64_t gti_rt_http_response_header_count_v1(int64_t response);
      uint64_t gti_rt_http_response_header_name_size_v1(int64_t response, uint64_t index);
      int64_t gti_rt_http_response_header_name_read_v1(int64_t response, uint64_t index, uint64_t offset, uint8_t* output, uint64_t capacity);
      uint64_t gti_rt_http_response_header_value_size_v1(int64_t response, uint64_t index);
      int64_t gti_rt_http_response_header_value_read_v1(int64_t response, uint64_t index, uint64_t offset, uint8_t* output, uint64_t capacity);
      uint64_t gti_rt_http_response_body_size_v1(int64_t response);
      int64_t gti_rt_http_response_body_read_v1(int64_t response, uint64_t offset, uint8_t* output, uint64_t capacity);
    }
  }

  export [[no_transfer, no_share]] class http_client_handle {
    mut int64_t value = 0;

  public:
    http_client_handle(int64_t handle) : value(handle) {}
    http_client_handle(http_client_handle& other) = delete;
    http_client_handle(http_client_handle&& other) = default;

    bool is_valid() {
      return this.value > 0;
    }

    int64_t get() {
      return this.value;
    }

    int64_t release() mut {
      int64_t result = this.value;
      this.value = 0;
      return result;
    }
  };

  export [[no_transfer, no_share]] class http_response_handle {
    mut int64_t value = 0;

  public:
    http_response_handle(int64_t handle) : value(handle) {}
    http_response_handle(http_response_handle& other) = delete;
    http_response_handle(http_response_handle&& other) = default;

    int64_t get() {
      return this.value;
    }

    bool is_valid() {
      return this.value > 0;
    }

    int64_t release() mut {
      int64_t result = this.value;
      this.value = 0;
      return result;
    }
  };

  export [[no_transfer, no_share]] class http_stream_handle {
    mut int64_t value = 0;

  public:
    http_stream_handle(int64_t handle) : value(handle) {}
    http_stream_handle(http_stream_handle& other) = delete;
    http_stream_handle(http_stream_handle&& other) = default;

    int64_t get() {
      return this.value;
    }

    bool is_valid() {
      return this.value > 0;
    }

    int64_t release() mut {
      int64_t result = this.value;
      this.value = 0;
      return result;
    }
  };

  namespace http_detail {
    constexpr uint8_t normalized_header_character(char value) {
      uint8_t code = uint8_t(value);
      if (code >= uint8_t(65) && code <= uint8_t(90)) {
        return uint8_t(code + uint8_t(32));
      }
      return code;
    }

    bool equal_header_name(std::string_view left, std::string_view right) {
      if (left.size() != right.size()) {
        return false;
      }
      for (mut std::size_t index = std::size_t(0); index < left.size(); index++) {
        if (normalized_header_character(left[index]) != normalized_header_character(right[index])) {
          return false;
        }
      }
      return true;
    }

    bool valid_header_name_character(char value) {
      uint8_t code = uint8_t(value);
      if ((code >= uint8_t(65) && code <= uint8_t(90)) || (code >= uint8_t(97) && code <= uint8_t(122)) || (code >= uint8_t(48) && code <= uint8_t(57))) {
        return true;
      }
      switch (value) {
      case '!':
      case '#':
      case '$':
      case '%':
      case '&':
      case '\'':
      case '*':
      case '+':
      case '-':
      case '.':
      case '^':
      case '_':
      case '`':
      case '|':
      case '~':
        return true;
      default:
        return false;
      }
    }

    // A request header: an RFC 9110 token name and a value with no CR, LF or
    // NUL, which would let the value inject another header line.
    bool valid_header(std::string_view name, std::string_view value) {
      if (name.empty()) {
        return false;
      }
      for (mut std::size_t index = std::size_t(0); index < name.size(); index++) {
        if (!valid_header_name_character(name[index])) {
          return false;
        }
      }
      for (mut std::size_t index = std::size_t(0); index < value.size(); index++) {
        if (value[index] == '\0' || value[index] == '\r' || value[index] == '\n') {
          return false;
        }
      }
      return true;
    }

    constexpr int32_t hex_digit_value(char value) {
      uint8_t code = uint8_t(value);
      if (code >= uint8_t('0') && code <= uint8_t('9')) {
        return int32_t(code - uint8_t('0'));
      }
      if (code >= uint8_t('A') && code <= uint8_t('F')) {
        return int32_t(code - uint8_t('A') + uint8_t(10));
      }
      if (code >= uint8_t('a') && code <= uint8_t('f')) {
        return int32_t(code - uint8_t('a') + uint8_t(10));
      }
      return int32_t(-1);
    }

    constexpr char upper_hex_digit(uint8_t value) {
      std::string_view digits = "0123456789ABCDEF";
      return digits[std::size_t(value)];
    }

    // RFC 3986 unreserved characters: ASCII letters and digits, '-', '.', '_', '~'.
    constexpr bool url_unreserved(char value) {
      uint8_t code = uint8_t(value);
      return (code >= uint8_t('A') && code <= uint8_t('Z')) || (code >= uint8_t('a') && code <= uint8_t('z')) ||
             (code >= uint8_t('0') && code <= uint8_t('9')) || value == '-' || value == '.' || value == '_' ||
             value == '~';
    }

    constexpr bool equal_ascii_insensitive(std::string_view source, std::size_t begin, std::string_view pattern) {
      if (source.size() - begin < pattern.size()) {
        return false;
      }
      for (mut std::size_t index = std::size_t(0); index < pattern.size(); index++) {
        if (normalized_header_character(source[begin + index]) != normalized_header_character(pattern[index])) {
          return false;
        }
      }
      return true;
    }

    constexpr bool valid_encoded_text(std::string_view source, std::size_t begin, std::size_t end) {
      mut std::size_t index = begin;
      while (index < end) {
        uint8_t code = uint8_t(source[index]);
        if (code <= uint8_t(32) || code >= uint8_t(127)) {
          return false;
        }
        if (source[index] == '%') {
          if (index + std::size_t(2) >= end || hex_digit_value(source[index + std::size_t(1)]) < int32_t(0) || hex_digit_value(source[index + std::size_t(2)]) < int32_t(0)) {
            return false;
          }
          index = index + std::size_t(3);
        } else {
          index++;
        }
      }
      return true;
    }

    constexpr bool valid_reg_name(std::string_view source, std::size_t begin, std::size_t end) {
      if (begin == end) {
        return false;
      }
      mut std::size_t index = begin;
      while (index < end) {
        if (url_unreserved(source[index])) {
          index++;
          continue;
        }
        switch (source[index]) {
        case '!':
        case '$':
        case '&':
        case '\'':
        case '(':
        case ')':
        case '*':
        case '+':
        case ',':
        case ';':
        case '=':
          index++;
          continue;
        case '%':
          if (index + std::size_t(2) >= end || hex_digit_value(source[index + std::size_t(1)]) < int32_t(0) || hex_digit_value(source[index + std::size_t(2)]) < int32_t(0)) {
            return false;
          }
          index = index + std::size_t(3);
          continue;
        default:
          return false;
        }
      }
      return true;
    }

    constexpr bool valid_bracketed_host(std::string_view source, std::size_t begin, std::size_t end) {
      if (end - begin < std::size_t(4) || source[begin] != '[' || source[end - std::size_t(1)] != ']') {
        return false;
      }
      mut bool saw_colon = false;
      for (mut std::size_t index = begin + std::size_t(1); index + std::size_t(1) < end; index++) {
        char value = source[index];
        if (value == ':') {
          saw_colon = true;
          continue;
        }
        if (value == '.') {
          continue;
        }
        if (hex_digit_value(value) < int32_t(0)) {
          return false;
        }
      }
      return saw_colon;
    }

    void append_percent_encoded(std::string_view source, mut std::string& output) {
      for (mut std::size_t index = std::size_t(0); index < source.size(); index++) {
        uint8_t code = uint8_t(source[index]);
        if (url_unreserved(source[index])) {
          output.push_back(source[index]);
        } else {
          output.push_back('%');
          output.push_back(upper_hex_digit(uint8_t(code / uint8_t(16))));
          output.push_back(upper_hex_digit(uint8_t(code % uint8_t(16))));
        }
      }
    }

    bool query_key_matches(std::string& query, std::size_t begin, std::size_t end, std::string_view raw_name) {
      mut std::size_t key_end = begin;
      while (key_end < end && query[key_end] != '=') {
        key_end++;
      }

      mut std::size_t encoded_index = begin;
      mut std::size_t raw_index = std::size_t(0);
      while (encoded_index < key_end && raw_index < raw_name.size()) {
        mut uint8_t decoded = uint8_t(query[encoded_index]);
        if (query[encoded_index] == '%') {
          if (encoded_index + std::size_t(2) >= key_end) {
            return false;
          }
          int32_t high = hex_digit_value(query[encoded_index + std::size_t(1)]);
          int32_t low = hex_digit_value(query[encoded_index + std::size_t(2)]);
          if (high < int32_t(0) || low < int32_t(0)) {
            return false;
          }
          decoded = uint8_t(high * int32_t(16) + low);
          encoded_index = encoded_index + std::size_t(3);
        } else {
          encoded_index++;
        }
        if (decoded != uint8_t(raw_name[raw_index])) {
          return false;
        }
        raw_index++;
      }
      return encoded_index == key_end && raw_index == raw_name.size();
    }

    // Component offsets of one validated absolute HTTP(S) URL, measured in the
    // text it was analyzed from. The path starts at authority_end; the query
    // follows query_marker, which equals the text size when there is no query.
    struct url_parts {
      mut bool secure;
      mut std::size_t host_begin;
      mut std::size_t host_end;
      mut std::size_t authority_end;
      mut bool explicit_port;
      mut uint16_t port;
      mut std::size_t query_marker;

      constexpr url_parts() : secure(false), host_begin(0), host_end(0), authority_end(0), explicit_port(false), port(uint16_t(0)), query_marker(0) {}
      url_parts(url_parts& other) = default;
    };

    // One grammar for runtime parsing, compile-time URL literals and redirect
    // resolution. Credentials and fragments are rejected rather than parsed.
    constexpr expected<url_parts, std::http::url_errc> analyze_url(std::string_view input) {
      if (input.empty()) {
        return unexpected(std::http::url_errc::invalid_scheme);
      }
      for (mut std::size_t index = std::size_t(0); index < input.size(); index++) {
        if (input[index] == '#') {
          return unexpected(std::http::url_errc::fragment_not_allowed);
        }
      }

      mut url_parts parts{};
      mut std::size_t scheme_size = std::size_t(0);
      if (input.size() >= std::size_t(7) && equal_ascii_insensitive(input, std::size_t(0), "http://")) {
        scheme_size = std::size_t(4);
      } else if (input.size() >= std::size_t(8) && equal_ascii_insensitive(input, std::size_t(0), "https://")) {
        scheme_size = std::size_t(5);
        parts.secure = true;
      } else {
        return unexpected(std::http::url_errc::invalid_scheme);
      }

      std::size_t authority_begin = scheme_size + std::size_t(3);
      mut std::size_t authority_end = authority_begin;
      while (authority_end < input.size() && input[authority_end] != '/' && input[authority_end] != '?') {
        authority_end++;
      }
      if (authority_begin == authority_end) {
        return unexpected(std::http::url_errc::missing_host);
      }
      for (mut std::size_t index = authority_begin; index < authority_end; index++) {
        if (input[index] == '@') {
          return unexpected(std::http::url_errc::credentials_not_allowed);
        }
      }

      mut std::size_t host_end = authority_end;
      mut std::size_t port_begin = authority_end;
      if (input[authority_begin] == '[') {
        mut std::size_t close = authority_begin + std::size_t(1);
        while (close < authority_end && input[close] != ']') {
          close++;
        }
        if (close == authority_end || !valid_bracketed_host(input, authority_begin, close + std::size_t(1))) {
          return unexpected(std::http::url_errc::invalid_host);
        }
        host_end = close + std::size_t(1);
        if (host_end < authority_end) {
          if (input[host_end] != ':') {
            return unexpected(std::http::url_errc::invalid_host);
          }
          parts.explicit_port = true;
          port_begin = host_end + std::size_t(1);
        }
      } else {
        mut std::size_t separator = authority_end;
        for (mut std::size_t index = authority_begin; index < authority_end; index++) {
          if (input[index] == ':') {
            if (separator != authority_end) {
              return unexpected(std::http::url_errc::invalid_host);
            }
            separator = index;
          }
        }
        if (separator != authority_end) {
          host_end = separator;
          port_begin = separator + std::size_t(1);
          parts.explicit_port = true;
        }
        if (host_end == authority_begin) {
          return unexpected(std::http::url_errc::missing_host);
        }
        if (!valid_reg_name(input, authority_begin, host_end)) {
          return unexpected(std::http::url_errc::invalid_host);
        }
      }

      if (parts.explicit_port) {
        if (port_begin == authority_end) {
          return unexpected(std::http::url_errc::invalid_port);
        }
        mut uint32_t value = uint32_t(0);
        for (mut std::size_t index = port_begin; index < authority_end; index++) {
          uint8_t code = uint8_t(input[index]);
          if (code < uint8_t('0') || code > uint8_t('9')) {
            return unexpected(std::http::url_errc::invalid_port);
          }
          value = value * uint32_t(10) + uint32_t(code - uint8_t('0'));
          if (value > uint32_t(65535)) {
            return unexpected(std::http::url_errc::invalid_port);
          }
        }
        parts.port = uint16_t(value);
      } else {
        parts.port = parts.secure ? uint16_t(443) : uint16_t(80);
      }

      mut std::size_t query_marker = input.size();
      for (mut std::size_t index = authority_end; index < input.size(); index++) {
        if (input[index] == '?') {
          query_marker = index;
          break;
        }
      }
      if (!valid_encoded_text(input, authority_end, query_marker) ||
          (query_marker < input.size() && !valid_encoded_text(input, query_marker + std::size_t(1), input.size()))) {
        return unexpected(std::http::url_errc::invalid_percent_encoding);
      }

      parts.host_begin = authority_begin;
      parts.host_end = host_end;
      parts.authority_end = authority_end;
      parts.query_marker = query_marker;
      return parts;
    }

    // The compile-time diagnostic for a URL literal, one message per url_errc.
    constexpr std::string_view url_literal_problem(std::http::url_errc error) {
      switch (error) {
      case std::http::url_errc::invalid_scheme:
        return "URL literal must be an absolute http:// or https:// URL";
      case std::http::url_errc::missing_host:
        return "URL literal has no host";
      case std::http::url_errc::invalid_host:
        return "URL literal host is not a valid name or bracketed IPv6 address";
      case std::http::url_errc::invalid_port:
        return "URL literal port is not a decimal number from 0 to 65535";
      case std::http::url_errc::invalid_percent_encoding:
        return "URL literal has a control, space, non-ASCII byte or malformed %HH escape";
      case std::http::url_errc::credentials_not_allowed:
        return "URL literal must not contain credentials";
      case std::http::url_errc::fragment_not_allowed:
        return "URL literal must not contain a fragment";
      }
      return "URL literal is not a valid absolute HTTP(S) URL";
    }

    // A URL literal's layout, or a compile-time error at the literal.
    [[track_caller]]
    constexpr url_parts checked_url_parts(std::string_view input) {
      expected<url_parts, std::http::url_errc> analyzed = analyze_url(input);
      if (!analyzed) {
        std::detail::panic(url_literal_problem(analyzed.error()));
      }
      return analyzed.value();
    }


  }
}

namespace std {
  namespace http {
    /// HTTP methods supported by the first synchronous client surface.
    export enum class method {
      get,
      post,
      put,
      patch,
      delete_,
      head,
    };

    /// Recoverable request construction and transport outcomes.
    export enum class errc {
      invalid_url,
      invalid_header,
      unsupported_scheme,
      name_resolution_failed,
      connection_failed,
      tls_failed,
      timeout,
      request_failed,
      response_too_large,
      backend_unavailable,
      client_creation_failed,
      cancelled,
      too_many_redirects,
      redirect_rejected,
    };

    /// Redirect policy is opt-in. Secure permits cross-origin hops after stripping
    /// explicit headers; neither following policy permits an HTTPS downgrade.
    export enum class redirect_policy { none, same_origin, secure };

    /// Allowed URL schemes for the initial request and every redirect.
    export enum class scheme_policy { http_and_https, https_only };

    /// An absolute HTTP(S) URL checked at compile time. A string constant
    /// converts implicitly wherever a `url_literal` parameter is expected and
    /// is rejected during compilation when it is not a valid URL, so
    /// `url::checked("https://api.example/v1")` cannot fail at run time. The
    /// literal keeps a view of its static text and the validated layout.
    export struct url_literal {
      string_view text;
      gti_internal::http_detail::url_parts layout;

      /// @runtime_escape std::http::url::parse(text), which reports a url_errc instead
      implicit consteval url_literal(string_view value) : text(value), layout(gti_internal::http_detail::checked_url_parts(value)) {}
    };

    /// An owned absolute HTTP(S) URL. One buffer holds the serialization: the
    /// scheme in lower case, then the authority, path and query exactly as
    /// parsed, with builder inputs percent-encoded as they are appended.
    /// Component accessors are views into that buffer.
    export class url {
      mut std::string text;
      mut gti_internal::http_detail::url_parts layout;

      // Only the checked factories and explicit clone construct a URL, always
      // from a serialization whose layout the shared parser produced.
      url(std::string serialized, gti_internal::http_detail::url_parts parts) : text(std::move(serialized)), layout(parts) {}

      static url from_validated(string_view source, gti_internal::http_detail::url_parts parts) {
        mut std::string serialized = std::string(source);
        serialized.replace(size_t(0), parts.secure ? size_t(5) : size_t(4), parts.secure ? "https" : "http");
        return url(std::move(serialized), parts);
      }

    public:
      url(url& other) = delete;
      url(url&& other) = default;

      /// Parses one absolute HTTP(S) URL. Scheme spelling is normalized to lower
      /// case; the authority, encoded path, and encoded query otherwise retain
      /// their source spelling.
      static expected<url, url_errc> parse(string_view source) {
        auto parts = ?gti_internal::http_detail::analyze_url(source);
        return from_validated(source, parts);
      }

      /// Copies a URL literal that was validated at compile time; it cannot fail.
      static url checked(url_literal literal) {
        return from_validated(literal.text, literal.layout);
      }

      /// Constructs an HTTPS URL from an ASCII host or host:port authority.
      static expected<url, url_errc> https(string_view authority) {
        if (authority.empty()) {
          return unexpected(url_errc::missing_host);
        }
        for (mut size_t index = size_t(0); index < authority.size(); index++) {
          if (authority[index] == '#') {
            return unexpected(url_errc::fragment_not_allowed);
          }
          if (authority[index] == '@') {
            return unexpected(url_errc::credentials_not_allowed);
          }
          if (authority[index] == '/' || authority[index] == '?') {
            return unexpected(url_errc::invalid_host);
          }
        }
        mut std::string source = std::string("https://");
        source.append(authority);
        auto parts = ?gti_internal::http_detail::analyze_url(source.view());
        return url(std::move(source), parts);
      }

      url clone() {
        return url(this.text.clone(), this.layout);
      }

      string_view scheme() {
        return this.text.view().substr(size_t(0), this.layout.secure ? size_t(5) : size_t(4));
      }

      string_view host() {
        return this.text.view().substr(this.layout.host_begin, this.layout.host_end - this.layout.host_begin);
      }

      bool has_explicit_port() {
        return this.layout.explicit_port;
      }

      /// Returns the explicit port, or the scheme default (80/443) when omitted.
      uint16_t port() {
        return this.layout.port;
      }

      /// The encoded path, starting with `/`, or empty for a bare authority.
      string_view path() {
        return this.text.view().substr(this.layout.authority_end, this.layout.query_marker - this.layout.authority_end);
      }

      /// Whether the URL has a `?`, even one followed by no fields.
      bool has_query() {
        return this.layout.query_marker < this.text.size();
      }

      /// The encoded query after `?`, or empty when there is none.
      string_view query() {
        if (!this.has_query()) {
          return this.text.view().substr(this.text.size());
        }
        return this.text.view().substr(this.layout.query_marker + size_t(1));
      }

      /// Appends one raw segment, percent-encoding reserved characters.
      void operator/=(string_view segment) mut {
        this.push_path_segment(segment);
      }

      url operator/(string_view segment) {
        mut url result = this.clone();
        result.push_path_segment(segment);
        return std::move(result);
      }

      /// Reuses a fresh or explicitly consumed URL without cloning it.
      url operator/(string_view segment) && {
        this.push_path_segment(segment);
        return std::move(this);
      }

      void push_path_segment(string_view segment) mut {
        std::size_t marker = this.layout.query_marker;
        bool separate = marker == this.layout.authority_end || this.text[marker - size_t(1)] != '/';
        if (!this.has_query()) {
          // The common case appends in place, with no intermediate buffer.
          if (separate) {
            this.text.push_back('/');
          }
          gti_internal::http_detail::append_percent_encoded(segment, this.text);
          this.layout.query_marker = this.text.size();
          return;
        }
        // Encoding writes at most three bytes per input byte, so reserving
        // that bound builds the inserted piece in one allocation.
        mut std::string piece = std::string();
        piece.reserve(size_t(1) + segment.size() * size_t(3));
        if (separate) {
          piece.push_back('/');
        }
        gti_internal::http_detail::append_percent_encoded(segment, piece);
        this.text.insert(marker, piece.view());
        this.layout.query_marker = marker + piece.size();
      }

      void add_query_parameter(string_view name, string_view value) mut {
        if (!this.has_query()) {
          this.text.push_back('?');
        } else if (this.text.size() > this.layout.query_marker + size_t(1)) {
          this.text.push_back('&');
        }
        gti_internal::http_detail::append_percent_encoded(name, this.text);
        this.text.push_back('=');
        gti_internal::http_detail::append_percent_encoded(value, this.text);
      }

      /// Replaces the first percent-decoded matching name, removes later matches,
      /// and appends a new field when the name was absent. `+` remains a literal
      /// plus; this is URL query handling, not form decoding.
      void set_query_parameter(string_view name, string_view value) mut {
        mut std::string replacement = std::string();
        mut bool replaced = false;
        mut size_t emitted = size_t(0);
        if (this.has_query() && this.text.size() > this.layout.query_marker + size_t(1)) {
          mut size_t begin = this.layout.query_marker + size_t(1);
          while (begin <= this.text.size()) {
            mut size_t end = begin;
            while (end < this.text.size() && this.text[end] != '&') {
              end++;
            }
            bool matches = gti_internal::http_detail::query_key_matches(this.text, begin, end, name);
            if (!matches || !replaced) {
              if (emitted > size_t(0)) {
                replacement.push_back('&');
              }
              if (matches) {
                gti_internal::http_detail::append_percent_encoded(name, replacement);
                replacement.push_back('=');
                gti_internal::http_detail::append_percent_encoded(value, replacement);
                replaced = true;
              } else {
                replacement.append(this.text.view().substr(begin, end - begin));
              }
              emitted++;
            }
            if (end == this.text.size()) {
              break;
            }
            begin = end + size_t(1);
          }
        }
        if (!replaced) {
          if (emitted > size_t(0)) {
            replacement.push_back('&');
          }
          gti_internal::http_detail::append_percent_encoded(name, replacement);
          replacement.push_back('=');
          gti_internal::http_detail::append_percent_encoded(value, replacement);
        }
        this.text.resize(this.layout.query_marker);
        this.text.push_back('?');
        this.text.append(replacement.view());
      }

      /// Removes the query and its `?` delimiter.
      void clear_query() mut {
        this.text.resize(this.layout.query_marker);
      }

      string_view view() {
        return this.text.view();
      }

      std::string string() {
        return this.text.clone();
      }
    };

    /// One owned header field. Names compare case-insensitively through request
    /// and response lookup, while original spelling and duplicate response fields
    /// remain available in `response::headers()`.
    export class header {
      string field_name;
      mut string field_value;

    public:
      header(string name, string value) : field_name(std::move(name)), field_value(std::move(value)) {}

      header(string_view name, string_view value) : field_name(std::string(name)), field_value(std::string(value)) {}

      header(header& other) = delete;
      header(header&& other) = default;

      string& name() {
        return this.field_name;
      }

      string& value() {
        return this.field_value;
      }

      void replace_value(string_view value) mut {
        mut string replacement = string(value);
        this.field_value.swap(replacement);
      }
    };

    /// An owned, reusable request description. URL, headers, body, and CA path are
    /// copied into the request; no caller view escapes the constructing call.
    export class request {
      method request_method;
      mut string request_url;
      mut vector<header> request_headers;
      mut string request_body;
      mut string ca_bundle_path;
      mut uint64_t connect_timeout = uint64_t(10000);
      mut uint64_t total_timeout = uint64_t(30000);
      mut uint64_t response_limit = uint64_t(16 * 1024 * 1024);
      mut uint32_t redirects = uint32_t(5);
      mut redirect_policy redirect_mode = redirect_policy::none;
      mut scheme_policy scheme_mode = scheme_policy::http_and_https;
      // The first builder input this request refused. Sending reports it before
      // any connection is made.
      mut optional<errc> refused = optional<errc>();

      void refuse(errc reason) mut {
        if (!this.refused.has_value()) {
          this.refused = optional<errc>(reason);
        }
      }

    public:
      request(method verb, string_view url) : request_method(verb), request_url(std::string(url)), request_headers(vector<header>()), request_body(string()), ca_bundle_path(string()) {}

      request(method verb, std::http::url& target) : request_method(verb), request_url(std::string(target.view())), request_headers(vector<header>()), request_body(string()), ca_bundle_path(string()) {}

      request(request& other) = delete;
      request(request&& other) = default;

      method verb() {
        return this.request_method;
      }

      string& url() {
        return this.request_url;
      }

      vector < header >& headers() {
        return this.request_headers;
      }

      string& body() {
        return this.request_body;
      }

      string& ca_bundle() {
        return this.ca_bundle_path;
      }

      uint64_t connect_timeout_ms() {
        return this.connect_timeout;
      }

      uint64_t timeout_ms() {
        return this.total_timeout;
      }

      uint64_t max_response_bytes() {
        return this.response_limit;
      }

      scheme_policy schemes_policy() { return this.scheme_mode; }
      void set_scheme_policy(scheme_policy policy) mut { this.scheme_mode = policy; }

      uint32_t redirect_limit() { return this.redirects; }
      redirect_policy redirects_policy() { return this.redirect_mode; }
      void set_redirect_limit(uint32_t count) mut { this.redirects = count; }
      void set_redirect_policy(redirect_policy policy) mut { this.redirect_mode = policy; }

      void set_url(string_view url) mut {
        mut string replacement = string(url);
        this.request_url.swap(replacement);
      }

      void set_url(std::http::url& target) mut {
        mut string replacement = string(target.view());
        this.request_url.swap(replacement);
      }

      void set_body(string body) mut {
        mut string replacement = std::move(body);
        this.request_body.swap(replacement);
      }

      void set_body(string_view body) mut {
        mut string replacement = string(body);
        this.request_body.swap(replacement);
      }

      void set_connect_timeout_ms(uint64_t milliseconds) mut {
        this.connect_timeout = milliseconds;
      }

      void set_timeout_ms(uint64_t milliseconds) mut {
        this.total_timeout = milliseconds;
      }

      void set_max_response_bytes(uint64_t maximum) mut {
        this.response_limit = maximum;
      }

      /// The first builder input this request refused, if any. `send`,
      /// `send_stream` and the client verbs return it without contacting the
      /// server; inspecting it earlier is optional.
      optional<errc> rejection() {
        if (!this.refused.has_value()) {
          return optional<errc>();
        }
        return optional<errc>(this.refused.value());
      }

      /// Uses a PEM trust bundle for this request. A path containing NUL is
      /// refused and reported as `errc::request_failed` when sent.
      void set_ca_bundle(string_view path) mut {
        for (mut size_t index = size_t(0); index < path.size(); index++) {
          if (path[index] == '\0') {
            this.refuse(errc::request_failed);
            return;
          }
        }
        mut string replacement = string(path);
        this.ca_bundle_path.swap(replacement);
      }

      /// Appends a field, keeping any existing field of the same name. A name
      /// that is not an RFC 9110 token, or a value containing CR, LF or NUL,
      /// is not added; sending reports `errc::invalid_header`.
      void add_header(string_view name, string_view value) mut {
        if (!gti_internal::http_detail::valid_header(name, value)) {
          this.refuse(errc::invalid_header);
          return;
        }
        this.request_headers.push_back(header(name, value));
      }

      /// Replaces every case-insensitive match with one field, or appends it.
      /// Invalid input is refused exactly as by `add_header`.
      void set_header(string_view name, string_view value) mut {
        if (!gti_internal::http_detail::valid_header(name, value)) {
          this.refuse(errc::invalid_header);
          return;
        }
        mut bool replaced = false;
        mut size_t index = size_t(0);
        while (index < this.request_headers.size()) {
          if (gti_internal::http_detail::equal_header_name(this.request_headers[index].name().view(), name)) {
            if (!replaced) {
              this.request_headers[index].replace_value(value);
              replaced = true;
              index++;
            } else {
              this.request_headers.erase(index);
            }
          } else {
            index++;
          }
        }
        if (!replaced) {
          this.request_headers.push_back(header(name, value));
        }
      }
    };

    /// A completely owned buffered HTTP response. Status values including 4xx and
    /// 5xx are successful responses; only construction/transport failures use the
    /// `errc` channel. The private runtime owner stores the already-buffered bytes;
    /// no socket, transfer, or libcurl identity is exposed through this type.
    export class response {
      mut gti_internal::http_response_handle handle;

      string read_text(uint32_t kind, uint64_t index, uint64_t length) {
        mut string result = string();
        result.reserve(size_t(length));
        mut uint8_t buffer[4096] = {};
        mut uint64_t offset = uint64_t(0);
        while (offset < length) {
          mut uint64_t capacity = length - offset;
          if (capacity > uint64_t(4096)) {
            capacity = uint64_t(4096);
          }
          mut int64_t count = -1;
          unsafe {
            if (kind == uint32_t(0)) {
              count = gti_internal::runtime::gti_rt_http_response_header_name_read_v1(this.handle.get(), index, offset, &buffer[0], capacity);
            } else if (kind == uint32_t(1)) {
              count = gti_internal::runtime::gti_rt_http_response_header_value_read_v1(this.handle.get(), index, offset, &buffer[0], capacity);
            } else {
              count = gti_internal::runtime::gti_rt_http_response_body_read_v1(this.handle.get(), offset, &buffer[0], capacity);
            }
          }
          if (count <= 0 || uint64_t(count) > capacity) {
            return std::move(result);
          }
          for (mut int64_t byte = int64_t(0); byte < count; byte++) {
            result.push_back(char(buffer[size_t(byte)]));
          }
          offset = offset + uint64_t(count);
        }
        return std::move(result);
      }

    public:
      response(gti_internal::http_response_handle value) : handle(std::move(value)) {}

      response(response& other) = delete;
      response(response&& other) = default;

      ~response() {
        if (this.handle.is_valid()) {
          gti_internal::runtime::gti_rt_http_response_destroy_v1(this.handle.release());
        }
      }

      uint32_t status() {
        return gti_internal::runtime::gti_rt_http_response_status_v1(this.handle.get());
      }

      vector<header> headers() {
        uint64_t count = gti_internal::runtime::gti_rt_http_response_header_count_v1(this.handle.get());
        mut vector<header> result = vector<header>();
        result.reserve(size_t(count));
        for (mut uint64_t index = uint64_t(0); index < count; index++) {
          uint64_t name_size = gti_internal::runtime::gti_rt_http_response_header_name_size_v1(this.handle.get(), index);
          uint64_t value_size = gti_internal::runtime::gti_rt_http_response_header_value_size_v1(this.handle.get(), index);
          result.push_back(header(this.read_text(uint32_t(0), index, name_size), this.read_text(uint32_t(1), index, value_size)));
        }
        return std::move(result);
      }

      string body() {
        uint64_t length = gti_internal::runtime::gti_rt_http_response_body_size_v1(this.handle.get());
        return this.read_text(uint32_t(2), uint64_t(0), length);
      }

    };
  }
}

namespace gti_internal {
  namespace http_detail {
    bool redirect_status(uint32_t status) {
      return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;
    }

    bool prefix_at(std::string_view text, std::size_t at, std::string_view prefix) {
      if (at > text.size() || prefix.size() > text.size() - at) { return false; }
      for (mut std::size_t i = 0; i < prefix.size(); i++) {
        if (text[at + i] != prefix[i]) { return false; }
      }
      return true;
    }

    void remove_last_segment(mut std::string& output) {
      mut std::size_t end = output.size();
      while (end > 0) {
        end--;
        if (output[end] == '/') { break; }
      }
      output.resize(end);
    }

    // RFC 3986 dot segments are literal syntax, not percent-decoded names.
    std::string remove_dot_segments(std::string_view input) {
      mut std::string output{};
      mut std::size_t i = 0;
      while (i < input.size()) {
        if (prefix_at(input, i, "../")) { i += 3; }
        else if (prefix_at(input, i, "./")) { i += 2; }
        else if (prefix_at(input, i, "/./")) { i += 2; }
        else if (prefix_at(input, i, "/.") && input.size() - i == 2) { output.push_back('/'); i += 2; }
        else if (prefix_at(input, i, "/../")) { remove_last_segment(output); i += 3; }
        else if (prefix_at(input, i, "/..") && input.size() - i == 3) { remove_last_segment(output); output.push_back('/'); i += 3; }
        else if ((prefix_at(input, i, ".") && input.size() - i == 1) || (prefix_at(input, i, "..") && input.size() - i == 2)) { i = input.size(); }
        else {
          output.push_back(input[i]);
          i++;
          while (i < input.size() && input[i] != '/') { output.push_back(input[i]); i++; }
        }
      }
      return std::move(output);
    }

    expected<std::string, std::http::errc> resolve_location(std::string_view base, std::string_view location) {
      // Fragments are local identifiers and are never sent to the server.
      mut std::size_t fragment = 0;
      while (fragment < location.size() && location[fragment] != '#') { fragment++; }
      std::string_view reference = location.substr(std::size_t(0), fragment);
      auto analyzed_base = analyze_url(base);
      if (!analyzed_base) { return unexpected(std::http::errc::redirect_rejected); }
      url_parts base_parts = analyzed_base.value();
      std::string_view base_path = base.substr(base_parts.authority_end, base_parts.query_marker - base_parts.authority_end);
      mut bool absolute = false;
      for (mut std::size_t i = 0; i < reference.size(); i++) {
        if (reference[i] == ':') { absolute = true; break; }
        if (reference[i] == '/' || reference[i] == '?') { break; }
      }
      mut std::string combined{};
      if (absolute) {
        combined = std::string(reference);
      } else if (reference.size() >= std::size_t(2) && reference[std::size_t(0)] == '/' && reference[std::size_t(1)] == '/') {
        combined = std::string(base_parts.secure ? "https:" : "http:");
        combined.append(reference);
      } else {
        combined = std::string(base.substr(std::size_t(0), base_parts.authority_end));
        if (reference.empty()) {
          combined.append(base.substr(base_parts.authority_end));
        } else if (reference[std::size_t(0)] == '/') {
          combined.append(reference);
        } else if (reference[std::size_t(0)] == '?') {
          combined.append(base_path);
          combined.append(reference);
        } else {
          // Merge with the base path up to and including its last '/'.
          mut std::size_t slash = base_path.size();
          while (slash > std::size_t(0) && base_path[slash - 1] != '/') { slash--; }
          combined.append(base_path.substr(std::size_t(0), slash));
          if (slash == std::size_t(0)) { combined.push_back('/'); }
          combined.append(reference);
        }
      }
      auto analyzed = analyze_url(combined.view());
      if (!analyzed) { return unexpected(std::http::errc::redirect_rejected); }
      url_parts parts = analyzed.value();
      auto normalized = remove_dot_segments(combined.view().substr(parts.authority_end, parts.query_marker - parts.authority_end));
      mut std::string result = std::string(combined.view().substr(std::size_t(0), parts.authority_end));
      result.append(normalized.view());
      result.append(combined.view().substr(parts.query_marker));
      return std::move(result);
    }

    expected<void, std::http::errc> check_scheme_policy(std::http::request& input) {
      if (input.schemes_policy() == std::http::scheme_policy::http_and_https) { return expected<void, std::http::errc>(); }
      auto parsed = std::http::url::parse(input.url().view());
      if (!parsed) { return unexpected(std::http::errc::invalid_url); }
      if (parsed.value().scheme() != "https") { return unexpected(std::http::errc::unsupported_scheme); }
      return expected<void, std::http::errc>();
    }

    std::http::request copy_request(std::http::request& input) {
      mut std::http::request result{input.verb(), input.url().view()};
      result.set_body(input.body().view());
      result.set_connect_timeout_ms(input.connect_timeout_ms());
      result.set_timeout_ms(input.timeout_ms());
      result.set_max_response_bytes(input.max_response_bytes());
      result.set_redirect_limit(input.redirect_limit());
      result.set_redirect_policy(input.redirects_policy());
      result.set_scheme_policy(input.schemes_policy());
      result.set_ca_bundle(input.ca_bundle().view());
      for (auto& field : input.headers()) { result.add_header(field.name().view(), field.value().view()); }
      return std::move(result);
    }

    expected<std::http::request, std::http::errc> redirected_request(std::http::request& input, uint32_t status, std::string_view location) {
      auto resolved = ?resolve_location(input.url().view(), location);
      auto before_result = std::http::url::parse(input.url().view());
      auto after_result = std::http::url::parse(resolved.view());
      if (!before_result || !after_result) { return unexpected(std::http::errc::redirect_rejected); }
      auto before = std::move(before_result).value();
      auto after = std::move(after_result).value();
      bool same_origin = equal_header_name(before.scheme(), after.scheme()) && equal_header_name(before.host(), after.host()) && before.port() == after.port();
      if (input.schemes_policy() == std::http::scheme_policy::https_only && after.scheme() != "https") { return unexpected(std::http::errc::redirect_rejected); }
      if (before.scheme() == "https" && after.scheme() != "https") { return unexpected(std::http::errc::redirect_rejected); }
      if (!same_origin && input.redirects_policy() == std::http::redirect_policy::same_origin) { return unexpected(std::http::errc::redirect_rejected); }
      mut auto verb = input.verb();
      mut bool discard_body = false;
      if ((status == 303 && verb != std::http::method::head) || ((status == 301 || status == 302) && verb == std::http::method::post)) {
        verb = std::http::method::get;
        discard_body = true;
      }
      mut std::http::request result{verb, resolved.view()};
      if (!discard_body) { result.set_body(input.body().view()); }
      result.set_connect_timeout_ms(input.connect_timeout_ms());
      result.set_timeout_ms(input.timeout_ms());
      result.set_max_response_bytes(input.max_response_bytes());
      result.set_redirect_limit(input.redirect_limit());
      result.set_redirect_policy(input.redirects_policy());
      result.set_scheme_policy(input.schemes_policy());
      result.set_ca_bundle(input.ca_bundle().view());
      if (same_origin) {
        for (auto& field : input.headers()) {
          bool body_header = equal_header_name(field.name().view(), "Content-Length") || equal_header_name(field.name().view(), "Content-Type") || equal_header_name(field.name().view(), "Transfer-Encoding") || equal_header_name(field.name().view(), "Content-Encoding") || equal_header_name(field.name().view(), "Expect");
          if (!discard_body || !body_header) { result.add_header(field.name().view(), field.value().view()); }
        }
      }
      return std::move(result);
    }

    uint32_t runtime_method(std::http::method value) {
      switch (value) {
      case std::http::method::get:
        return uint32_t(0);
      case std::http::method::post:
        return uint32_t(1);
      case std::http::method::put:
        return uint32_t(2);
      case std::http::method::patch:
        return uint32_t(3);
      case std::http::method::delete_:
        return uint32_t(4);
      case std::http::method::head:
        return uint32_t(5);
      default:
        return uint32_t(6);
      }
    }

    std::http::errc public_error(uint32_t value) {
      switch (value) {
      case uint32_t(1):
        return std::http::errc::invalid_url;
      case uint32_t(2):
        return std::http::errc::invalid_header;
      case uint32_t(3):
        return std::http::errc::unsupported_scheme;
      case uint32_t(4):
        return std::http::errc::name_resolution_failed;
      case uint32_t(5):
        return std::http::errc::connection_failed;
      case uint32_t(6):
        return std::http::errc::tls_failed;
      case uint32_t(7):
        return std::http::errc::timeout;
      case uint32_t(9):
        return std::http::errc::response_too_large;
      case uint32_t(10):
        return std::http::errc::backend_unavailable;
      case uint32_t(11):
        return std::http::errc::client_creation_failed;
      case uint32_t(12):
        return std::http::errc::cancelled;
      default:
        return std::http::errc::request_failed;
      }
    }

  }
}

namespace std {
  namespace http {
    /// An independently owned pull response and std::io::reader. Header copies
    /// survive the response. Reads expose transfer-decoded, content-encoded bytes.
    export class streaming_response {
      mut gti_internal::http_stream_handle handle;
      string final_url;
      int64_t metadata() { return gti_internal::runtime::gti_rt_http_stream_metadata_v1(this.handle.get()); }
      string read_text(uint32_t kind, uint64_t index, uint64_t length) {
        mut string result = string();
        result.reserve(size_t(length));
        mut uint8_t buffer[4096] = {};
        mut uint64_t offset = uint64_t(0);
        while (offset < length) {
          mut uint64_t capacity = length - offset;
          if (capacity > uint64_t(4096)) {
            capacity = uint64_t(4096);
          }
          mut int64_t count = -1;
          unsafe {
            if (kind == uint32_t(0)) {
              count = gti_internal::runtime::gti_rt_http_response_header_name_read_v1(this.metadata(), index, offset, &buffer[0], capacity);
            } else if (kind == uint32_t(1)) {
              count = gti_internal::runtime::gti_rt_http_response_header_value_read_v1(this.metadata(), index, offset, &buffer[0], capacity);
            } else {
              count = gti_internal::runtime::gti_rt_http_response_body_read_v1(this.metadata(), offset, &buffer[0], capacity);
            }
          }
          if (count <= 0 || uint64_t(count) > capacity) {
            return std::move(result);
          }
          for (mut int64_t byte = int64_t(0); byte < count; byte++) {
            result.push_back(char(buffer[size_t(byte)]));
          }
          offset = offset + uint64_t(count);
        }
        return std::move(result);
      }

    public:
      streaming_response(gti_internal::http_stream_handle value, string url) : handle(std::move(value)), final_url(std::move(url)) {}
      streaming_response(streaming_response& other) = delete;
      streaming_response(streaming_response&& other) = default;
      ~streaming_response() { gti_internal::runtime::gti_rt_http_stream_destroy_v1(this.handle.release()); }
      uint32_t status() { return gti_internal::runtime::gti_rt_http_response_status_v1(this.metadata()); }
      string effective_url() { return this.final_url.clone(); }
      vector<header> headers() {
        uint64_t count = gti_internal::runtime::gti_rt_http_response_header_count_v1(this.metadata());
        mut vector<header> result = vector<header>();
        result.reserve(size_t(count));
        for (mut uint64_t index = uint64_t(0); index < count; index++) {
          uint64_t name_size = gti_internal::runtime::gti_rt_http_response_header_name_size_v1(this.metadata(), index);
          uint64_t value_size = gti_internal::runtime::gti_rt_http_response_header_value_size_v1(this.metadata(), index);
          result.push_back(header(this.read_text(uint32_t(0), index, name_size), this.read_text(uint32_t(1), index, value_size)));
        }
        return std::move(result);
      }

      uint64_t bytes_read() { return gti_internal::runtime::gti_rt_http_stream_bytes_read_v1(this.handle.get()); }
      int32_t last_native_code() { return gti_internal::runtime::gti_rt_http_stream_native_code_v1(this.handle.get()); }
      optional<errc> last_error() {
        uint32_t status = gti_internal::runtime::gti_rt_http_stream_error_v1(this.handle.get());
        if (status == 0) { return optional<errc>(); }
        return optional<errc>(gti_internal::http_detail::public_error(status));
      }
      void cancel() mut { gti_internal::runtime::gti_rt_http_stream_cancel_v1(this.handle.get()); }
      expected<size_t, io_errc> read_some(mut mutable_span<uint8_t>& output) mut {
        if (output.empty()) { return size_t(0); }
        uint64_t capacity = uint64_t(output.size());
        mut uint64_t count = 0;
        mut uint32_t status = 0;
        unsafe {
          status = gti_internal::runtime::gti_rt_http_stream_read_v1(this.handle.get(), &output.get_unchecked_mut(size_t(0)), capacity, &count);
        }
        if (status == 7) { return unexpected(io_errc::timed_out); }
        if (status != 0) { return unexpected(io_errc::read_failed); }
        return size_t(count);
      }
    };

    /// A reusable synchronous client. One mutable borrow permits one request at a
    /// time; the native easy handle retains its connection pool between calls.
    export class client {
      mut gti_internal::http_client_handle handle;
      mut int32_t backend_code = int32_t(0);

      client(gti_internal::http_client_handle value) : handle(std::move(value)) {}

    public:
      client(client& other) = delete;
      client(client&& other) = default;

      static expected<client, errc> create() {
        mut int64_t value = int64_t(0);
        mut uint32_t status = uint32_t(0);
        unsafe {
          status = gti_internal::runtime::gti_rt_http_client_create_v1(&value);
        }
        if (status != uint32_t(0)) {
          errc code = gti_internal::http_detail::public_error(status);
          return unexpected(code);
        }
        return client(gti_internal::http_client_handle(value));
      }

      ~client() {
        if (this.handle.is_valid()) {
          gti_internal::runtime::gti_rt_http_client_destroy_v1(this.handle.release());
        }
      }

      /// Returns the libcurl status from the most recent `send`; zero means no
      /// backend error. This remains diagnostic-only—branch on `errc` instead.
      int32_t last_native_code() {
        return this.backend_code;
      }

      /// Copies the backend diagnostic from the most recent failed `send`.
      /// Branching logic must use `errc`; this text is intended for logs only.
      string last_error_message() {
        uint64_t length = gti_internal::runtime::gti_rt_http_client_error_size_v1(this.handle.get());
        mut string result = string();
        result.reserve(size_t(length));
        mut uint8_t buffer[4096] = {};
        mut uint64_t offset = uint64_t(0);
        while (offset < length) {
          mut uint64_t capacity = length - offset;
          if (capacity > uint64_t(4096)) {
            capacity = uint64_t(4096);
          }
          mut int64_t count = -1;
          unsafe {
            count = gti_internal::runtime::gti_rt_http_client_error_read_v1(this.handle.get(), offset, &buffer[0], capacity);
          }
          if (count <= 0 || uint64_t(count) > capacity) {
            return std::move(result);
          }
          for (mut int64_t byte = int64_t(0); byte < count; byte++) {
            result.push_back(char(buffer[size_t(byte)]));
          }
          offset = offset + uint64_t(count);
        }
        return std::move(result);
      }

    private:
      expected<streaming_response, errc> send_stream_once(request& input) mut {
        auto parsed = std::http::url::parse(input.url().view());
        if (!parsed) { return unexpected(errc::invalid_url); }
        mut string encoded_headers = string();
        auto& fields = input.headers();
        for (auto& field : fields) {
          encoded_headers.append(field.name().view());
          encoded_headers.push_back('\0');
          encoded_headers.append(field.value().view());
          encoded_headers.push_back('\0');
        }
        mut int64_t stream = 0;
        mut int32_t native_code = 0;
        mut uint32_t status = 0;
        unsafe {
          status = gti_internal::runtime::gti_rt_http_client_stream_v1(this.handle.get(), gti_internal::http_detail::runtime_method(input.verb()), input.url().view(), encoded_headers.view(), uint64_t(fields.size()), input.body().view(), input.connect_timeout_ms(), input.timeout_ms(), input.max_response_bytes(), input.ca_bundle().view(), &stream, &native_code);
        }
        this.backend_code = native_code;
        if (status != 0) { return unexpected(gti_internal::http_detail::public_error(status)); }
        return streaming_response(gti_internal::http_stream_handle(stream), input.url().clone());
      }

      expected<response, errc> send_once(request& input) mut {
        mut string encoded_headers = string();
        vector < header >& fields = input.headers();
        for (mut size_t index = size_t(0); index < fields.size(); index++) {
          encoded_headers.append(fields[index].name().view());
          encoded_headers.push_back('\0');
          encoded_headers.append(fields[index].value().view());
          encoded_headers.push_back('\0');
        }
        mut int64_t response_value = int64_t(0);
        mut int32_t native_code = int32_t(0);
        mut uint32_t status = uint32_t(0);
        unsafe {
          status = gti_internal::runtime::gti_rt_http_client_send_v1(this.handle.get(), gti_internal::http_detail::runtime_method(input.verb()), input.url().view(), encoded_headers.view(), uint64_t(fields.size()), input.body().view(), input.connect_timeout_ms(), input.timeout_ms(), input.max_response_bytes(), input.ca_bundle().view(), &response_value, &native_code);
        }
        this.backend_code = native_code;
        if (status != uint32_t(0)) {
          errc code = gti_internal::http_detail::public_error(status);
          return unexpected(code);
        }
        return response(gti_internal::http_response_handle(response_value));
      }

    public:
      expected<response, errc> send(request& input) mut {
        this.backend_code = 0;
        auto refused = input.rejection();
        if (refused.has_value()) { return unexpected(refused.value()); }
        ?gti_internal::http_detail::check_scheme_policy(input);
        if (input.redirects_policy() == redirect_policy::none) { return this.send_once(input); }
        auto initial_url = std::http::url::parse(input.url().view());
        if (!initial_url) { return unexpected(errc::invalid_url); }
        auto clock = std::chrono::steady_clock::now();
        if (!clock) { return unexpected(errc::request_failed); }
        auto started = std::move(clock).value();
        mut auto current = gti_internal::http_detail::copy_request(input);
        mut uint32_t hops = 0;
        while (true) {
          if (input.timeout_ms() != 0) {
            auto clock_now = std::chrono::steady_clock::now();
            if (!clock_now) { return unexpected(errc::request_failed); }
            auto now = std::move(clock_now).value();
            auto elapsed = now.elapsed_since(started);
            if (!elapsed) { return unexpected(errc::request_failed); }
            uint64_t milliseconds = uint64_t(elapsed.value().count() / int64_t(1000000));
            if (milliseconds >= input.timeout_ms()) { return unexpected(errc::timeout); }
            current.set_timeout_ms(input.timeout_ms() - milliseconds);
          }
          auto sent = this.send_once(current);
          if (!sent) { return unexpected(sent.error()); }
          auto result = std::move(sent).value();
          if (!gti_internal::http_detail::redirect_status(result.status())) { return std::move(result); }
          auto fields = result.headers();
          mut std::string location{};
          mut bool found = false;
          for (auto& field : fields) {
            if (gti_internal::http_detail::equal_header_name(field.name().view(), "Location")) {
              if (found) { this.backend_code = 0; return unexpected(errc::redirect_rejected); }
              found = true;
              location = field.value().clone();
            }
          }
          if (!found) { return std::move(result); }
          if (hops == input.redirect_limit()) { this.backend_code = 0; return unexpected(errc::too_many_redirects); }
          auto following = gti_internal::http_detail::redirected_request(current, result.status(), location.view());
          if (!following) { this.backend_code = 0; return unexpected(following.error()); }
          current = std::move(following).value();
          hops++;
        }
      }

      expected<streaming_response, errc> send_stream(request& input) mut {
        this.backend_code = 0;
        auto refused = input.rejection();
        if (refused.has_value()) { return unexpected(refused.value()); }
        ?gti_internal::http_detail::check_scheme_policy(input);
        if (input.redirects_policy() == redirect_policy::none) { return this.send_stream_once(input); }
        auto initial_url = std::http::url::parse(input.url().view());
        if (!initial_url) { return unexpected(errc::invalid_url); }
        auto clock = std::chrono::steady_clock::now();
        if (!clock) { return unexpected(errc::request_failed); }
        auto started = std::move(clock).value();
        mut auto current = gti_internal::http_detail::copy_request(input);
        mut uint32_t hops = 0;
        while (true) {
          if (input.timeout_ms() != 0) {
            auto clock_now = std::chrono::steady_clock::now();
            if (!clock_now) { return unexpected(errc::request_failed); }
            auto now = std::move(clock_now).value();
            auto elapsed = now.elapsed_since(started);
            if (!elapsed) { return unexpected(errc::request_failed); }
            uint64_t milliseconds = uint64_t(elapsed.value().count() / int64_t(1000000));
            if (milliseconds >= input.timeout_ms()) { return unexpected(errc::timeout); }
            current.set_timeout_ms(input.timeout_ms() - milliseconds);
          }
          auto sent = this.send_stream_once(current);
          if (!sent) { return unexpected(sent.error()); }
          auto result = std::move(sent).value();
          if (!gti_internal::http_detail::redirect_status(result.status())) { return std::move(result); }
          auto fields = result.headers();
          mut std::string location{};
          mut bool found = false;
          for (auto& field : fields) {
            if (gti_internal::http_detail::equal_header_name(field.name().view(), "Location")) {
              if (found) { this.backend_code = 0; return unexpected(errc::redirect_rejected); }
              found = true;
              location = field.value().clone();
            }
          }
          if (!found) { return std::move(result); }
          if (hops == input.redirect_limit()) { this.backend_code = 0; return unexpected(errc::too_many_redirects); }
          auto following = gti_internal::http_detail::redirected_request(current, result.status(), location.view());
          if (!following) { this.backend_code = 0; return unexpected(following.error()); }
          current = std::move(following).value();
          hops++;
        }
      }

      expected<response, errc> get(string_view url) mut {
        mut request input = request(method::get, url);
        return this.send(input);
      }

      expected<response, errc> get(std::http::url& target) mut {
        mut request input = request(method::get, target);
        return this.send(input);
      }

      expected<response, errc> post(string_view url, string_view body) mut {
        mut request input = request(method::post, url);
        input.set_body(body);
        return this.send(input);
      }

      expected<response, errc> post(std::http::url& target, string_view body) mut {
        mut request input = request(method::post, target);
        input.set_body(body);
        return this.send(input);
      }

      expected<response, errc> put(string_view url, string_view body) mut {
        mut request input = request(method::put, url);
        input.set_body(body);
        return this.send(input);
      }

      expected<response, errc> put(std::http::url& target, string_view body) mut {
        mut request input = request(method::put, target);
        input.set_body(body);
        return this.send(input);
      }

      expected<response, errc> patch(string_view url, string_view body) mut {
        mut request input = request(method::patch, url);
        input.set_body(body);
        return this.send(input);
      }

      expected<response, errc> patch(std::http::url& target, string_view body) mut {
        mut request input = request(method::patch, target);
        input.set_body(body);
        return this.send(input);
      }

      expected<response, errc> delete_(string_view url) mut {
        mut request input = request(method::delete_, url);
        return this.send(input);
      }

      expected<response, errc> delete_(std::http::url& target) mut {
        mut request input = request(method::delete_, target);
        return this.send(input);
      }

      expected<response, errc> head(string_view url) mut {
        mut request input = request(method::head, url);
        return this.send(input);
      }

      expected<response, errc> head(std::http::url& target) mut {
        mut request input = request(method::head, target);
        return this.send(input);
      }

    };
  }
}

// URLs format as their serialization; width, fill and alignment apply as for text.
export for concept std::formatting<std::http::url> {
  expected<void, std::format_errc> format(std::http::url& value, mut std::string& output,
                                          std::format_spec& spec) {
    std::string_view text = value.view();
    std::formatter<std::string_view> writer{};
    return writer.format(text, output, spec);
  }
};

namespace std {
namespace http {
export enum class server_errc {
  invalid_argument, wrong_state, malformed, unsupported_version, unsupported_coding,
  unsupported_expectation, line_limit, head_limit, field_limit, body_limit,
  chunk_line_limit, framing_limit, trailer_limit, truncated, transport
};
export enum class server_phase { configuration, head, body, output };
export struct server_error {
  server_errc code;
  server_phase phase;
  bool can_send_error;
private:
  io_errc cause;
public:
  server_error(server_errc code, server_phase phase, bool reply = false)
      : code(code), phase(phase), can_send_error(reply), cause(io_errc::invalid_stream) {}
  server_error(io_errc cause, server_phase phase)
      : code(server_errc::transport), phase(phase), can_send_error(false), cause(cause) {}
  optional<io_errc> transport_error() {
    if (this.code == server_errc::transport) { return optional<io_errc>(this.cause); }
    return optional<io_errc>();
  }
};
export struct server_limits {
  mut size_t request_line = 8192;
  mut size_t request_head = 32768;
  mut size_t request_fields = 100;
  mut size_t decoded_body = 1048576;
  mut size_t chunk_line = 1024;
  mut size_t trailer_bytes = 8192;
  mut size_t trailer_fields = 32;
  mut size_t chunk_framing = 65536;
  mut size_t response_head = 32768;
  mut size_t response_fields = 100;
  server_limits() {}
};
export enum class target_form { origin, absolute, authority, asterisk };
export enum class connection_policy { automatic, close };
export enum class disposition { continue_sent, reusable, close };

namespace server_detail {
// These construction tags stay private to the HTTP module.
enum class field_insertion { validated };
enum class connection_adoption { validated };
bool wire_field(string_view name, string_view value) {
  if (!gti_internal::http_detail::valid_header(name, value)) { return false; }
  for (mut size_t i = 0; i < value.size(); i++) {
    uint8_t c = uint8_t(value[i]);
    if ((c < uint8_t(32) && c != uint8_t(9)) || c == uint8_t(127)) { return false; }
  }
  return true;
}
bool reserved_field(string_view name) {
  return gti_internal::http_detail::equal_header_name(name, "Content-Length") ||
         gti_internal::http_detail::equal_header_name(name, "Transfer-Encoding") ||
         gti_internal::http_detail::equal_header_name(name, "Connection") ||
         gti_internal::http_detail::equal_header_name(name, "Trailer") ||
         gti_internal::http_detail::equal_header_name(name, "Upgrade");
}
}

/// Ordered fields. Names and values borrow the owning block until it changes.
export class field_block {
  mut vector<header> fields{};
public:
  field_block() {}
  field_block(field_block& other) = delete;
  field_block(field_block&& other) = default;
  size_t size() { return this.fields.size(); }
  string_view name_at(size_t index) { return this.fields[index].name().view(); }
  string_view value_at(size_t index) { return this.fields[index].value().view(); }
  optional<size_t> find_next(string_view name, size_t start) {
    for (mut size_t i = start; i < this.fields.size(); i++) {
      if (gti_internal::http_detail::equal_header_name(this.name_at(i), name)) {
        return optional<size_t>(i);
      }
    }
    return optional<size_t>();
  }
  void append(server_detail::field_insertion token, string_view name, string_view value) mut {
    this.fields.push_back(header(name, value));
  }
};

export class response_head {
  uint16_t status_code;
  mut field_block fields{};
  response_head(uint16_t status) : status_code(status) {}
public:
  response_head(response_head& other) = delete;
  response_head(response_head&& other) = default;
  static expected<response_head, server_error> create(uint16_t status) {
    if (status < uint16_t(200) || status > uint16_t(599)) {
      return unexpected(server_error(server_errc::invalid_argument, server_phase::output));
    }
    return response_head(status);
  }
  uint16_t status() { return this.status_code; }
  field_block& headers() { return this.fields; }
  expected<void, server_error> add_header(string_view name, string_view value) mut {
    if (server_detail::reserved_field(name) || !server_detail::wire_field(name, value)) {
      return unexpected(server_error(server_errc::invalid_argument, server_phase::output));
    }
    this.fields.append(server_detail::field_insertion::validated, name, value);
    return;
  }
};

namespace server_detail {
size_t until(string_view text, size_t from, char delimiter) {
  mut size_t i = from;
  while (i < text.size() && text[i] != delimiter) { i++; }
  return i;
}
bool token(string_view text) {
  if (text.empty()) { return false; }
  for (mut size_t i = 0; i < text.size(); i++) {
    if (!gti_internal::http_detail::valid_header_name_character(text[i])) { return false; }
  }
  return true;
}
// RFC 3986 pchar, slash and query delimiters. Percent escapes stay encoded.
bool target_suffix(string_view text, size_t from) {
  string_view punctuation = "!$&'()*+,;=:@/?";
  for (mut size_t i = from; i < text.size(); i++) {
    char c = text[i];
    if (gti_internal::http_detail::url_unreserved(c) || until(punctuation, size_t(0), c) < punctuation.size()) { continue; }
    if (c != '%' || text.size() - i < size_t(3) ||
        gti_internal::http_detail::hex_digit_value(text[i + size_t(1)]) < 0 ||
        gti_internal::http_detail::hex_digit_value(text[i + size_t(2)]) < 0) { return false; }
    i += size_t(2);
  }
  return true;
}
bool ows(char c) { return c == ' ' || c == '\t'; }
bool named(string_view a, string_view b) { return gti_internal::http_detail::equal_header_name(a, b); }

server_error peer(server_errc code) { return server_error(code, server_phase::head, true); }

expected<size_t, server_error> decimal_length(string_view text, size_t maximum) {
  if (text.empty()) { return unexpected(peer(server_errc::malformed)); }
  mut size_t value = 0;
  for (mut size_t i = 0; i < text.size(); i++) {
    int digit = gti_internal::http_detail::hex_digit_value(text[i]);
    if (digit < 0 || digit > 9) { return unexpected(peer(server_errc::malformed)); }
    if (size_t(digit) > maximum || value > (maximum - size_t(digit)) / size_t(10)) {
      return unexpected(peer(server_errc::body_limit));
    }
    value = value * size_t(10) + size_t(digit);
  }
  return value;
}
// A compact trie indexes the peer's hop-by-hop names without retaining views
// into the head. A level has at most the distinct ASCII token characters.
struct option_node {
  uint8_t character;
  mut size_t child = 0;
  mut size_t sibling = 0;
  mut bool terminal = false;
  option_node(uint8_t character) : character(character) {}
};
class connection_options {
  mut vector<option_node> nodes{};
  size_t child(size_t parent, uint8_t character) {
    mut size_t index = this.nodes[parent].child;
    while (index != 0 && this.nodes[index].character != character) { index = this.nodes[index].sibling; }
    return index;
  }
public:
  connection_options() {}
  void clear() mut { this.nodes.clear(); }
  void add(string_view name) mut {
    if (this.nodes.empty()) { this.nodes.push_back(option_node(uint8_t(0))); }
    mut size_t parent = 0;
    for (mut size_t i = 0; i < name.size(); i++) {
      uint8_t c = gti_internal::http_detail::normalized_header_character(name[i]);
      mut size_t index = this.child(parent, c);
      if (index == 0) {
        index = this.nodes.size();
        mut option_node node{c};
        node.sibling = this.nodes[parent].child;
        this.nodes.push_back(std::move(node));
        this.nodes[parent].child = index;
      }
      parent = index;
    }
    this.nodes[parent].terminal = true;
  }
  bool contains(string_view name) {
    if (this.nodes.empty()) { return false; }
    mut size_t parent = 0;
    for (mut size_t i = 0; i < name.size(); i++) {
      parent = this.child(parent, gti_internal::http_detail::normalized_header_character(name[i]));
      if (parent == 0) { return false; }
    }
    return this.nodes[parent].terminal;
  }
};
expected<bool, server_error> connection_close(string_view text, mut connection_options& options) {
  mut bool close = false;
  mut size_t first = 0;
  while (first < text.size()) {
    size_t comma = until(text, first, ',');
    mut size_t end = comma;
    while (first < end && ows(text[first])) { first++; }
    while (end > first && ows(text[end - size_t(1)])) { end--; }
    if (end > first) {
      auto option = text.substr(first, end - first);
      if (!token(option)) { return unexpected(peer(server_errc::malformed)); }
      if (named(option, "close")) { close = true; }
      options.add(option);
    }
    if (comma == text.size()) { break; }
    first = comma + size_t(1);
  }
  return close;
}
}

export class request_head {
  string verb;
  string target;
  string authority;
  http::target_form form;
  field_block fields;
  optional<size_t> length;
  bool chunk_coded;
  bool expect;
  bool closing;
public:
  request_head(string_view verb, string_view target, string_view authority, http::target_form form,
               field_block fields, optional<size_t> length, bool chunked, bool expect, bool closing)
      : verb(string(verb)), target(string(target)), authority(string(authority)), form(form),
        fields(std::move(fields)), length(std::move(length)), chunk_coded(chunked), expect(expect), closing(closing) {}
  request_head(request_head& other) = delete;
  request_head(request_head&& other) = default;
  string_view method_text() { return this.verb.view(); }
  string_view raw_target() { return this.target.view(); }
  string_view effective_authority() { return this.authority.view(); }
  http::target_form target_form() { return this.form; }
  field_block& headers() { return this.fields; }
  optional<size_t> content_length() {
    if (this.length.has_value()) { return optional<size_t>(this.length.value()); }
    return optional<size_t>();
  }
  bool expects_continue() { return this.expect; }
  bool chunked() { return this.chunk_coded; }
  bool requests_close() { return this.closing; }
};

namespace server_detail {
// URL syntax identifies the bracketed host. Validate the complete numeric
// address with the same source parser used by socket addresses.
bool valid_literal(string_view authority) {
  if (authority.empty() || authority[0] != '[') { return true; }
  size_t close = until(authority, size_t(1), ']');
  return close < authority.size() && bool(std::tcp::ipv6_address::parse_range(authority, size_t(1), close));
}
expected<request_head, server_error> decode_head(string_view wire, server_limits& limits, mut connection_options& options) {
  size_t line = until(wire, size_t(0), '\r');
  size_t space = until(wire, size_t(0), ' ');
  if (space >= line) { return unexpected(peer(server_errc::malformed)); }
  size_t second = until(wire, space + size_t(1), ' ');
  if (second >= line || second == space + size_t(1)) { return unexpected(peer(server_errc::malformed)); }
  auto method = wire.substr(size_t(0), space);
  if (!token(method)) { return unexpected(peer(server_errc::malformed)); }
  auto version = wire.substr(second + size_t(1), line - second - size_t(1));
  if (version != "HTTP/1.1") {
    if (version.size() == size_t(8) && version.substr(size_t(0), size_t(5)) == "HTTP/" &&
        uint8_t(version[5]) >= uint8_t('0') && uint8_t(version[5]) <= uint8_t('9') && version[6] == '.' && uint8_t(version[7]) >= uint8_t('0') && uint8_t(version[7]) <= uint8_t('9')) {
      return unexpected(peer(server_errc::unsupported_version));
    }
    return unexpected(peer(server_errc::malformed));
  }
  auto target = wire.substr(space + size_t(1), second - space - size_t(1));
  mut field_block fields{};
  mut string authority{};
  mut optional<size_t> length{};
  mut bool chunked = false;
  mut bool expects = false;
  mut bool close = false;
  mut size_t pos = line + size_t(2);
  while (pos < wire.size() && wire[pos] != '\r') {
    size_t end = until(wire, pos, '\r');
    auto pair = wire.substr(pos, end - pos);
    size_t colon = until(pair, size_t(0), ':');
    if (colon == pair.size()) { return unexpected(peer(server_errc::malformed)); }
    auto name = pair.substr(size_t(0), colon);
    mut size_t begin = colon + size_t(1);
    mut size_t last = pair.size();
    while (begin < last && ows(pair[begin])) { begin++; }
    while (last > begin && ows(pair[last - size_t(1)])) { last--; }
    auto value = pair.substr(begin, last - begin);
    if (fields.size() >= limits.request_fields) { return unexpected(peer(server_errc::field_limit)); }
    if (!wire_field(name, value)) { return unexpected(peer(server_errc::malformed)); }
    fields.append(field_insertion::validated, name, value);
    if (named(name, "Host")) {
      if (!authority.empty() || !url::https(value) || !valid_literal(value)) { return unexpected(peer(server_errc::malformed)); }
      authority.append(value);
    } else if (named(name, "Content-Length")) {
      if (length.has_value() || chunked) { return unexpected(peer(server_errc::malformed)); }
      auto count = ?decimal_length(value, limits.decoded_body);
      length = optional<size_t>(count);
    } else if (named(name, "Transfer-Encoding")) {
      if (chunked || length.has_value()) { return unexpected(peer(server_errc::malformed)); }
      if (!named(value, "chunked")) { return unexpected(peer(server_errc::unsupported_coding)); }
      chunked = true;
    } else if (named(name, "Expect")) {
      if (!named(value, "100-continue")) { return unexpected(peer(server_errc::unsupported_expectation)); }
      expects = true;
    } else if (named(name, "Connection")) {
      bool value_closes = ?connection_close(value, options);
      close = close || value_closes;
    }
    pos = end + size_t(2);
  }
  if (authority.empty()) { return unexpected(peer(server_errc::malformed)); }
  mut auto form = http::target_form::origin;
  if (method == "CONNECT") {
    auto endpoint = url::https(target);
    if (!endpoint || !endpoint.value().has_explicit_port() || !valid_literal(target)) { return unexpected(peer(server_errc::malformed)); }
    authority = string(target);
    form = http::target_form::authority;
  } else if (target == "*") {
    if (method != "OPTIONS") { return unexpected(peer(server_errc::malformed)); }
    form = http::target_form::asterisk;
  } else if (target[0] == '/') {
    if (!target_suffix(target, size_t(0))) { return unexpected(peer(server_errc::malformed)); }
  } else {
    auto parsed = gti_internal::http_detail::analyze_url(target);
    if (!parsed) { return unexpected(peer(server_errc::malformed)); }
    auto& parts = parsed.value();
    if (!target_suffix(target, parts.authority_end)) { return unexpected(peer(server_errc::malformed)); }
    auto selected = target.substr(parts.host_begin, parts.authority_end - parts.host_begin);
    if (!valid_literal(selected)) { return unexpected(peer(server_errc::malformed)); }
    authority = string(selected);
    form = http::target_form::absolute;
  }
  bool has_body = chunked || (length.has_value() && length.value() > size_t(0));
  return request_head(method, target, authority.view(), form, std::move(fields), std::move(length),
                      chunked, expects && has_body, close);
}
}

export struct head_progress {
  size_t consumed;
  mut optional<request_head> head;
  head_progress(size_t count) : consumed(count), head(optional<request_head>()) {}
  head_progress(size_t count, request_head message) : consumed(count), head(optional<request_head>(std::move(message))) {}
};
export enum class body_state { need_input, need_space, body_end };
export struct body_progress {
  size_t consumed;
  size_t written;
  body_state state;
  body_progress(size_t consumed, size_t written, body_state state)
      : consumed(consumed), written(written), state(state) {}
};
export enum class output_step<lifetime owner> {
  framing(span<uint8_t, owner> bytes),
  body(size_t remaining),
  flush
};

namespace server_detail {
enum class exchange_state { between, active, output, rejected, ended };
enum class body_frame { fixed, chunk_size, chunk_data, chunk_cr, chunk_lf, trailers, done };
bool extensions(string_view line, size_t from) {
  mut size_t i = from;
  while (i < line.size()) {
    while (i < line.size() && ows(line[i])) { i++; }
    if (i == line.size() || line[i] != ';') { return false; }
    i++;
    while (i < line.size() && ows(line[i])) { i++; }
    size_t name = i;
    while (i < line.size() && gti_internal::http_detail::valid_header_name_character(line[i])) { i++; }
    if (i == name) { return false; }
    size_t before_space = i;
    while (i < line.size() && ows(line[i])) { i++; }
    if (i == line.size() || line[i] != '=') { i = before_space; continue; }
    i++;
    while (i < line.size() && ows(line[i])) { i++; }
    if (i == line.size()) { return false; }
    if (line[i] == '"') {
      i++;
      mut bool closed = false;
      while (i < line.size()) {
        mut char c = line[i];
        i++;
        if (c == '"') { closed = true; break; }
        if (c == '\\') {
          if (i == line.size()) { return false; }
          c = line[i];
          i++;
        }
        if ((uint8_t(c) < uint8_t(32) && c != '\t') || uint8_t(c) == uint8_t(127)) { return false; }
      }
      if (!closed) { return false; }
    } else {
      size_t value = i;
      while (i < line.size() && gti_internal::http_detail::valid_header_name_character(line[i])) { i++; }
      if (i == value) { return false; }
    }
  }
  return true;
}
expected<size_t, server_error> chunk_size(string_view line, size_t budget) {
  mut size_t count = 0;
  mut size_t i = 0;
  while (i < line.size()) {
    int digit = gti_internal::http_detail::hex_digit_value(line[i]);
    if (digit < 0) { break; }
    if (size_t(digit) > budget || count > (budget - size_t(digit)) / size_t(16)) {
      return unexpected(server_error(server_errc::body_limit, server_phase::body, true));
    }
    count = count * size_t(16) + size_t(digit);
    i++;
  }
  if (i == 0 || !extensions(line, i)) {
    return unexpected(server_error(server_errc::malformed, server_phase::body, true));
  }
  return count;
}
bool valid_trailer(string_view line, connection_options& options) {
  size_t colon = until(line, size_t(0), ':');
  if (colon == line.size()) { return false; }
  auto name = line.substr(size_t(0), colon);
  if (!wire_field(name, line.substr(colon + size_t(1)))) { return false; }
  if (options.contains(name)) { return false; }
  if (name.size() > size_t(3) && named(name.substr(size_t(0), size_t(3)), "If-")) { return false; }
  return !reserved_field(name) && !named(name, "Host") && !named(name, "Content-Encoding") &&
         !named(name, "Content-Type") && !named(name, "Content-Range") &&
         !named(name, "Authorization") && !named(name, "Proxy-Authorization") &&
         !named(name, "Cookie") && !named(name, "Expect") && !named(name, "TE") &&
         !named(name, "Cache-Control") && !named(name, "Max-Forwards") && !named(name, "Range") &&
         !named(name, "Keep-Alive") && !named(name, "Proxy-Connection") &&
         !named(name, "Set-Cookie") && !named(name, "WWW-Authenticate") && !named(name, "Proxy-Authenticate") &&
         !named(name, "Location") && !named(name, "Retry-After") && !named(name, "Vary") &&
         !named(name, "Content-Language") && !named(name, "Content-Location");
}
}

/// Incremental HTTP/1.1 framing for one connection. The package drives transport readiness.
export class server_codec {
  server_limits limits;
  mut server_detail::exchange_state exchange = server_detail::exchange_state::between;
  mut server_detail::body_frame frame = server_detail::body_frame::done;
  mut string input{};
  mut server_detail::connection_options options{};
  mut size_t line_size = 0;
  mut size_t lines = 0;
  mut bool cr = false;
  mut size_t remaining = 0;
  mut size_t body_budget = 0;
  mut size_t framing_bytes = 0;
  mut size_t trailer_bytes = 0;
  mut size_t trailers = 0;
  mut bool wants_continue = false;
  mut bool head_method = false;
  mut bool connect_method = false;
  mut bool close_after = false;
  mut byte_buffer output{};
  mut size_t sent = 0;
  mut size_t payload_left = 0;
  mut disposition after = disposition::close;

  server_codec(server_limits limits) : limits(limits) {}
  server_error reject(server_errc code, server_phase phase) mut {
    this.exchange = server_detail::exchange_state::rejected;
    return server_error(code, phase, true);
  }
  bool append_output(string_view text) mut {
    if (text.size() > this.limits.response_head - this.output.size()) { return false; }
    for (mut size_t i = 0; i < text.size(); i++) { this.output.push_back(uint8_t(text[i])); }
    return true;
  }
  span<uint8_t, this> pending_framing() {
    auto all = this.output.as_span();
    return all.subspan(this.sent, all.size() - this.sent);
  }
public:
  server_codec(server_codec& other) = delete;
  server_codec(server_codec&& other) = default;
  static expected<server_codec, server_error> open(server_limits limits) {
    // A closing error reply needs its status line, two fields and an empty line.
    string_view minimal_error = "HTTP/1.1 400 \r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
    if (limits.request_line < size_t(2) || limits.request_line > limits.request_head ||
        limits.response_head < minimal_error.size() || limits.response_fields < size_t(2) ||
        limits.chunk_line < size_t(3) ||
        limits.chunk_line > limits.chunk_framing || limits.trailer_bytes < size_t(2) ||
        limits.trailer_bytes > limits.chunk_framing) {
      return unexpected(server_error(server_errc::invalid_argument, server_phase::configuration));
    }
    return server_codec(limits);
  }
  /// Consume at most one head, leaving the suffix in caller-owned storage.
  expected<head_progress, server_error> parse_head(span<uint8_t>& bytes) mut {
    if (this.exchange != server_detail::exchange_state::between) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::head));
    }
    for (mut size_t i = 0; i < bytes.size(); i++) {
      if (this.input.size() == this.limits.request_head) { return unexpected(this.reject(server_errc::head_limit, server_phase::head)); }
      if (this.lines == 0 && this.line_size == this.limits.request_line) { return unexpected(this.reject(server_errc::line_limit, server_phase::head)); }
      char c = char(bytes[i]);
      if (this.lines > this.limits.request_fields && this.line_size == 0 && c != '\r') {
        return unexpected(this.reject(server_errc::field_limit, server_phase::head));
      }
      if (this.cr != (c == '\n')) { return unexpected(this.reject(server_errc::malformed, server_phase::head)); }
      this.input.push_back(c);
      this.line_size++;
      this.cr = c == '\r';
      if (c == '\n') {
        if (this.line_size == size_t(2)) {
          if (this.lines == 0) { return unexpected(this.reject(server_errc::malformed, server_phase::head)); }
          this.options.clear();
          mut auto parsed = server_detail::decode_head(this.input.view(), this.limits, this.options);
          if (!parsed) { return unexpected(this.reject(parsed.error().code, server_phase::head)); }
          mut auto head = std::move(parsed).value();
          this.input.clear();
          this.lines = 0;
          this.line_size = 0;
          this.exchange = server_detail::exchange_state::active;
          auto length = head.content_length();
          this.remaining = length.has_value() ? length.value() : size_t(0);
          this.frame = head.chunked() ? server_detail::body_frame::chunk_size :
                       this.remaining > 0 ? server_detail::body_frame::fixed : server_detail::body_frame::done;
          this.body_budget = this.limits.decoded_body;
          this.framing_bytes = 0;
          this.trailer_bytes = 0;
          this.trailers = 0;
          this.wants_continue = head.expects_continue();
          this.close_after = head.requests_close();
          this.head_method = head.method_text() == "HEAD";
          this.connect_method = head.method_text() == "CONNECT";
          return head_progress(i + size_t(1), std::move(head));
        }
        this.lines++;
        this.line_size = 0;
      }
    }
    return head_progress(bytes.size());
  }
  /// Decode into nonempty caller storage, including across split chunk or trailer lines.
  expected<body_progress, server_error> parse_body(span<uint8_t>& bytes, mut mutable_span<uint8_t>& dst) mut {
    if (this.exchange != server_detail::exchange_state::active || this.wants_continue) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::body));
    }
    if (dst.empty()) { return unexpected(server_error(server_errc::invalid_argument, server_phase::body)); }
    mut size_t i = 0;
    mut size_t written = 0;
    while (this.frame != server_detail::body_frame::done) {
      if (i == bytes.size()) { return body_progress(i, written, body_state::need_input); }
      if (this.frame == server_detail::body_frame::fixed || this.frame == server_detail::body_frame::chunk_data) {
        if (written == dst.size()) { return body_progress(i, written, body_state::need_space); }
        mut size_t count = this.remaining;
        if (count > dst.size() - written) { count = dst.size() - written; }
        if (count > bytes.size() - i) { count = bytes.size() - i; }
        for (mut size_t j = 0; j < count; j++) { dst[written + j] = bytes[i + j]; }
        this.remaining -= count;
        i += count;
        written += count;
        if (this.remaining == 0) {
          this.frame = this.frame == server_detail::body_frame::fixed ? server_detail::body_frame::done : server_detail::body_frame::chunk_cr;
        }
        continue;
      }
      if (this.framing_bytes == this.limits.chunk_framing) { return unexpected(this.reject(server_errc::framing_limit, server_phase::body)); }
      this.framing_bytes++;
      char c = char(bytes[i]);
      i++;
      if (this.frame == server_detail::body_frame::chunk_cr || this.frame == server_detail::body_frame::chunk_lf) {
        if (this.frame == server_detail::body_frame::chunk_cr && c == '\r') {
          this.frame = server_detail::body_frame::chunk_lf;
        } else if (this.frame == server_detail::body_frame::chunk_lf && c == '\n') {
          this.frame = server_detail::body_frame::chunk_size;
        } else { return unexpected(this.reject(server_errc::malformed, server_phase::body)); }
        continue;
      }
      if (this.frame == server_detail::body_frame::trailers) {
        if (this.trailer_bytes == this.limits.trailer_bytes) { return unexpected(this.reject(server_errc::trailer_limit, server_phase::body)); }
        this.trailer_bytes++;
        if (this.trailers == this.limits.trailer_fields && this.line_size == 0 && c != '\r') {
          return unexpected(this.reject(server_errc::trailer_limit, server_phase::body));
        }
      } else if (this.line_size == this.limits.chunk_line) {
        return unexpected(this.reject(server_errc::chunk_line_limit, server_phase::body));
      }
      this.line_size++;
      if (this.cr != (c == '\n')) { return unexpected(this.reject(server_errc::malformed, server_phase::body)); }
      this.cr = c == '\r';
      if (c == '\r') { continue; }
      if (c != '\n') { this.input.push_back(c); continue; }
      if (this.frame == server_detail::body_frame::chunk_size) {
        auto parsed = server_detail::chunk_size(this.input.view(), this.body_budget);
        if (!parsed) { return unexpected(this.reject(parsed.error().code, server_phase::body)); }
        this.remaining = parsed.value();
        this.body_budget -= this.remaining;
        this.frame = this.remaining == 0 ? server_detail::body_frame::trailers : server_detail::body_frame::chunk_data;
      } else if (this.input.empty()) {
        this.frame = server_detail::body_frame::done;
      } else {
        if (!server_detail::valid_trailer(this.input.view(), this.options)) { return unexpected(this.reject(server_errc::malformed, server_phase::body)); }
        this.trailers++;
      }
      this.input.clear();
      this.line_size = 0;
    }
    return body_progress(i, written, body_state::body_end);
  }

  expected<void, server_error> end_input() mut {
    if (this.exchange == server_detail::exchange_state::between && this.input.empty()) {
      this.exchange = server_detail::exchange_state::ended;
      return;
    }
    if (this.exchange == server_detail::exchange_state::output && this.after != disposition::continue_sent) {
      this.after = disposition::close;
      return;
    }
    if (this.exchange == server_detail::exchange_state::active && this.frame == server_detail::body_frame::done) {
      this.close_after = true;
      return;
    }
    if (this.exchange == server_detail::exchange_state::between || this.exchange == server_detail::exchange_state::active ||
        (this.exchange == server_detail::exchange_state::output && this.after == disposition::continue_sent)) {
      auto phase = this.exchange == server_detail::exchange_state::between ? server_phase::head : server_phase::body;
      this.exchange = server_detail::exchange_state::ended;
      return unexpected(server_error(server_errc::truncated, phase));
    }
    return unexpected(server_error(server_errc::wrong_state, server_phase::head));
  }
  expected<void, server_error> begin_continue() mut {
    if (this.exchange != server_detail::exchange_state::active || !this.wants_continue) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::output));
    }
    this.output.clear();
    if (!this.append_output("HTTP/1.1 100 Continue\r\n\r\n")) {
      return unexpected(server_error(server_errc::head_limit, server_phase::output));
    }
    this.sent = 0;
    this.payload_left = 0;
    this.after = disposition::continue_sent;
    this.exchange = server_detail::exchange_state::output;
    return;
  }
  expected<void, server_error> begin_response(response_head& head, size_t representation_length, connection_policy policy) mut {
    if (this.exchange != server_detail::exchange_state::active) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::output));
    }
    uint16_t status = head.status();
    bool omit_length = status == uint16_t(204) || status == uint16_t(304);
    if (((omit_length || status == uint16_t(205)) && representation_length != size_t(0)) ||
        (this.connect_method && status < uint16_t(300))) {
      return unexpected(server_error(server_errc::invalid_argument, server_phase::output));
    }
    bool close = this.close_after || policy == connection_policy::close || this.frame != server_detail::body_frame::done;
    auto& fields = head.headers();
    size_t generated = (close ? size_t(1) : size_t(0)) + (omit_length ? size_t(0) : size_t(1));
    if (generated > this.limits.response_fields || fields.size() > this.limits.response_fields - generated) {
      return unexpected(server_error(server_errc::field_limit, server_phase::output));
    }
    this.output.clear();
    auto status_text = std::to_string(status);
    if (!this.append_output("HTTP/1.1 ") || !this.append_output(status_text.view()) || !this.append_output(" \r\n")) {
      return unexpected(server_error(server_errc::head_limit, server_phase::output));
    }
    for (mut size_t i = 0; i < fields.size(); i++) {
      if (!this.append_output(fields.name_at(i)) || !this.append_output(": ") ||
          !this.append_output(fields.value_at(i)) || !this.append_output("\r\n")) {
        return unexpected(server_error(server_errc::head_limit, server_phase::output));
      }
    }
    if (!omit_length) {
      auto length_text = std::to_string(representation_length);
      if (!this.append_output("Content-Length: ") || !this.append_output(length_text.view()) || !this.append_output("\r\n")) {
        return unexpected(server_error(server_errc::head_limit, server_phase::output));
      }
    }
    if ((close && !this.append_output("Connection: close\r\n")) || !this.append_output("\r\n")) {
      return unexpected(server_error(server_errc::head_limit, server_phase::output));
    }
    this.payload_left = this.head_method ? size_t(0) : representation_length;
    this.sent = 0;
    this.after = close ? disposition::close : disposition::reusable;
    this.exchange = server_detail::exchange_state::output;
    return;
  }
  expected<void, server_error> begin_error(uint16_t status) mut {
    if (this.exchange != server_detail::exchange_state::rejected) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::output));
    }
    if (status < uint16_t(400) || status > uint16_t(599)) {
      return unexpected(server_error(server_errc::invalid_argument, server_phase::output));
    }
    auto head = ?response_head::create(status);
    this.exchange = server_detail::exchange_state::active;
    auto result = this.begin_response(head, size_t(0), connection_policy::close);
    if (!result) {
      this.exchange = server_detail::exchange_state::rejected;
      return unexpected(result.error());
    }
    return;
  }
  /// Only the framing alternative retains a read-only view of this codec.
  expected<output_step<this>, server_error> next_output() {
    if (this.exchange != server_detail::exchange_state::output) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::output));
    }
    if (this.sent < this.output.size()) { return output_step<this>::framing(this.pending_framing()); }
    if (this.payload_left > 0) { return output_step<this>::body(this.payload_left); }
    return output_step<this>::flush;
  }
  expected<void, server_error> advance_output(size_t n) mut {
    if (this.exchange != server_detail::exchange_state::output) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::output));
    }
    size_t framing = this.output.size() - this.sent;
    if (n == 0 || n > (framing > 0 ? framing : this.payload_left)) {
      return unexpected(server_error(server_errc::invalid_argument, server_phase::output));
    }
    if (framing > 0) { this.sent += n; } else { this.payload_left -= n; }
    return;
  }
  expected<disposition, server_error> finish_flush() mut {
    if (this.exchange != server_detail::exchange_state::output ||
        this.sent != this.output.size() || this.payload_left != 0) {
      return unexpected(server_error(server_errc::wrong_state, server_phase::output));
    }
    auto result = this.after;
    this.output.clear();
    if (result == disposition::continue_sent) {
      this.wants_continue = false;
      this.exchange = server_detail::exchange_state::active;
    } else if (result == disposition::close) {
      this.exchange = server_detail::exchange_state::ended;
    } else {
      this.exchange = server_detail::exchange_state::between;
    }
    return result;
  }
};

namespace server_detail {
expected<size_t, server_error> write_prefix<S>(mut S& transport, span<uint8_t>& data, mut bool& terminal)
    requires io::writer<S> {
  size_t size = data.size();
  auto result = transport.write_some(data);
  if (!result) {
    terminal = true;
    return unexpected(server_error(result.error(), server_phase::output));
  }
  size_t count = result.value();
  if (count == 0 || count > size) {
    terminal = true;
    return unexpected(server_error(io_errc::write_failed, server_phase::output));
  }
  return count;
}
}
/// A blocking driver over the same wire codec. Owns a single duplex stream and
/// keeps the unread suffix of every transport read until the codec consumes it.
export class server_connection<S> {
  mut S transport;
  mut server_codec codec;
  mut byte_buffer window;
  mut size_t first = 0;
  mut size_t last = 0;
  mut bool terminal = false;

  expected<bool, server_error> refill(server_phase phase) mut requires io::reader<S> {
    size_t capacity = this.window.size();
    mut auto dst = this.window.as_mutable_span();
    auto result = this.transport.read_some(dst);
    if (!result) {
      this.terminal = true;
      return unexpected(server_error(result.error(), phase));
    }
    size_t count = result.value();
    if (count > capacity) {
      this.terminal = true;
      return unexpected(server_error(io_errc::read_failed, phase));
    }
    this.first = 0;
    this.last = count;
    if (count == 0) {
      this.terminal = true;
      ?this.codec.end_input();
      return false;
    }
    return true;
  }
  expected<disposition, server_error> write_pending(span<uint8_t>& body) mut requires io::writer<S> {
    mut size_t offset = 0;
    while (true) {
      mut size_t count = 0;
      mut bool flush = false;
      {
        auto pending = this.codec.next_output();
        if (!pending) { return unexpected(pending.error()); }
        switch (pending.value()) {
        case output_step<_>::framing(auto& bytes):
          count = ?server_detail::write_prefix(this.transport, bytes, this.terminal);
          break;
        case output_step<_>::body(remaining):
          auto data = body.subspan(offset, remaining);
          count = ?server_detail::write_prefix(this.transport, data, this.terminal);
          offset += count;
          break;
        case output_step<_>::flush: flush = true; break;
        }
      }
      if (flush) {
        auto flushed = this.transport.flush();
        if (!flushed) {
          this.terminal = true;
          return unexpected(server_error(flushed.error(), server_phase::output));
        }
        auto result = ?this.codec.finish_flush();
        this.terminal = result == disposition::close;
        return result;
      }
      ?this.codec.advance_output(count);
    }
  }
public:
  server_connection(server_detail::connection_adoption token, S stream, server_codec codec)
      : transport(std::move(stream)), codec(std::move(codec)), window(byte_buffer(size_t(4096))) {}
  server_connection(server_connection<S>& other) = delete;
  server_connection(server_connection<S>&& other) = default;
  expected<optional<request_head>, server_error> read_head() mut requires io::reader<S> {
    if (this.terminal) { return unexpected(server_error(server_errc::wrong_state, server_phase::head)); }
    while (true) {
      {
        auto all = this.window.as_span();
        auto input = all.subspan(this.first, this.last - this.first);
        mut auto parsed = this.codec.parse_head(input);
        if (!parsed) { return unexpected(parsed.error()); }
        this.first += parsed.value().consumed;
        if (parsed.value().head.has_value()) {
          mut auto step = std::move(parsed).value();
          return std::move(step.head);
        }
      }
      bool available = ?this.refill(server_phase::head);
      if (!available) { return optional<request_head>(); }
    }
  }
  expected<size_t, server_error> read_body(mut mutable_span<uint8_t>& dst) mut requires io::reader<S> {
    if (this.terminal) { return unexpected(server_error(server_errc::wrong_state, server_phase::body)); }
    while (true) {
      {
        auto all = this.window.as_span();
        auto input = all.subspan(this.first, this.last - this.first);
        auto step = ?this.codec.parse_body(input, dst);
        this.first += step.consumed;
        if (step.written > 0 || step.state == body_state::body_end) { return step.written; }
      }
      bool available = ?this.refill(server_phase::body);
      if (!available) { return unexpected(server_error(server_errc::truncated, server_phase::body)); }
    }
  }
  expected<void, server_error> send_continue() mut requires io::writer<S> {
    if (this.terminal) { return unexpected(server_error(server_errc::wrong_state, server_phase::output)); }
    ?this.codec.begin_continue();
    byte_buffer storage{};
    auto empty = storage.as_span();
    auto completed = ?this.write_pending(empty);
    return;
  }
  expected<disposition, server_error> send(response_head& head, span<uint8_t>& body, connection_policy policy) mut requires io::writer<S> {
    if (this.terminal) { return unexpected(server_error(server_errc::wrong_state, server_phase::output)); }
    ?this.codec.begin_response(head, body.size(), policy);
    return this.write_pending(body);
  }
  expected<void, server_error> send_error(uint16_t status) mut requires io::writer<S> {
    if (this.terminal) { return unexpected(server_error(server_errc::wrong_state, server_phase::output)); }
    ?this.codec.begin_error(status);
    byte_buffer storage{};
    auto empty = storage.as_span();
    auto completed = ?this.write_pending(empty);
    return;
  }
};

/// Validate limits and transfer the blocking duplex owner without performing I/O.
export expected<server_connection<S>, server_error> open_server_connection<S>(S stream, server_limits limits)
    requires io::reader<S> && io::writer<S> {
  mut auto codec = ?server_codec::open(limits);
  return server_connection<S>(server_detail::connection_adoption::validated, std::move(stream), std::move(codec));
}
}
}
