/// Follows symbolic links. An absent path is a successful not_found status.
export expected<file_status, errc> status(std::string_view input) {
  return gti_internal::filesystem_detail::status(input, uint32_t(1));
}
export expected<file_status, errc> status(path& input) {
  return status(input.view());
}
/// Inspects the link itself, including dangling links.
export expected<file_status, errc> symlink_status(std::string_view input) {
  return gti_internal::filesystem_detail::status(input, uint32_t(0));
}
export expected<file_status, errc> symlink_status(path& input) {
  return symlink_status(input.view());
}

export bool exists(file_status& value) { return value.type() != file_type::not_found; }
