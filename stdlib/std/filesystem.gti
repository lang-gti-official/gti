/// Copies regular-file contents. Existing destinations fail unless the caller
/// explicitly chooses skip_existing or overwrite_existing. Symlinks are followed.
export expected<bool, errc> copy_file(std::string_view from, std::string_view to, copy_options options) {
  mut uint32_t option = 0;
  if (options == copy_options::skip_existing) { option = uint32_t(1); }
  if (options == copy_options::overwrite_existing) { option = uint32_t(2); }
  uint64_t value = ?gti_internal::filesystem_detail::mutate(uint32_t(5), from, to, option);
  return value != uint64_t(0);
}
export expected<bool, errc> copy_file(std::string_view from, std::string_view to) { return copy_file(from, to, copy_options::none); }
export expected<bool, errc> copy_file(path& from, path& to, copy_options options) { return copy_file(from.view(), to.view(), options); }
export expected<bool, errc> copy_file(path& from, path& to) { return copy_file(from.view(), to.view(), copy_options::none); }

