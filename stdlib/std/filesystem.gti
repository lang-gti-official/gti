/// A move-only, nonrecursive directory stream. open() starts before the first
/// entry; next() returns true for each available entry and false at end.
export class directory_iterator {
  mut gti_internal::filesystem_result owner;
  mut bool available = false;
  directory_iterator(gti_internal::filesystem_result value) : owner(std::move(value)) {}
public:
  directory_iterator(directory_iterator& other) = delete;
  directory_iterator(directory_iterator&& other) = default;
  static expected<directory_iterator, errc> open(std::string_view input) {
    mut int64_t value = 0;
    mut uint32_t code = 0;
    unsafe { code = gti_internal::filesystem_runtime::gti_rt_fs_directory_open_v1(input, &value); }
    if (code != uint32_t(0)) { return unexpected(gti_internal::filesystem_detail::error(code)); }
    return directory_iterator(gti_internal::filesystem_result(value));
  }
  static expected<directory_iterator, errc> open(path& input) { return directory_iterator::open(input.view()); }
  expected<bool, errc> next() mut {
    this.available = false;
    mut uint32_t value = 0;
    mut uint32_t code = 0;
    unsafe { code = gti_internal::filesystem_runtime::gti_rt_fs_directory_next_v1(this.owner.get(), &value); }
    if (code != uint32_t(0)) { return unexpected(gti_internal::filesystem_detail::error(code)); }
    this.available = value != uint32_t(0);
    return this.available;
  }
  /// Returns an independent owned path; invalid before next() or after EOF/error.
  expected<path, errc> entry_path() {
    if (!this.available) { return unexpected(errc::invalid_argument); }
    mut std::string text = this.owner.text();
    return path(text.view());
  }
};

/// Collects directory entries into an owning range. Host order is unspecified;
/// concurrent directory changes do not produce an atomic snapshot.
export expected<std::vector<path>, errc> directory_entries(std::string_view input) {
  mut directory_iterator iterator = ?directory_iterator::open(input);
  mut std::vector<path> entries = std::vector<path>();
  for (;;) {
    bool available = ?iterator.next();
    if (!available) { break; }
    path entry = ?iterator.entry_path();
    entries.push_back(std::move(entry));
  }
  return std::move(entries);
}
export expected<std::vector<path>, errc> directory_entries(path& input) { return directory_entries(input.view()); }

}
