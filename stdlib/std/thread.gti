namespace std {
/// Recoverable managed-thread creation and explicit-join outcomes.
enum class thread_errc {
  resource_unavailable,
  operation_not_permitted,
  not_joinable,
  join_failed,
};
}

namespace gti_internal {
[[no_transfer, no_share]] class thread_handle {
public:
  thread_handle(thread_handle& other) = delete;
  ~thread_handle() = default;
};

[[no_transfer, no_share]] class thread_result_handle<Result> {
public:
  thread_result_handle() = default;
  thread_result_handle(thread_result_handle<Result>& other) = delete;
  ~thread_result_handle() = default;
};

gti_internal::thread_handle thread_handle_empty();
gti_internal::thread_result_handle<Result> thread_result_handle_empty<Result>();
bool thread_joinable(gti_internal::thread_handle& handle);
int32_t thread_spawn<Task>(mut gti_internal::thread_handle& handle, Task task);
int32_t thread_join(mut gti_internal::thread_handle& handle);
void thread_auto_join(mut gti_internal::thread_handle& handle);
bool thread_result_joinable<Result>(gti_internal::thread_result_handle<Result>& handle);
int32_t thread_result_spawn<Result, Task>(mut gti_internal::thread_result_handle<Result>& handle, Task task);
// Joins once and reports 0 (joined), 1 (not joinable) or 2 (join failed). A
// successful join keeps the worker's result in the handle for one take.
int32_t thread_result_join<Result>(mut gti_internal::thread_result_handle<Result>& handle);
Result thread_result_take<Result>(mut gti_internal::thread_result_handle<Result>& handle);
void thread_result_auto_join<Result>(mut gti_internal::thread_result_handle<Result>& handle);
// Identity-bound operation with verified task ownership and dependency loans.
int32_t thread_scope<Tasks...>(Tasks... tasks);
}

namespace std {
/// Runs consumed void tasks concurrently and joins every started task before
/// returning or propagating failure. Checked references may cross this bounded
/// call: shared referents must be share-safe; exclusive referents transfer-safe.
/// Remaining task storage is cleaned up in reverse order on the caller after
/// join-all. A consuming invocation retains ordinary receiver cleanup semantics.
/// Native creation failure stops submission, but still joins earlier tasks.
expected<void, thread_errc> parallel_invoke<Tasks...>(Tasks... tasks) {
  int32_t status = gti_internal::thread_scope(tasks...);
  if (status == 1) return unexpected(thread_errc::resource_unavailable);
  if (status != 0) return unexpected(thread_errc::operation_not_permitted);
  return;
}

/// A move-only managed thread. Destruction joins an outstanding worker.
///
/// The worker owns its task and all transfer-safe captures. A worker defined
/// failure is re-raised by `join()` or by the mandatory destructor join. Move
/// construction transfers the join obligation; move assignment is not part of
/// this first surface.
class thread {
  mut gti_internal::thread_handle handle;

  thread(gti_internal::thread_handle value)
      : handle(std::move(value)) {}

public:
  thread(thread& other) = delete;
  thread(thread&& other) = default;

  /// Starts one consumed, transfer-safe exact `void()` task.
  static expected<thread, thread_errc> start<Task>(Task task) {
    mut gti_internal::thread_handle handle =
        gti_internal::thread_handle_empty();
    int32_t status =
        gti_internal::thread_spawn(handle, std::move(task));
    if (status == 1) {
      return unexpected(thread_errc::resource_unavailable);
    }
    if (status != 0) {
      return unexpected(thread_errc::operation_not_permitted);
    }
    return thread(std::move(handle));
  }

  /// True while this value owns an outstanding join obligation.
  bool joinable() {
    return gti_internal::thread_joinable(this.handle);
  }

  /// Joins the worker once. A worker defined failure is re-raised here.
  expected<void, thread_errc> join() mut {
    int32_t status = gti_internal::thread_join(this.handle);
    if (status == 1) {
      return unexpected(thread_errc::not_joinable);
    }
    if (status != 0) {
      return unexpected(thread_errc::join_failed);
    }
    return;
  }

  ~thread() {
    gti_internal::thread_auto_join(this.handle);
  }
};

/// A move-only managed thread whose explicit join returns one owned result.
///
/// Destruction joins an outstanding worker and abandons an unobserved result.
/// The result type and task captures must be transfer-safe owned values.
class thread_result<Result> {
  mut gti_internal::thread_result_handle<Result> handle;

public:
  thread_result()
      : handle(gti_internal::thread_result_handle_empty<Result>()) {}

  thread_result(thread_result<Result>& other) = delete;
  thread_result(thread_result<Result>&& other) = default;

  /// Starts one consumed, transfer-safe exact `Result()` task.
  expected<void, thread_errc> start<Task>(Task task) mut {
    int32_t status =
        gti_internal::thread_result_spawn(this.handle, std::move(task));
    if (status == 1) {
      return unexpected(thread_errc::resource_unavailable);
    }
    if (status != 0) {
      return unexpected(thread_errc::operation_not_permitted);
    }
    return;
  }

  /// True while this value owns an outstanding join obligation.
  bool joinable() {
    return gti_internal::thread_result_joinable(this.handle);
  }

  /// Joins once and transfers the worker's owned result to this thread.
  expected<Result, thread_errc> join() mut {
    int32_t status = gti_internal::thread_result_join(this.handle);
    if (status == 1) {
      return unexpected(thread_errc::not_joinable);
    }
    if (status != 0) {
      return unexpected(thread_errc::join_failed);
    }
    return gti_internal::thread_result_take(this.handle);
  }

  ~thread_result() {
    gti_internal::thread_result_auto_join(this.handle);
  }
};
}
