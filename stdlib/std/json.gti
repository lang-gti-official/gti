// <std/json> -- JSON text for application types, through reflection.
//
// Every encoding and decoding rule is ordinary GTI written over <std/meta>;
// no JSON type or operation has compiler recognition. `encode` walks a
// value's fields and writes text; `decode` scans text into per-member byte
// ranges and builds the value with `std::meta::construct`, so no object exists
// before every field has a value and constructors are never bypassed.
//
// Field keys are the declared names unless `[[std::json::name("key")]]`
// renames one; `[[std::json::ignore]]` leaves a field out of the
// text and takes its declared default on decoding; `[[std::json::defaulted]]`
// lets an absent member take the field's declared default too. Members of the
// text that name no field are checked but not decoded; a repeated key is an
// error (`duplicate_key`). `read_file`/`write_file` move whole documents
// to and from disk.
//
// Supported types, at the top level and as fields: bool, the fixed-width
// integers (range-checked), float and double (shortest round-trip text, exact
// decimal lexemes accepted), std::string (owned text), std::string_view
// (encoding only), integral enums (by enumerator name), std::optional<T>
// (`null` or an absent member), std::vector<E>, std::map and
// std::unordered_map with std::string keys (objects with dynamic keys),
// nested reflectable structs, and any type with a
// `std::json::codec<T>` specialization. Anything else is
// rejected where it is used.
//
// The text grammar is strict JSON: valid UTF-8, no control characters in
// strings, `\u` escapes with surrogate pairs, no leading zeros, no comments,
// no trailing commas, nothing after the root value. Decoding failures carry
// an `errc`, the byte offset, the one-based line and column, and a JSON
// Pointer path to the failing value.
#include <std/charconv>
#include <std/cstdio>
#include <std/format>
#include <std/map>
#include <std/meta>
#include <std/optional>
#include <std/string>
#include <std/unordered_map>
#include <std/vector>

namespace std {
namespace json {

enum class errc {
  unexpected_end,
  unexpected_character,
  invalid_number,
  invalid_escape,
  invalid_unicode,
  duplicate_key,
  missing_field,
  invalid_enumerator,
  type_mismatch,
  number_out_of_range,
  nesting_limit,
  document_too_large,
  trailing_characters,
  io_failure,
};

std::string_view describe(errc code) {
  switch (code) {
    case errc::unexpected_end: return "unexpected end of JSON text";
    case errc::unexpected_character: return "unexpected character";
    case errc::invalid_number: return "invalid JSON number";
    case errc::invalid_escape: return "invalid JSON string escape";
    case errc::invalid_unicode: return "invalid UTF-8 or Unicode escape";
    case errc::duplicate_key: return "object repeats a key";
    case errc::missing_field: return "object is missing a required field";
    case errc::invalid_enumerator: return "string does not name an enumerator";
    case errc::type_mismatch: return "JSON value has the wrong type for the field";
    case errc::number_out_of_range: return "number does not fit the field type";
    case errc::nesting_limit: return "nesting exceeds the configured depth";
    case errc::document_too_large: return "document exceeds the configured size";
    case errc::trailing_characters: return "characters follow the JSON value";
    case errc::io_failure: return "the file could not be read or written";
  }
  return "unknown JSON error";
}

/// Why and where decoding (or encoding) stopped. `offset` is a byte offset
/// into the input; `line` and `column` are one-based and zero when the error
/// has no source location (an encoding failure). `path` is a JSON Pointer to
/// the value being decoded when the failure happened.
struct error {
  errc code = errc::unexpected_end;
  std::size_t offset = 0;
  std::size_t line = 0;
  std::size_t column = 0;
  mut { std::string path; }

  error(errc code, std::size_t offset, std::size_t line, std::size_t column)
      : code(code), offset(offset), line(line), column(column), path(std::string("")) {}
  error(error& other) = delete;
  error(error&& other) = default;

  std::string_view description() { return describe(this.code); }
  bool has_source_location() { return this.line > std::size_t(0); }

  /// Prefixes the JSON Pointer with one reference token, escaping `~` and
  /// `/` as the pointer grammar requires.
  void prepend_key(std::string_view key) mut {
    mut std::string prefix = std::string("/");
    for (mut std::size_t index = 0; index < key.size(); index++) {
      char value = key[index];
      if (value == '~') {
        prefix.append("~0");
      } else if (value == '/') {
        prefix.append("~1");
      } else {
        prefix.push_back(value);
      }
    }
    prefix.append(this.path.view());
    this.path = std::move(prefix);
  }

  /// Prefixes the JSON Pointer with an array index.
  void prepend_index(std::size_t index) mut {
    mut std::string prefix = std::string("/");
    detail::append_unsigned(prefix, uint64_t(index));
    prefix.append(this.path.view());
    this.path = std::move(prefix);
  }
};

/// Resource limits and leniency for decoding.
struct decode_options {
  mut {
    std::size_t max_depth;
    std::size_t max_document_bytes;
    bool missing_members_defaulted;
  }
  decode_options()
      : max_depth(std::size_t(128)), max_document_bytes(std::size_t(67108864)),
        missing_members_defaulted(false) {}
  decode_options(std::size_t max_depth, std::size_t max_document_bytes, bool missing_members_defaulted)
      : max_depth(max_depth), max_document_bytes(max_document_bytes),
        missing_members_defaulted(missing_members_defaulted) {}
  void set_max_depth(std::size_t maximum) mut { this.max_depth = maximum; }
  void set_max_document_bytes(std::size_t maximum) mut { this.max_document_bytes = maximum; }
  /// When set, an absent member whose field declares a default initializer
  /// takes that default instead of failing with `missing_field`, as if every
  /// such field were `[[defaulted]]`.
  void set_missing_members_defaulted(bool enabled) mut { this.missing_members_defaulted = enabled; }
};

/// `[[std::json::name("key")]]`: the object key of a field.
[[attribute]] struct name {
  std::string_view key = "";
};

/// `[[std::json::ignore]]`: the field is not part of the text.
[[attribute]] struct ignore {};

/// `[[std::json::defaulted]]`: an absent member takes the field's declared
/// default initializer instead of failing with `missing_field`. The field
/// must declare a default.
[[attribute]] struct defaulted {};

/// Applications specialize this class for a type they own that the field
/// rules do not cover (`class std::json::codec<Model> { ... }`):
///
///   expected<void, error> encode(Model& value, mut std::string& out);
///   expected<Model, error> decode(std::string_view text);
///
/// `encode` appends the value's JSON text; `decode` receives exactly the
/// value's text and reports offsets relative to it (the library rebases them).
/// The empty primary is detected through reflection: a specialization has
/// methods, the primary has none.
class codec<T> {
public:
};

namespace detail {

bool is_digit(char value) {
  return uint8_t(value) >= uint8_t('0') && uint8_t(value) <= uint8_t('9');
}

bool is_space(char value) {
  return value == ' ' || value == '\n' || value == '\t' || value == '\r';
}

char hex_character(uint8_t value) {
  std::string_view hex = "0123456789abcdef";
  return hex[std::size_t(value)];
}

/// The value of one hexadecimal digit, or -1.
int32_t hex_value(char value) {
  uint8_t code = uint8_t(value);
  if (code >= uint8_t('0') && code <= uint8_t('9')) {
    return int32_t(code - uint8_t('0'));
  }
  if (code >= uint8_t('a') && code <= uint8_t('f')) {
    return int32_t(code - uint8_t('a')) + 10;
  }
  if (code >= uint8_t('A') && code <= uint8_t('F')) {
    return int32_t(code - uint8_t('A')) + 10;
  }
  return -1;
}

void append_unsigned(mut std::string& out, uint64_t value) {
  if (value >= uint64_t(10)) {
    append_unsigned(out, value / uint64_t(10));
  }
  out.push_back(hex_character(uint8_t(value % uint64_t(10))));
}

void append_signed(mut std::string& out, int64_t value) {
  if (value < int64_t(0)) {
    out.push_back('-');
    // Negate without overflowing: -(value + 1) fits int64_t for every
    // negative value, and adding one back happens in the unsigned domain.
    append_unsigned(out, uint64_t(int64_t(-1) - value) + uint64_t(1));
    return;
  }
  append_unsigned(out, uint64_t(value));
}

bool continuation(uint8_t value) {
  return value >= uint8_t(128) && value <= uint8_t(191);
}

/// The byte width of the UTF-8 scalar starting at `offset`, or zero when the
/// bytes there are not a valid scalar (overlong forms, surrogates and values
/// above U+10FFFF included).
std::size_t utf8_width(std::string_view input, std::size_t offset, std::size_t end) {
  uint8_t first = uint8_t(input[offset]);
  if (first <= uint8_t(127)) {
    return 1;
  }
  if (first >= uint8_t(194) && first <= uint8_t(223)) {
    if (offset + std::size_t(1) >= end || !continuation(uint8_t(input[offset + std::size_t(1)]))) {
      return 0;
    }
    return 2;
  }
  if (first >= uint8_t(224) && first <= uint8_t(239)) {
    if (offset + std::size_t(2) >= end) {
      return 0;
    }
    uint8_t second = uint8_t(input[offset + std::size_t(1)]);
    if (!continuation(second) || !continuation(uint8_t(input[offset + std::size_t(2)]))) {
      return 0;
    }
    if (first == uint8_t(224) && second < uint8_t(160)) {
      return 0;
    }
    if (first == uint8_t(237) && second > uint8_t(159)) {
      return 0;
    }
    return 3;
  }
  if (first >= uint8_t(240) && first <= uint8_t(244)) {
    if (offset + std::size_t(3) >= end) {
      return 0;
    }
    uint8_t second = uint8_t(input[offset + std::size_t(1)]);
    if (!continuation(second) || !continuation(uint8_t(input[offset + std::size_t(2)])) ||
        !continuation(uint8_t(input[offset + std::size_t(3)]))) {
      return 0;
    }
    if (first == uint8_t(240) && second < uint8_t(144)) {
      return 0;
    }
    if (first == uint8_t(244) && second > uint8_t(143)) {
      return 0;
    }
    return 4;
  }
  return 0;
}

bool valid_utf8(std::string_view input) {
  mut std::size_t offset = 0;
  while (offset < input.size()) {
    std::size_t width = utf8_width(input, offset, input.size());
    if (width == std::size_t(0)) {
      return false;
    }
    offset = offset + width;
  }
  return true;
}

void append_code_point(mut std::string& out, int32_t point) {
  if (point <= 127) {
    out.push_back(char(uint8_t(point)));
    return;
  }
  if (point <= 2047) {
    out.push_back(char(uint8_t(192 + point / 64)));
    out.push_back(char(uint8_t(128 + point % 64)));
    return;
  }
  if (point <= 65535) {
    out.push_back(char(uint8_t(224 + point / 4096)));
    out.push_back(char(uint8_t(128 + (point / 64) % 64)));
    out.push_back(char(uint8_t(128 + point % 64)));
    return;
  }
  out.push_back(char(uint8_t(240 + point / 262144)));
  out.push_back(char(uint8_t(128 + (point / 4096) % 64)));
  out.push_back(char(uint8_t(128 + (point / 64) % 64)));
  out.push_back(char(uint8_t(128 + point % 64)));
}

/// Writes `text` as a JSON string literal with the shortest normal escapes;
/// non-ASCII UTF-8 is emitted directly. Fails on invalid UTF-8.
expected<void, error> append_escaped(mut std::string& out, std::string_view text) {
  if (!valid_utf8(text)) {
    return unexpected(error(errc::invalid_unicode, std::size_t(0), std::size_t(0), std::size_t(0)));
  }
  out.push_back('"');
  for (mut std::size_t index = 0; index < text.size(); index++) {
    char value = text[index];
    if (value == '"') {
      out.append("\\\"");
    } else if (value == '\\') {
      out.append("\\\\");
    } else if (value == '\n') {
      out.append("\\n");
    } else if (value == '\r') {
      out.append("\\r");
    } else if (value == '\t') {
      out.append("\\t");
    } else if (uint8_t(value) == uint8_t(8)) {
      out.append("\\b");
    } else if (uint8_t(value) == uint8_t(12)) {
      out.append("\\f");
    } else if (uint8_t(value) < uint8_t(32)) {
      out.append("\\u00");
      out.push_back(hex_character(uint8_t(uint8_t(value) / uint8_t(16))));
      out.push_back(hex_character(uint8_t(uint8_t(value) % uint8_t(16))));
    } else {
      out.push_back(value);
    }
  }
  out.push_back('"');
  return;
}

/// The one-based line and byte column of `offset` in `text`.
void locate(std::string_view text, std::size_t offset, mut std::size_t& line, mut std::size_t& column) {
  mut std::size_t current_line = 1;
  mut std::size_t line_start = 0;
  mut std::size_t limit = offset;
  if (limit > text.size()) {
    limit = text.size();
  }
  for (mut std::size_t index = 0; index < limit; index++) {
    if (text[index] == '\n') {
      current_line = current_line + std::size_t(1);
      line_start = index + std::size_t(1);
    }
  }
  line = current_line;
  column = offset - line_start + std::size_t(1);
}

error located(errc code, std::string_view text, std::size_t offset) {
  mut std::size_t line = 0;
  mut std::size_t column = 0;
  locate(text, offset, line, column);
  return error(code, offset, line, column);
}

/// The field's object key: the `name` attribute when applied, else the
/// declared name.
std::string_view key_of<T, uint64_t I>(std::meta::field<T, I> field) {
  if constexpr (std::meta::field<T, I>().has_attribute<name>()) {
    return std::meta::field<T, I>().attribute<name>().key;
  } else {
    return std::meta::field<T, I>().name();
  }
}

/// Whether `T` has a `codec` specialization: the empty primary has no
/// methods, a specialization declares `encode` and `decode`.
constexpr bool has_codec<T>() {
  return std::meta::type_of<codec<T>>().method_count() > uint64_t(0);
}

constexpr bool is_optional<T>() {
  return std::meta::primary_name_of<T>() == "std::optional";
}

constexpr bool is_vector<T>() {
  return std::meta::primary_name_of<T>() == "std::vector";
}

constexpr bool is_string_map<T>() {
  return std::meta::primary_name_of<T>() == "std::map" ||
         std::meta::primary_name_of<T>() == "std::unordered_map";
}

constexpr bool is_owned_string<T>() {
  return std::meta::name_of<T>() == "std::string";
}

// ---- encoding -------------------------------------------------------------

/// Whitespace policy shared by compact and pretty output.
struct layout {
  layout() = default;
  bool pretty = false;
  uint8_t indentation = 2;
};

void append_indentation(mut std::string& out, layout& style, std::size_t depth) {
  out.push_back('\n');
  for (mut std::size_t level = 0; level < depth; level++) {
    for (mut uint8_t column = 0; column < style.indentation; column++) {
      out.push_back(' ');
    }
  }
}

expected<void, error> encode_enum<E>(mut std::string& out, E value) {
  constexpr for (auto enumerator : std::meta::enumerators_of<E>()) {
    if (value == enumerator.value()) {
      return append_escaped(out, enumerator.name());
    }
  }
  return unexpected(error(errc::invalid_enumerator, std::size_t(0), std::size_t(0), std::size_t(0)));
}

/// Shortest round-trip decimal text for a finite floating value; non-finite
/// values are not JSON numbers.
expected<void, error> append_floating(mut std::string& out, double value) {
  if (value != value) {
    return unexpected(error(errc::number_out_of_range, std::size_t(0), std::size_t(0), std::size_t(0)));
  }
  std::string text = std::format("{}", value);
  std::string_view view = text.view();
  if (view.size() == std::size_t(0) || view[std::size_t(0)] == 'i' || view[std::size_t(0)] == 'n' ||
      (view.size() > std::size_t(1) && view[std::size_t(0)] == '-' && view[std::size_t(1)] == 'i')) {
    return unexpected(error(errc::number_out_of_range, std::size_t(0), std::size_t(0), std::size_t(0)));
  }
  out.append(view);
  return;
}

expected<void, error> encode_value<F>(mut std::string& out, F& item, layout& style, std::size_t depth) {
  if constexpr (has_codec<F>()) {
    codec<F> mapping{};
    return mapping.encode(item, out);
  } else if constexpr (std::meta::is_bool<F>()) {
    if (item) {
      out.append("true");
    } else {
      out.append("false");
    }
    return;
  } else if constexpr (std::meta::is_signed_integral<F>()) {
    append_signed(out, int64_t(item));
    return;
  } else if constexpr (std::meta::is_integral<F>()) {
    append_unsigned(out, uint64_t(item));
    return;
  } else if constexpr (std::meta::is_floating_point<F>()) {
    return append_floating(out, double(item));
  } else if constexpr (std::meta::is_text<F>()) {
    return append_escaped(out, item);
  } else if constexpr (is_owned_string<F>()) {
    return append_escaped(out, item.view());
  } else if constexpr (std::meta::is_enum<F>()) {
    return encode_enum(out, item);
  } else if constexpr (is_optional<F>()) {
    if (item.has_value()) {
      return encode_value(out, item.value(), style, depth);
    }
    out.append("null");
    return;
  } else if constexpr (is_vector<F>()) {
    out.push_back('[');
    mut bool first = true;
    for (auto& element : item) {
      if (!first) {
        out.push_back(',');
      }
      first = false;
      if (style.pretty) {
        append_indentation(out, style, depth + std::size_t(1));
      }
      ?encode_value(out, element, style, depth + std::size_t(1));
    }
    if (!first && style.pretty) {
      append_indentation(out, style, depth);
    }
    out.push_back(']');
    return;
  } else if constexpr (is_string_map<F>()) {
    out.push_back('{');
    mut bool first = true;
    for (auto& entry : item) {
      if (!first) {
        out.push_back(',');
      }
      first = false;
      if (style.pretty) {
        append_indentation(out, style, depth + std::size_t(1));
      }
      ?append_escaped(out, entry.first.view());
      out.push_back(':');
      if (style.pretty) {
        out.push_back(' ');
      }
      ?encode_value(out, entry.second, style, depth + std::size_t(1));
    }
    if (!first && style.pretty) {
      append_indentation(out, style, depth);
    }
    out.push_back('}');
    return;
  } else if constexpr (std::meta::is_reflectable<F>()) {
    return encode_object(out, item, style, depth);
  } else {
    static_assert(false, "std::json cannot encode this type");
  }
}

expected<void, error> encode_object<T>(mut std::string& out, T& value, layout& style, std::size_t depth) {
  out.push_back('{');
  mut bool first = true;
  constexpr for (auto field : std::meta::fields_of<T>()) {
    if constexpr (!field.has_attribute<ignore>()) {
      if (!first) {
        out.push_back(',');
      }
      first = false;
      if (style.pretty) {
        append_indentation(out, style, depth + std::size_t(1));
      }
      ?append_escaped(out, key_of(field));
      out.push_back(':');
      if (style.pretty) {
        out.push_back(' ');
      }
      ?encode_value(out, field.get(value), style, depth + std::size_t(1));
    }
  }
  if (!first && style.pretty) {
    append_indentation(out, style, depth);
  }
  out.push_back('}');
  return;
}

// ---- decoding -------------------------------------------------------------
//
// Decoding never slices the text: every value is a byte range [begin, end)
// of the original `string_view`, so spans stay plain offsets and error
// offsets are always absolute.

/// One `"key": value` member of an object (or one array element, with an
/// empty key): the unescaped key and the byte range of the raw value text.
struct member {
  std::string key;
  std::size_t begin = 0;
  std::size_t end = 0;
  member(std::string key, std::size_t begin, std::size_t end)
      : key(std::move(key)), begin(begin), end(end) {}
  member(member& other) = delete;
  member(member&& other) = default;
};

/// A cursor over the range [offset, limit) of a JSON text. Methods report
/// failures with the offset where they stopped.
struct scanner {
  std::string_view& text;
  std::size_t limit;
  std::size_t max_depth;
  mut { std::size_t offset; }
  scanner(std::string_view& text, std::size_t begin, std::size_t end, std::size_t max_depth)
      : text(text), limit(end), max_depth(max_depth), offset(begin) {}

  bool at_end() { return this.offset >= this.limit; }

  error fail(errc code, std::size_t offset) { return located(code, this.text, offset); }

  void skip_space() mut {
    while (!this.at_end() && is_space(this.text[this.offset])) {
      this.offset = this.offset + std::size_t(1);
    }
  }

  expected<char, error> peek() {
    if (this.at_end()) {
      return unexpected(this.fail(errc::unexpected_end, this.offset));
    }
    return this.text[this.offset];
  }

  expected<void, error> expect(char wanted) mut {
    char actual = ?this.peek();
    if (actual != wanted) {
      return unexpected(this.fail(errc::unexpected_character, this.offset));
    }
    this.offset = this.offset + std::size_t(1);
    return;
  }

  /// Four hexadecimal digits at the cursor as a code unit; -1 when a digit is
  /// invalid, -2 when the text ends first.
  int32_t read_hex_quad() mut {
    if (this.limit - this.offset < std::size_t(4)) {
      return -2;
    }
    mut int32_t value = 0;
    for (mut std::size_t index = 0; index < std::size_t(4); index++) {
      int32_t digit = hex_value(this.text[this.offset + index]);
      if (digit < 0) {
        return -1;
      }
      value = value * 16 + digit;
    }
    this.offset = this.offset + std::size_t(4);
    return value;
  }

  /// Scans a string literal at the cursor into `out`, validating UTF-8,
  /// rejecting raw control characters and decoding escapes.
  expected<void, error> read_string(mut std::string& out) mut {
    ?this.expect('"');
    while (true) {
      std::size_t start = this.offset;
      char value = ?this.peek();
      if (value == '"') {
        this.offset = this.offset + std::size_t(1);
        return;
      }
      if (uint8_t(value) < uint8_t(32)) {
        return unexpected(this.fail(errc::unexpected_character, start));
      }
      if (value != '\\') {
        std::size_t width = utf8_width(this.text, this.offset, this.limit);
        if (width == std::size_t(0)) {
          return unexpected(this.fail(errc::invalid_unicode, start));
        }
        for (mut std::size_t index = 0; index < width; index++) {
          out.push_back(this.text[this.offset + index]);
        }
        this.offset = this.offset + width;
        continue;
      }
      this.offset = this.offset + std::size_t(1);
      char escape = ?this.peek();
      this.offset = this.offset + std::size_t(1);
      if (escape == '"') {
        out.push_back('"');
      } else if (escape == '\\') {
        out.push_back('\\');
      } else if (escape == '/') {
        out.push_back('/');
      } else if (escape == 'n') {
        out.push_back('\n');
      } else if (escape == 't') {
        out.push_back('\t');
      } else if (escape == 'r') {
        out.push_back('\r');
      } else if (escape == 'b') {
        out.push_back(char(uint8_t(8)));
      } else if (escape == 'f') {
        out.push_back(char(uint8_t(12)));
      } else if (escape == 'u') {
        int32_t first = this.read_hex_quad();
        if (first == -2) {
          return unexpected(this.fail(errc::unexpected_end, this.offset));
        }
        if (first < 0) {
          return unexpected(this.fail(errc::invalid_escape, start));
        }
        mut int32_t point = first;
        if (first >= 55296 && first <= 56319) {
          // A high surrogate must be followed by an escaped low surrogate.
          if (this.limit - this.offset < std::size_t(2) || this.text[this.offset] != '\\' ||
              this.text[this.offset + std::size_t(1)] != 'u') {
            return unexpected(this.fail(errc::invalid_unicode, start));
          }
          this.offset = this.offset + std::size_t(2);
          int32_t second = this.read_hex_quad();
          if (second == -2) {
            return unexpected(this.fail(errc::unexpected_end, this.offset));
          }
          if (second < 56320 || second > 57343) {
            return unexpected(this.fail(errc::invalid_unicode, start));
          }
          point = 65536 + (first - 55296) * 1024 + (second - 56320);
        } else if (first >= 56320 && first <= 57343) {
          return unexpected(this.fail(errc::invalid_unicode, start));
        }
        append_code_point(out, point);
      } else {
        return unexpected(this.fail(errc::invalid_escape, start));
      }
    }
  }

  /// Skips a string literal without validating it: the characters it holds
  /// are checked when the value is decoded, so the failure carries the
  /// value's path.
  expected<void, error> skip_string(bool strict) mut {
    if (strict) {
      mut std::string discarded = std::string("");
      return this.read_string(discarded);
    }
    ?this.expect('"');
    while (true) {
      char value = ?this.peek();
      this.offset = this.offset + std::size_t(1);
      if (value == '"') {
        return;
      }
      if (value == '\\') {
        // Whatever follows a backslash belongs to the escape.
        if (this.at_end()) {
          return unexpected(this.fail(errc::unexpected_end, this.offset));
        }
        this.offset = this.offset + std::size_t(1);
      }
    }
  }

  /// Skips one complete value at the cursor following the JSON grammar
  /// (objects are `key: value` pairs, arrays are values, both comma
  /// separated), checking nesting as it goes and strings too when `strict`.
  /// Returns the byte range the value occupied, labelled with `key`.
  expected<member, error> skip_value(std::string key, std::size_t depth, bool strict) mut {
    this.skip_space();
    std::size_t begin = this.offset;
    ?this.skip_any(depth, strict);
    return member(std::move(key), begin, this.offset);
  }

  expected<void, error> skip_any(std::size_t depth, bool strict) mut {
    char head = ?this.peek();
    if (head == '"') {
      return this.skip_string(strict);
    }
    if (head == '{') {
      return this.skip_object(depth + std::size_t(1), strict);
    }
    if (head == '[') {
      return this.skip_array(depth + std::size_t(1), strict);
    }
    std::size_t begin = this.offset;
    while (!this.at_end()) {
      char value = this.text[this.offset];
      if (value == ',' || value == '}' || value == ']' || is_space(value)) {
        break;
      }
      this.offset = this.offset + std::size_t(1);
    }
    if (this.offset == begin) {
      return unexpected(this.fail(errc::unexpected_character, begin));
    }
    if (strict && !range_is(this.text, begin, this.offset, "true") &&
        !range_is(this.text, begin, this.offset, "false") &&
        !range_is(this.text, begin, this.offset, "null")) {
      mut bool integral = true;
      if (!valid_number(this.text, begin, this.offset, integral)) {
        return unexpected(this.fail(errc::invalid_number, begin));
      }
    }
    return;
  }

  expected<void, error> skip_object(std::size_t depth, bool strict) mut {
    if (depth > this.max_depth) {
      return unexpected(this.fail(errc::nesting_limit, this.offset));
    }
    ?this.expect('{');
    this.skip_space();
    if (?this.peek() == '}') {
      this.offset = this.offset + std::size_t(1);
      return;
    }
    while (true) {
      this.skip_space();
      ?this.skip_string(strict);
      this.skip_space();
      ?this.expect(':');
      this.skip_space();
      ?this.skip_any(depth, strict);
      this.skip_space();
      char next = ?this.peek();
      this.offset = this.offset + std::size_t(1);
      if (next == '}') {
        return;
      }
      if (next != ',') {
        return unexpected(this.fail(errc::unexpected_character, this.offset - std::size_t(1)));
      }
    }
  }

  expected<void, error> skip_array(std::size_t depth, bool strict) mut {
    if (depth > this.max_depth) {
      return unexpected(this.fail(errc::nesting_limit, this.offset));
    }
    ?this.expect('[');
    this.skip_space();
    if (?this.peek() == ']') {
      this.offset = this.offset + std::size_t(1);
      return;
    }
    while (true) {
      this.skip_space();
      ?this.skip_any(depth, strict);
      this.skip_space();
      char next = ?this.peek();
      this.offset = this.offset + std::size_t(1);
      if (next == ']') {
        return;
      }
      if (next != ',') {
        return unexpected(this.fail(errc::unexpected_character, this.offset - std::size_t(1)));
      }
    }
  }

  /// Requires the rest of the range to be blank.
  expected<void, error> finish() mut {
    this.skip_space();
    if (!this.at_end()) {
      return unexpected(this.fail(errc::trailing_characters, this.offset));
    }
    return;
  }
};

/// Splits an object's text into its members without interpreting values;
/// rejects repeated keys.
expected<std::vector<member>, error> parse_members(std::string_view text, std::size_t begin, std::size_t end, decode_options& options) {
  mut std::vector<member> members = std::vector<member>();
  mut scanner cursor{text, begin, end, options.max_depth};
  cursor.skip_space();
  ?cursor.expect('{');
  cursor.skip_space();
  if (?cursor.peek() == '}') {
    cursor.offset = cursor.offset + std::size_t(1);
    ?cursor.finish();
    return std::move(members);
  }
  while (true) {
    cursor.skip_space();
    std::size_t key_offset = cursor.offset;
    mut std::string key = std::string("");
    ?cursor.read_string(key);
    for (auto& earlier : members) {
      if (earlier.key.view() == key.view()) {
        return unexpected(cursor.fail(errc::duplicate_key, key_offset));
      }
    }
    cursor.skip_space();
    ?cursor.expect(':');
    member found = ?cursor.skip_value(std::move(key), std::size_t(1), false);
    members.push_back(std::move(found));
    cursor.skip_space();
    char next = ?cursor.peek();
    cursor.offset = cursor.offset + std::size_t(1);
    if (next == '}') {
      break;
    }
    if (next != ',') {
      return unexpected(cursor.fail(errc::unexpected_character, cursor.offset - std::size_t(1)));
    }
  }
  ?cursor.finish();
  return std::move(members);
}

/// Splits an array's text into the byte ranges of its elements.
expected<std::vector<member>, error> parse_elements(std::string_view text, std::size_t begin, std::size_t end, decode_options& options) {
  mut std::vector<member> elements = std::vector<member>();
  mut scanner cursor{text, begin, end, options.max_depth};
  cursor.skip_space();
  ?cursor.expect('[');
  cursor.skip_space();
  if (?cursor.peek() == ']') {
    cursor.offset = cursor.offset + std::size_t(1);
    ?cursor.finish();
    return std::move(elements);
  }
  while (true) {
    member found = ?cursor.skip_value(std::string(""), std::size_t(1), false);
    elements.push_back(std::move(found));
    cursor.skip_space();
    char next = ?cursor.peek();
    cursor.offset = cursor.offset + std::size_t(1);
    if (next == ']') {
      break;
    }
    if (next != ',') {
      return unexpected(cursor.fail(errc::unexpected_character, cursor.offset - std::size_t(1)));
    }
  }
  ?cursor.finish();
  return std::move(elements);
}

/// True when the range holds exactly `literal`.
bool range_is(std::string_view text, std::size_t begin, std::size_t end, std::string_view literal) {
  if (end - begin != literal.size()) {
    return false;
  }
  for (mut std::size_t index = 0; index < literal.size(); index++) {
    if (text[begin + index] != literal[index]) {
      return false;
    }
  }
  return true;
}

/// Trims surrounding blanks from a value range in place.
void trim(std::string_view text, mut std::size_t& begin, mut std::size_t& end) {
  while (begin < end && is_space(text[begin])) {
    begin = begin + std::size_t(1);
  }
  while (end > begin && is_space(text[end - std::size_t(1)])) {
    end = end - std::size_t(1);
  }
}

/// Whether the range is a JSON number lexeme; `integral` tells whether it
/// has neither fraction nor exponent.
bool valid_number(std::string_view text, std::size_t begin, std::size_t end, mut bool& integral) {
  integral = true;
  mut std::size_t offset = begin;
  if (offset >= end) {
    return false;
  }
  if (text[offset] == '-') {
    offset = offset + std::size_t(1);
    if (offset >= end) {
      return false;
    }
  }
  if (text[offset] == '0') {
    offset = offset + std::size_t(1);
    if (offset < end && is_digit(text[offset])) {
      return false;
    }
  } else {
    if (uint8_t(text[offset]) < uint8_t('1') || uint8_t(text[offset]) > uint8_t('9')) {
      return false;
    }
    while (offset < end && is_digit(text[offset])) {
      offset = offset + std::size_t(1);
    }
  }
  if (offset < end && text[offset] == '.') {
    integral = false;
    offset = offset + std::size_t(1);
    if (offset >= end || !is_digit(text[offset])) {
      return false;
    }
    while (offset < end && is_digit(text[offset])) {
      offset = offset + std::size_t(1);
    }
  }
  if (offset < end && (text[offset] == 'e' || text[offset] == 'E')) {
    integral = false;
    offset = offset + std::size_t(1);
    if (offset < end && (text[offset] == '+' || text[offset] == '-')) {
      offset = offset + std::size_t(1);
    }
    if (offset >= end || !is_digit(text[offset])) {
      return false;
    }
    while (offset < end && is_digit(text[offset])) {
      offset = offset + std::size_t(1);
    }
  }
  return offset == end;
}

/// The digits of an integer lexeme as a magnitude; `negative` reports a
/// leading minus. Fails with number_out_of_range past 64 bits.
expected<uint64_t, error> parse_magnitude(std::string_view text, std::size_t begin, std::size_t end, mut bool& negative) {
  mut std::size_t offset = begin;
  negative = false;
  if (offset < end && text[offset] == '-') {
    negative = true;
    offset = offset + std::size_t(1);
  }
  mut uint64_t value = 0;
  while (offset < end) {
    uint64_t digit = uint64_t(uint8_t(text[offset]) - uint8_t('0'));
    if (value > (uint64_t(18446744073709551615) - digit) / uint64_t(10)) {
      return unexpected(located(errc::number_out_of_range, text, begin));
    }
    value = value * uint64_t(10) + digit;
    offset = offset + std::size_t(1);
  }
  return value;
}

/// The widest signed and unsigned values a fixed-width integer type holds.
constexpr uint64_t unsigned_limit<F>() {
  if constexpr (std::meta::name_of<F>() == "uint8_t") {
    return uint64_t(255);
  } else if constexpr (std::meta::name_of<F>() == "uint16_t") {
    return uint64_t(65535);
  } else if constexpr (std::meta::name_of<F>() == "uint32_t") {
    return uint64_t(4294967295);
  } else {
    return uint64_t(18446744073709551615);
  }
}

constexpr int64_t signed_limit<F>() {
  if constexpr (std::meta::name_of<F>() == "int8_t") {
    return int64_t(127);
  } else if constexpr (std::meta::name_of<F>() == "int16_t") {
    return int64_t(32767);
  } else if constexpr (std::meta::name_of<F>() == "int32_t" || std::meta::name_of<F>() == "int") {
    return int64_t(2147483647);
  } else {
    return int64_t(9223372036854775807);
  }
}

expected<F, error> decode_unsigned<F>(std::string_view text, std::size_t begin, std::size_t end) {
  if constexpr (std::meta::is_integral<F>()) {
    mut bool integral = true;
    if (!valid_number(text, begin, end, integral)) {
      return unexpected(located(errc::invalid_number, text, begin));
    }
    if (!integral) {
      return unexpected(located(errc::type_mismatch, text, begin));
    }
    mut bool negative = false;
    uint64_t magnitude = ?parse_magnitude(text, begin, end, negative);
    if (negative && magnitude > uint64_t(0)) {
      return unexpected(located(errc::number_out_of_range, text, begin));
    }
    if (magnitude > unsigned_limit<F>()) {
      return unexpected(located(errc::number_out_of_range, text, begin));
    }
    return F(magnitude);
  } else {
    static_assert(false, "std::json: not an integral type");
  }
}

expected<F, error> decode_signed<F>(std::string_view text, std::size_t begin, std::size_t end) {
  if constexpr (std::meta::is_signed_integral<F>()) {
    mut bool integral = true;
    if (!valid_number(text, begin, end, integral)) {
      return unexpected(located(errc::invalid_number, text, begin));
    }
    if (!integral) {
      return unexpected(located(errc::type_mismatch, text, begin));
    }
    mut bool negative = false;
    uint64_t magnitude = ?parse_magnitude(text, begin, end, negative);
    uint64_t limit = uint64_t(signed_limit<F>());
    if (negative) {
      if (magnitude > limit + uint64_t(1)) {
        return unexpected(located(errc::number_out_of_range, text, begin));
      }
      if (magnitude == limit + uint64_t(1)) {
        // The most negative value: build it without a positive overflow.
        return F(int64_t(0) - int64_t(limit) - int64_t(1));
      }
      return F(int64_t(0) - int64_t(magnitude));
    }
    if (magnitude > limit) {
      return unexpected(located(errc::number_out_of_range, text, begin));
    }
    return F(int64_t(magnitude));
  } else {
    static_assert(false, "std::json: not a signed integral type");
  }
}

expected<F, error> decode_floating<F>(std::string_view text, std::size_t begin, std::size_t end) {
  if constexpr (std::meta::is_floating_point<F>()) {
    mut bool integral = true;
    if (!valid_number(text, begin, end, integral)) {
      return unexpected(located(errc::invalid_number, text, begin));
    }
    mut std::string lexeme = std::string("");
    for (mut std::size_t index = begin; index < end; index++) {
      lexeme.push_back(text[index]);
    }
    mut F value = F(0);
    std::from_chars_result parsed = std::from_chars(lexeme.view(), value);
    if (parsed.ec == std::parse_errc::result_out_of_range) {
      return unexpected(located(errc::number_out_of_range, text, begin));
    }
    if (parsed.ec != std::parse_errc::none || parsed.position != lexeme.size()) {
      return unexpected(located(errc::invalid_number, text, begin));
    }
    return value;
  } else {
    static_assert(false, "std::json: not a floating-point type");
  }
}

expected<E, error> decode_enum<E>(std::string_view text, std::size_t begin, std::size_t end, decode_options& options) {
  mut scanner cursor{text, begin, end, options.max_depth};
  mut std::string spelling = std::string("");
  ?cursor.read_string(spelling);
  ?cursor.finish();
  constexpr for (auto enumerator : std::meta::enumerators_of<E>()) {
    if (spelling.view() == enumerator.name()) {
      return enumerator.value();
    }
  }
  return unexpected(located(errc::invalid_enumerator, text, begin));
}

/// Decodes a value of the type a `type` metaobject names; used for the
/// argument of a generic container.
expected<E, error> decode_as<E>(std::meta::type<E> element, std::string_view text, std::size_t begin, std::size_t end, decode_options& options) {
  return decode_value<E>(text, begin, end, options);
}

/// Decodes array element `index`, prefixing a failure's path with the index.
expected<E, error> decode_element<E>(std::meta::type<E> element, std::string_view text, std::size_t begin, std::size_t end, decode_options& options, std::size_t index) {
  mut auto value = decode_value<E>(text, begin, end, options);
  if (!value) {
    mut error failure = std::move(value).error();
    failure.prepend_index(index);
    return unexpected(std::move(failure));
  }
  return std::move(value);
}

/// Decodes object member `key`, prefixing a failure's path with the key.
expected<E, error> decode_member<E>(std::meta::type<E> element, std::string_view text, std::size_t begin, std::size_t end, decode_options& options, std::string_view key) {
  mut auto value = decode_value<E>(text, begin, end, options);
  if (!value) {
    mut error failure = std::move(value).error();
    failure.prepend_key(key);
    return unexpected(std::move(failure));
  }
  return std::move(value);
}

/// Decodes through a `codec` specialization: the value's own text is copied
/// so the codec sees exactly it, and its offsets are rebased to the input.
expected<F, error> decode_with_codec<F>(std::string_view text, std::size_t begin, std::size_t end) {
  if constexpr (has_codec<F>()) {
    mut std::string span = std::string("");
    for (mut std::size_t index = begin; index < end; index++) {
      span.push_back(text[index]);
    }
    codec<F> mapping{};
    mut auto decoded = mapping.decode(span.view());
    if (!decoded) {
      mut error failure = std::move(decoded).error();
      mut std::size_t line = 0;
      mut std::size_t column = 0;
      locate(text, begin + failure.offset, line, column);
      mut error rebased = error(failure.code, begin + failure.offset, line, column);
      rebased.path = std::move(failure.path);
      return unexpected(std::move(rebased));
    }
    return std::move(decoded);
  } else {
    static_assert(false, "std::json: no codec specialization for this type");
  }
}

/// The value of `F` that the text range denotes.
expected<F, error> decode_value<F>(std::string_view text, std::size_t begin, std::size_t end, decode_options& options) {
  mut std::size_t start = begin;
  mut std::size_t stop = end;
  trim(text, start, stop);
  if constexpr (has_codec<F>()) {
    return decode_with_codec<F>(text, start, stop);
  } else if constexpr (std::meta::is_bool<F>()) {
    if (range_is(text, start, stop, "true")) {
      return true;
    }
    if (range_is(text, start, stop, "false")) {
      return false;
    }
    return unexpected(located(errc::type_mismatch, text, start));
  } else if constexpr (std::meta::is_signed_integral<F>()) {
    return decode_signed<F>(text, start, stop);
  } else if constexpr (std::meta::is_integral<F>()) {
    return decode_unsigned<F>(text, start, stop);
  } else if constexpr (std::meta::is_floating_point<F>()) {
    return decode_floating<F>(text, start, stop);
  } else if constexpr (is_owned_string<F>()) {
    mut scanner cursor{text, start, stop, options.max_depth};
    mut std::string out = std::string("");
    ?cursor.read_string(out);
    ?cursor.finish();
    return std::move(out);
  } else if constexpr (std::meta::is_enum<F>()) {
    return decode_enum<F>(text, start, stop, options);
  } else if constexpr (is_optional<F>()) {
    if (range_is(text, start, stop, "null")) {
      return F();
    }
    auto inner = ?decode_as(std::meta::list_first<std::meta::argument_list<F>>(), text, start, stop, options);
    // An open type parameter cannot be constructed from an argument, so fill
    // the empty optional in place instead.
    mut F out = F();
    out.emplace(std::move(inner));
    return std::move(out);
  } else if constexpr (is_vector<F>()) {
    mut F out = F();
    std::vector<member> elements = ?parse_elements(text, start, stop, options);
    mut std::size_t index = 0;
    for (auto& element : elements) {
      auto value = ?decode_element(std::meta::list_first<std::meta::argument_list<F>>(), text, element.begin, element.end, options, index);
      out.push_back(std::move(value));
      index = index + std::size_t(1);
    }
    return std::move(out);
  } else if constexpr (is_string_map<F>()) {
    mut F out = F();
    std::vector<member> members = ?parse_members(text, start, stop, options);
    for (auto& entry : members) {
      auto value = ?decode_member(std::meta::list_first<std::meta::list_rest<std::meta::argument_list<F>>>(), text, entry.begin, entry.end, options, entry.key.view());
      out.insert(std::string(entry.key.view()), std::move(value));
    }
    return std::move(out);
  } else if constexpr (std::meta::is_reflectable<F>()) {
    return decode_object<F>(text, start, stop, options);
  } else {
    static_assert(false, "std::json cannot decode this type");
  }
}

/// The value an `[[ignore]]`d or absent optional field takes on decoding:
/// its type's default construction, which the type must therefore support.
expected<F, error> default_value<F>() requires std::default_initializable<F> {
  return F();
}

/// Produces each field of `T` from the members of one object.
struct object_producer<T> {
  std::string_view& text;
  std::size_t begin;
  std::vector<member>& members;
  // Text is a checked reference: the cursor cannot outlive either the caller's
  // view binding or its character owner. The decoded-member index is borrowed
  // from decode_object for the same bounded construction. Neither input is
  // copied or allocated again. Limits remain a small value snapshot.
  decode_options options;
  object_producer(std::string_view& text, std::size_t begin, std::vector<member>& members, decode_options& limits)
      : text(text), begin(begin), members(members),
        options(decode_options(limits.max_depth, limits.max_document_bytes, limits.missing_members_defaulted)) {}
  object_producer(object_producer<T>& other) = delete;

  expected<std::meta::field_type<T, I>, error> produce<uint64_t I>(std::meta::field<T, I> field) mut {
    if constexpr (std::meta::field<T, I>().has_attribute<ignore>()) {
      // Never in the text: the declared default when there is one.
      if constexpr (std::meta::field<T, I>().has_default()) {
        auto declared = std::meta::field<T, I>().default_value();
        return std::move(declared);
      } else {
        return default_value<std::meta::field_type<T, I>>();
      }
    }
    std::string_view key = key_of(field);
    for (auto& candidate : this.members) {
      if (candidate.key.view() == key) {
        mut auto value = decode_value<std::meta::field_type<T, I>>(this.text, candidate.begin, candidate.end, this.options);
        if (!value) {
          mut error failure = std::move(value).error();
          failure.prepend_key(key);
          return unexpected(std::move(failure));
        }
        return std::move(value);
      }
    }
    // Absent: an optional is empty; a `[[defaulted]]` field (or every field
    // with a default, under the option) takes its declared initializer.
    if constexpr (is_optional<std::meta::field_type<T, I>>()) {
      return default_value<std::meta::field_type<T, I>>();
    } else if constexpr (std::meta::field<T, I>().has_attribute<defaulted>()) {
      static_assert(std::meta::field<T, I>().has_default(), "a [[std::json::defaulted]] field must declare a default initializer");
      auto declared = std::meta::field<T, I>().default_value();
      return std::move(declared);
    } else if constexpr (std::meta::field<T, I>().has_default()) {
      if (this.options.missing_members_defaulted) {
        auto declared = std::meta::field<T, I>().default_value();
        return std::move(declared);
      }
    }
    mut error missing = located(errc::missing_field, this.text, this.begin);
    missing.prepend_key(key);
    return unexpected(std::move(missing));
  }
};

/// Checks the text of a member that names no field: it is never decoded, so
/// its strings are validated here, with the key as the failure's path.
expected<void, error> validate_member(std::string_view text, member& entry, decode_options& options) {
  mut scanner cursor{text, entry.begin, entry.end, options.max_depth};
  mut auto checked = cursor.skip_value(std::string(""), std::size_t(1), true);
  if (!checked) {
    mut error failure = std::move(checked).error();
    failure.prepend_key(entry.key.view());
    return unexpected(std::move(failure));
  }
  return;
}

expected<T, error> decode_object<T>(std::string_view text, std::size_t begin, std::size_t end, decode_options& options) {
  std::vector<member> members = ?parse_members(text, begin, end, options);
  for (auto& entry : members) {
    mut bool known = false;
    constexpr for (auto field : std::meta::fields_of<T>()) {
      if constexpr (!field.has_attribute<ignore>()) {
        if (entry.key.view() == key_of(field)) {
          known = true;
        }
      }
    }
    if (!known) {
      ?validate_member(text, entry, options);
    }
  }
  mut object_producer<T> producer{text, begin, members, options};
  mut auto built = std::meta::construct<T, error, object_producer<T>>(producer);
  return std::move(built);
}

}

/// The compact JSON text of `value`. Structs become objects with one member
/// per field that is not `[[ignore]]`d, keyed by `[[name]]` or the declared
/// name; see the file comment for every supported type. Fails only for
/// invalid UTF-8 text and non-finite floating values.
expected<std::string, error> encode<T>(T& value) {
  mut std::string out = std::string("");
  mut detail::layout style{};
  ?detail::encode_value(out, value, style, std::size_t(0));
  return std::move(out);
}

/// Like `encode`, with newlines and `indentation` spaces per nesting level.
expected<std::string, error> encode_pretty<T>(T& value, uint8_t indentation = 2) {
  mut std::string out = std::string("");
  mut detail::layout style = {.pretty = true, .indentation = indentation};
  ?detail::encode_value(out, value, style, std::size_t(0));
  return std::move(out);
}

/// The `T` that the JSON text denotes. Structs are built field by field
/// through `std::meta::construct`; every non-ignored, non-optional field must
/// be present.
expected<T, error> decode<T>(std::string_view text, decode_options& options) {
  if (text.size() > options.max_document_bytes) {
    return unexpected(detail::located(errc::document_too_large, text, std::size_t(0)));
  }
  mut detail::scanner cursor{text, std::size_t(0), text.size(), options.max_depth};
  detail::member root = ?cursor.skip_value(std::string(""), std::size_t(0), false);
  ?cursor.finish();
  return detail::decode_value<T>(text, root.begin, root.end, options);
}

expected<T, error> decode<T>(std::string_view text) {
  mut decode_options options{};
  return decode<T>(text, options);
}

/// The `T` encoded in the file at `path`; `io_failure` when it cannot be
/// opened or read, otherwise the decoding result.
expected<T, error> read_file<T>(std::string_view path, decode_options& options) {
  mut auto opened = std::fopen(path, std::file_mode::read);
  if (!opened) {
    return unexpected(error(errc::io_failure, std::size_t(0), std::size_t(0), std::size_t(0)));
  }
  mut auto file = std::move(opened).value();
  mut std::string text = std::string("");
  while (true) {
    mut auto chunk = std::fread(*file, std::size_t(4096));
    if (!chunk) {
      return unexpected(error(errc::io_failure, std::size_t(0), std::size_t(0), std::size_t(0)));
    }
    if (chunk.value().size() == std::size_t(0)) {
      break;
    }
    text.append(chunk.value().view());
    if (text.size() > options.max_document_bytes) {
      return unexpected(detail::located(errc::document_too_large, text.view(), std::size_t(0)));
    }
  }
  return decode<T>(text.view(), options);
}

expected<T, error> read_file<T>(std::string_view path) {
  mut decode_options options{};
  return read_file<T>(path, options);
}

/// Writes `text` to `path`, replacing any existing file.
expected<void, error> write_text(std::string_view path, std::string_view text) {
  mut auto opened = std::fopen(path, std::file_mode::write);
  if (!opened) {
    return unexpected(error(errc::io_failure, std::size_t(0), std::size_t(0), std::size_t(0)));
  }
  mut auto file = std::move(opened).value();
  mut auto written = std::fwrite(text, *file);
  if (!written) {
    return unexpected(error(errc::io_failure, std::size_t(0), std::size_t(0), std::size_t(0)));
  }
  mut auto closed = std::fclose(*file);
  if (!closed) {
    return unexpected(error(errc::io_failure, std::size_t(0), std::size_t(0), std::size_t(0)));
  }
  return;
}

/// Encodes `value` compactly into the file at `path`.
expected<void, error> write_file<T>(std::string_view path, T& value) {
  std::string text = ?encode(value);
  return write_text(path, text.view());
}

/// Encodes `value` with newlines and indentation into the file at `path`,
/// ending with a newline.
expected<void, error> write_file_pretty<T>(std::string_view path, T& value, uint8_t indentation = 2) {
  mut std::string text = ?encode_pretty(value, indentation);
  text.push_back('\n');
  return write_text(path, text.view());
}

}
}
