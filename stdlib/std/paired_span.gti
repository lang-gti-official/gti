#include <std/span>
#include <std/memory>
#include <std/detail/iterator>

namespace std {
namespace detail {
class paired_span_sentinel {
  size_t finish;
public:
  paired_span_sentinel(size_t finish) : finish(finish) {}
  size_t position() { return this.finish; }
};

/// Read-only paired access without copying either underlying element.
/// A reference to this proxy borrows its cursor; advancing the cursor while
/// that reference is live is excluded by the ordinary child-loan rules.
class paired_span_element<std::storage_element L, std::storage_element R> {
  paired_span<L, R>& source;
  mut size_t current_position;
public:
  paired_span_element(paired_span<L, R>& source, size_t position)
      : source(source), current_position(position) {
    if (position > this.size()) { gti_internal::index_bounds_check(position, this.size()); }
  }
  size_t size() {
    return this.source.size();
  }
  size_t position() { return this.current_position; }
  L& first() {
    return this.source.first(this.current_position);
  }
  R& second() {
    return this.source.second(this.current_position);
  }
  paired_span_element<L, R> at(size_t position) {
    gti_internal::index_bounds_check(position, this.size());
    return paired_span_element<L, R>(this.source, position);
  }
  // Every observation remains checked by the source view. Cursors establish
  // their inclusive base-position bounds before changing this coordinate.
  void select(size_t position) mut { this.current_position = position; }
};

class paired_span_iterator<std::storage_element L, std::storage_element R, uint64_t Reverse = 0> {
  mut paired_span_element<L, R> element;
  mut size_t current_position;

  void advance(ptrdiff_t offset, bool subtract = false) mut {
    size_t position = detail::checked_iterator_position(this.current_position,
        size_t(0), this.element.size(), offset, subtract != (Reverse != 0));
    mut size_t selected = position;
    if constexpr (Reverse != 0) {
      if (position != size_t(0)) { selected = position - size_t(1); }
    }
    this.element.select(selected);
    this.current_position = position;
  }

  void advance_one<uint64_t Decrement = 0>() mut {
    size_t position = detail::checked_iterator_step<Reverse, Decrement>(
        this.current_position, size_t(0), this.element.size());
    mut size_t selected = position;
    if constexpr (Reverse != 0) {
      if (position != size_t(0)) { selected = position - size_t(1); }
    }
    this.element.select(selected);
    this.current_position = position;
  }
public:
  paired_span_iterator(paired_span<L, R>& source, size_t position)
      : element(paired_span_element<L, R>(source, position)), current_position(position) {
    if constexpr (Reverse != 0) {
      if (position != size_t(0)) { this.element.select(position - size_t(1)); }
    }
  }
  paired_span_element<L, R>& operator*() {
    if constexpr (Reverse != 0) {
      size_t position = detail::checked_iterator_position(this.current_position,
          size_t(0), this.element.size(), ptrdiff_t(-1));
      gti_internal::index_bounds_check(position, this.element.size());
    } else {
      gti_internal::index_bounds_check(this.current_position, this.element.size());
    }
    return this.element;
  }
  paired_span_element<L, R>& operator->() { return *this; }
  // An indexed proxy owns only checked borrowing state. It does not change
  // the cursor's cached coordinate or copy either underlying element.
  paired_span_element<L, R> operator[](ptrdiff_t offset) {
    mut size_t position = detail::checked_iterator_position(this.current_position,
        size_t(0), this.element.size(), offset, Reverse != 0);
    if constexpr (Reverse != 0) {
      position = detail::checked_iterator_position(position,
          size_t(0), this.element.size(), ptrdiff_t(-1));
    }
    return this.element.at(position);
  }
  void operator++() mut { this.advance_one<>(); }
  void operator--() mut { this.advance_one<1>(); }
  void operator+=(ptrdiff_t offset) mut { this.advance(offset); }
  void operator-=(ptrdiff_t offset) mut { this.advance(offset, true); }
  ptrdiff_t operator-(paired_span_sentinel sentinel) {
    if constexpr (Reverse != 0) { return detail::checked_iterator_difference(sentinel.position(), this.current_position); }
    return detail::checked_iterator_difference(this.current_position, sentinel.position());
  }
  ptrdiff_t operator-(paired_span_iterator<L, R, Reverse>& other) {
    if constexpr (Reverse != 0) { return detail::checked_iterator_difference(other.current_position, this.current_position); }
    return detail::checked_iterator_difference(this.current_position, other.current_position);
  }
  bool operator!=(paired_span_sentinel sentinel) {
    return this.current_position != sentinel.position();
  }
  bool operator!=(paired_span_iterator<L, R, Reverse>& other) {
    return this.current_position != other.current_position;
  }
  bool operator==(paired_span_sentinel sentinel) {
    return this.current_position == sentinel.position();
  }
  bool operator==(paired_span_iterator<L, R, Reverse>& other) {
    return this.current_position == other.current_position;
  }
};
}

/// A read-only indexed view over two independently owned contiguous buffers.
/// Its length is the shorter input length. Both owners remain borrowed until
/// the last use of this view and every copy derived from it.
class paired_span<std::storage_element L, std::storage_element R> {
  span<L> left_view;
  span<R> right_view;

public:
  using const_iterator = detail::paired_span_iterator<L, R>;
  using const_reverse_iterator = detail::paired_span_iterator<L, R, 1>;
  using sentinel = detail::paired_span_sentinel;
  using value_type = detail::paired_span_element<L, R>;
  paired_span(span<L> left, span<R> right)
      : left_view(std::move(left)), right_view(std::move(right)) {}

  size_t size() {
    size_t left_size = this.left_view.size();
    size_t right_size = this.right_view.size();
    return left_size < right_size ? left_size : right_size;
  }

  bool empty() {
    return this.size() == 0;
  }

  detail::paired_span_iterator<L, R> begin() {
    return detail::paired_span_iterator<L, R>(this, size_t(0));
  }
  detail::paired_span_sentinel end() { return detail::paired_span_sentinel(this.size()); }
  detail::paired_span_iterator<L, R> end_iterator() {
    return detail::paired_span_iterator<L, R>(this, this.size());
  }
  detail::paired_span_iterator<L, R> cbegin() { return this.begin(); }
  detail::paired_span_sentinel cend() { return this.end(); }
  const_reverse_iterator rbegin() { return const_reverse_iterator(this, this.size()); }
  detail::paired_span_sentinel rend() { return detail::paired_span_sentinel(size_t(0)); }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  detail::paired_span_sentinel crend() { return this.rend(); }

  L& first(size_t index) {
    gti_internal::index_bounds_check(index, this.size());
    return this.left_view[index];
  }

  R& second(size_t index) {
    gti_internal::index_bounds_check(index, this.size());
    return this.right_view[index];
  }

  paired_span<L, R> subspan(size_t offset, size_t count) {
    size_t length = this.size();
    if (offset > length) {
      gti_internal::index_bounds_check(offset, length);
    }
    size_t remaining = length - offset;
    if (count > remaining) {
      gti_internal::index_bounds_check(count, remaining);
    }
    return paired_span<L, R>(this.left_view.subspan(offset, count),
                              this.right_view.subspan(offset, count));
  }
};
}
