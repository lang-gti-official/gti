// C++-familiar API scaffold for <std/iterator>.
// Iterator behavior remains structural in GTI; these names are ordinary
// library vocabulary rather than compiler-recognized category tags.

namespace gti_internal {
@compiler_constraint("input_iterator") concept input_iterator_capability<I>;
@compiler_constraint("sentinel_for") concept sentinel_for_capability<S, I>;
@compiler_constraint("dereferences_to") concept dereferences_to_capability<I, T>;
@compiler_constraint("writable_iterator") concept writable_iterator_capability<I>;
@compiler_constraint("writes_to") concept writes_to_capability<I, T>;
@compiler_constraint("bidirectional_iterator") concept bidirectional_iterator_capability<I>;
@compiler_constraint("random_access_iterator") concept random_access_iterator_capability<I>;
@compiler_constraint("subscripts_to_mut") concept subscripts_to_mut_capability<I, T>;
@compiler_constraint("sized_sentinel_for") concept sized_sentinel_for_capability<S, I>;
@compiler_constraint("input_range") concept input_range_capability<R>;
@compiler_constraint("range_of") concept range_of_capability<R, T>;
@compiler_constraint("mutable_range_of") concept mutable_range_of_capability<R, T>;
@compiler_constraint("sized_range") concept sized_range_capability<R>;
}

namespace std {
concept input_iterator<I> = gti_internal::input_iterator_capability<I>;
concept sentinel_for<Sentinel, Iterator> =
    gti_internal::sentinel_for_capability<Sentinel, Iterator>;
concept dereferences_to<Iterator, T> =
    gti_internal::dereferences_to_capability<Iterator, T>;
concept forward_iterator<Iterator> =
    std::input_iterator<Iterator> &&
    std::copy_constructible<Iterator> &&
    std::sentinel_for<Iterator, Iterator>;

// A writable position: mut dereference yields a mutable element reference and
// prefix increment advances the position. `writes_to` is the exact-element
// refinement, mirroring how `dereferences_to` refines `input_iterator`.
concept output_iterator<Iterator> =
    gti_internal::writable_iterator_capability<Iterator>;
concept writes_to<Iterator, T> =
    gti_internal::writes_to_capability<Iterator, T>;

// Movement categories compose over the input contract the same way the
// C++-familiar hierarchy does, but each level is an exact structural
// capability rather than a tag: bidirectional adds `void operator--() mut`,
// and random access adds `void operator+=(std::ptrdiff_t) mut` plus
// `void operator-=(std::ptrdiff_t) mut`.
concept bidirectional_iterator<Iterator> =
    std::forward_iterator<Iterator> &&
    gti_internal::bidirectional_iterator_capability<Iterator>;
concept random_access_iterator<Iterator> =
    std::bidirectional_iterator<Iterator> &&
    gti_internal::random_access_iterator_capability<Iterator>;

// Positioned mutable access without moving the cursor: a mut iterator whose
// `mut operator[](std::ptrdiff_t)` returns a mutable reference to exactly T.
// One exclusive cursor plus offsets reaches every element of its range, which
// is how in-place algorithms keep a single mutable borrow of the owner.
concept subscripts_to_mut<Iterator, T> =
    gti_internal::subscripts_to_mut_capability<Iterator, T>;

// A sentinel whose distance is known without walking: the iterator provides
// read-only `std::ptrdiff_t operator-(Sentinel&)` returning the signed
// number of increments from the iterator to the sentinel.
concept sized_sentinel_for<Sentinel, Iterator> =
    std::sentinel_for<Sentinel, Iterator> &&
    gti_internal::sized_sentinel_for_capability<Sentinel, Iterator>;

// Complete-range concepts derive the private iterator and sentinel selected by
// a range's exact begin/end protocol. They intentionally expose no associated
// iterator type: range-first generic code iterates the owner directly, and
// concrete reanalysis retains the selected source declarations.
concept input_range<Range> =
    gti_internal::input_range_capability<Range>;
concept range_of<Range, T> =
    std::input_range<Range> &&
    gti_internal::range_of_capability<Range, T>;
concept mutable_range_of<Range, T> =
    std::range_of<Range, T> &&
    gti_internal::mutable_range_of_capability<Range, T>;
concept sized_range<Range> =
    std::input_range<Range> &&
    gti_internal::sized_range_capability<Range>;

struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : public input_iterator_tag {};
struct bidirectional_iterator_tag : public forward_iterator_tag {};
struct random_access_iterator_tag : public bidirectional_iterator_tag {};
struct contiguous_iterator_tag : public random_access_iterator_tag {};

// Forward-only utilities take an unsigned distance; the signed overload
// requires bidirectional movement so a negative distance always has an exact
// meaning. Movement steps rather than jumping so the reference receiver only
// needs the increment/decrement contract.
void advance<Iterator>(mut Iterator& iterator, mut ptrdiff_t distance)
  requires std::bidirectional_iterator<Iterator> {
  while (distance > 0) {
    ++iterator;
    distance--;
  }
  while (distance < 0) {
    --iterator;
    distance++;
  }
}

void advance<Iterator>(mut Iterator& iterator, mut size_t distance)
  requires std::input_iterator<Iterator> {
  while (distance > 0) {
    ++iterator;
    distance--;
  }
}

ptrdiff_t distance<Iterator, Sentinel>(mut Iterator first, Sentinel last)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  mut ptrdiff_t result = 0;
  while (first != last) {
    ++first;
    result++;
  }
  return result;
}

Iterator next<Iterator>(mut Iterator iterator)
  requires std::input_iterator<Iterator> {
  ++iterator;
  return std::move(iterator);
}

Iterator next<Iterator>(mut Iterator iterator, ptrdiff_t distance)
  requires std::random_access_iterator<Iterator> {
  iterator += distance;
  return std::move(iterator);
}

Iterator next<Iterator>(mut Iterator iterator, mut size_t distance)
  requires std::input_iterator<Iterator> {
  while (distance > 0) {
    ++iterator;
    distance--;
  }
  return std::move(iterator);
}

Iterator prev<Iterator>(mut Iterator iterator)
  requires std::bidirectional_iterator<Iterator> {
  --iterator;
  return std::move(iterator);
}

Iterator prev<Iterator>(mut Iterator iterator, mut size_t distance)
  requires std::bidirectional_iterator<Iterator> {
  while (distance > 0) {
    --iterator;
    distance--;
  }
  return std::move(iterator);
}

}
