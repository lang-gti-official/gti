// C++-familiar iterator and range vocabulary for <std/iterator>.
// Iterator behavior remains structural in GTI; these names are ordinary
// library vocabulary rather than compiler-recognized category tags.

#include <std/meta>

namespace std {
namespace detail {
// Declaration metadata supplies the result type; an ordinary expression query
// separately validates access, overload selection, and the checked origin.
constexpr bool readable_dereference_result<I, R>(std::meta::type<I> owner,
                                                 std::meta::type<R> result) {
  if constexpr (std::meta::type<R>().is_reference()) {
    return requires(I& cursor) { { *cursor } -> R [[borrowed_from(cursor)]]; };
  } else {
    // Legacy text handles can retain expression-specific owner dependencies.
    return !std::meta::type<R>().is_void() && std::meta::is_copyable<R>() &&
           std::meta::is_borrow_free<R>() &&
           !std::meta::is_same<R, std::string_view>() &&
           !std::meta::is_same<R, c_string>() &&
           (requires(I& cursor) { { *cursor } -> R; });
  }
}
constexpr bool dereference_declaration<I, T, uint64_t Typed>() {
  if constexpr (std::meta::is_class<I>() || std::meta::is_struct<I>() ||
                std::meta::type<I>().is_interface() || std::meta::type<I>().is_union()) {
    mut bool found = false;
    constexpr for (auto member : std::meta::lookup_operators_of<I>()) {
      if constexpr (member.name() == "operator*" && member.is_public() &&
                    !member.is_static() && !member.is_mutating() &&
                    !member.is_consuming() && !member.is_unsafe() &&
                    !member.is_generic() && !member.is_constrained() &&
                    member.parameter_count() == uint64_t(0)) {
        if constexpr (Typed == uint64_t(0)) {
          found = readable_dereference_result(std::meta::type<I>(), member.result());
        } else {
          if constexpr (!std::meta::type<T>().is_void() &&
                        !std::meta::type<T>().is_reference()) {
            if constexpr (member.result().is_same<T>() || member.result().is_same<T&>()) {
              found = readable_dereference_result(std::meta::type<I>(), member.result());
            }
          }
        }
      }
    }
    return found;
  } else { return false; }
}
constexpr bool readable_dereference_declaration<I>() {
  return dereference_declaration<I, void, 0>();
}
constexpr bool exact_dereference_declaration<I, T>() {
  return dereference_declaration<I, T, 1>();
}
constexpr bool sentinel_declaration<I, S, uint64_t Distance>() {
  if constexpr (std::meta::is_class<I>() || std::meta::is_struct<I>() ||
                std::meta::type<I>().is_interface() || std::meta::type<I>().is_union()) {
    mut uint64_t found = 0;
    constexpr for (auto member : std::meta::lookup_operators_of<I>()) {
      if constexpr (member.is_public() && !member.is_static() &&
                    !member.is_mutating() && !member.is_consuming() &&
                    !member.is_unsafe() && !member.is_generic() &&
                    !member.is_constrained() && member.parameter_count() == uint64_t(1)) {
        if constexpr ((Distance == uint64_t(0) && member.name() == "operator!=") ||
                      (Distance == uint64_t(1) && member.name() == "operator-")) {
          constexpr for (auto parameter : member.parameters()) {
            if constexpr (parameter.type().is_same<S&>() ||
                          parameter.type().is_same<S>()) { found++; }
          }
        }
      }
    }
    return found == uint64_t(1);
  } else { return false; }
}
constexpr bool sentinel_comparison_declaration<I, S>() {
  return sentinel_declaration<I, S, 0>();
}
constexpr bool sentinel_distance_declaration<I, S>() {
  return sentinel_declaration<I, S, 1>();
}
// Preserve the declaration-level category contract, independently of whether
// one particular expression could bind a different parameter by conversion.
constexpr bool cursor_movement_declarations<I, uint64_t Required>() {
  if constexpr (std::meta::is_class<I>() || std::meta::is_struct<I>() ||
                std::meta::type<I>().is_interface() ||
                std::meta::type<I>().is_union()) {
    mut uint64_t found = 0;
    constexpr for (auto member : std::meta::lookup_operators_of<I>()) {
      if constexpr (member.is_public() && !member.is_static() &&
                    member.is_mutating() && !member.is_consuming() &&
                    !member.is_unsafe() && !member.is_generic() &&
                    !member.is_constrained() && member.result().is_void()) {
        if constexpr (member.name() == "operator--" &&
                      member.parameter_count() == uint64_t(0)) {
          found |= 1;
        }
        if constexpr (member.name() == "operator++" &&
                      member.parameter_count() == uint64_t(0)) {
          found |= 8;
        }
        if constexpr (member.parameter_count() == uint64_t(1)) {
          constexpr for (auto parameter : member.parameters()) {
            if constexpr (parameter.type().is_same<std::ptrdiff_t>()) {
              if constexpr (member.name() == "operator+=") { found |= 2; }
              if constexpr (member.name() == "operator-=") { found |= 4; }
            }
          }
        }
      }
    }
    return (found & Required) == Required;
  } else {
    return false;
  }
}
constexpr bool cursor_decrement_declarations<I>() {
  return cursor_movement_declarations<I, 1>();
}
constexpr bool cursor_increment_declarations<I>() {
  return cursor_movement_declarations<I, 8>();
}
constexpr bool cursor_jump_declarations<I>() {
  return cursor_movement_declarations<I, 6>();
}
constexpr bool cursor_index_declaration<I>() {
  if constexpr (std::meta::is_class<I>() || std::meta::is_struct<I>() ||
                std::meta::type<I>().is_interface() || std::meta::type<I>().is_union()) {
    mut bool found = false;
    constexpr for (auto member : std::meta::lookup_operators_of<I>()) {
      if constexpr (member.name() == "operator[]" && member.is_public() &&
                    !member.is_static() && member.is_mutating() &&
                    !member.is_consuming() && !member.is_unsafe() &&
                    !member.is_generic() && !member.is_constrained() &&
                    member.parameter_count() == uint64_t(1)) {
        constexpr for (auto parameter : member.parameters()) {
          if constexpr (parameter.type().is_same<std::ptrdiff_t>()) { found = true; }
        }
      }
    }
    return found;
  } else { return false; }
}
[[unsatisfied("Provide public void operator--() mut.")]]
concept cursor_decrements<I> = cursor_decrement_declarations<I>() &&
requires(mut I& position) {
  { --position } -> void;
};
[[unsatisfied("Provide public void operator+=(std::ptrdiff_t) mut and operator-=(std::ptrdiff_t) mut.")]]
concept cursor_jumps<I> = cursor_jump_declarations<I>() &&
requires(mut I& position, std::ptrdiff_t distance) {
  { position += distance } -> void;
  { position -= distance } -> void;
};
}
[[unsatisfied("Provide public, safe read-only operator*() yielding a checked cursor-borrowed reference or an independent copyable value, and public void operator++() mut.")]]
concept input_iterator<I> = detail::readable_dereference_declaration<I>() &&
    detail::cursor_increment_declarations<I>() &&
    requires(I& cursor, mut I& position) { { *cursor }; { ++position } -> void; };
[[unsatisfied("The iterator must provide one unambiguous public read-only bool operator!=(S&) or operator!=(S) with copyable S for the exact sentinel type.")]]
concept sentinel_for<Sentinel, Iterator> =
    detail::sentinel_comparison_declaration<Iterator, Sentinel>() &&
    requires(Iterator& position, Sentinel& end) {
      { position != end } -> bool;
    };
[[unsatisfied("The read-only dereference must yield exactly T as a checked cursor-borrowed reference or an independent copyable value.")]]
concept dereferences_to<Iterator, T> =
    detail::exact_dereference_declaration<Iterator, T>() &&
    requires(Iterator& cursor) { { *cursor }; };
concept forward_iterator<Iterator> =
    std::input_iterator<Iterator> &&
    std::copy_constructible<Iterator> &&
    std::sentinel_for<Iterator, Iterator>;

// A writable position: mut dereference yields a mutable element reference and
// prefix increment advances the position. `writes_to` is the exact-element
// refinement, mirroring how `dereferences_to` refines `input_iterator`.
[[unsatisfied("Provide mutable operator*() returning a mutable checked reference borrowed from the cursor, and public void operator++() mut.")]]
concept output_iterator<Iterator> =
    detail::cursor_increment_declarations<Iterator>() &&
    requires(mut Iterator& cursor) {
      { *cursor } -> mut auto& [[borrowed_from(cursor)]];
      { ++cursor } -> void;
    };
[[unsatisfied("Provide a mutable dereference returning exactly mut T& borrowed from the cursor.")]]
concept writes_to<Iterator, T> = requires(mut Iterator& cursor) {
  { *cursor } -> mut T& [[borrowed_from(cursor)]];
};

// Movement categories compose over the input contract the same way the
// C++-familiar hierarchy does, but each level is an exact structural
// capability rather than a tag: bidirectional adds `void operator--() mut`,
// and random access adds `void operator+=(std::ptrdiff_t) mut` plus
// `void operator-=(std::ptrdiff_t) mut`.
concept bidirectional_iterator<Iterator> =
    std::forward_iterator<Iterator> &&
    detail::cursor_decrements<Iterator>;
concept random_access_iterator<Iterator> =
    std::bidirectional_iterator<Iterator> &&
    detail::cursor_jumps<Iterator>;

// Movement is independent of duplication: exclusive output cursors can move
// backward or jump without becoming copyable multipass readers.
concept bidirectional_cursor<Iterator> =
    std::input_iterator<Iterator> &&
    detail::cursor_decrements<Iterator>;
concept random_access_cursor<Iterator> =
    std::bidirectional_cursor<Iterator> &&
    detail::cursor_jumps<Iterator>;

// Positioned mutable access without moving the cursor: a mut iterator whose
// `mut operator[](std::ptrdiff_t)` returns a mutable reference to exactly T.
// One exclusive cursor plus offsets reaches every element of its range, which
// is how in-place algorithms keep a single mutable borrow of the owner.
concept subscripts_to_mut<Iterator, T> =
    detail::cursor_index_declaration<Iterator>() &&
    requires(mut Iterator& cursor, std::ptrdiff_t offset) {
      { cursor[offset] } -> mut T& [[borrowed_from(cursor)]];
    };

// A sentinel whose distance is known without walking: the iterator provides
// read-only `std::ptrdiff_t operator-(Sentinel&)` or a copyable by-value
// `std::ptrdiff_t operator-(Sentinel)`. Subtraction uses conventional
// left-minus-right coordinates: an iterator before its end has a negative
// difference. `distance(first, last)` instead counts forward increments.
[[unsatisfied("The iterator must provide public read-only std::ptrdiff_t operator-(S&) or operator-(S) with copyable S for the exact sentinel type, returning the signed distance from the iterator to the sentinel.")]]
concept sized_sentinel_for<Sentinel, Iterator> =
    std::sentinel_for<Sentinel, Iterator> &&
    detail::sentinel_distance_declaration<Iterator, Sentinel>() &&
    requires(Iterator& position, Sentinel& end) {
      { position - end } -> std::ptrdiff_t;
    };

// Complete-range concepts derive the private iterator and sentinel selected by
// a range's exact begin/end protocol. They intentionally expose no associated
// iterator type: range-first generic code iterates the owner directly, and
// concrete reanalysis retains the selected source declarations.
[[unsatisfied("Provide the accessible begin()/end() operations and checked element access required by a read-only range loop.")]]
concept input_range<Range> =
    requires(Range& range) { for (auto& element : range) {} };
[[unsatisfied("The range must yield exactly the required element type with read-only checked access.")]]
concept range_of<Range, T> =
    std::input_range<Range> &&
    requires(Range& range) { for (T& element : range) {} };
[[unsatisfied("Provide the begin_mut()/end() operations and exact mutable element access required by a mutable range loop.")]]
concept mutable_range_of<Range, T> =
    std::range_of<Range, T> &&
    requires(mut Range& range) { for (mut T& element : range) {} };
[[unsatisfied("The range must provide a safe read-only size() returning std::size_t without a conversion.")]]
concept sized_range<Range> =
    std::input_range<Range> &&
    requires(Range& range) { { (range.size()) } -> std::size_t; };

struct input_iterator_tag { input_iterator_tag() = default; };
struct output_iterator_tag { output_iterator_tag() = default; };
struct forward_iterator_tag : public input_iterator_tag { forward_iterator_tag() = default; };
struct bidirectional_iterator_tag : public forward_iterator_tag { bidirectional_iterator_tag() = default; };
struct random_access_iterator_tag : public bidirectional_iterator_tag { random_access_iterator_tag() = default; };
struct contiguous_iterator_tag : public random_access_iterator_tag { contiguous_iterator_tag() = default; };

// Forward-only utilities take an unsigned distance; the signed overload
// requires bidirectional movement so a negative distance always has an exact
// meaning. Movement steps rather than jumping so the reference receiver only
// needs the increment/decrement contract.
void advance<Iterator>(mut Iterator& iterator, mut ptrdiff_t distance)
  requires std::bidirectional_cursor<Iterator> {
  while (distance > 0) {
    ++iterator;
    distance--;
  }
  while (distance < 0) {
    --iterator;
    distance++;
  }
}

void advance<Iterator>(mut Iterator& iterator, mut size_t distance)
  requires std::input_iterator<Iterator> {
  while (distance > 0) {
    ++iterator;
    distance--;
  }
}

ptrdiff_t distance<Iterator, Sentinel>(mut Iterator first, Sentinel last)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  mut ptrdiff_t result = 0;
  while (first != last) {
    ++first;
    result++;
  }
  return result;
}

Iterator next<Iterator>(mut Iterator iterator)
  requires std::input_iterator<Iterator> {
  ++iterator;
  return std::move(iterator);
}

Iterator next<Iterator>(mut Iterator iterator, ptrdiff_t distance)
  requires std::random_access_cursor<Iterator> {
  iterator += distance;
  return std::move(iterator);
}

Iterator next<Iterator>(mut Iterator iterator, mut size_t distance)
  requires std::input_iterator<Iterator> {
  while (distance > 0) {
    ++iterator;
    distance--;
  }
  return std::move(iterator);
}

Iterator prev<Iterator>(mut Iterator iterator)
  requires std::bidirectional_cursor<Iterator> {
  --iterator;
  return std::move(iterator);
}

Iterator prev<Iterator>(mut Iterator iterator, mut size_t distance)
  requires std::bidirectional_cursor<Iterator> {
  while (distance > 0) {
    --iterator;
    distance--;
  }
  return std::move(iterator);
}

}
