export module algorithm;

// Algorithms that need ordering, input iteration, confined predicates, one
// exact-return callable, writable output iteration, or whole-range in-place
// element rewriting are implemented here. In-place algorithms take the owning
// container so the exclusive borrow and the element type stay explicit;
// iterator-pair in-place forms wait on retainable mutable cursors.
import std.iterator;
import std.functional;
import std.vector;
namespace std {
export constexpr T min<std::totally_ordered T>(T left, T right) {
  if (right < left) {
    return std::move(right);
  }
  return std::move(left);
}

export constexpr T max<std::totally_ordered T>(T left, T right) {
  if (left < right) {
    return std::move(right);
  }
  return std::move(left);
}

export constexpr T clamp<std::totally_ordered T>(T value, T low, T high) {
  if (value < low) {
    return std::move(low);
  }
  if (high < value) {
    return std::move(high);
  }
  return std::move(value);
}

export bool all_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                           mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (!predicate(*first)) {
      return false;
    }
  }
  return true;
}

export bool any_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                           mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return true;
    }
  }
  return false;
}

export bool none_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                            mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return false;
    }
  }
  return true;
}

export [[discardable]]
Function for_each<Iterator, Sentinel, Function>(mut Iterator first,
                                                Sentinel last,
                                                mut Function function)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_operation<Function, Iterator, void> {
  while (first != last) {
    function(*first);
    ++first;
  }
  return std::move(function);
}

export Iterator find<Iterator, Sentinel, T>(mut Iterator first, Sentinel last,
                                     T& value)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::equality_comparable<T> {
  while (first != last) {
    if (*first == value) {
      break;
    }
    ++first;
  }
  return std::move(first);
}
export Iterator find_if<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                Sentinel last,
                                                mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return std::move(first);
    }
  }
  return std::move(first);
}

export Iterator find_if_not<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                    Sentinel last,
                                                    mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (!predicate(*first)) {
      return std::move(first);
    }
  }
  return std::move(first);
}

export ptrdiff_t count<Iterator, Sentinel, T>(mut Iterator first, Sentinel last,
                                       T& value)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::equality_comparable<T> {
  mut ptrdiff_t result = 0;
  while (first != last) {
    if (*first == value) {
      result++;
    }
    ++first;
  }
  return result;
}
export ptrdiff_t count_if<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                  Sentinel last,
                                                  mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  mut ptrdiff_t result = 0;
  for (; first != last; ++first) {
    if (predicate(*first)) {
      result++;
    }
  }
  return result;
}

// Writable-output iteration: the destination cursor's mut dereference and
// prefix increment come from std::output_iterator; every write stays checked
// at the destination access itself, so an exhausted destination raises the
// destination's own defined failure. Returning the advanced cursor transfers
// its existing owner dependencies to the caller, including exclusive access.
export [[discardable]]
OutputIterator copy<Iterator, Sentinel, OutputIterator>(mut Iterator first,
                                              Sentinel last,
                                              mut OutputIterator output)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::output_iterator<OutputIterator> {
  while (first != last) {
    *output = *first;
    ++first;
    ++output;
  }
  return std::move(output);
}

// Whole-range fill keeps one exclusive range loan and one iteration-bounded
// mutable element loan. The exact element relation prevents a backend-selected
// conversion; fixed-array and nominal ranges use the same concrete range plan.
export void fill<Range, std::copyable T>(mut Range& values, T& value)
  requires std::mutable_range_of<Range, T> {
  for (mut T& element : values) {
    element = value;
  }
}

// Same-type whole-range transformation: the operation receives each source
// element by reference and its owned result is assigned into the destination
// slot.
// Reading and writing the same vector is rejected by borrow exclusivity at
// the call site; an undersized destination raises its own checked failure.
export void transform<std::movable T, Operation>(std::vector<T>& source,
                                           mut std::vector<T>& destination,
                                           mut Operation operation)
  requires std::vector_element<T> && std::operation<Operation, T, T> {
  for (mut size_t index = size_t(0); index < source.size(); index++) {
    T produced = operation(source[index]);
    destination[index] = std::move(produced);
  }
}

// In-place families retain one exclusive container borrow. Checked restoring
// transfers permute initialized elements without copying or leaving a hole.
export void reverse<std::relocatable T>(mut std::vector<T>& values)
  requires std::vector_element<T> {
  if (values.size() < std::size_t(2)) {
    return;
  }
  mut ptrdiff_t left = ptrdiff_t(0);
  mut ptrdiff_t right = ptrdiff_t(values.size()) - ptrdiff_t(1);
  while (left < right) {
    values.swap_elements(size_t(left), size_t(right));
    left++;
    right--;
  }
}

namespace detail {
// The partition levels a range may use before it falls back to heapsort:
// 2*floor(log2(count)), which keeps the worst case O(n log n).
size_t sort_depth_limit(size_t count) {
  mut size_t depth = size_t(0);
  mut size_t remaining = count;
  while (remaining > size_t(1)) {
    remaining /= size_t(2);
    depth += size_t(2);
  }
  return depth;
}

// The default relation: operator< on two readable elements.
class sort_less<std::totally_ordered T> {
public:
  sort_less() {}
  bool operator()(T& left, T& right) { return left < right; }
};

// Each phase below borrows the caller's one comparator and compares through a
// read-only reborrow of the owner that ends before any swap. Keeping each
// phase a separate small function keeps its element accesses inlinable. Every
// phase states the same comparator contract as the public overloads.

// Insertion sort of [low, high).
void sort_insertion<std::relocatable T, Compare>(mut std::vector<T>& values,
                                                 mut Compare& compare,
                                                 size_t low, size_t high)
  requires std::vector_element<T> && std::comparator<Compare, T> {
  for (mut size_t next = low + size_t(1); next < high; next++) {
    mut size_t position = next;
    while (position > low) {
      mut bool before = false;
      {
        std::vector<T>& readable = values;
        before = compare(readable[position], readable[position - size_t(1)]);
      }
      if (!before) {
        break;
      }
      values.swap_elements(position, position - size_t(1));
      position--;
    }
  }
}

// Heapsort of [low, high). root < end/2 proves 2*root+1 is an in-range child
// without overflow; an odd-sized heap's last parent also has children at
// root == end/2-1.
void sort_heap<std::relocatable T, Compare>(mut std::vector<T>& values,
                                            mut Compare& compare, size_t low,
                                            size_t high)
  requires std::vector_element<T> && std::comparator<Compare, T> {
  mut size_t end = high - low;
  mut size_t start = end / size_t(2);
  while (end > size_t(1)) {
    mut size_t root = size_t(0);
    if (start > size_t(0)) {
      start--;
      root = start;
    } else {
      end--;
      values.swap_elements(low, low + end);
    }
    while (root < end / size_t(2)) {
      mut size_t child = root * size_t(2) + size_t(1);
      if (child + size_t(1) < end) {
        mut bool larger = false;
        {
          std::vector<T>& readable = values;
          larger = compare(readable[low + child],
                           readable[low + child + size_t(1)]);
        }
        if (larger) {
          child++;
        }
      }
      mut bool before = false;
      {
        std::vector<T>& readable = values;
        before = compare(readable[low + root], readable[low + child]);
      }
      if (!before) {
        break;
      }
      values.swap_elements(low + root, low + child);
      root = child;
    }
  }
}

// Return a sampled index, never a copied pivot. A three-comparison decision
// tree avoids allocating or sorting a temporary array of sample indices.
// The caller checks storage access before lending these values. Keeping that
// access outside this policy helper lets an infallible relation stay infallible.
size_t sort_median_index<std::relocatable T, Compare>(T& first, T& middle, T& last,
                                                       mut Compare& compare,
                                                       size_t first_index,
                                                       size_t middle_index,
                                                       size_t last_index)
  requires std::vector_element<T> && std::comparator<Compare, T> {
  if (compare(first, middle)) {
    if (compare(middle, last)) { return middle_index; }
    if (compare(first, last)) { return last_index; }
    return first_index;
  }
  if (compare(first, last)) { return first_index; }
  if (compare(middle, last)) { return last_index; }
  return middle_index;
}

// Probe the whole input for either monotonic direction before partitioning.
// Equivalence prefixes do not choose a direction. Once a strict direction is
// known, one comparison per adjacent pair suffices. Disorder returns early;
// no element moves and a failed comparator leaves the input unchanged.
// 1 means nondecreasing (including all equal), -1 nonincreasing, 0 neither.
int sort_monotonic_direction<std::relocatable T, Compare>(std::vector<T>& values,
                                                           mut Compare& compare)
  requires std::vector_element<T> && std::comparator<Compare, T> {
  mut int direction = 0;
  for (mut size_t index = size_t(1); index < values.size(); index++) {
    if (direction >= 0) {
      if (compare(values[index], values[index - size_t(1)])) {
        if (direction > 0) { return 0; }
        direction = -1;
      } else if (direction == 0 &&
                 compare(values[index - size_t(1)], values[index])) {
        direction = 1;
      }
    } else if (compare(values[index - size_t(1)], values[index])) {
      return 0;
    }
  }
  return direction < 0 ? -1 : 1;
}

// Partitions [low, high), which holds more than 16 elements, and returns the
// pivot's final index: earlier elements are not after it and later elements
// are not before it. The pivot is the median of the first, middle and last
// elements or, for a range longer than 40, the median of the medians of three
// evenly spaced triples (Bentley and McIlroy, "Engineering a Sort Function",
// 1993). Both scans stop at elements equal to the pivot, so runs of equal
// elements split evenly, and both stay inside (low, high) whatever the
// comparison answers.
size_t sort_partition<std::relocatable T, Compare>(mut std::vector<T>& values,
                                                   mut Compare& compare,
                                                   size_t low, size_t high)
  requires std::vector_element<T> && std::comparator<Compare, T> {
  size_t count = high - low;
  size_t middle = low + count / size_t(2);
  size_t last = high - size_t(1);
  mut bool before = false;
  mut size_t pivot = size_t(0);
  {
    std::vector<T>& readable = values;
    if (count > size_t(40)) {
      size_t step = count / size_t(8);
      size_t first_sample = sort_median_index(
          readable[low], readable[low + step], readable[low + step * size_t(2)],
          compare, low, low + step, low + step * size_t(2));
      size_t middle_sample = sort_median_index(
          readable[middle - step], readable[middle], readable[middle + step],
          compare, middle - step, middle, middle + step);
      size_t last_sample = sort_median_index(
          readable[last - step * size_t(2)], readable[last - step], readable[last],
          compare, last - step * size_t(2), last - step, last);
      pivot = sort_median_index(
          readable[first_sample], readable[middle_sample], readable[last_sample],
          compare, first_sample, middle_sample, last_sample);
    } else {
      pivot = sort_median_index(readable[low], readable[middle], readable[last],
                                compare, low, middle, last);
    }
  }
  values.swap_elements(low, pivot);
  mut size_t left = low + size_t(1);
  mut size_t right = last;
  while (true) {
    while (left <= right) {
      {
        std::vector<T>& readable = values;
        before = compare(readable[left], readable[low]);
      }
      if (!before) {
        break;
      }
      left++;
    }
    while (left <= right) {
      {
        std::vector<T>& readable = values;
        before = compare(readable[low], readable[right]);
      }
      if (!before) {
        break;
      }
      right--;
    }
    if (left >= right) {
      break;
    }
    values.swap_elements(left, right);
    left++;
    right--;
  }
  values.swap_elements(low, right);
  return right;
}

// Adaptive introsort. Monotonic whole inputs finish in linear time; otherwise
// a range longer than 16 elements is partitioned; shorter ranges
// finish with insertion sort, and a range that exhausts sort_depth_limit
// partition levels finishes with heapsort, so comparisons stay O(n log n) for
// every input. Each split leaves the larger side on a fixed stack and
// continues with the smaller side, so at most log2(n) < 64 ranges wait at
// once and sorting never allocates. Only checked restoring swaps move
// elements, so an interrupted sort leaves a permutation of the original
// elements.
void introsort<std::relocatable T, Compare>(mut std::vector<T>& values,
                                            mut Compare& compare)
  requires std::vector_element<T> && std::comparator<Compare, T> {
  mut size_t lows[64] = {};
  mut size_t highs[64] = {};
  mut size_t depths[64] = {};
  mut size_t waiting = size_t(0);
  mut size_t low = size_t(0);
  mut size_t high = values.size();
  if (high > size_t(16)) {
    mut int direction = 0;
    {
      std::vector<T>& readable = values;
      direction = sort_monotonic_direction(readable, compare);
    }
    if (direction != 0) {
      if (direction < 0) {
        for (mut size_t left = size_t(0); left < high / size_t(2); left++) {
          values.swap_elements(left, high - left - size_t(1));
        }
      }
      return;
    }
  }
  mut size_t depth = sort_depth_limit(high);
  while (true) {
    if (high - low <= size_t(16)) {
      sort_insertion(values, compare, low, high);
    } else if (depth == size_t(0)) {
      sort_heap(values, compare, low, high);
    } else {
      depth--;
      size_t pivot = sort_partition(values, compare, low, high);
      if (pivot - low < high - pivot - size_t(1)) {
        lows[waiting] = pivot + size_t(1);
        highs[waiting] = high;
        depths[waiting] = depth;
        waiting++;
        high = pivot;
      } else {
        lows[waiting] = low;
        highs[waiting] = pivot;
        depths[waiting] = depth;
        waiting++;
        low = pivot + size_t(1);
      }
      continue;
    }
    if (waiting == size_t(0)) {
      break;
    }
    waiting--;
    low = lows[waiting];
    high = highs[waiting];
    depth = depths[waiting];
  }
}
}

// Both overloads sort in place with detail::introsort: O(n log n)
// comparisons in the worst case, fixed auxiliary storage and no allocation.
// Neither promises stability; the order of equal elements is unspecified.
export void sort<std::relocatable T>(mut std::vector<T>& values)
  requires std::vector_element<T> && std::totally_ordered<T> {
  mut detail::sort_less<T> less{};
  detail::introsort(values, less);
}

// A complete-range comparator overload keeps one exact callable in the same
// exclusive scope as the vector and lends it to every phase. The bounded
// relation guarantees an owned bool result for two readable T values and
// rejects a consuming target because sorting may compare zero or more times.
// Compare must define a strict weak order; any other relation still leaves a
// permutation.
export void sort<std::relocatable T, Compare>(mut std::vector<T>& values,
                                    mut Compare compare)
  requires std::vector_element<T> && std::comparator<Compare, T> {
  detail::introsort(values, compare);
}

// Complete-range predicate and operation clients derive the element type from
// the exact structural begin/end protocol. The compiler recognizes neither a
// public range nor an algorithm name; concrete reanalysis selects every
// endpoint, iterator operator, and callable target before HIR/MIR lowering.
export bool all_of<Range, Predicate>(Range& values, mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  for (auto& element : values) {
    if (!predicate(element)) {
      return false;
    }
  }
  return true;
}

export bool any_of<Range, Predicate>(Range& values, mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  for (auto& element : values) {
    if (predicate(element)) {
      return true;
    }
  }
  return false;
}

export bool none_of<Range, Predicate>(Range& values, mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  for (auto& element : values) {
    if (predicate(element)) {
      return false;
    }
  }
  return true;
}

export ptrdiff_t count_if<Range, Predicate>(Range& values,
                                    mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  mut ptrdiff_t result = 0;
  for (auto& element : values) {
    if (predicate(element)) {
      result++;
    }
  }
  return result;
}

export [[discardable]]
Function for_each<Range, Function>(Range& values, mut Function function)
  requires std::input_range<Range> &&
           std::range_operation<Function, Range, void> {
  for (auto& element : values) {
    function(element);
  }
  return std::move(function);
}

namespace detail {
bool binary_search_counted<Iterator, T>(mut Iterator first,
                                        ptrdiff_t count,
                                        T& value)
  requires std::forward_iterator<Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::totally_ordered<T> {
  if (count <= 0) {
    return false;
  }

  ptrdiff_t half = count / 2;
  mut Iterator middle = first;
  mut size_t offset = size_t(half);
  while (offset > 0) {
    ++middle;
    offset--;
  }

  if (*middle < value) {
    ++middle;
    ptrdiff_t remaining = count - half - 1;
    return binary_search_counted(std::move(middle), remaining, value);
  }
  if (value < *middle) {
    return binary_search_counted(std::move(first), half, value);
  }
  return true;
}
}

export bool binary_search<Iterator, Sentinel, T>(mut Iterator first,
                                          Sentinel last,
                                          T& value)
  requires std::forward_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::totally_ordered<T> {
  mut Iterator scan = first;
  mut ptrdiff_t count = 0;
  while (scan != last) {
    ++scan;
    count++;
  }
  return detail::binary_search_counted(std::move(first), count, value);
}
export bool contains<Iterator, Sentinel, T>(mut Iterator first, Sentinel last, T& value)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::equality_comparable<T> {
  while (first != last) {
    if (*first == value) { return true; }
    ++first;
  }
  return false;
}

export bool contains<Range, T>(Range& values, T& value)
  requires std::range_of<Range, T> && std::equality_comparable<T> {
  for (auto& element : values) {
    if (element == value) { return true; }
  }
  return false;
}

export ptrdiff_t count<Range, T>(Range& values, T& value)
  requires std::range_of<Range, T> && std::equality_comparable<T> {
  mut ptrdiff_t result = 0;
  for (auto& element : values) {
    if (element == value) { result++; }
  }
  return result;
}

export bool is_partitioned<Iterator, Sentinel, Predicate>(
    mut Iterator first, Sentinel last, mut Predicate predicate)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  mut bool reached_false = false;
  while (first != last) {
    if (predicate(*first)) {
      if (reached_false) { return false; }
    } else { reached_false = true; }
    ++first;
  }
  return true;
}

export bool is_partitioned<Range, Predicate>(Range& values, mut Predicate predicate)
  requires std::input_range<Range> && std::range_predicate<Predicate, Range> {
  mut bool reached_false = false;
  for (auto& element : values) {
    if (predicate(element)) {
      if (reached_false) { return false; }
    } else { reached_false = true; }
  }
  return true;
}

// Four endpoints keep both reads bounded, including unequal-length inputs.
// Element comparisons are ordinary exact GTI operators, checked again for
// every concrete instance (no host comparison, conversion, or type erasure).
export bool equal<I, S, J, E>(mut I first, S last, mut J second, E end)
  requires std::input_iterator<I> && std::sentinel_for<S, I> &&
           std::input_iterator<J> && std::sentinel_for<E, J> {
  while (first != last && second != end) {
    if (!(*first == *second)) { return false; }
    ++first;
    ++second;
  }
  return !(first != last) && !(second != end);
}

export bool starts_with<I, S, J, E>(mut I first, S last, mut J second, E end)
  requires std::input_iterator<I> && std::sentinel_for<S, I> &&
           std::input_iterator<J> && std::sentinel_for<E, J> {
  while (second != end) {
    if (!(first != last)) { return false; }
    if (!(*first == *second)) { return false; }
    ++first;
    ++second;
  }
  return true;
}

export bool lexicographical_compare<I, S, J, E>(mut I first, S last, mut J second, E end)
  requires std::input_iterator<I> && std::sentinel_for<S, I> &&
           std::input_iterator<J> && std::sentinel_for<E, J> {
  while (first != last && second != end) {
    if (*first < *second) { return true; }
    if (*second < *first) { return false; }
    ++first;
    ++second;
  }
  return !(first != last) && second != end;
}

export Iterator adjacent_find<Iterator, Sentinel>(mut Iterator first, Sentinel last)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> {
  if (!(first != last)) { return std::move(first); }
  mut Iterator next = first;
  ++next;
  while (next != last) {
    if (*first == *next) { return std::move(first); }
    ++first;
    ++next;
  }
  ++first;
  return std::move(first);
}

export Iterator search<Iterator, Sentinel, Pattern, PatternEnd>(
    mut Iterator first, Sentinel last, Pattern pattern, PatternEnd pattern_end)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::forward_iterator<Pattern> && std::sentinel_for<PatternEnd, Pattern> {
  while (first != last) {
    mut Iterator scan = first;
    mut Pattern needle = pattern;
    while (scan != last && needle != pattern_end) {
      if (!(*scan == *needle)) { break; }
      ++scan;
      ++needle;
    }
    if (!(needle != pattern_end)) { return std::move(first); }
    ++first;
  }
  return std::move(first);
}

export Iterator find_first_of<Iterator, Sentinel, Pattern, PatternEnd>(
    mut Iterator first, Sentinel last, Pattern pattern, PatternEnd pattern_end)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::forward_iterator<Pattern> && std::sentinel_for<PatternEnd, Pattern> {
  while (first != last) {
    mut Pattern needle = pattern;
    while (needle != pattern_end) {
      if (*first == *needle) { return std::move(first); }
      ++needle;
    }
    ++first;
  }
  return std::move(first);
}

export Iterator search_n<Iterator, Sentinel, T>(
    mut Iterator first, Sentinel last, size_t count, T& value)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::equality_comparable<T> {
  if (count == 0) { return std::move(first); }
  while (first != last) {
    mut Iterator scan = first;
    mut size_t matched = 0;
    while (scan != last && matched < count) {
      if (!(*scan == value)) { break; }
      ++scan;
      matched++;
    }
    if (matched == count) { return std::move(first); }
    // A failing run cannot contain the start of a successful overlapping run.
    for (mut size_t skipped = 0; skipped < matched; skipped++) { ++first; }
    if (first != last) { ++first; }
  }
  return std::move(first);
}

// Returning the original parameter preserves its exact owner identity. Cursor
// positions are advanced, never reassigned or reseated to a different owner.
// A partitioned range has a true prefix followed by a false suffix. Count
// first, then narrow without requiring subtraction or random-access movement:
// O(log n) predicate calls, O(n) increments, no allocation or element copies.
export Iterator partition_point<Iterator, Sentinel, Predicate>(
    mut Iterator first, Sentinel last, mut Predicate predicate)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  mut Iterator scan = first;
  mut size_t remaining = 0;
  while (scan != last) { ++scan; remaining++; }
  while (remaining > 0) {
    size_t half = remaining / 2;
    mut Iterator middle = first;
    for (mut size_t step = 0; step < half; step++) { ++middle; }
    if (predicate(*middle)) {
      for (mut size_t step = 0; step <= half; step++) { ++first; }
      remaining -= half + 1;
    } else { remaining = half; }
  }
  return std::move(first);
}

export Iterator lower_bound<Iterator, Sentinel, T>(mut Iterator first, Sentinel last, T& value)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::totally_ordered<T> {
  mut Iterator scan = first;
  mut size_t remaining = 0;
  while (scan != last) { ++scan; remaining++; }
  while (remaining > 0) {
    size_t half = remaining / 2;
    mut Iterator middle = first;
    for (mut size_t step = 0; step < half; step++) { ++middle; }
    if (*middle < value) {
      for (mut size_t step = 0; step <= half; step++) { ++first; }
      remaining -= half + 1;
    } else { remaining = half; }
  }
  return std::move(first);
}

export Iterator upper_bound<Iterator, Sentinel, T>(mut Iterator first, Sentinel last, T& value)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::totally_ordered<T> {
  mut Iterator scan = first;
  mut size_t remaining = 0;
  while (scan != last) { ++scan; remaining++; }
  while (remaining > 0) {
    size_t half = remaining / 2;
    mut Iterator middle = first;
    for (mut size_t step = 0; step < half; step++) { ++middle; }
    if (!(value < *middle)) {
      for (mut size_t step = 0; step <= half; step++) { ++first; }
      remaining -= half + 1;
    } else { remaining = half; }
  }
  return std::move(first);
}

// Comparator-ordered queries require only the supplied exact order, not T's
// operator<. One owned, repeatable comparator lives for the complete search;
// move-only elements are only borrowed. The range must be partitioned for the
// bound's comparison (and sorted under the strict weak order for binary_search).
export Iterator lower_bound<Iterator, Sentinel, T, Compare>(
    mut Iterator first, Sentinel last, T& value, mut Compare compare)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::comparator<Compare, T> {
  mut Iterator scan = first;
  mut size_t remaining = 0;
  while (scan != last) { ++scan; remaining++; }
  while (remaining > 0) {
    size_t half = remaining / 2;
    mut Iterator middle = first;
    for (mut size_t step = 0; step < half; step++) { ++middle; }
    if (compare(*middle, value)) {
      for (mut size_t step = 0; step <= half; step++) { ++first; }
      remaining -= half + 1;
    } else { remaining = half; }
  }
  return std::move(first);
}

export Iterator upper_bound<Iterator, Sentinel, T, Compare>(
    mut Iterator first, Sentinel last, T& value, mut Compare compare)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::comparator<Compare, T> {
  mut Iterator scan = first;
  mut size_t remaining = 0;
  while (scan != last) { ++scan; remaining++; }
  while (remaining > 0) {
    size_t half = remaining / 2;
    mut Iterator middle = first;
    for (mut size_t step = 0; step < half; step++) { ++middle; }
    if (!compare(value, *middle)) {
      for (mut size_t step = 0; step <= half; step++) { ++first; }
      remaining -= half + 1;
    } else { remaining = half; }
  }
  return std::move(first);
}

export bool binary_search<Iterator, Sentinel, T, Compare>(
    mut Iterator first, Sentinel last, T& value, mut Compare compare)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::comparator<Compare, T> {
  mut Iterator scan = first;
  mut size_t remaining = 0;
  while (scan != last) { ++scan; remaining++; }
  // Find the lower bound without transferring or copying the comparator:
  // its state must also survive the final reverse-order equivalence check.
  while (remaining > 0) {
    size_t half = remaining / 2;
    mut Iterator middle = first;
    for (mut size_t step = 0; step < half; step++) { ++middle; }
    if (compare(*middle, value)) {
      for (mut size_t step = 0; step <= half; step++) { ++first; }
      remaining -= half + 1;
    } else { remaining = half; }
  }
  return first != last && !compare(value, *first);
}

export Iterator min_element<Iterator, Sentinel>(mut Iterator first, Sentinel last)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> {
  if (!(first != last)) { return std::move(first); }
  mut Iterator scan = first;
  ++scan;
  while (scan != last) {
    if (*scan < *first) {
      while (first != scan) { ++first; }
    }
    ++scan;
  }
  return std::move(first);
}

export Iterator max_element<Iterator, Sentinel>(mut Iterator first, Sentinel last)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> {
  if (!(first != last)) { return std::move(first); }
  mut Iterator scan = first;
  ++scan;
  while (scan != last) {
    if (*first < *scan) {
      while (first != scan) { ++first; }
    }
    ++scan;
  }
  return std::move(first);
}

export bool is_sorted<Iterator, Sentinel>(mut Iterator first, Sentinel last)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> {
  if (!(first != last)) { return true; }
  mut Iterator next = first;
  ++next;
  while (next != last) {
    if (*next < *first) { return false; }
    ++first;
    ++next;
  }
  return true;
}

export Iterator is_sorted_until<Iterator, Sentinel>(mut Iterator first, Sentinel last)
  requires std::forward_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> {
  if (!(first != last)) { return std::move(first); }
  mut Iterator next = first;
  ++next;
  while (next != last) {
    if (*next < *first) { ++first; return std::move(first); }
    ++first;
    ++next;
  }
  ++first;
  return std::move(first);
}

export void replace<Range, std::copyable T>(mut Range& values, T& old_value, T& new_value)
  requires std::mutable_range_of<Range, T> && std::equality_comparable<T> {
  for (mut T& element : values) {
    if (element == old_value) { element = new_value; }
  }
}

export void replace_if<Range, std::copyable T, Predicate>(
    mut Range& values, mut Predicate predicate, T& replacement)
  requires std::mutable_range_of<Range, T> && std::predicate<Predicate, T> {
  for (mut T& element : values) {
    if (predicate(element)) { element = replacement; }
  }
}

// Output algorithms retain one exclusive destination cursor and return no
// escaping cursor. Output exhaustion uses the destination's checked failure.
export void copy_if<Iterator, Sentinel, Output, Predicate>(
    mut Iterator first, Sentinel last, mut Output output, mut Predicate predicate)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::output_iterator<Output> && std::indirect_predicate<Predicate, Iterator> {
  while (first != last) {
    if (predicate(*first)) { *output = *first; ++output; }
    ++first;
  }
}

export void copy_n<Iterator, Output>(mut Iterator first, size_t count, mut Output output)
  requires std::input_iterator<Iterator> && std::output_iterator<Output> {
  for (mut size_t index = 0; index < count; index++) {
    *output = *first;
    ++first;
    ++output;
  }
}

export void replace_copy<Iterator, Sentinel, Output, T>(
    mut Iterator first, Sentinel last, mut Output output, T& old_value, T& new_value)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::copyable<T> &&
           std::equality_comparable<T> && std::output_iterator<Output> &&
           std::writes_to<Output, T> {
  while (first != last) {
    if (*first == old_value) { *output = new_value; }
    else { *output = *first; }
    ++first;
    ++output;
  }
}

export void replace_copy_if<Iterator, Sentinel, Output, T, Predicate>(
    mut Iterator first, Sentinel last, mut Output output,
    mut Predicate predicate, T& replacement)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::copyable<T> &&
           std::output_iterator<Output> && std::writes_to<Output, T> &&
           std::indirect_predicate<Predicate, Iterator> {
  while (first != last) {
    if (predicate(*first)) { *output = replacement; }
    else { *output = *first; }
    ++first;
    ++output;
  }
}

export void remove_copy<Iterator, Sentinel, Output, T>(
    mut Iterator first, Sentinel last, mut Output output, T& value)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> && std::copyable<T> &&
           std::equality_comparable<T> && std::output_iterator<Output> &&
           std::writes_to<Output, T> {
  while (first != last) {
    if (!(*first == value)) { *output = *first; ++output; }
    ++first;
  }
}

export void remove_copy_if<Iterator, Sentinel, Output, Predicate>(
    mut Iterator first, Sentinel last, mut Output output, mut Predicate predicate)
  requires std::input_iterator<Iterator> && std::sentinel_for<Sentinel, Iterator> &&
           std::output_iterator<Output> && std::indirect_predicate<Predicate, Iterator> {
  while (first != last) {
    if (!predicate(*first)) { *output = *first; ++output; }
    ++first;
  }
}
}
