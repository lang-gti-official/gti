// Algorithms that need ordering, input iteration, confined predicates, one
// exact-return callable, writable output iteration, or whole-range in-place
// element rewriting are implemented here. In-place algorithms take the owning
// container so the exclusive borrow and the element type stay explicit;
// iterator-pair in-place forms wait on retainable mutable cursors.

#include <std/iterator>
#include <std/functional>
#include <std/vector>

namespace std {
T min<std::totally_ordered T>(T left, T right) {
  if (right < left) {
    return std::move(right);
  }
  return std::move(left);
}

T max<std::totally_ordered T>(T left, T right) {
  if (left < right) {
    return std::move(right);
  }
  return std::move(left);
}

T clamp<std::totally_ordered T>(T value, T low, T high) {
  if (value < low) {
    return std::move(low);
  }
  if (high < value) {
    return std::move(high);
  }
  return std::move(value);
}

bool all_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                           mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (!predicate(*first)) {
      return false;
    }
  }
  return true;
}

bool any_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                           mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return true;
    }
  }
  return false;
}

bool none_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                            mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return false;
    }
  }
  return true;
}

Function for_each<Iterator, Sentinel, Function>(mut Iterator first,
                                                Sentinel last,
                                                mut Function function)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_operation<Function, Iterator, void> {
  while (first != last) {
    function(*first);
    ++first;
  }
  return std::move(function);
}

Iterator find<Iterator, Sentinel, T>(mut Iterator first, Sentinel last,
                                     T& value)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::equality_comparable<T> {
  while (first != last) {
    if (*first == value) {
      break;
    }
    ++first;
  }
  return std::move(first);
}
Iterator find_if<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                Sentinel last,
                                                mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return std::move(first);
    }
  }
  return std::move(first);
}

Iterator find_if_not<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                    Sentinel last,
                                                    mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  for (; first != last; ++first) {
    if (!predicate(*first)) {
      return std::move(first);
    }
  }
  return std::move(first);
}

ptrdiff_t count<Iterator, Sentinel, T>(mut Iterator first, Sentinel last,
                                       T& value)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::equality_comparable<T> {
  mut ptrdiff_t result = 0;
  while (first != last) {
    if (*first == value) {
      result++;
    }
    ++first;
  }
  return result;
}
ptrdiff_t count_if<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                  Sentinel last,
                                                  mut Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::indirect_predicate<Predicate, Iterator> {
  mut ptrdiff_t result = 0;
  for (; first != last; ++first) {
    if (predicate(*first)) {
      result++;
    }
  }
  return result;
}

// Writable-output iteration: the destination cursor's mut dereference and
// prefix increment come from std::output_iterator; every write stays checked
// at the destination access itself, so an exhausted destination raises the
// destination's own defined failure. Unlike the C++-familiar signature, the
// advanced cursor is not returned: a mutable owner-tied cursor cannot escape
// through a return value under the current ownership model.
void copy<Iterator, Sentinel, OutputIterator>(mut Iterator first,
                                              Sentinel last,
                                              mut OutputIterator output)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::output_iterator<OutputIterator> {
  while (first != last) {
    *output = *first;
    ++first;
    ++output;
  }
}

// Whole-range fill keeps one exclusive range loan and one iteration-bounded
// mutable element loan. The exact element relation prevents a backend-selected
// conversion; fixed-array and nominal ranges use the same concrete range plan.
void fill<Range, std::copyable T>(mut Range& values, T& value)
  requires std::mutable_range_of<Range, T> {
  for (mut T& element : values) {
    element = value;
  }
}

// Same-type whole-range transformation: the operation receives each source
// element by reference and its owned result is assigned into the destination
// slot.
// Reading and writing the same vector is rejected by borrow exclusivity at
// the call site; an undersized destination raises its own checked failure.
void transform<std::copyable T, Operation>(std::vector<T>& source,
                                           mut std::vector<T>& destination,
                                           mut Operation operation)
  requires std::operation<Operation, T, T> {
  for (mut size_t index = size_t(0); index < source.size(); index++) {
    T produced = operation(source[index]);
    destination[index] = produced;
  }
}

// In-place families rewrite one owning container through a single exclusive
// borrow, copying each element out and assigning it back into place. Element
// types must therefore be copyable until place-aware initialization tracking
// allows moving directly out of an indexed element.
void reverse<std::copyable T>(mut std::vector<T>& values) {
  if (values.size() < std::size_t(2)) {
    return;
  }
  mut ptrdiff_t left = ptrdiff_t(0);
  mut ptrdiff_t right = ptrdiff_t(values.size()) - ptrdiff_t(1);
  while (left < right) {
    T low = values[size_t(left)];
    T high = values[size_t(right)];
    values[size_t(left)] = high;
    values[size_t(right)] = low;
    left++;
    right--;
  }
}

namespace detail {
// Lomuto partition quicksort over a copied pivot. Recursion always descends
// into the smaller side while the loop continues on the larger, so the stack
// stays logarithmic in the range length.
void sort_range<std::copyable T>(mut std::vector<T>& values,
                                 mut ptrdiff_t low, mut ptrdiff_t high)
  requires std::totally_ordered<T> {
  while (low < high) {
    T pivot = values[size_t(high)];
    mut ptrdiff_t store = low;
    for (mut ptrdiff_t scan = low; scan < high; scan++) {
      if (values[size_t(scan)] < pivot) {
        T lower = values[size_t(scan)];
        T kept = values[size_t(store)];
        values[size_t(scan)] = kept;
        values[size_t(store)] = lower;
        store++;
      }
    }
    T boundary = values[size_t(store)];
    values[size_t(high)] = boundary;
    values[size_t(store)] = pivot;
    if (store - low < high - store) {
      sort_range(values, low, store - ptrdiff_t(1));
      low = store + ptrdiff_t(1);
    } else {
      sort_range(values, store + ptrdiff_t(1), high);
      high = store - ptrdiff_t(1);
    }
  }
}
}

void sort<std::copyable T>(mut std::vector<T>& values)
  requires std::totally_ordered<T> {
  if (values.size() > std::size_t(1)) {
    detail::sort_range(values, ptrdiff_t(0),
                       ptrdiff_t(values.size()) - ptrdiff_t(1));
  }
}

// A complete-range comparator overload keeps one exact callable in the same
// exclusive scope as the vector. The bounded relation guarantees an owned
// bool result for two readable T values and rejects a consuming target because
// sorting may compare zero or more times. Insertion sort keeps the first
// comparator client iterative and deterministic without forwarding callable
// state through recursive helpers.
void sort<std::copyable T, Compare>(mut std::vector<T>& values,
                                    mut Compare compare)
  requires std::comparator<Compare, T> {
  for (mut size_t index = size_t(1); index < values.size(); index++) {
    mut size_t current = index;
    while (current > size_t(0)) {
      size_t previous = current - size_t(1);
      T current_value = values[current];
      T previous_value = values[previous];
      if (!compare(current_value, previous_value)) {
        break;
      }
      T lower = values[current];
      T upper = values[previous];
      values[current] = upper;
      values[previous] = lower;
      current--;
    }
  }
}

// Complete-range predicate and operation clients derive the element type from
// the exact structural begin/end protocol. The compiler recognizes neither a
// public range nor an algorithm name; concrete reanalysis selects every
// endpoint, iterator operator, and callable target before HIR/MIR lowering.
bool all_of<Range, Predicate>(Range& values, mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  for (auto& element : values) {
    if (!predicate(element)) {
      return false;
    }
  }
  return true;
}

bool any_of<Range, Predicate>(Range& values, mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  for (auto& element : values) {
    if (predicate(element)) {
      return true;
    }
  }
  return false;
}

bool none_of<Range, Predicate>(Range& values, mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  for (auto& element : values) {
    if (predicate(element)) {
      return false;
    }
  }
  return true;
}

ptrdiff_t count_if<Range, Predicate>(Range& values,
                                    mut Predicate predicate)
  requires std::input_range<Range> &&
           std::range_predicate<Predicate, Range> {
  mut ptrdiff_t result = 0;
  for (auto& element : values) {
    if (predicate(element)) {
      result++;
    }
  }
  return result;
}

Function for_each<Range, Function>(Range& values, mut Function function)
  requires std::input_range<Range> &&
           std::range_operation<Function, Range, void> {
  for (auto& element : values) {
    function(element);
  }
  return std::move(function);
}

namespace detail {
bool binary_search_counted<Iterator, T>(mut Iterator first,
                                        ptrdiff_t count,
                                        T& value)
  requires std::forward_iterator<Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::totally_ordered<T> {
  if (count <= 0) {
    return false;
  }

  ptrdiff_t half = count / 2;
  mut Iterator middle = first;
  mut size_t offset = size_t(half);
  while (offset > 0) {
    ++middle;
    offset--;
  }

  if (*middle < value) {
    ++middle;
    ptrdiff_t remaining = count - half - 1;
    return binary_search_counted(std::move(middle), remaining, value);
  }
  if (value < *middle) {
    return binary_search_counted(std::move(first), half, value);
  }
  return true;
}
}

bool binary_search<Iterator, Sentinel, T>(mut Iterator first,
                                          Sentinel last,
                                          T& value)
  requires std::forward_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::totally_ordered<T> {
  mut Iterator scan = first;
  mut ptrdiff_t count = 0;
  while (scan != last) {
    ++scan;
    count++;
  }
  return detail::binary_search_counted(std::move(first), count, value);
}
}
