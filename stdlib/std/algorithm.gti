// Algorithms that need only ordering, input iteration, or a confined predicate
// are implemented here. The remaining declarations require callable result,
// output-iterator, or bidirectional/random-access contracts that GTI cannot yet
// express honestly.

#include <std/iterator>

namespace std {
T min<std::totally_ordered T>(T left, T right) {
  if (right < left) {
    return std::move(right);
  }
  return std::move(left);
}

T max<std::totally_ordered T>(T left, T right) {
  if (left < right) {
    return std::move(right);
  }
  return std::move(left);
}

T clamp<std::totally_ordered T>(T value, T low, T high) {
  if (value < low) {
    return std::move(low);
  }
  if (high < value) {
    return std::move(high);
  }
  return std::move(value);
}

bool all_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                           Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  for (; first != last; ++first) {
    if (!predicate(*first)) {
      return false;
    }
  }
  return true;
}

bool any_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                           Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return true;
    }
  }
  return false;
}

bool none_of<Iterator, Sentinel, Predicate>(mut Iterator first, Sentinel last,
                                            Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return false;
    }
  }
  return true;
}

Function for_each<Iterator, Function>(Iterator first, Iterator last,
                                      Function function);

Iterator find<Iterator, T>(Iterator first, Iterator last, T& value);
Iterator find_if<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                Sentinel last,
                                                Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  for (; first != last; ++first) {
    if (predicate(*first)) {
      return std::move(first);
    }
  }
  return std::move(first);
}

Iterator find_if_not<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                    Sentinel last,
                                                    Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  for (; first != last; ++first) {
    if (!predicate(*first)) {
      return std::move(first);
    }
  }
  return std::move(first);
}

ptrdiff_t count<Iterator, T>(Iterator first, Iterator last, T& value);
ptrdiff_t count_if<Iterator, Sentinel, Predicate>(mut Iterator first,
                                                  Sentinel last,
                                                  Predicate predicate)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> {
  mut ptrdiff_t result = 0;
  for (; first != last; ++first) {
    if (predicate(*first)) {
      result++;
    }
  }
  return result;
}

OutputIterator copy<InputIterator, OutputIterator>(InputIterator first,
                                                    InputIterator last,
                                                    OutputIterator output);
OutputIterator transform<InputIterator, OutputIterator, UnaryOperation>(
    InputIterator first, InputIterator last, OutputIterator output,
    UnaryOperation operation);

void reverse<Iterator>(Iterator first, Iterator last);
void sort<Iterator>(Iterator first, Iterator last);
void sort<Iterator, Compare>(Iterator first, Iterator last, Compare compare);
}
