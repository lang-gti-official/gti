namespace std {
class string {
  mut gti_internal::storage<char> data;
  mut size_t count = 0;

  bool equals(string_view other) {
    if (this.count != other.size()) {
      return false;
    }
    for (mut size_t index = 0; index < this.count; index++) {
      if (gti_internal::storage_read(this.data, index) != other[index]) {
        return false;
      }
    }
    return true;
  }

  bool equals(string& other) {
    if (this.count != other.size()) {
      return false;
    }
    for (mut size_t index = 0; index < this.count; index++) {
      if (gti_internal::storage_read(this.data, index) != other[index]) {
        return false;
      }
    }
    return true;
  }

public:
  string() : data(gti_internal::allocate_storage<char>(uint64(0))) {}

  string(string_view value)
      : data(gti_internal::allocate_storage<char>(value.size())) {
    for (mut size_t index = 0; index < value.size(); index++) {
      gti_internal::storage_construct(this.data, index, value[index]);
      this.count++;
    }
  }

  size_t size() {
    return this.count;
  }

  bool empty() {
    return this.count == 0;
  }

  size_t capacity() {
    return gti_internal::storage_capacity(this.data);
  }

  char& at(int index) {
    return gti_internal::storage_read(this.data, uint64(index));
  }

  char& at(size_t index) {
    return gti_internal::storage_read(this.data, index);
  }

  char& operator[](int index) {
    return gti_internal::storage_read(this.data, uint64(index));
  }

  mut char& operator[](int index) mut {
    return gti_internal::storage_read_mut(this.data, uint64(index));
  }

  char& operator[](size_t index) {
    return gti_internal::storage_read(this.data, index);
  }

  mut char& operator[](size_t index) mut {
    return gti_internal::storage_read_mut(this.data, index);
  }

  void reserve(size_t requested) mut {
    if (requested <= this.capacity()) {
      return;
    }
    mut gti_internal::storage<char> replacement =
        gti_internal::allocate_storage<char>(requested);
    gti_internal::storage_relocate(this.data, replacement, this.count);
    this.data = std::move(replacement);
  }

  void push_back(char value) mut {
    if (this.count == this.capacity()) {
      mut size_t grown = this.capacity() * 2;
      if (grown <= this.count) {
        grown = this.count + 1;
      }
      this.reserve(grown);
    }
    gti_internal::storage_construct(this.data, this.count, value);
    this.count++;
  }

  void append(string_view value) mut {
    this.reserve(this.count + value.size());
    for (mut size_t index = 0; index < value.size(); index++) {
      gti_internal::storage_construct(this.data, this.count, value[index]);
      this.count++;
    }
  }

  void clear() mut {
    while (this.count > 0) {
      this.count--;
      gti_internal::storage_destroy(this.data, this.count);
    }
  }

  string clone() {
    mut string result = string();
    result.reserve(this.count);
    for (mut size_t index = 0; index < this.count; index++) {
      result.push_back(gti_internal::storage_read(this.data, index));
    }
    return std::move(result);
  }

  bool operator==(string_view other) {
    return this.equals(other);
  }

  bool operator!=(string_view other) {
    return !this.equals(other);
  }

  bool operator==(string& other) {
    return this.equals(other);
  }

  bool operator!=(string& other) {
    return !this.equals(other);
  }
};
}
