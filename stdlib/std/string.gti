#include <std/iterator>
#include <std/span>

// The storage-backed value, capacity, indexed operations, and owner-dependent
// read-only views are implemented.
#include <std/functional>
#include <std/numeric>

namespace std {
  namespace detail {
    class storage_sentinel {
      size_t final_position;

    public:
      storage_sentinel(size_t position) : final_position(position) {}

      size_t position() {
        return this.final_position;
      }
    };

    class storage_iterator<T> {
      gti_internal::prefix_storage<T>& data;
      mut size_t current_position;

    public:
      storage_iterator(gti_internal::prefix_storage<T>& source, size_t position) : data(source), current_position(position) {}

      T& operator*() {
        return gti_internal::prefix_storage_read(this.data, this.current_position);
      }

      void operator++() mut {
        this.current_position++;
      }

      bool operator!=(storage_sentinel& sentinel) {
        return this.current_position != sentinel.position();
      }

      bool operator!=(storage_iterator<T>& other) {
        return this.current_position != other.current_position;
      }
    };
  }

  /// An owning, move-only, mutable sequence of characters.
  class string {
    mut gti_internal::prefix_storage<char> data;
    mut size_t count = 0;
    mut size_t reserved = 0;

    gti_internal::prefix_storage<char> replace_storage(
        gti_internal::prefix_storage<char> replacement) mut {
      auto previous = std::move(this.data);
      this.data = std::move(replacement);
      return std::move(previous);
    }

    bool equals(string_view other) {
      if (this.count != other.size()) {
        return false;
      }
      for (mut size_t index = 0; index < this.count; index++) {
        if (gti_internal::prefix_storage_read(this.data, index) != other[index]) {
          return false;
        }
      }
      return true;
    }

    bool equals(string& other) {
      if (this.count != other.size()) {
        return false;
      }
      for (mut size_t index = 0; index < this.count; index++) {
        if (gti_internal::prefix_storage_read(this.data, index) != other[index]) {
          return false;
        }
      }
      return true;
    }

  public:
    string() : data(gti_internal::allocate_prefix_storage<char>(uint64_t(0))) {}

    string(string_view value) : data(gti_internal::allocate_prefix_storage<char>(value.size())), reserved(value.size()) {
      for (mut size_t index = 0; index < value.size(); index++) {
        gti_internal::prefix_storage_append(this.data, value[index]);
        this.count++;
      }
    }

    string<uint64_t N>(char values[N]) : data(gti_internal::allocate_prefix_storage<char>(N)), reserved(N) {
      while (this.count < N) {
        gti_internal::prefix_storage_append(this.data, values[this.count]);
        this.count++;
      }
    }

  string<Iterator, Sentinel>(mut Iterator first, Sentinel last)
    requires std::input_iterator<Iterator> &&
             std::sentinel_for<Sentinel, Iterator> &&
               std::dereferences_to<Iterator, char>
        : data(gti_internal::allocate_prefix_storage<char>(uint64_t(0))) {
      while (first != last) {
        this.push_back(*first);
        ++first;
      }
    }

    /// Copies the code units in [begin, end) into an independent owner.
    /// Requires begin <= end <= other.size(); invalid ranges raise GTI-R0007.
    string(std::size_t begin, std::size_t end, std::string& other)
        : data(gti_internal::allocate_prefix_storage<char>(uint64_t(0))) {
      // Validate the full range before subtraction, allocation, or any read.
      // Equality is valid at either endpoint, including an empty source.
      if (begin > end) {
        gti_internal::index_bounds_check(begin, end);
      }
      if (end > other.size()) {
        gti_internal::index_bounds_check(end, other.size());
      }
      this.reserve(end - begin);
      for (mut size_t index = begin; index < end; index++) {
        this.push_back(other[index]);
      }
    }

    string(string& other) = delete;
    string(string&& other) = default;

    /// Returns the number of live characters.
    size_t size() {
      return this.count;
    }

    /// Returns whether the string contains no characters.
    bool empty() {
      return this.count == 0;
    }

    char& front() {
      gti_internal::index_bounds_check(size_t(0), this.count);
      return gti_internal::prefix_storage_read(this.data, size_t(0));
    }

    mut char& front() mut {
      gti_internal::index_bounds_check(size_t(0), this.count);
      return gti_internal::prefix_storage_read_mut(this.data, size_t(0));
    }

    char& back() {
      gti_internal::index_bounds_check(size_t(0), this.count);
      return gti_internal::prefix_storage_read(this.data, this.count - 1);
    }

    mut char& back() mut {
      gti_internal::index_bounds_check(size_t(0), this.count);
      return gti_internal::prefix_storage_read_mut(this.data, this.count - 1);
    }

    /// Returns the number of characters that fit without growing storage.
    size_t capacity() {
      return this.reserved;
    }

    detail::storage_iterator<char> begin() {
      return detail::storage_iterator<char>(this.data, size_t(0));
    }

    detail::storage_sentinel end() {
      return detail::storage_sentinel(this.count);
    }

    /// Returns a counted read-only text view tied to this string.
    string_view view() {
      return gti_internal::prefix_storage_text_view(this.data);
    }

    /// Returns a checked read-only character view tied to this string.
    span<char> as_span() {
      return span<char>(this.data, size_t(0), this.count);
    }

    char& at(int index) {
      gti_internal::index_bounds_check(uint64_t(index), this.count);
      return gti_internal::prefix_storage_read(this.data, uint64_t(index));
    }

    mut char& at(int index) mut {
      gti_internal::index_bounds_check(uint64_t(index), this.count);
      return gti_internal::prefix_storage_read_mut(this.data, uint64_t(index));
    }

    char& at(size_t index) {
      gti_internal::index_bounds_check(index, this.count);
      return gti_internal::prefix_storage_read(this.data, index);
    }

    mut char& at(size_t index) mut {
      gti_internal::index_bounds_check(index, this.count);
      return gti_internal::prefix_storage_read_mut(this.data, index);
    }

    char& operator[](int index) {
      gti_internal::index_bounds_check(uint64_t(index), this.count);
      return gti_internal::prefix_storage_read(this.data, uint64_t(index));
    }

    mut char& operator[](int index) mut {
      gti_internal::index_bounds_check(uint64_t(index), this.count);
      return gti_internal::prefix_storage_read_mut(this.data, uint64_t(index));
    }

    char& operator[](size_t index) {
      gti_internal::index_bounds_check(index, this.count);
      return gti_internal::prefix_storage_read(this.data, index);
    }

    mut char& operator[](size_t index) mut {
      gti_internal::index_bounds_check(index, this.count);
      return gti_internal::prefix_storage_read_mut(this.data, index);
    }

    void reserve(size_t requested) mut {
      if (requested <= this.capacity()) {
        return;
      }
      mut gti_internal::prefix_storage<char> replacement = gti_internal::allocate_prefix_storage<char>(requested);
      gti_internal::prefix_storage_relocate(this.data, replacement);
      this.data = std::move(replacement);
      this.reserved = requested;
    }

    void resize(size_t requested) mut {
      while (this.count > requested) {
        gti_internal::prefix_storage_pop(this.data);
        this.count--;
      }
      this.reserve(requested);
      while (this.count < requested) {
        gti_internal::prefix_storage_append(this.data, '\0');
        this.count++;
      }
    }

    void shrink_to_fit() mut {
      if (this.reserved == this.count) {
        return;
      }
      mut gti_internal::prefix_storage<char> replacement = gti_internal::allocate_prefix_storage<char>(this.count);
      gti_internal::prefix_storage_relocate(this.data, replacement);
      this.data = std::move(replacement);
      this.reserved = this.count;
    }

    void push_back(char value) mut {
      if (this.count == this.capacity()) {
        mut size_t grown = this.capacity() * 2;
        if (grown <= this.count) {
          grown = this.count + 1;
        }
        this.reserve(grown);
      }
      gti_internal::prefix_storage_append(this.data, value);
      this.count++;
    }

    void pop_back() mut {
      if (this.count == 0) {
        return;
      }
      gti_internal::prefix_storage_pop(this.data);
      this.count--;
    }

    void append(string_view value) mut {
      this.reserve(this.count + value.size());
      for (mut size_t index = 0; index < value.size(); index++) {
        gti_internal::prefix_storage_append(this.data, value[index]);
        this.count++;
      }
    }

    void clear() mut {
      while (this.count > 0) {
        gti_internal::prefix_storage_pop(this.data);
        this.count--;
      }
    }

    string clone() {
      mut string result = string();
      result.reserve(this.count);
      for (mut size_t index = 0; index < this.count; index++) {
        result.push_back(gti_internal::prefix_storage_read(this.data, index));
      }
      return std::move(result);
    }

    /// Exchanges storage, size, and capacity without copying code units.
    void swap(mut string& other) mut {
      auto previous = std::move(this.data);
      this.data = other.replace_storage(std::move(previous));
      size_t previous_count = this.count;
      this.count = other.count;
      other.count = previous_count;
      size_t previous_capacity = this.reserved;
      this.reserved = other.reserved;
      other.reserved = previous_capacity;
    }

    bool operator==(string_view other) {
      return this.equals(other);
    }

    bool operator!=(string_view other) {
      return !this.equals(other);
    }

    bool operator==(string& other) {
      return this.equals(other);
    }

    bool operator!=(string& other) {
      return !this.equals(other);
    }
  };

  void print(string& value) {
    for (mut size_t index = 0; index < value.size(); index++) {
      print(value[index]);
    }
  }

  void print(string value) {
    for (mut size_t index = 0; index < value.size(); index++) {
      print(value[index]);
    }
  }

  void println(string& value) {
    print(value);
    print("\n");
  }

  void println(string value) {
    print(value);
    print("\n");
  }

  /// Writes a binary32 value in decimal without adding a newline.
  void print(float value) {
    mut string text = detail::float_to_decimal_string(value);
    print(text);
  }

  /// Writes a binary32 value in decimal followed by a newline.
  void println(float value) {
    print(value);
    print("\n");
  }

  namespace detail {
    char decimal_digit_character(uint8_t digit) {
      switch (digit) {
      case uint8_t(0):
        return '0';
      case uint8_t(1):
        return '1';
      case uint8_t(2):
        return '2';
      case uint8_t(3):
        return '3';
      case uint8_t(4):
        return '4';
      case uint8_t(5):
        return '5';
      case uint8_t(6):
        return '6';
      case uint8_t(7):
        return '7';
      case uint8_t(8):
        return '8';
      case uint8_t(9):
        return '9';
      default:
        return '?';
      }
    }
  }

  string to_string<std::integral T>(T value) {
    mut string result = string();
    if (value == T(0)) {
      result.push_back('0');
      return std::move(result);
    }

    if (value < T(0)) {
      result.push_back('-');
    }

    mut uint8_t[20] digits = {};
    mut size_t count = 0;
    mut T remaining = value;
    while (remaining != T(0)) {
      mut int64_t digit = int64_t(remaining % T(10));
      if (digit < 0) {
        digit = -digit;
      }
      digits[count] = uint8_t(digit);
      count++;
      remaining = T(remaining / T(10));
    }

    result.reserve(result.size() + count);
    while (count > 0) {
      count--;
      result.push_back(detail::decimal_digit_character(digits[count]));
    }
    return std::move(result);
  }
  namespace detail {
    /// Fixed fractional digit count for binary32 decimal text. Six matches
    /// the familiar `%f` default and is well inside binary32's precision.
    constexpr size_t float_fraction_digits = 6;

    /// The largest binary32 magnitude below which every value still carries
    /// fractional bits (2^24). At or above it a binary32 is an exact integer.
    constexpr float float_integral_threshold = 16777216.0;

    bool float_is_nan(float value) {
      return value != value;
    }

    bool float_is_infinite(float value) {
      if (float_is_nan(value)) {
        return false;
      }
      return value - value != 0.0;
    }

    /// Appends the exact decimal digits of a binary32 whose magnitude is at
    /// least 2^24, so the value is an exact integer. The value is normalised
    /// to `mantissa * 2^exponent` by exact halving, then the mantissa's
    /// decimal digits are doubled `exponent` times. Every step is exact, so
    /// the result is the value's true decimal expansion rather than an
    /// approximation routed through a wider float.
    void append_large_integral_float(mut string& result, float magnitude) {
      mut float remaining = magnitude;
      mut int32_t exponent = 0;
      while (remaining >= float_integral_threshold) {
        remaining = remaining / 2.0;
        exponent++;
      }

      // `remaining` is now an exact integer below 2^24.
      mut int64_t mantissa = int64_t(remaining);

      // Little-endian decimal digits of the mantissa.
      mut uint8_t[48] digits = {};
      mut size_t count = 0;
      while (mantissa > 0) {
        digits[count] = uint8_t(mantissa % 10);
        count++;
        mantissa = mantissa / 10;
      }
      if (count == 0) {
        digits[0] = uint8_t(0);
        count = 1;
      }

      mut int32_t doubling = 0;
      while (doubling < exponent) {
        mut int32_t carry = 0;
        for (mut size_t index = 0; index < count; index++) {
          int32_t doubled = int32_t(digits[index]) * 2 + carry;
          digits[index] = uint8_t(doubled % 10);
          carry = doubled / 10;
        }
        while (carry > 0) {
          digits[count] = uint8_t(carry % 10);
          count++;
          carry = carry / 10;
        }
        doubling++;
      }

      result.reserve(result.size() + count);
      while (count > 0) {
        count--;
        result.push_back(decimal_digit_character(digits[count]));
      }
    }

    /// Appends `float_fraction_digits` fractional digits for a binary32
    /// magnitude below 2^24, rounding to nearest with ties to even on the
    /// exact expansion, and
    /// returns the carry into the integer part.
    ///
    /// The fractional part of a binary32 carries at most 24 significant bits,
    /// so multiplying it by ten in binary64 needs at most 28 and is therefore
    /// exact; subtracting the extracted digit is exact as well. Each digit is
    /// consequently the true decimal digit of the stored value, not a
    /// re-rounded approximation.
    int64_t append_fraction_digits(mut string& result, double fraction) {
      mut uint8_t[8] digits = {};
      mut double remaining = fraction;
      mut size_t index = 0;
      while (index < float_fraction_digits + 1) {
        remaining = remaining * 10.0d;
        int64_t digit = int64_t(remaining);
        remaining = remaining - double(digit);
        digits[index] = uint8_t(digit);
        index++;
      }

      // Round to nearest with ties to even on the exact expansion. The
      // seventh digit and remaining exact fraction distinguish values above
      // half from an exact tie; an exact tie raises only an odd retained
      // sixth digit. Propagate any carry through the retained digits.
      mut int64_t carry = 0;
      uint8_t guard = digits[float_fraction_digits];
      uint8_t retained = digits[float_fraction_digits - 1];
      bool above_half = guard > uint8_t(5) ||
                        (guard == uint8_t(5) && remaining > 0.0d);
      bool exact_odd_tie = guard == uint8_t(5) && remaining == 0.0d &&
                           retained % uint8_t(2) == uint8_t(1);
      if (above_half || exact_odd_tie) {
        carry = 1;
        mut size_t position = float_fraction_digits;
        while (position > 0 && carry == 1) {
          position--;
          int32_t raised = int32_t(digits[position]) + 1;
          if (raised == 10) {
            digits[position] = uint8_t(0);
          } else {
            digits[position] = uint8_t(raised);
            carry = 0;
          }
        }
      }

      result.reserve(result.size() + float_fraction_digits);
      for (mut size_t emit = 0; emit < float_fraction_digits; emit++) {
        result.push_back(decimal_digit_character(digits[emit]));
      }
      return carry;
    }

    /// The shared binary32 decimal text contract used by `std::to_string`,
    /// `std::print`, and `std::println`.
    string float_to_decimal_string(float value) {
      mut string result = string();
      if (float_is_nan(value)) {
        result.append("nan");
        return std::move(result);
      }

      mut float magnitude = value;
      bool negative = value < 0.0 ||
                      (value == 0.0 && 1.0 / value < 0.0);
      if (negative) {
        result.push_back('-');
        magnitude = -value;
      }

      if (float_is_infinite(magnitude)) {
        result.append("inf");
        return std::move(result);
      }

      if (magnitude >= float_integral_threshold) {
        append_large_integral_float(result, magnitude);
        result.push_back('.');
        for (mut size_t zero = 0; zero < float_fraction_digits; zero++) {
          result.push_back('0');
        }
        return std::move(result);
      }

      // Below 2^24 the integer part fits an int64 exactly.
      mut int64_t whole = int64_t(magnitude);
      double fraction = double(magnitude) - double(whole);

      mut string fraction_text = string();
      int64_t carry = append_fraction_digits(fraction_text, fraction);
      whole = whole + carry;

      mut string whole_text = to_string(whole);
      result.append(whole_text.view());
      result.push_back('.');
      result.append(fraction_text.view());
      return std::move(result);
    }
  }

  /// Decimal text for a binary32 value: an optional sign, the integer part,
  /// a point, and exactly six fractional digits taken from the stored
  /// value's exact decimal expansion and rounded to nearest with ties to even.
  /// Signed zero is preserved. Non-finite values render as `nan`, `inf`, and
  /// `-inf`.
  string to_string(float value) {
    return detail::float_to_decimal_string(value);
  }

  namespace detail {
    static std::size_t fnv_64_1a_hasher(std::string& value) {
      mut uint64_t result = uint64_t(14695981039346656037);

      for (auto& c : value) {
        uint64_t symbol = uint8_t(c);
        result = result ^ symbol;
        result = std::wrapping_mul(result, uint64_t(1099511628211));
      }

      return result;
    }
  }
}

class std::hash<std::string> {
public:
  std::size_t operator()(std::string& value) {
    return detail::fnv_64_1a_hasher(value);
  }
};
