// The storage-backed core is implemented. Bodyless members mark reviewed
// additions that are expressible now but still need their GTI implementations.
namespace std {
namespace detail {
class storage_sentinel {
  size_t final_position;

public:
  storage_sentinel(size_t position) : final_position(position) {}

  size_t position() {
    return this.final_position;
  }
};

class storage_iterator<T> {
  gti_internal::storage<T>& data;
  mut size_t current_position;

public:
  storage_iterator(gti_internal::storage<T>& source, size_t position)
      : data(source), current_position(position) {}

  T& operator*() {
    return gti_internal::storage_read(this.data, this.current_position);
  }

  void operator++() mut {
    this.current_position++;
  }

  bool operator!=(storage_sentinel& sentinel) {
    return this.current_position != sentinel.position();
  }
};
}

class string {
  mut gti_internal::storage<char> data;
  mut size_t count = 0;
  mut size_t reserved = 0;

  bool equals(string_view other) {
    if (this.count != other.size()) {
      return false;
    }
    for (mut size_t index = 0; index < this.count; index++) {
      if (gti_internal::storage_read(this.data, index) != other[index]) {
        return false;
      }
    }
    return true;
  }

  bool equals(string& other) {
    if (this.count != other.size()) {
      return false;
    }
    for (mut size_t index = 0; index < this.count; index++) {
      if (gti_internal::storage_read(this.data, index) != other[index]) {
        return false;
      }
    }
    return true;
  }

public:
  string() : data(gti_internal::allocate_storage<char>(uint64_t(0))) {}

  string(string_view value)
      : data(gti_internal::allocate_storage<char>(value.size())),
        reserved(value.size()) {
    for (mut size_t index = 0; index < value.size(); index++) {
      gti_internal::storage_construct(this.data, index, value[index]);
      this.count++;
    }
  }

  string(string& other) = delete;
  string(string&& other) = default;

  size_t size() {
    return this.count;
  }

  bool empty() {
    return this.count == 0;
  }

  char& front();
  mut char& front() mut;

  char& back();
  mut char& back() mut;

  size_t capacity() {
    return this.reserved;
  }

  detail::storage_iterator<char> begin() {
    return detail::storage_iterator<char>(this.data, size_t(0));
  }

  detail::storage_sentinel end() {
    return detail::storage_sentinel(this.count);
  }

  char& at(int index) {
    return gti_internal::storage_read(this.data, uint64_t(index));
  }

  mut char& at(int index) mut;

  char& at(size_t index) {
    return gti_internal::storage_read(this.data, index);
  }

  mut char& at(size_t index) mut;

  char& operator[](int index) {
    return gti_internal::storage_read(this.data, uint64_t(index));
  }

  mut char& operator[](int index) mut {
    return gti_internal::storage_read_mut(this.data, uint64_t(index));
  }

  char& operator[](size_t index) {
    return gti_internal::storage_read(this.data, index);
  }

  mut char& operator[](size_t index) mut {
    return gti_internal::storage_read_mut(this.data, index);
  }

  void reserve(size_t requested) mut {
    if (requested <= this.capacity()) {
      return;
    }
    mut gti_internal::storage<char> replacement =
        gti_internal::allocate_storage<char>(requested);
    gti_internal::storage_relocate(this.data, replacement, this.count);
    this.data = std::move(replacement);
    this.reserved = requested;
  }

  void resize(size_t requested) mut;

  void shrink_to_fit() mut;

  void push_back(char value) mut {
    if (this.count == this.capacity()) {
      mut size_t grown = this.capacity() * 2;
      if (grown <= this.count) {
        grown = this.count + 1;
      }
      this.reserve(grown);
    }
    gti_internal::storage_construct(this.data, this.count, value);
    this.count++;
  }

  void pop_back() mut;

  void append(string_view value) mut {
    this.reserve(this.count + value.size());
    for (mut size_t index = 0; index < value.size(); index++) {
      gti_internal::storage_construct(this.data, this.count, value[index]);
      this.count++;
    }
  }

  void clear() mut {
    while (this.count > 0) {
      this.count--;
      gti_internal::storage_destroy(this.data, this.count);
    }
  }

  string clone() {
    mut string result = string();
    result.reserve(this.count);
    for (mut size_t index = 0; index < this.count; index++) {
      result.push_back(gti_internal::storage_read(this.data, index));
    }
    return std::move(result);
  }

  void swap(mut string& other) mut;

  bool operator==(string_view other) {
    return this.equals(other);
  }

  bool operator!=(string_view other) {
    return !this.equals(other);
  }

  bool operator==(string& other) {
    return this.equals(other);
  }

  bool operator!=(string& other) {
    return !this.equals(other);
  }
};
}
