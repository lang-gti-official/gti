export module string_view;

import std.iterator;
import "detail/iterator.gti";

export namespace std::string_view {
  constexpr std::size_t npos = uint64_t(18446744073709551615);
}

namespace std::detail {
class text_view_sentinel {
  size_t final_position;
public:
  text_view_sentinel(size_t position) : final_position(position) {}
  size_t position() { return this.final_position; }
};

// The counted view is retained by reference, not copied into an untracked
// field. This keeps both its physical shell and any dynamic owner live.
class text_view_iterator<uint64_t Reverse = 0> {
  std::string_view& view;
  mut size_t current_position;
public:
  text_view_iterator(std::string_view& source, size_t position)
      : view(source), current_position(position) {
    gti_internal::require_container_argument(position <= source.size());
  }

  char operator*() {
    size_t selected = checked_iterator_element(this.current_position, size_t(0),
                                               this.view.size(), ptrdiff_t(0), Reverse != 0);
    // A counted byte view yields a code-unit value, not a typed object
    // reference. Ordinary checked indexing remains the read authority.
    return this.view[selected];
  }
  void operator++() mut {
    this.current_position = checked_iterator_step<Reverse>(
        this.current_position, size_t(0), this.view.size());
  }
  void operator--() mut {
    this.current_position = checked_iterator_step<Reverse, 1>(
        this.current_position, size_t(0), this.view.size());
  }
  void operator+=(ptrdiff_t offset) mut {
    this.current_position = checked_iterator_position(this.current_position, size_t(0),
                                                      this.view.size(), offset, Reverse != 0);
  }
  void operator-=(ptrdiff_t offset) mut {
    this.current_position = checked_iterator_position(this.current_position, size_t(0),
                                                      this.view.size(), offset, Reverse == 0);
  }
  char operator[](ptrdiff_t offset) {
    size_t selected = checked_iterator_element(this.current_position, size_t(0),
                                               this.view.size(), offset, Reverse != 0);
    return this.view[selected];
  }
  ptrdiff_t operator-(text_view_sentinel sentinel) {
    if constexpr (Reverse != 0) {
      return checked_iterator_difference(sentinel.position(), this.current_position);
    }
    return checked_iterator_difference(this.current_position, sentinel.position());
  }
  ptrdiff_t operator-(text_view_iterator<Reverse>& other) {
    if constexpr (Reverse != 0) {
      return checked_iterator_difference(other.current_position, this.current_position);
    }
    return checked_iterator_difference(this.current_position, other.current_position);
  }
  bool operator==(text_view_sentinel sentinel) { return this.current_position == sentinel.position(); }
  bool operator!=(text_view_sentinel sentinel) { return this.current_position != sentinel.position(); }
  bool operator==(text_view_iterator<Reverse>& other) { return this.current_position == other.current_position; }
  bool operator!=(text_view_iterator<Reverse>& other) { return this.current_position != other.current_position; }
};
}

// Public names let ordinary adapters spell their return types while the
// implementation classes remain private to this module.
namespace std {
export using string_view_iterator = detail::text_view_iterator<0>;
export using string_view_reverse_iterator = detail::text_view_iterator<1>;
export using string_view_sentinel = detail::text_view_sentinel;
}

namespace gti_internal {
// Trusted declaration identities bind builtin member syntax to these ordinary
// source functions. They do not become backend-known iteration operations.
export std::detail::text_view_iterator<0> text_view_begin(std::string_view& view) {
  return std::detail::text_view_iterator<0>(view, std::size_t(0));
}
export std::detail::text_view_iterator<0> text_view_cbegin(std::string_view& view) {
  return text_view_begin(view);
}
export std::detail::text_view_sentinel text_view_end(std::string_view& view) {
  return std::detail::text_view_sentinel(view.size());
}
export std::detail::text_view_sentinel text_view_cend(std::string_view& view) {
  return text_view_end(view);
}
export std::detail::text_view_iterator<0> text_view_end_iterator(std::string_view& view) {
  return std::detail::text_view_iterator<0>(view, view.size());
}
export std::detail::text_view_iterator<0> text_view_iterator_at(std::string_view& view, std::size_t position) {
  return std::detail::text_view_iterator<0>(view, position);
}
export std::detail::text_view_iterator<1> text_view_rbegin(std::string_view& view) {
  return std::detail::text_view_iterator<1>(view, view.size());
}
export std::detail::text_view_iterator<1> text_view_crbegin(std::string_view& view) {
  return text_view_rbegin(view);
}
export std::detail::text_view_sentinel text_view_rend(std::string_view& view) {
  return std::detail::text_view_sentinel(std::size_t(0));
}
export std::detail::text_view_sentinel text_view_crend(std::string_view& view) {
  return text_view_rend(view);
}
export std::detail::text_view_iterator<1> text_view_rend_iterator(std::string_view& view) {
  return std::detail::text_view_iterator<1>(view, std::size_t(0));
}
export std::detail::text_view_iterator<1> text_view_reverse_iterator_at(std::string_view& view, std::size_t position) {
  return std::detail::text_view_iterator<1>(view, position);
}

// Searches and comparisons work on the counted code units.
constexpr bool text_matches_at(std::string_view text, std::size_t position,
                               std::string_view needle) {
  if (position > text.size() || needle.size() > text.size() - position) {
    return false;
  }
  for (mut std::size_t offset = 0; offset < needle.size(); offset++) {
    if (text[position + offset] != needle[offset]) { return false; }
  }
  return true;
}

export constexpr std::size_t text_view_find(std::string_view text,
                                          std::string_view needle,
                                          std::size_t position) {
  if (position > text.size() || needle.size() > text.size() - position) {
    return std::string_view::npos;
  }
  std::size_t last = text.size() - needle.size();
  for (mut std::size_t index = position;; index++) {
    if (text_matches_at(text, index, needle)) { return index; }
    if (index == last) { return std::string_view::npos; }
  }
}

export constexpr std::size_t text_view_find(std::string_view text,
                                          std::string_view needle) {
  return text_view_find(text, needle, std::size_t(0));
}

export constexpr std::size_t text_view_find(std::string_view text, char needle,
                                          std::size_t position) {
  for (mut std::size_t index = position; index < text.size(); index++) {
    if (text[index] == needle) { return index; }
  }
  return std::string_view::npos;
}

export constexpr std::size_t text_view_find(std::string_view text, char needle) {
  return text_view_find(text, needle, std::size_t(0));
}

export constexpr std::size_t text_view_rfind(std::string_view text,
                                           std::string_view needle,
                                           std::size_t position) {
  if (needle.size() > text.size()) { return std::string_view::npos; }
  mut std::size_t index = text.size() - needle.size();
  if (position < index) { index = position; }
  while (true) {
    if (text_matches_at(text, index, needle)) { return index; }
    if (index == 0) { return std::string_view::npos; }
    index--;
  }
}

export constexpr std::size_t text_view_rfind(std::string_view text,
                                           std::string_view needle) {
  return text_view_rfind(text, needle, std::string_view::npos);
}

export constexpr std::size_t text_view_rfind(std::string_view text, char needle,
                                           std::size_t position) {
  if (text.empty()) { return std::string_view::npos; }
  mut std::size_t index = text.size() - std::size_t(1);
  if (position < index) { index = position; }
  while (true) {
    if (text[index] == needle) { return index; }
    if (index == 0) { return std::string_view::npos; }
    index--;
  }
}

export constexpr std::size_t text_view_rfind(std::string_view text, char needle) {
  return text_view_rfind(text, needle, std::string_view::npos);
}

export constexpr bool text_view_contains(std::string_view text, std::string_view needle) {
  return text_view_find(text, needle) != std::string_view::npos;
}

export constexpr bool text_view_contains(std::string_view text, char needle) {
  return text_view_find(text, needle) != std::string_view::npos;
}

export constexpr bool text_view_starts_with(std::string_view text, std::string_view prefix) {
  return text_matches_at(text, std::size_t(0), prefix);
}

export constexpr bool text_view_starts_with(std::string_view text, char prefix) {
  return !text.empty() && text[std::size_t(0)] == prefix;
}

export constexpr bool text_view_ends_with(std::string_view text, std::string_view suffix) {
  return suffix.size() <= text.size() &&
         text_matches_at(text, text.size() - suffix.size(), suffix);
}

export constexpr bool text_view_ends_with(std::string_view text, char suffix) {
  return !text.empty() && text[text.size() - std::size_t(1)] == suffix;
}

export constexpr int text_view_compare(std::string_view left, std::string_view right) {
  std::size_t shared = left.size() < right.size() ? left.size() : right.size();
  for (mut std::size_t index = 0; index < shared; index++) {
    uint8_t a = uint8_t(left[index]);
    uint8_t b = uint8_t(right[index]);
    if (a < b) { return -1; }
    if (a > b) { return 1; }
  }
  if (left.size() < right.size()) { return -1; }
  if (left.size() > right.size()) { return 1; }
  return 0;
}

export constexpr char text_view_at(std::string_view text, int position) {
  return text[position];
}

export constexpr char text_view_at(std::string_view text, std::size_t position) {
  return text[position];
}

export constexpr char text_view_front(std::string_view text) {
  return text[std::size_t(0)];
}

export constexpr char text_view_back(std::string_view text) {
  return text[text.empty() ? std::size_t(0) : text.size() - std::size_t(1)];
}

export constexpr bool text_compare_less(std::string_view left, std::string_view right) {
  return text_view_compare(left, right) < 0;
}

export constexpr bool text_compare_less_equal(std::string_view left, std::string_view right) {
  return text_view_compare(left, right) <= 0;
}

export constexpr bool text_compare_greater(std::string_view left, std::string_view right) {
  return text_view_compare(left, right) > 0;
}

export constexpr bool text_compare_greater_equal(std::string_view left, std::string_view right) {
  return text_view_compare(left, right) >= 0;
}

// Compiler primitive: rewrites view to [offset, offset + count) of its current
// characters. The caller proves offset + count <= view.size(); the place keeps
// its owner dependency, so a narrowed copy relays exactly what view relayed.
unsafe void narrow_text_view(mut std::string_view& view, uint64_t offset, uint64_t count);

// A counted sub-view over the same characters and the same owner. The count
// clamps to the remainder; a position past size() raises GTI-R0007, even for
// an empty result. No byte is copied. (One non-overloaded helper keeps the
// relayed owner dependency a direct body fact for both member overloads.)
std::string_view checked_text_subview(mut std::string_view view, std::size_t position,
                                      std::size_t count) {
  std::size_t size = view.size();
  if (position > size) { gti_internal::index_bounds_check(position, size); }
  mut std::size_t length = size - position;
  if (count < length) { length = count; }
  unsafe { narrow_text_view(view, position, length); }
  return view;
}
// The argument-free form returns the existing counted view.
export constexpr std::string_view text_view_substr(std::string_view view) {
  return view;
}

// view.substr(position, count) and view.substr(position).
export std::string_view text_view_substr(std::string_view view, std::size_t position,
                                         std::size_t count) {
  return checked_text_subview(view, position, count);
}
export std::string_view text_view_substr(std::string_view view, std::size_t position) {
  return checked_text_subview(view, position, std::string_view::npos);
}
// view.remove_prefix(count) and view.remove_suffix(count) shrink a writable
// view in place; it keeps its owner. A count past size() raises GTI-R0007.
export void text_view_remove_prefix(mut std::string_view& view, std::size_t count) {
  std::size_t size = view.size();
  if (count > size) { gti_internal::index_bounds_check(count, size); }
  unsafe { narrow_text_view(view, count, size - count); }
}
export void text_view_remove_suffix(mut std::string_view& view, std::size_t count) {
  std::size_t size = view.size();
  if (count > size) { gti_internal::index_bounds_check(count, size); }
  unsafe { narrow_text_view(view, std::size_t(0), size - count); }
}
}

namespace std {
export detail::text_view_iterator<0> begin(std::string_view& view) { return gti_internal::text_view_begin(view); }
export detail::text_view_sentinel end(std::string_view& view) { return gti_internal::text_view_end(view); }
export detail::text_view_iterator<0> cbegin(std::string_view& view) { return gti_internal::text_view_cbegin(view); }
export detail::text_view_sentinel cend(std::string_view& view) { return gti_internal::text_view_cend(view); }
export detail::text_view_iterator<1> rbegin(std::string_view& view) { return gti_internal::text_view_rbegin(view); }
export detail::text_view_sentinel rend(std::string_view& view) { return gti_internal::text_view_rend(view); }
export detail::text_view_iterator<1> crbegin(std::string_view& view) { return gti_internal::text_view_crbegin(view); }
export detail::text_view_sentinel crend(std::string_view& view) { return gti_internal::text_view_crend(view); }
}
