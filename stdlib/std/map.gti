#include <std/vector>
#include <std/memory>
#include <std/functional>
#include <std/utility>

namespace std {
namespace detail {
struct map_node<K, V> {
  mut map_entry<K, V> entry;
  mut size_t left = 0;
  mut size_t right = 0;
  mut size_t parent = 0;
  mut int height = 1;

  map_node(K key, V value, size_t ancestor)
      : entry(map_entry<K, V>(std::move(key), std::move(value))), parent(ancestor) {}
};

class map_sentinel {
public:
  map_sentinel() = default;
};

class map_iterator<K, V, uint64_t Reverse = 0> {
  vector<unique_ptr<map_node<K, V>>>& nodes;
  size_t root;
  mut size_t position;

public:
  map_iterator(vector<unique_ptr<map_node<K, V>>>& source, size_t index, size_t root)
      : nodes(source), root(root), position(index) {}

  map_entry<K, V>& operator*() {
    gti_internal::require_container_argument(this.position != 0);
    return this.nodes[this.position - 1]->entry;
  }

  map_entry<K, V>& operator->() { return *this; }

  bool operator!=(map_sentinel end) { return this.position != 0; }
  bool operator==(map_sentinel end) { return this.position == 0; }
  bool operator!=(map_iterator<K, V, Reverse>& other) {
    return this.position != other.position;
  }
  bool operator==(map_iterator<K, V, Reverse>& other) {
    return this.position == other.position;
  }

  void operator++() mut {
    gti_internal::require_container_argument(this.position != 0);
    mut size_t right = this.nodes[this.position - 1]->right;
    if constexpr (Reverse != 0) { right = this.nodes[this.position - 1]->left; }
    if (right != 0) {
      this.position = right;
      while (true) {
        mut size_t next = this.nodes[this.position - 1]->left;
        if constexpr (Reverse != 0) { next = this.nodes[this.position - 1]->right; }
        if (next == 0) { break; }
        this.position = next;
      }
    } else {
      mut size_t child = this.position;
      mut size_t parent = this.nodes[child - 1]->parent;
      while (parent != 0) {
        mut size_t next = this.nodes[parent - 1]->right;
        if constexpr (Reverse != 0) { next = this.nodes[parent - 1]->left; }
        if (next != child) { break; }
        child = parent;
        parent = this.nodes[child - 1]->parent;
      }
      this.position = parent;
    }
  }

  void operator--() mut {
    mut size_t previous = this.position;
    if (previous == 0) {
      previous = this.root;
      gti_internal::require_container_argument(previous != 0);
      while (true) {
        mut size_t next = this.nodes[previous - 1]->right;
        if constexpr (Reverse != 0) { next = this.nodes[previous - 1]->left; }
        if (next == 0) { break; }
        previous = next;
      }
    } else {
      mut size_t subtree = this.nodes[previous - 1]->left;
      if constexpr (Reverse != 0) { subtree = this.nodes[previous - 1]->right; }
      if (subtree != 0) {
        previous = subtree;
        while (true) {
          mut size_t next = this.nodes[previous - 1]->right;
          if constexpr (Reverse != 0) { next = this.nodes[previous - 1]->left; }
          if (next == 0) { break; }
          previous = next;
        }
      } else {
        mut size_t child = previous;
        previous = this.nodes[child - 1]->parent;
        while (previous != 0) {
          mut size_t next = this.nodes[previous - 1]->left;
          if constexpr (Reverse != 0) { next = this.nodes[previous - 1]->right; }
          if (next != child) { break; }
          child = previous;
          previous = this.nodes[child - 1]->parent;
        }
        gti_internal::require_container_argument(previous != 0);
      }
    }
    this.position = previous;
  }
};

class map_entry_projection<K, V> {
  mut vector<unique_ptr<map_node<K, V>>>& nodes;
  size_t root;
  mut size_t position;

public:
  map_entry_projection(mut vector<unique_ptr<map_node<K, V>>>& source, size_t index, size_t root)
      : nodes(source), root(root), position(index) {}

  // The owning record is read-only. Only the mapped field is writable.
  map_entry<K, V>& read_entry() {
    gti_internal::require_container_argument(this.position != 0);
    return this.nodes[this.position - 1]->entry;
  }
  K& first() { return this.read_entry().first; }
  K& key() { return this.first(); }
  V& second() { return this.read_entry().second; }
  mut V& second() mut {
    gti_internal::require_container_argument(this.position != 0);
    return this.nodes[this.position - 1]->entry.second;
  }
  V& mapped() { return this.second(); }
  mut V& mapped() mut { return this.second(); }
  size_t index() { return this.position; }

  void advance(bool reverse) mut {
    gti_internal::require_container_argument(this.position != 0);
    mut size_t right = this.nodes[this.position - 1]->right;
    if (reverse) { right = this.nodes[this.position - 1]->left; }
    if (right != 0) {
      this.position = right;
      while (true) {
        mut size_t next = this.nodes[this.position - 1]->left;
        if (reverse) { next = this.nodes[this.position - 1]->right; }
        if (next == 0) { break; }
        this.position = next;
      }
    } else {
      mut size_t child = this.position;
      mut size_t parent = this.nodes[child - 1]->parent;
      while (parent != 0) {
        mut size_t next = this.nodes[parent - 1]->right;
        if (reverse) { next = this.nodes[parent - 1]->left; }
        if (next != child) { break; }
        child = parent;
        parent = this.nodes[child - 1]->parent;
      }
      this.position = parent;
    }
  }

  void retreat(bool reverse) mut {
    mut size_t previous = this.position;
    if (previous == 0) {
      previous = this.root;
      gti_internal::require_container_argument(previous != 0);
      while (true) {
        mut size_t next = this.nodes[previous - 1]->right;
        if (reverse) { next = this.nodes[previous - 1]->left; }
        if (next == 0) { break; }
        previous = next;
      }
    } else {
      mut size_t subtree = this.nodes[previous - 1]->left;
      if (reverse) { subtree = this.nodes[previous - 1]->right; }
      if (subtree != 0) {
        previous = subtree;
        while (true) {
          mut size_t next = this.nodes[previous - 1]->right;
          if (reverse) { next = this.nodes[previous - 1]->left; }
          if (next == 0) { break; }
          previous = next;
        }
      } else {
        mut size_t child = previous;
        previous = this.nodes[child - 1]->parent;
        while (previous != 0) {
          mut size_t next = this.nodes[previous - 1]->left;
          if (reverse) { next = this.nodes[previous - 1]->right; }
          if (next != child) { break; }
          child = previous;
          previous = this.nodes[child - 1]->parent;
        }
        gti_internal::require_container_argument(previous != 0);
      }
    }
    this.position = previous;
  }
};

// The inline projection is a view, not the owning node entry. Replacing or
// moving a view cannot transfer or mutate a stored key.
class map_mut_iterator<K, V, uint64_t Reverse = 0> {
  mut map_entry_projection<K, V> projection;
public:
  map_mut_iterator(mut vector<unique_ptr<map_node<K, V>>>& source, size_t index, size_t root)
      : projection(map_entry_projection<K, V>(source, index, root)) {}
  map_entry<K, V>& operator*() { return this.projection.read_entry(); }
  mut map_entry_projection<K, V>& operator*() mut {
    gti_internal::require_container_argument(this.projection.index() != 0);
    return this.projection;
  }
  map_entry<K, V>& operator->() { return *this; }
  mut map_entry_projection<K, V>& operator->() mut { return *this; }
  K& key() { return this.projection.key(); }
  bool operator!=(map_sentinel end) { return this.projection.index() != 0; }
  bool operator==(map_sentinel end) { return this.projection.index() == 0; }
  void operator++() mut { this.projection.advance(Reverse != 0); }
  void operator--() mut { this.projection.retreat(Reverse != 0); }
};
}

/// An owning ordered dictionary. Its AVL tree stores links as slot indexes,
/// never untracked pointers; zero is the absent link, other links are index+1.
class map<K, V, Compare = std::less<K>> {
  mut vector<unique_ptr<detail::map_node<K, V>>> nodes{};
  mut vector<size_t> free_slots{};
  mut size_t root = 0;
  mut size_t element_count = 0;
  Compare compare;

  int height(size_t node) {
    if (node == 0) { return 0; }
    return this.nodes[node - 1]->height;
  }

  void refresh(size_t node) mut {
    int left = this.height(this.nodes[node - 1]->left);
    int right = this.height(this.nodes[node - 1]->right);
    if (left > right) { this.nodes[node - 1]->height = left + 1; }
    else { this.nodes[node - 1]->height = right + 1; }
  }

  void replace_link(size_t parent, size_t previous, size_t replacement) mut {
    if (parent == 0) { this.root = replacement; }
    else if (this.nodes[parent - 1]->left == previous) {
      this.nodes[parent - 1]->left = replacement;
    } else { this.nodes[parent - 1]->right = replacement; }
    if (replacement != 0) { this.nodes[replacement - 1]->parent = parent; }
  }

  [[discardable]] size_t rotate_left(size_t node) mut {
    size_t pivot = this.nodes[node - 1]->right;
    size_t middle = this.nodes[pivot - 1]->left;
    size_t parent = this.nodes[node - 1]->parent;
    this.replace_link(parent, node, pivot);
    this.nodes[node - 1]->right = middle;
    if (middle != 0) { this.nodes[middle - 1]->parent = node; }
    this.nodes[pivot - 1]->left = node;
    this.nodes[node - 1]->parent = pivot;
    this.refresh(node);
    this.refresh(pivot);
    return pivot;
  }

  [[discardable]] size_t rotate_right(size_t node) mut {
    size_t pivot = this.nodes[node - 1]->left;
    size_t middle = this.nodes[pivot - 1]->right;
    size_t parent = this.nodes[node - 1]->parent;
    this.replace_link(parent, node, pivot);
    this.nodes[node - 1]->left = middle;
    if (middle != 0) { this.nodes[middle - 1]->parent = node; }
    this.nodes[pivot - 1]->right = node;
    this.nodes[node - 1]->parent = pivot;
    this.refresh(node);
    this.refresh(pivot);
    return pivot;
  }

  void rebalance(mut size_t node) mut {
    while (node != 0) {
      this.refresh(node);
      size_t left = this.nodes[node - 1]->left;
      size_t right = this.nodes[node - 1]->right;
      int balance = this.height(left) - this.height(right);
      if (balance > 1) {
        if (this.height(this.nodes[left - 1]->left) <
            this.height(this.nodes[left - 1]->right)) {
          this.rotate_left(left);
        }
        node = this.rotate_right(node);
      } else if (balance < -1) {
        if (this.height(this.nodes[right - 1]->right) <
            this.height(this.nodes[right - 1]->left)) {
          this.rotate_right(right);
        }
        node = this.rotate_left(node);
      }
      node = this.nodes[node - 1]->parent;
    }
  }

  size_t locate(K& key) {
    mut size_t node = this.root;
    while (node != 0) {
      if (this.compare(key, this.nodes[node - 1]->entry.first)) {
        node = this.nodes[node - 1]->left;
      } else if (this.compare(this.nodes[node - 1]->entry.first, key)) {
        node = this.nodes[node - 1]->right;
      } else { return node; }
    }
    return 0;
  }

public:
  using key_type = K;
  using mapped_type = V;
  using value_type = detail::map_entry<K, V>;
  using size_type = size_t;
  using iterator = detail::map_mut_iterator<K, V>;
  using const_iterator = detail::map_iterator<K, V>;
  using sentinel = detail::map_sentinel;
  using reverse_iterator = detail::map_mut_iterator<K, V, 1>;
  using const_reverse_iterator = detail::map_iterator<K, V, 1>;

  map() requires std::default_initializable<Compare> &&
                 std::read_binary_callable<Compare, K, K, bool>
      : compare(Compare()) {}
  map(Compare ordering) requires std::read_binary_callable<Compare, K, K, bool>
      : compare(std::move(ordering)) {}
  map(map<K, V, Compare>& other) = delete;
  map(map<K, V, Compare>&& other) = default;

  size_t size() { return this.element_count; }
  bool empty() { return this.element_count == 0; }
  bool contains(K& key) { return this.locate(key) != 0; }
  size_t count(K& key) {
    if (this.contains(key)) { return 1; }
    return 0;
  }

  detail::map_iterator<K, V> begin() {
    mut size_t node = this.root;
    if (node != 0) {
      while (this.nodes[node - 1]->left != 0) {
        node = this.nodes[node - 1]->left;
      }
    }
    return detail::map_iterator<K, V>(this.nodes, node, this.root);
  }

  detail::map_sentinel end() { return detail::map_sentinel(); }
  const_iterator end_iterator() { return const_iterator(this.nodes, size_t(0), this.root); }
  iterator end_mut() mut { return iterator(this.nodes, size_t(0), this.root); }
  const_iterator cbegin() { return this.begin(); }
  sentinel cend() { return this.end(); }
  const_reverse_iterator rbegin() {
    mut size_t node = this.root;
    if (node != 0) {
      while (this.nodes[node - 1]->right != 0) { node = this.nodes[node - 1]->right; }
    }
    return const_reverse_iterator(this.nodes, node, this.root);
  }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  sentinel rend() { return sentinel(); }
  sentinel crend() { return this.rend(); }
  reverse_iterator rbegin_mut() mut {
    mut size_t node = this.root;
    if (node != 0) {
      while (this.nodes[node - 1]->right != 0) { node = this.nodes[node - 1]->right; }
    }
    return reverse_iterator(this.nodes, node, this.root);
  }
  reverse_iterator rend_mut() mut { return reverse_iterator(this.nodes, size_t(0), this.root); }

  detail::map_mut_iterator<K, V> begin_mut() mut {
    mut size_t node = this.root;
    if (node != 0) {
      while (this.nodes[node - 1]->left != 0) {
        node = this.nodes[node - 1]->left;
      }
    }
    return detail::map_mut_iterator<K, V>(this.nodes, node, this.root);
  }

  detail::map_iterator<K, V> find(K& key) {
    size_t node = this.locate(key);
    return detail::map_iterator<K, V>(this.nodes, node, this.root);
  }

  detail::map_mut_iterator<K, V> find_mut(K& key) mut {
    size_t node = this.locate(key);
    return detail::map_mut_iterator<K, V>(this.nodes, node, this.root);
  }

  detail::map_iterator<K, V> lower_bound(K& key) {
    mut size_t node = this.root;
    mut size_t result = 0;
    while (node != 0) {
      if (this.compare(this.nodes[node - 1]->entry.first, key)) {
        node = this.nodes[node - 1]->right;
      } else {
        result = node;
        node = this.nodes[node - 1]->left;
      }
    }
    return detail::map_iterator<K, V>(this.nodes, result, this.root);
  }

  detail::map_iterator<K, V> upper_bound(K& key) {
    mut size_t node = this.root;
    mut size_t result = 0;
    while (node != 0) {
      if (this.compare(key, this.nodes[node - 1]->entry.first)) {
        result = node;
        node = this.nodes[node - 1]->left;
      } else { node = this.nodes[node - 1]->right; }
    }
    return detail::map_iterator<K, V>(this.nodes, result, this.root);
  }

  V& at(K& key) {
    size_t node = this.locate(key);
    gti_internal::require_key(node != 0);
    return this.nodes[node - 1]->entry.second;
  }

  mut V& at(K& key) mut {
    size_t node = this.locate(key);
    gti_internal::require_key(node != 0);
    return this.nodes[node - 1]->entry.second;
  }

private:
  pair<size_t, bool> insert_position(K key, V value) mut {
    mut size_t parent = 0;
    mut size_t node = this.root;
    mut bool left = false;
    while (node != 0) {
      parent = node;
      if (this.compare(key, this.nodes[node - 1]->entry.first)) {
        left = true;
        node = this.nodes[node - 1]->left;
      } else if (this.compare(this.nodes[node - 1]->entry.first, key)) {
        left = false;
        node = this.nodes[node - 1]->right;
      } else { return pair<size_t, bool>(node, false); }
    }
    auto owned = std::make_unique<detail::map_node<K, V>>(
        std::move(key), std::move(value), parent);
    mut size_t added = this.nodes.size() + 1;
    if (this.free_slots.empty()) {
      this.nodes.push_back(std::move(owned));
    } else {
      added = this.free_slots.back();
      this.nodes[added - 1] = std::move(owned);
      this.free_slots.pop_back();
    }
    if (parent == 0) { this.root = added; }
    else if (left) { this.nodes[parent - 1]->left = added; }
    else { this.nodes[parent - 1]->right = added; }
    this.element_count++;
    this.rebalance(parent);
    return pair<size_t, bool>(added, true);
  }

public:
  [[discardable]] pair<iterator, bool> insert(K key, V value) mut {
    auto result = this.insert_position(std::move(key), std::move(value));
    return pair<iterator, bool>(iterator(this.nodes, result.first, this.root), result.second);
  }

  [[discardable]] pair<iterator, bool> insert_or_assign(K key, V value) mut {
    size_t node = this.locate(key);
    if (node != 0) {
      this.nodes[node - 1]->entry.second = std::move(value);
      return pair<iterator, bool>(iterator(this.nodes, node, this.root), false);
    }
    auto result = this.insert_position(std::move(key), std::move(value));
    return pair<iterator, bool>(iterator(this.nodes, result.first, this.root), result.second);
  }

  [[discardable]] pair<iterator, bool> try_emplace<Args...>(K key, Args... args) mut {
    size_t node = this.locate(key);
    if (node != 0) {
      return pair<iterator, bool>(iterator(this.nodes, node, this.root), false);
    }
    auto result = this.insert_position(std::move(key), V(args...));
    return pair<iterator, bool>(iterator(this.nodes, result.first, this.root), result.second);
  }

  [[discardable]] pair<iterator, bool> emplace<Args...>(K key, Args... args) mut {
    auto result = this.insert_position(std::move(key), V(args...));
    return pair<iterator, bool>(iterator(this.nodes, result.first, this.root), result.second);
  }

  [[discardable]] mut V& get_or_insert(K key) mut requires std::default_initializable<V> {
    size_t node = this.locate(key);
    if (node != 0) { return this.nodes[node - 1]->entry.second; }
    auto result = this.insert_position(std::move(key), V());
    return this.nodes[result.first - 1]->entry.second;
  }

  [[discardable]] size_t erase(K& key) mut {
    size_t node = this.locate(key);
    if (node == 0) { return 0; }
    // Reserve the vacant-slot record before changing any tree links.
    this.free_slots.push_back(node);
    size_t left = this.nodes[node - 1]->left;
    size_t right = this.nodes[node - 1]->right;
    size_t parent = this.nodes[node - 1]->parent;
    mut size_t start = parent;
    if (left == 0) { this.replace_link(parent, node, right); }
    else if (right == 0) { this.replace_link(parent, node, left); }
    else {
      mut size_t successor = right;
      while (this.nodes[successor - 1]->left != 0) {
        successor = this.nodes[successor - 1]->left;
      }
      size_t ancestor = this.nodes[successor - 1]->parent;
      if (ancestor == node) { start = successor; }
      else {
        size_t child = this.nodes[successor - 1]->right;
        this.replace_link(ancestor, successor, child);
        this.nodes[successor - 1]->right = right;
        this.nodes[right - 1]->parent = successor;
        start = ancestor;
      }
      this.replace_link(parent, node, successor);
      this.nodes[successor - 1]->left = left;
      this.nodes[left - 1]->parent = successor;
    }
    this.element_count--;
    this.rebalance(start);
    this.nodes[node - 1].reset();
    return 1;
  }

  void clear() mut {
    this.root = 0;
    this.element_count = 0;
    this.free_slots.clear();
    this.nodes.clear();
  }
};
}
