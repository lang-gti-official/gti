#include <std/memory>

namespace std {
/// Passive provider descriptor; copying it does not duplicate release authority.
using raw_allocation = std::detail::raw_allocation;

/// Signature/effect contract only; satisfying this concept is not a proof that
/// returned addresses supply disjoint, writable regions until matching release.
concept memory_resource<R> = requires(R& resource, layout request) {
  unsafe { resource.allocate(request) } -> expected<std::detail::raw_allocation, alloc_errc>;
} && requires(R& resource, std::detail::raw_allocation allocation) {
  unsafe { resource.release(allocation) } -> void;
};

/// Reusable checked shared borrow of an explicitly trusted resource.
/// It retains the provider's lifetime, not ownership or synchronization rights.
class resource_ref<memory_resource R> {
  R& resource;
public:
  resource_ref(gti_internal::resource_binding token, R& resource)
      : resource(resource) {}
  R& get() { return this.resource; }
};

/// The caller proves the provider contract for every future use through this
/// binding and its copies, including overlapping live leases. Successful
/// nonempty allocations are writable, sufficiently aligned, large enough,
/// disjoint from all outstanding regions, and contain no preexisting objects
/// whose lifetime adoption would overwrite. Their addresses and descriptors
/// remain valid until matching release; release retires exactly that region
/// and does not access destroyed elements. Raw aliases, independent reset,
/// reentrant calls and concurrent calls must not violate these promises.
/// Shared borrowing checks the provider shell's lifetime; it cannot validate
/// raw memory or add locks.
unsafe resource_ref<R> bind_resource<R>(R& resource) requires memory_resource<R> {
  return resource_ref<R>(gti_internal::resource_binding::trusted, resource);
}


/// Portable process allocation. Direct calls retain the unsafe byte contract.
class process_resource {
public:
  process_resource() {}
  unsafe expected<raw_allocation, alloc_errc> allocate(layout request) {
    gti_internal::process_resource process{};
    unsafe { return process.allocate(request); }
  }
  unsafe void release(raw_allocation allocation) {
    gti_internal::process_resource process{};
    unsafe { process.release(allocation); }
  }
};
}

namespace std::detail {
class resource_lease<std::memory_resource R> {
  std::resource_ref<R> resource;
  mut std::raw_allocation allocation;
public:
  resource_lease(std::resource_ref<R> resource)
      : resource(resource),
        allocation(std::raw_allocation()) {}
  resource_lease(gti_internal::resource_binding token, std::resource_ref<R> resource, std::raw_allocation allocation)
      : resource(resource), allocation(allocation) {}
  resource_lease(resource_lease<R>& other) = delete;
  resource_lease(resource_lease<R>&& other) = default;
  std::resource_ref<R> binding() {
      return this.resource;
  }
  uint64_t alignment() { return this.allocation.alignment; }
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    unsafe { return this.resource.get().allocate(request); }
  }
  std::raw_allocation take() mut {
    std::raw_allocation previous = this.allocation;
    this.allocation = std::raw_allocation();
    return previous;
  }
  unsafe void attach(std::raw_allocation allocation) mut { this.allocation = allocation; }
  void release() mut {
    std::raw_allocation previous = this.take();
    if (previous.address != nullptr) {
      unsafe { this.resource.get().release(previous); }
    }
  }
  ~resource_lease() {
    if (this.allocation.address != nullptr) {
      unsafe { this.resource.get().release(this.allocation); }
    }
  }
};
}

namespace std {
/// Typed owner over a region chosen by a checked, explicitly bound resource.
/// Two leases precede the slot engine: reverse field cleanup destroys elements
/// before metadata and object bytes. Both regions use the same bound resource.
/// Region shape checks do not prove provenance, disjointness or provider honesty.
class resource_storage<std::storage_element T, memory_resource R> {
  mut std::detail::resource_lease<R> lease;
  mut std::detail::resource_lease<R> metadata;
  mut gti_internal::sparse_slots<T> data;
public:
  using const_iterator = detail::sparse_iterator<T>;
  using iterator = detail::sparse_mut_iterator<T>;
  using const_reverse_iterator = detail::sparse_iterator<T, 1>;
  using reverse_iterator = detail::sparse_mut_iterator<T, 1>;
  using sentinel = detail::memory_slot_sentinel;

  resource_storage(resource_ref<R> resource)
      : lease(std::detail::resource_lease<R>(resource)),
        metadata(std::detail::resource_lease<R>(resource)),
        data(gti_internal::sparse_slots<T>()) {}
  resource_storage(resource_storage<T,R>& other) = delete;
  resource_storage(resource_storage<T,R>&& other) = default;

  /// Visits only live slots while retaining the region and provider binding.
  const_iterator begin() { return const_iterator(this.data, size_t(0)); }
  const_iterator cbegin() { return this.begin(); }
  sentinel end() { return sentinel(this.capacity()); }
  sentinel cend() { return this.end(); }
  const_iterator end_iterator() { return const_iterator(this.data, this.capacity()); }
  iterator begin_mut() mut { return iterator(this.data, size_t(0)); }
  iterator end_mut() mut { return iterator(this.data, this.capacity()); }
  const_reverse_iterator rbegin() { return const_reverse_iterator(this.data, this.capacity()); }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  sentinel rend() { return sentinel(size_t(0)); }
  sentinel crend() { return this.rend(); }
  reverse_iterator rbegin_mut() mut { return reverse_iterator(this.data, this.capacity()); }
  reverse_iterator rend_mut() mut { return reverse_iterator(this.data, size_t(0)); }

  size_t capacity() { return this.data.capacity(); }
  bool initialized(size_t index) {
    return this.data.initialized(index);
  }
  expected<void, alloc_errc> try_allocate(size_t count) mut
      requires layout_queryable<T> {
    return this.try_allocate(count, alignment(layout_of<T>().alignment));
  }
  expected<void, alloc_errc> try_allocate(size_t count, alignment requested) mut
      requires layout_queryable<T> {
    return gti_internal::try_allocate_sparse(this.lease, this.metadata,
                                            this.data, count, requested.bytes());
  }
  [[discardable]]
  mut T& emplace<Args...>(size_t index, Args... args) mut {
    return this.data.emplace(index, args...);
  }
  T& get(size_t index) { return this.data.read(index); }
  mut T& get_mut(size_t index) mut { return this.data.read_mut(index); }
  void destroy(size_t index) mut { this.data.destroy(index); }
  void clear() mut { this.data.clear(); }
  void relocate_to(mut resource_storage<T,R>& destination, size_t count) mut
      requires std::movable<T> && std::relocatable<T> {
    this.data.relocate_to(destination.data, count);
  }
  /// Grows a fully initialized prefix, retaining this owner's resource binding.
  /// Allocation failure leaves the original region and elements untouched.
  expected<void, alloc_errc> try_reserve_prefix(size_t requested, size_t live) mut
      requires layout_queryable<T> && std::movable<T> && std::relocatable<T> {
    if (live > this.capacity()) { return unexpected(alloc_errc::invalid_state); }
    mut size_t index = 0;
    while (index < this.capacity()) {
      if (this.data.initialized(index) != (index < live)) {
        return unexpected(alloc_errc::invalid_state);
      }
      index++;
    }
    if (requested <= this.capacity()) { return; }
    mut size_t selected = this.lease.alignment();
    if (selected == size_t(0)) { selected = layout_of<T>().alignment; }
    mut resource_storage<T,R> candidate{this.lease.binding()};
    auto attempt = candidate.try_allocate(requested, alignment(selected));
    if (!attempt) { return unexpected(attempt.error()); }
    this.relocate_to(candidate, live);
    gti_internal::sparse_slots<T> previous = std::move(this.data);
    this.data = std::move(candidate.data);
    candidate.data = std::move(previous);
    raw_allocation previous_allocation = this.lease.take();
    unsafe { this.lease.attach(candidate.lease.take());
    candidate.lease.attach(previous_allocation);
    raw_allocation previous_metadata = this.metadata.take();
    this.metadata.attach(candidate.metadata.take());
    candidate.metadata.attach(previous_metadata); }
    return;
  }
  /// Destroys live elements, then returns the region to its own resource.
  /// The binding is retained, so the owner can allocate again afterwards.
  void release() mut {
    raw_allocation allocation = this.lease.take();
    std::detail::resource_lease<R> previous_lease{gti_internal::resource_binding::trusted, this.lease.binding(), allocation};
    raw_allocation flags = this.metadata.take();
    std::detail::resource_lease<R> previous_metadata{gti_internal::resource_binding::trusted, this.metadata.binding(), flags};
    // Retire receiver state before any element cleanup can fail.
    gti_internal::sparse_slots<T> previous = std::move(this.data);
    this.data = gti_internal::sparse_slots<T>();
  }
};
}
