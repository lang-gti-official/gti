export module set;
import "detail/map_iterators.gti";

import std.map;
import std.functional;
import std.utility;
namespace std {
namespace detail {
/// Projects immutable keys while preserving the underlying iterator's loan.
class set_key_iterator<K, uint64_t Reverse = 0> {
  mut map_iterator<K, bool, Reverse> cursor;
public:
  set_key_iterator(map_iterator<K, bool, Reverse> cursor) : cursor(std::move(cursor)) {}
  K& operator*() { return this.cursor->first; }
  K& operator->() { return this.cursor->first; }
  void operator++() mut { ++this.cursor; }
  void operator--() mut { --this.cursor; }
  bool operator!=(map_sentinel end) { return this.cursor != end; }
  bool operator==(map_sentinel end) { return this.cursor == end; }
  bool operator!=(set_key_iterator<K, Reverse>& other) { return this.cursor != other.cursor; }
  bool operator==(set_key_iterator<K, Reverse>& other) { return this.cursor == other.cursor; }
};
class set_insert_iterator<K> {
  mut map_mut_iterator<K, bool> cursor;
public:
  set_insert_iterator(map_mut_iterator<K, bool> cursor) : cursor(std::move(cursor)) {}
  K& operator*() { return this.cursor.key(); }
  K& operator->() { return this.cursor.key(); }
  void operator++() mut { ++this.cursor; }
  void operator--() mut { --this.cursor; }
  bool operator!=(map_sentinel end) { return this.cursor != end; }
  bool operator==(map_sentinel end) { return this.cursor == end; }
};
}

/// Unique immutable keys ordered by an ordinary AVL dictionary.
export class set<K, Compare = std::less<K>> {
  mut map<K, bool, Compare> entries;
  map<K, bool, Compare> replace(map<K, bool, Compare> value) mut {
    auto previous = std::move(this.entries);
    this.entries = std::move(value);
    return std::move(previous);
  }
public:
  using key_type = K;
  using value_type = K;
  using size_type = size_t;
  using iterator = detail::set_insert_iterator<K>;
  using const_iterator = detail::set_key_iterator<K>;
  using sentinel = detail::map_sentinel;
  using const_reverse_iterator = detail::set_key_iterator<K, 1>;
  static set<K, Compare> collection_init(uint64_t count)
      requires std::default_initializable<Compare> && std::read_binary_callable<Compare, K, K, bool> {
    return set<K, Compare>();
  }
  static set<K, Compare> collection_insert(mut set<K, Compare> collection, K element)
      requires std::movable<K> && std::read_binary_callable<Compare, K, K, bool> {
    collection.insert(std::move(element));
    return std::move(collection);
  }
  set() requires std::default_initializable<Compare> && std::read_binary_callable<Compare, K, K, bool>
      : entries(map<K, bool, Compare>()) {}
  set(Compare compare) requires std::read_binary_callable<Compare, K, K, bool>
      : entries(map<K, bool, Compare>(std::move(compare))) {}
  set(set<K, Compare>& other) = delete;
  set(set<K, Compare>&& other) = default;
  size_t size() { return this.entries.size(); }
  bool empty() { return this.entries.empty(); }
  bool contains(K& key) { return this.entries.contains(key); }
  size_t count(K& key) { return this.entries.count(key); }
  [[discardable]] size_t erase(K& key) mut { return this.entries.erase(key); }
  void clear() mut { this.entries.clear(); }
  void swap(mut set<K, Compare>& other) mut {
    auto previous = std::move(this.entries);
    this.entries = other.replace(std::move(previous));
  }
  const_iterator begin() { return const_iterator(this.entries.begin()); }
  const_iterator end_iterator() { return const_iterator(this.entries.end_iterator()); }
  const_iterator cbegin() { return this.begin(); }
  sentinel cend() { return this.end(); }
  const_reverse_iterator rbegin() { return const_reverse_iterator(this.entries.rbegin()); }
  const_reverse_iterator crbegin() { return this.rbegin(); }
  sentinel rend() { return this.entries.rend(); }
  sentinel crend() { return this.rend(); }
  detail::map_sentinel end() { return this.entries.end(); }
  const_iterator find(K& key) { return const_iterator(this.entries.find(key)); }
  const_iterator lower_bound(K& key) { return const_iterator(this.entries.lower_bound(key)); }
  const_iterator upper_bound(K& key) { return const_iterator(this.entries.upper_bound(key)); }
  [[discardable]] pair<iterator, bool> insert(K key) mut {
    mut auto result = this.entries.insert(std::move(key), true);
    bool inserted = result.second;
    return pair<iterator, bool>(iterator(std::move(result.first)), inserted);
  }
  [[discardable]] pair<iterator, bool> emplace<Args...>(Args... args) mut {
    return this.insert(K(args...));
  }
};
}
