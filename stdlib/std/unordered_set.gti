#include <std/unordered_map>
#include <std/functional>
#include <std/utility>

namespace std {
namespace detail {
class unordered_set_key_iterator<K> {
  mut unordered_map_iterator<K, bool> cursor;
public:
  unordered_set_key_iterator(unordered_map_iterator<K, bool> cursor) : cursor(std::move(cursor)) {}
  K& operator*() { return this.cursor->first; }
  K& operator->() { return this.cursor->first; }
  void operator++() mut { ++this.cursor; }
  bool operator!=(unordered_map_sentinel end) { return this.cursor != end; }
  bool operator==(unordered_map_sentinel end) { return this.cursor == end; }
  bool operator!=(unordered_set_key_iterator<K>& other) { return this.cursor != other.cursor; }
  bool operator==(unordered_set_key_iterator<K>& other) { return this.cursor == other.cursor; }
};
class unordered_set_insert_iterator<K> {
  mut unordered_map_mut_iterator<K, bool> cursor;
public:
  unordered_set_insert_iterator(unordered_map_mut_iterator<K, bool> cursor) : cursor(std::move(cursor)) {}
  K& operator*() { return this.cursor.key(); }
  K& operator->() { return this.cursor.key(); }
  void operator++() mut { ++this.cursor; }
  bool operator!=(unordered_map_sentinel end) { return this.cursor != end; }
  bool operator==(unordered_map_sentinel end) { return this.cursor == end; }
};
}
/// Unique immutable keys backed by the cached-hash chained dictionary.
class unordered_set<K, Hash = std::hash<K>, KeyEqual = std::equal_to<K>> {
  mut unordered_map<K, bool, Hash, KeyEqual> entries;
  unordered_map<K, bool, Hash, KeyEqual> replace(unordered_map<K, bool, Hash, KeyEqual> value) mut {
    auto previous = std::move(this.entries);
    this.entries = std::move(value);
    return std::move(previous);
  }
public:
  using key_type = K;
  using value_type = K;
  using size_type = size_t;
  using iterator = detail::unordered_set_insert_iterator<K>;
  using const_iterator = detail::unordered_set_key_iterator<K>;
  using sentinel = detail::unordered_map_sentinel;
  static unordered_set<K, Hash, KeyEqual> collection_init(uint64_t count)
      requires std::default_initializable<Hash> && std::default_initializable<KeyEqual> &&
          std::read_callable<Hash, K, std::size_t> && std::read_binary_callable<KeyEqual, K, K, bool> {
    mut unordered_set<K, Hash, KeyEqual> result{};
    result.reserve(count);
    return std::move(result);
  }
  static unordered_set<K, Hash, KeyEqual> collection_insert(
      mut unordered_set<K, Hash, KeyEqual> collection, K element)
      requires std::movable<K> && std::read_callable<Hash, K, std::size_t> &&
          std::read_binary_callable<KeyEqual, K, K, bool> {
    collection.insert(std::move(element));
    return std::move(collection);
  }
  unordered_set() requires std::default_initializable<Hash> && std::default_initializable<KeyEqual> &&
      std::read_callable<Hash, K, std::size_t> && std::read_binary_callable<KeyEqual, K, K, bool>
      : entries(unordered_map<K, bool, Hash, KeyEqual>()) {}
  unordered_set(Hash hash, KeyEqual equal)
      requires std::read_callable<Hash, K, std::size_t> && std::read_binary_callable<KeyEqual, K, K, bool>
      : entries(unordered_map<K, bool, Hash, KeyEqual>(std::move(hash), std::move(equal))) {}
  unordered_set(unordered_set<K, Hash, KeyEqual>& other) = delete;
  unordered_set(unordered_set<K, Hash, KeyEqual>&& other) = default;
  size_t size() { return this.entries.size(); }
  bool empty() { return this.entries.empty(); }
  bool contains(K& key) { return this.entries.contains(key); }
  size_t count(K& key) { return this.entries.count(key); }
  [[discardable]] size_t erase(K& key) mut { return this.entries.erase(key); }
  void clear() mut { this.entries.clear(); }
  void swap(mut unordered_set<K, Hash, KeyEqual>& other) mut {
    auto previous = std::move(this.entries);
    this.entries = other.replace(std::move(previous));
  }
  size_t bucket_count() { return this.entries.bucket_count(); }
  size_t bucket(K& key) { return this.entries.bucket(key); }
  size_t bucket_size(size_t index) { return this.entries.bucket_size(index); }
  float load_factor() { return this.entries.load_factor(); }
  float max_load_factor() { return this.entries.max_load_factor(); }
  void max_load_factor(float value) mut { this.entries.max_load_factor(value); }
  void reserve(size_t count) mut { this.entries.reserve(count); }
  void rehash(size_t count) mut { this.entries.rehash(count); }
  const_iterator begin() { return const_iterator(this.entries.begin()); }
  const_iterator end_iterator() { return const_iterator(this.entries.end_iterator()); }
  const_iterator cbegin() { return this.begin(); }
  sentinel cend() { return this.end(); }
  detail::unordered_map_sentinel end() { return this.entries.end(); }
  const_iterator find(K& key) { return const_iterator(this.entries.find(key)); }
  [[discardable]] pair<iterator, bool> insert(K key) mut {
    mut auto result = this.entries.insert(std::move(key), true);
    bool inserted = result.second;
    return pair<iterator, bool>(iterator(std::move(result.first)), inserted);
  }
  [[discardable]] pair<iterator, bool> emplace<Args...>(Args... args) mut { return this.insert(K(args...)); }
};
}
