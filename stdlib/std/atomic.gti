namespace gti_internal {
@compiler_constraint("atomic_scalar") concept atomic_scalar_capability<T>;
}

namespace std {
/// A scalar domain with a stable public atomic contract: bool and the
/// fixed-width signed and unsigned integer types.
concept atomic_scalar<T> =
    gti_internal::atomic_scalar_capability<T> && std::copyable<T> &&
    std::default_initializable<T> && std::transferable<T> &&
    std::shareable<T>;

/// Static tag selecting relaxed atomic ordering.
struct memory_order_relaxed {
  /// Static tag selecting relaxed atomic ordering.
  constexpr memory_order_relaxed() {}
};
/// Static tag selecting acquire atomic ordering.
struct memory_order_acquire {
  /// Static tag selecting acquire atomic ordering.
  constexpr memory_order_acquire() {}
};
/// Static tag selecting release atomic ordering.
struct memory_order_release {
  /// Static tag selecting release atomic ordering.
  constexpr memory_order_release() {}
};
/// Static tag selecting acquire-release atomic ordering.
struct memory_order_acq_rel {
  /// Static tag selecting acquire-release atomic ordering.
  constexpr memory_order_acq_rel() {}
};
/// Static tag selecting sequentially consistent atomic ordering.
struct memory_order_seq_cst {
  /// Static tag selecting sequentially consistent atomic ordering.
  constexpr memory_order_seq_cst() {}
};

/// Result of one strong atomic compare/exchange operation.
class atomic_compare_exchange_result<std::atomic_scalar T> {
  bool exchanged_value;
  T observed_value;

public:
  atomic_compare_exchange_result(bool exchanged, T observed)
      : exchanged_value(exchanged), observed_value(observed) {}

  /// True when the desired value replaced the expected value.
  bool exchanged() {
    return this.exchanged_value;
  }

  /// The value observed immediately before the compare/exchange decision.
  T observed() {
    return this.observed_value;
  }
};
}

namespace gti_internal {
/// Compiler-owned scalar atomic representation. The declaration identity, not
/// this source spelling, selects the backend capability.
class atomic_storage<std::atomic_scalar T> {
public:
  atomic_storage(T value) {}
};

T atomic_load<std::atomic_scalar T>(gti_internal::atomic_storage<T>& storage);
T atomic_load_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage);
T atomic_load_acquire<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage);
void atomic_wait<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T old);
void atomic_wait_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T old);
void atomic_wait_acquire<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T old);
void atomic_notify_one<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage);
void atomic_notify_all<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage);
void atomic_store<std::atomic_scalar T>(gti_internal::atomic_storage<T>& storage,
                                        T value);
void atomic_store_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T value);
void atomic_store_release<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T value);
T atomic_exchange<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T value);
T atomic_exchange_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T value);
T atomic_exchange_acquire<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T value);
T atomic_exchange_release<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T value);
T atomic_exchange_acq_rel<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T value);
bool atomic_compare_exchange<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_relaxed_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_acquire_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_acquire_acquire<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_release_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_acq_rel_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_acq_rel_acquire<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_seq_cst_relaxed<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
bool atomic_compare_exchange_seq_cst_acquire<std::atomic_scalar T>(
    gti_internal::atomic_storage<T>& storage, T expected_value, T desired,
    mut T& observed);
}

namespace std {
/// A share-safe atomic bool or fixed-width integer.
///
/// Operations without an order argument are sequentially consistent. Explicit
/// static order tags select only combinations valid for that operation. The
/// fixed-width integer domain also has source-defined fetch add/subtract and
/// bitwise operations; add/subtract retain checked-overflow failure. The
/// value is move-only; GTI's borrow rules prevent moving it while shared
/// references are live, preserving the storage identity used by an operation.
class atomic<std::atomic_scalar T> {
  gti_internal::atomic_storage<T> storage;

  T fetch_update_impl<Update>(mut Update update) {
    mut T observed = gti_internal::atomic_load_relaxed(this.storage);
    while (true) {
      T desired = update(observed);
      mut T actual = observed;
      if (gti_internal::atomic_compare_exchange(
              this.storage, observed, desired, actual)) {
        return observed;
      }
      observed = actual;
    }
  }

  T fetch_update_impl<Update>(mut Update update,
                              memory_order_relaxed order) {
    mut T observed = gti_internal::atomic_load_relaxed(this.storage);
    while (true) {
      T desired = update(observed);
      mut T actual = observed;
      if (gti_internal::atomic_compare_exchange_relaxed_relaxed(
              this.storage, observed, desired, actual)) {
        return observed;
      }
      observed = actual;
    }
  }

  T fetch_update_impl<Update>(mut Update update,
                              memory_order_acquire order) {
    mut T observed = gti_internal::atomic_load_relaxed(this.storage);
    while (true) {
      T desired = update(observed);
      mut T actual = observed;
      if (gti_internal::atomic_compare_exchange_acquire_acquire(
              this.storage, observed, desired, actual)) {
        return observed;
      }
      observed = actual;
    }
  }

  T fetch_update_impl<Update>(mut Update update,
                              memory_order_release order) {
    mut T observed = gti_internal::atomic_load_relaxed(this.storage);
    while (true) {
      T desired = update(observed);
      mut T actual = observed;
      if (gti_internal::atomic_compare_exchange_release_relaxed(
              this.storage, observed, desired, actual)) {
        return observed;
      }
      observed = actual;
    }
  }

  T fetch_update_impl<Update>(mut Update update,
                              memory_order_acq_rel order) {
    mut T observed = gti_internal::atomic_load_relaxed(this.storage);
    while (true) {
      T desired = update(observed);
      mut T actual = observed;
      if (gti_internal::atomic_compare_exchange_acq_rel_acquire(
              this.storage, observed, desired, actual)) {
        return observed;
      }
      observed = actual;
    }
  }

  T fetch_update_impl<Update>(mut Update update,
                              memory_order_seq_cst order) {
    mut T observed = gti_internal::atomic_load_relaxed(this.storage);
    while (true) {
      T desired = update(observed);
      mut T actual = observed;
      if (gti_internal::atomic_compare_exchange(
              this.storage, observed, desired, actual)) {
        return observed;
      }
      observed = actual;
    }
  }

public:
  /// Creates one atomic scalar initialized to `value`.
  atomic(T value)
      : storage(gti_internal::atomic_storage<T>(value)) {}
  atomic(atomic<T>& other) = delete;
  atomic(atomic<T>&& other) = default;

  /// Returns the current value with sequentially consistent ordering.
  T load() {
    return gti_internal::atomic_load(this.storage);
  }

  /// Returns the current value without creating a synchronizes-with edge.
  T load(memory_order_relaxed order) {
    return gti_internal::atomic_load_relaxed(this.storage);
  }

  /// Returns the current value with acquire ordering.
  T load(memory_order_acquire order) {
    return gti_internal::atomic_load_acquire(this.storage);
  }

  /// Returns the current value with sequentially consistent ordering.
  T load(memory_order_seq_cst order) {
    return gti_internal::atomic_load(this.storage);
  }

  /// Replaces the current value with sequentially consistent ordering.
  void store(T value) {
    gti_internal::atomic_store(this.storage, value);
  }

  /// Blocks until a load observes a value different from `old`. Notification
  /// alone does not change the value or publish other data. A transient change
  /// away from `old` and back may be missed; use a generation counter when needed.
  void wait(T old) {
    gti_internal::atomic_wait(this.storage, old);
  }

  void wait(T old, memory_order_relaxed order) {
    gti_internal::atomic_wait_relaxed(this.storage, old);
  }

  void wait(T old, memory_order_acquire order) {
    gti_internal::atomic_wait_acquire(this.storage, old);
  }

  void wait(T old, memory_order_seq_cst order) {
    gti_internal::atomic_wait(this.storage, old);
  }

  /// Wakes at least one eligible blocked waiter, if present. No notification
  /// credit is retained and a waiter rechecks its value before returning.
  void notify_one() {
    gti_internal::atomic_notify_one(this.storage);
  }

  /// Wakes all eligible blocked waiters, if present.
  void notify_all() {
    gti_internal::atomic_notify_all(this.storage);
  }

  /// Replaces the current value without creating a synchronizes-with edge.
  void store(T value, memory_order_relaxed order) {
    gti_internal::atomic_store_relaxed(this.storage, value);
  }

  /// Replaces the current value with release ordering.
  void store(T value, memory_order_release order) {
    gti_internal::atomic_store_release(this.storage, value);
  }

  /// Replaces the current value with sequentially consistent ordering.
  void store(T value, memory_order_seq_cst order) {
    gti_internal::atomic_store(this.storage, value);
  }

  /// Replaces and returns the prior value with sequentially consistent
  /// ordering.
  T exchange(T value) {
    return gti_internal::atomic_exchange(this.storage, value);
  }

  /// Replaces and returns the prior value with relaxed ordering.
  T exchange(T value, memory_order_relaxed order) {
    return gti_internal::atomic_exchange_relaxed(this.storage, value);
  }

  /// Replaces and returns the prior value with acquire ordering.
  T exchange(T value, memory_order_acquire order) {
    return gti_internal::atomic_exchange_acquire(this.storage, value);
  }

  /// Replaces and returns the prior value with release ordering.
  T exchange(T value, memory_order_release order) {
    return gti_internal::atomic_exchange_release(this.storage, value);
  }

  /// Replaces and returns the prior value with acquire-release ordering.
  T exchange(T value, memory_order_acq_rel order) {
    return gti_internal::atomic_exchange_acq_rel(this.storage, value);
  }

  /// Replaces and returns the prior value with sequentially consistent
  /// ordering.
  T exchange(T value, memory_order_seq_cst order) {
    return gti_internal::atomic_exchange(this.storage, value);
  }

  /// Strongly compares with `expected_value`, conditionally stores `desired`,
  /// and reports both success and the observed value. This operation never
  /// fails spuriously and is sequentially consistent.
  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  /// Strong compare/exchange using the supplied success order and its standard
  /// derived failure order.
  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_relaxed order) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_relaxed_relaxed(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_acquire order) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_acquire_acquire(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_release order) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_release_relaxed(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_acq_rel order) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_acq_rel_acquire(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_seq_cst order) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  /// Strong compare/exchange using explicit success and failure orders. Only
  /// the nine valid static type pairs have overloads.
  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_relaxed success,
      memory_order_relaxed failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_relaxed_relaxed(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_acquire success,
      memory_order_relaxed failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_acquire_relaxed(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_acquire success,
      memory_order_acquire failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_acquire_acquire(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_release success,
      memory_order_relaxed failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_release_relaxed(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_acq_rel success,
      memory_order_relaxed failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_acq_rel_relaxed(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_acq_rel success,
      memory_order_acquire failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_acq_rel_acquire(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_seq_cst success,
      memory_order_relaxed failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_seq_cst_relaxed(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_seq_cst success,
      memory_order_acquire failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange_seq_cst_acquire(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  atomic_compare_exchange_result<T> compare_exchange_strong(
      T expected_value, T desired, memory_order_seq_cst success,
      memory_order_seq_cst failure) {
    mut T observed = expected_value;
    bool exchanged = gti_internal::atomic_compare_exchange(
        this.storage, expected_value, desired, observed);
    return atomic_compare_exchange_result<T>(exchanged, observed);
  }

  /// Atomically adds `operand`, returning the prior value. Integer arithmetic
  /// is checked before each compare/exchange attempt; overflow raises defined
  /// failure without publishing that attempted update.
  T fetch_add(T operand) requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed + operand);
    });
  }

  T fetch_add(T operand, memory_order_relaxed order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed + operand);
    }, order);
  }

  T fetch_add(T operand, memory_order_acquire order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed + operand);
    }, order);
  }

  T fetch_add(T operand, memory_order_release order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed + operand);
    }, order);
  }

  T fetch_add(T operand, memory_order_acq_rel order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed + operand);
    }, order);
  }

  T fetch_add(T operand, memory_order_seq_cst order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed + operand);
    }, order);
  }

  /// Atomically subtracts `operand`, returning the prior value. Integer
  /// arithmetic is checked before each compare/exchange attempt.
  T fetch_sub(T operand) requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed - operand);
    });
  }

  T fetch_sub(T operand, memory_order_relaxed order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed - operand);
    }, order);
  }

  T fetch_sub(T operand, memory_order_acquire order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed - operand);
    }, order);
  }

  T fetch_sub(T operand, memory_order_release order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed - operand);
    }, order);
  }

  T fetch_sub(T operand, memory_order_acq_rel order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed - operand);
    }, order);
  }

  T fetch_sub(T operand, memory_order_seq_cst order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed - operand);
    }, order);
  }

  /// Atomically applies bitwise AND with `operand`, returning the prior value.
  T fetch_and(T operand) requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed & operand);
    });
  }

  T fetch_and(T operand, memory_order_relaxed order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed & operand);
    }, order);
  }

  T fetch_and(T operand, memory_order_acquire order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed & operand);
    }, order);
  }

  T fetch_and(T operand, memory_order_release order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed & operand);
    }, order);
  }

  T fetch_and(T operand, memory_order_acq_rel order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed & operand);
    }, order);
  }

  T fetch_and(T operand, memory_order_seq_cst order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed & operand);
    }, order);
  }

  /// Atomically applies bitwise OR with `operand`, returning the prior value.
  T fetch_or(T operand) requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed | operand);
    });
  }

  T fetch_or(T operand, memory_order_relaxed order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed | operand);
    }, order);
  }

  T fetch_or(T operand, memory_order_acquire order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed | operand);
    }, order);
  }

  T fetch_or(T operand, memory_order_release order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed | operand);
    }, order);
  }

  T fetch_or(T operand, memory_order_acq_rel order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed | operand);
    }, order);
  }

  T fetch_or(T operand, memory_order_seq_cst order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed | operand);
    }, order);
  }

  /// Atomically applies bitwise XOR with `operand`, returning the prior value.
  T fetch_xor(T operand) requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed ^ operand);
    });
  }

  T fetch_xor(T operand, memory_order_relaxed order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed ^ operand);
    }, order);
  }

  T fetch_xor(T operand, memory_order_acquire order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed ^ operand);
    }, order);
  }

  T fetch_xor(T operand, memory_order_release order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed ^ operand);
    }, order);
  }

  T fetch_xor(T operand, memory_order_acq_rel order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed ^ operand);
    }, order);
  }

  T fetch_xor(T operand, memory_order_seq_cst order)
      requires std::integral<T> {
    return this.fetch_update_impl([operand](T observed) -> T {
      return T(observed ^ operand);
    }, order);
  }
};
}
