#include <std/span>

// The storage-backed value, capacity, indexed operations, move-aware
// insertion/erasure, and bounded read-only/mutable iteration are implemented.
namespace std {
namespace detail {
class vector_sentinel {
  size_t final_position;

public:
  vector_sentinel(size_t position) : final_position(position) {}

  size_t position() {
    return this.final_position;
  }
};

class vector_iterator<T> {
  gti_internal::prefix_storage<T>& data;
  mut size_t current_position;

public:
  vector_iterator(gti_internal::prefix_storage<T>& source, size_t position)
      : data(source), current_position(position) {}

  T& operator*() {
    return gti_internal::prefix_storage_read(this.data, this.current_position);
  }

  void operator++() mut {
    this.current_position++;
  }

  bool operator!=(vector_sentinel& sentinel) {
    return this.current_position != sentinel.position();
  }

  bool operator!=(vector_iterator<T>& other) {
    return this.current_position != other.current_position;
  }
};

// This mutable storage dependency is an ephemeral standard-library carrier.
// Semantics permits it only when the compiler-generated range iterator keeps
// it on the range's exclusive loan; ordinary local storage remains rejected.
class vector_mut_iterator<T> {
  mut gti_internal::prefix_storage<T>& data;
  mut size_t current_position;

public:
  vector_mut_iterator(mut gti_internal::prefix_storage<T>& source,
                      size_t position)
      : data(source), current_position(position) {}

  T& operator*() {
    return gti_internal::prefix_storage_read(this.data,
                                              this.current_position);
  }

  mut T& operator*() mut {
    return gti_internal::prefix_storage_read_mut(this.data,
                                                  this.current_position);
  }

  void operator++() mut {
    this.current_position++;
  }

  bool operator!=(vector_sentinel& sentinel) {
    return this.current_position != sentinel.position();
  }
};
}

/// An owning, move-only, contiguous sequence of `T` values.
class vector<std::movable T> {
  mut gti_internal::prefix_storage<T> data;
  mut size_t reserved = 0;

  void ensure_capacity_for_one() mut {
    size_t live = gti_internal::prefix_storage_length(this.data);
    if (live < this.reserved) {
      return;
    }

    mut size_t grown = this.reserved * 2;
    if (grown <= live) {
      grown = live + 1;
    }
    this.reserve(grown);
  }

public:
  vector() : data(gti_internal::allocate_prefix_storage<T>(uint64_t(0))) {}

  vector(size_t initial_size)
      : data(gti_internal::allocate_prefix_storage<T>(initial_size)),
        reserved(initial_size) {
    while (gti_internal::prefix_storage_length(this.data) < initial_size) {
      gti_internal::prefix_storage_append(this.data);
    }
  }

  vector<uint64_t N>(T initial[N])
      : data(gti_internal::allocate_prefix_storage<T>(N)), reserved(N) {
    while (gti_internal::prefix_storage_length(this.data) < N) {
      size_t index = gti_internal::prefix_storage_length(this.data);
      gti_internal::prefix_storage_append(this.data, initial[index]);
    }
  }

  vector(vector<T>& other) = delete;
  vector(vector<T>&& other) = default;

  /// Returns the number of live elements.
  size_t size() {
    return gti_internal::prefix_storage_length(this.data);
  }

  /// Returns the number of elements that fit without growing storage.
  size_t capacity() {
    return this.reserved;
  }

  /// Returns whether the vector contains no elements.
  bool empty() {
    return gti_internal::prefix_storage_length(this.data) == 0;
  }

  T& front() {
    size_t live = gti_internal::prefix_storage_length(this.data);
    size_t index = size_t(0);
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read(this.data, index);
  }

  mut T& front() mut {
    size_t live = gti_internal::prefix_storage_length(this.data);
    size_t index = size_t(0);
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read_mut(this.data, index);
  }

  T& back() {
    size_t live = gti_internal::prefix_storage_length(this.data);
    mut size_t index = size_t(0);
    if (live > 0) {
      index = live - 1;
    }
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read(this.data, index);
  }

  mut T& back() mut {
    size_t live = gti_internal::prefix_storage_length(this.data);
    mut size_t index = size_t(0);
    if (live > 0) {
      index = live - 1;
    }
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read_mut(this.data, index);
  }

  T& at(size_t index) {
    size_t live = gti_internal::prefix_storage_length(this.data);
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read(this.data, index);
  }

  mut T& at(size_t index) mut {
    size_t live = gti_internal::prefix_storage_length(this.data);
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read_mut(this.data, index);
  }

  T& operator[](size_t index) {
    size_t live = gti_internal::prefix_storage_length(this.data);
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read(this.data, index);
  }

  mut T& operator[](size_t index) mut {
    size_t live = gti_internal::prefix_storage_length(this.data);
    gti_internal::index_bounds_check(index, live);
    return gti_internal::prefix_storage_read_mut(this.data, index);
  }

  detail::vector_iterator<T> begin() {
    return detail::vector_iterator<T>(this.data, size_t(0));
  }

  detail::vector_mut_iterator<T> begin_mut() mut {
    return detail::vector_mut_iterator<T>(this.data, size_t(0));
  }

  detail::vector_sentinel end() {
    return detail::vector_sentinel(
        gti_internal::prefix_storage_length(this.data));
  }

  /// Returns a checked read-only view tied to this vector's storage.
  span<T> as_span() {
    return span<T>(this.data, size_t(0),
                   gti_internal::prefix_storage_length(this.data));
  }

  void reserve(size_t requested) mut {
    if (requested <= this.reserved) {
      return;
    }

    mut gti_internal::prefix_storage<T> replacement =
        gti_internal::allocate_prefix_storage<T>(requested);
    gti_internal::prefix_storage_relocate(this.data, replacement);
    this.data = std::move(replacement);
    this.reserved = requested;
  }

  void resize(size_t requested) mut
    requires std::default_initializable<T> {
    while (gti_internal::prefix_storage_length(this.data) > requested) {
      gti_internal::prefix_storage_pop(this.data);
    }
    this.reserve(requested);
    while (gti_internal::prefix_storage_length(this.data) < requested) {
      gti_internal::prefix_storage_append(this.data);
    }
  }

  void resize(size_t requested, T value) mut
    requires std::copyable<T> {
    while (gti_internal::prefix_storage_length(this.data) > requested) {
      gti_internal::prefix_storage_pop(this.data);
    }
    this.reserve(requested);
    while (gti_internal::prefix_storage_length(this.data) < requested) {
      gti_internal::prefix_storage_append(this.data, value);
    }
  }

  void shrink_to_fit() mut {
    size_t live = gti_internal::prefix_storage_length(this.data);
    if (this.reserved == live) {
      return;
    }
    mut gti_internal::prefix_storage<T> replacement =
        gti_internal::allocate_prefix_storage<T>(live);
    gti_internal::prefix_storage_relocate(this.data, replacement);
    this.data = std::move(replacement);
    this.reserved = live;
  }

  void push_back(T value) mut {
    this.ensure_capacity_for_one();
    gti_internal::prefix_storage_append(this.data, std::move(value));
  }

  void insert(size_t index, T value) mut {
    this.ensure_capacity_for_one();
    gti_internal::prefix_storage_insert(this.data, index, std::move(value));
  }

  mut T& emplace_back<Args...>(Args... args) mut {
    this.ensure_capacity_for_one();
    size_t index = gti_internal::prefix_storage_length(this.data);
    gti_internal::prefix_storage_append(this.data, args...);
    return gti_internal::prefix_storage_read_mut(this.data, index);
  }

  void pop_back() mut {
    if (gti_internal::prefix_storage_length(this.data) == 0) {
      return;
    }
    gti_internal::prefix_storage_pop(this.data);
  }

  void erase(size_t index) mut {
    gti_internal::prefix_storage_erase(this.data, index);
  }

  void clear() mut {
    while (gti_internal::prefix_storage_length(this.data) > 0) {
      gti_internal::prefix_storage_pop(this.data);
    }
  }

  void swap(mut vector<T>& other) mut;

  vector<T> clone()
    requires std::copyable<T> {
    mut vector<T> result = vector<T>();
    size_t live = gti_internal::prefix_storage_length(this.data);
    result.reserve(live);
    for (mut size_t index = 0; index < live; index++) {
      result.push_back(gti_internal::prefix_storage_read(this.data, index));
    }
    return std::move(result);
  }
};
}
