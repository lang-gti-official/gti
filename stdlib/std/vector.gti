#include <std/span>
#include <std/utility>
#include <std/memory>

// The storage-backed value, capacity, indexed operations, move-aware
// insertion/erasure, and bounded read-only/mutable iteration are implemented.
namespace std {
// Capacity changes and shifts use generated, failure-free relocation, never
// custom movement or assignment. Independent storage excludes checked borrows.
concept vector_element<T> = std::relocatable<T> && std::storage_element<T>;
namespace detail {
class vector_sentinel {
  size_t final_position;

public:
  vector_sentinel(size_t position) : final_position(position) {}

  size_t position() {
    return this.final_position;
  }
};

class vector_iterator<std::storage_element T> {
  std::detail::prefix_owner<T>& data;
  mut size_t current_position;

public:
  vector_iterator(std::detail::prefix_owner<T>& source, size_t position)
      : data(source), current_position(position) {}

  T& operator*() {
    return this.data.read(this.current_position);
  }

  void operator++() mut {
    this.current_position++;
  }

  // Backward and signed movement keep checked position arithmetic: stepping
  // or jumping before position zero raises the defined unsigned-range
  // failure, and every read remains prefix-checked at the access itself.
  void operator--() mut {
    this.current_position--;
  }

  void operator+=(ptrdiff_t distance) mut {
    this.current_position = size_t(ptrdiff_t(this.current_position) + distance);
  }

  void operator-=(ptrdiff_t distance) mut {
    this.current_position = size_t(ptrdiff_t(this.current_position) - distance);
  }

  // The signed distance from this iterator to the sentinel; positive while
  // the sentinel is ahead.
  ptrdiff_t operator-(vector_sentinel sentinel) {
    return ptrdiff_t(sentinel.position()) - ptrdiff_t(this.current_position);
  }

  bool operator!=(vector_sentinel sentinel) {
    return this.current_position != sentinel.position();
  }

  bool operator!=(vector_iterator<T>& other) {
    return this.current_position != other.current_position;
  }
};

// This mutable storage dependency is an ephemeral standard-library carrier.
// Semantics permits it only when the compiler-generated range iterator keeps
// it on the range's exclusive loan; ordinary local storage remains rejected.
class vector_mut_iterator<std::storage_element T> {
  mut std::detail::prefix_owner<T>& data;
  mut size_t current_position;

public:
  vector_mut_iterator(mut std::detail::prefix_owner<T>& source,
                      size_t position)
      : data(source), current_position(position) {}

  T& operator*() {
    return this.data.read(
                                              this.current_position);
  }

  mut T& operator*() mut {
    return this.data.read_mut(
                                                  this.current_position);
  }

  void operator++() mut {
    this.current_position++;
  }

  bool operator!=(vector_sentinel sentinel) {
    return this.current_position != sentinel.position();
  }
};
}

/// An owning, move-only, contiguous sequence of `T` values.
class vector<std::vector_element T> {
  mut std::detail::prefix_owner<T> data;

  std::detail::prefix_owner<T> replace_storage(
      std::detail::prefix_owner<T> replacement) mut {
    auto previous = std::move(this.data);
    this.data = std::move(replacement);
    return std::move(previous);
  }

  void ensure_capacity_for_one() mut {
    size_t live = this.data.length();
    size_t capacity = this.data.capacity();
    if (live < capacity) {
      return;
    }

    mut size_t grown = capacity * 2;
    if (grown <= live) {
      grown = live + 1;
    }
    this.reserve(grown);
  }

public:
  using iterator = detail::vector_mut_iterator<T>;
  using const_iterator = detail::vector_iterator<T>;
  using sentinel = detail::vector_sentinel;

  vector() : data(std::detail::prefix_owner<T>(uint64_t(0))) {}

  /// Collection-brace protocol: reserve once, then consume each owned element.
  static vector<T> collection_init(uint64_t count) {
    mut vector<T> result{};
    result.reserve(count);
    return std::move(result);
  }

  static vector<T> collection_insert(mut vector<T> collection, T element) {
    collection.push_back(std::move(element));
    return std::move(collection);
  }

  vector(size_t initial_size)
      : data(std::detail::prefix_owner<T>(initial_size)) {
    while (this.data.length() < initial_size) {
      this.data.append();
    }
  }

  vector<uint64_t N>(T initial[N])
      : data(std::detail::prefix_owner<T>(N)) {
    while (this.data.length() < N) {
      size_t index = this.data.length();
      this.data.append_value(initial[index]);
    }
  }

  vector(vector<T>& other) = delete;
  vector(vector<T>&& other) = default;

  /// Returns the number of live elements.
  size_t size() {
    return this.data.length();
  }

  /// Returns the number of elements that fit without growing storage.
  size_t capacity() {
    return this.data.capacity();
  }

  /// Check both live indices before mutation; equal valid indices are a no-op.
  void swap_elements(size_t left, size_t right) mut
    requires std::relocatable<T> {
    gti_internal::index_bounds_check(left, this.size());
    gti_internal::index_bounds_check(right, this.size());
    this.data.swap_elements(left, right);
  }

  /// Returns whether the vector contains no elements.
  bool empty() {
    return this.data.length() == 0;
  }

  T& front() {
    size_t live = this.data.length();
    size_t index = size_t(0);
    gti_internal::index_bounds_check(index, live);
    return this.data.read(index);
  }

  mut T& front() mut {
    size_t live = this.data.length();
    size_t index = size_t(0);
    gti_internal::index_bounds_check(index, live);
    return this.data.read_mut(index);
  }

  T& back() {
    size_t live = this.data.length();
    mut size_t index = size_t(0);
    if (live > 0) {
      index = live - 1;
    }
    gti_internal::index_bounds_check(index, live);
    return this.data.read(index);
  }

  mut T& back() mut {
    size_t live = this.data.length();
    mut size_t index = size_t(0);
    if (live > 0) {
      index = live - 1;
    }
    gti_internal::index_bounds_check(index, live);
    return this.data.read_mut(index);
  }

  T& at(size_t index) {
    size_t live = this.data.length();
    gti_internal::index_bounds_check(index, live);
    return this.data.read(index);
  }

  mut T& at(size_t index) mut {
    size_t live = this.data.length();
    gti_internal::index_bounds_check(index, live);
    return this.data.read_mut(index);
  }

  T& operator[](size_t index) {
    size_t live = this.data.length();
    gti_internal::index_bounds_check(index, live);
    return this.data.read(index);
  }

  mut T& operator[](size_t index) mut {
    size_t live = this.data.length();
    gti_internal::index_bounds_check(index, live);
    return this.data.read_mut(index);
  }

  const_iterator begin() {
    return detail::vector_iterator<T>(this.data, size_t(0));
  }

  iterator begin_mut() mut {
    return detail::vector_mut_iterator<T>(this.data, size_t(0));
  }

  sentinel end() {
    return detail::vector_sentinel(
        this.data.length());
  }

  /// Returns a checked read-only view tied to this vector's storage.
  span<T> as_span() {
    return span<T>(this.data, size_t(0),
                   this.data.length());
  }

  /// Exclusively borrows initialized elements without permitting reallocation.
  mutable_span<T> as_mutable_span() mut {
    size_t count = this.data.length();
    return mutable_span<T>(this.data, size_t(0), count);
  }

  void reserve(size_t requested) mut {
    if (requested <= this.data.capacity()) {
      return;
    }

    mut std::detail::prefix_owner<T> replacement =
        std::detail::prefix_owner<T>(requested);
    this.data.relocate_to(replacement);
    this.data = std::move(replacement);
  }

  void resize(size_t requested) mut
    requires std::default_initializable<T> {
    while (this.data.length() > requested) {
      this.data.pop();
    }
    this.reserve(requested);
    while (this.data.length() < requested) {
      this.data.append();
    }
  }

  void resize(size_t requested, T value) mut
    requires std::copyable<T> {
    while (this.data.length() > requested) {
      this.data.pop();
    }
    this.reserve(requested);
    while (this.data.length() < requested) {
      this.data.append_value(value);
    }
  }

  void shrink_to_fit() mut {
    size_t live = this.data.length();
    if (this.data.capacity() == live) {
      return;
    }
    mut std::detail::prefix_owner<T> replacement =
        std::detail::prefix_owner<T>(live);
    this.data.relocate_to(replacement);
    this.data = std::move(replacement);
  }

  void push_back(T value) mut {
    this.ensure_capacity_for_one();
    this.data.append_value(std::move(value));
  }

  void insert(size_t index, T value) mut {
    this.ensure_capacity_for_one();
    this.data.insert( index, std::move(value));
  }

  mut T& emplace_back<Args...>(Args... args) mut {
    this.ensure_capacity_for_one();
    size_t index = this.data.length();
    this.data.append(args...);
    return this.data.read_mut(index);
  }

  void pop_back() mut {
    if (this.data.length() == 0) {
      return;
    }
    this.data.pop();
  }

  void erase(size_t index) mut {
    gti_internal::index_bounds_check(index, this.size());
    this.data.erase(index);
  }

  void clear() mut {
    while (this.data.length() > 0) {
      this.data.pop();
    }
  }

  /// Exchanges storage and capacity without allocating or moving elements.
  void swap(mut vector<T>& other) mut {
    auto previous = std::move(this.data);
    this.data = other.replace_storage(std::move(previous));
  }

  /// Duplicates each element using its clone contract (or ordinary copying).
  vector<T> clone() requires std::cloneable<T> {
    mut vector<T> result = vector<T>();
    size_t live = this.data.length();
    result.reserve(live);
    for (mut size_t index = 0; index < live; index++) {
      result.push_back(
          std::clone(this.data.read(index)));
    }
    return std::move(result);
  }
};
}
