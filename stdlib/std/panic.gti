// Public, cleanup-preserving terminal failures. Formatting uses the same
// source-defined formatter as other APIs; message capture itself never formats.
#include <std/format>
#include <std/string>
#include <std/detail/panic>

namespace std {
  /// Stops normal execution after preserving the message and running cleanup.
  [[noreturn, track_caller]]
  void panic(string_view message) {
    detail::panic(message);
  }

  /// Formats a terminal message. A format error uses a bounded literal fallback
  /// rather than recursively attempting to format another panic message.
  [[noreturn, track_caller]]
  void panic<First, Args...>(string_view pattern, First first, Args... args) requires formattable<First> {
    mut expected<std::string, std::format_errc> message =
        std::try_format(pattern, std::move(first), args...);
    if (message) {
      panic(message.value().view());
    }
    switch (message.error()) {
    case format_errc::invalid_format:
      panic("Panic message formatting failed: invalid format");
    case format_errc::argument_count_mismatch:
      panic("Panic message formatting failed: argument count mismatch");
    case format_errc::unsupported_argument:
      panic("Panic message formatting failed: unsupported argument");
    }
    panic("Panic message formatting failed: unknown format error");
  }
}
