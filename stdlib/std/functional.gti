#include <std/memory>
#include <std/polymorphic>

// Callable relationships and source-defined owning callback policy.

namespace gti_internal {
// Non-null GTI invocation address with its defined-failure convention. This
// is not a C function pointer and never retains a callable environment.
class function_pointer<Signature> {};
function_pointer<Signature> function_pointer_from_item<Signature, F>(F target);
R function_pointer_invoke<R, Args...>(function_pointer<R(Args...)>& target,
                                    Args... args);
@compiler_constraint("read_callable") concept read_callable_capability<Callable, Argument, Result>;
@compiler_constraint("mut_callable") concept mut_callable_capability<Callable, Argument, Result>;
@compiler_constraint("once_callable") concept once_callable_capability<Callable, Argument, Result>;
@compiler_constraint("read_binary_callable") concept read_binary_callable_capability<Callable, Left, Right, Result>;
@compiler_constraint("mut_binary_callable") concept mut_binary_callable_capability<Callable, Left, Right, Result>;
@compiler_constraint("once_binary_callable") concept once_binary_callable_capability<Callable, Left, Right, Result>;
@compiler_constraint("once_action") concept once_action_capability<Callable>;
@compiler_constraint("indirect_predicate") concept indirect_predicate_capability<Callable, Iterator>;
@compiler_constraint("indirect_operation") concept indirect_operation_capability<Callable, Iterator, Result>;
@compiler_constraint("range_predicate") concept range_predicate_capability<Callable, Range>;
@compiler_constraint("range_operation") concept range_operation_capability<Callable, Range, Result>;

// Each repeatable wrapper owns one erased model. A model that is an inline
// polymorphic payload and fits the 32-byte slot lives inside the wrapper; any
// other model is boxed. Moving a wrapper relocates an inline model with it.
// Once-callable wrappers keep a boxed target: consuming invocation projects
// ownership through a transparent unique-owner accessor, which the inline
// slot does not provide yet.
interface function_target<R, Args...> {
  R invoke(Args... args);
  void clone_into(mut std::inline_polymorphic<function_target<R, Args...>, 32, 8>& destination);
};

class function_model<Callable, R, Args...> : public function_target<R, Args...> {
  Callable callable;
public:
  function_model(Callable callable) : callable(std::move(callable)) {}
  R invoke(Args... args) override { return this.callable(args...); }
  void clone_into(mut std::inline_polymorphic<function_target<R, Args...>, 32, 8>& destination) override {
    destination.replace(function_model<Callable, R, Args...>(this.callable));
  }
};

class function_signature<Signature> {};

interface move_function_target<R, Args...> {
  R invoke(Args... args);
};

// Capability-qualified erasure retains a proof about every possible target.
// It does not grant concurrent invocation: these interfaces require transfer
// only, and implementations prove it through their ordinary captured fields.
[[transfer]] interface transfer_function_target<R, Args...> {
  R invoke(Args... args);
};

class transfer_function_model<std::transferable Callable, R, Args...>
    : public transfer_function_target<R, Args...> {
  Callable callable;
public:
  transfer_function_model(Callable value) : callable(std::move(value)) {}
  R invoke(Args... args) override { return this.callable(args...); }
};

[[transfer]] interface mut_transfer_function_target<R, Args...> {
  R invoke(Args... args) mut;
};

class mut_transfer_function_model<std::transferable Callable, R, Args...>
    : public mut_transfer_function_target<R, Args...> {
  mut Callable callable;
public:
  mut_transfer_function_model(Callable value) : callable(std::move(value)) {}
  R invoke(Args... args) mut override { return this.callable(args...); }
};

[[transfer]] interface once_transfer_function_target<R, Args...> {
  R operator()(Args... args) &&;
};

class once_transfer_function_model<std::transferable Callable, R, Args...>
    : public once_transfer_function_target<R, Args...> {
  mut Callable callable;
public:
  once_transfer_function_model(Callable value) : callable(std::move(value)) {}
  R operator()(Args... args) && override { return std::move(this.callable)(args...); }
};

std::unique_ptr<once_transfer_function_target<R, Args...>>
make_once_transfer_function_target<R, std::transferable Callable, Args...>(
    Callable callable, function_signature<R(Args...) &&>& signature) {
  auto model = std::make_unique<once_transfer_function_model<Callable, R, Args...>>(
      std::move(callable));
  return std::upcast_unique<once_transfer_function_target<R, Args...>,
      once_transfer_function_model<Callable, R, Args...>>(std::move(model));
}

class move_function_model<Callable, R, Args...> : public move_function_target<R, Args...> {
  Callable callable;
public:
  move_function_model(Callable callable) : callable(std::move(callable)) {}
  R invoke(Args... args) override { return this.callable(args...); }
};

interface once_function_target<R, Args...> {
  R operator()(Args... args) &&;
  std::unique_ptr<once_function_target<R, Args...>> clone();
};

class once_function_model<Callable, R, Args...> : public once_function_target<R, Args...> {
  mut Callable callable;
public:
  once_function_model(Callable callable) : callable(std::move(callable)) {}
  R operator()(Args... args) && override { return std::move(this.callable)(args...); }
  std::unique_ptr<once_function_target<R, Args...>> clone() override {
    auto model = std::make_unique<once_function_model<Callable, R, Args...>>(this.callable);
    return std::upcast_unique<once_function_target<R, Args...>, once_function_model<Callable, R, Args...>>(
        std::move(model));
  }
};

std::unique_ptr<once_function_target<R, Args...>> make_once_function_target<R, Callable, Args...>(
    Callable callable, function_signature<R(Args...) &&>& signature) {
  auto model = std::make_unique<once_function_model<Callable, R, Args...>>(std::move(callable));
  return std::upcast_unique<once_function_target<R, Args...>, once_function_model<Callable, R, Args...>>(
      std::move(model));
}

interface once_move_function_target<R, Args...> {
  R operator()(Args... args) &&;
};

class once_move_function_model<Callable, R, Args...> : public once_move_function_target<R, Args...> {
  mut Callable callable;
public:
  once_move_function_model(Callable callable) : callable(std::move(callable)) {}
  R operator()(Args... args) && override { return std::move(this.callable)(args...); }
};

std::unique_ptr<once_move_function_target<R, Args...>> make_once_move_function_target<R, Callable, Args...>(
    Callable callable, function_signature<R(Args...) &&>& signature) {
  auto model = std::make_unique<once_move_function_model<Callable, R, Args...>>(std::move(callable));
  return std::upcast_unique<once_move_function_target<R, Args...>, once_move_function_model<Callable, R, Args...>>(
      std::move(model));
}

interface mut_function_target<R, Args...> {
  R invoke(Args... args) mut;
  void clone_into(mut std::inline_polymorphic<mut_function_target<R, Args...>, 32, 8>& destination);
};

class mut_function_model<Callable, R, Args...> : public mut_function_target<R, Args...> {
  mut Callable callable;
public:
  mut_function_model(Callable callable) : callable(std::move(callable)) {}
  R invoke(Args... args) mut override { return this.callable(args...); }
  void clone_into(mut std::inline_polymorphic<mut_function_target<R, Args...>, 32, 8>& destination) override {
    destination.replace(mut_function_model<Callable, R, Args...>(this.callable));
  }
};

interface mut_move_function_target<R, Args...> {
  R invoke(Args... args) mut;
};

class mut_move_function_model<Callable, R, Args...> : public mut_move_function_target<R, Args...> {
  mut Callable callable;
public:
  mut_move_function_model(Callable callable) : callable(std::move(callable)) {}
  R invoke(Args... args) mut override { return this.callable(args...); }
};
}

namespace std {
/// A non-null, non-owning GTI invocation pointer. Construction accepts one
/// exact namespace function item or zero-capture lambda; signatures match
/// exactly. It does not borrow an environment or allocate storage.
class function_ptr<R(Args...)> {
  gti_internal::function_pointer<R(Args...)> target;
public:
  function_ptr<F>(F target)
      : target(gti_internal::function_pointer_from_item<R(Args...)>(target)) {}
  R operator()(Args... args) {
    return gti_internal::function_pointer_invoke(this.target, args...);
  }
};

/// A read-only, signature-erased checked borrow of an existing callable.
/// The callable and everything it borrows must outlive this view's uses.
class function_ref<R(Args...)> {
  std::erased_object& object;
  gti_internal::function_pointer<R(std::erased_object&, Args...)> invoke;
public:
  function_ref<F>(F& target)
      : object(std::erase_ref(target)),
        invoke(gti_internal::function_pointer_from_item<R(std::erased_object&, Args...)>([](std::erased_object& object, Args... args) -> R {
          unsafe {
            F& callable = std::restore_ref<F>(object);
            return callable(args...);
          }
        })) {}
  R operator()(Args... args) { return gti_internal::function_pointer_invoke(this.invoke, this.object, args...); }
};

/// An exclusive, move-only borrowed callback. Invocation requires mutable
/// access to the view; overlapping invocation/reentry remains rejected.
class function_ref<R(Args...) mut> {
  mut std::erased_object& object;
  gti_internal::function_pointer<R(mut std::erased_object&, Args...)> invoke;
public:
  function_ref<F>(mut F& target)
      : object(std::erase_mut(target)),
        invoke(gti_internal::function_pointer_from_item<R(mut std::erased_object&, Args...)>([](mut std::erased_object& object, Args... args) -> R {
          unsafe {
            mut F& callable = std::restore_mut<F>(object);
            return callable(args...);
          }
        })) {}
  R operator()(Args... args) mut { return gti_internal::function_pointer_invoke(this.invoke, this.object, args...); }
};

  /// A move-only owned callback whose erased target remains transferable.
  /// Transfer does not grant concurrent invocation or shared mutation. Small
  /// eligible repeatable targets use the same inline slot as ordinary functions.
  class transfer_function<R(Args...)> {
    mut std::inline_polymorphic<gti_internal::transfer_function_target<R, Args...>, 32, 8> target{};
  public:
    transfer_function() {}
    transfer_function<std::transferable Callable>(Callable callable) {
      this.target.replace(gti_internal::transfer_function_model<Callable, R, Args...>(std::move(callable)));
    }
    bool empty() { return !this.target.has_value(); }
    void reset() mut { this.target.reset(); }
    void replace<std::transferable Callable>(Callable callable) mut {
      this.target.replace(gti_internal::transfer_function_model<Callable, R, Args...>(std::move(callable)));
    }
    R operator()(Args... args) { return this.target.get().invoke(args...); }
  };

  /// A transferable callback with exclusive, repeatable invocation.
  class transfer_function<R(Args...) mut> {
    mut std::inline_polymorphic<gti_internal::mut_transfer_function_target<R, Args...>, 32, 8> target{};
  public:
    transfer_function() {}
    transfer_function<std::transferable Callable>(Callable callable) {
      this.target.replace(gti_internal::mut_transfer_function_model<Callable, R, Args...>(std::move(callable)));
    }
    bool empty() { return !this.target.has_value(); }
    void reset() mut { this.target.reset(); }
    void replace<std::transferable Callable>(Callable callable) mut {
      this.target.replace(gti_internal::mut_transfer_function_model<Callable, R, Args...>(std::move(callable)));
    }
    R operator()(Args... args) mut { return this.target.get().invoke(args...); }
  };

  /// A transferable callback invoked once through consuming access. Like the
  /// ordinary once-callable owner, its target is boxed so consuming projection
  /// uses the existing unique-owner lifetime contract.
  class transfer_function<R(Args...) &&> {
    mut std::unique_ptr<gti_internal::once_transfer_function_target<R, Args...>> target = nullptr;
  public:
    transfer_function() {}
    transfer_function<std::transferable Callable>(Callable callable) {
      gti_internal::function_signature<R(Args...) &&> signature{};
      this.target = gti_internal::make_once_transfer_function_target(std::move(callable), signature);
    }
    bool empty() { return this.target == nullptr; }
    void reset() mut { this.target.reset(); }
    void replace<std::transferable Callable>(Callable callable) mut {
      gti_internal::function_signature<R(Args...) &&> signature{};
      this.target = gti_internal::make_once_transfer_function_target(std::move(callable), signature);
    }
    R operator()(Args... args) && { return std::move(*this.target)(args...); }
  };

  /// Own a callback invoked once through consuming access. An explicit clone
  /// creates another independently consumable target before invocation.
  class function<R(Args...) &&> {
    mut std::unique_ptr<gti_internal::once_function_target<R, Args...>> target = nullptr;
  public:
    function() {}
    function<Callable>(Callable callable) requires std::copy_constructible<Callable> {
      gti_internal::function_signature<R(Args...) &&> signature{};
      this.target = gti_internal::make_once_function_target(std::move(callable), signature);
    }
    bool empty() { return this.target == nullptr; }
    void reset() mut { this.target.reset(); }
    void replace<Callable>(Callable callable) mut requires std::copy_constructible<Callable> {
      gti_internal::function_signature<R(Args...) &&> signature{};
      this.target = gti_internal::make_once_function_target(std::move(callable), signature);
    }
    R operator()(Args... args) && { return std::move(*this.target)(args...); }
    function<R(Args...) &&> clone() {
      mut function<R(Args...) &&> copy{};
      if (!this.empty()) { copy.target = this.target->clone(); }
      return std::move(copy);
    }
  };

  /// Own a once-invoked callback without requiring copyable captured state.
  /// Remaining captures live through the invocation's enclosing expression.
  class move_only_function<R(Args...) &&> {
    mut std::unique_ptr<gti_internal::once_move_function_target<R, Args...>> target = nullptr;
  public:
    move_only_function() {}
    move_only_function<Callable>(Callable callable) {
      gti_internal::function_signature<R(Args...) &&> signature{};
      this.target = gti_internal::make_once_move_function_target(std::move(callable), signature);
    }
    bool empty() { return this.target == nullptr; }
    void reset() mut { this.target.reset(); }
    void replace<Callable>(Callable callable) mut {
      gti_internal::function_signature<R(Args...) &&> signature{};
      this.target = gti_internal::make_once_move_function_target(std::move(callable), signature);
    }
    R operator()(Args... args) && { return std::move(*this.target)(args...); }
  };

  /// Own a repeatable callback invoked through exclusive mutable access.
  /// A clone takes an independent copy of the target's current state.
  class function<R(Args...) mut> {
    mut std::inline_polymorphic<gti_internal::mut_function_target<R, Args...>, 32, 8> target{};
  public:
    function() {}
    function<Callable>(Callable callable) requires std::copy_constructible<Callable> {
      this.target.replace(gti_internal::mut_function_model<Callable, R, Args...>(std::move(callable)));
    }
    bool empty() { return !this.target.has_value(); }
    void reset() mut { this.target.reset(); }
    void replace<Callable>(Callable callable) mut requires std::copy_constructible<Callable> {
      this.target.replace(gti_internal::mut_function_model<Callable, R, Args...>(std::move(callable)));
    }
    R operator()(Args... args) mut { return this.target.get().invoke(args...); }
    function<R(Args...) mut> clone() {
      mut function<R(Args...) mut> copy{};
      if (!this.empty()) { this.target.get().clone_into(copy.target); }
      return std::move(copy);
    }
  };

  /// Own a mutable callback without requiring copyable retained state.
  class move_only_function<R(Args...) mut> {
    mut std::inline_polymorphic<gti_internal::mut_move_function_target<R, Args...>, 32, 8> target{};
  public:
    move_only_function() {}
    move_only_function<Callable>(Callable callable) {
      this.target.replace(gti_internal::mut_move_function_model<Callable, R, Args...>(std::move(callable)));
    }
    bool empty() { return !this.target.has_value(); }
    void reset() mut { this.target.reset(); }
    void replace<Callable>(Callable callable) mut {
      this.target.replace(gti_internal::mut_move_function_model<Callable, R, Args...>(std::move(callable)));
    }
    R operator()(Args... args) mut { return this.target.get().invoke(args...); }
  };

  /// Own a repeatable read-only callback with the exact signature.
  /// Cloning is explicit; moving transfers ownership without copying captures.
  /// Calling an empty wrapper follows the checked null-owner failure contract.
  class function<R(Args...)> {
    mut std::inline_polymorphic<gti_internal::function_target<R, Args...>, 32, 8> target{};
  public:
    function() {}
    function<Callable>(Callable callable) requires std::copy_constructible<Callable> {
      this.target.replace(gti_internal::function_model<Callable, R, Args...>(std::move(callable)));
    }
    bool empty() { return !this.target.has_value(); }
    void reset() mut { this.target.reset(); }
    void replace<Callable>(Callable callable) mut requires std::copy_constructible<Callable> {
      this.target.replace(gti_internal::function_model<Callable, R, Args...>(std::move(callable)));
    }
    R operator()(Args... args) { return this.target.get().invoke(args...); }
    function<R(Args...)> clone() {
      mut function<R(Args...)> copy{};
      if (!this.empty()) { this.target.get().clone_into(copy.target); }
      return std::move(copy);
    }
  };

  /// Own a read-only callback without requiring its captures to be copyable.
  /// There is no clone operation; explicit moves transfer the retained target.
  class move_only_function<R(Args...)> {
    mut std::inline_polymorphic<gti_internal::move_function_target<R, Args...>, 32, 8> target{};
  public:
    move_only_function() {}
    move_only_function<Callable>(Callable callable) {
      this.target.replace(gti_internal::move_function_model<Callable, R, Args...>(std::move(callable)));
    }
    bool empty() { return !this.target.has_value(); }
    void reset() mut { this.target.reset(); }
    void replace<Callable>(Callable callable) mut {
      this.target.replace(gti_internal::move_function_model<Callable, R, Args...>(std::move(callable)));
    }
    R operator()(Args... args) { return this.target.get().invoke(args...); }
  };

  /// Exact confined-call relationships. `read_callable` requires a public
  /// read-only target; `mut_callable` is a repeatable exclusive-use site and
  /// therefore accepts read-only or mutable targets; `once_callable` is a
  /// consuming use site and accepts read-only, mutable, or consuming targets.
  /// Arguments are exact readable values: a concrete target may take each one
  /// by value or by read-only reference. Results are exact and non-borrowed.
  concept read_callable<Callable, Argument, Result> =
      gti_internal::read_callable_capability<Callable, Argument, Result>;
  concept mut_callable<Callable, Argument, Result> =
      gti_internal::mut_callable_capability<Callable, Argument, Result>;
  concept once_callable<Callable, Argument, Result> =
      gti_internal::once_callable_capability<Callable, Argument, Result>;

  concept read_binary_callable<Callable, Left, Right, Result> =
      gti_internal::read_binary_callable_capability<Callable, Left, Right,
                                                    Result>;
  concept mut_binary_callable<Callable, Left, Right, Result> =
      gti_internal::mut_binary_callable_capability<Callable, Left, Right,
                                                   Result>;
  concept once_binary_callable<Callable, Left, Right, Result> =
      gti_internal::once_binary_callable_capability<Callable, Left, Right,
                                                    Result>;

  concept predicate<Predicate, Argument> =
      std::mut_callable<Predicate, Argument, bool>;
  concept binary_predicate<Predicate, Left, Right> =
      std::mut_binary_callable<Predicate, Left, Right, bool>;
  concept operation<Operation, Argument, Result> =
      std::mut_callable<Operation, Argument, Result>;
  concept binary_operation<Operation, Left, Right, Result> =
      std::mut_binary_callable<Operation, Left, Right, Result>;
  concept comparator<Compare, T> = std::binary_predicate<Compare, T, T>;
  concept once_action<Callable> =
      gti_internal::once_action_capability<Callable>;

  /// Iterator-aware relations name the source cursor directly because the
  /// bounded concept language intentionally has no associated-type syntax.
  concept indirect_predicate<Predicate, Iterator> =
      gti_internal::indirect_predicate_capability<Predicate, Iterator>;
  concept indirect_operation<Operation, Iterator, Result> =
      gti_internal::indirect_operation_capability<Operation, Iterator, Result>;
  concept range_predicate<Predicate, Range> =
      gti_internal::range_predicate_capability<Predicate, Range>;
  concept range_operation<Operation, Range, Result> =
      gti_internal::range_operation_capability<Operation, Range, Result>;

  /// Consume one exact no-argument action. A reusable target is valid because
  /// a once-only use site may invoke it through owned access; a consuming
  /// operator() must be selected exactly and invalidates the local callable.
  void invoke_once<Callable>(Callable callable)
    requires std::once_action<Callable> {
    std::move(callable)();
  }

  class less<std::totally_ordered T> {
  public:
    bool operator()(T & left, T & right) {
      return left < right;
    }
  };

  class greater<std::totally_ordered T> {
  public:
    bool operator()(T & left, T & right) {
      return left > right;
    }
  };

  class equal_to<std::equality_comparable T> {
  public:
    bool operator()(T & left, T & right) {
      return left == right;
    }
  };

  class not_equal_to<std::equality_comparable T> {
  public:
    bool operator()(T & left, T & right) {
      return left != right;
    }
  };

  // The primary is deliberately non-callable. Exact specializations supply
  // executable hashing; an unsupported key must fail before native linking.
  class hash<T> {};

  // Hashes are process-local lookup values, not a serialized representation.
  // Converting a negative integer directly to size_t would be checked failure.
  // Complementing -(value + 1) also handles the minimum signed value safely.
  namespace detail {
    size_t signed_integer_hash<std::signed_integral T>(T value) {
      if (value < T(0)) {
        return ~size_t(-T(value + T(1)));
      }
      return size_t(value);
    }
  }

}

class std::hash<int8_t> {
public:
  std::size_t operator()(int8_t& value) {
    return detail::signed_integer_hash(value);
  }
};

class std::hash<int16_t> {
public:
  std::size_t operator()(int16_t& value) {
    return detail::signed_integer_hash(value);
  }
};

class std::hash<int32_t> {
public:
  std::size_t operator()(int32_t& value) {
    return detail::signed_integer_hash(value);
  }
};

class std::hash<int64_t> {
public:
  std::size_t operator()(int64_t& value) {
    return detail::signed_integer_hash(value);
  }
};

class std::hash<uint8_t> {
public:
  std::size_t operator()(uint8_t& value) { return std::size_t(value); }
};

class std::hash<uint16_t> {
public:
  std::size_t operator()(uint16_t& value) { return std::size_t(value); }
};

class std::hash<uint32_t> {
public:
  std::size_t operator()(uint32_t& value) { return std::size_t(value); }
};

class std::hash<uint64_t> {
public:
  std::size_t operator()(uint64_t& value) { return value; }
};

class std::hash<bool> {
public:
  std::size_t operator()(bool& value) {
    if (value) { return 1; }
    return 0;
  }
};

class std::hash<char> {
public:
  std::size_t operator()(char& value) {
    return std::size_t(uint8_t(value));
  }
};
