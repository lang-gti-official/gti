export module charconv;
import "detail/charconv_parse.gti";
export import "detail/charconv_types.gti";

import std.numeric;


namespace std {

/// Locale-independent, nonallocating integer parsing. No whitespace, plus
/// sign, or radix prefix is skipped. A failed parse leaves output unchanged.
export from_chars_result from_chars<std::integral T>(string_view input, mut T& output, int base) {
  return detail::parse_integer(input, output, base, false);
}

export from_chars_result from_chars<std::integral T>(string_view input, mut T& output) {
  return std::from_chars(input, output, 10);
}

export from_chars_result from_chars(string_view input, mut float& output, chars_format format) {
  return detail::parse_float(input, size_t(0), output, format);
}
export from_chars_result from_chars(string_view input, mut double& output, chars_format format) {
  return detail::parse_float(input, size_t(0), output, format);
}
export from_chars_result from_chars(string_view input, mut float& output) {
  return std::from_chars(input, output, chars_format::general);
}
export from_chars_result from_chars(string_view input, mut double& output) {
  return std::from_chars(input, output, chars_format::general);
}
}
