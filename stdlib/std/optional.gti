// Optional values are ordinary GTI policy over one declaration-bound inline
// storage capability. The private representation owns at most one live T and
// never allocates merely to represent the empty state.

#include <std/utility>

namespace gti_internal {
/// Compiler-owned inline storage for zero or one live `T`.
///
/// Exact trusted declaration identity selects the representation. Application
/// code cannot name this type or its operations, and the public optional class
/// owns every state transition.
class optional_storage<std::move_constructible T> {
public:
  optional_storage() {}
  optional_storage(optional_storage<T>& other) = delete;
  optional_storage(optional_storage<T>&& other) = default;
  ~optional_storage() = default;
};

bool optional_storage_has_value<std::move_constructible T>(
    gti_internal::optional_storage<T>& storage);
void optional_storage_construct<std::move_constructible T>(
    mut gti_internal::optional_storage<T>& storage, T value);
T& optional_storage_read<std::move_constructible T>(
    gti_internal::optional_storage<T>& storage);
mut T& optional_storage_read_mut<std::move_constructible T>(
    mut gti_internal::optional_storage<T>& storage);
void optional_storage_reset<std::move_constructible T>(
    mut gti_internal::optional_storage<T>& storage);
}

namespace std {
/// A move-only owner of an optional `T`.
///
/// Empty construction does not allocate. Moving transfers engagement and the
/// contained value; GTI then treats the source binding as moved and
/// unavailable. Access to an empty value raises GTI's checked
/// `empty_owner_access/member_access` failure after normal MIR cleanup. Copy
/// construction and both assignment forms remain deliberately absent; use an
/// explicit `clone()` when `T` supports duplication.
class optional<std::move_constructible T> {
  mut gti_internal::optional_storage<T> storage =
      gti_internal::optional_storage<T>();

public:
  /// Constructs an empty optional.
  optional() {}

  /// Moves one completed value into the optional.
  optional(T value) {
    gti_internal::optional_storage_construct(this.storage,
                                             std::move(value));
  }

  optional(optional<T>& other) = delete;
  optional(optional<T>&& other) = default;

  /// Returns whether a value is live.
  bool has_value() {
    return gti_internal::optional_storage_has_value(this.storage);
  }

  /// Equivalent to `has_value()`.
  operator bool() {
    return this.has_value();
  }

  /// Returns a checked read-only reference to the live value.
  T& value() {
    return gti_internal::optional_storage_read(this.storage);
  }

  /// Returns a checked exclusive reference to the live value.
  mut T& value() mut {
    return gti_internal::optional_storage_read_mut(this.storage);
  }

  T& operator*() {
    return this.value();
  }

  mut T& operator*() mut {
    return this.value();
  }

  T& operator->() {
    return this.value();
  }

  mut T& operator->() mut {
    return this.value();
  }

  /// Returns a copy of the live value, or moves `fallback` when empty.
  ///
  /// Only copy construction is required, not copy assignment. Move-only
  /// payloads keep the other members, including explicit `clone()`.
  T value_or(T fallback) requires std::copy_constructible<T> {
    if (this.has_value()) {
      return this.value();
    }
    return std::move(fallback);
  }

  /// Duplicates an engaged payload using its explicit clone contract.
  /// Empty optionals remain empty; sharing follows the payload's clone policy.
  optional<T> clone() requires std::cloneable<T> {
    if (this.has_value()) {
      return optional<T>(std::clone(this.value()));
    }
    return optional<T>();
  }

  /// Destroys the live value, if any, and becomes empty.
  void reset() mut {
    gti_internal::optional_storage_reset(this.storage);
  }

  /// Replaces the current value from `args`, remaining empty on failure.
  ///
  /// Payload construction runs as ordinary GTI before publication into the
  /// inline slot. The private capability only transfers a completed value;
  /// it must not hide a source constructor or its failure/cleanup schedule.
  mut T& emplace<Args...>(Args... args) mut {
    this.reset();
    T value = T(args...);
    gti_internal::optional_storage_construct(this.storage, std::move(value));
    return gti_internal::optional_storage_read_mut(this.storage);
  }
};
}
