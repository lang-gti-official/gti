export module optional;

// Optional policy and storage are ordinary GTI: the payload enum owns exactly
// one live value or none. The compiler supplies general enum lifetime rules.
import std.utility;
namespace std {
/// The value representing an empty optional.
export struct nullopt_t { nullopt_t() = default; };
export nullopt_t nullopt{};

namespace detail {
enum optional_state<T> {
  empty,
  engaged(T value),
};
}

/// A move-only optional owner with inline, source-defined tagged storage.
/// Empty access raises the checked empty-owner failure after normal cleanup.
/// Copying is explicit through clone(); moving consumes the source binding.
export class optional<std::move_constructible T> {
  mut detail::optional_state<T> state = detail::optional_state<T>::empty;

public:
  optional() {}
  implicit optional(nullopt_t empty) {}
  implicit optional(T value) : state(detail::optional_state<T>::engaged(std::move(value))) {}
  optional(optional<T>& other) = delete;
  optional(optional<T>&& other) = default;

  bool has_value() {
    switch (this.state) {
    case detail::optional_state<T>::engaged: return true;
    case detail::optional_state<T>::empty: return false;
    }
  }

  operator bool() { return this.has_value(); }

  T& value() {
    switch (this.state) {
    case detail::optional_state<T>::engaged(auto& payload): return payload;
    case detail::optional_state<T>::empty: gti_internal::fail_empty_owner();
    }
  }

  mut T& value() mut {
    switch (this.state) {
    case detail::optional_state<T>::engaged(mut auto& payload): return payload;
    case detail::optional_state<T>::empty: gti_internal::fail_empty_owner();
    }
  }

  T value() && {
    switch (std::move(this.state)) {
    case detail::optional_state<T>::engaged(payload): return payload;
    case detail::optional_state<T>::empty: gti_internal::fail_empty_owner();
    }
  }

  T& operator*() { return this.value(); }
  mut T& operator*() mut { return this.value(); }
  T& operator->() { return this.value(); }
  mut T& operator->() mut { return this.value(); }

  T value_or(T fallback) requires std::copy_constructible<T> {
    switch (this.state) {
    case detail::optional_state<T>::engaged(payload): return payload;
    case detail::optional_state<T>::empty: return std::move(fallback);
    }
  }

  optional<T> clone() requires std::cloneable<T> {
    switch (this.state) {
    case detail::optional_state<T>::engaged(auto& payload):
      return optional<T>(std::clone(payload));
    case detail::optional_state<T>::empty: return optional<T>();
    }
  }

  void reset() mut { this.state = detail::optional_state<T>::empty; }

  /// Destroys the old value before construction; failure leaves this empty.
  [[discardable]]
  mut T& emplace<Args...>(Args... args) mut {
    this.reset();
    this.state = detail::optional_state<T>::engaged(T(args...));
    return this.value();
  }
};

export for <std::move_constructible T> concept std::tryable<optional<T>> {
  using value_type = T;
  using residual_type = nullopt_t;
  bool has_value(optional<T>& value) { return value.has_value(); }
  [[borrowed_from(value)]] T take_value(optional<T> value) { return std::move(value).value(); }
  nullopt_t take_residual(optional<T> value) { return nullopt_t(); }
};
}
