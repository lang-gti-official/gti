namespace std {
  class Vector {
  public:
    Vector() {}
    void at() {}
    void front() {}
    void back() {}
    void data() {}

    void begin() {}
    void end() {}
    void rbegin() {}
    void rend() {}

    bool empty() {}
    uint64 size() {}

    void clear() {}
    void insert() {}
    void emplace() {}
    void push_back() {}
    void pop_back() {}
    void emplace_back() {}
    void resize() {}
    void swap() {}
  private:
  };
}
