// The implicit prelude contains only language-wide vocabulary, compiler-bound
// capabilities shared by several standard units, and the minimal hosted output
// surface used by ordinary programs. Module-owned policy belongs in its
// canonical <std/...> unit.
namespace gti_internal {
  // Compiler capability type declarations are deliberately empty. Semantics
  // binds their trusted declaration identities to private representations;
  // application declarations with the same spelling remain ordinary types.
  // Prefix-initialized storage (P-STORAGE-01): the live elements always form
  // the prefix [0, length). Construction appends exactly at the live length,
  // destruction removes exactly the last live element, relocation transfers
  // the complete prefix, and reads check the logical prefix.
  class prefix_storage<T> {};
  class text_view {};
  class c_string {};
  class c_bool {};
  class c_char {};
  class c_schar {};
  class c_uchar {};
  class c_short {};
  class c_ushort {};
  class c_int {};
  class c_uint {};
  class c_long {};
  class c_ulong {};
  class c_longlong {};
  class c_ulonglong {};
  class c_float {};
  class c_double {};
  class c_size_t {};
  class c_ptrdiff_t {};
  class c_intptr_t {};
  class c_uintptr_t {};

  @compiler_constraint("numeric") concept numeric_capability<T>;
  @compiler_constraint("signed_numeric") concept signed_numeric_capability<T>;
  @compiler_constraint("integral") concept integral_capability<T>;
  @compiler_constraint("integral_enum") concept integral_enum_capability<T>;
  @compiler_constraint("enum_underlying") concept enum_underlying_capability<T, U>;
  @compiler_constraint("signed_integral") concept signed_integral_capability<T>;
  @compiler_constraint("unsigned_integral") concept unsigned_integral_capability<T>;
  @compiler_constraint("floating_point") concept floating_point_capability<T>;
  @compiler_constraint("copy_constructible") concept copy_constructible_capability<T>;
  @compiler_constraint("move_constructible") concept move_constructible_capability<T>;
  @compiler_constraint("copyable") concept copyable_capability<T>;
  @compiler_constraint("movable") concept movable_capability<T>;
  @compiler_constraint("relocatable") concept relocatable_capability<T>;
  @compiler_constraint("bitwise_relocatable") concept bitwise_relocatable_capability<T>;
  @compiler_constraint("transferable") concept transferable_capability<T>;
  @compiler_constraint("shareable") concept shareable_capability<T>;
  @compiler_constraint("default_initializable") concept default_initializable_capability<T>;
  @compiler_constraint("equality_comparable") concept equality_comparable_capability<T>;
  @compiler_constraint("relationally_ordered") concept relationally_ordered_capability<T>;
  @compiler_constraint("adds") concept adds_capability<T>;
  @compiler_constraint("subtracts") concept subtracts_capability<T>;
  @compiler_constraint("negates") concept negates_capability<T>;
  @compiler_constraint("scales_by") concept scales_by_capability<T, S>;
  // The identity-bound public logical-size check raises index_out_of_bounds
  // when `index >= size`, so container indexing reports the logical bound
  // rather than leaking the private storage invariant.
  void index_bounds_check(uint64_t index, uint64_t size);
  void require_key(bool found);
  void require_container_argument(bool valid);
  void require_vacant_storage(bool valid);
  void require_live_storage(bool valid);
  void require_relocation_capacity(bool valid);
  void require_relocation_source(bool valid);
  void require_relocation_destination(bool valid);
  T restoring_exchange<T>(mut T& destination, T replacement);
  U enum_underlying_value<U, T>(T value);
  void restoring_swap<T>(mut T& left, mut T& right);
  void restoring_indexed_swap<S>(mut S& storage, uint64_t left, uint64_t right);
  [[noreturn, track_caller]]
  void panic(gti_internal::text_view message);

  gti_internal::prefix_storage<T> allocate_prefix_storage<T>(uint64_t count);
  void prefix_storage_append<T, Args...>(mut gti_internal::prefix_storage<T>& storage, Args... args);
  void prefix_storage_pop<T>(mut gti_internal::prefix_storage<T>& storage);
  T & prefix_storage_read<T>(gti_internal::prefix_storage<T>& storage, uint64_t index);
  mut T & prefix_storage_read_mut<T>(mut gti_internal::prefix_storage<T>& storage, uint64_t index);
  uint64_t prefix_storage_length<T>(gti_internal::prefix_storage<T>& storage);
  void prefix_storage_relocate<T>(mut gti_internal::prefix_storage<T>& source, mut gti_internal::prefix_storage<T>& destination); // Insert and erase preserve the prefix invariant atomically: the element
  // shift and the construction or destruction happen inside one sealed
  // operation, so no partially initialized slot is ever observable.
  void prefix_storage_insert<T, Args...>(mut gti_internal::prefix_storage<T>& storage, uint64_t index, Args... args);
  void prefix_storage_erase<T>(mut gti_internal::prefix_storage<T>& storage, uint64_t index);
  gti_internal::text_view prefix_storage_text_view(gti_internal::prefix_storage<char>& storage);
  // The narrowed descriptor [position, position + count) of `text`, clamped
  // to its size. The result observes the same storage as `text`, including
  // when it is empty. Range policy belongs to std::string_view.
  gti_internal::text_view text_view_slice(gti_internal::text_view text, uint64_t position, uint64_t count);
  gti_internal::c_string prefix_storage_c_string(gti_internal::prefix_storage<char>& storage);
  gti_internal::c_string prefix_storage_try_c_string(gti_internal::prefix_storage<char>& storage);

  namespace runtime {
    extern "C" {
      int32_t gti_rt_write_stdout(gti_internal::text_view value);
      int32_t gti_rt_write_stdout_byte(uint8_t value);
    }

    [[track_caller]]
    void write_stdout(std::string_view value) {
      if (gti_rt_write_stdout(value.text_capability()) != 0) {
        gti_internal::panic("Output failed: stdout write failed".text_capability());
      }
    }

    int32_t write_stdout_byte(uint8_t value) {
      return gti_rt_write_stdout_byte(value);
    }

  }
}

using c_string = gti_internal::c_string;
using c_void = void;
using c_bool = gti_internal::c_bool;
using c_char = gti_internal::c_char;
using c_schar = gti_internal::c_schar;
using c_uchar = gti_internal::c_uchar;
using c_short = gti_internal::c_short;
using c_ushort = gti_internal::c_ushort;
using c_int = gti_internal::c_int;
using c_uint = gti_internal::c_uint;
using c_long = gti_internal::c_long;
using c_ulong = gti_internal::c_ulong;
using c_longlong = gti_internal::c_longlong;
using c_ulonglong = gti_internal::c_ulonglong;
using c_float = gti_internal::c_float;
using c_double = gti_internal::c_double;
using c_size_t = gti_internal::c_size_t;
using c_ptrdiff_t = gti_internal::c_ptrdiff_t;
using c_intptr_t = gti_internal::c_intptr_t;
using c_uintptr_t = gti_internal::c_uintptr_t;

namespace std {
  /// Can initialize a new value by movement; assignment is not required.
  concept move_constructible<T> = gti_internal::move_constructible_capability<T>;
  concept movable<T> = gti_internal::movable_capability<T> && std::move_constructible<T>;
  /// Can transfer a complete value into empty storage without copying it.
  /// Does not authorize replacement, moving a borrowed value, or raw access.
  concept relocatable<T> = gti_internal::relocatable_capability<T> && std::move_constructible<T>;
  /// Structurally eligible for bytewise relocation; native representation may
  /// require an equivalent generated elementwise transfer instead.
  concept bitwise_relocatable<T> = std::relocatable<T> && gti_internal::bitwise_relocatable_capability<T>;
  concept transferable<T> = gti_internal::transferable_capability<T>;
  concept shareable<T> = gti_internal::shareable_capability<T>;
  concept copy_constructible<T> = gti_internal::copy_constructible_capability<T>;
  concept copyable<T> = std::copy_constructible<T> && gti_internal::copyable_capability<T> && std::movable<T>;
  concept default_initializable<T> = gti_internal::default_initializable_capability<T>;
  concept equality_comparable<T> = gti_internal::equality_comparable_capability<T>;
  concept totally_ordered<T> = std::equality_comparable<T> && gti_internal::relationally_ordered_capability<T>;
  concept ordered<T> = std::totally_ordered<T>;
  concept numeric<T> = gti_internal::numeric_capability<T> && std::totally_ordered<T> && std::copyable<T> && std::default_initializable<T>;
  concept signed_numeric<T> = gti_internal::signed_numeric_capability<T> && std::numeric<T>;
  concept integral<T> = gti_internal::integral_capability<T> && std::numeric<T>;
  /// A scoped enum with fixed-width integer values, excluding payload enums.
  concept integral_enum<T> = gti_internal::integral_enum_capability<T>;
  /// The exact declared underlying type of an integral enum.
  concept enum_underlying<T, U> = gti_internal::enum_underlying_capability<T, U>;
  /// Extract without widening, narrowing, or implicit enum conversion.
  U to_underlying<U, T>(T value) requires std::enum_underlying<T, U> {
    return gti_internal::enum_underlying_value<U, T>(value);
  }
  concept signed_integral<T> = gti_internal::signed_integral_capability<T> && std::integral<T> && std::signed_numeric<T>;
  concept unsigned_integral<T> = gti_internal::unsigned_integral_capability<T> && std::integral<T>;
  concept floating_point<T> = gti_internal::floating_point_capability<T> && std::signed_numeric<T>;
  /// Domain-value operator capabilities (L-OP-01). Each proves one exact
  /// public read-only member returning an owned value of the domain type,
  /// so a generic body may use the operator without importing ADL, free
  /// lookup, rewritten candidates, or conversion ranking.
  concept addable<T> = gti_internal::adds_capability<T>;
  concept subtractable<T> = gti_internal::subtracts_capability<T>;
  concept negatable<T> = gti_internal::negates_capability<T>;
  concept scalable_by<T, Scalar> = gti_internal::scales_by_capability<T, Scalar>;

  /// The composed vector-space contract over a domain type and its scalar:
  /// addition, subtraction, additive inverse, and scaling, with ordinary
  /// copy semantics. This family is member-only, matching GTI's user-operator
  /// rule, so a built-in numeric does not satisfy it — built-in arithmetic
  /// keeps its own checked semantics under `std::numeric`.
  concept vector_space<T, Scalar> =
      std::addable<T> && std::subtractable<T> && std::negatable<T> &&
      std::scalable_by<T, Scalar> && std::copyable<T>;

  using size_t = uint64_t;
  /// The end position of a string_view iteration.
  class string_view_sentinel {
    size_t final_position;

  public:
    string_view_sentinel(size_t position) : final_position(position) {}

    size_t position() {
      return this.final_position;
    }
  };

  /// A read-only iterator over the code units of a string_view. It relays the
  /// viewed storage's owner, not the view it was obtained from. The current
  /// code unit is held by the iterator itself, so a dereference observes the
  /// iterator rather than addressing the viewed bytes.
  class string_view_iterator {
    gti_internal::text_view text;
    mut size_t current_position = 0;
    mut char current = '\0';

  public:
    // The private text capability withholds this constructor from
    // application lookup; string_view::begin() is the public factory.
    string_view_iterator(gti_internal::text_view text) : text(text) {
      if (this.text.size() != 0) {
        this.current = this.text[size_t(0)];
      }
    }

    char& operator*() {
      return this.current;
    }

    void operator++() mut {
      this.current_position++;
      if (this.current_position < this.text.size()) {
        this.current = this.text[this.current_position];
      }
    }

    bool operator!=(string_view_sentinel& sentinel) {
      return this.current_position != sentinel.position();
    }

    bool operator!=(string_view_iterator& other) {
      return this.current_position != other.current_position;
    }
  };

  /// A counted, read-only, non-owning view of character storage.
  ///
  /// A view never owns, allocates, or modifies the characters it observes.
  /// Every copy, subview, and iterator retains the original storage owner,
  /// so the owner cannot be mutated, moved, or destroyed while any of them
  /// remains live. Operations count code units and treat embedded NUL bytes
  /// as ordinary characters; comparison uses unsigned byte order.
  class string_view {
    mut gti_internal::text_view text;

    constexpr bool matches_at(size_t position, string_view needle) {
      size_t count = this.size();
      if (position > count || needle.size() > count - position) {
        return false;
      }
      for (mut size_t offset = 0; offset < needle.size(); offset++) {
        if (this[position + offset] != needle[offset]) {
          return false;
        }
      }
      return true;
    }

    constexpr bool contains_char(string_view set, char value) {
      for (mut size_t index = 0; index < set.size(); index++) {
        if (set[index] == value) {
          return true;
        }
      }
      return false;
    }

  public:
    /// The largest size_t value; returned by searches that find no match.
    static constexpr size_t npos = uint64_t(18446744073709551615);

    /// Creates an empty view.
    constexpr string_view() : text("".text_capability()) {}

    // The parameter is a compiler-private text capability, so this
    // constructor is available to trusted library source only. It is the
    // single bridge from literal and owner storage to the public view.
    constexpr string_view(gti_internal::text_view text) : text(text) {}

    /// Returns the private text capability for trusted library source.
    constexpr gti_internal::text_view text_capability() {
      return this.text;
    }

    /// Returns the number of code units in the view.
    constexpr size_t size() {
      return this.text.size();
    }

    /// Returns the number of code units in the view.
    constexpr size_t length() {
      return this.size();
    }

    /// Returns whether the view contains no code units.
    constexpr bool empty() {
      return this.size() == 0;
    }

    /// Returns the code unit at `index`; raises GTI-R0007 when
    /// `index >= size()`.
    constexpr char operator[](size_t index) {
      return this.text[index];
    }

    /// Signed indexing; raises GTI-R0007 for a negative index or
    /// `index >= size()`.
    constexpr char operator[](int index) {
      return this.text[index];
    }

    /// Returns the code unit at `index`; raises GTI-R0007 when
    /// `index >= size()`.
    constexpr char at(size_t index) {
      return this.text[index];
    }

    /// Returns the first code unit; raises GTI-R0007 on an empty view.
    constexpr char front() {
      return this.text[size_t(0)];
    }

    /// Returns the last code unit; raises GTI-R0007 on an empty view.
    constexpr char back() {
      size_t count = this.size();
      if (count == 0) {
        return this.text[size_t(0)];
      }
      return this.text[count - 1];
    }

    /// Returns a view of at most `count` code units starting at `position`.
    /// `position == size()` yields an empty view; `position > size()` raises
    /// GTI-R0007. The count is clamped to the remaining length. The result
    /// observes the same storage owner as this view.
    constexpr string_view substr(size_t position, size_t count) {
      size_t available = this.size();
      if (position > available) {
        gti_internal::index_bounds_check(position, available);
      }
      mut size_t taken = available - position;
      if (count < taken) {
        taken = count;
      }
      return string_view(gti_internal::text_view_slice(this.text, position, taken));
    }

    /// Returns the view from `position` to the end.
    constexpr string_view substr(size_t position) {
      return this.substr(position, string_view::npos);
    }

    /// Drops the first `count` code units; raises GTI-R0007 when
    /// `count > size()`.
    void remove_prefix(size_t count) mut {
      size_t available = this.size();
      if (count > available) {
        gti_internal::index_bounds_check(count, available);
      }
      this.text = gti_internal::text_view_slice(this.text, count, available - count);
    }

    /// Drops the last `count` code units; raises GTI-R0007 when
    /// `count > size()`.
    void remove_suffix(size_t count) mut {
      size_t available = this.size();
      if (count > available) {
        gti_internal::index_bounds_check(count, available);
      }
      this.text = gti_internal::text_view_slice(this.text, size_t(0), available - count);
    }

    /// Returns the first match at or after `position`, or npos. An empty
    /// needle matches at any position up to and including size().
    constexpr size_t find(string_view needle, size_t position) {
      size_t count = this.size();
      if (position > count || needle.size() > count - position) {
        return string_view::npos;
      }
      size_t last = count - needle.size();
      mut size_t index = position;
      while (true) {
        if (this.matches_at(index, needle)) {
          return index;
        }
        if (index == last) {
          return string_view::npos;
        }
        index++;
      }
    }

    constexpr size_t find(string_view needle) {
      return this.find(needle, size_t(0));
    }

    constexpr size_t find(char needle, size_t position) {
      size_t count = this.size();
      for (mut size_t index = position; index < count; index++) {
        if (this[index] == needle) {
          return index;
        }
      }
      return string_view::npos;
    }

    constexpr size_t find(char needle) {
      return this.find(needle, size_t(0));
    }

    /// Returns the last match starting at or before `position`, or npos. An
    /// empty needle matches at min(position, size()).
    constexpr size_t rfind(string_view needle, size_t position) {
      size_t count = this.size();
      if (needle.size() > count) {
        return string_view::npos;
      }
      mut size_t index = count - needle.size();
      if (position < index) {
        index = position;
      }
      while (true) {
        if (this.matches_at(index, needle)) {
          return index;
        }
        if (index == 0) {
          return string_view::npos;
        }
        index--;
      }
    }

    constexpr size_t rfind(string_view needle) {
      return this.rfind(needle, string_view::npos);
    }

    constexpr size_t rfind(char needle, size_t position) {
      size_t count = this.size();
      if (count == 0) {
        return string_view::npos;
      }
      mut size_t index = count - 1;
      if (position < index) {
        index = position;
      }
      while (true) {
        if (this[index] == needle) {
          return index;
        }
        if (index == 0) {
          return string_view::npos;
        }
        index--;
      }
    }

    constexpr size_t rfind(char needle) {
      return this.rfind(needle, string_view::npos);
    }

    /// Returns the first position at or after `position` whose code unit
    /// occurs in `set`, or npos.
    constexpr size_t find_first_of(string_view set, size_t position) {
      size_t count = this.size();
      for (mut size_t index = position; index < count; index++) {
        if (this.contains_char(set, this[index])) {
          return index;
        }
      }
      return string_view::npos;
    }

    constexpr size_t find_first_of(string_view set) {
      return this.find_first_of(set, size_t(0));
    }

    constexpr size_t find_first_of(char value, size_t position) {
      return this.find(value, position);
    }

    constexpr size_t find_first_of(char value) {
      return this.find(value, size_t(0));
    }

    /// Returns the last position at or before `position` whose code unit
    /// occurs in `set`, or npos.
    constexpr size_t find_last_of(string_view set, size_t position) {
      size_t count = this.size();
      if (count == 0) {
        return string_view::npos;
      }
      mut size_t index = count - 1;
      if (position < index) {
        index = position;
      }
      while (true) {
        if (this.contains_char(set, this[index])) {
          return index;
        }
        if (index == 0) {
          return string_view::npos;
        }
        index--;
      }
    }

    constexpr size_t find_last_of(string_view set) {
      return this.find_last_of(set, string_view::npos);
    }

    constexpr size_t find_last_of(char value, size_t position) {
      return this.rfind(value, position);
    }

    constexpr size_t find_last_of(char value) {
      return this.rfind(value, string_view::npos);
    }

    /// Returns the first position at or after `position` whose code unit
    /// does not occur in `set`, or npos.
    constexpr size_t find_first_not_of(string_view set, size_t position) {
      size_t count = this.size();
      for (mut size_t index = position; index < count; index++) {
        if (!this.contains_char(set, this[index])) {
          return index;
        }
      }
      return string_view::npos;
    }

    constexpr size_t find_first_not_of(string_view set) {
      return this.find_first_not_of(set, size_t(0));
    }

    constexpr size_t find_first_not_of(char value, size_t position) {
      size_t count = this.size();
      for (mut size_t index = position; index < count; index++) {
        if (this[index] != value) {
          return index;
        }
      }
      return string_view::npos;
    }

    constexpr size_t find_first_not_of(char value) {
      return this.find_first_not_of(value, size_t(0));
    }

    /// Returns the last position at or before `position` whose code unit
    /// does not occur in `set`, or npos.
    constexpr size_t find_last_not_of(string_view set, size_t position) {
      size_t count = this.size();
      if (count == 0) {
        return string_view::npos;
      }
      mut size_t index = count - 1;
      if (position < index) {
        index = position;
      }
      while (true) {
        if (!this.contains_char(set, this[index])) {
          return index;
        }
        if (index == 0) {
          return string_view::npos;
        }
        index--;
      }
    }

    constexpr size_t find_last_not_of(string_view set) {
      return this.find_last_not_of(set, string_view::npos);
    }

    constexpr size_t find_last_not_of(char value, size_t position) {
      size_t count = this.size();
      if (count == 0) {
        return string_view::npos;
      }
      mut size_t index = count - 1;
      if (position < index) {
        index = position;
      }
      while (true) {
        if (this[index] != value) {
          return index;
        }
        if (index == 0) {
          return string_view::npos;
        }
        index--;
      }
    }

    constexpr size_t find_last_not_of(char value) {
      return this.find_last_not_of(value, string_view::npos);
    }

    constexpr bool contains(string_view needle) {
      return this.find(needle) != string_view::npos;
    }

    constexpr bool contains(char needle) {
      return this.find(needle) != string_view::npos;
    }

    constexpr bool starts_with(string_view prefix) {
      return this.matches_at(size_t(0), prefix);
    }

    constexpr bool starts_with(char prefix) {
      return this.size() != 0 && this[size_t(0)] == prefix;
    }

    constexpr bool ends_with(string_view suffix) {
      size_t count = this.size();
      if (suffix.size() > count) {
        return false;
      }
      return this.matches_at(count - suffix.size(), suffix);
    }

    constexpr bool ends_with(char suffix) {
      size_t count = this.size();
      return count != 0 && this[count - 1] == suffix;
    }

    /// Compares code units in unsigned byte order; a proper prefix orders
    /// first. Returns a negative, zero, or positive value.
    constexpr int compare(string_view other) {
      size_t count = this.size();
      size_t other_count = other.size();
      mut size_t shared = count;
      if (other_count < shared) {
        shared = other_count;
      }
      for (mut size_t index = 0; index < shared; index++) {
        uint8_t left = uint8_t(this[index]);
        uint8_t right = uint8_t(other[index]);
        if (left < right) {
          return -1;
        }
        if (left > right) {
          return 1;
        }
      }
      if (count < other_count) {
        return -1;
      }
      if (count > other_count) {
        return 1;
      }
      return 0;
    }

    // Byte equality of two counted descriptors is a failure-free
    // representation comparison of the private capability.
    constexpr bool operator==(string_view other) {
      return this.text == other.text;
    }

    constexpr bool operator!=(string_view other) {
      return this.text != other.text;
    }

    constexpr bool operator<(string_view other) { return this.compare(other) < 0; }
    constexpr bool operator>(string_view other) { return this.compare(other) > 0; }
    constexpr bool operator<=(string_view other) { return this.compare(other) <= 0; }
    constexpr bool operator>=(string_view other) { return this.compare(other) >= 0; }

    /// Iterates the code units in order. The iterator retains this view's
    /// storage owner.
    string_view_iterator begin() {
      return string_view_iterator(this.text);
    }

    string_view_sentinel end() {
      return string_view_sentinel(this.size());
    }
  };

  using ptrdiff_t = int64_t;

  /// Transfers `value` into an owned result and leaves the source moved from.
  T move<T>(T& value);

  /// Writes `value` to standard output without adding a newline.
  [[track_caller]]
  void print(string_view value) {
    gti_internal::runtime::write_stdout(value);
  }

  /// Writes one character to standard output without adding a newline.
  [[track_caller]]
  void print(char value) {
    if (gti_internal::runtime::write_stdout_byte(uint8_t(value)) != 0) {
      gti_internal::panic("Output failed: stdout write failed".text_capability());
    }
  }

  /// Writes `value` to standard output followed by a newline.
  [[track_caller]]
  void println(string_view value) {
    print(value);
    print("\n");
  }

  /// Writes one character to standard output followed by a newline.
  [[track_caller]]
  void println(char value) {
    print(value);
    print("\n");
  }
}

namespace gti_internal {
  [[track_caller]]
  void print_decimal_digit(uint8_t digit) {
    switch (digit) {
    case uint8_t(0):
      runtime::write_stdout("0");
      break;
    case uint8_t(1):
      runtime::write_stdout("1");
      break;
    case uint8_t(2):
      runtime::write_stdout("2");
      break;
    case uint8_t(3):
      runtime::write_stdout("3");
      break;
    case uint8_t(4):
      runtime::write_stdout("4");
      break;
    case uint8_t(5):
      runtime::write_stdout("5");
      break;
    case uint8_t(6):
      runtime::write_stdout("6");
      break;
    case uint8_t(7):
      runtime::write_stdout("7");
      break;
    case uint8_t(8):
      runtime::write_stdout("8");
      break;
    case uint8_t(9):
      runtime::write_stdout("9");
      break;
    default:
      runtime::write_stdout("?");
      break;
    }
  }

  [[track_caller]]
  void print_integral<std::integral T>(T value) {
    if (value == T(0)) {
      runtime::write_stdout("0");
      return;
    }

    if (value < T(0)) {
      runtime::write_stdout("-");
    }

    mut uint8_t[20] digits = {};
    mut std::size_t count = 0;
    mut T remaining = value;
    while (remaining != T(0)) {
      mut int64_t digit = int64_t(remaining % T(10));
      if (digit < 0) {
        digit = -digit;
      }
      digits[count] = uint8_t(digit);
      count++;
      remaining = T(remaining / T(10));
    }

    while (count > 0) {
      count--;
      print_decimal_digit(digits[count]);
    }
  }
}

namespace std {
  /// Writes an integral value in decimal without adding a newline.
  [[track_caller]]
  void print<std::integral T>(T value) {
    gti_internal::print_integral(value);
  }

  /// Writes an integral value in decimal followed by a newline.
  [[track_caller]]
  void println<std::integral T>(T value) {
    print(value);
    print("\n");
  }
}
