// The implicit prelude contains only language-wide vocabulary, compiler-bound
// capabilities shared by several standard units, and the minimal hosted output
// surface used by ordinary programs. Module-owned policy belongs in its
// canonical <std/...> unit.
namespace gti_internal {
  // Compiler capability type declarations are deliberately empty. Semantics
  // binds their trusted declaration identities to private representations;
  // application declarations with the same spelling remain ordinary types.
  class text_view {};
  class c_string {};
  class c_bool {};
  class c_char {};
  class c_schar {};
  class c_uchar {};
  class c_short {};
  class c_ushort {};
  class c_int {};
  class c_uint {};
  class c_long {};
  class c_ulong {};
  class c_longlong {};
  class c_ulonglong {};
  class c_float {};
  class c_double {};
  class c_size_t {};
  class c_ptrdiff_t {};
  class c_intptr_t {};
  class c_uintptr_t {};

  @compiler_constraint("numeric") concept numeric_capability<T>;
  @compiler_constraint("signed_numeric") concept signed_numeric_capability<T>;
  @compiler_constraint("integral") concept integral_capability<T>;
  @compiler_constraint("integral_enum") concept integral_enum_capability<T>;
  @compiler_constraint("enum_underlying") concept enum_underlying_capability<T, U>;
  @compiler_constraint("signed_integral") concept signed_integral_capability<T>;
  @compiler_constraint("unsigned_integral") concept unsigned_integral_capability<T>;
  @compiler_constraint("floating_point") concept floating_point_capability<T>;
  @compiler_constraint("copy_constructible") concept copy_constructible_capability<T>;
  @compiler_constraint("move_constructible") concept move_constructible_capability<T>;
  @compiler_constraint("copyable") concept copyable_capability<T>;
  @compiler_constraint("movable") concept movable_capability<T>;
  @compiler_constraint("relocatable") concept relocatable_capability<T>;
  @compiler_constraint("bitwise_relocatable") concept bitwise_relocatable_capability<T>;
  @compiler_constraint("transferable") concept transferable_capability<T>;
  @compiler_constraint("shareable") concept shareable_capability<T>;
  @compiler_constraint("default_initializable") concept default_initializable_capability<T>;
  @compiler_constraint("equality_comparable") concept equality_comparable_capability<T>;
  @compiler_constraint("relationally_ordered") concept relationally_ordered_capability<T>;
  @compiler_constraint("adds") concept adds_capability<T>;
  @compiler_constraint("subtracts") concept subtracts_capability<T>;
  @compiler_constraint("negates") concept negates_capability<T>;
  @compiler_constraint("scales_by") concept scales_by_capability<T, S>;
  // The identity-bound public logical-size check raises index_out_of_bounds
  // when `index >= size`, so container indexing reports the logical bound
  // rather than leaking the private storage invariant.
  void index_bounds_check(uint64_t index, uint64_t size);
  void require_key(bool found);
  void require_container_argument(bool valid);
  void require_vacant_storage(bool valid);
  void require_live_storage(bool valid);
  void require_relocation_capacity(bool valid);
  void require_relocation_source(bool valid);
  void require_relocation_destination(bool valid);
  // Source allocation policy selects recoverable expected or process abort.
  // This guard reports exhaustion and aborts without cleanup. Size overflow
  // and malformed requests must not be classified as exhaustion by callers.
  void require_allocation(bool succeeded);
  // Source cleanup loops need failure-free target integer arithmetic without
  // importing the high-level numeric algorithms (which depend on memory).
  T integer_wrapping_add<T>(T left, T right);
  T integer_wrapping_sub<T>(T left, T right);
  T restoring_exchange<T>(mut T& destination, T replacement);
  U enum_underlying_value<U, T>(T value);
  void restoring_swap<T>(mut T& left, mut T& right);
  void restoring_indexed_swap<S>(mut S& storage, uint64_t left, uint64_t right);
  [[noreturn, track_caller]]
  void panic(gti_internal::text_view message);


  namespace runtime {
    extern "C" {
      int32_t gti_rt_write_stdout(gti_internal::text_view value);
      int32_t gti_rt_write_stdout_byte(uint8_t value);
    }

    [[track_caller]]
    void write_stdout(gti_internal::text_view value) {
      if (gti_rt_write_stdout(value) != 0) {
        gti_internal::panic("Output failed: stdout write failed");
      }
    }

    int32_t write_stdout_byte(uint8_t value) {
      return gti_rt_write_stdout_byte(value);
    }

  }
}

using c_string = gti_internal::c_string;
using c_void = void;
using c_bool = gti_internal::c_bool;
using c_char = gti_internal::c_char;
using c_schar = gti_internal::c_schar;
using c_uchar = gti_internal::c_uchar;
using c_short = gti_internal::c_short;
using c_ushort = gti_internal::c_ushort;
using c_int = gti_internal::c_int;
using c_uint = gti_internal::c_uint;
using c_long = gti_internal::c_long;
using c_ulong = gti_internal::c_ulong;
using c_longlong = gti_internal::c_longlong;
using c_ulonglong = gti_internal::c_ulonglong;
using c_float = gti_internal::c_float;
using c_double = gti_internal::c_double;
using c_size_t = gti_internal::c_size_t;
using c_ptrdiff_t = gti_internal::c_ptrdiff_t;
using c_intptr_t = gti_internal::c_intptr_t;
using c_uintptr_t = gti_internal::c_uintptr_t;

namespace std {
  /// Can initialize a new value by movement; assignment is not required.
  concept move_constructible<T> = gti_internal::move_constructible_capability<T>;
  concept movable<T> = gti_internal::movable_capability<T> && std::move_constructible<T>;
  /// Can transfer a complete value into empty storage without copying it.
  /// Does not authorize replacement, moving a borrowed value, or raw access.
  concept relocatable<T> = gti_internal::relocatable_capability<T> && std::move_constructible<T>;
  /// Structurally eligible for bytewise relocation; native representation may
  /// require an equivalent generated elementwise transfer instead.
  concept bitwise_relocatable<T> = std::relocatable<T> && gti_internal::bitwise_relocatable_capability<T>;
  concept transferable<T> = gti_internal::transferable_capability<T>;
  concept shareable<T> = gti_internal::shareable_capability<T>;
  concept copy_constructible<T> = gti_internal::copy_constructible_capability<T>;
  concept copyable<T> = std::copy_constructible<T> && gti_internal::copyable_capability<T> && std::movable<T>;
  concept default_initializable<T> = gti_internal::default_initializable_capability<T>;
  concept equality_comparable<T> = gti_internal::equality_comparable_capability<T>;
  concept totally_ordered<T> = std::equality_comparable<T> && gti_internal::relationally_ordered_capability<T>;
  concept ordered<T> = std::totally_ordered<T>;
  concept numeric<T> = gti_internal::numeric_capability<T> && std::totally_ordered<T> && std::copyable<T> && std::default_initializable<T> && std::bitwise_relocatable<T>;
  concept signed_numeric<T> = gti_internal::signed_numeric_capability<T> && std::numeric<T>;
  concept integral<T> = gti_internal::integral_capability<T> && std::numeric<T>;
  /// A scoped enum with fixed-width integer values, excluding payload enums.
  concept integral_enum<T> = gti_internal::integral_enum_capability<T>;
  /// The exact declared underlying type of an integral enum.
  concept enum_underlying<T, U> = gti_internal::enum_underlying_capability<T, U>;
  /// Extract without widening, narrowing, or implicit enum conversion.
  U to_underlying<U, T>(T value) requires std::enum_underlying<T, U> {
    return gti_internal::enum_underlying_value<U, T>(value);
  }
  concept signed_integral<T> = gti_internal::signed_integral_capability<T> && std::integral<T> && std::signed_numeric<T>;
  concept unsigned_integral<T> = gti_internal::unsigned_integral_capability<T> && std::integral<T>;
  concept floating_point<T> = gti_internal::floating_point_capability<T> && std::signed_numeric<T>;
  /// Domain-value operator capabilities (L-OP-01). Each proves one exact
  /// public read-only member returning an owned value of the domain type,
  /// so a generic body may use the operator without importing ADL, free
  /// lookup, rewritten candidates, or conversion ranking.
  concept addable<T> = gti_internal::adds_capability<T>;
  concept subtractable<T> = gti_internal::subtracts_capability<T>;
  concept negatable<T> = gti_internal::negates_capability<T>;
  concept scalable_by<T, Scalar> = gti_internal::scales_by_capability<T, Scalar>;

  /// The composed vector-space contract over a domain type and its scalar:
  /// addition, subtraction, additive inverse, and scaling, with ordinary
  /// copy semantics. This family is member-only, matching GTI's user-operator
  /// rule, so a built-in numeric does not satisfy it — built-in arithmetic
  /// keeps its own checked semantics under `std::numeric`.
  concept vector_space<T, Scalar> =
      std::addable<T> && std::subtractable<T> && std::negatable<T> &&
      std::scalable_by<T, Scalar> && std::copyable<T>;

  /// The protocol of prefix `?` for every type except built-in `expected`.
  ///
  /// A type takes part through a `for concept std::tryable<T>` block. For
  /// `?operand`, the operand is evaluated once and passed like a by-value
  /// argument. `has_value` decides whether evaluation continues. On success,
  /// `take_value` consumes the operand and produces the result of `?`. Otherwise
  /// `take_residual` consumes it, and the enclosing function returns the
  /// residual, initializing its return type as `R result = residual;` would.
  concept tryable<T> {
    typename value_type;
    typename residual_type;
    bool has_value(T& value);
    [[borrowed_from(value)]] value_type take_value(T value);
    residual_type take_residual(T value);
  };

  /// A counted, read-only view over character storage.
  using string_view = gti_internal::text_view;
  using size_t = uint64_t;
  using ptrdiff_t = int64_t;

  /// Transfers `value` into an owned result and leaves the source moved from.
  T move<T>(T& value);

  /// Writes `value` to standard output without adding a newline.
  [[track_caller]]
  void print(string_view value) {
    gti_internal::runtime::write_stdout(value);
  }

  /// Writes one character to standard output without adding a newline.
  [[track_caller]]
  void print(char value) {
    if (gti_internal::runtime::write_stdout_byte(uint8_t(value)) != 0) {
      gti_internal::panic("Output failed: stdout write failed");
    }
  }

  /// Writes `value` to standard output followed by a newline.
  [[track_caller]]
  void println(string_view value) {
    print(value);
    print("\n");
  }

  /// Writes one character to standard output followed by a newline.
  [[track_caller]]
  void println(char value) {
    print(value);
    print("\n");
  }
}

namespace gti_internal {
  [[track_caller]]
  void print_decimal_digit(uint8_t digit) {
    switch (digit) {
    case uint8_t(0):
      runtime::write_stdout("0");
      break;
    case uint8_t(1):
      runtime::write_stdout("1");
      break;
    case uint8_t(2):
      runtime::write_stdout("2");
      break;
    case uint8_t(3):
      runtime::write_stdout("3");
      break;
    case uint8_t(4):
      runtime::write_stdout("4");
      break;
    case uint8_t(5):
      runtime::write_stdout("5");
      break;
    case uint8_t(6):
      runtime::write_stdout("6");
      break;
    case uint8_t(7):
      runtime::write_stdout("7");
      break;
    case uint8_t(8):
      runtime::write_stdout("8");
      break;
    case uint8_t(9):
      runtime::write_stdout("9");
      break;
    default:
      runtime::write_stdout("?");
      break;
    }
  }

  [[track_caller]]
  void print_integral<std::integral T>(T value) {
    if (value == T(0)) {
      runtime::write_stdout("0");
      return;
    }

    if (value < T(0)) {
      runtime::write_stdout("-");
    }

    mut uint8_t[20] digits = {};
    mut std::size_t count = 0;
    mut T remaining = value;
    while (remaining != T(0)) {
      mut int64_t digit = int64_t(remaining % T(10));
      if (digit < 0) {
        digit = -digit;
      }
      digits[count] = uint8_t(digit);
      count++;
      remaining = T(remaining / T(10));
    }

    while (count > 0) {
      count--;
      print_decimal_digit(digits[count]);
    }
  }
}

namespace std {
  /// Writes an integral value in decimal without adding a newline.
  [[track_caller]]
  void print<std::integral T>(T value) {
    gti_internal::print_integral(value);
  }

  /// Writes an integral value in decimal followed by a newline.
  [[track_caller]]
  void println<std::integral T>(T value) {
    print(value);
    print("\n");
  }
}
