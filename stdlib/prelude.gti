namespace gti_internal {
@compiler_constraint("numeric")
concept numeric_capability<T>;
@compiler_constraint("signed_numeric")
concept signed_numeric_capability<T>;
@compiler_constraint("integral")
concept integral_capability<T>;
@compiler_constraint("signed_integral")
concept signed_integral_capability<T>;
@compiler_constraint("unsigned_integral")
concept unsigned_integral_capability<T>;
@compiler_constraint("floating_point")
concept floating_point_capability<T>;
@compiler_constraint("copyable")
concept copyable_capability<T>;
@compiler_constraint("movable")
concept movable_capability<T>;
@compiler_constraint("default_initializable")
concept default_initializable_capability<T>;
@compiler_constraint("equality_comparable")
concept equality_comparable_capability<T>;
@compiler_constraint("relationally_ordered")
concept relationally_ordered_capability<T>;

gti_internal::unique_owner<T>
allocate_unique_owner<T, Args...>(Args... args);
T& unique_owner_borrow<T>(gti_internal::unique_owner<T>& owner);
mut T& unique_owner_borrow_mut<T>(mut gti_internal::unique_owner<T>& owner);
bool unique_owner_is_null<T>(gti_internal::unique_owner<T>& owner);

gti_internal::storage<T> allocate_storage<T>(uint64_t count);
void storage_construct<T>(mut gti_internal::storage<T>& storage,
                          uint64_t index, T value);
T& storage_read<T>(gti_internal::storage<T>& storage, uint64_t index);
mut T& storage_read_mut<T>(mut gti_internal::storage<T>& storage,
                           uint64_t index);
void storage_destroy<T>(mut gti_internal::storage<T>& storage,
                        uint64_t index);
void storage_relocate<T>(mut gti_internal::storage<T>& source,
                         mut gti_internal::storage<T>& destination,
                         uint64_t count);

class file_handle {
  mut int64_t descriptor = -1;

public:
  file_handle(int64_t value) : descriptor(value) {}

  bool is_valid() {
    return this.descriptor >= 0;
  }

  int64_t get() {
    return this.descriptor;
  }

  int64_t release() mut {
    int64_t value = this.descriptor;
    this.descriptor = -1;
    return value;
  }
};

namespace runtime {
@runtime("stdout.write")
void write_stdout(gti_internal::text_view value);

@runtime("stdin.read_byte")
int32_t read_stdin_byte();

@runtime("file.open_read")
int64_t open_file_read(gti_internal::text_view path);

@runtime("file.read_byte")
int32_t read_file_byte(int64_t descriptor);

@runtime("file.close")
int32_t close_file(int64_t descriptor);
}
}

namespace std {
concept movable<T> = gti_internal::movable_capability<T>;
concept copyable<T> =
    gti_internal::copyable_capability<T> && std::movable<T>;
concept default_initializable<T> =
    gti_internal::default_initializable_capability<T>;
concept equality_comparable<T> =
    gti_internal::equality_comparable_capability<T>;
concept totally_ordered<T> =
    std::equality_comparable<T> &&
    gti_internal::relationally_ordered_capability<T>;
concept ordered<T> = std::totally_ordered<T>;
concept numeric<T> =
    gti_internal::numeric_capability<T> && std::totally_ordered<T> &&
    std::copyable<T> && std::default_initializable<T>;
concept signed_numeric<T> =
    gti_internal::signed_numeric_capability<T> && std::numeric<T>;
concept integral<T> =
    gti_internal::integral_capability<T> && std::numeric<T>;
concept signed_integral<T> =
    gti_internal::signed_integral_capability<T> && std::integral<T> &&
    std::signed_numeric<T>;
concept unsigned_integral<T> =
    gti_internal::unsigned_integral_capability<T> && std::integral<T>;
concept floating_point<T> =
    gti_internal::floating_point_capability<T> && std::signed_numeric<T>;

using string_view = gti_internal::text_view;
using size_t = uint64_t;
using ptrdiff_t = int64_t;

T move<T>(T& value);

class unique_ptr<T> {
  mut gti_internal::unique_owner<T> owner = nullptr;

public:
  unique_ptr(gti_internal::unique_owner<T> value)
      : owner(std::move(value)) {}

  T& operator*() {
    return gti_internal::unique_owner_borrow(this.owner);
  }

  mut T& operator*() mut {
    return gti_internal::unique_owner_borrow_mut(this.owner);
  }

  T& operator->() {
    return gti_internal::unique_owner_borrow(this.owner);
  }

  mut T& operator->() mut {
    return gti_internal::unique_owner_borrow_mut(this.owner);
  }

  operator bool() {
    return !gti_internal::unique_owner_is_null(this.owner);
  }

  bool operator==(nullptr_t other) {
    return gti_internal::unique_owner_is_null(this.owner);
  }

  bool operator!=(nullptr_t other) {
    return !gti_internal::unique_owner_is_null(this.owner);
  }
};

unique_ptr<T> make_unique<T, Args...>(Args... args) {
  return unique_ptr<T>(
      gti_internal::allocate_unique_owner<T>(args...));
}

void print(string_view value) {
  gti_internal::runtime::write_stdout(value);
}

void println(string_view value) {
  print(value);
  print("\n");
}
}
