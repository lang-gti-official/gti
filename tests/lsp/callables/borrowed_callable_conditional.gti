// A mutable borrowed callable called in a conditional hovers with its borrow
// mode and navigates to the generic; a branch mismatch is S2050 (no backend
// error), a read-only borrow cannot call a mutating operator, and edits
// recover. (borrowed_callable_conditionals_lsp_test.py)
//@ hover @pick: mut Counter&
//@ definition @pick: @decl
class Counter {
public: Counter() = default;
  mut int count = 0;
  int operator()(int n) mut { this.count += n; return this.count; }
};
int /*@decl*/pick<F>(mut F& producer, bool ok) {
  auto result = ok ? producer(1) : 2;
  return result;
}
int main() {
  mut Counter counter{};
  /* 😀 */ return /*@pick*/pick(counter, true);
}
