// Specializations by receiver mode select the `mut` one; a duplicate mode or
// an unmatched `&&` argument is reported. (From function_signature_lsp_test.py.)
//@ definition @value: @mut_family
//@ hover @value: mut
// 😀
class Callback<R(Args...)> { public: Callback() = default; int mode() { return 1; } };
class /*@mut_family*/Callback<R(Args...) mut> { public: Callback() = default; int mode() { return 2; } };
int main() { /*@value*/Callback<int() mut> value{}; return value.mode(); }
