// A method over a class pack shows the instance's parameter types, and a
// call with too few arguments is a class-pack arity error.
// (From function_signature_lsp_test.py.)
//@ hover @send: int32_t
//@ hover @send: bool
class Relay<Args...> { public: void send(Args... args) {}  public: Relay() = default; };
int main() { Relay<int, bool> value{}; value./*@send*/send(1, true); return 0; }
// --- step 2
class Relay<Args...> { public: void send(Args... args) {}  public: Relay() = default; };
int main() { Relay<int, bool> value{}; value.send(1); return 0; }  //~ ERROR GTI-S2005 class pack
// --- step 3
class Relay<Args...> { public: void send(Args... args) {}  public: Relay() = default; };
int main() { Relay<int, bool> value{}; value.send(1, true); return 0; }
