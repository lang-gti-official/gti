// Completion through a receiver of the derived type offers protected
// members. (From protected_member_lsp_test.py.)
//@ completion @dot: secret helper read
class Base {
protected:
  int /*@secret*/secret = 7;
  int helper() { return secret; }
public:
  Base() {}
  int read() { return secret; }
};
struct Sibling : public Base {};
struct Derived : public Base { int get(Derived& peer) { return peer./*@dot*/sec; } };  //~ ERROR GTI-S2000
