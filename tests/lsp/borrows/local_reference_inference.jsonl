{"expect": {"method": "textDocument/publishDiagnostics", "params": {"uri": "$URI", "version": 7, "diagnostics": []}}}
{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "$DIR_URI/owner.gti", "languageId": "gti", "version": 1, "text": "export module owner;\nexport struct Record {\n  int count = 1;\n  Record() = default;\n  Record(Record& other) = delete;\n  Record(Record&& other) = default;\n};\n"}}}}
