// An unsaved dependency overlay changes the referent's field access in the
// open root (the write through a now read-only field is an error) and closing
// it restores the file on disk; formatting restores the canonical spacing of
// inferred reference declarations. (local_reference_inference_lsp_test.py.)
{"file": {"name": "main.gti", "text": "import \"owner.gti\";\nint main() {\n  mut Record owner{};\n  /* 😀 */ auto& observed = owner;\n  int snapshot = observed.count;\n  mut auto& writable = owner;\n  writable.count = snapshot + 1;\n  return writable.count - 2;\n}\n"}}
{"file": {"name": "owner.gti", "text": "export module owner;\nexport struct Record {\n  mut int count = 1;\n  Record() = default;\n  Record(Record& other) = delete;\n  Record(Record&& other) = default;\n};\n"}}
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"capabilities": {}}}}
{"expect": {"id": 1, "result": "$ANY"}}
{"send": {"jsonrpc": "2.0", "method": "initialized", "params": {}}}
