{"expect": {"method": "textDocument/publishDiagnostics", "params": {"uri": "$URI", "version": 7, "diagnostics": []}}}
{"send": {"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "$URI", "version": 8}, "contentChanges": [{"text": "import \"owner.gti\";\nint main() {\n  mut Record owner{};\n  /* 😀 */ auto&observed=owner;\nint snapshot=observed.count;\n  mut auto &writable = owner;\n  writable.count = snapshot + 1;\n  return writable.count - 2;\n}\n"}]}}}
