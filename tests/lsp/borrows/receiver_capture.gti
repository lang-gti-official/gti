// Shared and mutable receiver captures (`[&this]`, `[mut &this]`) in
// classes and generics: the captured receiver hovers as Counter, formatting
// keeps both captures (and analyses clean), a shared capture of a mutating
// body is an error (no backend error), and an empty capture recovers.
// (borrowing_callbacks_lsp_test.py, third part; prepareRename on `this` is
// borrows/receiver_capture_rename.jsonl)
//@ hover @this: Counter
//@ formatting: [&this]
//@ formatting: [mut &this]
int invoke<F>(F& callback) { return callback(); }
int invoke_mut<F>(mut F& callback) { return callback(); }

class Counter {
  mut int value;
public:
  Counter(int value) : value(value) {}
  int read() { return this.value; }
  void increment() mut { this.value += 1; }
  int shared() {
    auto callback = [&this]() -> int { return /*@this*/this.read(); };
    auto copy = callback;
    return invoke(copy);
  }
  int exclusive() mut {
    mut auto callback = [mut &this]() -> int {
      this.increment();
      this.value += 2;
      return this.value;
    };
    int result = invoke_mut(callback);
    // The receiver loan ends at the closure's last use.
    this.value += 1;
    return result;
  }
};

class Box<T> {
  T value;
public:
  Box(T value) : value(value) {}
  T read() {
    auto callback = [&this]() -> T { return this.value; };
    return callback();
  }
};

int main() {
  mut Counter counter{4};
  if (counter.shared() != 4) return 1;
  if (counter.exclusive() != 7) return 2;
  if (counter.read() != 8) return 3;
  Box<int> number{12};
  Box<bool> flag{true};
  if (number.read() != 12 || !flag.read()) return 4;
  return 0;
}
// --- step 2
