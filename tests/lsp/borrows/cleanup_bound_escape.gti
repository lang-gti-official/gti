// --- step 3
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 8; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { int observed = this.resource.value; }
};
class Owner {
  Guard guard;
public:
  Owner(Resource& resource) : guard(Guard(resource)) {}
};
int main() { mut Resource resource{}; Owner owner{resource}; resource.reset(); return 0; }  //~ ERROR GTI-S2017
