// Returning a reference borrowed from a local cleanup-bound carrier is one
// S2017 in user terms (a local, not a mutex or unlock); a nested
// cleanup-bound field conflicts the same way, without a backend error.
// (cleanup_bound_borrow_lsp_test.py)
// 😀 UTF-16 control
struct Resource { int value = 7; };
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { int observed = this.resource.value; }
  Resource& read() { return this.resource; }
};
Resource& leak(Resource& resource) {
  Guard guard{resource};
  return guard.read();  //~ ERROR GTI-S2017 Returned reference refers to local
}
int main() { return 0; }
