// Shared and exclusive child borrows and temporaries in constructor packs
// publish exactly the frontend's verdict, never a backend error.
// (scalar_temporary_borrow_lsp_test.py, second part)
void keep(int& value) {}
int main() { mut int owner = 1; mut int& parent = owner;
  int& child = parent; keep(parent); keep(child); return 0; }
// --- step 2
