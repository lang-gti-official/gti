// Shared and exclusive child borrows, temporaries in constructor packs and
// temporaries passed in a returned call each publish exactly the
// frontend's verdict, never a backend error.
// (scalar_temporary_borrow_lsp_test.py, second part)
void keep(int& value) {}
int main() { mut int owner = 1; mut int& parent = owner;
  int& child = parent; keep(parent); keep(child); return 0; }
// --- step 2
void keep(int& value) {}
int main() { mut int owner = 1; mut int& parent = owner;
  mut int& child = parent; keep(parent); keep(child); return 0; }  //~ ERROR GTI-S2017
// --- step 3
void keep(int& value) {}
int main() { mut int owner = 1; mut int& parent = owner;
  int& child = parent; keep(parent); keep(child); return 0; }
// --- step 4
class Owner { int value = 7; public: Owner() = default; int& get() { return this.value; } };
class View { int& value; public: View(int& v) : value(v) {} };
void observe<Args...>(Args&... values) {}
int main() { observe(View(Owner().get())); return 0; }
// --- step 5
import std.string;
class Pattern { public: Pattern() = default; };
class Result { std::string_view text; public:
  Result(std::string_view text) : text(text) {}
  bool matched() { return this.text.size() != std::size_t(0); }
};
Result match(std::string_view text, Pattern& pattern) { return Result(text); }
bool matches(std::string& text) { return match(text.view(), Pattern()).matched(); }
int main() { std::string text{"hello"}; return matches(text) ? 0 : 1; }
// --- step 6
