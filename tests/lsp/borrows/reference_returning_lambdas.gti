// Lambdas taking and returning mutable references compose; the result
// hovers as int32_t, formatting keeps `-> mut int&` (and analyses clean),
// a write while a returned reference lives is S2017 (no backend error), and
// an incomplete return type recovers. (borrowing_callbacks_lsp_test.py,
// second part)
//@ hover @changed: int32_t
//@ formatting: -> mut int&
int main() {
  // supplementary character: 😀
  auto increment = [](mut int& value) -> mut int& {
    value += 1;
    return value;
  };
  auto relay = [](mut int& value) -> mut int& {
    mut int& alias = value;
    return alias;
  };
  auto observe = [](mut int& value) -> int& {
    value += 1;
    return value;
  };
  mut int number = 10;
  mut int& changed = increment(relay(number));
  /*@changed*/changed += 5;
  int& observed = observe(number);
  return observed - 17;
}
