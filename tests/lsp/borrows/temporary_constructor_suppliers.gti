// A secondary temporary supplier reports S2127 and clears after its region is corrected.
class Two<lifetime o> {
  int&<o> x;
  int&<o> y;
public:
  Two(int&<o> x, int&<o> y) : x(x), y(y) {}
  int&<o> pick(bool s) && { if (s) { return this.x; } return this.y; }
};
int&<a> relay<lifetime a, lifetime b>(int&<a> keep, int&<b> other) {
  return Two(keep, other).pick(false); //~ ERROR GTI-S2127
}
int main() { return 0; }
// --- step 2
class Two<lifetime o> {
  int&<o> x;
  int&<o> y;
public:
  Two(int&<o> x, int&<o> y) : x(x), y(y) {}
  int&<o> pick(bool s) && { if (s) { return this.x; } return this.y; }
};
int&<a> relay<lifetime a>(int&<a> keep, int&<a> other) {
  return Two(keep, other).pick(false);
}
int main() { return 0; }
