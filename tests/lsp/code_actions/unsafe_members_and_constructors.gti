// Unsafe members, requirement members and constructors: a call outside
// unsafe is S2055, inside it hovers with `unsafe`, broken signatures
// recover, an unsafe expression block is a keyword token, and an unused
// unsafe expression block offers no keyword-only removal.
// (unsafe_function_lsp_test.py, second part)
// 😀 UTF-16 control
concept readable<T> = requires(T& x) { unsafe { x.read() } -> int; };
struct Meter { Meter() = default; unsafe int read() { return 7; } };
int main() { Meter meter{}; return meter.read(); }  //~ ERROR GTI-S2055
// --- step 2
//@ hover @read: unsafe int32_t Meter::read
//@ hover @readable: unsafe { x.read() } -> int
// 😀 UTF-16 control
concept r/*^readable*/eadable<T> = requires(T& x) { unsafe { x.read() } -> int; };
struct Meter { Meter() = default; unsafe int read() { return 7; } };
int main() { Meter meter{}; unsafe { return meter.r/*^read*/ead(); } }
// --- step 3
// 😀 UTF-16 control
concept readable<T> = requires(T& x) { unsafe { x.read() } -> int; };
struct Meter { Meter() = default; unsafe int read( { return 7; } };  //~ ERROR GTI-P0001
int main() { Meter meter{}; unsafe { return meter.read(); } }  //~ ERROR GTI-S2000
