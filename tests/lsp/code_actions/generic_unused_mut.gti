// --- step 3
// 😀 UTF-16 control
// A20: GTI-S2096 'never used mutably' is wrong; its quick fix breaks the build.
void bump<T>(mut int32_t& total, T& value) { total++; }

int32_t count_all<Args...>(Args... args) {
  mut int32_t total = 0;
  (bump(total, args), ...);
  return total;
}

int main() {
  int32_t n = count_all(1, true, 2.5d);
  std::println(n);
  return n == 3 ? 0 : 1;
}
// --- step 4
// 😀 UTF-16 control
// A24: an unreachable-statement warning is decided from a single generic instance.
int32_t adjust<uint64_t Mode>(int32_t value) {
  if constexpr (Mode == 0) {
    return value;
  }
  return value + 1;
}

int main() {
  return adjust<0>(1) + adjust<1>(1) == 3 ? 0 : 1;
}
