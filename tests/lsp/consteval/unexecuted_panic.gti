// An unexecuted compile-time panic publishes nothing; an executed one fails
// the invocation (#174, #175). (From consteval_lsp_test.py.)
import std.panic;
consteval void require_small(int value) {
  if (value > 10) { std::panic("format pattern rejected: too large"); }
}
int main() { require_small(3); return 0; }
// --- step 2
import std.panic;
consteval void require_small(int value) {
  if (value > 10) { std::panic("format pattern rejected: too large"); }
}
int main() { require_small(30); return 0; }  //~ ERROR GTI-S2057 Consteval invocation
