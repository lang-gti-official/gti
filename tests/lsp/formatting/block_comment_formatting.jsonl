// Formatting re-indents a block comment's continuation lines, leaves a
// `/*` inside a string alone and keeps a trailing block comment; an
// unterminated block comment is one GTI-L0011 at its opening delimiter.
// (block_comment_lsp_test.py; the formatted text is exact, so a transcript.)
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"capabilities": {}}}}
{"expect": {"id": 1, "result": "$ANY"}}
{"send": {"jsonrpc": "2.0", "method": "initialized", "params": {}}}
{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "$URI", "languageId": "gti", "version": 1, "text": "int main() {\n  /* first 😀 line\n     second line */\n  std::string_view text = \"/* not a comment */\";\n  return 0; /* trailing */\n}\n"}}}}
{"expect": {"method": "textDocument/publishDiagnostics", "params": {"uri": "$URI", "version": 1, "diagnostics": []}}}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "textDocument/formatting", "params": {"textDocument": {"uri": "$URI"}, "options": {"tabSize": 2, "insertSpaces": true}}}}
{"expect": {"id": 2, "result": [{"range": "$ANY", "newText": "int main() {\n  /* first 😀 line\n   second line */\n  std::string_view text = \"/* not a comment */\";\n  return 0; /* trailing */\n}\n"}]}}
{"send": {"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "$URI", "version": 2}, "contentChanges": [{"text": "int main() {\n  /* unfinished\n  return 0;\n}\n"}]}}}
{"expect": {"method": "textDocument/publishDiagnostics", "params": {"uri": "$URI", "version": 2, "diagnostics": [{"code": "GTI-L0011", "message": "Unterminated block comment.", "range": {"start": {"line": 1, "character": 2}, "end": {"line": 1, "character": 4}}}]}}}
