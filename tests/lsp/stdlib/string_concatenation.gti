// Editor diagnostics and inferred result types follow string concatenation semantics.
//@ hover @result: std::string
import std.string;
int main() {
  std::string suffix = "name";
  mut auto /*@result*/result = "hello " + suffix + "!";
  result += "!";
  std::println(result);
  return 0;
}
// --- step 2
import std.string;
int main() {
  mut std::string text = "hello";
  auto view = text.view();
  text += "!"; //~ ERROR GTI-S2017
  std::println(view);
  return 0;
}
// --- step 3
//@ hover @result: std::string
import std.string;
int main() {
  std::string suffix = "name";
  auto /*@result*/result = "hello " + suffix + "!";
  std::println(result);
  return 0;
}
