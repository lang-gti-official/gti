// A partially typed method in a condition uses the receiver's accessible members.
//@ completion @member: is_open !is_ready
class Stream {
  bool is_ready() { return false; }
public:
  Stream() {}
  bool is_open() { return true; }
};

int main() {
  Stream stream{};
  if (stream.is/*^member*/_open()) {}
  return 0;
}
