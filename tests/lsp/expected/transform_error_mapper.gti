// transform_error takes an ordinary function item: it navigates, a
// mismatched mapper or a named receiver is reported, and completion on a
// moved expected offers its consuming members. (From expected_transform_error_lsp_test.py.)
//@ hover @map: map
//@ hover @map: Error
//@ definition @map: @decl
enum class Error { failed };
Error /*@decl*/map(int error) { return Error::failed; }
expected<int, int> read() { return unexpected(1); }
int main() {
  auto source = read();
  /*😀*/ auto mapped = std::move(source).transform_error(/*@map*/map);
  return mapped.has_value() ? 1 : 0;
}
