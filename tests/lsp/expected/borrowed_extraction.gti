// A reference extracted from an expected hovers as its referent and
// navigates to its binding; a named consuming receiver, writing the owner
// while the extracted reference (by .expect or ?) is live, and incomplete
// source are reported and repaired. (From borrowed_expected_extraction_lsp_test.py.)
//@ hover @use: int32_t
//@ definition @use: @decl
expected<int&, int> lookup(int& owner) { return owner; }
expected<int, int> read(int& owner) {
  int& propagated = ?lookup(owner);
  auto carrier = lookup(owner);
  /*😀*/ int& /*@decl*/demanded = std::move(carrier).expect("required");
  return propagated + /*@use*/demanded;
}
int main() {
  mut int owner = 7;
  int& alias = lookup(owner).expect("required");
  int observed = alias;
  owner = 8;
  return observed + owner - 15;
}
