// A designator resolves to its field for hover, definition and references;
// an unknown designator is S2091. (designated_construction_lsp_test.py)
//@ hover @designator: int32_t
//@ definition @designator: @decl
//@ references @designator: @decl @designator @use
struct Point { int /*@decl*/x = 0; int y = 0;  public: Point() = default; };
int main() { Point p = {./*@designator*/x = 3}; return p./*@use*/x; }
// --- step 2
struct Point { int x = 0; int y = 0;  public: Point() = default; };
int main() { Point p = {.missing = 3}; return p.x; }  //~ ERROR GTI-S2091
