// Lifetime and borrow errors in user terms, each repaired clean: an
// ambiguous returned reference (S2017, no quick fix) fixed by a binder, a
// region mismatch fixed by an outlives bound, a write while a reborrow
// lives, a loan carried into a later loop iteration, a returned local, and
// a region carrier assigned a shorter-lived borrow and then used (S2017;
// RFC 0003 admits the whole-value assignment). (lifetime_parameters_lsp_test.py,
// second part; related locations are not asserted)
//@ no-code-action @choose
/* 😀 */ int& /*^choose*/choose(int& first, int& second, bool condition) {  //~ ERROR GTI-S2017
  if (condition) { return first; } return second;
}
// --- step 2
/* 😀 */ int&<a> choose<lifetime a>(int&<a> first, int&<a> second, bool condition) {
  if (condition) { return first; } return second;
}
// --- step 3
/* 😀 */ int&<a> choose<lifetime a, lifetime b>(int&<a> first, int&<b> second) { return second; }  //~ ERROR GTI-S2127
// --- step 4
/* 😀 */ int&<a> choose<lifetime a, lifetime b>(int&<a> first, int&<b> second) requires outlives<b, a> { return second; }
// --- step 5
int main() {
  mut int value = 1; mut int& parent = value;
  { mut int& ended = parent; ended = 2; }
  /* 😀 */ mut int& child = parent;
  /* 😀 */ parent = 3;  //~ ERROR GTI-S2017
  return child;
}
// --- step 6
int main() {
  mut int value = 1; mut int& parent = value;
  { mut int& ended = parent; ended = 2; }
  /* 😀 */ mut int& child = parent;
  /* 😀 */ int saved = child; parent = 3;
  return saved;
}
// --- step 7
int main() {
  mut int value = 1; int& borrowed = value;
  for (mut int i = 0; i < 2; i += 1) {
    /* 😀 */ int copy = borrowed;
    value = copy + 1;  //~ ERROR GTI-S2017
  } return 0;
}
