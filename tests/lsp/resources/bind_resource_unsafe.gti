// Binding a resource is an ordinary unsafe library call: hover shows it,
// and calling it outside `unsafe` is the shared unsafe-call error. (From resource_protocol_lsp_test.py.)
//@ hover @bind: unsafe
//@ hover @bind: resource_ref
import std.resource_vector;
import std.resource;
import std.memory;
struct Pool { Pool() = default;
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    return unexpected(std::alloc_errc::resource_exhausted);
  }
  unsafe void release(std::raw_allocation allocation) {}
  void reset() mut {}
};
int fill(std::resource_ref<Pool> resource) {
  mut std::resource_vector<int, Pool> values{resource};
  auto pushed = values.try_push_back(7);
  return pushed ? 0 : 1;
}
int main() {
  mut Pool pool{};
  unsafe {
    /*😀*/ auto resource = std::/*@bind*/bind_resource(pool);
    int status = fill(resource);
    if (status != 1) { return status; }
  }
  pool.reset();
  return 0;
}
// --- step 2
import std.resource_vector;
import std.resource;
import std.memory;
struct Pool { Pool() = default;
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    return unexpected(std::alloc_errc::resource_exhausted);
  }
  unsafe void release(std::raw_allocation allocation) {}
  void reset() mut {}
};
int fill(std::resource_ref<Pool> resource) {
  mut std::resource_vector<int, Pool> values{resource};
  auto pushed = values.try_push_back(7);
  return pushed ? 0 : 1;
}
int main() {
  mut Pool pool{};
  {
    /*😀*/ auto resource = std::bind_resource(pool);  //~ ERROR GTI-S2055
    int status = fill(resource);
    if (status != 1) { return status; }
  }
  pool.reset();
  return 0;
}
