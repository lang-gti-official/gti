{"file": {"name": "library.gti", "text": "export module procedural_macro_library;\nimport std.syntax;\n\n// Input includes the outer braces. Parsing the interior retains the caller's\n// names and source spans; it does not evaluate the expression.\nconstexpr std::syntax::tokens contents(std::syntax::tokens input) {\n  return std::syntax::slice(input, uint64_t(1),\n                            std::syntax::size(input) - uint64_t(1));\n}\n\nexport #macro(proc) std::syntax::expr identity(std::syntax::tokens input) {\n  return std::syntax::parse(contents(input));\n}\n\n// A non-HTML example: build an immediately invoked lambda whose argument runs\n// once. Its parameter has a fresh identity independent of caller spellings.\nexport #macro(proc) std::syntax::expr twice_once(std::syntax::tokens input) {\n  auto origin = std::syntax::location(input, uint64_t(0), uint64_t(1));\n  auto binding = std::syntax::fresh(\"saved\", origin);\n  auto saved = std::syntax::reference(binding);\n  mut auto output = std::syntax::punctuation(\"[\", origin);\n  output = std::syntax::join(output, std::syntax::punctuation(\"]\", origin));\n  output = std::syntax::join(output, std::syntax::punctuation(\"(\", origin));\n  output = std::syntax::join(output, std::syntax::keyword(\"int\", origin));\n  output = std::syntax::join(output, saved);\n  output = std::syntax::join(output, std::syntax::punctuation(\")\", origin));\n  output = std::syntax::join(output, std::syntax::punctuation(\"->\", origin));\n  output = std::syntax::join(output, std::syntax::keyword(\"int\", origin));\n  output = std::syntax::join(output, std::syntax::punctuation(\"{\", origin));\n  output = std::syntax::join(output, std::syntax::keyword(\"return\", origin));\n  output = std::syntax::join(output, saved);\n  output = std::syntax::join(output, std::syntax::punctuation(\"+\", origin));\n  output = std::syntax::join(output, saved);\n  output = std::syntax::join(output, std::syntax::punctuation(\";\", origin));\n  output = std::syntax::join(output, std::syntax::punctuation(\"}\", origin));\n  output = std::syntax::join(output, std::syntax::punctuation(\"(\", origin));\n  output = std::syntax::join(output,\n                            std::syntax::splice(std::syntax::parse(contents(input))));\n  output = std::syntax::join(output, std::syntax::punctuation(\")\", origin));\n  return std::syntax::parse(output);\n}\n"}}
{"file": {"name": "main.gti", "text": "import \"library.gti\";\nint main() { return identity!({twice_once!({21})}) - 42; }\n"}}
{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "$URI", "languageId": "gti", "version": 1, "text": "import \"library.gti\";\nint main() { return identity!({twice_once!({21})}) - 42; }\n"}}}}
{"expect": {"method": "textDocument/publishDiagnostics", "params": {"uri": "$URI", "version": 1, "diagnostics": []}}}
