// A changed generic default in a dirty declaration overlay rejects the open
// consumer's old arguments (GTI-S2067); closing the overlay restores the
// declaration on disk, so the original consumer is clean again and its
// variant hover shows the on-disk default at the UTF-16 position after a
// supplementary character. (generic_enum_lsp_test.py.)
{"file": {"name": "main.gti", "text": "import \"messages.gti\";\nclass Resource { public: Resource() {} ~Resource() {} };\nenum Owned { Empty, Item(Resource resource) };\nvoid forward<Args...>(Args... args) {}\nusing Count = Message<int32_t>;\nclass ClosureResource { public: ClosureResource() {} ~ClosureResource() {} };\nenum ClosureEvent<T> { empty, item(T value) };\nint main() {\n  forward(Owned::Item(Resource()));\n  auto owner = ClosureEvent<ClosureResource>::item(ClosureResource());\n  auto callback = [owner = std::move(owner)](ClosureEvent<ClosureResource> input) -> ClosureEvent<ClosureResource> {\n    return std::move(input);\n  };\n  auto result = callback(ClosureEvent<ClosureResource>::empty);\n  // The supplementary character tests UTF-16 navigation below.\n  /* 😀 */ auto first = Count::item(1, int64_t(2));\n  auto second = Message<bool, bool, 7>::item(true, false);\n  switch (first) {\n    case Message<int32_t>::idle: return 1;\n    case Message<int32_t>::item(payload, detail): break;\n  }\n  switch (second) {\n    case Message<bool, bool, 7>::idle: return 2;\n    case Message<bool, bool, 7>::item(payload, detail): return 0;\n  }\n}\n"}}
{"file": {"name": "messages.gti", "text": "export module messages;\nexport enum Message<T, U = int64_t, uint64_t Channel = 3> {\n  idle,\n  item(T payload, U detail)\n};\n"}}
