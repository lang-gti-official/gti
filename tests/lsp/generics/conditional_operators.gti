// Operators with a requires clause navigate the clause's concept; an
// instance that fails it is reported at the operator use; broken clause
// syntax recovers. (From conditional_member_operators_lsp_test.py.)
//@ definition @use: @decl
//@ hover @use: available<T>
//@ formatting: requires available<T>
concept /*@decl*/available<T> = std::numeric<T>;
class Box<T> {
public:
  Box() = default;
  int operator[](int index) requires /*@use*/available<T> { return index; }
  int operator()(int value) requires available<T> { return value; }
};
int main() { /* 🧮 */ Box<int> box{}; return box[0] + box(0); }
// --- step 2
