// Generic enum variants keep compiler-owned exact signatures: binder hover,
// definition and tokens in the declaration; exact instance signatures in
// hover, completion and patterns at the use; and a dirty declaration overlay
// (the `enum class` spelling, a changed default, a parse error and its repair)
// updates the consumer instead of the file on disk. (generic_enum_lsp_test.py;
// closing the overlay is generic_enum_overlay_close.jsonl.)
//@ hover @first: Message<int32_t, int64_t, 3>::item(int32_t payload, int64_t detail)
//@ hover @second: Message<bool, bool, 7>::item(bool payload, bool detail)
//@ hover @pattern: int32_t payload, int64_t detail
//@ completion-detail @count item: int32_t payload, int64_t detail
//@ completion @count: idle
//@ completion-detail @bools item: bool payload, bool detail
//@ completion @bools: idle
//@ token @first: enumMember
//@ definition @first: @messages.gti:variant
// --- main.gti
import "messages.gti";
class Resource { public: Resource() {} ~Resource() {} };
enum Owned { Empty, Item(Resource resource) };
void forward<Args...>(Args... args) {}
using Count = Message<int32_t>;
class ClosureResource { public: ClosureResource() {} ~ClosureResource() {} };
enum ClosureEvent<T> { empty, item(T value) };
int main() {
  forward(Owned::Item(Resource()));
  auto owner = ClosureEvent<ClosureResource>::item(ClosureResource());
  auto callback = [owner = std::move(owner)](ClosureEvent<ClosureResource> input) -> ClosureEvent<ClosureResource> {
    return std::move(input);
  };
  auto result = callback(ClosureEvent<ClosureResource>::empty);
  // The supplementary character tests UTF-16 navigation below.
  /* 😀 */ auto first = Count::/*^count*/it/*^first*/em(1, int64_t(2));
  auto second = Message<bool, bool, 7>::/*^bools*/it/*^second*/em(true, false);
  switch (first) {
    case Message<int32_t>::idle: return 1;
    case Message<int32_t>::/*@pattern*/item(payload, detail): break;
  }
  switch (second) {
    case Message<bool, bool, 7>::idle: return 2;
    case Message<bool, bool, 7>::item(payload, detail): return 0;
  }
}
// --- messages.gti
//@ hover @binder: type parameter T
//@ definition @use: @binder
//@ hover @channel: uint64_t Channel
//@ hover @message: enum Message<
//@ hover @variant: T payload, U detail
//@ token @binder: typeParameter
export module messages;
export enum /*@message*/Message</*@binder*/T, U = int64_t, uint64_t /*@channel*/Channel = 3> {
  idle,
  /*@variant*/item(/*@use*/T payload, U detail)
};
// --- step 2 messages.gti
//@ hover @message2: enum class Message<
export module messages;
export enum class /*@message2*/Message<T, U = int64_t, uint64_t Channel = 3> {
  idle,
  item(T payload, U detail)
};
