int main() { /*😀*/ accept<Item>(); return 0; }  //~ ERROR GTI-S2029 bitwise_relocatable
// --- step 3
class Item { public: Item() {} ~Item() {} };
void accept<std::relocatable T>() {}
int main() { /*😀*/ accept<Item>(); return 0; }
