// relocatable; an incomplete argument list recovers.
// (From structural_relocation_lsp_test.py.)
//@ hover @concept: concept std::bitwise_relocatable
class Item { public: Item() {} };
void accept<std::/*@concept*/bitwise_relocatable T>() {}
int main() { /*😀*/ accept<Item>(); return 0; }
