// TCP surface: error enum coverage, endpoint values and closed-state paths.
import std.tcp;
import std.chrono;

int32_t code_for(std::tcp::errc e) {
  switch (e) {
  case std::tcp::errc::not_open:
    return 1;
  case std::tcp::errc::connection_refused:
    return 2;
  case std::tcp::errc::timed_out:
    return 3;
  default:
    return 4;
  }
}

int main() {
  auto endpoint = std::tcp::socket_address(std::tcp::ipv4_address::loopback(), uint16_t(0));
  mut auto opened = std::tcp::listener::bind(endpoint);
  if (!opened) {
    std::println(code_for(opened.error()));
    return 0;
  }
  mut std::tcp::listener server = std::move(opened).value();
  std::print(server.is_open() ? 1 : 0); std::print(" ");
  auto idle = server.wait_acceptable(std::chrono::nanoseconds(int64_t(1000000)));
  std::print(idle ? 0 : code_for(idle.error())); std::print(" ");
  mut auto closed = server.close();
  std::print(closed.has_value() ? 1 : 0); std::print(" ");
  auto again = server.close();
  std::print(again ? 0 : code_for(again.error())); std::print(" ");
  std::println(server.is_open() ? 1 : 0);
  return 0;
}
