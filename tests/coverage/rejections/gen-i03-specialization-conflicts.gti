// INVALID: exact specializations that collide after canonicalization
// (alias and int/int32_t spellings), a symbolic (partial) pattern, an
// unqualified target, and a foreign/foreign key against a std primary.
import std.functional;
import std.vector;

namespace codec {
class traits<T> {
public:
  int32_t width() { return 0; }
public:
  traits() = default;
};
}

using Word = int32_t;

class codec::traits<int32_t> {
public:
  int32_t width() { return 32; }
public:
  traits() = default;
};

class codec::traits<Word> {
public:
  int32_t width() { return 33; }
};

class codec::traits<int> {
public:
  int32_t width() { return 34; }
};

class codec::traits<std::vector<T>> {
public:
  int32_t width() { return 1; }
};

class std::hash<int64_t> {
public:
  std::size_t operator()(int64_t& value) { return 0; }
};

int main() {
  codec::traits<int32_t> t{};
  return t.width();
}
