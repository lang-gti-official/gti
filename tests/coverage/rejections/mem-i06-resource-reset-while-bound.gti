// Invalid: a provider cannot be mutated (exclusive access) while a
// resource_vector built from its binding is still live; the owner retains a
// shared checked provider borrow through its cleanup.
import std.resource_vector;
import std.resource;
import std.memory;

class Counting {
  std::process_resource process{};
  mut int32_t generation = 0;
public:
  Counting() {}
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    unsafe { return this.process.allocate(request); }
  }
  unsafe void release(std::raw_allocation allocation) {
    unsafe { this.process.release(allocation); }
  }
  void reset() mut { this.generation += 1; }
};

int main() {
  mut Counting provider{};
  unsafe {
    std::resource_ref<Counting> bound = std::bind_resource(provider);
    mut std::resource_vector<int32_t, Counting> values{bound};
    values.push_back(1);
    provider.reset();
    return int32_t(values.size()) - 1;
  }
}
