// INVALID: a text view of a map key must not outlive the map.
#include <std/map>
#include <std/string>
std::string_view first_key() {
  mut std::map<std::string, int> table{};
  [[discard]] table.insert(std::string("k"), 1);
  auto first = table.begin();
  return (*first).first.view();
}
int main() { return int(first_key().size()); }
