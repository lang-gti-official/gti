// INVALID: the owner is moved inside the branch selected only for Mode == 0
// and read afterwards. Mode == 1 is valid; the Mode == 0 instance must be
// rejected by per-instance flow analysis, not accepted from the symbolic body.
#include <std/memory>

int32_t read_after<uint64_t Mode>(std::unique_ptr<int32_t> owner) {
  if constexpr (Mode == 0) {
    std::unique_ptr<int32_t> taken = std::move(owner);
  }
  return *owner;
}

int main() {
  int32_t ok = read_after<1>(std::make_unique<int32_t>(1));
  int32_t bad = read_after<0>(std::make_unique<int32_t>(2));
  return ok + bad;
}
