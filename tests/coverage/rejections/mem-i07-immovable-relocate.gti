// Invalid: relocate_to requires std::relocatable<T>; an immovable element type
// must be rejected at the call, not in the backend.
import std.memory;
class Pinned {
  int32_t v;
public:
  Pinned(int32_t v) : v(v) {}
  Pinned(Pinned& other) = delete;
  Pinned(Pinned&& other) = delete;
};
int main() {
  std::allocator heap{};
  mut auto a = heap.try_storage<Pinned>(std::size_t(1));
  mut auto b = heap.try_storage<Pinned>(std::size_t(1));
  mut std::storage<Pinned> left = std::move(a).value();
  mut std::storage<Pinned> right = std::move(b).value();
  left.emplace(std::size_t(0), 1);
  left.relocate_to(right, std::size_t(1));
  return 0;
}
