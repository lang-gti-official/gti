// INVALID: expected<T&, E> declares no value_or member (expected.md).
enum class errc { missing };
class Table {
  int value_ = 3;
public:
  Table() {}
  expected<int&, errc> find(bool ok) {
    if (!ok) { return unexpected(errc::missing); }
    return this.value_;
  }
};
int main() {
  Table table{};
  int fallback = 9;
  auto found = table.find(false);
  int& chosen = found.value_or(fallback);
  return chosen;
}
