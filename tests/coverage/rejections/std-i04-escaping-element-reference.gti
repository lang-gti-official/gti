// INVALID: returning a reference into a by-value (local) container that is
// destroyed when the function returns.
import std.map;
int& first_value(std::map<int, int> table) {
  int key = 1;
  return table.at(key);
}
int main() {
  mut std::map<int, int> table{};
  [[discard]] table.insert(1, 10);
  return first_value(std::move(table));
}
