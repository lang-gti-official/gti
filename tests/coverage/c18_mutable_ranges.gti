import std.vector;
class Accum { public: Accum() {} };
int main() {
  mut std::vector<int32_t> v = std::vector<int32_t>();
  v.push_back(1); v.push_back(2); v.push_back(3);
  for (mut auto& slot : v) { slot = slot * 10; }
  mut int32_t total = 0;
  for (auto& slot : v) { total = total + slot; }
  mut int32_t[3] raw = {1, 2, 3};
  for (mut auto& cell : raw) { cell = cell + 1; }
  for (auto& cell : raw) { total = total + cell; }
  std::println(total);
  return 0;
}
