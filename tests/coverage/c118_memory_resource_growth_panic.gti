// Valid (failure path): plain resource_vector growth on an exhausted resource
// aborts with GTI-R0011. No element, prepared push argument, region or local
// is cleaned up. Make output unbuffered so a missing cleanup witness cannot be
// confused with buffered output lost by abort.
#include <std/resource_vector>
#include <std/resource>
#include <std/memory>
#include <std/string>
#include "support/bump.gti"

extern "C" { void coverage_unbuffered_output(); }

class Loud {
  int32_t id;
public:
  Loud(int32_t id) : id(id) {}
  Loud(Loud& other) = delete;
  Loud(Loud&& other) = default;
  ~Loud() {
    std::print("drop ");
    std::println(this.id);
  }
};

void grow(std::resource_ref<probe::Bump> resource) {
  Loud before{100};
  mut std::resource_vector<Loud, probe::Bump> items{resource};
  items.emplace_back(1);
  items.emplace_back(2);
  items.emplace_back(3);
  items.emplace_back(4);
  std::println("full");
  items.push_back(Loud(5));
  std::println("unreachable");
}

int main() {
  coverage_unbuffered_output();
  probe::Bump resource{1, true};
  Loud outer{200};
  unsafe {
    // One object region, never reset or moved while bound. The initial
    // capacity-four allocation succeeds; the fifth insertion exhausts budget.
    std::resource_ref<probe::Bump> bound = std::bind_resource(resource);
    grow(bound);
  }
  return 1;
}
