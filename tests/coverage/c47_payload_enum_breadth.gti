// Payload enums with multi-field payloads and exhaustive switch binding.
#include <std/vector>

enum class Node {
  leaf,
  value(int32_t n),
  labelled(char tag, int32_t n),
};

int32_t weight(Node& node) {
  switch (node) {
  case Node::leaf:
    return 1;
  case Node::value(n):
    return n;
  case Node::labelled(tag, n):
    return int32_t(uint8_t(tag)) + n;
  }
}

int main() {
  mut std::vector<Node> nodes = std::vector<Node>();
  nodes.push_back(Node::leaf);
  nodes.push_back(Node::value(5));
  nodes.push_back(Node::labelled('a', 2));

  mut int32_t total = 0;
  for (auto& n : nodes) { total = total + weight(n); }
  std::print(total); std::print(" ");

  mut Node single = Node::labelled('z', 4);
  std::println(weight(single));
  return 0;
}
