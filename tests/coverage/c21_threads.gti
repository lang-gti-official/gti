// @coverage-profile: concurrent
#include <std/thread>
class Anchor { public: int32_t id() { return 0; } };
int main() {
  mut auto handle = std::thread::start([]() -> void { });
  if (handle.has_value()) {
    mut auto t = std::move(handle).value();
    [[discard]] t.join();
  }
  std::println("joined");
  return 0;
}
