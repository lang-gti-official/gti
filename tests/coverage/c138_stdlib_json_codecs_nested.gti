// Nested JSON codecs: a codec<LineItem> specialization for a class with an
// invariant is used automatically inside an Order struct's vector, an
// optional field defaults when absent, the order encodes back through the
// nested codec, a vector of orders round-trips, and the decoded move-only
// orders are indexed in a string-keyed map that itself encodes as an object.
#include <std/json>
#include <std/map>
#include <std/optional>
#include <std/string>
#include <std/vector>

class LineItem {
  std::string sku_;
  uint32_t quantity_;
public:
  LineItem(std::string sku, uint32_t quantity) : sku_(std::move(sku)), quantity_(quantity) {}
  std::string_view sku() { return this.sku_.view(); }
  uint32_t quantity() { return this.quantity_; }
};

struct line_record {
  std::string sku = std::string("");
  uint32_t quantity = 0;
public:
  line_record() = default;
};

class std::json::codec<LineItem> {
public:
  expected<void, std::json::error> encode(LineItem& item, mut std::string& out) {
    line_record record = {.sku = std::string(item.sku()), .quantity = item.quantity()};
    std::string text = ?std::json::encode(record);
    out.append(text.view());
    return;
  }
  expected<LineItem, std::json::error> decode(std::string_view text) {
    line_record record = ?std::json::decode<line_record>(text);
    if (record.quantity == 0) {
      return unexpected(std::json::error(std::json::errc::number_out_of_range, std::size_t(0), std::size_t(0), std::size_t(0)));
    }
    return LineItem(std::string(record.sku.view()), record.quantity);
  }
public:
  codec() = default;
};

struct Order {
  std::string id = std::string("");
  std::vector<LineItem> items = std::vector<LineItem>();
  std::optional<std::string> coupon = std::optional<std::string>();
public:
  Order() = default;
};

int main() {
  auto decoded = std::json::decode<Order>(
      "{\"id\":\"o-1\",\"items\":[{\"sku\":\"tea\",\"quantity\":2},{\"sku\":\"cup\",\"quantity\":1}]}");
  if (!decoded) { return 1; }
  Order order = std::move(decoded).value();
  if (order.id.view() != "o-1" || order.items.size() != std::size_t(2) ||
      order.items[std::size_t(0)].sku() != "tea" || order.items[std::size_t(1)].quantity() != 1 ||
      order.coupon.has_value()) {
    return 2;
  }

  // Encoding goes back through the nested codec and reports the empty coupon.
  auto encoded = std::json::encode(order);
  if (!encoded || encoded.value().view() != "{\"id\":\"o-1\",\"items\":[{\"sku\":\"tea\",\"quantity\":2},{\"sku\":\"cup\",\"quantity\":1}],\"coupon\":null}") {
    return 3;
  }

  // A codec failure keeps the element path; its offset is rebased to the input.
  auto rejected = std::json::decode<Order>("{\"id\":\"o-2\",\"items\":[{\"sku\":\"tea\",\"quantity\":0}]}");
  if (rejected || rejected.error().code != std::json::errc::number_out_of_range ||
      rejected.error().path.view() != "/items/0" || rejected.error().offset != std::size_t(21)) {
    return 4;
  }
  auto malformed = std::json::decode<Order>("{\"id\":\"o-3\",\"items\":[{\"sku\":\"tea\"}]}");
  if (malformed || malformed.error().code != std::json::errc::missing_field || malformed.error().path.view() != "/items/0/quantity") {
    return 5;
  }

  // A vector of orders round-trips, and the orders index into a map that
  // encodes as an object keyed by id.
  auto batch = std::json::decode<std::vector<Order>>(
      "[{\"id\":\"a\",\"items\":[],\"coupon\":\"SAVE\"},{\"id\":\"b\",\"items\":[{\"sku\":\"x\",\"quantity\":9}]}]");
  if (!batch) { return 6; }
  std::vector<Order> orders = std::move(batch).value();
  if (orders.size() != std::size_t(2) || !orders[std::size_t(0)].coupon.has_value() ||
      orders[std::size_t(0)].coupon.value().view() != "SAVE") {
    return 7;
  }
  mut std::map<std::string, Order> index = std::map<std::string, Order>();
  auto first = std::json::decode<Order>("{\"id\":\"a\",\"items\":[],\"coupon\":\"SAVE\"}");
  auto second = std::json::decode<Order>("{\"id\":\"b\",\"items\":[{\"sku\":\"x\",\"quantity\":9}]}");
  if (!first || !second) { return 7; }
  [[discard]] index.insert(std::string("a"), std::move(first).value());
  [[discard]] index.insert(std::string("b"), std::move(second).value());
  auto indexed = std::json::encode(index);
  if (!indexed || indexed.value().view() != "{\"a\":{\"id\":\"a\",\"items\":[],\"coupon\":\"SAVE\"},\"b\":{\"id\":\"b\",\"items\":[{\"sku\":\"x\",\"quantity\":9}],\"coupon\":null}}") {
    return 8;
  }
  auto reindexed = std::json::decode<std::map<std::string, Order>>(indexed.value().view());
  if (!reindexed || reindexed.value().size() != std::size_t(2)) { return 9; }
  std::string key_b = std::string("b");
  if (reindexed.value().at(key_b).items.size() != std::size_t(1)) { return 10; }
  return 0;
}
