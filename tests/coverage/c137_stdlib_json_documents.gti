// JSON documents: build a nested object/array tree, serialize compact and
// pretty, reparse and compare, walk objects with key_at/value_at and arrays
// with elements(), exact 64-bit extrema, escapes and surrogate pairs, error
// codes with locations/paths, nesting limits, and borrowed get() results.
#include <std/json>
#include <std/string>
#include <std/vector>
#include <std/format>

int count_numbers(std::json::value& node) {
  if (node.is_number()) { return 1; }
  mut int total = 0;
  if (node.is_array()) {
    for (auto& child : node.elements()) { total += count_numbers(child); }
  } else if (node.is_object()) {
    for (mut std::size_t i = 0; i < node.object_size(); i++) {
      total += count_numbers(node.value_at(i));
    }
  }
  return total;
}

int main() {
  mut auto root = std::json::value::object();
  mut auto servers = std::json::value::array();
  for (mut int i = 0; i < 3; i++) {
    mut auto server = std::json::value::object();
    std::string host = std::to_string(i);
    auto named = server.set("host", host.view());
    auto port = server.set("port", int64_t(8000 + i));
    auto up = server.set("up", i != 1);
    if (!named || !port || !up) { return 1; }
    auto pushed = servers.push(std::move(server));
    if (!pushed) { return 2; }
  }
  auto stored = root.set("servers", std::move(servers));
  auto lowest = root.set("lowest", int64_t(-9223372036854775807) - int64_t(1));
  auto highest = root.set("highest", uint64_t(18446744073709551615));
  auto text = root.set("text", "tab\tquote\"é");
  auto nothing = root.set("nothing", std::json::value::null());
  if (!stored || !lowest || !highest || !text || !nothing) { return 3; }
  // set() on an existing key replaces in place without reordering.
  auto replaced = root.set("lowest", int64_t(-1));
  if (!replaced || root.key_at(std::size_t(1)) != "lowest") { return 4; }

  std::string compact = std::json::stringify(root);
  std::println(compact);
  std::string expected_text{"{\"servers\":[{\"host\":\"0\",\"port\":8000,\"up\":true},{\"host\":\"1\",\"port\":8001,\"up\":false},{\"host\":\"2\",\"port\":8002,\"up\":true}],\"lowest\":-1,\"highest\":18446744073709551615,\"text\":\"tab\\tquote\\\"é\",\"nothing\":null}"};
  if (compact != expected_text) { return 5; }

  std::string pretty = std::json::stringify_pretty(root, uint8_t(1));
  auto reparsed = std::json::parse(pretty.view());
  if (!reparsed) { std::println(reparsed.error().description()); return 6; }
  mut auto copy = std::move(reparsed).value();
  if (std::json::stringify(copy) != compact) { return 7; }
  if (count_numbers(copy) != 5) { return 8; }

  // Borrowed get(): a checked read-only view into the document.
  {
    auto list = copy.get("servers");
    if (!list) { return 9; }
    std::json::value& array = list.value();
    if (!array.is_array() || array.size() != 3) { return 10; }
    auto port = array.at(std::size_t(2)).get_uint64("port");
    if (!port || port.value() != uint64_t(8002)) { return 11; }
    auto wrong = array.at(std::size_t(0)).get_boolean("host");
    if (wrong || wrong.error().code() != std::json::errc::type_mismatch) { return 12; }
  }
  auto huge = copy.get_uint64("highest");
  auto as_signed = copy.get_int64("highest");
  if (!huge || huge.value() != uint64_t(18446744073709551615)) { return 13; }
  if (as_signed || as_signed.error().code() != std::json::errc::number_out_of_range) { return 14; }
  auto decoded = copy.get_string("text");
  if (!decoded || decoded.value() != "tab\tquote\"é") { return 15; }
  if (!copy.contains("nothing") || !copy.at("nothing").is_null() || copy.contains("absent")) { return 16; }

  // Walk object keys in insertion order.
  mut std::string keys{};
  for (mut std::size_t i = 0; i < copy.object_size(); i++) {
    keys.append(copy.key_at(i).view());
    keys.push_back(' ');
  }
  if (keys != "servers lowest highest text nothing ") { return 17; }

  // Surrogate pair decoding, exact number lexemes and doubles.
  auto unicode = std::json::parse("{\"g\":\"\\ud83d\\ude00\",\"n\":1.50e2}");
  if (!unicode) { return 18; }
  mut auto u = std::move(unicode).value();
  auto g = u.get_string("g");
  auto n = u.get_double("n");
  if (!g || g.value().size() != 4 || !n || n.value() != 150.0) { return 19; }
  if (std::json::stringify(u) != "{\"g\":\"😀\",\"n\":1.50e2}") { return 20; }

  // Syntax errors carry a location; access errors carry a path instead.
  auto trailing = std::json::parse("{\n  \"a\": [1, 2,]\n}");
  if (trailing || !trailing.error().has_source_location() ||
      trailing.error().line() != 2 || trailing.error().code() != std::json::errc::unexpected_token) { return 21; }
  std::println("{}:{} {}", trailing.error().line(), trailing.error().column(), trailing.error().description());
  auto lone = std::json::parse("\"\\ud800\"");
  if (lone || lone.error().code() != std::json::errc::invalid_unicode) { return 22; }
  auto leading_zero = std::json::parse("[01]");
  if (leading_zero || leading_zero.error().code() != std::json::errc::invalid_number) { return 23; }

  mut std::json::parse_options shallow = std::json::parse_options();
  shallow.set_max_depth(std::size_t(2));
  auto deep = std::json::parse("[[1]]", shallow);  // scalars count as nested values
  if (deep || deep.error().code() != std::json::errc::nesting_limit) { return 24; }
  auto ok = std::json::parse("[1]", shallow);
  if (!ok) { return 25; }

  // Independent deep clone.
  mut auto edited = copy.clone();
  auto flipped = edited.at("servers").at(std::size_t(0)).set("up", false);
  if (!flipped) { return 26; }
  auto original = copy.at("servers").at(std::size_t(0)).get_boolean("up");
  if (!original || !original.value()) { return 27; }
  return 0;
}
