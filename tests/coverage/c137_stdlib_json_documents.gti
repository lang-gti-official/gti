// JSON documents: encode a nested struct compact and pretty, decode it back
// and compare, optionals for null and absent members, exact 64-bit extrema,
// escapes and surrogate pairs, error codes with paths and locations, and
// nesting limits.
#include <std/json>
#include <std/optional>
#include <std/string>
#include <std/vector>

struct point {
  int64_t x = 0;
  uint64_t y = 0;
};

struct shape {
  std::string name = std::string("");
  std::vector<point> outline = std::vector<point>();
  std::optional<std::string> note = std::optional<std::string>();
  bool closed = true;
};

int main() {
  point low = {.x = int64_t(-9223372036854775807) - int64_t(1), .y = uint64_t(0)};
  point high = {.x = int64_t(9223372036854775807), .y = uint64_t(18446744073709551615)};
  mut std::vector<point> outline = std::vector<point>();
  outline.push_back(low);
  outline.push_back(high);
  shape value = {.name = std::string("tab\there \"quoted\""), .outline = std::move(outline)};

  auto compact = std::json::encode(value);
  if (!compact) { return 1; }
  if (compact.value().view() != "{\"name\":\"tab\\there \\\"quoted\\\"\",\"outline\":[{\"x\":-9223372036854775808,\"y\":0},{\"x\":9223372036854775807,\"y\":18446744073709551615}],\"note\":null,\"closed\":true}") {
    return 2;
  }
  auto pretty = std::json::encode_pretty(value, uint8_t(1));
  if (!pretty) { return 3; }
  std::string readable_text = std::move(pretty).value();
  std::string_view readable = readable_text.view();
  if (readable.size() <= compact.value().size() || readable[std::size_t(0)] != '{' || readable[std::size_t(1)] != '\n') {
    return 4;
  }

  // Both texts decode to the same value.
  auto from_compact = std::json::decode<shape>(compact.value().view());
  auto from_pretty = std::json::decode<shape>(readable);
  if (!from_compact || !from_pretty) { return 5; }
  shape a = std::move(from_compact).value();
  shape b = std::move(from_pretty).value();
  if (a.name.view() != b.name.view() || a.name.view() != value.name.view() ||
      a.outline.size() != std::size_t(2) || b.outline.size() != std::size_t(2) ||
      a.outline[std::size_t(0)].x != low.x || a.outline[std::size_t(1)].y != high.y ||
      a.note.has_value() || b.note.has_value() || !a.closed) {
    return 6;
  }

  // Escapes and surrogate pairs decode to UTF-8; an absent optional is empty.
  auto escaped = std::json::decode<shape>("{\"name\":\"\\u0041\\ud83d\\ude00\",\"outline\":[],\"closed\":false}");
  if (!escaped) { return 7; }
  shape escaped_shape = std::move(escaped).value();
  std::string_view text = escaped_shape.name.view();
  if (text.size() != std::size_t(5) || text[std::size_t(0)] != 'A' || uint8_t(text[std::size_t(1)]) != uint8_t(240) ||
      escaped_shape.note.has_value() || escaped_shape.closed) {
    return 8;
  }

  // Errors: code, JSON Pointer path, line and column.
  auto missing = std::json::decode<shape>("{\n  \"outline\": [],\n  \"closed\": true\n}");
  if (missing || missing.error().code != std::json::errc::missing_field || missing.error().path.view() != "/name") {
    return 9;
  }
  auto wrong = std::json::decode<shape>("{\"name\":\"n\",\"outline\":[{\"x\":1,\"y\":-1}],\"closed\":true}");
  if (wrong || wrong.error().code != std::json::errc::number_out_of_range || wrong.error().path.view() != "/outline/0/y") {
    return 10;
  }
  auto syntax = std::json::decode<shape>("{\"name\":\"n\",\n\"outline\":[{\"x\":1,\"y\":2}\n\"closed\":true}");
  if (syntax || syntax.error().code != std::json::errc::unexpected_character || syntax.error().line != std::size_t(3) ||
      syntax.error().column != std::size_t(1)) {
    return 11;
  }
  auto duplicate = std::json::decode<point>("{\"x\":1,\"y\":2,\"x\":3}");
  if (duplicate || duplicate.error().code != std::json::errc::duplicate_key) { return 12; }

  // Limits.
  mut std::json::decode_options limits{};
  limits.set_max_depth(std::size_t(3));
  auto too_deep = std::json::decode<std::vector<std::vector<std::vector<std::vector<int32_t>>>>>("[[[[1]]]]", limits);
  if (too_deep || too_deep.error().code != std::json::errc::nesting_limit) { return 13; }
  auto within = std::json::decode<std::vector<std::vector<std::vector<int32_t>>>>("[[[1]]]", limits);
  if (!within) { return 14; }
  return 0;
}
