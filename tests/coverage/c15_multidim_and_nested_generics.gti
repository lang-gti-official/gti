import std.vector;
class Box<T> {
  mut T value;
public:
  Box(T value) : value(std::move(value)) {}
  T& get() { return this.value; }
};
T unwrap_twice<T>(Box<Box<T>>& outer) requires std::copyable<T> {
  return outer.get().get();
}
int main() {
  mut int32_t[2][3] grid = {};
  mut int32_t total = 0;
  for (mut std::size_t r = std::size_t(0); r < std::size_t(2); r++) {
    for (mut std::size_t c = std::size_t(0); c < std::size_t(3); c++) {
      grid[r][c] = int32_t(r) * 10 + int32_t(c);
      total = total + grid[r][c];
    }
  }
  mut Box<Box<int32_t>> nested = Box<Box<int32_t>>(Box<int32_t>(7));
  std::println(total + unwrap_twice(nested));
  return 0;
}
