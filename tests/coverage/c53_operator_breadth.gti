// Comparison, subscript, call, arrow-style and increment operator overloads.
class Counter {
  mut int32_t n = 0;
public:
  Counter(int32_t n) : n(n) {}
  int32_t value() { return this.n; }
  bool operator==(Counter& o) { return this.n == o.n; }
  bool operator!=(Counter& o) { return this.n != o.n; }
  bool operator<(Counter& o) { return this.n < o.n; }
  bool operator>(Counter& o) { return this.n > o.n; }
  bool operator<=(Counter& o) { return this.n <= o.n; }
  bool operator>=(Counter& o) { return this.n >= o.n; }
  Counter operator+(Counter& o) { return Counter(this.n + o.n); }
  int32_t operator()(int32_t scale) { return this.n * scale; }
public:
  Counter() = default;
};

class Table {
  mut int32_t slots[4];
public:
  Table() : slots({}) {}
  mut int32_t& operator[](std::size_t index) mut { return this.slots[index]; }
  int32_t& operator[](std::size_t index) { return this.slots[index]; }
};

int main() {
  Counter a = Counter(3);
  Counter b = Counter(7);
  std::print(a == b ? 1 : 0);
  std::print(a != b ? 1 : 0);
  std::print(a < b ? 1 : 0);
  std::print(a > b ? 1 : 0);
  std::print(a <= b ? 1 : 0);
  std::print(a >= b ? 1 : 0);
  std::print(" ");
  std::print((a + b).value()); std::print(" ");
  std::print(a(5)); std::print(" ");

  mut Table t = Table();
  t[std::size_t(0)] = 9;
  t[std::size_t(3)] = 1;
  std::println(t[std::size_t(0)] + t[std::size_t(3)]);
  return 0;
}
