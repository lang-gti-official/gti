// WORKAROUND variant of v10 (no structured binding over a class array).
// Defaulted/deleted copy and move policies combined with static live-instance
// counters, move-only values in vectors and fields, implicit move on return,
// move assignment dropping the old value, and structured bindings over
// struct results of functions, methods and fixed arrays of structs.
import std.format;
import std.vector;

class Ticket {
  int32_t id;
public:
  static mut int32_t live = 0;
  static mut int32_t dropped_ids = 0;
  Ticket(int32_t id) : id(id) { live += 1; }
  Ticket(Ticket& other) = delete;
  Ticket(Ticket&& other) = default;
  ~Ticket() {
    live -= 1;
    dropped_ids = dropped_ids * 10 + this.id;
  }
  int32_t value() { return this.id; }
};

class Snapshot {
  int32_t v;
public:
  Snapshot(int32_t v) : v(v) {}
  Snapshot(Snapshot& other) = default;
  Snapshot(Snapshot&& other) = default;
  int32_t get() { return this.v; }
};

class Holder {
  mut Ticket ticket;
  Snapshot snap;
public:
  Holder(Ticket ticket, Snapshot snap) : ticket(std::move(ticket)), snap(snap) {}
  int32_t sum() { return this.ticket.value() + this.snap.get(); }
  void replace(Ticket t) mut { this.ticket = std::move(t); }
};

struct Range {
  int32_t lo;
  int32_t hi;
  Range(int32_t lo, int32_t hi) : lo(lo), hi(hi) {}
  int32_t width() { return this.hi - this.lo; }
  Range grown(int32_t by) { return Range(this.lo - by, this.hi + by); }
};

Ticket issue(int32_t id) {
  Ticket t = Ticket(id);
  return t; // implicit move of a move-only local
}

Range span_of(std::vector<int32_t>& values) {
  mut int32_t lo = values[std::size_t(0)];
  mut int32_t hi = lo;
  for (auto& v : values) {
    if (v < lo) { lo = v; }
    if (v > hi) { hi = v; }
  }
  return Range(lo, hi);
}

int main() {
  {
    mut std::vector<Ticket> queue{};
    queue.push_back(issue(1));
    queue.push_back(Ticket(2));
    mut Ticket third = issue(3);
    queue.push_back(std::move(third));
    if (Ticket::live != 3) { return 1; }
    mut int32_t s = 0;
    for (auto& t : queue) { s += t.value(); }
    if (s != 6) { return 2; }
  }
  if (Ticket::live != 0) { return 3; }
  Ticket::dropped_ids = 0;

  {
    Snapshot base = Snapshot(5);
    Snapshot copy1 = Snapshot(base);
    mut Holder h = Holder(issue(7), base);
    if (h.sum() != 12 || copy1.get() != 5) { return 4; }
    h.replace(Ticket(8));            // old ticket 7 dropped by assignment
    if (Ticket::dropped_ids != 7 || Ticket::live != 1) { return 5; }
    if (h.sum() != 13) { return 6; }

    mut Ticket a = Ticket(4);
    Ticket b = Ticket(9);
    a = std::move(b);                // ticket 4 dropped
    if (Ticket::dropped_ids != 74 || a.value() != 9) { return 7; }
  }
  // a(9) then h's ticket(8) at scope end (reverse declaration order)
  if (Ticket::live != 0 || Ticket::dropped_ids != 7498) { std::println("{}", Ticket::dropped_ids); return 8; }

  mut std::vector<int32_t> values{};
  values.push_back(4); values.push_back(-2); values.push_back(9);
  auto [lo, hi] = span_of(values);
  if (lo != -2 || hi != 9) { return 9; }

  Range r = Range(1, 3);
  auto [glo, ghi] = r.grown(2);
  if (glo != -1 || ghi != 5) { return 10; }

  Range pairs[2] = {Range(0, 1), Range(5, 8)};
  // WORKAROUND: `auto [first, second] = pairs;` emits invalid C++ / ICEs.
  if (pairs[0].width() + pairs[1].width() != 4) { return 11; }

  std::println("tickets ok {} span {}..{}", Ticket::dropped_ids, lo, hi);
  return 0;
}
