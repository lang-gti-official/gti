export module math_a;
namespace engine::math {
  export using scalar = int32_t;

  static int helper() { return 1; }

  export scalar add(scalar a, scalar b) { return a + b; }
  export int from_a() { return helper(); }

  export class Counter {
  public:
    static mut int created = 0;
    static int limit = 10;
    Counter() {}
    static void bump() { created = created + 1; }
  };
}

export namespace em = engine::math;
