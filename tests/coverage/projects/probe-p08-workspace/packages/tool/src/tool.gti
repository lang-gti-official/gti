import core;
import "scorers.gti";
import std.vector;

int main() {
  mut std::vector<int> values{};
  values.push_back(1);
  values.push_back(2);
  values.push_back(3);
  tool::Squarer squarer{};
  core::Doubler doubler{};
  int squares = core::apply_all(squarer, values);
  int doubles = core::apply_all(doubler, values);
  if (squares != 14 || doubles != 12) {
    return 1;
  }
  if (core::pick(false, 1, 2) != 2) {
    return 2;
  }
  std::println("tool ok");
  return 0;
}
