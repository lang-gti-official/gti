export module stats;
import base.core;
import std.vector;
import "detail/accumulate.gti";

namespace mid::stats {
  export int start = base::core::seed() * 10;

  export int doubled_sum(std::vector<int>& values) {
    return base::core::twice(mid::detail::accumulate(values));
  }

  export int total_area(base::core::Shape& a, base::core::Shape& b) {
    return a.area() + b.area();
  }

  export int total_sides(base::core::Shape& a, base::core::Shape& b) {
    return a.sides() + b.sides();
  }

  export int twice_calls() { return base::core::calls; }
}

namespace mid::stats {
  export class Summary {
  public:
    int total;
    Summary(int t) : total(t) {}
    int doubled() { return base::core::twice(total); }
  };
  export Summary summarize(int value) { return Summary(value); }
}
