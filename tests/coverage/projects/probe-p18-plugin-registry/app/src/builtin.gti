export module builtin;
import plugins;
import std.memory;
import std.string;

namespace app {
  export class Doubler : public plugins::Plugin {
    mut int calls = 0;

  public:
    Doubler() {}
    int run(int input) mut override {
      this.calls++;
      return input * 2;
    }
    std::string name() override { return std::string("double"); }
  };

  export class Adder : public plugins::Plugin {
    int amount;

  public:
    Adder(int a) : amount(a) {}
    int run(int input) mut override { return input + this.amount; }
    std::string name() override { return std::string("add"); }
  };

  export void install(mut plugins::Registry& registry) {
    registry.add(std::upcast_unique<plugins::Plugin, Doubler>(std::make_unique<Doubler>()));
    registry.add(std::upcast_unique<plugins::Plugin, Adder>(std::make_unique<Adder>(2)));
  }
}
