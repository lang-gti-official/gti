#include <std/vector>

namespace inv {
  class Inventory {
    mut std::vector<int> counts = std::vector<int>();

  public:
    Inventory() {}
    void add(int count) mut { counts.push_back(count); }
    int total() {
      mut int sum = 0;
      for (int value : counts) {
        sum = sum + value;
      }
      return sum;
    }
    int at(uint64_t index) { return counts[index]; }
    uint64_t size() { return counts.size(); }
  };
}
