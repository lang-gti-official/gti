// Payload enums driving a small state machine with generics and strings.
#include <std/string>
#include <std/vector>

enum class Token {
  end,
  number(int32_t value),
  word(char first, int32_t length),
};

int32_t score(Token token) {
  switch (token) {
  case Token::end:
    return 0;
  case Token::number(value):
    return value;
  case Token::word(first, length):
    return int32_t(uint8_t(first)) + length;
  }
}

int main() {
  mut std::vector<Token> tokens = std::vector<Token>();
  tokens.push_back(Token::number(7));
  tokens.push_back(Token::word('a', 3));
  tokens.push_back(Token::end);

  mut int32_t total = 0;
  for (auto& t : tokens) {
    total = total + score(t);
  }
  std::println(total);
  return 0;
}
