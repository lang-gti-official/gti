// Recursion, nested loops, break/continue, early return and while/do shapes.
class Anchor { public: int32_t id() { return 0; }  public: Anchor() = default; };

int32_t fib(int32_t n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}

int32_t grid_scan() {
  mut int32_t hits = 0;
  for (mut int32_t r = 0; r < 5; r++) {
    if (r == 3) { continue; }
    for (mut int32_t c = 0; c < 5; c++) {
      if (c > r) { break; }
      hits = hits + 1;
    }
  }
  return hits;
}

int32_t while_shapes() {
  mut int32_t n = 0;
  mut int32_t total = 0;
  while (n < 4) { total = total + n; n = n + 1; }
  mut int32_t m = 0;
  do { total = total + 1; m = m + 1; } while (m < 3);
  return total;
}

int main() {
  std::print(fib(10)); std::print(" ");
  std::print(grid_scan()); std::print(" ");
  std::println(while_shapes());
  return 0;
}
