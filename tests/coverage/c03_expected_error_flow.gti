// expected<T,E> with the propagation operator across several call layers.
#include <std/string>

enum class parse_errc {
  empty_input,
  bad_digit,
};

expected<int32_t, parse_errc> digit_value(char c) {
  uint8_t code = uint8_t(c);
  if (code < uint8_t('0') || code > uint8_t('9')) {
    return unexpected(parse_errc::bad_digit);
  }
  return int32_t(code) - int32_t(uint8_t('0'));
}

expected<int32_t, parse_errc> parse_number(std::string_view text) {
  if (text.size() == std::size_t(0)) {
    return unexpected(parse_errc::empty_input);
  }
  mut int32_t total = 0;
  for (mut std::size_t i = std::size_t(0); i < text.size(); i++) {
    int32_t d = ?digit_value(text[i]);
    total = total * 10 + d;
  }
  return total;
}

expected<int32_t, parse_errc> doubled(std::string_view text) {
  int32_t v = ?parse_number(text);
  return v * 2;
}

int main() {
  mut auto good = doubled("123");
  mut auto bad = doubled("12x");
  mut auto empty = doubled("");
  std::print(good.has_value() ? good.value() : -1);
  std::print(" ");
  std::print(bad.has_value() ? 0 : 1);
  std::print(" ");
  std::println(empty.has_value() ? 0 : 1);
  return 0;
}
