// F7: an invalid json::decode<T> with no codec reaches the backend through bodyless primary
// codec members (ICE instead of a semantic diagnostic).
// INVALID: decoding an application type that has no std::json::codec
// specialization. The primary codec declares bodyless decode/encode members
// and "supplies no fallback behavior" (docs/language/json.md), so this must
// be a GTI diagnostic, not a native link failure.
#include <std/json>
#include <std/string>
class Config {
public:
  int retries;
  Config(int retries) : retries(retries) {}
  Config(Config& other) = delete;
  Config(Config&& other) = default;
};
int main() {
  auto decoded = std::json::decode<Config>("{\"retries\":3}");
  if (!decoded) { return 1; }
  return decoded.value().retries == 3 ? 0 : 2;
}
