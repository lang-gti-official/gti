// A45: a derived class whose base carries state is GTI-B0003 (constructor lacks rollback
// authority for a state-bearing base subobject).
class Base {
public:
  int32_t x = 1;
};
class Derived : public Base {
public:
  Derived() { std::println(2); }
};
int main() {
  Derived d = Derived();
  return d.x - 1;
}
