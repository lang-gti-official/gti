#include <std/vector>
#include <std/algorithm>
class Positive {
public:
  Positive() {}
  bool operator()(int32_t value) { return value > 1; }
};
int main() {
  mut std::vector<int32_t> values = std::vector<int32_t>();
  values.push_back(0); values.push_back(2);
  std::ptrdiff_t big = std::count_if(values.begin(), values.end(), Positive());
  std::println(int32_t(big));
  return 0;
}
