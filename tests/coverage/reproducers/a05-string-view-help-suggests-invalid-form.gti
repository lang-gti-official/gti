// A05: GTI-S2003 correctly rejects passing a std::string where a
// std::string_view is required, but its help suggests
// 'std::string_view(value)', which is itself rejected (GTI-S2030). The
// working form is 'word.view()'.
import std.string;

int main() {
  std::string word = std::string("abc");
  mut std::string out{};
  out.append(word);
  return 0;
}
