// A36: ': child_(nullptr)' for a unique_ptr field is rejected although the field
// initializer '= nullptr' is accepted.
#include <std/memory>
class Node {
  std::unique_ptr<int> child_;
public:
  Node() : child_(nullptr) {}
  bool empty() { return !this.child_; }
};
int main() { Node n{}; return n.empty() ? 0 : 1; }
