class Val {
  mut int32_t n = 0;
public:
  Val(int32_t n) : n(n) {}
  int32_t get() { return this.n; }
  Val twin() { return Val(this.n); }
public:
  Val() = default;
};
int32_t take(Val v) { return v.get(); }
class Holder {
  mut Val inner;
public:
  Holder(Val v) : inner(std::move(v)) {}
  int32_t get() { return this.inner.get(); }
};
int main() { mut Val named = Val(5); mut Holder h = Holder(named); int32_t r = h.get(); std::println(r); return 0; }
