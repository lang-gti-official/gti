// A41: passing a fixed-array argument through storage::emplace fails with no diagnostic.
import std.memory;
class Holder {
  int32_t values[3];
public:
  Holder(int32_t initial[3]) : values(initial) {}
  int32_t sum() { return this.values[0] + this.values[1] + this.values[2]; }
};
int main() {
  std::allocator heap{};
  mut auto made = heap.try_storage<Holder>(std::size_t(1));
  mut std::storage<Holder> s = std::move(made).value();
  int32_t seed[3] = {1, 2, 3};
  s.emplace(std::size_t(0), seed);
  return s.get(std::size_t(0)).sum() - 6;
}
