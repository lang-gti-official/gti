// A55: the underlying shape, a constructor-local pack forwarding a move-only element.
// ICE: a constructor-local pack forwards a move-only element (std::string)
// into a generic field initializer T(args...). Same shape as the private
// list_node/deque_node constructors behind list/deque/queue emplacement.
import std.string;
class Task {
  std::string name_;
public:
  Task(std::string name) : name_(std::move(name)) {}
  Task(Task& other) = delete;
  Task(Task&& other) = default;
};
struct Node<T> {
  mut T value;
  Node<Args...>(Args... args) : value(T(args...)) {}
};
int main() {
  Node<Task> owned = Node<Task>(std::string("c"));
  return 0;
}
