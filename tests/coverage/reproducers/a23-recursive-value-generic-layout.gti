// A23: a finite value-generic recursion ended by a specialization is rejected as
// self-containing, with follow-on errors.
namespace shapes {
struct Layer<uint64_t N> {
  Layer<N - 1> inner;
  int32_t value = 1;
};
}

struct shapes::Layer<0> {
  int32_t value = 100;
};

int main() {
  shapes::Layer<2> stack{};
  return stack.value - 1;
}
