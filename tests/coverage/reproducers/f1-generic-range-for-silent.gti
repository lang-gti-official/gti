#include <std/vector>
int32_t count_all<std::copyable T>(std::vector<T>& values) requires std::vector_element<T> {
  mut int32_t total = 0;
  for (auto& v : values) { total = total + 1; }
  return total;
}
int main() {
  mut std::vector<int32_t> ints = std::vector<int32_t>();
  ints.push_back(3);
  std::println(count_all(ints));
  return 0;
}
