// A56: std::make_unique<T>(T value) is a backend ICE.
// ICE: std::make_unique<T>(T value) -- heap-allocating an already-built value
// of the same type. Fails for a passive copyable struct, user move-only
// classes, std::string and std::vector; make_unique<T>(other args) works.
import std.memory;
struct Copyable {
  int v;
  Copyable(int v) : v(v) {}
};
int main() {
  auto p = std::make_unique<Copyable>(Copyable(3));
  return p->v == 3 ? 0 : 1;
}
