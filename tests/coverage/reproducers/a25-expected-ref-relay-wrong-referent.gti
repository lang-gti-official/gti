// A25: WRONG RESULT. Returning a local reference through expected<T&, E> yields the
// parameter (prints 1) instead of the referent (2).
// WRONG RESULT: a free function returning expected<T&, E> from a local
// reference derived from its reference parameter returns the parameter itself
// (the root, value 1) instead of the child (value 2). Exits 1, prints 1.
#include <std/memory>
enum class errc { missing };
class Node {
  int value_;
  std::unique_ptr<Node> child_;
public:
  Node(int value, int child) : value_(value), child_(std::make_unique<Node>(child, true)) {}
  Node(int value, bool leaf) : value_(value), child_(std::unique_ptr<Node>(nullptr)) {}
  int value() { return this.value_; }
  Node& child() { return *this.child_; }
};
expected<Node&, errc> relay(Node& node) {
  Node& inner = node.child();
  return inner;
}
int main() {
  Node root{1, 2};
  auto r = relay(root);
  std::println(r.value().value());
  return r.value().value() == 2 ? 0 : 1;
}
