// A01: the same field assignment from a class-valued call result.
struct Cents {
  mut int64_t amount = 0;
public:
  Cents() = default;
};

Cents make(int64_t amount) {
  mut Cents made{};
  made.amount = amount;
  return made;
}

struct Holder {
  mut Cents balance = Cents();
public:
  Holder() = default;
};

int main() {
  mut Holder holder{};
  holder.balance = make(int64_t(7));
  return holder.balance.amount == int64_t(7) ? 0 : 1;
}
