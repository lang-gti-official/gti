// cstdio file handles: write, read back, and error propagation through expected.
import std.cstdio;
import std.string;

expected<std::string, std::io_errc> round_trip(std::string_view path) {
  mut auto writer = ?std::fopen(path, std::file_mode::write);
  ?writer->write("hello coverage");
  writer.reset();

  mut auto reader = ?std::fopen(path, std::file_mode::read);
  mut std::string body = ?reader->read_some(std::size_t(64));
  return std::move(body);
}

int main() {
  mut auto result = round_trip("coverage-roundtrip.txt");
  if (!result) {
    std::println("io failure");
    return 1;
  }
  mut std::string body = std::move(result).value();
  std::print(int32_t(body.size())); std::print(" ");
  std::println(body.view());
  return 0;
}
