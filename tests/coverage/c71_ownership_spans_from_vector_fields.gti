// std::span borrowed from a vector field through receiver methods,
// sub-spans on temporaries and locals, by-value span relays, a mutable span
// over a field in a mut method, and owner growth after the spans end.
import std.span;
import std.vector;

int sum(std::span<int> values) {
  mut int total = 0;
  for (auto& value : values) {
    total += value;
  }
  return total;
}

std::span<int> relay(std::span<int> values) { return values; }
// `return values.last(count);` from a by-value span parameter is rejected
// with GTI-S2085 (documented by-value carrier limit).
int tail_sum(std::span<int> values, std::size_t count) {
  return sum(values.last(count));
}

class Series {
  mut std::vector<int> values_{};

public:
  Series() {}
  void push(int value) mut { this.values_.push_back(value); }
  std::span<int> window() { return this.values_.as_span(); }
  std::span<int> recent(std::size_t count) {
    std::span<int> all = this.values_.as_span();
    return all.last(count);
  }
  void scale(int factor) mut {
    mut std::mutable_span<int> all = this.values_.as_mutable_span();
    for (mut auto& value : all) {
      value *= factor;
    }
  }
};

int main() {
  mut Series series{};
  for (mut int i = 1; i <= 6; i += 1) {
    series.push(i);
  }
  std::span<int> whole = series.window();
  if (sum(whole) != 21 || whole.size() != std::size_t(6)) { return 1; }
  std::span<int> recent = series.recent(std::size_t(3));
  if (sum(recent) != 15 || recent.front() != 4) { return 2; }
  if (tail_sum(whole, std::size_t(2)) != 11) { return 3; }
  std::span<int> relayed = relay(relay(whole));
  std::span<int> middle = relayed.subspan(std::size_t(1), std::size_t(2));
  if (sum(middle) != 5 || middle[std::size_t(1)] != 3) { return 4; }
  mut int loop_total = 0;
  for (mut std::size_t start = std::size_t(0); start < whole.size();
       start += std::size_t(2)) {
    loop_total += sum(whole.subspan(start, std::size_t(2)));
  }
  if (loop_total != 21) { return 5; }

  // Every span has ended: mutate the owner through a mutable span, then grow.
  series.scale(2);
  series.push(7);
  std::span<int> after = series.window();
  if (sum(after) != 49 || after.back() != 7) { return 6; }
  std::println(sum(after));
  std::println("v05 ok");
  return 0;
}
