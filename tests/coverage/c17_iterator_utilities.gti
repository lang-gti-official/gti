#include <std/vector>
#include <std/iterator>
#include <std/algorithm>
int main() {
  mut std::vector<int32_t> v = std::vector<int32_t>();
  v.push_back(10); v.push_back(20); v.push_back(30); v.push_back(40);
  std::ptrdiff_t n = std::distance(v.begin(), v.end());
  mut auto cur = std::next(v.begin());
  mut auto adv = std::next(std::next(v.begin()));
  int32_t needle = 30;
  mut auto found = std::find(v.begin(), v.end(), needle);
  std::print(int32_t(n)); std::print(" ");
  std::print(*cur); std::print(" ");
  std::print(*adv); std::print(" ");
  std::println(*found);
  return 0;
}
