#include <std/random>
#include <std/cmath>
class Anchor { public: int32_t id() { return 0; } };
int main() {
  mut std::random_engine engine = std::random_engine(uint64_t(12345));
  uint64_t a = engine();
  uint64_t b = engine();
  float neg = -2.5;
  float abs_value = std::abs(neg);
  std::print(a == b ? 0 : 1); std::print(" ");
  std::print(std::isfinite(abs_value) ? 1 : 0); std::print(" ");
  std::println(int32_t(abs_value));
  return 0;
}
