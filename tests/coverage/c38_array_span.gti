// Fixed-capacity array plus span views over it.
#include <std/array>
#include <std/span>

int32_t sum_span(std::span<int32_t> view) {
  mut int32_t total = 0;
  for (mut std::size_t i = std::size_t(0); i < view.size(); i++) {
    total = total + view[i];
  }
  return total;
}

int main() {
  mut std::array<int32_t, 4> values = std::array<int32_t, 4>();
  values.fill(2);
  values[std::size_t(0)] = 5;
  values[std::size_t(3)] = 9;

  std::print(int32_t(values.size())); std::print(" ");
  std::print(values.front()); std::print(values.back()); std::print(" ");
  std::print(values.empty() ? 1 : 0); std::print(" ");

  mut std::array<int32_t, 0> none = std::array<int32_t, 0>();
  std::println(none.empty() ? 1 : 0);
  return 0;
}
