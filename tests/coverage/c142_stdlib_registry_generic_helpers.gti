// A registry class owning std::map<int, unique_ptr<Shape>> (interface
// dispatch through map values), receiver-tied borrowed lookups (read-only and
// mut), generic member pruning with a predicate (collect keys, then erase),
// generic free helpers over maps and complete ranges, and set algebra over
// two std::set<int> via ordered traversal.
#include <std/map>
#include <std/set>
#include <std/memory>
#include <std/vector>
#include <std/algorithm>
#include <std/iterator>
#include <std/functional>

interface Shape {
  int area();
  void scale(int factor) mut;
};

class Square : public Shape {
  mut int side;
public:
  Square(int side) : side(side) {}
  int area() override { return this.side * this.side; }
  void scale(int factor) mut override { this.side *= factor; }
};

class Rect : public Shape {
  mut int w;
  mut int h;
public:
  Rect(int w, int h) : w(w), h(h) {}
  int area() override { return this.w * this.h; }
  void scale(int factor) mut override { this.w *= factor; this.h *= factor; }
};

class Registry {
  mut std::map<int, std::unique_ptr<Shape>> shapes;
  mut int next_id;
public:
  Registry() : shapes(std::map<int, std::unique_ptr<Shape>>()), next_id(1) {}
  int add(std::unique_ptr<Shape> shape) mut {
    int id = this.next_id;
    this.next_id++;
    [[discard]] this.shapes.insert(id, std::move(shape));
    return id;
  }
  Shape& get(int id) { return *this.shapes.at(id); }
  mut Shape& get_mut(int id) mut { return *this.shapes.at(id); }
  std::size_t size() { return this.shapes.size(); }
  int total_area() {
    mut int total = 0;
    // Workaround: entry.second->area() on a range-for element ICEs (repro/rB).
    auto stop = this.shapes.end();
    for (mut auto it = this.shapes.begin(); it != stop; ++it) { total += (*it).second->area(); }
    return total;
  }
  std::size_t prune<Predicate>(mut Predicate doomed) mut
      requires std::read_callable<Predicate, int, bool> {
    // Workaround: range-for inside a method-local generic fails silently
    // (repro/rF2); use an explicit cursor/sentinel loop and index loop.
    mut std::vector<int> victims{};
    auto stop = this.shapes.end();
    for (mut auto it = this.shapes.begin(); it != stop; ++it) {
      // Workaround: `Shape& shape = *(*it).second;` ICEs in MIR (repro/rG).
      int area = (*it).second->area();
      if (doomed(area)) { victims.push_back((*it).first); }
    }
    for (mut std::size_t i = 0; i < victims.size(); i++) {
      int id = victims[i];
      [[discard]] this.shapes.erase(id);
    }
    return victims.size();
  }
};

std::size_t count_where<K, V, Predicate>(std::map<K, V>& source, mut Predicate keep)
    requires std::read_callable<Predicate, V, bool> {
  mut std::size_t found = 0;
  for (auto& entry : source) {
    if (keep(entry.second)) { found++; }
  }
  return found;
}

int sum_range<Range>(Range& values) requires std::range_of<Range, int> {
  mut int total = 0;
  for (auto& value : values) { total += value; }
  return total;
}

class Small {
public:
  bool operator()(int& area) { return area < 10; }
public:
  Small() = default;
};

int main() {
  mut Registry registry{};
  int a = registry.add(std::upcast_unique<Shape, Square>(std::make_unique<Square>(2)));
  int b = registry.add(std::upcast_unique<Shape, Rect>(std::make_unique<Rect>(3, 5)));
  int c = registry.add(std::upcast_unique<Shape, Square>(std::make_unique<Square>(1)));
  if (registry.size() != 3 || registry.total_area() != 4 + 15 + 1) { return 1; }

  {
    Shape& rect = registry.get(b);
    if (rect.area() != 15) { return 2; }
  }
  registry.get_mut(a).scale(3);   // 2 -> 6
  if (registry.get(a).area() != 36) { return 3; }

  if (registry.prune(Small()) != 1 || registry.size() != 2) { return 4; }
  if (registry.total_area() != 36 + 15) { return 5; }

  mut std::map<int, int> stock{};
  for (mut int i = 0; i < 10; i++) { [[discard]] stock.insert(i, i * i); }
  std::size_t big = count_where(stock, [](int& v) -> bool { return v > 20; });
  if (big != 5) { return 6; }

  std::vector<int> listed = {4, 8, 15, 16, 23, 42};
  int[4] fixed = {1, 2, 3, 4};
  if (sum_range(listed) != 108 || sum_range(fixed) != 10) { return 7; }

  // Ordered set intersection/difference by walking two sorted ranges.
  std::set<int> left = {1, 3, 5, 7, 9, 11};
  std::set<int> right = {3, 4, 5, 6, 11, 12};
  mut std::vector<int> both{};
  mut std::vector<int> only_left{};
  for (auto& value : left) {
    if (right.contains(value)) { both.push_back(value); } else { only_left.push_back(value); }
  }
  if (sum_range(both) != 3 + 5 + 11 || sum_range(only_left) != 1 + 7 + 9) { return 8; }
  int six = 6;
  auto right_end = right.end();
  auto first_ge = right.lower_bound(six);
  if (!(first_ge != right_end) || *first_ge != 6) { return 9; }
  std::ptrdiff_t tail = std::distance(right.upper_bound(six), right.end());
  if (tail != 2) { return 10; }
  return c == 3 ? 0 : 11;
}
