// A rational-number value class with arithmetic, unary, comparison and
// compound-assignment operators; long chained expressions mixing operators on
// class results, comparisons applied directly to operator results, methods on
// operator results, and an operator used inside a loop accumulator.
import std.format;

int32_t gcd(int32_t a, int32_t b) {
  mut int32_t x = a < 0 ? 0 - a : a;
  mut int32_t y = b < 0 ? 0 - b : b;
  while (y != 0) {
    int32_t t = x % y;
    x = y;
    y = t;
  }
  return x == 0 ? 1 : x;
}

class Fraction {
  mut int32_t num;
  mut int32_t den;
public:
  Fraction(int32_t n, int32_t d) : num(0), den(1) {
    int32_t g = gcd(n, d);
    int32_t sign = d < 0 ? -1 : 1;
    this.num = sign * n / g;
    this.den = sign * d / g;
  }
  int32_t numerator() { return this.num; }
  int32_t denominator() { return this.den; }

  Fraction operator+(Fraction o) { return Fraction(this.num * o.den + o.num * this.den, this.den * o.den); }
  Fraction operator-(Fraction o) { return Fraction(this.num * o.den - o.num * this.den, this.den * o.den); }
  Fraction operator*(Fraction o) { return Fraction(this.num * o.num, this.den * o.den); }
  Fraction operator/(Fraction o) { return Fraction(this.num * o.den, this.den * o.num); }
  Fraction operator*(int32_t k) { return Fraction(this.num * k, this.den); }
  Fraction operator-() { return Fraction(0 - this.num, this.den); }

  bool operator==(Fraction o) { return this.num == o.num && this.den == o.den; }
  bool operator!=(Fraction o) { return !(this.num == o.num && this.den == o.den); }
  bool operator<(Fraction o) { return this.num * o.den < o.num * this.den; }
  bool operator>=(Fraction o) { return !(this.num * o.den < o.num * this.den); }

  void operator+=(Fraction o) mut {
    int32_t n = this.num * o.den + o.num * this.den;
    int32_t d = this.den * o.den;
    int32_t g = gcd(n, d);
    this.num = n / g;
    this.den = d / g;
  }
  void operator*=(int32_t k) mut {
    int32_t n = this.num * k;
    int32_t g = gcd(n, this.den);
    this.num = n / g;
    this.den = this.den / g;
  }
  void operator-=(Fraction o) mut {
    int32_t n = this.num * o.den - o.num * this.den;
    int32_t d = this.den * o.den;
    int32_t g = gcd(n, d);
    this.num = n / g;
    this.den = d / g;
  }
};

int main() {
  Fraction half = Fraction(1, 2);
  Fraction third = Fraction(1, 3);
  Fraction quarter = Fraction(1, 4);

  // 1/2 + 1/3 + 1/4 = 13/12
  Fraction sum = half + third + quarter;
  if (sum.numerator() != 13 || sum.denominator() != 12) { return 1; }

  // left-to-right chain: ((1/2 - 1/3) * 1/4) / 1/3 = 1/8
  Fraction mixed = half - third * quarter / third;
  // precedence: third * quarter / third = 1/4; 1/2 - 1/4 = 1/4
  if (mixed != quarter) { return 2; }

  // comparison applied directly to operator results
  if (!(half + quarter == quarter * 3)) { return 3; }
  if (!(third < half - quarter + quarter)) { return 4; }
  if (half * 2 - half >= half + third) { return 5; }

  // unary minus on a method result and on a named operator result
  Fraction product = half * third;
  if (product.denominator() != 6) { return 6; }
  if (-half.numerator() != -1) { return 7; }
  Fraction partial = half + third;
  Fraction negated = -partial;
  if (negated.numerator() != -5 || negated.denominator() != 6) { return 8; }

  // compound assignment in a loop; accumulate harmonic numbers H(6) = 49/20
  mut Fraction h = Fraction(0, 1);
  for (mut int32_t i = 1; i <= 6; i++) {
    h += Fraction(1, i);
  }
  if (h.numerator() != 49 || h.denominator() != 20) { return 9; }
  h *= 20;
  if (h.numerator() != 49 || h.denominator() != 1) { return 10; }
  h -= Fraction(48, 1);
  if (h != Fraction(1, 1)) { return 11; }

  std::println("{}/{} {}/{}", sum.numerator(), sum.denominator(),
               negated.numerator(), negated.denominator());
  return 0;
}
