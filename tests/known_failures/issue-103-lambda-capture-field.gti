// Reproducer for https://github.com/LukeHHA/gti/issues/103
//
// Reading a field of a captured class or struct inside a lambda raises
// GTI-B0001 from the MIR verifier: the capture place carries a field
// projection, so its type is the field's type rather than the captured
// value's, and the "capture place matches its environment field" check
// compares those two types directly.
//
// Capturing the class without projecting a field compiles, and capturing a
// scalar and reading it compiles.

class holder {
public:
  holder() {}
  mut int32_t value = 4;
};

int main() {
  mut holder h = holder();
  auto f = [h]() -> int32_t { return h.value; };
  return int(f()) - 4;
}
