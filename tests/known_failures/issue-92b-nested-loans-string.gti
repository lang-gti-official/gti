// Reproducer for https://github.com/LukeHHA/gti/issues/92 (variant: std::string).
//
// The loan-conflict ICE is not specific to std::vector: nested read-only
// range-for over the same std::string raises GTI-B0001 too.

#include <std/string>

int main() {
  mut std::string s = std::string("ab");
  mut int32_t total = 0;
  for (auto& a : s) {
    for (auto& b : s) {
      total = total + 1;
    }
  }
  return total - 4;
}
