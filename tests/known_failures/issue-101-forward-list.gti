// Reproducer for https://github.com/LukeHHA/gti/issues/101
//
// forward_list::push_front raises GTI-B0001 in its own body, though it is
// implemented (stdlib/std/forward_list.gti:63-66) and documented as a working
// operation. Constructing the empty list alone compiles.

#include <std/forward_list>

int main() {
  mut std::forward_list<int32_t> l = std::forward_list<int32_t>();
  l.push_front(1);
  return 0;
}
