// An unchecked element reference blocks growing its vector, with the raw-pointer audit on.
//@ slow
//@ check-fail
//@ raw-pointer-audit: warn
import std.vector;

int main() {
  mut std::vector<int> values = std::vector<int>({1, 2});
  unsafe {
    int& first = values.get_unchecked(std::size_t(0));  //~ WARN GTI-S2102 //~ WARN GTI-S2102
    values.push_back(3);  //~ WARN GTI-S2102 //~ ERROR GTI-S2017
    return first;
  }
}
