// A nested carrier argument cannot alias a shorter-lived source, with the raw-pointer audit on.
//@ slow
//@ check-fail
//@ raw-pointer-audit: warn
class Write {
  mut int& value;
public:
  Write(mut int& value) : value(value) {}
};
class Pair {
  Write first;
  Write second;
public:
  Pair(Write first, Write second) : first(std::move(first)), second(std::move(second)) {}
};
class Duplicate {
  Pair pair;  //~ ERROR GTI-S2045
public:
  Duplicate(mut int& value) : pair(Pair(Write(value), Write(value))) {}  //~ ERROR GTI-S2017
};
int main() {
  mut int value = 0;
  Duplicate invalid{value};
  return 0;
}
