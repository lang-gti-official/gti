// Sparse-slot, arena-prefix and SIMD-lane traversals allocate nothing and produce exact checksums.
//@ slow
//@ run-pass
// --- traversal_allocations.gti
import std.memory;
import std.simd;

extern "C" {
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
  uint64_t slot_traversal_now_ns();
  void slot_traversal_observe(uint64_t checksum);
  void slot_traversal_report(uint64_t family, uint64_t length, uint64_t elapsed,
                             uint64_t allocations, uint64_t checksum);
}

uint64_t traverse_storage(std::storage<int32_t>& values, std::size_t rounds) {
  mut uint64_t checksum = 0;
  auto end = values.end();
  auto rend = values.rend();
  for (mut std::size_t round = 0; round < rounds; round++) {
    for (mut auto cursor = values.begin(); cursor != end; ++cursor) {
      checksum += uint64_t(*cursor);
    }
    for (mut auto cursor = values.rbegin(); cursor != rend; ++cursor) {
      checksum += uint64_t(*cursor);
    }
  }
  return checksum;
}

uint64_t traverse_arena(std::arena<int32_t>& values, std::size_t rounds) {
  mut uint64_t checksum = 0;
  auto end = values.end();
  auto rend = values.rend();
  for (mut std::size_t round = 0; round < rounds; round++) {
    for (mut auto cursor = values.begin(); cursor != end; ++cursor) {
      checksum += uint64_t(*cursor);
    }
    for (mut auto cursor = values.rbegin(); cursor != rend; ++cursor) {
      checksum += uint64_t(*cursor);
    }
  }
  return checksum;
}

uint64_t traverse_lanes<uint64_t N>(std::simd<float, N>& values, std::size_t rounds) {
  mut uint64_t checksum = 0;
  auto end = values.end();
  auto rend = values.rend();
  for (mut std::size_t round = 0; round < rounds; round++) {
    for (mut auto cursor = values.begin(); cursor != end; ++cursor) {
      checksum += uint64_t(*cursor);
    }
    for (mut auto cursor = values.rbegin(); cursor != rend; ++cursor) {
      checksum += uint64_t(*cursor);
    }
  }
  return checksum;
}

int measure_storage(std::size_t capacity) {
  std::allocator allocator{};
  mut auto allocated = allocator.try_storage<int32_t>(capacity);
  if (!allocated) { return 1; }
  mut auto values = std::move(allocated).value();
  for (mut std::size_t position = 0; position < capacity; position += 4) {
    values.construct(position, int32_t(position));
  }
  [[discard]] traverse_storage(values, std::size_t(100));
  adoption_count_begin();
  uint64_t start = slot_traversal_now_ns();
  uint64_t checksum = traverse_storage(values, std::size_t(20000));
  uint64_t elapsed = slot_traversal_now_ns() - start;
  adoption_count_end();
  uint64_t allocations = adoption_allocations();
  if (allocations != uint64_t(0)) { return 2; }
  slot_traversal_observe(checksum);
  slot_traversal_report(uint64_t(1), uint64_t(capacity), elapsed, allocations, checksum);
  return 0;
}

int measure_arena(std::size_t length) {
  mut auto allocated = std::try_make_arena<int32_t>(length * 2);
  if (!allocated) { return 3; }
  mut auto values = std::move(allocated).value();
  for (mut std::size_t position = 0; position < length; position++) {
    [[discard]] values.try_insert(int32_t(position));
  }
  [[discard]] traverse_arena(values, std::size_t(100));
  adoption_count_begin();
  uint64_t start = slot_traversal_now_ns();
  uint64_t checksum = traverse_arena(values, std::size_t(20000));
  uint64_t elapsed = slot_traversal_now_ns() - start;
  adoption_count_end();
  uint64_t allocations = adoption_allocations();
  if (allocations != uint64_t(0)) { return 4; }
  slot_traversal_observe(checksum);
  slot_traversal_report(uint64_t(2), uint64_t(length), elapsed, allocations, checksum);
  return 0;
}

int measure_lanes<uint64_t N>() {
  std::simd<float, N> values{1.0};
  [[discard]] traverse_lanes(values, std::size_t(100));
  adoption_count_begin();
  uint64_t start = slot_traversal_now_ns();
  uint64_t checksum = traverse_lanes(values, std::size_t(20000));
  uint64_t elapsed = slot_traversal_now_ns() - start;
  adoption_count_end();
  uint64_t allocations = adoption_allocations();
  if (allocations != uint64_t(0)) { return 5; }
  slot_traversal_observe(checksum);
  slot_traversal_report(uint64_t(3), N, elapsed, allocations, checksum);
  return 0;
}

int main() {
  for (mut int round = 0; round < 5; round++) {
    if (round % 2 == 0) {
      if (measure_storage(std::size_t(128)) != 0 || measure_storage(std::size_t(256)) != 0) { return 6; }
      if (measure_arena(std::size_t(128)) != 0 || measure_arena(std::size_t(256)) != 0) { return 7; }
      if (measure_lanes<8>() != 0 || measure_lanes<16>() != 0) { return 8; }
    } else {
      if (measure_lanes<16>() != 0 || measure_lanes<8>() != 0) { return 9; }
      if (measure_arena(std::size_t(256)) != 0 || measure_arena(std::size_t(128)) != 0) { return 10; }
      if (measure_storage(std::size_t(256)) != 0 || measure_storage(std::size_t(128)) != 0) { return 11; }
    }
  }
  return 0;
}
// --- allocation_counts.cpp
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <new>
#if defined(_WIN32)
#include <malloc.h>
#else
#include <sys/resource.h>
#endif

namespace {
// Cleanup markers must remain visible even when exhaustion immediately aborts.
struct ConfigureAllocationProcess {
  ConfigureAllocationProcess() {
    std::setvbuf(stdout, nullptr, _IONBF, 0);
#if !defined(_WIN32)
    const rlimit limit{0, 0};
    setrlimit(RLIMIT_CORE, &limit);
#endif
  }
} configureAllocationProcess;
bool enabled = false;
std::uint64_t allocations = 0;
std::uint64_t bytes = 0;
std::uint64_t fail_at = 0;
bool audit_cleanup = false;
enum class Path { LegacyAligned, Process };
struct Region {
  void *address = nullptr;
  Path path = Path::Process;
  bool audited = false;
};
Region regions[4096]{};
std::size_t live_count = 0;

bool failed_attempt(std::size_t size) {
  if (!enabled)
    return false;
  ++allocations;
  bytes += size;
  if (fail_at == 0 || allocations != fail_at)
    return false;
  fail_at = 0; // Cleanup can itself print through allocating library code.
  return true;
}

void remember(void *address, Path path) {
  if (!address)
    return;
  for (const auto &region : regions)
    if (region.address == address)
      std::abort();
  for (auto &region : regions) {
    if (!region.address) {
      // Startup argv allocations precede the observation window. Track their
      // exact release too, without including them in scenario counts/leaks.
      region = {address, path, audit_cleanup};
      live_count += audit_cleanup ? 1 : 0;
      return;
    }
  }
  std::abort(); // Never silently lose a live allocation's identity.
}

void retire(void *address, Path path) {
  if (!address)
    return;
  for (auto &region : regions) {
    if (region.address == address) {
      if (region.path != path)
        std::abort();
      if (region.audited) {
        if (live_count == 0)
          std::abort();
        --live_count;
      }
      region = {};
      return;
    }
  }
  std::abort(); // A wrong-provider, untracked or duplicate release is a bug.
}
} // namespace

void *operator new(std::size_t size, std::align_val_t alignment,
                   const std::nothrow_t &) noexcept {
  if (failed_attempt(size))
    return nullptr;
  void *result = nullptr;
  const auto aligned = static_cast<std::size_t>(alignment);
#if defined(_WIN32)
  result = _aligned_malloc(size,
                           aligned < sizeof(void *) ? sizeof(void *) : aligned);
#else
  if (posix_memalign(&result,
                     aligned < sizeof(void *) ? sizeof(void *) : aligned,
                     size) != 0)
    return nullptr;
#endif
  remember(result, Path::LegacyAligned);
  return result;
}

void operator delete(void *pointer, std::align_val_t) noexcept {
  retire(pointer, Path::LegacyAligned);
#if defined(_WIN32)
  _aligned_free(pointer);
#else
  std::free(pointer);
#endif
}

// Inject the real source process-provider boundary, rather than observing an
// obsolete container representation's allocation implementation. These exact
// adapters avoid pulling the production adapter object from the runtime
// archive.
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return (std::numeric_limits<std::size_t>::max)();
}
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t size,
                                          std::uint64_t alignment) {
  if (failed_attempt(static_cast<std::size_t>(size)))
    return nullptr;
  void *address = _aligned_malloc(static_cast<std::size_t>(size),
                                  static_cast<std::size_t>(alignment));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  retire(address, Path::Process);
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  if (failed_attempt(static_cast<std::size_t>(bytes)))
    return nullptr;
  void *address = std::malloc(static_cast<std::size_t>(bytes));
  remember(address, Path::Process);
  return address;
}
extern "C" void *gti_rt_realloc_v1(void *address, std::uint64_t size) {
  if (failed_attempt(size))
    return nullptr;
  for (auto &region : regions) {
    if (region.address == address && region.path == Path::Process) {
      void *result = std::realloc(address, static_cast<std::size_t>(size));
      if (result)
        region.address = result;
      return result;
    }
  }
  std::abort();
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t size,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  if (failed_attempt(static_cast<std::size_t>(size))) {
    *status = ENOMEM;
    return nullptr;
  }
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(size));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) {
  retire(address, Path::Process);
  std::free(address);
}
#endif

extern "C" void adoption_count_begin() {
  allocations = 0;
  bytes = 0;
  enabled = true;
}
extern "C" void adoption_count_end() { enabled = false; }
extern "C" void adoption_trace(std::int32_t value) {
  std::printf("%d\n", static_cast<int>(value));
}
extern "C" std::uint64_t adoption_allocations() { return allocations; }
extern "C" std::uint64_t adoption_bytes() { return bytes; }
extern "C" void adoption_fail_at(std::uint64_t allocation) {
  if (live_count != 0)
    std::abort(); // Reset must never erase leaks from an earlier failure
                  // window.
  adoption_count_begin();
  fail_at = allocation;
  audit_cleanup = true;
}
// Called by the outermost GTI guard after URL and temporary cleanup. GTI's
// terminal failure deliberately does not run unmanaged C++ static destructors.
extern "C" void adoption_check_cleanup() {
  std::printf("live=%zu\n", live_count);
  audit_cleanup = false;
}
// --- cost_report.cpp
#include <cstdint>
#include <cstdio>

// The benchmark's clock and report, made deterministic: the test compares
// each sample's allocation count and checksum, not its elapsed time.
extern "C" std::uint64_t slot_traversal_now_ns() { return 0; }

extern "C" void slot_traversal_observe(std::uint64_t) {}

extern "C" void slot_traversal_report(std::uint64_t family, std::uint64_t length,
                                      std::uint64_t, std::uint64_t allocations,
                                      std::uint64_t checksum) {
  std::printf("%llu %llu %llu %llu\n", static_cast<unsigned long long>(family),
              static_cast<unsigned long long>(length),
              static_cast<unsigned long long>(allocations),
              static_cast<unsigned long long>(checksum));
}
