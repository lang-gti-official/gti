// Inline polymorphic owners avoid allocation for small payloads, box large ones once and clean up each object once.
//@ run-pass
//@ slow
//@ revisions: success exhausted division overflow zero
//@[success] stdout: empty empty
//@[success] stdout: inline replace allocations 0
//@[success] stdout: inline inline 3
//@[success] stdout: bumped inline 5
//@[success] stdout: move allocations 0
//@[success] stdout: moved inline 5
//@[success] stdout: other boxed 36
//@[success] stdout: move assign allocations 0
//@[success] stdout: assigned inline 5
//@[success] stdout: ~tracked 9
//@[success] stdout: doomed inline 1
//@[success] stdout: boxed replace allocations 1
//@[success] stdout: replaced boxed 7
//@[success] stdout: ~tracked 7
//@[success] stdout: back inline inline 11
//@[success] stdout: wide replace allocations 1
//@[success] stdout: wide boxed 8
//@[success] stdout: reset empty
//@[success] stdout: vector 24 16 528
//@[success] stdout: function small allocations 0
//@[success] stdout: function clone allocations 0
//@[success] stdout: function move allocations 0
//@[success] stdout: function calls 5 6
//@[success] stdout: function large allocations 1
//@[success] stdout: function large 10
//@[success] stdout: counter 2
//@[success] stdout: move-only owning allocations 1
//@[success] stdout: move-only 5
//@[success] stdout: transfer small allocations 0
//@[success] stdout: transfer move allocations 0
//@[success] stdout: transfer call 7
//@[success] stdout: transfer large allocations 1
//@[success] stdout: transfer wide 10
//@[success] stdout: transfer once allocations 0
//@[success] stdout: transfer consumed 42
//@[success] stdout: live 0
//@[exhausted] run-fail
//@[exhausted] exit-signal: SIGABRT
//@[exhausted] args: phase
//@[exhausted] stderr-contains: <std/detail/memory_core>:248: runtime error[GTI-R0011]: allocation_failure in unique_owner
//@[division] run-fail
//@[division] exit-code: 70
//@[division] args: phase phase
//@[division] stdout: ~tracked 5
//@[division] stderr-contains: inline_polymorphic_lifecycle.gti:70: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[overflow] run-fail
//@[overflow] exit-code: 70
//@[overflow] args: phase phase phase
//@[overflow] stdout: ~tracked 6
//@[overflow] stderr-contains: inline_polymorphic_lifecycle.gti:26: runtime error[GTI-R0001]: integer_overflow in addition
//@[zero] run-fail
//@[zero] exit-code: 70
//@[zero] args: phase phase phase phase
//@[zero] stdout: ~tracked 8
//@[zero] stderr-contains: inline_polymorphic_lifecycle.gti:235: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- inline_polymorphic_lifecycle.gti
import std.format;
import std.functional;
import std.memory;
import std.polymorphic;
import std.string;
import std.vector;

extern "C" {
void inline_polymorphic_count_begin();
uint64_t inline_polymorphic_allocations();
uint64_t inline_polymorphic_live();
void inline_polymorphic_fail_next();
}

interface meter {
  int read();
  void bump(int amount) mut;
};

// Scalar state only: an inline payload.
class gauge : public meter {
  mut int value;
public:
  gauge(int value) : value(value) {}
  int read() override { return this.value; }
  void bump(int amount) mut override { this.value = this.value + amount; }
};

// Its destructor runs source code, so it is boxed.
class tracked : public meter {
  int value;
public:
  tracked(int value) : value(value) {}
  ~tracked() { std::println(std::runtime_format("~tracked {}", this.value)); }
  int read() override { return this.value; }
  void bump(int amount) mut override {}
};

// Inert, but larger than the 32-byte slot: boxed.
class wide : public meter {
  int64_t a;
  int64_t b;
  int64_t c;
  int64_t d;
public:
  wide(int64_t seed) : a(seed), b(seed), c(seed), d(seed) {}
  int read() override { return int(this.a + this.b + this.c + this.d); }
  void bump(int amount) mut override {}
};

using slot = std::inline_polymorphic<meter, 32, 8>;

void report(std::string_view label, slot& value) {
  if (!value.has_value()) {
    std::println(std::runtime_format("{} empty", label));
    return;
  }
  std::println(std::runtime_format("{} {} {}", label, value.is_inline() ? "inline" : "boxed",
                           value.get().read()));
}

void allocations(std::string_view label, uint64_t before) {
  std::println(std::runtime_format("{} allocations {}", label, inline_polymorphic_allocations() - before));
}

uint64_t counted() {
  return inline_polymorphic_allocations();
}

int divide(int value, int by) { return value / by; }

// Retained mutable state moves with an inline callback.
struct step_counter {
  mut int value = 0;
  int operator()() mut {
    this.value += 1;
    return this.value;
  }
public:
  step_counter() = default;
};

void owners() {
  mut slot value{};
  report("empty", value);
  mut uint64_t start = counted();
  value.replace(gauge(3));
  allocations("inline replace", start);
  report("inline", value);
  value.get().bump(2);
  report("bumped", value);

  start = counted();
  slot moved = std::move(value);
  allocations("move", start);
  report("moved", moved);

  mut slot other{wide(int64_t(9))};
  report("other", other);
  start = counted();
  other = std::move(moved);
  allocations("move assign", start);
  report("assigned", other);
  {
    // Assignment destroys the replaced boxed object exactly once.
    mut slot doomed{tracked(9)};
    slot incoming{gauge(1)};
    doomed = std::move(incoming);
    report("doomed", doomed);
  }

  start = counted();
  other.replace(tracked(7));
  allocations("boxed replace", start);
  report("replaced", other);
  other.replace(gauge(11));
  report("back inline", other);
  start = counted();
  other.replace(wide(int64_t(2)));
  allocations("wide replace", start);
  report("wide", other);
  other.reset();
  report("reset", other);

  // Growth relocates every inline payload into the new buffer.
  mut std::vector<slot> many{};
  for (mut int index = 0; index < 24; index++) {
    mut slot item{};
    if (index % 3 == 0) {
      item.replace(wide(int64_t(index)));
    } else {
      item.replace(gauge(index));
    }
    many.push_back(std::move(item));
  }
  mut int total = 0;
  mut int inline_count = 0;
  for (mut std::size_t index = 0; index < many.size(); index++) {
    total = total + many[index].get().read();
    if (many[index].is_inline()) {
      inline_count++;
    }
  }
  std::println(std::runtime_format("vector {} {} {}", many.size(), inline_count, total));
}

void callbacks() {
  int offset = 4;
  mut uint64_t start = counted();
  std::function<int(int)> small{[offset](int value) -> int { return value + offset; }};
  allocations("function small", start);
  start = counted();
  auto copy = small.clone();
  allocations("function clone", start);
  start = counted();
  std::function<int(int)> moved = std::move(copy);
  allocations("function move", start);
  std::println(std::runtime_format("function calls {} {}", small(1), moved(2)));

  int64_t a = 1;
  int64_t b = 2;
  int64_t c = 3;
  int64_t d = 4;
  start = counted();
  std::function<int(int)> large{
      [a, b, c, d](int value) -> int { return value + int(a + b + c + d); }};
  allocations("function large", start);
  std::println(std::runtime_format("function large {}", large(0)));

  mut std::function<int() mut> counter{step_counter()};
  [[discard]] counter();
  mut std::function<int() mut> moved_counter = std::move(counter);
  std::println(std::runtime_format("counter {}", moved_counter()));

  auto owned = std::make_unique<int>(5);
  start = counted();
  std::move_only_function<int()> boxed{
      [owned = std::move(owned)]() -> int { return *owned; }};
  allocations("move-only owning", start);
  std::println(std::runtime_format("move-only {}", boxed()));

  // Transfer qualification changes the admitted targets, not their storage
  // cost: repeatable small jobs remain inline, wide and consuming jobs box.
  start = counted();
  std::transfer_function<int(int)> transferable{
      [offset](int value) -> int { return value + offset; }};
  allocations("transfer small", start);
  start = counted();
  auto transferred = std::move(transferable);
  allocations("transfer move", start);
  std::println(std::runtime_format("transfer call {}", transferred(3)));
  start = counted();
  std::transfer_function<int(int)> wide_transfer{
      [a, b, c, d](int value) -> int { return value + int(a + b + c + d); }};
  allocations("transfer large", start);
  std::println(std::runtime_format("transfer wide {}", wide_transfer(0)));
  start = counted();
  std::transfer_function<int(int) &&> once{
      [offset](int value) -> int { return value + offset; }};
  allocations("transfer once", start);
  std::println(std::runtime_format("transfer consumed {}", std::move(once)(38)));
}

int main(int argc, std::vector<std::string> argv) {
  inline_polymorphic_count_begin();
  if (argc == 1) {
    owners();
    callbacks();
    std::println(std::runtime_format("live {}", inline_polymorphic_live()));
    return 0;
  }
  if (argc == 2) {
    // An exhausted boxed allocation reports and aborts without cleanup.
    mut slot value{tracked(1)};
    inline_polymorphic_fail_next();
    value.replace(tracked(2));
    return 1;
  }
  if (argc == 3) {
    // A payload that fails before publication never reaches the slot.
    mut slot value{tracked(5)};
    value.replace(gauge(divide(1, argc - 3)));
    return 1;
  }
  if (argc == 4) {
    // Failure inside an inline payload's method unwinds its owners.
    slot boxed{tracked(6)};
    mut slot value{gauge(2147483647)};
    value.get().bump(1);
    return 1;
  }
  // Failure inside an inline callback destroys each owner exactly once.
  slot boxed{tracked(8)};
  int zero = argc - 5;
  std::function<int(int)> callback{[zero](int value) -> int { return value / zero; }};
  return callback(1);
}
// --- allocations.cpp
#include "process_allocation_test_provider.h"
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <new>
#ifndef _WIN32
#include <sys/resource.h>
#endif

// Counts the GTI provider on LLVM and native new on the legacy C++ backend,
// tracks live blocks, and can fail the next acquisition without real resource
// exhaustion.
namespace {
// Abort deliberately does not flush streams. Make cleanup markers observable
// before any program I/O, so an empty capture proves cleanup did not execute.
struct ConfigureFaultProcess {
  ConfigureFaultProcess() {
    std::setvbuf(stdout, nullptr, _IONBF, 0);
#ifndef _WIN32
    const rlimit limit{0, 0};
    setrlimit(RLIMIT_CORE, &limit);
#endif
  }
} configureFaultProcess;

bool counting = false;
bool failNext = false;
std::uint64_t allocations = 0;
void *live[4096]{};
std::size_t liveCount = 0;

void *track(void *result) {
  if (counting && result != nullptr) {
    ++allocations;
    if (liveCount == 4096)
      std::abort(); // A broken fixture must not silently lose rows.
    live[liveCount++] = result;
  }
  return result;
}

void forget(void *pointer) {
  for (std::size_t index = 0; index != liveCount; ++index) {
    if (live[index] == pointer) {
      live[index] = live[--liveCount];
      return;
    }
  }
}
} // namespace

void *operator new(std::size_t size, const std::nothrow_t &) noexcept {
  if (counting && failNext) {
    failNext = false;
    return nullptr;
  }
  return track(std::malloc(size == 0 ? 1 : size));
}

void *operator new(std::size_t size, std::align_val_t alignment,
                   const std::nothrow_t &) noexcept {
  if (counting && failNext) {
    failNext = false;
    return nullptr;
  }
  void *result = nullptr;
  const auto aligned = static_cast<std::size_t>(alignment);
  if (posix_memalign(&result,
                     aligned < sizeof(void *) ? sizeof(void *) : aligned,
                     size == 0 ? 1 : size) != 0)
    return nullptr;
  return track(result);
}

void operator delete(void *pointer) noexcept {
  forget(pointer);
  std::free(pointer);
}
void operator delete(void *pointer, std::size_t) noexcept {
  forget(pointer);
  std::free(pointer);
}
void operator delete(void *pointer, std::align_val_t) noexcept {
  forget(pointer);
  std::free(pointer);
}
void operator delete(void *pointer, std::size_t, std::align_val_t) noexcept {
  forget(pointer);
  std::free(pointer);
}

extern "C" void inline_polymorphic_count_begin() {
  counting = true;
  allocations = 0;
}
extern "C" std::uint64_t inline_polymorphic_allocations() {
  return allocations;
}
extern "C" std::uint64_t inline_polymorphic_live() { return liveCount; }
extern "C" void inline_polymorphic_fail_next() { failNext = true; }

namespace gti_test_process_provider {
void *acquire(std::size_t bytes, std::size_t alignment) {
  if (counting && failNext) {
    failNext = false;
    return nullptr;
  }
  return track(systemAllocate(bytes, alignment));
}
void release(void *address) {
  forget(address);
  systemRelease(address);
}
} // namespace gti_test_process_provider
// --- process_allocation_test_provider.h
#pragma once
// Complete injectable GTI process provider for native allocation oracles.
// Each companion supplies acquire/release; C++ new/delete remain independent.
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdlib>
#include <limits>
#ifdef _WIN32
#include <malloc.h>
#endif
namespace gti_test_process_provider {
void *acquire(std::size_t bytes, std::size_t alignment);
void release(void *address);
inline void *systemAllocate(std::size_t bytes, std::size_t alignment) {
#ifdef _WIN32
  return _aligned_malloc(bytes, alignment < sizeof(void *) ? sizeof(void *)
                                                           : alignment);
#else
  if (alignment <= alignof(std::max_align_t))
    return std::malloc(bytes);
  void *result = nullptr;
  return posix_memalign(&result, alignment, bytes) == 0 ? result : nullptr;
#endif
}
inline void systemRelease(void *address) {
#ifdef _WIN32
  _aligned_free(address);
#else
  std::free(address);
#endif
}
} // namespace gti_test_process_provider
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return (std::numeric_limits<std::size_t>::max)();
}
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *p,
                                                     std::uint64_t a) {
  return p && a && !(a & (a - 1)) &&
         reinterpret_cast<std::uintptr_t>(p) % a == 0;
}
#ifdef _WIN32
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t n, std::uint64_t a) {
  return gti_test_process_provider::acquire(n, a);
}
extern "C" void gti_rt_aligned_free_v1(void *p) {
  gti_test_process_provider::release(p);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t n) {
  return gti_test_process_provider::acquire(n, 1);
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t n, std::uint64_t a,
                                          std::int32_t *status) {
  void *result = gti_test_process_provider::acquire(n, a);
  *status = result ? 0 : ENOMEM;
  return result;
}
extern "C" void gti_rt_posix_free_v1(void *p) {
  gti_test_process_provider::release(p);
}
#endif
