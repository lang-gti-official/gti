// Generated prefix transport: ordinary prefix fixture does not receive compiler capability trust.
//@ check-pass
//@ stdlib-overlay: std/trusted_generated_prefix_transport.gti std/prefix_constructor_test.gti
//@ slow
// --- main.gti
import std.string;
import std.vector;
import std.trusted_generated_prefix_transport;
int main(int argc, std::vector<std::string> argv) { return trusted_case_main(argc, std::move(argv)); }
// --- std/trusted_generated_prefix_transport.gti
export module trusted_generated_prefix_transport;
import std.string;
import std.vector;
import "prefix_constructor_test.gti";

mut bool fail_cleanup = false;

struct Token {
  std::string text;
  Token() : text(std::string("resource")) {}
  ~Token() {
    std::println(89);
    int divisor = fail_cleanup ? 0 : 1;
    int checked = 1 / divisor; // token cleanup
  }
};
struct Guard {
  ~Guard() { std::println(900); }
public:
  Guard() = default;
};

export int trusted_case_main(int argc, std::vector<std::string> argv) {
  Guard caller{};
  int scenario = argc - 1;
  fail_cleanup = scenario >= 4;
  uint64_t capacity = scenario % 4 >= 2 ? uint64_t(1) : uint64_t(0);
  if (scenario % 2 == 0) {
    append_same_type<Token>(Token(), capacity);
  } else {
    append_same_type_pack<Token>(capacity, Token());
  }
  return 0;
}
// --- std/prefix_constructor_test.gti
export module prefix_constructor_test; import "../std/detail/memory_storage.gti";
// Test-only ordinary source-owner client; never shipped in the standard library.
import std.memory;
export void append_to_empty<T, Args...>(Args... args) requires std::storage_element<T> {
  mut std::detail::prefix_owner<T> storage{uint64_t(0)};
  storage.append(args...); // capacity failure
}

export void append_same_type<T>(T value, uint64_t capacity) requires std::storage_element<T> {
  mut std::detail::prefix_owner<T> storage{capacity};
  storage.append_value(std::move(value)); // direct capacity
}

export void append_same_type_pack<T, Args...>(uint64_t capacity, Args... args) requires std::storage_element<T> {
  mut std::detail::prefix_owner<T> storage{capacity};
  storage.append(args...); // pack capacity
}
