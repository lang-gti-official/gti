// An unstaged constructor field initializer (explicit initializer) keeps its literal-backed value at O3: dead-unused-computations retains it.
//@ slow
//@ run-pass
//@ opt: O3
//@ reason: the bug was the optimizer deleting the initializer's value
//@ stdout: Ada
//@ snapshot: optimization-report
// CHECK: unused computation retained: the constructor record publishes an unstaged field initializer from this value
import std.string;
struct P { std::string_view name; uint32_t health; P() : name("Ada"), health(7) {} };
int main() { P p{}; std::print(p.name); std::print("\n"); return 0; }
