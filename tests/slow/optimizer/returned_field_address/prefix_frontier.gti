// The optimizer keeps the overflow check of each returned field, borrow or result whose proof went stale (prefix frontier); the program itself runs clean.
//@ slow
//@ opt: O3
//@ reason: the optimizer must not reuse a stale pointee or result proof
//@ run-pass
//@ revisions: base bad_prefix_native bad_prefix_retarget bad_prefix_gap bad_prefix_partial bad_prefix_value bad_prefix_lifetime
//@[bad_prefix_native] args: case
//@[bad_prefix_native] run-fail
//@[bad_prefix_native] exit-code: 70
//@[bad_prefix_native] stderr-contains: prefix_frontier.gti:72: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_prefix_retarget] args: case case
//@[bad_prefix_retarget] run-fail
//@[bad_prefix_retarget] exit-code: 70
//@[bad_prefix_retarget] stderr-contains: prefix_frontier.gti:79: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_prefix_gap] args: case case case
//@[bad_prefix_gap] run-fail
//@[bad_prefix_gap] exit-code: 70
//@[bad_prefix_gap] stderr-contains: prefix_frontier.gti:92: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_prefix_partial] args: case case case case
//@[bad_prefix_partial] run-fail
//@[bad_prefix_partial] exit-code: 70
//@[bad_prefix_partial] stderr-contains: prefix_frontier.gti:105: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_prefix_value] args: case case case case case
//@[bad_prefix_value] run-fail
//@[bad_prefix_value] exit-code: 70
//@[bad_prefix_value] stderr-contains: prefix_frontier.gti:116: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_prefix_lifetime] args: case case case case case case
//@[bad_prefix_lifetime] run-fail
//@[bad_prefix_lifetime] exit-code: 70
//@[bad_prefix_lifetime] stderr-contains: prefix_frontier.gti:123: runtime error[GTI-R0001]: integer_overflow in addition
// --- prefix_frontier.gti
import std.string;
import std.vector;
import std.memory;
extern "C" {
  void* malloc(uint64_t bytes);
  void free(void* address);
  void opaque_pointer_effect(int* pointer);
}

class Sequence {
  mut int* pointer = nullptr;
  mut uint64_t live = 0;
public:
  Sequence(int* pointer) : pointer(pointer) {}
  uint64_t size() { return this.live; }
  unsafe void append(int value) mut {
    unsafe { std::construct_at(this.pointer + this.live, value); }
    this.live += uint64_t(1);
  }
  unsafe int& at(uint64_t index) {
    unsafe { return std::assume_ref(this.pointer + index, this); }
  }
  unsafe void clobber() mut {
    unsafe { opaque_pointer_effect(this.pointer); }
  }
  unsafe void retarget(int* other) mut {
    this.pointer = other;
    this.live = uint64_t(1);
  }
  unsafe void append_gap(int value) mut {
    unsafe { std::construct_at(this.pointer + this.live + uint64_t(1), value); }
    this.live += uint64_t(1);
  }
  unsafe void append_maybe(int value, bool initialize) mut {
    if (initialize) {
      unsafe { std::construct_at(this.pointer + this.live, value); }
    }
    this.live += uint64_t(1);
  }
  unsafe void replace_first() mut {
    unsafe {
      std::destroy_at(this.pointer);
      std::construct_at(this.pointer, 2147483647);
    }
  }
public:
  Sequence() = default;
};

unsafe int prefix_frontier(Sequence& sequence) {
  unsafe {
    int& value = sequence.at(uint64_t(0));
    return value + 1;
  }
}
unsafe int prefix_last(Sequence& sequence) {
  unsafe {
    int& value = sequence.at(uint64_t(4999));
    return value + 1;
  }
}
unsafe int prefix_parameter(Sequence& sequence, uint64_t index) {
  unsafe {
    int& value = sequence.at(index);
    return value + 1;
  }
}
unsafe int bad_prefix_native(mut Sequence& sequence) {
  unsafe {
    sequence.clobber();
    int& value = sequence.at(uint64_t(0));
    return value + 1;
  }
}
unsafe int bad_prefix_retarget(mut Sequence& sequence, int* other) {
  unsafe {
    sequence.retarget(other);
    int& value = sequence.at(uint64_t(0));
    return value + 1;
  }
}
unsafe int bad_prefix_gap() {
  unsafe {
    void* bytes = malloc(uint64_t(8));
    if (bytes == nullptr) return 1;
    int* pointer = std::typed_address<int>(bytes);
    std::construct_at(pointer, 2147483647);
    opaque_pointer_effect(pointer);
    mut Sequence sequence{pointer};
    sequence.append_gap(7);
    int& value = sequence.at(uint64_t(0));
    return value + 1;
  }
}
unsafe int bad_prefix_partial() {
  unsafe {
    void* bytes = malloc(uint64_t(8));
    if (bytes == nullptr) return 1;
    int* pointer = std::typed_address<int>(bytes);
    std::construct_at(pointer, 2147483647);
    opaque_pointer_effect(pointer);
    mut Sequence sequence{pointer};
    sequence.append_maybe(7, false);
    int& value = sequence.at(uint64_t(0));
    return value + 1;
  }
}
unsafe int bad_prefix_value() {
  unsafe {
    void* bytes = malloc(uint64_t(8));
    if (bytes == nullptr) return 1;
    int* pointer = std::typed_address<int>(bytes);
    mut Sequence sequence{pointer};
    sequence.append(2147483647);
    int& value = sequence.at(uint64_t(0));
    return value + 1;
  }
}
unsafe int bad_prefix_lifetime(mut Sequence& sequence) {
  unsafe {
    sequence.replace_first();
    int& value = sequence.at(uint64_t(0));
    return value + 1;
  }
}

int main(int argc, std::vector<std::string> argv) {
  unsafe {
    void* bytes = malloc(uint64_t(20000));
    if (bytes == nullptr) return 1;
    int* pointer = std::typed_address<int>(bytes);
    mut Sequence sequence{pointer};
    while (sequence.size() < uint64_t(5000)) {
      sequence.append(7);
    }
    mut int other = 2147483647;
    if (argc == 2) return bad_prefix_native(sequence);
    if (argc == 3) return bad_prefix_retarget(sequence, &other);
    if (argc == 4) return bad_prefix_gap();
    if (argc == 5) return bad_prefix_partial();
    if (argc == 6) return bad_prefix_value();
    if (argc == 7) return bad_prefix_lifetime(sequence);
    int answer = prefix_frontier(sequence);
    int last = prefix_last(sequence);
    for (mut uint64_t index = 0; index < uint64_t(5000); index++) {
      if (prefix_parameter(sequence, index) != 8) return 1;
    }
    for (mut uint64_t index = 0; index < uint64_t(5000); index++) {
      std::destroy_at(pointer + index);
    }
    free(bytes);
    return answer == 8 && last == 8 ? 0 : 1;
  }
}
// --- optimizer_returned_field_address_native.cpp
#include <cstdint>
#include <limits>

extern "C" void opaque_pointer_effect(std::int32_t *pointer) {
  *pointer = std::numeric_limits<std::int32_t>::max();
}
