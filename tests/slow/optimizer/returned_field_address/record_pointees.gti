// The optimizer keeps the overflow check of each returned field, borrow or result whose proof went stale (record pointees); the program itself runs clean.
//@ slow
//@ opt: O3
//@ reason: the optimizer must not reuse a stale pointee or result proof
//@ run-pass
//@ revisions: base bad_record_broad bad_record_native bad_record_field_borrow bad_record_lifetime bad_record_argument bad_record_other
//@[bad_record_broad] args: case
//@[bad_record_broad] run-fail
//@[bad_record_broad] exit-code: 70
//@[bad_record_broad] stderr-contains: record_pointees.gti:56: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_record_native] args: case case
//@[bad_record_native] run-fail
//@[bad_record_native] exit-code: 70
//@[bad_record_native] stderr-contains: record_pointees.gti:65: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_record_field_borrow] args: case case case
//@[bad_record_field_borrow] run-fail
//@[bad_record_field_borrow] exit-code: 70
//@[bad_record_field_borrow] stderr-contains: record_pointees.gti:75: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_record_lifetime] args: case case case case
//@[bad_record_lifetime] run-fail
//@[bad_record_lifetime] exit-code: 70
//@[bad_record_lifetime] stderr-contains: record_pointees.gti:87: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_record_argument] args: case case case case case
//@[bad_record_argument] run-fail
//@[bad_record_argument] exit-code: 70
//@[bad_record_argument] stderr-contains: record_pointees.gti:98: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_record_other] args: case case case case case case
//@[bad_record_other] run-fail
//@[bad_record_other] exit-code: 70
//@[bad_record_other] stderr-contains: record_pointees.gti:106: runtime error[GTI-R0001]: integer_overflow in addition
// --- record_pointees.gti
import std.string;
import std.vector;
import std.memory;
extern "C" { void opaque_pointer_effect(int* pointer); }

struct Reading {
  mut int broad;
  mut int narrow;
  Reading() : broad(2147483647), narrow(7) {}
};
class Witness { public: int unrelated = 2147483647;  public: Witness() = default; };

unsafe void publish_record(Reading* pointer) {
  Reading value{};
  unsafe { std::construct_at(pointer, std::move(value)); }
}

unsafe void publish_second(Reading* pointer, Reading first, Reading second) {
  unsafe { std::construct_at(pointer, std::move(second)); }
}

unsafe int read_narrow(Reading* pointer, Witness& owner) {
  unsafe {
    publish_record(pointer);
    Reading& value = std::assume_ref(pointer, owner);
    return value.narrow + 1;
  }
}

unsafe int read_second_argument(Reading* pointer, Witness& owner) {
  mut Reading first{};
  first.narrow = 2147483647;
  Reading second{};
  unsafe {
    publish_second(pointer, first, second);
    Reading& value = std::assume_ref(pointer, owner);
    return value.narrow + 1;
  }
}

unsafe int read_field_borrow(Reading* pointer, mut Witness& owner) {
  unsafe {
    publish_record(pointer);
    mut Reading& record = std::assume_mut(pointer, owner);
    record.broad = 99;
    int& narrow = record.narrow;
    return narrow + 1;
  }
}

unsafe int bad_record_broad(Reading* pointer, mut Witness& owner) {
  unsafe {
    publish_record(pointer);
    mut Reading& value = std::assume_mut(pointer, owner);
    value.narrow = value.broad;
    return value.narrow + 1;
  }
}

unsafe int bad_record_native(Reading* pointer, mut Witness& owner) {
  unsafe {
    publish_record(pointer);
    mut Reading& value = std::assume_mut(pointer, owner);
    opaque_pointer_effect(&value.narrow);
    return value.narrow + 1;
  }
}

unsafe int bad_record_field_borrow(Reading* pointer, mut Witness& owner) {
  unsafe {
    publish_record(pointer);
    mut Reading& value = std::assume_mut(pointer, owner);
    mut int& narrow = value.narrow;
    narrow = 2147483647;
    return value.narrow + 1;
  }
}

unsafe int bad_record_lifetime(Reading* pointer, Witness& owner) {
  unsafe {
    publish_record(pointer);
    std::destroy_at(pointer);
    mut Reading other{};
    other.narrow = 2147483647;
    std::construct_at(pointer, std::move(other));
    Reading& value = std::assume_ref(pointer, owner);
    return value.narrow + 1;
  }
}

unsafe int bad_record_argument(Reading* pointer, Witness& owner) {
  Reading first{};
  mut Reading second{};
  second.narrow = 2147483647;
  unsafe {
    publish_second(pointer, first, second);
    Reading& value = std::assume_ref(pointer, owner);
    return value.narrow + 1;
  }
}

unsafe int bad_record_other(Reading* pointer, Reading* other, Witness& owner) {
  unsafe {
    publish_record(pointer);
    Reading& value = std::assume_ref(other, owner);
    return value.narrow + 1;
  }
}

int main(int argc, std::vector<std::string> argv) {
  mut Witness owner{};
  mut std::uninitialized<Reading> storage{};
  mut std::uninitialized<Reading> packed{};
  mut std::uninitialized<Reading> borrowed{};
  mut Reading other{};
  other.narrow = 2147483647;
  unsafe {
    if (argc == 2) return bad_record_broad(storage.data(), owner);
    if (argc == 3) return bad_record_native(storage.data(), owner);
    if (argc == 4) return bad_record_field_borrow(storage.data(), owner);
    if (argc == 5) return bad_record_lifetime(storage.data(), owner);
    if (argc == 6) return bad_record_argument(storage.data(), owner);
    if (argc == 7) return bad_record_other(storage.data(), &other, owner);
    int answer = read_narrow(storage.data(), owner);
    int selected = read_second_argument(packed.data(), owner);
    int projected = read_field_borrow(borrowed.data(), owner);
    std::destroy_at(storage.data());
    std::destroy_at(packed.data());
    std::destroy_at(borrowed.data());
    return answer == 8 && selected == 8 && projected == 8 ? 0 : 1;
  }
}
// --- optimizer_returned_field_address_native.cpp
#include <cstdint>
#include <limits>

extern "C" void opaque_pointer_effect(std::int32_t *pointer) {
  *pointer = std::numeric_limits<std::int32_t>::max();
}
