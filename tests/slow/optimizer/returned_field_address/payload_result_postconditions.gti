// The optimizer keeps the overflow check of each returned field, borrow or result whose proof went stale (payload result postconditions); the program itself runs clean.
//@ slow
//@ opt: O3
//@ reason: the optimizer must not reuse a stale pointee or result proof
//@ run-pass
//@ revisions: base bad_failed_gate bad_reassigned_gate bad_later_gate bad_native_gate bad_mixed_gate bad_switched_gate bad_active_gate
//@[bad_failed_gate] args: case
//@[bad_failed_gate] run-fail
//@[bad_failed_gate] exit-code: 70
//@[bad_failed_gate] stderr-contains: payload_result_postconditions.gti:122: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_reassigned_gate] args: case case
//@[bad_reassigned_gate] run-fail
//@[bad_reassigned_gate] exit-code: 70
//@[bad_reassigned_gate] stderr-contains: payload_result_postconditions.gti:129: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_later_gate] args: case case case
//@[bad_later_gate] run-fail
//@[bad_later_gate] exit-code: 70
//@[bad_later_gate] stderr-contains: payload_result_postconditions.gti:136: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_native_gate] args: case case case case
//@[bad_native_gate] run-fail
//@[bad_native_gate] exit-code: 70
//@[bad_native_gate] stderr-contains: payload_result_postconditions.gti:143: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_mixed_gate] args: case case case case case
//@[bad_mixed_gate] run-fail
//@[bad_mixed_gate] exit-code: 70
//@[bad_mixed_gate] stderr-contains: payload_result_postconditions.gti:149: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_switched_gate] args: case case case case case case
//@[bad_switched_gate] run-fail
//@[bad_switched_gate] exit-code: 70
//@[bad_switched_gate] stderr-contains: payload_result_postconditions.gti:156: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_active_gate] args: case case case case case case case
//@[bad_active_gate] run-fail
//@[bad_active_gate] exit-code: 70
//@[bad_active_gate] stderr-contains: payload_result_postconditions.gti:165: runtime error[GTI-R0001]: integer_overflow in addition
// --- payload_result_postconditions.gti
import std.string;
import std.vector;
extern "C" { void opaque_pointer_effect(int* pointer); }

// A user-defined result class and payload enum, unrelated to any library
// type: per-alternative postconditions must cross the calls that build the
// result and the boolean tag tests that observe it.
enum gate_state { open(int32_t level), shut(int32_t reason) };

class Refusal {
public:
  int32_t reason = 0;
  Refusal(int32_t reason) : reason(reason) {}
public:
  Refusal() = default;
};

class Gate {
  mut gate_state state;
public:
  Gate(int32_t level) : state(gate_state::open(level)) {}
  Gate(Refusal refusal) : state(gate_state::shut(refusal.reason)) {}
  bool passed() {
    switch (this.state) {
    case gate_state::open: return true;
    case gate_state::shut: return false;
    }
  }
  bool refused() { return !this.passed(); }
};

// A payload with a source destructor keeps its result's cleanup active.
class Noisy {
  mut int* target = nullptr;
public:
  Noisy(mut int* target) : target(target) {}
  ~Noisy() { unsafe { opaque_pointer_effect(this.target); } }
public:
  Noisy() = default;
};

enum noisy_state { held(Noisy value), empty(int32_t code) };

class NoisyGate {
  mut noisy_state state;
public:
  NoisyGate(Noisy value) : state(noisy_state::held(std::move(value))) {}
  bool passed() {
    switch (this.state) {
    case noisy_state::held: return true;
    case noisy_state::empty: return false;
    }
  }
};

class Ticket {
public:
  mut int count = 0;
  NoisyGate noisy() mut {
    this.count = 7;
    return NoisyGate(Noisy(&this.count));
  }
  Gate publish(bool accepted) mut {
    if (!accepted) {
      this.count = 2147483647;
      return Gate(Refusal(1));
    }
    this.count = 7;
    return Gate(3);
  }
public:
  Ticket() = default;
};

Gate relay(mut Ticket& ticket, bool accepted) {
  return ticket.publish(accepted);
}

// One exit returns a gate whose alternative this body cannot know, so it
// contributes its postcondition to every alternative.
Gate mixed(mut Ticket& ticket, bool accepted, Gate fallback) {
  if (accepted) {
    ticket.count = 7;
    return Gate(3);
  }
  ticket.count = 2147483647;
  return fallback;
}

gate_state classify(mut Ticket& ticket, bool accepted) {
  if (accepted) {
    ticket.count = 7;
    return gate_state::open(1);
  }
  ticket.count = 2147483647;
  return gate_state::shut(2);
}

int accepted_gate(mut Ticket& ticket) {
  auto gate = relay(ticket, true);
  if (!gate.passed()) return 0;
  return ticket.count + 1;
}

int refused_gate(mut Ticket& ticket) {
  auto gate = ticket.publish(true);
  if (gate.refused()) return 0;
  return ticket.count + 1;
}

int switched_gate(mut Ticket& ticket) {
  auto state = classify(ticket, true);
  switch (state) {
  case gate_state::open: return ticket.count + 1;
  case gate_state::shut: return 0;
  }
}

int bad_failed_gate(mut Ticket& ticket) {
  auto gate = relay(ticket, false);
  if (gate.passed()) return 0;
  return ticket.count + 1;
}

int bad_reassigned_gate(mut Ticket& ticket) {
  auto gate = relay(ticket, true);
  ticket.count = 2147483647;
  if (!gate.passed()) return 0;
  return ticket.count + 1;
}

int bad_later_gate(mut Ticket& ticket) {
  auto first = relay(ticket, true);
  auto second = relay(ticket, false);
  if (!first.passed()) return 0;
  return ticket.count + 1;
}

int bad_native_gate(mut Ticket& ticket) {
  auto gate = relay(ticket, true);
  unsafe { opaque_pointer_effect(&ticket.count); }
  if (!gate.passed()) return 0;
  return ticket.count + 1;
}

int bad_mixed_gate(mut Ticket& ticket) {
  auto gate = mixed(ticket, false, Gate(3));
  if (!gate.passed()) return 0;
  return ticket.count + 1;
}

int bad_switched_gate(mut Ticket& ticket) {
  auto state = classify(ticket, false);
  switch (state) {
  case gate_state::open: return 0;
  case gate_state::shut: return ticket.count + 1;
  }
}

int bad_active_gate(mut Ticket& ticket) {
  {
    auto gate = ticket.noisy();
    if (!gate.passed()) return 0;
  }
  return ticket.count + 1;
}

int main(int argc, std::vector<std::string> argv) {
  mut Ticket ticket{};
  if (argc == 2) return bad_failed_gate(ticket);
  if (argc == 3) return bad_reassigned_gate(ticket);
  if (argc == 4) return bad_later_gate(ticket);
  if (argc == 5) return bad_native_gate(ticket);
  if (argc == 6) return bad_mixed_gate(ticket);
  if (argc == 7) return bad_switched_gate(ticket);
  if (argc == 8) return bad_active_gate(ticket);
  return accepted_gate(ticket) == 8 && refused_gate(ticket) == 8 &&
                 switched_gate(ticket) == 8
             ? 0
             : 1;
}
// --- optimizer_returned_field_address_native.cpp
#include <cstdint>
#include <limits>

extern "C" void opaque_pointer_effect(std::int32_t *pointer) {
  *pointer = std::numeric_limits<std::int32_t>::max();
}
