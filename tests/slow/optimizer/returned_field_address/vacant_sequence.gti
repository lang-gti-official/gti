// The optimizer keeps the overflow check of each returned field, borrow or result whose proof went stale (vacant sequence); the program itself runs clean.
//@ slow
//@ opt: O3
//@ reason: the optimizer must not reuse a stale pointee or result proof
//@ run-pass
//@ revisions: base bad_vacant_replaced bad_vacant_native bad_vacant_lifetime
//@[bad_vacant_replaced] args: case
//@[bad_vacant_replaced] run-fail
//@[bad_vacant_replaced] exit-code: 70
//@[bad_vacant_replaced] stderr-contains: vacant_sequence.gti:51: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_vacant_native] args: case case
//@[bad_vacant_native] run-fail
//@[bad_vacant_native] exit-code: 70
//@[bad_vacant_native] stderr-contains: vacant_sequence.gti:60: runtime error[GTI-R0001]: integer_overflow in addition
//@[bad_vacant_lifetime] args: case case case
//@[bad_vacant_lifetime] run-fail
//@[bad_vacant_lifetime] exit-code: 70
//@[bad_vacant_lifetime] stderr-contains: vacant_sequence.gti:69: runtime error[GTI-R0001]: integer_overflow in addition
// --- vacant_sequence.gti
import std.string;
import std.vector;
import std.memory;
extern "C" { void opaque_pointer_effect(int* pointer); }

class Publication {
  mut uint64_t count = 0;
public:
  unsafe void append(int* pointer, int value) mut {
    unsafe { std::construct_at(pointer, std::move(value)); }
    this.count = uint64_t(1);
  }
  unsafe void replace(int* pointer, int* next) mut {
    unsafe {
      this.append(next, 9);
      mut int& value = std::assume_mut(pointer, this);
      value = 2147483647;
    }
  }
  unsafe void native(int* pointer, int* next) mut {
    unsafe {
      this.append(next, 9);
      opaque_pointer_effect(pointer);
    }
  }
  unsafe void reconstruct(int* pointer, int* next) mut {
    unsafe {
      this.append(next, 9);
      std::destroy_at(pointer);
      std::construct_at(pointer, 2147483647);
    }
  }
public:
  Publication() = default;
};

unsafe int consecutive_vacant(int* pointer, int* next) {
  mut Publication writer{};
  unsafe {
    writer.append(pointer, 7);
    writer.append(next, 9);
    return *pointer + 1;
  }
}

unsafe int bad_vacant_replaced(int* pointer, int* next) {
  mut Publication writer{};
  unsafe {
    writer.append(pointer, 7);
    writer.replace(pointer, next);
    return *pointer + 1;
  }
}

unsafe int bad_vacant_native(int* pointer, int* next) {
  mut Publication writer{};
  unsafe {
    writer.append(pointer, 7);
    writer.native(pointer, next);
    return *pointer + 1;
  }
}

unsafe int bad_vacant_lifetime(int* pointer, int* next) {
  mut Publication writer{};
  unsafe {
    writer.append(pointer, 7);
    writer.reconstruct(pointer, next);
    return *pointer + 1;
  }
}

int main(int argc, std::vector<std::string> argv) {
  mut std::uninitialized<int> first{};
  mut std::uninitialized<int> second{};
  unsafe {
    if (argc == 2) return bad_vacant_replaced(first.data(), second.data());
    if (argc == 3) return bad_vacant_native(first.data(), second.data());
    if (argc == 4) return bad_vacant_lifetime(first.data(), second.data());
    return consecutive_vacant(first.data(), second.data()) == 8 ? 0 : 1;
  }
}
// --- optimizer_returned_field_address_native.cpp
#include <cstdint>
#include <limits>

extern "C" void opaque_pointer_effect(std::int32_t *pointer) {
  *pointer = std::numeric_limits<std::int32_t>::max();
}
