// Annotated test suites: `gti test` discovers [[test]] functions (also
// through imported and private module units, never from dependency
// packages), runs each isolated with cleanup, reports panics and signals,
// keeps the test catalog in the build cache (and repairs a poisoned entry),
// keeps dispatcher names hygienic, rejects a suite with its own main or no
// tests, and still runs a legacy main. (From annotated_test_suite_test.py;
// the debug-symbol cache restoration it checked on macOS and the O3 run are
// dropped. Invalid [[test]] declarations are tests/ui/declarations/annotated_tests.)
slow
$ cd project
$ gti test --no-cache
stderr: Test result: 3 passed
stderr: engine::tests::another_fresh_scene_state ... passed
stderr: engine::tests::event_value_is_preserved ... passed
stderr: engine::tests::fresh_scene_state ... passed
$ gti test --verbose
$ gti test --verbose
stderr: cache hit
stderr: Test result: 3 passed
$ sh -c "f=$(find build/gti/cache -name metadata | head -1); sed 's/case engine::tests::fresh_scene_state/case engine::tests::wrong_name/' $f > $f.new && mv $f.new $f"
$ gti test --verbose
stderr: Test result: 3 passed
!stderr: wrong_name ...
$ sh -c "grep -c 'case engine::tests::fresh_scene_state' $(find build/gti/cache -name metadata | head -1)"
stdout: 1
$ cp ../variants/isolation.gti tests/main.gti
$ gti test --no-cache
? 70
