// Ordered queries over standard containers allocate nothing (native allocation counter).
//@ run-pass
//@ slow
// --- ordered_search_cost.gti
import std.algorithm;
import std.iterator;
import std.vector;

extern "C" {
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
}

mut std::size_t calls = 0;
mut std::size_t increments = 0;
mut std::size_t jumps = 0;

class CostEnd {
  std::size_t length;
public:
  CostEnd(std::size_t length) : length(length) {}
  std::size_t position() { return this.length; }
};
// A second end over the same positions with no distance operator: a jumping
// cursor must still count its way to it.
class UnsizedEnd {
  std::size_t length;
public:
  UnsizedEnd(std::size_t length) : length(length) {}
  std::size_t position() { return this.length; }
};
// The step-only cursor has neither jumps nor a sized sentinel.
class CostCursor {
  CostSeries& owner;
  mut std::size_t index;
public:
  CostCursor(CostSeries& owner, std::size_t index) : owner(owner), index(index) {}
  int& operator*() { return this.owner.at(this.index); }
  void operator++() mut { this.index++; increments++; }
  bool operator!=(CostEnd& end) { return this.index != end.position(); }
  bool operator!=(CostCursor& other) { return this.index != other.index; }
};
// An unrelated cursor that declares the jump contract and a sized sentinel.
// Nothing about it names a standard container.
class JumpCostCursor {
  CostSeries& owner;
  mut std::size_t index;
public:
  JumpCostCursor(CostSeries& owner, std::size_t index) : owner(owner), index(index) {}
  int& operator*() { return this.owner.at(this.index); }
  void operator++() mut { this.index++; increments++; }
  void operator+=(std::ptrdiff_t offset) mut {
    this.index = std::size_t(std::ptrdiff_t(this.index) + offset);
    jumps++;
  }
  void operator-=(std::ptrdiff_t offset) mut {
    this.index = std::size_t(std::ptrdiff_t(this.index) - offset);
    jumps++;
  }
  bool operator!=(CostEnd& end) { return this.index != end.position(); }
  bool operator!=(UnsizedEnd& end) { return this.index != end.position(); }
  bool operator!=(JumpCostCursor& other) { return this.index != other.index; }
  std::ptrdiff_t operator-(CostEnd& end) {
    return std::ptrdiff_t(this.index) - std::ptrdiff_t(end.position());
  }
  std::size_t position() { return this.index; }
};
class CostSeries {
  mut std::vector<int> elements{};
public:
  CostSeries(std::size_t length) {
    this.elements.reserve(length);
    for (mut std::size_t index = 0; index < length; index++) {
      this.elements.push_back(int(index / 2));
    }
  }
  int& at(std::size_t index) { return this.elements[index]; }
  CostCursor begin() { return CostCursor(this, std::size_t(0)); }
  CostEnd end() { return CostEnd(this.elements.size()); }
  JumpCostCursor jump_begin() { return JumpCostCursor(this, std::size_t(0)); }
  UnsizedEnd unsized_end() { return UnsizedEnd(this.elements.size()); }
public:
  CostSeries() = default;
};
class CostOrder {
public:
  bool operator()(int& left, int& right) { calls++; return left < right; }
public:
  CostOrder() = default;
};
class CostPredicate {
  int threshold;
public:
  CostPredicate(int threshold) : threshold(threshold) {}
  bool operator()(int& value) { calls++; return value < this.threshold; }
};

void reset_cost() {
  calls = 0;
  increments = 0;
  jumps = 0;
  unsafe { adoption_count_begin(); }  //~ WARN GTI-S2100
}
bool check_cost(std::size_t length, std::size_t maximum_calls) {
  unsafe {  //~ WARN GTI-S2100
    adoption_count_end();
    if (adoption_allocations() != uint64_t(0)) { return false; }
  }
  // Counted forward search uses at most three traversals and logarithmically
  // many callback invocations. Counters observe the real source operations.
  return calls <= maximum_calls && increments <= std::size_t(3) * length;
}
// A jumping cursor measures a sized range with one subtraction and an unsized
// one with exactly one counting pass; each narrowing level then makes at most
// two checked jumps and no increments.
bool check_jumps(std::size_t levels, std::size_t maximum_calls, std::size_t counted) {
  unsafe {  //~ WARN GTI-S2100
    adoption_count_end();
    if (adoption_allocations() != uint64_t(0)) { return false; }
  }
  return calls <= maximum_calls && increments == counted &&
         jumps <= std::size_t(2) * levels;
}

int exercise_jumps(std::size_t length, int key, std::size_t levels,
                   std::size_t expected_lower, std::size_t expected_upper) {
  CostSeries values{length};
  CostEnd end = values.end();
  UnsizedEnd unsized = values.unsized_end();
  bool expected_found = expected_lower != expected_upper;
  std::size_t none = 0;

  reset_cost();
  auto lower = std::lower_bound(values.jump_begin(), end, key, CostOrder());
  if (!check_jumps(levels, levels, none) || lower.position() != expected_lower) { return 1; }
  reset_cost();
  auto upper = std::upper_bound(values.jump_begin(), end, key, CostOrder());
  if (!check_jumps(levels, levels, none) || upper.position() != expected_upper) { return 2; }
  reset_cost();
  auto partition = std::partition_point(values.jump_begin(), end, CostPredicate(key));
  if (!check_jumps(levels, levels, none) || partition.position() != expected_lower) { return 3; }
  reset_cost();
  bool found = std::binary_search(values.jump_begin(), end, key, CostOrder());
  if (!check_jumps(levels, levels + 1, none) || found != expected_found) { return 4; }

  // The element-order overloads move the same way.
  reset_cost();
  auto natural_lower = std::lower_bound(values.jump_begin(), end, key);
  if (!check_jumps(levels, none, none) || natural_lower.position() != expected_lower) { return 5; }
  reset_cost();
  auto natural_upper = std::upper_bound(values.jump_begin(), end, key);
  if (!check_jumps(levels, none, none) || natural_upper.position() != expected_upper) { return 6; }
  reset_cost();
  bool natural_found = std::binary_search(values.jump_begin(), end, key);
  if (!check_jumps(levels, none, none) || natural_found != expected_found) { return 7; }

  // Without a sized sentinel the range is counted once, then narrowed by jumps.
  reset_cost();
  auto unsized_lower = std::lower_bound(values.jump_begin(), unsized, key, CostOrder());
  if (!check_jumps(levels, levels, length) || unsized_lower.position() != expected_lower) {
    return 8;
  }
  reset_cost();
  bool unsized_found = std::binary_search(values.jump_begin(), unsized, key);
  if (!check_jumps(levels, none, length) || unsized_found != expected_found) { return 9; }
  return 0;
}

int exercise(std::size_t length, int key) {
  CostSeries values{length};
  CostEnd end = values.end();
  mut std::size_t levels = 0;
  for (mut std::size_t size = length; size > 0; size /= 2) { levels++; }
  mut std::size_t expected_lower = 0;
  mut std::size_t expected_upper = 0;
  for (mut std::size_t index = 0; index < length; index++) {
    if (int(index / 2) < key) { expected_lower++; }
    if (int(index / 2) <= key) { expected_upper++; }
  }
  reset_cost();
  auto lower = std::lower_bound(values.begin(), end, key, CostOrder());
  if (!check_cost(length, levels)) { return 1; }
  if (std::size_t(std::distance(values.begin(), lower)) != expected_lower) { return 2; }

  reset_cost();
  auto upper = std::upper_bound(values.begin(), end, key, CostOrder());
  if (!check_cost(length, levels)) { return 3; }
  if (std::size_t(std::distance(values.begin(), upper)) != expected_upper) { return 4; }

  reset_cost();
  auto partition = std::partition_point(values.begin(), end, CostPredicate(key));
  if (!check_cost(length, levels)) { return 5; }
  if (std::size_t(std::distance(values.begin(), partition)) != expected_lower) { return 6; }

  reset_cost();
  bool found = std::binary_search(values.begin(), end, key, CostOrder());
  if (!check_cost(length, levels + 1)) { return 7; }
  if (found != (expected_lower != expected_upper)) { return 8; }
  if (exercise_jumps(length, key, levels, expected_lower, expected_upper) != 0) { return 11; }

  reset_cost();
  auto greatest = std::max_element(values.begin(), end, CostOrder());
  if (!check_cost(length, length - 1) || calls != length - 1 ||
      increments > std::size_t(2) * length) { return 9; }
  if (*greatest != int((length - 1) / 2)) { return 10; }
  return 0;
}

int main() {
  for (mut std::size_t length = 16; length <= 128; length *= 2) {
    if (exercise(length, -1) != 0) { return 1; }
    if (exercise(length, int(length / 4)) != 0) { return 2; }
    if (exercise(length, int(length / 2)) != 0) { return 3; }
  }
  return 0;
}
// --- allocation_counts.cpp
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <new>
#if defined(_WIN32)
#include <malloc.h>
#else
#include <sys/resource.h>
#endif

namespace {
// Cleanup markers must remain visible even when exhaustion immediately aborts.
struct ConfigureAllocationProcess {
  ConfigureAllocationProcess() {
    std::setvbuf(stdout, nullptr, _IONBF, 0);
#if !defined(_WIN32)
    const rlimit limit{0, 0};
    setrlimit(RLIMIT_CORE, &limit);
#endif
  }
} configureAllocationProcess;
bool enabled = false;
std::uint64_t allocations = 0;
std::uint64_t bytes = 0;
std::uint64_t fail_at = 0;
bool audit_cleanup = false;
enum class Path { LegacyAligned, Process };
struct Region {
  void *address = nullptr;
  Path path = Path::Process;
  bool audited = false;
};
Region regions[4096]{};
std::size_t live_count = 0;

bool failed_attempt(std::size_t size) {
  if (!enabled)
    return false;
  ++allocations;
  bytes += size;
  if (fail_at == 0 || allocations != fail_at)
    return false;
  fail_at = 0; // Cleanup can itself print through allocating library code.
  return true;
}

void remember(void *address, Path path) {
  if (!address)
    return;
  for (const auto &region : regions)
    if (region.address == address)
      std::abort();
  for (auto &region : regions) {
    if (!region.address) {
      // Startup argv allocations precede the observation window. Track their
      // exact release too, without including them in scenario counts/leaks.
      region = {address, path, audit_cleanup};
      live_count += audit_cleanup ? 1 : 0;
      return;
    }
  }
  std::abort(); // Never silently lose a live allocation's identity.
}

void retire(void *address, Path path) {
  if (!address)
    return;
  for (auto &region : regions) {
    if (region.address == address) {
      if (region.path != path)
        std::abort();
      if (region.audited) {
        if (live_count == 0)
          std::abort();
        --live_count;
      }
      region = {};
      return;
    }
  }
  std::abort(); // A wrong-provider, untracked or duplicate release is a bug.
}
} // namespace

void *operator new(std::size_t size, std::align_val_t alignment,
                   const std::nothrow_t &) noexcept {
  if (failed_attempt(size))
    return nullptr;
  void *result = nullptr;
  const auto aligned = static_cast<std::size_t>(alignment);
#if defined(_WIN32)
  result = _aligned_malloc(size,
                           aligned < sizeof(void *) ? sizeof(void *) : aligned);
#else
  if (posix_memalign(&result,
                     aligned < sizeof(void *) ? sizeof(void *) : aligned,
                     size) != 0)
    return nullptr;
#endif
  remember(result, Path::LegacyAligned);
  return result;
}

void operator delete(void *pointer, std::align_val_t) noexcept {
  retire(pointer, Path::LegacyAligned);
#if defined(_WIN32)
  _aligned_free(pointer);
#else
  std::free(pointer);
#endif
}

// Inject the real source process-provider boundary, rather than observing an
// obsolete container representation's allocation implementation. These exact
// adapters avoid pulling the production adapter object from the runtime
// archive.
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return (std::numeric_limits<std::size_t>::max)();
}
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t size,
                                          std::uint64_t alignment) {
  if (failed_attempt(static_cast<std::size_t>(size)))
    return nullptr;
  void *address = _aligned_malloc(static_cast<std::size_t>(size),
                                  static_cast<std::size_t>(alignment));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  retire(address, Path::Process);
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  if (failed_attempt(static_cast<std::size_t>(bytes)))
    return nullptr;
  void *address = std::malloc(static_cast<std::size_t>(bytes));
  remember(address, Path::Process);
  return address;
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t size,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  if (failed_attempt(static_cast<std::size_t>(size))) {
    *status = ENOMEM;
    return nullptr;
  }
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(size));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) {
  retire(address, Path::Process);
  std::free(address);
}
#endif

extern "C" void adoption_count_begin() {
  allocations = 0;
  bytes = 0;
  enabled = true;
}
extern "C" void adoption_count_end() { enabled = false; }
extern "C" void adoption_trace(std::int32_t value) {
  std::printf("%d\n", static_cast<int>(value));
}
extern "C" std::uint64_t adoption_allocations() { return allocations; }
extern "C" std::uint64_t adoption_bytes() { return bytes; }
extern "C" void adoption_fail_at(std::uint64_t allocation) {
  if (live_count != 0)
    std::abort(); // Reset must never erase leaks from an earlier failure
                  // window.
  adoption_count_begin();
  fail_at = allocation;
  audit_cleanup = true;
}
// Called by the outermost GTI guard after URL and temporary cleanup. GTI's
// terminal failure deliberately does not run unmanaged C++ static destructors.
extern "C" void adoption_check_cleanup() {
  std::printf("live=%zu\n", live_count);
  audit_cleanup = false;
}
