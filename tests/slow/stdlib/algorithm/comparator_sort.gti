// std::sort with user comparators sorts every shape within its comparison bound.
//@ slow
//@ run-pass
//@ stdout: 127
//@ stdout: 255
//@ stdout: 511
//@ stdout: 1023
// --- comparator_sort.gti
import std.algorithm;
import std.panic;
import std.string;
import std.vector;

mut uint64_t comparisons = 0;
mut int comparator_drops = 0;

extern "C" {
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
}

class Ordering {
  std::string label;
  bool descending;
  mut uint64_t calls = uint64_t(0);
public:
  Ordering(bool descending) : label(std::string("owning comparator")), descending(descending) {}
  Ordering(Ordering& other) = delete;
  Ordering(Ordering&& other) = default;
  ~Ordering() {
    if (this.calls != comparisons) { std::panic("comparator state was not retained"); }
    comparator_drops++;
  }
  bool operator()(int& left, int& right) mut {
    this.calls++;
    comparisons++;
    return this.descending ? left > right : left < right;
  }
};

int exercise(int count, int shape, bool descending) {
  mut std::vector<int> values{};
  mut std::vector<int> frequencies{};
  values.reserve(std::size_t(count));
  frequencies.resize(std::size_t(count));
  for (mut int i = 0; i < count; i++) {
    mut int value = i;
    if (shape == 0) { value = count - i - 1; }
    if (shape == 2) { value = 0; }
    if (shape == 3) { value = i <= count / 2 ? i : count - i; }
    if (shape == 4) { value = i % 2 == 0 && i + 1 < count ? i + 1 : i - 1; }
    if (shape == 5) { value = (i * 137 + 43) % count; }
    if (shape == 6) { value = i < count / 2 ? count / 2 : count - i - 1; }
    if (shape == 7 && i == count - 1) { value = 0; }
    if (shape == 8) { value = i / 4; }
    if (shape == 9 && i == count - 2) { value = count - 1; }
    if (shape == 9 && i == count - 1) { value = count - 2; }
    if (shape == 10) { value = (count - i - 1) / 4; }
    if (shape == 11) { value = i == 0 ? count - 1 : (i == 1 ? 0 : count / 2); }
    if (shape == 12) { value = i % 32 == 0 || i % 32 == 31 ? count - 1 : 0; }
    values.push_back(value);
    frequencies[std::size_t(value)]++;
  }
  comparisons = uint64_t(0);
  int drops_before = comparator_drops;
  Ordering ordering{descending};
  unsafe { adoption_count_begin(); }  //~ WARN GTI-S2100
  std::sort(values, std::move(ordering));
  mut uint64_t allocations = uint64_t(0);
  unsafe {  //~ WARN GTI-S2100
    adoption_count_end();
    allocations = adoption_allocations();
  }
  if (allocations != uint64_t(0)) { return 6; }
  if (comparator_drops != drops_before + 1) { return 1; }
  for (mut std::size_t i = std::size_t(0); i < values.size(); i++) {
    int current = values[i];
    if (current < 0 || current >= count) { return 2; }
    frequencies[std::size_t(current)]--;
    if (i > std::size_t(0)) {
      int previous = values[i - std::size_t(1)];
      if (descending ? previous < current : previous > current) { return 3; }
    }
  }
  for (auto& remaining : frequencies) { if (remaining != 0) { return 4; } }
  // Introsort stays within 2*n*(ceil(log2(n))+1) comparisons on these shapes;
  // sort_adversary.gti checks its O(n log n) worst case.
  mut uint64_t levels = uint64_t(0);
  mut std::size_t width = std::size_t(1);
  while (width < values.size()) { width *= std::size_t(2); levels++; }
  if (comparisons > uint64_t(2) * uint64_t(count) * (levels + uint64_t(1))) { return 7; }
  // Whole ascending/reverse/equivalent runs take at most two comparisons
  // per adjacent pair, including equivalent prefixes and plateaus.
  if (count > 16 && (shape <= 2 || shape == 6 || shape == 8 || shape == 10) &&
      comparisons > uint64_t(2) * uint64_t(count - 1)) { return 8; }
  if (shape == 0 && !descending) { std::println(comparisons); }
  return 0;
}

int main() {
  for (mut int count = 128; count <= 1024; count *= 2) {
    for (mut int shape = 0; shape < 13; shape++) {
      int result = exercise(count, shape, false);
      if (result != 0) { return result; }
      int reverse = exercise(count, shape, true);
      if (reverse != 0) { return reverse; }
    }
  }
  // Exercise insertion, sampling, block-window and residual boundaries.
  int boundaries[17] = {2, 15, 16, 17, 31, 32, 33, 39, 40, 41,
                       63, 64, 65, 127, 129, 255, 257};
  for (int& count : boundaries) {
    for (mut int shape = 1; shape < 13; shape++) {
      if (exercise(count, shape, false) != 0 ||
          exercise(count, shape, true) != 0) { return 9; }
    }
  }
  if (exercise(0, 1, false) != 0 || exercise(1, 1, false) != 0) { return 5; }
  return 0;
}
// --- allocation_counts.cpp
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <new>
#if defined(_WIN32)
#include <malloc.h>
#else
#include <sys/resource.h>
#endif

namespace {
// Cleanup markers must remain visible even when exhaustion immediately aborts.
struct ConfigureAllocationProcess {
  ConfigureAllocationProcess() {
    std::setvbuf(stdout, nullptr, _IONBF, 0);
#if !defined(_WIN32)
    const rlimit limit{0, 0};
    setrlimit(RLIMIT_CORE, &limit);
#endif
  }
} configureAllocationProcess;
bool enabled = false;
std::uint64_t allocations = 0;
std::uint64_t bytes = 0;
std::uint64_t fail_at = 0;
bool audit_cleanup = false;
enum class Path { LegacyAligned, Process };
struct Region {
  void *address = nullptr;
  Path path = Path::Process;
  bool audited = false;
};
Region regions[4096]{};
std::size_t live_count = 0;

bool failed_attempt(std::size_t size) {
  if (!enabled)
    return false;
  ++allocations;
  bytes += size;
  if (fail_at == 0 || allocations != fail_at)
    return false;
  fail_at = 0; // Cleanup can itself print through allocating library code.
  return true;
}

void remember(void *address, Path path) {
  if (!address)
    return;
  for (const auto &region : regions)
    if (region.address == address)
      std::abort();
  for (auto &region : regions) {
    if (!region.address) {
      // Startup argv allocations precede the observation window. Track their
      // exact release too, without including them in scenario counts/leaks.
      region = {address, path, audit_cleanup};
      live_count += audit_cleanup ? 1 : 0;
      return;
    }
  }
  std::abort(); // Never silently lose a live allocation's identity.
}

void retire(void *address, Path path) {
  if (!address)
    return;
  for (auto &region : regions) {
    if (region.address == address) {
      if (region.path != path)
        std::abort();
      if (region.audited) {
        if (live_count == 0)
          std::abort();
        --live_count;
      }
      region = {};
      return;
    }
  }
  std::abort(); // A wrong-provider, untracked or duplicate release is a bug.
}
} // namespace

void *operator new(std::size_t size, std::align_val_t alignment,
                   const std::nothrow_t &) noexcept {
  if (failed_attempt(size))
    return nullptr;
  void *result = nullptr;
  const auto aligned = static_cast<std::size_t>(alignment);
#if defined(_WIN32)
  result = _aligned_malloc(size,
                           aligned < sizeof(void *) ? sizeof(void *) : aligned);
#else
  if (posix_memalign(&result,
                     aligned < sizeof(void *) ? sizeof(void *) : aligned,
                     size) != 0)
    return nullptr;
#endif
  remember(result, Path::LegacyAligned);
  return result;
}

void operator delete(void *pointer, std::align_val_t) noexcept {
  retire(pointer, Path::LegacyAligned);
#if defined(_WIN32)
  _aligned_free(pointer);
#else
  std::free(pointer);
#endif
}

// Inject the real source process-provider boundary, rather than observing an
// obsolete container representation's allocation implementation. These exact
// adapters avoid pulling the production adapter object from the runtime
// archive.
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return (std::numeric_limits<std::size_t>::max)();
}
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t size,
                                          std::uint64_t alignment) {
  if (failed_attempt(static_cast<std::size_t>(size)))
    return nullptr;
  void *address = _aligned_malloc(static_cast<std::size_t>(size),
                                  static_cast<std::size_t>(alignment));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  retire(address, Path::Process);
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  if (failed_attempt(static_cast<std::size_t>(bytes)))
    return nullptr;
  void *address = std::malloc(static_cast<std::size_t>(bytes));
  remember(address, Path::Process);
  return address;
}
extern "C" void *gti_rt_realloc_v1(void *address, std::uint64_t size) {
  if (failed_attempt(size))
    return nullptr;
  for (auto &region : regions) {
    if (region.address == address && region.path == Path::Process) {
      void *result = std::realloc(address, static_cast<std::size_t>(size));
      if (result)
        region.address = result;
      return result;
    }
  }
  std::abort();
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t size,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  if (failed_attempt(static_cast<std::size_t>(size))) {
    *status = ENOMEM;
    return nullptr;
  }
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(size));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) {
  retire(address, Path::Process);
  std::free(address);
}
#endif

extern "C" void adoption_count_begin() {
  allocations = 0;
  bytes = 0;
  enabled = true;
}
extern "C" void adoption_count_end() { enabled = false; }
extern "C" void adoption_trace(std::int32_t value) {
  std::printf("%d\n", static_cast<int>(value));
}
extern "C" std::uint64_t adoption_allocations() { return allocations; }
extern "C" std::uint64_t adoption_bytes() { return bytes; }
extern "C" void adoption_fail_at(std::uint64_t allocation) {
  if (live_count != 0)
    std::abort(); // Reset must never erase leaks from an earlier failure
                  // window.
  adoption_count_begin();
  fail_at = allocation;
  audit_cleanup = true;
}
// Called by the outermost GTI guard after URL and temporary cleanup. GTI's
// terminal failure deliberately does not run unmanaged C++ static destructors.
extern "C" void adoption_check_cleanup() {
  std::printf("live=%zu\n", live_count);
  audit_cleanup = false;
}
