// A type-erased input view reads the owner's cursor and shares flags, error bits and gcount.
//@ run-pass
//@ slow
import std.istream;
import std.io;
import std.string;
import std.span;

int take(mut std::istream input) {
  mut int n = 0;
  input >> std::hex >> n;
  if (!input || input.peek() != 58) { return 1; }
  input.ignore();
  mut std::string remainder{};
  if (!std::getline(input, remainder) || remainder != "ok") { return 2; }
  if (input.gcount() != 1 || !input.eof() || input.fail()) { return 3; }
  return n == 42 ? 0 : 4;
}

int main() {
  uint8_t bytes[5] = {uint8_t(50), uint8_t(97), uint8_t(58), uint8_t(111), uint8_t(107)};
  mut auto memory = std::io::memory_reader(bytes.as_span());
  mut std::basic_istream<std::io::memory_reader> owner{std::move(memory)};
  int result = take(owner.as_istream());
  if (result != 0) { return result; }
  if (!owner.eof() || owner.fail() || owner.gcount() != 1 ||
      (owner.flags() & std::ios::basefield) != std::ios::hex) { return 5; }
  return 0;
}
