// An application codec takes precedence over the default payload enum representation.
//@ run-pass
//@ slow
import std.json;
import std.string;

enum class Delay { seconds(uint64_t count) };
class std::json::codec<Delay> {
public:
  codec() = default;
  expected<void, std::json::error> encode(Delay& value, mut std::string& out) {
    switch (value) {
      case Delay::seconds(auto& count):
        auto text = ?std::json::encode(count);
        out.append(text.view());
        return;
    }
  }
  expected<Delay, std::json::error> decode(std::string_view text) {
    auto count = ?std::json::decode<uint64_t>(text);
    return Delay::seconds(count);
  }
};
int main() {
  auto delay = std::json::decode<Delay>("60");
  if (!delay) { return 1; }
  auto text = std::json::encode(delay.value());
  return text && text.value().view() == "60" ? 0 : 2;
}
