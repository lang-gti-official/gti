// Numeric address values round-trip without opening sockets or resolving hosts.
//@ run-pass
//@ slow
import std.tcp;
import std.json;
import std.vector;

struct Network {
  std::tcp::ipv4_address v4;
  std::tcp::ipv6_address v6;
  std::tcp::socket_address endpoint;
};

int main() {
  auto net = std::json::decode<Network>("{\"v4\":\"192.0.2.1\",\"v6\":\"::1\",\"endpoint\":\"[fe80::1%4]:443\"}");
  if (!net) { return 1; }
  auto text = std::json::encode(net.value());
  if (!text || text.value().view() != "{\"v4\":\"192.0.2.1\",\"v6\":\"::1\",\"endpoint\":\"[fe80::1%4]:443\"}") { return 2; }
  auto invalid = std::json::decode<std::vector<std::tcp::socket_address>>("[\"host.test:80\"]");
  if (invalid || invalid.error().path.view() != "/0" || invalid.error().offset != std::size_t(1)) { return 3; }
  if (std::json::decode<std::tcp::ipv4_address>("42")) { return 4; }
  return 0;
}
