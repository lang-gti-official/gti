// Out-of-range access and cursor misuse on complete containers fail with their report after cleanup.
//@ slow
//@ run-fail
//@ exit-code: 70
//@ stdout: 99
//@ revisions: b0 b1 b2 b3 b4 b5 b6 b7 b8
//@[b0] stderr-contains: runtime error[GTI-R0007]
//@[b1] args: bounds
//@[b1] stderr-contains: runtime error[GTI-R0007]
//@[b2] args: bounds bounds
//@[b2] stderr-contains: runtime error[GTI-R0007]
//@[b3] args: bounds bounds bounds
//@[b3] stderr-contains: runtime error[GTI-R0007]
//@[b4] args: bounds bounds bounds bounds
//@[b4] stderr-contains: runtime error[GTI-R0007]
//@[b5] args: bounds bounds bounds bounds bounds
//@[b5] stderr-contains: runtime error[GTI-R0016]
//@[b6] args: bounds bounds bounds bounds bounds bounds
//@[b6] stderr-contains: runtime error[GTI-R0016]
//@[b7] args: bounds bounds bounds bounds bounds bounds bounds
//@[b7] stderr-contains: runtime error[GTI-R0007]
//@[b8] args: bounds bounds bounds bounds bounds bounds bounds bounds
//@[b8] stderr-contains: runtime error[GTI-R0007]
import std.list;
import std.deque;
import std.queue;
import std.set;
import std.unordered_set;
import std.vector;
import std.string;
class Guard {
public:
  Guard() {}
  ~Guard() { std::println(99); }
};
int main(int argc, std::vector<std::string> argv) {
  Guard guard{};
  if (argc == 1) {
    std::list<int> values{};
    return values.front();
  }
  if (argc == 2) {
    mut std::list<int> values{};
    values.erase(std::size_t(0));
  }
  if (argc == 3) {
    std::deque<int> values{};
    return values.back();
  }
  if (argc == 4) {
    mut std::deque<int> values{};
    values.push_front(1);
    return values.at(std::size_t(1));
  }
  if (argc == 5) {
    std::queue<int> values{};
    return values.front();
  }
  if (argc == 6) {
    std::set<int> values{};
    return *values.begin();
  }
  if (argc == 8) {
    mut std::deque<int> values{};
    values.insert(std::size_t(1), 7);
  }
  if (argc == 9) {
    mut std::deque<int> values{};
    values.erase(std::size_t(0));
  }
  std::unordered_set<int> values{};
  mut auto cursor = values.begin();
  ++cursor;
  return 0;
}
