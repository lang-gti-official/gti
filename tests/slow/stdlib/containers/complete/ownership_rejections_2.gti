namespace case_iterator_list {
int entry() {
  mut std::list<int> values{};
  values.push_back(1);
  auto cursor = values.begin();
  values.clear();  //~ ERROR GTI-S2017
  return *cursor;
}
}

namespace case_iterator_deque {
int entry() {
  mut std::deque<int> values{};
