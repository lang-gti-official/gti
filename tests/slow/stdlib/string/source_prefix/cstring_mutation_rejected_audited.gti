// A live C-string view blocks mutating its string, with the raw-pointer audit on.
//@ slow
//@ check-fail
//@ raw-pointer-audit: warn
import std.string;
int main() {
  mut std::string text{};
  c_string native = text.try_c_string();
  text.push_back('a');  //~ WARN GTI-S2103 //~ ERROR GTI-S2017
  return native == nullptr ? 1 : 0;
}
