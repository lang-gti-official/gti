// The internal owning factory reports an empty rules handle before dereferencing it.
//@ run-pass
//@ slow
//@ reason: Zone-rules ownership integration took 12.60 CPU seconds on Linux CI, above the fast-tier budget.
//@ stdlib-overlay: std/chrono_rules_probe.gti
// --- main.gti
import std.chrono_rules_probe;
int main() { return check_empty_rules(); }
// --- std/chrono_rules_probe.gti
export module chrono_rules_probe;
import "detail/chrono_zones.gti";
import "detail/chrono_tzif.gti";
import "detail/chrono_calendar.gti";
import std.memory;
export int check_empty_rules() {
  std::shared_ptr<std::chrono::detail::zone_rules> empty{};
  auto result = std::chrono::zoned_time::try_from_rules(std::move(empty), std::chrono::timestamp(0i64));
  if (result || result.error() != std::chrono::errc::invalid_data) return 1;
  auto rules = std::chrono::detail::zone_rules::try_fixed(0).expect("fixed rules");
  mut auto handle = std::make_shared<std::chrono::detail::zone_rules>(std::move(rules));
  handle.reset();
  auto reset_result = std::chrono::zoned_time::try_from_rules(std::move(handle), std::chrono::timestamp(0i64));
  return !reset_result && reset_result.error() == std::chrono::errc::invalid_data ? 0 : 2;
}
