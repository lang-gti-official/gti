// Constructions consuming an Expected<Class, E> argument publish directly at their Return or constructor field, without default-constructing the payload.
//@ run-pass
//@ revisions: default invalid constructor-failure
//@[invalid] run-fail
//@[invalid] args: invalid
//@[invalid] exit-code: 70
//@[invalid] stdout: cleanup
//@[invalid] stderr-contains: prepared_checked_payload.gti:49: runtime error[GTI-R0009]: invalid_expected_access in value_on_error
//@[constructor-failure] run-fail
//@[constructor-failure] args: constructor failure
//@[constructor-failure] exit-code: 70
//@[constructor-failure] stdout: later
//@[constructor-failure] stdout: cleanup
//@[constructor-failure] stderr-contains: prepared_checked_payload.gti:16: runtime error[GTI-R0001]: integer_overflow in addition
//@ slow
// --- prepared_checked_payload.gti
import std.format;
import std.string;
import std.vector;

struct Item {
  int32_t number;
  Item(int32_t value) : number(value) {}
  Item(Item&) = default;
  Item(Item&&) = default;
};

struct Box {
  Item item;
  int32_t total;
  Box(Item input, int32_t after)
      : item(input), total(input.number + after) {}
};

struct Guard {
  ~Guard() { std::println("cleanup"); }
public:
  Guard() = default;
};

expected<Item, int32_t> parse(bool valid) {
  if (!valid) { return unexpected(int32_t(7)); }
  return Item(41);
}

expected<Box, int32_t> wrap(bool valid) {
  auto parsed = parse(valid);
  if (!parsed) { return unexpected(parsed.error()); }
  return Box(parsed.value(), 1);
}

expected<Box, int32_t> wrap_error() {
  expected<int32_t, Item> parsed = unexpected(Item(8));
  return Box(parsed.error(), 2);
}

int32_t observe(Item& item) { return item.number; }

int32_t later(int32_t value) { std::println("later"); return value; }

int main(int argc, std::vector<std::string> argv) {
  if (argc == 2) {
    Guard guard{};
    auto parsed = parse(false);
    Box failing{parsed.value(), later(1)};
    return failing.total;
  }
  if (argc == 3) {
    Guard guard{};
    auto parsed = parse(true);
    Box failing{parsed.value(), later(2147483647)};
    return failing.total;
  }
  auto valid = wrap(true);
  if (!valid || valid.value().total != 42) { return 1; }
  auto invalid = wrap(false);
  if (invalid || invalid.error() != 7) { return 2; }
  auto error = wrap_error();
  if (!error || error.value().total != 10) { return 3; }
  auto parsed = parse(true);
  if (observe(parsed.value()) != 41) { return 4; }
  return 0;
}
