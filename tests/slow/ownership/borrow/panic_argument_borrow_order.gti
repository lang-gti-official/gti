// Scalar and operator temporaries retain ordered evaluation and cleanup.
//@ run-pass
//@ revisions: default divide panic-position later-producer-fails
//@[default] stdout: temporary
//@[default] stdout: 24 21
//@[default] stdout: holder
//@[divide] run-fail
//@[divide] args: divide
//@[divide] exit-code: 70
//@[divide] stdout: holder
//@[divide] stderr-contains: panic_argument_borrow_order.gti:35: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[panic-position] run-fail
//@[panic-position] args: panic position
//@[panic-position] exit-code: 70
//@[panic-position] stdout: holder
//@[panic-position] stderr-contains: panic_argument_borrow_order.gti:16: runtime error[GTI-R0017]: panic: "position row(9), col(0), line(45), file(
//@[panic-position] stderr-contains: panic_argument_borrow_order.gti)"
//@[later-producer-fails] run-fail
//@[later-producer-fails] args: later producer fails
//@[later-producer-fails] exit-code: 70
//@[later-producer-fails] stdout: holder
//@[later-producer-fails] stderr-contains: panic_argument_borrow_order.gti:40: runtime error[GTI-R0002]: division_by_zero in integer_division
//@ slow
// --- panic_argument_borrow_order.gti
import std;

#macro CHECK_RANGE(uint8_t row, uint8_t col, std::source_location loc) {
  if (row >= 9 || col >= 9) {
    std::panic("position row({}), col({}), line({}), file({})", row, col,
               loc.line(), loc.file_name());
  }
}

struct Position {
  uint8_t row;
  uint8_t col;
  Position(uint8_t row, uint8_t col,
           std::source_location loc = std::source_location::current())
      : row(row), col(col) {
    CHECK_RANGE!(row, col, loc); // panic-site
  }
};

struct Holder {
  int value;
  Holder(int value) : value(value) {}
  ~Holder() { std::println("holder"); }
  int& get() { return this.value; }
};

struct Payload {
  int value;
  Payload(int value) : value(value) {}
  ~Payload() { std::println("temporary"); }
  int read() { return this.value; }
};

int combine(int& a, int& b, int& c, int& d) {
  return a / b + c / d; // divide-site
}
int consume(Payload& payload, int& divisor) {
  return payload.read() / divisor;
}
int later(int divisor) { return 1 / divisor; } // producer-site

int main(int argc, std::vector<std::string> argv) {
  Holder holder{argc == 2 ? 0 : 2};
  if (argc == 3) {
    Position invalid{uint8_t(9), uint8_t(0)}; // location-site
  }
  if (argc == 4) {
    return combine(42, holder.get(), later(0), holder.get());
  }
  Position valid{uint8_t(0), uint8_t(0)};
  int sum = combine(42, holder.get(), 6, holder.get());
  int owned = consume(Payload(42), holder.get());
  std::println("{} {}", sum, owned);
  return sum == 24 && owned == 21 ? 0 : 1;
}
