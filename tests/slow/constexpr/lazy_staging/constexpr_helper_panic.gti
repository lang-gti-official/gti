// A constexpr user helper reports its panic message.
//@ snapshot: diagnostics
//@ slow
import std.panic;
[[noreturn]] constexpr void reject(std::string_view message) { std::panic(message); }
consteval int checked_percent(int value) {
  if (value > 100) { reject("percentage above 100"); }
  return value;
}
int main() { return checked_percent(42) + checked_percent(142) == 0 ? 0 : 1; }  //~ ERROR GTI-S2057
