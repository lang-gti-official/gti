// Temporary test directories own cleanup across moves and file helpers preserve exact bounded bytes.
//@ run-pass
//@ slow
import std.testing;
import std.testing.resources;
import std.filesystem;
import std.string;
int main() {
  mut std::filesystem::path previous{};
  {
    auto original = std::testing::temporary_directory::create().expect("create directory");
    previous = original.path().clone();
    auto directory = std::move(original);
    auto file = directory.path() / "fixture";
    std::testing::write_file(file, "hello\0world").expect("write bytes");
    auto bytes = std::testing::read_file(file).expect("read bytes");
    std::testing::check_string_eq(bytes.view(), "hello\0world");
    auto limited = std::testing::read_file(file, uint64_t(2));
    std::testing::check(!limited, "bounded read must fail instead of truncate");
    auto absent = directory.path() / "missing";
    auto failed = std::testing::read_file(absent);
    std::testing::check(!failed, "missing file must report a recoverable error");
  }
  std::testing::check(!std::filesystem::exists(previous).expect("query cleanup"));
  return 0;
}
