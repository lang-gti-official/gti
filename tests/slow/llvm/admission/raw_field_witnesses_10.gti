// Raw field witnesses: raw projection type verification preserves readonly, padded, nested-array and base fields.
//@ build-pass
//@ slow
class Nested { public: mut int values[3] = {1, 2, 3};  public: Nested() = default; }; int main() { mut Nested object{}; unsafe { Nested* pointer = &object; pointer->values[1] = 9; return pointer->values[1] - 9; } }
