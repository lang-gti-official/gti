// Selected result relays: the program is accepted.
//@ build-pass
//@ slow
class Base {
public:
  int32_t value;
  Base() : value(5) {}
  virtual int32_t& slot() { return this.value; }
};
int32_t& relay(Base& base) { return base.slot(); }
int main() {
  Base owner{};
  Base other{};
  return relay(owner) == 5 && other.value == 5 ? 0 : 1;
}
