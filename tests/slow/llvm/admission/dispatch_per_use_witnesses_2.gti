// Dispatch per use witnesses: exact generated Copy Construct and implicit Copy Load into fresh whole locals have operation-specific admission.
//@ build-pass
//@ slow
    class P {
    public:
      int value;
      P(int input) : value(input) {}
      virtual int read() { return this.value; }
    };
    int main() {
      P original{7};
      P explicit_copy{original};
      P implicit_copy = original;
      return original.read() + explicit_copy.read() + implicit_copy.read() - 21;
    }
