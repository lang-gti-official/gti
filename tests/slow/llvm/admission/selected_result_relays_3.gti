// Selected result relays: a interface call's selected int32_t& relays on LLVM.
//@ build-pass
//@ slow
import std.span;
import std.string;
import std.vector;
class Record {
public:
  std::string name;
  Record() : name(std::string("record")) {}
};
interface Picker {
  int32_t& select();
};
class Base : public Picker {
public:
  int32_t value;
  mut std::vector<int32_t> values;
  Record record;
  Base() : value(5), record(Record()) {}
  virtual void poke() {}
  int32_t& select() override { return this.value; }
};
int32_t& relay(Picker& item) { return item.select(); }
int main() {
  mut Base owner{};
  owner.values.push_back(1);
  return relay(owner) == 5 ? 0 : 1;
}
