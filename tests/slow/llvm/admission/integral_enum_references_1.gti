// Integral enum references: sealed integral enum references are represented.
//@ build-pass
//@ slow
enum class E { first, second };
E& read(E& value) { return value; }
mut E& edit(mut E& value) { return value; }
int main() {
  mut E value = E::first;
  edit(value) = E::second;
  return read(value) == E::second ? 0 : 1;
}
