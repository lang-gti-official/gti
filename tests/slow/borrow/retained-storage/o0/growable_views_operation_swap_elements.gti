// Borrowed storage: growable views operation swap elements.
//@ slow
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.vector;
int main() {
  std::string first{"first"}; std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.push_back(first.view());
  values.push_back(second.view());
  values.reserve(32);
  values.swap_elements(0, 1);
  return values.size() == 2 && values[1] == "first" && values[0] == "second" ? 0 : 1;
}
