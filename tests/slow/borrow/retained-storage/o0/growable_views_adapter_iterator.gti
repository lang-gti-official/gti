// Borrowed storage: growable views adapter iterator.
//@ slow
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.vector;
int main() {
  std::string first{"first"}; std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.push_back(first.view());
  values.push_back(second.view());
  values.reserve(32);
  auto adapter = values.begin();
  auto selected = *adapter;
  return selected == "first" ? 0 : 1;
}
