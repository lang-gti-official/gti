// Borrowed storage: growable views operation clone.
//@ slow
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.vector;
int main() {
  std::string first{"first"}; std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.push_back(first.view());
  values.push_back(second.view());
  values.reserve(32);
  auto copied = values.clone();
  return copied.size() == 2 && copied[0] == "first" && copied[1] == "second" ? 0 : 1;
}
