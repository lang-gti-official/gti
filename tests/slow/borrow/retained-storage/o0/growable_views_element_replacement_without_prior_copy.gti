// Borrowed storage: growable views element replacement without prior copy.
//@ slow
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.vector;
int main() {
  std::string first{"first"}; std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.emplace_back(first.view());
  values[0] = second.view();
  values.reserve(32);
  auto current = values[0];
  return current == "second" ? 0 : 1;
}
