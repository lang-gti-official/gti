// Borrowed storage: growable views element reference blocks growth.
//@ slow
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
import std.vector;
int main() {
  std::string first{"first"}; std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.push_back(first.view());
  values.push_back(second.view());
  std::string_view& element = values[0];
  values.reserve(32);  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  if (element != "first") { return 2; }
  return values.size() == 2 && values[0] == "first" && values[1] == "second" ? 0 : 1;
}
