// A typed macro rejects an argument of the wrong type at the invocation;
// the fixed call hovers as a `#macro`. (From deferred_assertion_lsp_test.py.)
import std.assert;
int main() { /*😀*/ std::assert!(1); return 0; }  //~ ERROR GTI-S2003
// --- step 2
//@ hover @assert: #macro
import std.assert;
int main() { /*😀*/ std::/*@assert*/assert!(true); return 0; }
