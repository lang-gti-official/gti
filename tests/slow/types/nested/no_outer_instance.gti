// A nested type's method has no implicit enclosing instance to read. (Analysis takes about 5 s, a compiler cost bug.)
//@ check-fail
//@ slow
struct C { int value = 1; struct N { int read() { return value; }  public: N() = default; };  public: C() = default; }; int main() { return 0; }  //~ ERROR GTI-S2001 value
