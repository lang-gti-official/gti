//@[worker_cleanup] stderr-contains: panic_runtime.gti:15: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0017] at panic_runtime.gti:94 message="worker primary failure"; secondary [GTI-R0017] message="cleanup failed"
//@[stored_library] run-fail
//@[stored_library] exit-code: 70
