//@[stored_library] stdout: 90
//@[stored_library] stderr-contains: <std/functional>:54: runtime error[GTI-R0017]: panic: "stored 6"
//@[stored_wrapper] run-fail
//@[stored_wrapper] exit-code: 70
//@[stored_wrapper] args: case case case case case case case case case case case case case case case case case
//@[stored_wrapper] stdout: 90
//@[stored_wrapper] stderr-contains: panic_runtime.gti:80: runtime error[GTI-R0017]: panic: "stored 7"
