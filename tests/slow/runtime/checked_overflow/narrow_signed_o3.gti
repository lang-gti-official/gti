// Checked, saturating and ordinary arithmetic on int8_t, int16_t match exact math at every boundary pair (a hash of each sweep's results, from an exact oracle); 8- and 16-bit operators promote to int32. Optimized.
//@ slow
//@ opt: O3
//@ reason: the optimizer must not fold or reorder checked arithmetic on unknown operands
//@ run-pass
//@ revisions: sweep_int8 sweep_int16 ops_int8 ops_int16 
//@[sweep_int8] args: int8 sweep -128 -127 -65 -64 -9 -8 -7 -3 -2 -1 0 1 2 3 7 8 9 63 64 126 127
//@[sweep_int8] stdout: 2646
//@[sweep_int8] stdout: -3414172565162591107
//@[ops_int8] args: int8 add 126 1 add 127 1 add 127 0 sub -127 1 sub -128 1 sub 0 0 mul 7 7 mul 8 8 mul 127 2 mul 127 1 mul 0 127 add -128 -1 sub 127 -1 mul -128 -1 mul -1 -128 mul -128 1 mul -8 8
//@[ops_int8] stdout: 127
//@[ops_int8] stdout: 128
//@[ops_int8] stdout: 127
//@[ops_int8] stdout: -128
//@[ops_int8] stdout: -129
//@[ops_int8] stdout: 0
//@[ops_int8] stdout: 49
//@[ops_int8] stdout: 64
//@[ops_int8] stdout: 254
//@[ops_int8] stdout: 127
//@[ops_int8] stdout: 0
//@[ops_int8] stdout: -129
//@[ops_int8] stdout: 128
//@[ops_int8] stdout: 128
//@[ops_int8] stdout: 128
//@[ops_int8] stdout: -128
//@[ops_int8] stdout: -64
//@[sweep_int16] args: int16 sweep -32768 -32767 -16385 -16384 -129 -128 -127 -3 -2 -1 0 1 2 3 127 128 129 16383 16384 32766 32767
//@[sweep_int16] stdout: 2646
//@[sweep_int16] stdout: 7777497287820166365
//@[ops_int16] args: int16 add 32766 1 add 32767 1 add 32767 0 sub -32767 1 sub -32768 1 sub 0 0 mul 127 127 mul 128 128 mul 32767 2 mul 32767 1 mul 0 32767 add -32768 -1 sub 32767 -1 mul -32768 -1 mul -1 -32768 mul -32768 1 mul -128 128
//@[ops_int16] stdout: 32767
//@[ops_int16] stdout: 32768
//@[ops_int16] stdout: 32767
//@[ops_int16] stdout: -32768
//@[ops_int16] stdout: -32769
//@[ops_int16] stdout: 0
//@[ops_int16] stdout: 16129
//@[ops_int16] stdout: 16384
//@[ops_int16] stdout: 65534
//@[ops_int16] stdout: 32767
//@[ops_int16] stdout: 0
//@[ops_int16] stdout: -32769
//@[ops_int16] stdout: 32768
//@[ops_int16] stdout: 32768
//@[ops_int16] stdout: 32768
//@[ops_int16] stdout: -32768
//@[ops_int16] stdout: -16384
import std.charconv;
import std.numeric;
import std.panic;
import std.string;
import std.vector;

int8_t parse_int8(std::string& text) {
  mut int8_t value = int8_t(0);
  auto parsed = std::from_chars(text.view(), value);
  if (parsed.ec != std::parse_errc::none || parsed.position != text.size()) {
    std::panic("unparsable operand");
  }
  return value;
}
int64_t mix_int8(int64_t hash, int64_t value) {
  return std::wrapping_add(std::wrapping_mul(hash, int64_t(1099511628211)), value);
}
int64_t mix_checked_int8(int64_t hash, expected<int8_t, std::arithmetic_errc> result) {
  if (result.has_value()) { return mix_int8(mix_int8(hash, int64_t(1)), int64_t(result.value())); }
  return mix_int8(hash, int64_t(2));
}
void sweep_int8(std::vector<std::string>& argv) {
  mut std::vector<int8_t> values = std::vector<int8_t>();
  for (mut std::size_t index = std::size_t(3); index < argv.size(); index++) {
    values.push_back(parse_int8(argv[index]));
  }
  mut int64_t hash = int64_t(0);
  mut int32_t count = 0;
  for (auto& left : values) {
    for (auto& right : values) {
      hash = mix_checked_int8(hash, std::checked_add(left, right));
      hash = mix_checked_int8(hash, std::checked_sub(left, right));
      hash = mix_checked_int8(hash, std::checked_mul(left, right));
      hash = mix_int8(hash, int64_t(std::saturating_add(left, right)));
      hash = mix_int8(hash, int64_t(std::saturating_sub(left, right)));
      hash = mix_int8(hash, int64_t(std::saturating_mul(left, right)));
      count += 6;
    }
  }
  std::println(count);
  std::println(hash);
}
void operate_int8(std::vector<std::string>& argv) {
  for (mut std::size_t index = std::size_t(2); index + std::size_t(2) < argv.size(); index += std::size_t(3)) {
    std::string& operation = argv[index];
    int8_t left = parse_int8(argv[index + std::size_t(1)]);
    int8_t right = parse_int8(argv[index + std::size_t(2)]);
    if (operation == "add") { std::println(left + right); }
    else if (operation == "sub") { std::println(left - right); }
    else if (operation == "mul") { std::println(left * right); }
    else if (operation == "add-assign") {
      mut auto target = left;
      target += right;
      std::println(target);
    }
    else { std::panic("unknown operation"); }
  }
}

int16_t parse_int16(std::string& text) {
  mut int16_t value = int16_t(0);
  auto parsed = std::from_chars(text.view(), value);
  if (parsed.ec != std::parse_errc::none || parsed.position != text.size()) {
    std::panic("unparsable operand");
  }
  return value;
}
int64_t mix_int16(int64_t hash, int64_t value) {
  return std::wrapping_add(std::wrapping_mul(hash, int64_t(1099511628211)), value);
}
int64_t mix_checked_int16(int64_t hash, expected<int16_t, std::arithmetic_errc> result) {
  if (result.has_value()) { return mix_int16(mix_int16(hash, int64_t(1)), int64_t(result.value())); }
  return mix_int16(hash, int64_t(2));
}
void sweep_int16(std::vector<std::string>& argv) {
  mut std::vector<int16_t> values = std::vector<int16_t>();
  for (mut std::size_t index = std::size_t(3); index < argv.size(); index++) {
    values.push_back(parse_int16(argv[index]));
  }
  mut int64_t hash = int64_t(0);
  mut int32_t count = 0;
  for (auto& left : values) {
    for (auto& right : values) {
      hash = mix_checked_int16(hash, std::checked_add(left, right));
      hash = mix_checked_int16(hash, std::checked_sub(left, right));
      hash = mix_checked_int16(hash, std::checked_mul(left, right));
      hash = mix_int16(hash, int64_t(std::saturating_add(left, right)));
      hash = mix_int16(hash, int64_t(std::saturating_sub(left, right)));
      hash = mix_int16(hash, int64_t(std::saturating_mul(left, right)));
      count += 6;
    }
  }
  std::println(count);
  std::println(hash);
}
void operate_int16(std::vector<std::string>& argv) {
  for (mut std::size_t index = std::size_t(2); index + std::size_t(2) < argv.size(); index += std::size_t(3)) {
    std::string& operation = argv[index];
    int16_t left = parse_int16(argv[index + std::size_t(1)]);
    int16_t right = parse_int16(argv[index + std::size_t(2)]);
    if (operation == "add") { std::println(left + right); }
    else if (operation == "sub") { std::println(left - right); }
    else if (operation == "mul") { std::println(left * right); }
    else if (operation == "add-assign") {
      mut auto target = left;
      target += right;
      std::println(target);
    }
    else { std::panic("unknown operation"); }
  }
}

int main(int argc, std::vector<std::string> argv) {
  if (argc < 3) { return 2; }
  std::string& type = argv[std::size_t(1)];
  bool sweep = argv[std::size_t(2)] == "sweep";
  if (type == "int8") {
    if (sweep) { sweep_int8(argv); } else { operate_int8(argv); }
    return 0;
  }
  if (type == "int16") {
    if (sweep) { sweep_int16(argv); } else { operate_int16(argv); }
    return 0;
  }
  return 3;
}
