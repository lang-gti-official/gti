int main(int argc, std::vector<std::string> argv) {
  if (argc < 3) { return 2; }
  std::string& type = argv[std::size_t(1)];
  bool sweep = argv[std::size_t(2)] == "sweep";
  if (type == "uint8") {
    if (sweep) { sweep_uint8(argv); } else { operate_uint8(argv); }
    return 0;
  }
  if (type == "uint16") {
    if (sweep) { sweep_uint16(argv); } else { operate_uint16(argv); }
    return 0;
  }
  if (type == "uint32") {
    if (sweep) { sweep_uint32(argv); } else { operate_uint32(argv); }
    return 0;
  }
  if (type == "uint64") {
    if (sweep) { sweep_uint64(argv); } else { operate_uint64(argv); }
    return 0;
  }
  return 3;
}
