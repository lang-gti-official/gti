  for (mut std::size_t index = std::size_t(3); index < argv.size(); index++) {
    values.push_back(parse_uint64(argv[index]));
  }
  mut uint64_t hash = uint64_t(0);
  mut int32_t count = 0;
  for (auto& left : values) {
    for (auto& right : values) {
      hash = mix_checked_uint64(hash, std::checked_add(left, right));
      hash = mix_checked_uint64(hash, std::checked_sub(left, right));
      hash = mix_checked_uint64(hash, std::checked_mul(left, right));
