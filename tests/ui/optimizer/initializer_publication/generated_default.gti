// An unstaged constructor field initializer (generated default) keeps its literal-backed value.
//@ run-pass
//@ stdout: Ada|Ada
import std.string;
struct P { std::string_view name = "Ada"; uint32_t health = 7;  public: P() = default; };
void app(mut std::string& out, std::string_view& item) { out.append(item); }
int main() {
  P p{};
  mut std::string out = std::string("");
  app(out, p.name);
  std::print(out.view());
  std::print("|");
  std::print(p.name);
  std::print("\n");
  return 0;
}
