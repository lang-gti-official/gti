// A failing task capture cleanup after a worker panic reports the cleanup failure.
//@ run-fail
//@ execution-profile: concurrent
//@ exit-code: 70
//@ stdout: worker body
//@ stdout: 82
//@ stderr-contains: panic_task_cleanup.gti:11: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0017] at panic_task_cleanup.gti:29 message="capture primary failure"; secondary [GTI-R0017] message="cleanup failed"
// --- panic_task_cleanup.gti
import std.panic;
import std.thread;

struct Guard {
  int id;
  bool fails;
  Guard(int value, bool failure = false) : id(value), fails(failure) {}
  ~Guard() {
    std::println(id);
    if (fails) {
      std::panic("cleanup failed"); // cleanup-site
    }
  }
};


[[unsafe_transfer]] struct TaskSentinel {
  ~TaskSentinel() { std::println(99); }
public:
  TaskSentinel() = default;
};

[[unsafe_transfer]] struct TaskCleanupFailure {
  Guard sibling;
  TaskCleanupFailure() : sibling(Guard(98)) {}
  ~TaskCleanupFailure() {
    Guard skipped{97};
    Guard failing{82, true};
    std::panic("capture primary failure"); // capture-primary-site
  }
};


int main() {
  Guard parent{90};
  TaskSentinel first{};
  TaskCleanupFailure last{};
  auto task = [first = std::move(first), last = std::move(last)]() -> void {
    std::println("worker body");
  };
  auto started = std::thread::start(std::move(task));
  if (!started) { return 99; }
  mut std::thread worker = std::move(started).value();
  auto joined = worker.join();
  if (!joined) { return 98; }
  return 0;
}
