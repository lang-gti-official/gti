// A worker panic drops its fresh carriers in reverse order; a cleanup failure escalates.
//@ run-fail
//@ revisions: panic cleanup
//@ execution-profile: concurrent
//@[panic] exit-code: 70
//@[panic] stdout: 82
//@[panic] stdout: 83
//@[panic] stdout: 92
//@[panic] stdout: 91
//@[panic] stdout: 89
//@[panic] stdout: 88
//@[panic] stdout: 84
//@[panic] stdout: 90
//@[panic] stderr-contains: panic_worker_fresh_carriers.gti:36: runtime error[GTI-R0017]: panic: "worker primary failure"
//@[cleanup] exit-code: 70
//@[cleanup] args: case
//@[cleanup] stdout: 82
//@[cleanup] stderr-contains: panic_worker_fresh_carriers.gti:16: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0017] at panic_worker_fresh_carriers.gti:36 message="worker primary failure"; secondary [GTI-R0017] message="cleanup failed"
// --- panic_worker_fresh_carriers.gti
import std.panic;
import std.memory;
import std.mutex;
import std.optional;
import std.thread;
import std.string;
import std.vector;

struct Guard {
  int id;
  bool fails;
  Guard(int value, bool failure = false) : id(value), fails(failure) {}
  ~Guard() {
    std::println(id);
    if (fails) {
      std::panic("cleanup failed"); // cleanup-site
    }
  }
};

expected<Guard, int> worker_result() { return Guard(91); }

std::vector<Guard> worker_sequence() {
  mut std::vector<Guard> result{};
  result.push_back(Guard(92));
  return result;
}

void worker_double_failure(
    std::unique_ptr<Guard> owner, std::optional<Guard> optional,
    expected<Guard, int> result, std::vector<Guard> sequence,
    std::mutex<int> gate, bool emergency) {
  std::mutex_guard<int> held = gate.lock();
  Guard skipped{83};
  Guard worker{82, emergency};
  std::panic("worker primary failure"); // worker-primary-site
}

int main(int argc, std::vector<std::string> argv) {
  Guard parent{90};
  bool emergency = argc > 1;
  auto started = std::thread::start([emergency]() -> void {
    Guard caller{84};
    worker_double_failure(std::make_unique<Guard>(88, false),
                          std::optional<Guard>(Guard(89)), worker_result(),
                          worker_sequence(), std::mutex<int>(0), emergency);
  });
  if (!started) { return 99; }
  mut std::thread worker = std::move(started).value();
  auto joined = worker.join();
  if (!joined) { return 98; }
  return 0;
}
