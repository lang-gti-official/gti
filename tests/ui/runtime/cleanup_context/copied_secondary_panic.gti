// A long secondary panic during cleanup reports both full messages and stops cleanup.
//@ run-fail
//@ exit-code: 70
//@ stderr-contains: main.gti:5: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0017] at main.gti:10 message="\x00tail"; secondary [GTI-R0017] message="\x00tail"
// --- main.gti
import std.panic;
class Outer { public: Outer() = default; ~Outer() { std::print('O'); } };
class Failing { public: Failing() = default; ~Failing() {
  std::print('D');
  std::panic("\0tail");
} };
int main() {
  Outer outer{};
  Failing inner{};
  std::panic("\0tail");
}
