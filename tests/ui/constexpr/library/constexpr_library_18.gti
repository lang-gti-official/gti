// Constexpr library: non-generic unsupported constexpr results retain their declaration-time diagnostic.
class Base { public: int x = 0; };
class Derived : public Base { public: int y = 0; };
constexpr Derived impossible(Derived value) { return value; }  //~ ERROR GTI-S2057 must return void or a supported value //~ ERROR GTI-S2057
int main() { return 0; }
