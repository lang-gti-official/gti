// Constexpr library: runtime-only constexpr instantiations retain ordinary ownership errors rather than signature eligibility errors.
import std.string;
constexpr T relay<T>(T value) { return std::move(value); }
int main() { std::string value = std::string("a"); std::string moved = relay(std::move(value)); return int(value.size()); }  //~ ERROR GTI-S2018
