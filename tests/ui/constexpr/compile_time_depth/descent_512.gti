// Compile-time depth: A 512-deep string-view recursive descent fits the default limit of 512 nested calls.
//@ check-pass
constexpr int32_t depth_of(std::string_view text, int32_t at) {
  if (text[at] == '(') { return depth_of(text, at + 1) + 1; }
  return 0;
}
