// Compile-time depth: A constexpr constructor shares the 512-call default.
//@ check-pass
constexpr int32_t count(int32_t remaining) {
  if (remaining == 0) { return 0; }
  return count(remaining - 1) + 1;
}
struct Tally {
  int32_t total;
  constexpr Tally(int32_t remaining) : total(count(remaining)) {}
};
constexpr int32_t total = Tally(510).total;
static_assert(total == 510);
int main() { return 0; }
