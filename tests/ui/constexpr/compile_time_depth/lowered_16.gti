// Compile-time depth: A lowered limit still admits exactly its own depth.
//@ check-pass
//@ constexpr-depth: 16
constexpr int32_t depth_of(std::string_view text, int32_t at) {
  if (text[at] == '(') { return depth_of(text, at + 1) + 1; }
  return 0;
}
static_assert(depth_of("(((((((((((((((x", 0) == 15);
int main() { return 0; }
