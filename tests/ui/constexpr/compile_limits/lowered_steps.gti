// Compile limits: a lowered step limit rejects the same request, naming the request, the executing function, the limit, the flag and the manifest key.
//@ constexpr-steps: 4096
//@ snapshot: diagnostics
struct Tally {
  uint64_t count;
  uint64_t sum;
  constexpr Tally(uint64_t c, uint64_t s) : count(c), sum(s) {}
};
constexpr Tally accumulate(uint64_t n, uint64_t seed) {
  mut uint64_t count = 0;
  mut uint64_t sum = seed;
  while (count < n) {
    count = count + 1;  //~ ERROR GTI-S2057 used all 4096 steps of its constant-evaluation execution-step limit while executing 'accumulate'
    sum = sum + count;
  }
  return Tally(count, sum);
}
constexpr uint64_t spin(uint64_t n) { return accumulate(n, uint64_t(0)).count; }
static_assert(spin(uint64_t(5000)) == uint64_t(5000));
int main() { return 0; }
