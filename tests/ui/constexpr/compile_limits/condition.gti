// Compile limits: a compile-time branch condition's exhaustion names its limit.
//@ constexpr-steps: 1000
struct Tally {
  uint64_t count;
  uint64_t sum;
  constexpr Tally(uint64_t c, uint64_t s) : count(c), sum(s) {}
};
constexpr Tally accumulate(uint64_t n, uint64_t seed) {
  mut uint64_t count = 0;
  mut uint64_t sum = seed;
  while (count < n) {
    count = count + 1;  //~ ERROR GTI-S2057 'if constexpr'
    sum = sum + count;
  }
  return Tally(count, sum);
}
constexpr uint64_t spin(uint64_t n) { return accumulate(n, uint64_t(0)).count; }
int pick() { if constexpr (spin(uint64_t(5000)) > uint64_t(0)) { return 1; } else { return 0; } }  //~ ERROR GTI-S2031
int main() { return 0; }
