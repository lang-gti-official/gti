// Compile limits: one step below the edge, the same request is attributed to the step limit.
//@ constexpr-steps: 1987
//@ constexpr-depth: 32
// 1988 is the smallest step budget at which recursion still reaches the depth
// limit of 32 (found by bisection: `gti x.gti --emit-mir --constexpr-depth 32
// --constexpr-steps N`); there the depth trip leaves the budget exactly spent,
// so a step charged while the failure unwinds would re-attribute it. If step
// accounting changes, re-derive the edge and update both edge files.
struct Tally {
  uint64_t count;
  uint64_t sum;
  constexpr Tally(uint64_t c, uint64_t s) : count(c), sum(s) {}
};
constexpr Tally accumulate(uint64_t n, uint64_t seed) {
  mut uint64_t count = 0;
  mut uint64_t sum = seed;
  while (count < n) {
    count = count + 1;
    sum = sum + count;
  }
  return Tally(count, sum);
}
constexpr uint64_t spin(uint64_t n) { return accumulate(n, uint64_t(0)).count; }
constexpr uint64_t deep(uint64_t n) {
  mut uint64_t i = 0;
  while (i < uint64_t(3)) { i = i + 1; }
  return deep(n + uint64_t(1));  //~ ERROR GTI-S2057 used all 1987 steps
}
static_assert(deep(uint64_t(0)) == uint64_t(0));
int main() { return 0; }
