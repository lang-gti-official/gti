// Compile limits: exhaustion inside a constexpr constructor names its class.
//@ constexpr-steps: 1000
struct Tally {
  uint64_t count;
  uint64_t sum;
  constexpr Tally(uint64_t c, uint64_t s) : count(c), sum(s) {}
};
constexpr Tally accumulate(uint64_t n, uint64_t seed) {
  mut uint64_t count = 0;
  mut uint64_t sum = seed;
  while (count < n) {
    count = count + 1;
    sum = sum + count;
  }
  return Tally(count, sum);
}
constexpr uint64_t spin(uint64_t n) { return accumulate(n, uint64_t(0)).count; }
struct Heavy {
  uint64_t value;
  constexpr Heavy(uint64_t n) : value(0) {
    mut uint64_t i = 0;
    while (i < n) { i = i + 1; }  //~ ERROR GTI-S2057 while executing 'Heavy'
  }
};
constexpr Heavy heavy = Heavy(uint64_t(5000));
int main() { return 0; }
