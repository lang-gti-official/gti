// A panic executed by a constexpr binding fails the request with its message.
//@ check-fail
import std.panic;
constexpr int checked_third(int v) {
  if (v % 3 != 0) { std::panic("not a multiple of three"); }  //~ ERROR GTI-S2057 Compile-time evaluation panicked: "not a multiple of three"
  return v / 3;
}
int runtime_only(int v) { return v - 1; }
constexpr int clamp_positive(int v) {
  if (v < 0) { return runtime_only(v); }
  return v;
}
constexpr int checked_half(int v) {
  if (v % 2 != 0) { std::panic("odd {}", v); }
  return v / 2;
}
constexpr int bad = checked_third(10);
int main() { return bad; }
