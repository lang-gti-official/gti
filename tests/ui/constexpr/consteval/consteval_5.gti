// Consteval: runtime checked arguments name the parameter and required constant.
struct Checked {
  int value;
  implicit consteval Checked(int value) : value(value) { int proof = 1 / (value > 0 ? 1 : 0); }
};
int consume(Checked checked, int runtime) { return checked.value + runtime; }
int run(int runtime) { return consume(runtime, 0); }  //~ ERROR GTI-S2057 parameter 'checked' must be a compile-time constant
