// A checked-format panic reports its formatted message and runs cleanup.
//@ run-fail
//@ exit-code: 70
//@ stderr-contains: main.gti:11: runtime error[GTI-R0017]: panic: "value=42"
//@ stdout: cleanup
//@ args: panic
// --- main.gti
import std.panic;
import std.vector;
import std.string;
struct Guard {
  ~Guard() { std::println("cleanup"); }
  Guard() = default;
};
int main(int argc, std::vector<std::string> argv) {
  if (argc == 1) { return 0; }
  Guard guard{};
  std::panic("value={}", 42);
  return 0;  //~ WARN GTI-S2095
}
