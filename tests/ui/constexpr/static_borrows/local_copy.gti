// A constexpr local can copy and observe a user-defined value borrowing static storage.
//@ run-pass
constexpr int value = 17;

struct View<lifetime a> {
  int&<a> value;
  constexpr View(int&<a> value) : value(value) {}
  constexpr int read() { return this.value; }
};

constexpr View<static> original = View<static>(value);

int main() {
  constexpr View<static> copy = original;
  static_assert(copy.read() == 17);
  constexpr View<static> next = copy;
  static_assert(next.value == 17);
  return next.read() - 17;
}
