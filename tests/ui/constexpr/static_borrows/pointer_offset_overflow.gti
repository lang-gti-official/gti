// An offset that overflows an imported static array pointer is rejected during evaluation.
constexpr int data[2] = {2, 17};
constexpr const int* end = unsafe { &data[0] + 2 };

constexpr const int* advanced() {
  unsafe { return end + 9223372036854775807; }  //~ ERROR GTI-S2057 cannot apply this operation
}

constexpr const int* bad = advanced();
