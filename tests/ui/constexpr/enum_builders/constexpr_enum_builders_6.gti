// Constexpr enum builders: enum builders preserve type, lifetime and constant eligibility.
enum class E : uint8_t { low, high }; enum class F : uint8_t { low, high }; constexpr void set(mut E& value) { value = E::high; } E runtime() { return E::low; } constexpr E bad() { mut E value = E::low; set(value); return runtime(); } constexpr E value = bad(); int main() { return 0; }  //~ ERROR GTI-S2057
