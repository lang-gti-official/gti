// Compile time conditionals: the same source under an empty external define set selects 22 (and 7).
//@ run-pass
#define LOCAL
#define LOCAL
#if target.os == "never"
#define LEAKED
#define ALTERNATE
#define EXTERNAL
#endif

#if defined(EXTERNAL) &&
    (target.os != "never" || defined(ALTERNATE))
int selected_value() { return 11; }
#else
int selected_value() { return 22; }
#endif

#undef EXTERNAL
#ifdef EXTERNAL
#error "a source undef did not remove an externally seeded flag"
#endif

#ifdef LEAKED
#error "an inactive definition leaked"
#endif

#undef LOCAL
#ifndef LOCAL
int local_state() { return 7; }
#else
int local_state() { return 9; }
#endif

int main() { return selected_value() + local_state() == 29 ? 0 : 1; }
