// Static assertions: dependent assertions in generic constructors should evaluate during canonical constructor-instance reanalysis.
class Extent {
public:
  Extent<uint64_t N>(int values[N]) {
    static_assert(N <= uint64_t(2), "too many constructor values");  //~ ERROR GTI-S2079
  }
public:
  Extent() = default;
};
int main() {
  Extent value = Extent({1, 2, 3});
  return 0;
}
