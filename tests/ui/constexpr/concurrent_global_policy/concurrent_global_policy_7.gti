namespace std {
[[no_transfer, no_share]] class native_resource {
  int descriptor;
public:
  native_resource(int value) : descriptor(value) {}
};
}
std::native_resource resource = std::native_resource(1);  //~ ERROR GTI-S2060 'resource' to have a share-capable type
