  ~CleanupBase() {}
};
class DerivedCleanup : public CleanupBase {
public:
  DerivedCleanup() : CleanupBase() {}
};
using Wrapped = Wrapper;
Wrapped global_cleanup{};  //~ ERROR GTI-S2061
Wrapped cleanup_array[2] = {Wrapped(), Wrapped()};  //~ ERROR GTI-S2061
DerivedCleanup base_cleanup{};  //~ ERROR GTI-S2061
class Registry {
public:
  static Wrapped static_cleanup{};  //~ ERROR GTI-S2061 Static field 'static_cleanup'
