// Namespace owners admit aliases, arrays, nested fields, bases and class static fields.
class Cleanup {
public:
  Cleanup() {}
  ~Cleanup() {}
};
class Wrapper {
public:
  Cleanup nested = Cleanup();
public:
  Wrapper() = default;
};
class CleanupBase {
public:
  CleanupBase() {}
  ~CleanupBase() {}
};
class DerivedCleanup : public CleanupBase {
public:
  DerivedCleanup() : CleanupBase() {}
};
using Wrapped = Wrapper;
Wrapped global_cleanup{};
Wrapped cleanup_array[2] = {Wrapped(), Wrapped()};
DerivedCleanup base_cleanup{};
class Registry {
public:
  static Wrapped static_cleanup{};
public:
  Registry() = default;
};
int main() { return 0; }
