// Mutable constexpr execution preserves frontend rejection: step limit.
constexpr void add(mut int& value, int amount) { value += amount; }  //~ ERROR GTI-S2057
constexpr int bad() { mut int value = 0; while (value < 5000000) { add(value, 1); } return value; } constexpr int constant = bad();
int main() { return 0; }
