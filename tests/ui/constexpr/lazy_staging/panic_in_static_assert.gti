// A static_assert reports an executed panic with its message and the request note.
//@ snapshot: diagnostics
import std.panic;
constexpr int checked_third(int v) {
  if (v % 3 != 0) { std::panic("not a multiple of three"); }  //~ ERROR GTI-S2057
  return v / 3;
}
static_assert(checked_third(10) == 3);
int main() { return 0; }
