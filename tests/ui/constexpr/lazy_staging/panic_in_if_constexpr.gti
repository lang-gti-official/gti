// An if constexpr condition reports an executed panic with its message and the request note.
//@ snapshot: diagnostics
import std.panic;
constexpr int checked_third(int v) {
  if (v % 3 != 0) { std::panic("not a multiple of three"); }  //~ ERROR GTI-S2057
  return v / 3;
}
int main() {
  if constexpr (checked_third(10) == 3) { return 0; }
  return 1;
}
