// Program-constant operands after a never-returning operand are never lowered.
[[noreturn]] int stop() {
  while (true) {
  }
}
constexpr int LIMIT = 4;
int add(int left, int right) { return left + right; }

int binary() { return stop() + LIMIT; }
int argument() { return add(stop(), LIMIT); }

int main() { return 0; }
