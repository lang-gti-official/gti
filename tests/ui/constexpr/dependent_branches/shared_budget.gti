// Nested semantic predicates and the enclosing MIR call share one work budget; exhaustion is attributed to the executing source with the requesting assertion as a note.
//@ snapshot: diagnostics
constexpr int cost<uint64_t N>() {
  mut int total = 0;
  for (mut int i = 0; i < 20000; i++) { total += 1; }  //~ ERROR GTI-S2057
  return total;
}
constexpr int nested<uint64_t N>() {
  if constexpr (cost<N>() == 20000) {
    if constexpr (cost<N>() == 20000) { return cost<N>(); }
  }
  return 0;
}
static_assert(nested<1>() == 20000);
int main() { return 0; }
