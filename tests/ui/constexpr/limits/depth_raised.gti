// A raised constexpr-depth admits recursion deeper than the 512 default and
// is still a limit. (testConfigurableCompileTimeDepth)
//@ constexpr-depth: 2048
constexpr int32_t descend(int32_t n) {
  if (n == 0) { return 0; }
  return descend(n - 1) + 1;
}
static_assert(descend(2047) == 2047);
static_assert(descend(2048) == 2048);  //~ ERROR GTI-S2057 limit of 2048 nested calls
int main() { return 0; }
