// Constexpr results and constructors retain immutable static reference fields.
//@ run-pass
enum class E { invalid };

constexpr expected<int, E> fail() { return unexpected(E::invalid); }
constexpr expected<int, E> succeed() { return 7; }
constexpr int divide(int denominator) { return 1 / denominator; }
constexpr int seed = 1;

struct P {
  int& x;
  constexpr P(int& value) : x(value) {}
};

constexpr P saved = P(seed);
static_assert(saved.x == 1);
int main() { return saved.x - 1; }
