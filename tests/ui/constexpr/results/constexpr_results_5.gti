// Constexpr results: results and constructors preserve constant eligibility.
enum class E { invalid }; constexpr expected<int, E> fail() { return unexpected(E::invalid); } constexpr expected<int, E> succeed() { return 7; } constexpr int divide(int denominator) { return 1 / denominator; } struct P { int x; constexpr P(mut int& value) : x(value) { value += 1; } }; constexpr P bad = P(3); int main() { return 0; }  //~ ERROR GTI-S2012
