// A conditional payload reference is visible only on the matching path.
enum Period { seconds(int value), minutes(int value) };
int inspect(Period& period) {
  if (case Period::seconds(auto& matched_ticks) = period) {
    return matched_ticks;
  } else {
    return matched_ticks; //~ ERROR GTI-S2001
  }
}
int main() { return 0; }
