// Consuming source members publish owning expected payloads after cleanup.
//@ run-pass
//@ revisions: run1 run2 run3 run4 run5
//@[run1] stdout: 10
//@[run1] stdout: 11
//@[run1] stdout: 20
//@[run1] stdout: 30
//@[run1] stdout: 12
//@[run1] stdout: 90
//@[run2] run-fail
//@[run2] args: callee-fails
