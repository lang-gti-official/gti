// A pending Expected payload remains local until fallible cleanup succeeds.
//@ run-pass
//@ revisions: run1 run2 run3
//@[run1] stdout: 1
//@[run1] stdout: 2
//@[run1] stdout: 4
//@[run1] stdout: 3
//@[run2] run-fail
//@[run2] args: guard-fails
//@[run2] exit-code: 70
//@[run2] stdout: 1
//@[run2] stdout: 2
//@[run2] stdout: 3
//@[run2] stderr-contains: expected_payload_pending_cleanup.gti:20: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[run3] run-fail
//@[run3] args: guard-fails payload-fails
//@[run3] exit-code: 70
//@[run3] stdout: 1
//@[run3] stdout: 2
//@[run3] stdout: 3
//@[run3] stderr-contains: expected_payload_pending_cleanup.gti:10: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0002] at expected_payload_pending_cleanup.gti:20; secondary [GTI-R0002]
// --- expected_payload_pending_cleanup.gti
import std.string;
import std.vector;

class Result {
  int divisor;
public:
  Result(int divisor) : divisor(divisor) { std::println(1); }
  ~Result() {
    std::println(3);
    int value = 1 / this.divisor;
  }
};

class Guard {
  int divisor;
public:
  Guard(int divisor) : divisor(divisor) {}
  ~Guard() {
    std::println(2);
    int value = 2 / this.divisor;
  }
};

expected<Result, std::string> make(Guard guard, int payload_divisor) {
  return Result(payload_divisor);
}

int main(int argc, std::vector<std::string> argv) {
  int guard_divisor = argc == 1 ? 1 : 0;
  int payload_divisor = argc < 3 ? 1 : 0;
  auto result = make(Guard(guard_divisor), payload_divisor);
  std::println(4);
  return 0;
}
