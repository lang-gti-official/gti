//@[run5] stderr-contains: expected_field_failure.gti:27: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0002] at expected_field_failure.gti:42; secondary [GTI-R0002]
//@[run6] run-fail
//@[run6] args: ordinary error cleanup fails first
//@[run6] exit-code: 70
//@[run6] stdout: 20
//@[run6] stdout: 30
//@[run6] stdout: 0
//@[run6] stdout: 40
//@[run6] stdout: 21
//@[run6] stdout: 22
