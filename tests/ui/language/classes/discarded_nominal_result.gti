// Discarded cleanup-free class results preserve calls and failure cleanup, and a branch-only receiver result published into its MIR destination is not mistaken for a discarded one.
//@ run-pass
//@ revisions: default member-failure free-failure
//@[default] stdout: 12
//@[default] stdout: 6
//@[default] stdout: 4
//@[default] stdout: 8
//@[default] stdout: 9
//@[member-failure] run-fail
//@[member-failure] args: member-failure
//@[member-failure] exit-code: 70
//@[member-failure] stdout: 12
//@[member-failure] stdout: 9
//@[member-failure] stderr-contains: discarded_nominal_result.gti:12: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[free-failure] run-fail
//@[free-failure] args: free failure
//@[free-failure] exit-code: 70
//@[free-failure] stdout: 12
//@[free-failure] stdout: 6
//@[free-failure] stdout: 9
//@[free-failure] stderr-contains: discarded_nominal_result.gti:12: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- discarded_nominal_result.gti
import std.string;
import std.vector;

class Option {
  int value;
public:
  Option(int value) : value(value) { std::println(value); }
  Option(Option& other) = default;
  Option(Option&& other) = default;
};

[[discardable]] Option make_option(int divisor) { return Option(12 / divisor); }

class App {
public:
  ~App() { std::println(9); }
  [[discardable]] Option add_flag(int divisor) mut { return make_option(divisor); }
public:
  App() = default;
};

int main(int argc, std::vector<std::string> argv) {
  mut App app{};
  for (mut int index = 0; index < 2; index++) {
    int divisor = argc == 2 && index == 1 ? 0 : index + 1;
    if (index == 0) { [[discard]] app.add_flag(divisor); }
    else { app.add_flag(divisor); }
  }
  make_option(argc == 3 ? 0 : 3);
  std::println(8);
  return 0;
}
