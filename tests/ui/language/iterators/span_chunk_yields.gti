// A read-only operator* may yield a std::span whose region names only the
// cursor's own lifetime parameter: each chunk borrows the vector, not the
// cursor, so it survives ++ and serves range-for, the iterator concepts and a
// generic algorithm.
//@ run-pass
import std.vector;
import std.span;
import std.iterator;

class chunk_end { public: chunk_end() = default; };
class chunk_cursor<lifetime owner> {
  std::span<int, owner> source;
  mut uint64_t first;
public:
  chunk_cursor(std::span<int, owner> source) : source(source), first(0) {}
  chunk_cursor(chunk_cursor<owner>& other) = default;
  std::span<int, owner> operator*() { return this.source.subspan(this.first, uint64_t(2)); }
  void operator++() mut { this.first = this.first + uint64_t(2); }
  bool operator!=(chunk_end end) { return this.first + uint64_t(2) <= this.source.size(); }
  bool operator!=(chunk_cursor<owner>& other) { return this.first != other.first; }
};
class chunks<lifetime owner> {
  std::span<int, owner> source;
public:
  chunks(std::span<int, owner> source) : source(source) {}
  chunk_cursor<owner> begin() { return chunk_cursor(this.source); }
  chunk_end end() { return chunk_end(); }
};

static_assert(std::input_iterator<chunk_cursor<static>>);
static_assert(std::forward_iterator<chunk_cursor<static>>);
static_assert(std::dereferences_to<chunk_cursor<static>, std::span<int>>);

// Generic code keeps each yield across the advance that follows it.
int first_items<I, S>(mut I first, S last) requires std::input_iterator<I> && std::sentinel_for<S, I> {
  mut int total = 0;
  for (; first != last; ++first) {
    auto current = *first;
    total += current[0];
  }
  return total;
}

int main() {
  mut std::vector<int> values{};
  for (mut int i = 1; i <= 6; i++) values.push_back(i);
  mut int by_value = 0;
  mut int by_reference = 0;
  mut int typed = 0;
  for (auto piece : chunks(values.as_span())) by_value += piece[0] + piece[1];
  for (auto& piece : chunks(values.as_span())) by_reference += piece[0] + piece[1];
  for (std::span<int> piece : chunks(values.as_span())) typed += piece[0] + piece[1];
  if (by_value != 21 || by_reference != 21 || typed != 21) return 1;

  // Collect from each yield into a local; the yields borrow `values` only.
  mut std::vector<int> firsts{};
  for (auto piece : chunks(values.as_span())) firsts.push_back(piece[0]);
  mut auto cursor = chunk_cursor(values.as_span());
  auto kept = *cursor;
  ++cursor;
  auto next = *cursor;
  if (firsts[0] != 1 || firsts[1] != 3 || kept[1] != 2 || next[1] != 4) return 2;
  return first_items(chunk_cursor(values.as_span()), chunk_end()) == 9 ? 0 : 3;
}
