// Constructor field placement/replacement preserves success and failure cleanup.
//@ run-pass
//@ revisions: default fail
//@[default] stdout: 12
//@[default] stdout: old
//@[default] stdout: 12
//@[default] stdout: new
//@[default] stdout: done
//@[default] stdout: new
//@[fail] run-fail
//@[fail] args: fail
//@[fail] exit-code: 70
//@[fail] stdout: 12
//@[fail] stdout: old
//@[fail] stdout: new
//@[fail] stderr-contains: constructor_field_call_assignment.gti:13: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- constructor_field_call_assignment.gti
import std.string;
import std.vector;

class Result {
  mut std::string text{};
public:
  Result() {}
  Result(std::string_view value) : text(std::string(value)) {}
  ~Result() { std::println(text); }
};

Result parse(int divisor) {
  std::println(12 / divisor);
  return Result("new");
}

class Holder {
  mut Result result{ "old" };
public:
  Holder(int divisor) {
    result = parse(1);
    this.result = parse(divisor);
    std::println("done");
  }
public:
  Holder() = default;
};

int main(int argc, std::vector<std::string> argv) {
  Holder holder{2 - argc};
  return 0;
}
