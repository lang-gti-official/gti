// Constructor field placement/replacement preserves success and failure cleanup.
//@ run-pass
//@ revisions: default fail
//@[default] stdout: 12
//@[default] stdout: 2
//@[default] stdout: 1
//@[default] stdout: 9
//@[fail] run-fail
//@[fail] args: fail
//@[fail] exit-code: 70
//@[fail] stdout: 1
//@[fail] stdout: 9
//@[fail] stderr-contains: expected_constructor_payload.gti:20: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- expected_constructor_payload.gti
import std.optional;
import std.string;
import std.vector;

class Marker {
  int identity;
public:
  Marker(int value) : identity(value) {}
  ~Marker() { std::println(this.identity); }
};

class Payload {
  Marker first;
  std::optional<std::string> text;
  int number;
public:
  Payload(int divisor)
      : first(Marker(1)),
        text(std::optional<std::string>(std::string("payload"))),
        number(12 / divisor) {}
  ~Payload() { std::println(2); }
  int value() { return this.number; }
};

int main(int argc, std::vector<std::string> argv) {
  Marker caller{9};
  expected<Payload, int> result = Payload(2 - argc);
  std::println(result.value().value());
  return 0;
}
