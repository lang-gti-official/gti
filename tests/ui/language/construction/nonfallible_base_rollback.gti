// Base rollback carries a secondary record only for fallible cleanup.
//@ run-pass
//@ revisions: default field-fails
//@[default] stdout: 30
//@[default] stdout: 40
//@[default] stdout: 20
//@[default] stdout: 90
//@[field-fails] run-fail
//@[field-fails] args: field-fails
//@[field-fails] exit-code: 70
//@[field-fails] stdout: 30
//@[field-fails] stdout: 90
//@[field-fails] stderr-contains: nonfallible_base_rollback.gti:9: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- nonfallible_base_rollback.gti
import std.memory;
import std.vector;
import std.string;

mut int stage = 0;
int Read() {
  std::println(30);
  int divisor = stage == 1 ? 0 : 1;
  return 7 / divisor;
}
class Base {
public:
  Base() = default;
  ~Base() {}
  virtual int Value() = 0;
};
class Derived : public Base {
  int value = Read();
public:
  Derived() = default;
  ~Derived() { std::println(20); }
  int Value() override { return this.value; }
};
class Outer {
public:
  Outer() = default;
  ~Outer() { std::println(90); }
};
int main(int argc, std::vector<std::string> argv) {
  stage = argc - 1;
  Outer outer{};
  auto value = std::make_unique<Derived>();
  std::println(40);
  return value->Value() - 7;
}
