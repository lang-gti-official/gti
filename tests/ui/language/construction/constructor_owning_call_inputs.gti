//@[run2] args: argument
//@[run2] exit-code: 70
//@[run2] stdout: second
//@[run2] stdout: first
//@[run2] stdout: guard
//@[run2] stderr-contains: constructor_owning_call_inputs.gti:25: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[run3] run-fail
//@[run3] args: inside call
//@[run3] exit-code: 70
//@[run3] stdout: second
//@[run3] stdout: first
//@[run3] stdout: guard
//@[run3] stderr-contains: constructor_owning_call_inputs.gti:14: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[run4] run-fail
//@[run4] args: later field fails
//@[run4] exit-code: 70
//@[run4] stdout: 1
//@[run4] stdout: second
//@[run4] stdout: second
//@[run4] stdout: first
//@[run4] stdout: guard
