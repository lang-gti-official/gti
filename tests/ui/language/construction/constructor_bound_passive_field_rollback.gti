// Cleanup-free class fields retain exact constructor rollback semantics.
//@ run-pass
//@ revisions: default fail
//@[default] stdout: 49
//@[default] stdout: 20
//@[fail] run-fail
//@[fail] args: fail
//@[fail] exit-code: 70
//@[fail] stderr-contains: constructor_bound_passive_field_rollback.gti:14: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- constructor_bound_passive_field_rollback.gti
import std.string;
import std.vector;

struct Resource { int value = 42;  public: Resource() = default; };
struct View {
  Resource& resource;
  View(Resource& resource) : resource(resource) {}
};
class Holder {
  View view;
  int marker = 7;
public:
  Holder(View view, int divisor) : view(view) {
    int checked = 1 / divisor;
  }
  int read() { return this.view.resource.value + this.marker; }
  ~Holder() { std::println(20); }
};
int main(int argc, std::vector<std::string> argv) {
  Resource resource{};
  View view{resource};
  Holder holder{view, argc == 1 ? 1 : 0};
  std::println(holder.read());
  return 0;
}
