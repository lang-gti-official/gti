// Private construction keeps source access and exact failure publication.
//@ run-pass
//@ revisions: default direct-fails named-fails
//@[default] stdout: 1
//@[default] stdout: 6
//@[default] stdout: 2
//@[default] stdout: 1
//@[default] stdout: 6
//@[default] stdout: 2
//@[default] stdout: 9
//@[direct-fails] run-fail
//@[direct-fails] args: direct-fails
//@[direct-fails] exit-code: 70
//@[direct-fails] stdout: 1
//@[direct-fails] stdout: 9
//@[direct-fails] stderr-contains: private_constructor_placement.gti:8: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[named-fails] run-fail
//@[named-fails] args: named fails
//@[named-fails] exit-code: 70
//@[named-fails] stdout: 1
//@[named-fails] stdout: 6
//@[named-fails] stdout: 2
//@[named-fails] stdout: 1
//@[named-fails] stdout: 9
//@[named-fails] stderr-contains: private_constructor_placement.gti:8: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- private_constructor_placement.gti
import std.string;
import std.vector;

class Secret {
  std::string label;
  Secret(int divisor, std::string label) : label(std::move(label)) {
    std::println(1);
    int checked = 12 / divisor;
  }
public:
  ~Secret() { std::println(2); }
  static Secret direct(int divisor) {
    return Secret(divisor, std::string("secret"));
  }
  static Secret named(int divisor) {
    Secret result = Secret(divisor, std::string("secret"));
    return std::move(result);
  }
  std::size_t size() { return this.label.size(); }
};

class Guard {
public:
  ~Guard() { std::println(9); }
public:
  Guard() = default;
};

int main(int argc, std::vector<std::string> argv) {
  Guard guard{};
  {
    auto direct = Secret::direct(argc == 2 ? 0 : 1);
    std::println(direct.size());
  }
  {
    auto named = Secret::named(argc == 3 ? 0 : 1);
    std::println(named.size());
  }
  return 0;
}
