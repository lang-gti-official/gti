// Prepared fresh owning closures survive later-argument failure exactly once.
//@ run-pass
//@ revisions: default fail
//@[default] stdout: 7
//@[default] stdout: 9
//@[fail] run-fail
//@[fail] args: fail
//@[fail] exit-code: 70
//@[fail] stdout: 7
//@[fail] stdout: 9
//@[fail] stderr-contains: fresh_callable_borrow_later_argument_failure.gti:23: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- fresh_callable_borrow_later_argument_failure.gti
import std.string;
import std.vector;

class Resource {
  int identity;
public:
  Resource(int identity) : identity(identity) {}
  ~Resource() { std::println(this.identity); }
  int read() { return this.identity; }
};

int observe<F>(F& callback, int value) {
  int result = callback();
  return result;
}

int main(int argc, std::vector<std::string> argv) {
  Resource caller{9};
  Resource capture{7};
  int divisor = argc == 2 ? 0 : 1;
  return observe([capture = std::move(capture)]() -> int {
    return capture.read();
  }, 12 / divisor) - 7;
}
