// Fixed-array elements and class static owners use reverse construction order.
//@ run-pass
//@ stdout: 3
//@ stdout: 2
//@ stdout: 1
class Marker {
  int value;
public:
  Marker(int value) : value(value) {}
  ~Marker() { std::println(value); }
};
Marker roots[2] = {Marker(1), Marker(2)};
class Registry {
public:
  static Marker last{3};
  Registry() = default;
};
int main() { return 0; }
