// A global destructor's secondary failure abandons its remaining subobjects.
//@ run-fail
//@ exit-code: 70
//@ stdout: 2
//@ stderr-contains: failure_during_cleanup
class Field {
public:
  Field() {}
  ~Field() { std::println(99); }
};
class Owner {
  Field member;
  int divisor;
public:
  Owner(int divisor) : member(), divisor(divisor) {}
  ~Owner() {
    std::println(2);
    int checked = 12 / divisor;
    if (checked == 99) { std::println(99); }
  }
};
Owner global{0};
int main() {
  mut int zero = 0;
  return 1 / zero;
}
