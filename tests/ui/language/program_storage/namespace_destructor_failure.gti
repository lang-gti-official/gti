// The first shutdown failure still cleans earlier global owners.
//@ run-fail
//@ exit-code: 70
//@ stdout: 2
//@ stdout: 1
//@ stderr-contains: division_by_zero
class Marker {
  int value;
  int divisor;
public:
  Marker(int value, int divisor) : value(value), divisor(divisor) {}
  ~Marker() {
    std::println(value);
    int checked = 12 / divisor;
    if (checked == 99) { std::println(99); }
  }
};
Marker first{1, 1};
Marker second{2, 0};
int main() { return 0; }
