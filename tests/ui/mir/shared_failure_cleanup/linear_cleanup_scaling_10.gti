// Linear cleanup scaling: early returns: scaling fixture lowers.
//@ check-pass
mut int32_t zero = 0;
class Owner {
  int32_t divisor;
public:
  Owner(int32_t divisor) : divisor(10 / divisor) {}
  ~Owner() { int32_t checked = 10 / this.divisor; }
};
void step(int32_t at) {
  if (at == zero) {
    int32_t failure = 1 / zero;
  }
}
int32_t run(int32_t divisor) {
  Owner owner1 = Owner(divisor);
  step(1);
  if (divisor == 10) { return 1; }
  Owner owner2 = Owner(divisor);
  step(2);
  if (divisor == 20) { return 2; }
  Owner owner3 = Owner(divisor);
  step(3);
  if (divisor == 30) { return 3; }
