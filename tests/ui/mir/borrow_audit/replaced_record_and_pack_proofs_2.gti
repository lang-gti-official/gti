// Replaced record and pack proofs: passing a replaced record's referent to a helper uses its current owner rather than retaining the previous value's dependency.
//@ check-pass
int read_reference(int& value) { return value; }

class ReadCarrier {
public:
  int& referent;
  ReadCarrier(int& source) : referent(source) {}
};
int use() {
  mut int first_owner = 1;
  mut int second_owner = 2;  //~ WARN GTI-S2096
  mut ReadCarrier left = ReadCarrier(first_owner);
  ReadCarrier right = ReadCarrier(second_owner);
  left = right;
  first_owner = 3;
  return read_reference(left.referent) - 2;
}
