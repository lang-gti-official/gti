// Program initialization plans: stored-reference construction must force its later constexpr argument to remain a storage access.
class RefBox {
  int32_t& value;
public:
  RefBox(int32_t& source) : value(source) {}
};
class Globals {
public:
  static int32_t make_box() {
    RefBox box = RefBox(Globals::later);
    return 1;
  }
  static mut int32_t first = Globals::make_box();  //~ ERROR GTI-S2068
  static constexpr int32_t later = 4;
public:
  Globals() = default;
};
int main() { return Globals::first; }
