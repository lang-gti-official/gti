// Program initialization plans: a bare constexpr passed through an exact reference parameter must remain a storage access rather than constant substitution.
class Globals {
public:
  static int32_t inspect(int32_t& value) { return value; }
  static mut int32_t first = Globals::inspect(Globals::later);  //~ ERROR GTI-S2068
  static constexpr int32_t later = -3;
public:
  Globals() = default;
};
int main() { return Globals::first; }
