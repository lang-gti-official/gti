// CHECK: end-borrow {{.*}} loan=2
// CHECK: activate-borrow {{.*}} loan=1
// CHECK-NEXT: assign
// CHECK-NEXT: end-borrow {{.*}} loan=1
import std.vector;
int main() {
  mut std::vector<int32_t> values = std::vector<int32_t>();
  values.push_back(3);
  values[std::size_t(0)] = values[std::size_t(0)] + 2;
  return 0;
}
