// Function contracts: the function-contract diagnostic rejects terminal operator.
[[noreturn]] void stop() { while (true) {} }
[[noreturn]] int stop_number() { while (true) {} }
[[noreturn]] bool stop_test() { while (true) {} }
int identity(int value) { return value; }
struct Action { [[noreturn]] void operator()() { stop(); }  public: Action() = default; };  //~ ERROR GTI-S2099
int main() { return 0; }
