// Function contracts: the function-contract diagnostic rejects unselected branch.
[[noreturn]] void stop() { while (true) {} }
[[noreturn]] int stop_number() { while (true) {} }
[[noreturn]] bool stop_test() { while (true) {} }
int identity(int value) { return value; }
[[noreturn]] int run(bool value) { return value ? 1 : stop_number(); }  //~ ERROR GTI-S2099
int main() { return 0; }
