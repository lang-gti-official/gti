// Function contracts: the function-contract diagnostic rejects virtual.
[[noreturn]] void stop() { while (true) {} }
[[noreturn]] int stop_number() { while (true) {} }
[[noreturn]] bool stop_test() { while (true) {} }
int identity(int value) { return value; }
class Guard { public: [[track_caller]] virtual void check() {}  public: Guard() = default; };  //~ ERROR GTI-S2099
int main() { return 0; }
