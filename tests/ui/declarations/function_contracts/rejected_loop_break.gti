// Function contracts: the function-contract diagnostic rejects loop break.
[[noreturn]] void stop() { while (true) {} }
[[noreturn]] int stop_number() { while (true) {} }
[[noreturn]] bool stop_test() { while (true) {} }
int identity(int value) { return value; }
[[noreturn]] void run() { while (true) { break; } }  //~ ERROR GTI-S2099
int main() { return 0; }
