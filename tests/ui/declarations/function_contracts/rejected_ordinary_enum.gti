// Function contracts: the function-contract diagnostic rejects ordinary enum.
[[noreturn]] void stop() { while (true) {} }
[[noreturn]] int stop_number() { while (true) {} }
[[noreturn]] bool stop_test() { while (true) {} }
int identity(int value) { return value; }
enum class State { first, second }; [[noreturn]] void run(State value) { switch (value) { case State::first: stop(); case State::second: stop(); } }  //~ ERROR GTI-S2099
int main() { return 0; }
