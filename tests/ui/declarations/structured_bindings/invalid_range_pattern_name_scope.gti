// Structured bindings: pattern names end with the iteration.
struct Item { mut int first; int second; Item(int a, int b) : first(a), second(b) {} };
int main() { mut Item items[1] = {Item(1, 2)}; for (auto& [pattern_first, pattern_second] : items) {} return pattern_first; return 0; }  //~ ERROR GTI-S2001 //~ WARN GTI-S2095
