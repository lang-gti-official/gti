// Structured bindings: owner mutation cannot invalidate a projected borrow.
struct Item { mut int first; int second; Item(int a, int b) : first(a), second(b) {} };
int main() { mut Item items[1] = {Item(1, 2)}; for (auto& [a, b] : items) { items[0].first = 7; int copy = a; } return 0; }  //~ ERROR GTI-S2017
