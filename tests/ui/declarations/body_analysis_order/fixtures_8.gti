// Fixtures: demanded callee diagnostics follow the caller's.
import std.iterator;
import std.list;

int main() {
  std::list<int> priorities = {2, 4, 4, 9};
  int urgent = 9;
  auto found = my_find(priorities.begin(), priorities.end(), urgent);
  return found != priorities.end() ? 0 : missing_in_caller;  //~ ERROR GTI-S2001
}

Iterator my_find<Iterator, Sentinel, T>(mut Iterator first, Sentinel last,
                                        T& value)
  requires std::input_iterator<Iterator> &&
           std::sentinel_for<Sentinel, Iterator> &&
           std::dereferences_to<Iterator, T> &&
           std::equality_comparable<T> {
  while (first != last) {
    if (*first == value) {
      break;
    }
    ++first;
  }
  int oops = missing_in_callee;  //~ ERROR GTI-S2001
  return std::move(first);
}
