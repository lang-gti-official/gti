// A mutable reference pack cannot bind an immutable object.
//@ check-fail
//@ execution-profile: concurrent
class Ticket {
public:
  Ticket() = default;
  Ticket(Ticket& other) = delete;
  Ticket(Ticket&& other) = default;
};
void touch<Args...>(mut Args&... args) {}
int main() { Ticket value{}; touch(value); return 0; }  //~ ERROR GTI-S2017
