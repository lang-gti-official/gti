// S: returning a closure does not permit forcing one move capture twice.
import std.memory;
#macro F repeated<F>(F expression) { F first = expression; return expression; }
int main() {
  auto owner = std::make_unique<int>(7);
  auto callback = repeated!([owned = std::move(owner)]() -> int { return *owned; });  //~ ERROR GTI-S2018
  return 0;
}
