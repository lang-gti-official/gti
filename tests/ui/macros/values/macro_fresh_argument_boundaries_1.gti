// Macro fresh argument boundaries: invalid result macro must stop before emission.
struct Value { int number; Value(int number) : number(number) {} };
#macro Value fresh(int number) { Value guard{99}; return Value(number); }

int change(mut Value& value) { value.number = 3; return value.number; }  //~ ERROR GTI-S2000
int main() { return change(fresh!(1)); }  //~ ERROR GTI-S2017
