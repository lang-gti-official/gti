// Semantics: ordinary braced calls keep configuration directive behavior.
//@ check-pass
// --- main.gti
import std.array; int main(){ auto values = std::array<int, 2>({
#define ORDINARY_FLAG
1,2});
#ifdef ORDINARY_FLAG
return values[0] - 1;
#else
#error "flag lost"
#endif
}
// --- library.gti
export module library; import std.syntax; export #macro(proc) std::syntax::expr html(std::syntax::tokens input) { return std::syntax::parse(std::syntax::literal("42", std::syntax::location(input, uint64_t(0), uint64_t(1)))); }
