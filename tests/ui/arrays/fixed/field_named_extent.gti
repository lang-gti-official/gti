// A field extent resolved from an earlier constant has the same exact
// type in method bodies, external projections and generic instances.
//@ run-pass
namespace storage {
constexpr int32_t ROWS = 2;
constexpr int32_t COLS = 3;
struct Grid<T> {
public:
  Grid() {}
  T read(int32_t row, int32_t column) {
    // Member lookup uses the declaration's extent even in a shadowing scope.
    int32_t COLS = 1;
    return this.cells[row][column + COLS - 1];
  }
  mut T cells[ROWS][COLS + 1] = {};
  void set(int32_t row, int32_t column, T value) mut {
    this.cells[row][column] = value;
  }
};
}
int32_t main() {
  mut storage::Grid<int32_t> numbers{};
  numbers.set(1,3,42);
  if (numbers.read(1,3) != 42 or numbers.cells[1][3] != 42) return 1;
  mut storage::Grid<bool> flags{};
  flags.cells[0][2] = true;
  return flags.read(0,2) ? 0 : 2;
}
