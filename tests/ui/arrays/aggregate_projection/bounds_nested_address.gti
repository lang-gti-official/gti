// An out-of-bounds fixed-array index (nested address) fails before the access and drops the guard.
//@ run-fail
//@ exit-code: 70
//@ stdout: guard dropped
//@ stderr-contains: index_out_of_bounds
class Guard{
public:Guard(){}~Guard(){std::println("guard dropped");}};
struct Frame{mut int slots[2][2]={{1,2},{3,4}};
Frame() = default;};
int outside(){return 2;}int main() {
  Guard guard{};
mut Frame frame{};
Frame* pointer=&frame;unsafe{int* element=&pointer->slots[outside()][0];return *element;}}
