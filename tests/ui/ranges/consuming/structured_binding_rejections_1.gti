// Range-for structured bindings reject copies of move-only elements, partial moves, owner invalidation, immutable writes, aliasing and wrong arity.
//@ check-fail
import std.string;
import std.utility;
import std.vector;

namespace case_implicit_copy {
struct Entry {
  mut std::string key;
  mut int value;
  Entry(std::string key, int value) : key(std::move(key)), value(value) {}
};
struct Frozen { int a; int b; Frozen():a(1),b(2){} };
int entry() {
  mut std::vector<Entry> entries{};
  entries.emplace_back(std::string("key"), 1);
for (auto [key, value] : entries) {} return 0; }  //~ ERROR GTI-S2003
}

namespace case_partial_move {
struct Entry {
  mut std::string key;
  mut int value;
  Entry(std::string key, int value) : key(std::move(key)), value(value) {}
};
struct Frozen { int a; int b; Frozen():a(1),b(2){} };
int entry() {
  mut std::vector<Entry> entries{};
  entries.emplace_back(std::string("key"), 1);
for (auto& [key, value] : entries) { auto moved = std::move(key); } return 0; }  //~ ERROR GTI-S2018
}

namespace case_immutable_field {
struct Entry {
  mut std::string key;
  mut int value;
  Entry(std::string key, int value) : key(std::move(key)), value(value) {}
};
struct Frozen { int a; int b; Frozen():a(1),b(2){} };
int entry() {
  mut std::vector<Entry> entries{};
  entries.emplace_back(std::string("key"), 1);
mut Frozen frozen[1] = {Frozen()}; for (mut auto& [a, b] : frozen) {} return 0; }  //~ ERROR GTI-S2017 //~ ERROR GTI-S2017
}

namespace case_immutable_owner {
struct Entry {
  mut std::string key;
  mut int value;
  Entry(std::string key, int value) : key(std::move(key)), value(value) {}
};
struct Frozen { int a; int b; Frozen():a(1),b(2){} };
int entry() {
  mut std::vector<Entry> entries{};
  entries.emplace_back(std::string("key"), 1);
auto& readonly = entries; for (mut auto& [key, value] : readonly) { value += 1; } return 0; }  //~ ERROR GTI-S2017 //~ ERROR GTI-S2083
}

namespace case_wrong_arity {
struct Entry {
  mut std::string key;
  mut int value;
  Entry(std::string key, int value) : key(std::move(key)), value(value) {}
};
struct Frozen { int a; int b; Frozen():a(1),b(2){} };
int entry() {
  mut std::vector<Entry> entries{};
  entries.emplace_back(std::string("key"), 1);
for (auto& [key] : entries) {} return 0; }  //~ ERROR GTI-S2048
}

int main() { return 0; }
