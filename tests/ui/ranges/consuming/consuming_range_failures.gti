// Consuming ranges keep exact cleanup when the body, an element destructor, the condition or the producer fails.
//@ run-pass
//@ revisions: ok body element_drop remaining_first remaining_double has_next take_next
//@[ok] stdout: 1
//@[ok] stdout: 3
//@[ok] stdout: 2
//@[body] args: body
//@[body] stdout: 1
//@[body] stdout: 3
//@[body] stdout: 2
//@[body] run-fail
//@[body] exit-code: 70
//@[body] stderr-contains: consuming_range_failures.gti:69: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[element_drop] args: element drop
//@[element_drop] stdout: 1
//@[element_drop] stdout: 3
//@[element_drop] stdout: 2
//@[element_drop] run-fail
//@[element_drop] exit-code: 70
//@[element_drop] stderr-contains: consuming_range_failures.gti:29: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[remaining_first] args: remaining first failure
//@[remaining_first] stdout: 1
//@[remaining_first] stdout: 3
//@[remaining_first] stdout: 2
//@[remaining_first] run-fail
//@[remaining_first] exit-code: 70
//@[remaining_first] stderr-contains: consuming_range_failures.gti:29: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[remaining_double] args: remaining double drop failure
//@[remaining_double] stdout: 1
//@[remaining_double] stdout: 3
//@[remaining_double] stdout: 2
//@[remaining_double] run-fail
//@[remaining_double] exit-code: 70
//@[remaining_double] stderr-contains: consuming_range_failures.gti:29: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0002] at consuming_range_failures.gti:29; secondary [GTI-R0002]
//@[has_next] args: has next fails after one
//@[has_next] stdout: 1
//@[has_next] stdout: 90
//@[has_next] run-fail
//@[has_next] exit-code: 70
//@[has_next] stderr-contains: consuming_range_failures.gti:40: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[take_next] args: take next fails after temporary creation
//@[take_next] stdout: 1
//@[take_next] stdout: 2
//@[take_next] stdout: 90
//@[take_next] run-fail
//@[take_next] exit-code: 70
//@[take_next] stderr-contains: consuming_range_failures.gti:48: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- consuming_range_failures.gti
import std.vector;
import std.string;
import std.panic;

extern "C" {
  void provider_test_mode(int32_t mode);
  int32_t provider_test_calls();
  int32_t provider_test_releases();
}
class CheckAllocations {
public:
  CheckAllocations() { provider_test_mode(0); }
  ~CheckAllocations() {
    if (provider_test_calls() != provider_test_releases()) {
      std::panic("consuming range leaked an allocation");
    }
  }
};

class Mark {
  int id;
  bool fail;
public:
  Mark(int id, bool fail = false) : id(id), fail(fail) {}
  Mark(Mark& other) = delete;
  Mark(Mark&& other) = default;
  ~Mark() {
    std::println(this.id);
    if (this.fail) { int zero = 0; int checked = 1 / zero; } // destructor failure
  }
};

class Source {
  mut int position = 0;
  int mode;
public:
  Source(int mode) : mode(mode) {}
  bool has_next() {
    if (this.position == 1 && this.mode == 6) {
      int zero = 0; int checked = 1 / zero; // condition failure
    }
    return this.position < 3;
  }
  Mark take_next() mut {
    this.position++;
    Mark result{this.position};
    if (this.position == 2 && this.mode == 7) {
      int zero = 0; int checked = 1 / zero; // producer failure
    }
    return std::move(result);
  }
  ~Source() { std::println(90); }
};

int main(int argc, std::vector<std::string> argv) {
  // This outer guard runs after normal and first-failure range cleanup.
  // A second failure terminates under the language's ordinary emergency rule.
  CheckAllocations allocations{};
  if (argc >= 6) {
    for (auto value : Source(argc)) {}
    return 0;
  }
  mut std::vector<Mark> values{};
  values.emplace_back(1, argc == 3);
  values.emplace_back(2, argc == 5);
  values.emplace_back(3, argc >= 4);
  for (auto value : std::move(values).into_range()) {
    if (argc == 2) {
      int zero = 0; int checked = 1 / zero; // body failure
    }
    break;
  }
  return 0;
}
// --- process_resource_policy_native.cpp
#include <array>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdlib>
#include <limits>
#if defined(_WIN32)
#include <malloc.h>
#endif

namespace {
int mode = 0;
int calls = 0;
int ordinary_calls = 0;
int releases = 0;
int size_queries = 0;
int fail_on_call = 0;
bool observing = false;
struct Region {
  void *address = nullptr;
  int identity = 0;
};
std::array<Region, 256> regions{};
std::array<int, 64> events{};
std::array<std::uint64_t, 16> requested_bytes{};
int event_count = 0;

void remember(void *address) {
  if (!address)
    return;
  for (auto &region : regions) {
    if (!region.address) {
      // Source-defined argv containers use this same process provider before
      // main begins. Retain their descriptors for exact release checking, but
      // do not attribute them to the scenario's allocation/event counters.
      region = {address, observing ? calls : 0};
      return;
    }
  }
  std::abort();
}

void event(int value) {
  if (event_count == static_cast<int>(events.size()))
    std::abort();
  events[event_count++] = value;
}

void retire(void *address) {
  for (auto &region : regions) {
    if (region.address && region.address == address) {
      if (region.identity != 0) {
        event(-region.identity);
        ++releases;
      }
      region = {};
      return;
    }
  }
  std::abort(); // Wrong provider, empty or duplicate release.
}
} // namespace

extern "C" void provider_test_mode(std::int32_t selected) {
  for (const auto &region : regions)
    if (region.address && region.identity != 0)
      std::abort(); // A reset must not hide leaked regions.
  observing = true;
  mode = selected;
  calls = 0;
  ordinary_calls = 0;
  releases = 0;
  size_queries = 0;
  fail_on_call = 0;
  event_count = 0;
}
extern "C" std::int32_t provider_test_ordinary_calls() {
  return ordinary_calls;
}
extern "C" std::int32_t provider_test_calls() { return calls; }
extern "C" std::int32_t provider_test_releases() { return releases; }
extern "C" std::int32_t provider_test_size_queries() { return size_queries; }
extern "C" std::uint64_t provider_test_bytes(std::int32_t attempt) {
  if (attempt < 1 || attempt > calls ||
      attempt > static_cast<int>(requested_bytes.size()))
    std::abort();
  return requested_bytes[attempt - 1];
}
extern "C" void provider_test_fail_on_call(std::int32_t selected) {
  fail_on_call = selected;
}
extern "C" void provider_test_event(std::int32_t value) { event(value); }
extern "C" std::int32_t provider_test_events() { return event_count; }
extern "C" std::int32_t provider_test_event_at(std::int32_t index) {
  if (index < 0 || index >= event_count)
    std::abort();
  return events[index];
}
#if defined(GTI_TEST_PROCESS_OWNERS)
extern "C" std::int32_t provider_test_process_owners() {
  return GTI_TEST_PROCESS_OWNERS;
}
extern "C" void provider_test_observe_storage(const void *address) {
  if (!address)
    std::abort();
}
#endif
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  if (observing)
    ++size_queries;
  // Scenario selection precedes allocation; the target limit remains stable
  // throughout each allocation transaction, including both sparse regions.
  return mode == 1 ? 4095 : (std::numeric_limits<std::size_t>::max)();
}
// Keep the observation seam in this injected adapter set too: pulling the
// production memory object from the runtime archive would also pull its
// allocation definitions and conflict with this fixture's injected provider.
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t bytes,
                                          std::uint64_t alignment) {
  if (observing) {
    ++calls;
    requested_bytes.at(calls - 1) = bytes;
  }
  if (mode >= 2 || (observing && fail_on_call > 0 && calls == fail_on_call))
    return nullptr;
  if (bytes == 0 || alignment == 0 || (alignment & (alignment - 1)) != 0)
    std::abort();
  void *address = _aligned_malloc(static_cast<std::size_t>(bytes),
                                  static_cast<std::size_t>(alignment));
  remember(address);
  return address;
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  retire(address);
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  if (observing) {
    ++calls;
    ++ordinary_calls;
    requested_bytes.at(calls - 1) = bytes;
  }
  if (mode >= 2 || (observing && fail_on_call > 0 && calls == fail_on_call))
    return nullptr;
  if (bytes == 0)
    std::abort();
  void *address = std::malloc(static_cast<std::size_t>(bytes));
  remember(address);
  return address;
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t bytes,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  if (observing) {
    ++calls;
    requested_bytes.at(calls - 1) = bytes;
  }
  if (observing && fail_on_call > 0 && calls == fail_on_call) {
    *status = ENOMEM;
    return nullptr;
  }
  if (mode >= 2) {
    *status = mode == 2 ? ENOMEM : mode == 3 ? EINVAL : mode == 4 ? -123 : 0;
    return nullptr;
  }
  if (bytes == 0 || alignment < sizeof(void *) ||
      alignment % sizeof(void *) != 0 || (alignment & (alignment - 1)) != 0) {
    std::abort(); // Source policy must normalize before invoking this adapter.
  }
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(bytes));
  remember(address);
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) {
  retire(address);
  std::free(address);
}
#endif
extern "C" std::int32_t provider_test_region(void *address, std::uint64_t bytes,
                                             std::uint64_t alignment) {
  if (!address || reinterpret_cast<std::uintptr_t>(address) % alignment != 0)
    return 1;
  auto *data = static_cast<unsigned char *>(address);
  for (std::uint64_t index = 0; index < bytes; ++index)
    data[index] = static_cast<unsigned char>(index);
  for (std::uint64_t index = 0; index < bytes; ++index)
    if (data[index] != static_cast<unsigned char>(index))
      return 2;
  return 0;
}
