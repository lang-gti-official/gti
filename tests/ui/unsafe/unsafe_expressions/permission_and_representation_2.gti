// Permission and representation: formatting preserves unsafe expression meaning.
//@ check-pass
unsafe T identity<T>(T value) {
  return value;
}
T permitted<T>(T value) {
  return unsafe {
    identity(value)
  };
}
unsafe int read(const int* p) {
  return unsafe {
    *p
  };
}
struct Item {
  int value;
  unsafe Item(int n) : value(n) {}
};
int add(int a, int b) {
  return a + b;
}
int main() {
  int n = 20;
  auto item = unsafe {
    Item(read(&n))
  };
  auto result = add(unsafe {  //~ WARN GTI-S2100
    permitted(item.value)
  }, unsafe {
    read(&n)
  }
  );
  return result == 40 ? 0 : 1;
}
