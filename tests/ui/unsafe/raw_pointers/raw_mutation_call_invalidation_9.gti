// Raw mutation call invalidation: direct assertion is lifetime-inert independent of declaration order.
//@ check-pass
//@ raw-pointer-audit: strict
struct Owner { mut int value = 1;  public: Owner() = default; };
int main() {
  mut Owner owner{};
  int* address = &owner.value;
  unsafe {
    { mut int& value = borrow(address, owner); value = 2; }
    return *address;
  }
}
unsafe mut int&<a> borrow<lifetime a>(int* address, mut Owner&<a> owner) {
  unsafe { { return *((address)); } }
}
