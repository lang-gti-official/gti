// Projected raw pointer origins: writes through raw aliases must retain checked-loan conflicts.
//@ raw-pointer-audit: strict
struct Address { mut int* pointer = nullptr;  public: Address() = default; };
int main() {
  mut int value = 7;
  mut Address address{};
  Address* alias = &address;
  unsafe {
    alias->pointer = &value;
    int& checked = value;
    *address.pointer = 9;  //~ ERROR GTI-S2102
    return checked;
  }
}
