// Raw access: rejected with GTI-S2102.
//@ raw-pointer-audit: strict
struct Address {
  mut const int* pointer = nullptr;
  int read() { unsafe { return *this.pointer; } }
public:
  Address() = default;
};
int main() {
  mut Address address{};
  { int dead = 7; address.pointer = &dead; }
  return address.read();  //~ ERROR GTI-S2102
}
