// Raw access: rejected with GTI-S2102.
//@ raw-pointer-audit: strict
struct Address {
  mut const int* pointer = nullptr;
  void operator+=(int ignored) mut {
    int dead = 7;
    this.pointer = &dead;
  }
public:
  Address() = default;
};
int main() {
  mut Address address{};
  address += 0;
  unsafe { return *address.pointer; }  //~ ERROR GTI-S2102
}
