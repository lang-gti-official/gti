// Raw access: rejected with GTI-S2102.
//@ raw-pointer-audit: strict
int main() {
  mut int owner = 7;
  const int* pointer = &owner;
  auto read = [pointer]() -> int { unsafe { return *pointer; } };
  mut int& held = owner;
  int observed = read();  //~ ERROR GTI-S2102
  held = 8;
  return observed + held;
}
