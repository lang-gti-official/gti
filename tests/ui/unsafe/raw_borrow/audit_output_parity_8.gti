// Audit output parity: generic and public borrowed-from witnesses is valid in both audit modes.
//@ check-pass
//@ raw-pointer-audit: warn
import std.memory;
unsafe T&<a> observe<T, lifetime a>(const T* address, T&<a> owner) {
  unsafe { return *address; }
}
int main() {
  int owner = 7;
  const int* address = &owner;
  unsafe {
    int& first = observe<int>(address, owner);
    int& second = std::assume_ref(address, owner);
    return first + second - 14;
  }
}
