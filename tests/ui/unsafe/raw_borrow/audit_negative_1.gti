// Audit negative: receiver raw assertion cannot conceal an unrelated field origin.
//@ raw-pointer-audit: strict
struct Reading {
  mut const int* address = nullptr;
  int&<this> read() { unsafe { return *this.address; } }
public:
  Reading() = default;
};
int main() {
  int unrelated = 42;
  mut Reading owner{};
  owner.address = &unrelated;
  return owner.read();  //~ ERROR GTI-S2101
}
