// Tagged raw origins: tagged and inherited raw fields preserve callee expiry.
//@ raw-pointer-audit: strict
import std.memory;
struct Address { const int* pointer = nullptr;  public: Address() = default; };
expected<Address, int> dangling() { int dead = 7; Address result{.pointer = &dead}; return result; }
int main() { auto wrapped = dangling(); if (!wrapped) { return 1; }
  unsafe { return std::assume_ref(wrapped.value().pointer, wrapped); } }  //~ ERROR GTI-S2102 //~ ERROR GTI-S2102
