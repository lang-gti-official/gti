// Audit output parity: native pointer adaptation and checked failure schedule is valid in both audit modes.
//@ check-pass
//@ raw-pointer-audit: warn
extern "C" { int32_t native_read(const int32_t* address); }
int32_t quotient(int32_t divisor) { return 42 / divisor; }
int main() {
  int32_t value = 7;
  unsafe { return quotient(native_read(&value)); }
}
