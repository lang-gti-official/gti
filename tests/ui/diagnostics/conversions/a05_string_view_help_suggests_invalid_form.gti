// Reproducer a05-string-view-help-suggests-invalid-form: passing a std::string where a std::string_view is required is a type mismatch (its view-accessor guidance is checked on a user type in user_view_guidance).
// A05: GTI-S2003 correctly rejects passing a std::string where a
// std::string_view is required, but its help suggests
// 'std::string_view(value)', which is itself rejected (GTI-S2030). The
// working form is 'word.view()'.
import std.string;

int main() {
  std::string word = std::string("abc");
  mut std::string out{};
  out.append(word);  //~ ERROR GTI-S2003
  return 0;
}
