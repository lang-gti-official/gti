// Reproducer a33-unnecessary-mut-deref-store: a store through an overloaded dereference is a mutable use.
//@ check-pass
// A33: GTI-S2096 'never used mutably' on an overloaded dereference store; the quick fix
// breaks the build (GTI-S2002).
import std.memory;
int main() {
  mut std::unique_ptr<int> p = std::make_unique<int>(3);
  *p = 103;
  return *p == 103 ? 0 : 1;
}
