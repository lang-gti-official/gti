// A guard published from a stored (direct) mutex reference conflicts once with a second lock while it lives; the explanation is its destruction.
//@ execution-profile: concurrent
import std.mutex;
void see(std::mutex<int32_t>& value) {}
class User {
  std::mutex<int32_t>& owner;
public:
  User(std::mutex<int32_t>& owner) : owner(owner) {}
  void use() {
    auto guard = this.owner.lock();
    auto second = this.owner.lock();  //~ ERROR GTI-S2017
  }
};
int main() { return 0; }
