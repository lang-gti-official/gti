// Ending the scope of a guard published from a stored (direct) mutex reference permits a second lock.
//@ execution-profile: concurrent
//@ check-pass
import std.mutex;
void see(std::mutex<int32_t>& value) {}
class User {
  std::mutex<int32_t>& owner;
public:
  User(std::mutex<int32_t>& owner) : owner(owner) {}
  void use() {
    { auto guard = this.owner.lock(); }
    auto second = this.owner.lock();
  }
};
int main() { return 0; }
