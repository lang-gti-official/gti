// Ownership and missing include diagnostics: full-expression carrier exclusion is structural, not a container name exception.
class Lease {
  mut int& value;
public:
  bool success = true;
  Lease(mut int& value) : value(value) {}
};
Lease acquire(mut int& value) { return Lease(value); }
int main() {
  mut int value = 7;
  if (acquire(value).success && value == 7) { return 1; }  //~ ERROR GTI-S2017
  return 0;
}
