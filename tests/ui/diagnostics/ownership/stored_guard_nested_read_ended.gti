// Ending the scope of a guard published from a stored (nested) mutex reference permits a read of the ancestor.
//@ execution-profile: concurrent
//@ check-pass
import std.mutex;
void see(std::mutex<int32_t>& value) {}
class Holder { public:
  std::mutex<int32_t>& owner;
  Holder(std::mutex<int32_t>& owner) : owner(owner) {}
};
class User {
  Holder& holder;
public:
  User(Holder& holder) : holder(holder) {}
  void use() {
    { auto guard = this.holder.owner.lock(); }
    see(this.holder.owner);
  }
};
int main() { return 0; }
