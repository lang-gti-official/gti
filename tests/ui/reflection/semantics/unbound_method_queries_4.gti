// Unbound method queries: an unbound reflected signature query is diagnosed before MIR: std::meta::method<OpenMethod, 0>().result().is_void().
import std.meta;
import std.format;
class OpenMethod {
public:
  OpenMethod() = default;
  T pick<T>(T value) { return value; }
};
class PointerMethod {
public:
  PointerMethod() = default;
  T* pick<T>(T* value) { return value; }
};
int main() { std::println("{}", std::meta::method<OpenMethod, 0>().result().is_void()); return 0; }  //~ ERROR GTI-S2126
