// Class assertions: complete: a false self-reflecting assertion reports its message once.
import std.meta;
class Node<T> {
  static_assert(std::meta::type<Node<T>>().field_count() == uint64_t(2),  //~ ERROR GTI-S2079
                "two fields");
  T value;
public:
  Node(T value) : value(value) {}
};
int main() { Node<int32_t> node = Node<int32_t>(1); return 0; }
