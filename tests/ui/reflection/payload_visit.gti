// Reflected dispatch borrows only the active case and preserves a generic enum's field types.
//@ run-pass
import std.meta;

enum Reading<T> { idle, sample(T value, int scale) };

struct Reader {
  int visit(std::meta::enumerator<Reading<int>, 0> tag) { return 1; }
  int visit(std::meta::enumerator<Reading<int>, 1> tag, int& value, int& scale) {
    return value * scale;
  }
};

int main() {
  mut Reader reader{};
  Reading<int> idle = Reading<int>::idle;
  Reading<int> sample = Reading<int>::sample(7, 6);
  if (std::meta::visit<int, Reading<int>, Reader>(idle, reader) != 1) { return 1; }
  return std::meta::visit<int, Reading<int>, Reader>(sample, reader) - 42;
}
