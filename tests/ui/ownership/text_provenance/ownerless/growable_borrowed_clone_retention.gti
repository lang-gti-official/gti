// Growable borrowed clone retention: cloned storage rejects mutation of an external owner.
//@ require-function-definitions
import std.string;
import std.vector;
int main() {
  mut std::string first{"first"}; std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.push_back(first.view()); values.push_back(second.view());
  auto copied = values.clone();
  first.clear();  //~ ERROR GTI-S2017
  return copied[0] == "first" && copied[1] == "second" ? 0 : 1;
}
