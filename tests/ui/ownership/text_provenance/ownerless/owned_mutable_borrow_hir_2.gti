// Owned mutable borrow hir: shared owners cannot authorize mutable owned access.
import std.memory;
class Reading { public: int& value; Reading(int& input) : value(input) {} };
unsafe mut Reading& access(Reading* address, int& owner) {  //~ ERROR GTI-S2017
  unsafe { return std::borrow_owned_mut_at(address, owner); }  //~ ERROR GTI-S2017 //~ ERROR GTI-S2017
}
int main() {
  Reading* address = nullptr;
  mut int owner = 0;
  unsafe { mut Reading& selected = access(address, owner); }  //~ ERROR GTI-S2017
  return 0;
}
