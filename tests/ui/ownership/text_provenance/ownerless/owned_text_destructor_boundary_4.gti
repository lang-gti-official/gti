// Owned text destructor boundary: destruction cannot publish borrowed text into global storage.
import std.memory;
import std.string;
import std.panic;
mut std::string_view escaped = "";
struct Label {
  std::string_view text;
  Label(std::string_view input) : text(input) {}
  ~Label() { escaped = this.text; }
};
int main() {
  std::string owner{"borrowed"};
  mut std::uninitialized<Label> storage{};
  unsafe {
    Label* address = storage.data();
    std::construct_owned_at<Label, std::uninitialized<Label>, std::string_view>(address, storage, owner.view());  //~ ERROR GTI-S2045
    std::destroy_at(address);
  }
  return 0;
}
