// Permuting recursive field contracts: dynamic text cannot reach the formal a recursion permutes.
import std.string;
struct Token {
  std::string_view text;
  int line;
};
std::string_view pick(Token a, Token b, int n) {
  if (n == 0) {
    return a.text;
  }
  return pick(b, a, n - 1);
}
std::string_view outer(Token x, Token y) { return pick(x, y, 3); }

int main() {
  std::string owner{"dynamic"};
  Token a{.text = "ab", .line = 1};
  Token b{.text = owner.view(), .line = 2};
  return pick(a, b, 1).size() == 7 ? 0 : 1;  //~ ERROR GTI-S2045
}
