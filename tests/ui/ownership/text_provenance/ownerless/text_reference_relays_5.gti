// Text reference relays: a relayed view is checked at source: std::string_view& r = t.ref(); Token u = std::move(t); uint64_t n = r.size();.
import std.string;
mut std::string_view kept = "";
class Token {
public:
  std::string_view text;
  int kind;
  Token(std::string_view text, int kind) : text(text), kind(kind) {}
  std::string_view& ref() { return this.text; }
  int& kindRef() { return this.kind; }
  int& kindOf() { return this.kindRef(); }
  std::string_view& alias() { return this.ref(); }
};
class Box<T> {
public:
  T value;
  Box(T value) : value(value) {}
  T& get() { return this.value; }
};
void keep(Token& token) { kept = token.ref(); }
uint64_t width(Token& token) { return token.ref().size(); }
int run() { mut std::string input{"input"}; Token t = Token(input.view(), 1); std::string_view& r = t.ref(); Token u = std::move(t); uint64_t n = r.size(); return 0; }  //~ WARN GTI-S2096 //~ ERROR GTI-S2017
int main() { return run(); }
