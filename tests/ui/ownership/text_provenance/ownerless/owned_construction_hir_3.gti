// Owned construction hir: ordinary raw construction still rejects checked borrowed payloads.
import std.memory;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
void put(Reading* destination, mut int& owner, int& input) {
  unsafe { std::construct_at<Reading, int&>(destination, input); }
}
int main() {
  Reading* destination = nullptr;
  mut int owner = 0;
  int number = 11;
  put(destination, owner, number);  //~ ERROR GTI-S2019
  return 0;
}
