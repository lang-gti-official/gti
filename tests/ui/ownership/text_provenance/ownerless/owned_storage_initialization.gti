// Owned storage initialization: owner-aware scalar initialization reaches verified MIR.
//@ check-pass
import std.memory;
int main() {
  mut std::uninitialized<int> storage{};
  unsafe {
    int* address = storage.data();
    std::initialize_owned_at(address, storage, 42);
    return *address == 42 ? 0 : 1;
  }
}
