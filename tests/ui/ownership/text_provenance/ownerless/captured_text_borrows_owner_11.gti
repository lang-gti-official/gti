// Captured text borrows owner: captured text keeps its owner borrowed: mut Doc doc{}; std::string_view body = doc.body.view(); auto read = [body]() -> std::string_view { return body; }; std::string_view held = read(); doc.body.append("!"); std::println(held); return 0;.
import std.string;
import std.functional;
struct Doc {
  mut std::string body;
  Doc() : body("doc-body") {}
};
std::string_view same(std::string_view text) { return text; }
int main() {
  mut std::string owner{"dynamic"};  //~ WARN GTI-S2096
  std::string_view view = owner.view();
  auto captured = [view]() -> std::string_view { return view; };
  mut Doc doc{}; std::string_view body = doc.body.view(); auto read = [body]() -> std::string_view { return body; }; std::string_view held = read(); doc.body.append("!"); std::println(held); return 0;  //~ ERROR GTI-S2017
}
