// Owned mutable borrow hir: exclusive owner-aware access is accepted by
// semantics. Its HIR contract is checked by the ownerless_owned_mutable_borrow_hir
// unit case; lowering this direct return of a carrier reference to MIR is
// issue #545.
//@ analyze-pass
import std.memory;
class Reading { public: int& value; Reading(int& input) : value(input) {} };
unsafe mut Reading& access(Reading* address, mut int& owner) {
  unsafe { return std::borrow_owned_mut_at(address, owner); }
}
int main() {
  Reading* address = nullptr;
  mut int owner = 0;
  unsafe { mut Reading& selected = access(address, owner); }
  return 0;
}
