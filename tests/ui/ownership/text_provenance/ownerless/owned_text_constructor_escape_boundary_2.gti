// Owned text constructor escape boundary: raw construction also cannot publish an escaping dynamic text input.
import std.memory;
import std.string;
mut std::string_view escaped = "";
struct Label {
  std::string_view text;
  Label(std::string_view input) : text(input) { escaped = input; }  //~ ERROR GTI-S2045
};
int main() {
  std::string owner{"borrowed"};
  mut std::uninitialized<Label> storage{};
  unsafe {
    Label* address = storage.data();
    std::construct_at<Label, std::string_view>(address, owner.view());
  }
  return escaped == "borrowed" ? 0 : 1;
}
