// Captured text borrows owner: captured text keeps its owner borrowed: auto size = [view]() -> int { return int(view.size()); }; std::function_ref<int()> sized{size}; owner.append("!"); return sized();.
import std.string;
import std.functional;
struct Doc {
  mut std::string body;
  Doc() : body("doc-body") {}
};
std::string_view same(std::string_view text) { return text; }
int main() {
  mut std::string owner{"dynamic"};
  std::string_view view = owner.view();
  auto captured = [view]() -> std::string_view { return view; };
  auto size = [view]() -> int { return int(view.size()); }; std::function_ref<int()> sized{size}; owner.append("!"); return sized();  //~ ERROR GTI-S2017
}
