// Invocation pointer text targets: a text-relaying invocation pointer target is rejected where it is formed: std::string_view(std::string&).
import std.functional;
import std.string;
std::string_view target(std::string& owner) {
  return owner.view();
}
int main() {
  std::function_ptr<std::string_view(std::string&)> pointer{target};  //~ ERROR GTI-S2045
  return 0;
}
