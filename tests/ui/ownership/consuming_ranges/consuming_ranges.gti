// Consuming ranges: owned scalar yields support ordinary binding conversion and mutation.
//@ check-pass
class Source {
  mut int count = 0;
public:
  Source() {}
  bool has_next() { return this.count < 3; }
  int take_next() mut { this.count++; return this.count; }
};

int main() {
  mut int64_t sum = 0;
  for (mut int64_t value : Source()) { value += 1; sum += value; }
  return sum == 9 ? 0 : 1;
}
