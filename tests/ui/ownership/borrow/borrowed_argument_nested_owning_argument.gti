// Borrowed arguments survive a nested call that takes an owning argument.
//@ run-pass
//@ revisions: default later build-build hold-hold name-name moved-moved gate-gate admit-admit later-later tag-tag near-near
//@[later] args: later
//@[build-build] run-fail
//@[build-build] args: build build
