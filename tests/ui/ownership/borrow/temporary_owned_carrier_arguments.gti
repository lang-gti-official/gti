// Scalar and operator temporaries retain ordered evaluation and cleanup.
//@ run-pass
//@ revisions: default later body-fails producer-now-fails
//@[default] stdout: consume
//@[default] stdout: 14
//@[default] stdout: 24
//@[default] stdout: 13
//@[default] stdout: 23
//@[later] run-fail
//@[later] args: later
//@[later] exit-code: 70
//@[later] stdout: 14
//@[later] stdout: 24
//@[later] stdout: 13
//@[later] stdout: 23
//@[later] stderr-contains: temporary_owned_carrier_arguments.gti:18: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[body-fails] run-fail
//@[body-fails] args: body fails
//@[body-fails] exit-code: 70
//@[body-fails] stdout: consume
//@[body-fails] stdout: 14
//@[body-fails] stdout: 24
//@[body-fails] stdout: 13
//@[body-fails] stdout: 23
//@[body-fails] stderr-contains: temporary_owned_carrier_arguments.gti:21: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[producer-now-fails] run-fail
//@[producer-now-fails] args: producer now fails
//@[producer-now-fails] exit-code: 70
//@[producer-now-fails] stdout: 13
//@[producer-now-fails] stdout: 23
//@[producer-now-fails] stderr-contains: temporary_owned_carrier_arguments.gti:17: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- temporary_owned_carrier_arguments.gti
import std.string;
import std.vector;
class Owner {
  int value;
public:
  Owner(int v) : value(v) {}
  int& get() { return this.value; }
  ~Owner() { std::println(this.value + 20); }
};
class View {
  int& value;
public:
  View(int& v) : value(v) {}
  int read() { return this.value; }
  ~View() { std::println(this.value + 10); }
};
Owner produce(int divisor) { return Owner(4 / divisor); } // producer-failure
int later(int divisor) { return 0 / divisor; } // later-failure
int consume(View& first, View& second, int& ignored, int& divisor) {
  std::println("consume");
  return (first.read() + second.read() + ignored) / divisor; // body-failure
}
int observe<Args...>(Args&... args) { return consume(args...); }
int forward<Args...>(Args&... args) { return observe(args...); }
int main(int argc, std::vector<std::string> argv) {
  return forward(View(Owner(3).get()), View(produce(argc == 4 ? 0 : 1).get()),
                 later(argc == 2 ? 0 : 1), argc == 3 ? 0 : 1) - 7;
}
