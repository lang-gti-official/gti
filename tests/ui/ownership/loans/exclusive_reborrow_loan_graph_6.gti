// Exclusive reborrow loan graph: shared stored accessor forbids mutable owner/reference invalidation.
class Box { public: mut int value = 2; int& read() { return this.value; } };
class View { int& value; public: View(int& source) : value(source) {}
  int get() { return this.value; } };
int bad(mut Box& parent) { View retained = View(parent.read());
mut Box& alias = parent; alias.value = 99; return retained.get(); }  //~ ERROR GTI-S2017
int main() { return 0; }
