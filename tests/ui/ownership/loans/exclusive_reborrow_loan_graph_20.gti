// Exclusive reborrow loan graph: borrowed-state carrier arguments should remain compatible with a mutation of a disjoint sibling place.
//@ check-pass
class Box {
public:
  mut int value = 2;
  int& read() { return this.value; }
  int bump() mut {
    this.value += 1;
    return this.value;
  }
public:
  Box() = default;
};
class Pair {
public:
  mut Box left = Box();
  mut Box right = Box();
public:
  Pair() = default;
};
class View {
  int& value;
public:
  View(int& source) : value(source) {}
  int get() { return this.value; }
};
int consume(View view, int changed) { return view.get() + changed; }
int main() {
  mut Pair parent = Pair();
  return consume(View(parent.left.read()), parent.right.bump()) - 5;
}
