// Exclusive reborrow loan graph: overlapping mutable reference call results should produce one outer-call exclusivity diagnostic.
class Box {
  mut int value = 0;

public:
  mut int& write() mut { return this.value; }
public:
  Box() = default;
};
int sum(int& left, int& right) { return left + right; }
int main() {
  mut Box parent = Box();
  return sum(parent.write(), parent.write());  //~ ERROR GTI-S2017 Call creates overlapping reference accesses
}
