// Exclusive reborrow loan graph: a borrowed carrier blocks later mutation, not mutation completed before its construction.
class Box {
public:
  mut int value = 2;
  int& read() { return this.value; }
  int bump() mut {
    this.value += 1;
    return this.value;
  }
public:
  Box() = default;
};
class View {
  int& value;
public:
  View(int& source) : value(source) {}
  int get() { return this.value; }
};
int forward(View view, int changed) { return view.get() + changed; }
int reverse(int changed, View view) { return changed + view.get(); }
int forward_case(mut Box& parent) {
  return forward(View(parent.read()), parent.bump());  //~ ERROR GTI-S2017
}
int reverse_case(mut Box& parent) {
  return reverse(parent.bump(), View(parent.read()));
}
int main() { return 0; }
