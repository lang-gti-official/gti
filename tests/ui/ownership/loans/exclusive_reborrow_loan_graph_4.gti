// Exclusive reborrow loan graph: single-path shared carriers retain a checked child of mutable parents and their read-only reborrows.
//@ check-pass
class Box {
public:
  mut int value = 2;
  int& read() { return this.value; }
public:
  Box() = default;
};
class View {
  int& value;
public:
  View(int& source) : value(source) {}
  int get() { return this.value; }
};
int direct_parent(mut Box& parent) {
  View retained = View(parent.read());
  return retained.get();
}
int child_parent(mut Box& parent) {
  int& child = parent.read();
  View retained = View(child);
  return retained.get();
}
int main() { return 0; }
