// Exclusive reborrow loan graph: a later mutable receiver evaluation should not invalidate an earlier retained call result.
class Box {
  mut int value = 0;

public:
  int& read() { return this.value; }
  int bump() mut {
    this.value += 1;
    return this.value;
  }
public:
  Box() = default;
};
int combine(int& borrowed, int changed) { return borrowed + changed; }
int main() {
  mut Box parent = Box();
  return combine(parent.read(), parent.bump());  //~ ERROR GTI-S2017 call operand mutates storage borrowed
}
