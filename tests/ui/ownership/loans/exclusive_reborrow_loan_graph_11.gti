// Exclusive reborrow loan graph: a later mutable-reference helper evaluation should not invalidate an earlier retained call result.
class Box {
  mut int value = 0;

public:
  int& read() { return this.value; }
  void bump() mut { this.value += 1; }
public:
  Box() = default;
};
int mutate(mut Box& box) {
  box.bump();
  return 0;
}
int combine(int& borrowed, int changed) { return borrowed + changed; }
int main() {
  mut Box parent = Box();
  return combine(parent.read(), mutate(parent));  //~ ERROR GTI-S2017 later call operand mutates storage borrowed
}
