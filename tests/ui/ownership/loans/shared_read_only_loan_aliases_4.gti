// Shared read only loan aliases: mutable carrier access never upgrades the external read-only referent.
import std.string;
int main() { mut std::string value = std::string("gti"); mut auto iterator = value.begin(); mut std::string::const_iterator& alias = iterator; *alias = 'x'; return 0; }  //~ ERROR GTI-S2002 Dereference assignment requires mutable access
