// Switch and break loan flow: a switch break nested in a loop must not be mistaken for a terminating loop break.
import std.string;
int main() { mut std::string value = std::string("gti"); mut auto iterator = value.begin(); mut int count = 0; while (count < 2) { switch (count) { case 0: char current = *iterator; value.push_back('!'); break; default: break; } count++; } return 0; }  //~ ERROR GTI-S2017
