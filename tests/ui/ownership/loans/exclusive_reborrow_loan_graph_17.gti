// Exclusive reborrow loan graph: nested binary, conditional, assignment, and postfix mutations should be visible to full-call borrow validation.
class Box {
public:
  mut int value = 2;

  int& read() { return this.value; }
  int bump() mut {
    this.value += 1;
    return this.value;
  }
public:
  Box() = default;
};
int combine(int& observed, int changed) { return observed + changed; }
int binary_case(mut Box& parent) {
  return combine(parent.read(), 1 + parent.bump());  //~ ERROR GTI-S2017
}
int conditional_case(mut Box& parent, bool choose) {
  return combine(parent.read(), choose ? parent.bump() : 0);  //~ ERROR GTI-S2017
}
int assignment_case(mut Box& parent) {
  return combine(parent.read(), parent.value += 1);  //~ ERROR GTI-S2017
}
int postfix_case(mut Box& parent) {
  return combine(parent.read(), parent.value++);  //~ ERROR GTI-S2017
}
int main() { return 0; }
