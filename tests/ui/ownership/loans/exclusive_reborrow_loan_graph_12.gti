// Exclusive reborrow loan graph: a completed earlier mutation may precede an overlapping borrow through the ordinary verified ordered-call schedule.
//@ check-pass
class Box {
  mut int value = 0;

public:
  int& read() { return this.value; }
  int bump() mut {
    this.value += 1;
    return this.value;
  }
public:
  Box() = default;
};
int combine(int changed, int& borrowed) { return changed + borrowed; }
int main() {
  mut Box parent = Box();
  return combine(parent.bump(), parent.read());
}
