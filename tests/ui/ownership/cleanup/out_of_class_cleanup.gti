// Separate definitions preserve owner and virtual cleanup at every native mode.
//@ run-pass
//@ revisions: default fail
//@[default] stdout: 2
//@[default] stdout: 1
//@[default] stdout: 4
//@[default] stdout: 3
//@[fail] run-fail
//@[fail] args: fail
//@[fail] exit-code: 70
//@[fail] stdout: 4
//@[fail] stdout: 3
//@[fail] stdout: 2
//@[fail] stdout: 1
//@[fail] stderr-contains: out_of_class_cleanup.gti:33: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- out_of_class_cleanup.gti
import std.memory;
import std.string;
import std.vector;

class Trace {
  int number;
public:
  Trace(int id) : number(id) {}
  ~Trace() { std::println(this.number); }
};

interface Service {
  static std::unique_ptr<Service> create(int mode);
  int value();
};

class Implementation : public Service {
  Trace member;
public:
  Implementation() : member(Trace(3)) {}
  ~Implementation() { std::println(4); }
  int value() override;
};

int Implementation::value() { return 42; }

std::unique_ptr<Service> Service::create(int choice) {
  Trace first{1};
  Trace second{2};
  auto implementation = std::make_unique<Implementation>();
  if (choice != 0) {
    mut int zero = choice - 1;  //~ WARN GTI-S2096
    int failure = 1 / zero;
  }
  return std::upcast_unique<Service, Implementation>(std::move(implementation));
}

int main(int argc, std::vector<std::string> argv) {
  auto service = Service::create(argc - 1);
  if (service->value() != 42) { return 1; }
  return 0;
}
