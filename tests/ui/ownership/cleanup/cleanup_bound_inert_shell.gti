// Cleanup-bound source guards retain resources through normal/failure cleanup.
//@ run-pass
//@ revisions: default fail
//@[default] stdout: 40
//@[fail] run-fail
//@[fail] args: fail
//@[fail] exit-code: 70
//@[fail] stdout: 40
//@[fail] stderr-contains: cleanup_bound_inert_shell.gti:24: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- cleanup_bound_inert_shell.gti
import std.string;
import std.vector;

mut int observed = 0;
class Resource {
public:
  int value = 40;
  ~Resource() { std::println(observed); }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  // Failure-free cleanup still needs a real MIR drop before ending the loan.
  // Running this a second time during native shell destruction changes output.
  ~Guard() { observed ^= this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item, int divisor) : item(std::move(item)) {
    int checked = 1 / divisor;
  }
};
int main(int argc, std::vector<std::string> argv) {
  Resource resource{};
  Box<Guard> box{Guard(resource), argc > 1 ? 0 : 1};
  return 0;
}
