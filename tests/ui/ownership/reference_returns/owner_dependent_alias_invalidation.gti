// General owner dependent returns: mutating an owner while an alias of a view-derived reference is live is a borrow conflict.
import std.memory;
class View {
  int& value;
public:
  View(int& source) : value(source) {}
  int& get() { return this.value; }
};
class Owner {
  mut int value;
public:
  Owner(int initial) : value(initial) {}
  int& read() { return this.value; }
  void replace(int next) mut { this.value = next; }
};
int shared_invalidation() {
  mut Owner owner = Owner(1);
  View view = View(owner.read());
  int& first = view.get();
  int& second = first;
  owner.replace(2);  //~ ERROR GTI-S2017
  return second;
}
int main() { return 0; }
