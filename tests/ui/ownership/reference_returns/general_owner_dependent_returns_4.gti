// General owner dependent returns: ambiguous, mutable, and unrelated borrowed returns and aliases must be rejected.
import std.memory;

class DirectPayload {
public:
  int value;
  DirectPayload(int initial) : value(initial) {}
};

class View {
  int& value;

public:
  View(int& source) : value(source) {}
  int& get() { return this.value; }
};

int global_value = 1;

int& ambiguous(int& left, int& right) { return left; }  //~ ERROR GTI-S2017
int& mutable_source(mut int& source) { return source; }  //~ ERROR GTI-S2017

int& local_source(int& source) {
  int local = 1;
  return local;  //~ ERROR GTI-S2017
}

int& global_source(int& source) { return global_value; }

View local_view(int& source) {
  int local = 1;
  return View(local);  //~ ERROR GTI-S2045
}

class WrongFactory {
public:
  View make(int& source) { return View(source); }  //~ ERROR GTI-S2045
public:
  WrongFactory() = default;
};

class Owner {
  mut int value;

public:
  Owner(int initial) : value(initial) {}
  int& read() { return this.value; }
  void replace(int next) mut { this.value = next; }
};

int shared_invalidation() {
  mut Owner owner = Owner(1);
  View view = View(owner.read());
  int& first = view.get();
  int& second = first;
  owner.replace(2);
  return second;
}

int mutable_alias() {
  mut int value = 1;
  mut int& first = value;
  int& alias = first;
  return alias;
}

int main() { return 0; }
