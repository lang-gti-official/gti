// Source defined storage: ordinary method diagnostics preserve mutable access, scalar types and arity checks.
import std.memory;
std::storage<T> fixture_storage<T>(uint64_t count) requires std::storage_element<T> {
  std::allocator allocator{};
  auto allocated = allocator.try_storage<T>(count);
  return std::move(allocated).expect("test storage allocation");
}

int main() {
  std::allocator allocator{};
  auto fixed = fixture_storage<int>(uint64_t(1));
  fixed.construct(uint64_t(0), 1);  //~ ERROR GTI-S2000
  auto wrong_count = allocator.try_storage<int>(true);  //~ ERROR GTI-S2012
  auto extra_alignment = allocator.try_storage<int>(uint64_t(1), std::alignment(uint64_t(8)), true);  //~ ERROR GTI-S2012
  mut auto values = fixture_storage<int>(uint64_t(1));
  uint64_t extra_capacity = values.capacity(uint64_t(0));  //~ ERROR GTI-S2005
  bool wrong_index = values.initialized(true);  //~ ERROR GTI-S2003
  return 0;
}
