// Variadic storage construction and vector: range mutation diagnostics should report each identical borrow origin span and message only once.
import std.vector;

int main() {
  mut std::vector<int32_t> values = std::vector<int32_t>();
  [[discard]] values.emplace_back(1);
  for (int32_t& value : values) {
    values.reserve(std::size_t(4));  //~ ERROR GTI-S2017
  }
  return 0;
}
