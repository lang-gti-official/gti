// Unique ownership and allocation: empty unique-owner construction, repeated reset, nullptr assignment, and later replacement should validate through MIR.
//@ check-pass
import std.memory;

struct Widget {
public:
  Widget() {}
};

class Nullable {
  mut bool empty = false;

public:
  Nullable(nullptr_t value) : empty(true) {}
  void operator=(nullptr_t value) mut { this.empty = true; }
  bool is_empty() { return this.empty; }
public:
  Nullable() = default;
};

void consume(std::unique_ptr<Widget> value) {}

int main() {
  mut Nullable nullable = nullptr;
  nullable = nullptr;
  if (!nullable.is_empty()) { return 1; }

  mut std::unique_ptr<Widget> owner = nullptr;
  owner.reset();
  owner = nullptr;
  owner = std::make_unique<Widget>();
  owner = nullptr;
  return 0;
}
