// Fixed array pack forwarding: pack forwarding retains exact array extents and element types.
import std.memory;

class Holder {
  int32_t values[3];
public:
  Holder(int32_t initial[3]) : values(initial) {}
};
T forward_construct<T, Args...>(Args... args) { return T(args...); }  //~ ERROR GTI-S2012

int main() {
  int32_t seed[2] = {1, 2};
  Holder result = forward_construct<Holder>(seed);
  return 0;
}
