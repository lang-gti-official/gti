// Confined callable results: nested result inference must not erase receiver-tied reference origins.
class ReferenceSource {
  int value = 7;
public:
  int& operator()(int unused) { return this.value; }
public:
  ReferenceSource() = default;
};
int compose<Outer, Inner>(Outer outer, Inner inner, int value) {
  return outer(inner(value));  //~ ERROR GTI-S2046 without references, tracked borrowed state, or lambda identity
}
int main() {
  ReferenceSource inner{};
  auto outer = [](int value) -> int { return value; };
  return compose(outer, inner, 4);
}
