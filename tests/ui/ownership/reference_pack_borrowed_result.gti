// A borrowed carrier returned with a reference pack retains its owner's loan.
import std.string;
struct Holder {
  std::string_view value;
  Holder(std::string_view text) : value(text) {}
};
Holder observe<Args...>(std::string_view text, Args&... args) { return Holder(text); }
int main() {
  mut std::string text = "owner";
  int n = 1;
  auto holder = observe(text.view(), n);
  text.clear(); //~ ERROR GTI-S2017
  return int(holder.value.size());
}
