// Stored reference loop invalidation: a retained loan should remain active across loop backedges and end on the shared loop exit.
//@ snapshot: mir
//@ mir-function: main
// The loop-carried loan ends exactly once on the normal path, at the loop exit.
// CHECK: end-borrow hir-statement={{#[0-9]+}} call-input-kind=value loan=1 dispatch-owner
// CHECK-NOT: end-borrow hir-statement={{#[0-9]+}} call-input-kind=value loan=1 dispatch-owner
//@ check-pass
import std.string;
int main() { mut std::string value = std::string("gti"); mut auto iterator = value.begin(); mut int count = 0; while (count < 2) { char current = *iterator; count++; } value.push_back('!'); return 0; }
