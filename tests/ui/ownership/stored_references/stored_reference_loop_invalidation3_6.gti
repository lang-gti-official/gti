// Stored reference loop invalidation3: an owner mutation before continue must remain rejected because the next condition reuses the retained carrier.
import std.string;
int main() { mut std::string value = std::string("gti"); mut auto iterator = value.begin(); mut int count = 0; while (*iterator == 'g' and count < 2) { value.push_back('!'); count++; continue; } return 0; }  //~ ERROR GTI-S2017 while a reference borrowed from it may still be live
