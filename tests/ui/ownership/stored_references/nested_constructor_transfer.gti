// Moving an exclusive carrier into a nested constructor hands the borrow to its result.
//@ run-pass
struct State {
  mut int& object;
  State(mut int& x) : object(x) {}
  mut int& owner() mut { return this.object; }
};
struct View {
  mut State state;
  int tag;
  View(State s, int tag) : state(std::move(s)), tag(tag) {}
};
View make(mut int& x) {
  State s{x};
  return View(std::move(s), 4);
}
int main() {
  mut int v = 1;
  {
    mut View view = make(v);
    view.state.owner() = 6;
  }
  return v - 6;
}
