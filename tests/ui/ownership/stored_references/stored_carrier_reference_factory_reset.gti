// Stored carrier return provenance: a reference factory does not allow mutation of its carrier shell while the returned wrapper still uses it.
class Cell {
  int& resource;
  mut int value = 7;
public:
  Cell(int& resource) : resource(resource) {}
  int read() { return this.value; }
  void reset() mut { this.value = 9; }
  ~Cell() {}
};
class Reference<T> {
  T& owner;
public:
  Reference(T& owner) : owner(owner) {}
  T& get() { return this.owner; }
};
Reference<T> bind<T>(T& owner) { return Reference<T>(owner); }
int main() {
  int resource = 4;
  mut Cell owner{resource};
  auto reference = bind(owner);
  owner.reset();  //~ ERROR GTI-S2017
  return reference.get().read() - 7;
}
