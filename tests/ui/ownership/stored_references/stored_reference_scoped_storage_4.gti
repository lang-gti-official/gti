// Stored reference scoped storage: stored-reference diagnostics should reject unsupported reference graphs, assignment, and temporary owners.
class BorrowingIterator<T> {
  T& value;
public:
  BorrowingIterator(T& source) : value(source) {}
};
class SingleRange<T> {
  mut T value;
public:
  SingleRange(T initial) : value(initial) {}
  BorrowingIterator<T> begin() { return BorrowingIterator<T>(this.value); }
};
int main() {
  BorrowingIterator<int> dangling = SingleRange<int>(2).begin();  //~ ERROR GTI-S2045
  return 0;
}
