// Prefix storage capability: every ordinary prefix mutation (pop, append, insert, erase, read_mut, relocation from or into) rejects a live element loan of the owner it changes.
//@ stdlib-overlay: std/detail/memory_storage.gti
import std.memory;
import std.detail.memory_storage;

int live_1() {
  mut std::detail::prefix_owner<int> values{uint64_t(2)};
  mut std::detail::prefix_owner<int> other{uint64_t(2)};
  values.append_value(7);
  other.append_value(9);
  int& value = values.read(uint64_t(0));
  values.pop();  //~ ERROR GTI-S2017
  return value;
}
