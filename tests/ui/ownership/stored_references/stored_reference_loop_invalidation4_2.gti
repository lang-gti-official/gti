// Stored reference loop invalidation4: a switch break nested in a loop must not be mistaken for a loop exit before the next backedge.
import std.string;
int main() { mut std::string value = std::string("gti"); mut auto iterator = value.begin(); mut int count = 0; while (count < 1) { switch (count) { case 0: { char current = *iterator; break; } default: { break; } } value.push_back('!'); count++; } return 0; }  //~ ERROR GTI-S2017 while a reference borrowed from it may still be live
