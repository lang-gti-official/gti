// Stored carrier return provenance: a composed owned-storage accessor still freezes its external owner after the passive carrier moves.
class ValueBox<T> {
  mut T payload;
public:
  ValueBox(T value) : payload(value) {}
  T& get() { return this.payload; }
  void set(T value) mut { this.payload = value; }
};
class BorrowedBox<T, lifetime a> {
  ValueBox<T>&<a> owner;
public:
  BorrowedBox(ValueBox<T>&<a> owner) : owner(owner) {}
  T&<a> get() { return this.owner.get(); }
};
int main() {
  mut ValueBox<int> owner{4};
  BorrowedBox<int> carrier{owner};
  int& value = carrier.get();
  auto moved = std::move(carrier);
  owner.set(9);  //~ ERROR GTI-S2017
  return value + moved.get() - 8;
}
