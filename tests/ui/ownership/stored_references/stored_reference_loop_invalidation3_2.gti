// Stored reference loop invalidation3: a retained use in the loop condition should remain live on the backedge and end only on the false edge.
//@ check-pass
import std.string;
int main() { mut std::string value = std::string("gti"); mut auto iterator = value.begin(); mut int count = 0; while (*iterator == 'g' and count < 1) { count++; } value.push_back('!'); return 0; }
