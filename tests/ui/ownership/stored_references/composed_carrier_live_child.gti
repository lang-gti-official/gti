// Composed carrier function transfer: writing through a reference into the carrier's exclusive owner while the forwarded carrier is live is a borrow conflict.
struct Cell { mut int value = 0;  public: Cell() = default; };
struct Context {
  int& step;
  mut Cell& left;
  mut Cell& right;
  Context(int& step, mut Cell& left, mut Cell& right)
      : step(step), left(left), right(right) {}
  void update() mut {
    this.left.value += this.step;
    this.right.value += this.step;
  }
};
T forward_context<T>(T context) { return std::move(context); }

int main() {
  int step = 2;
  mut Cell left{};
  mut Cell right{};
  mut Context initial{step, left, right};

  mut Cell& child = initial.left;
  mut Context active = forward_context<Context>(std::move(initial));  //~ ERROR GTI-S2017
  child.value = 9;
  active.update();
  return 0;
}
