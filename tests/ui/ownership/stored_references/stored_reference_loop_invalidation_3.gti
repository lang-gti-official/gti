// Stored reference loop invalidation: an unbraced loop body should have its own loan-flow region and project a pre-existing carrier to the loop exit.
//@ check-pass
import std.string;
int main() { mut std::string value = std::string("gti"); mut auto iterator = value.begin(); mut char observed = '?'; while (false) observed = *iterator; value.push_back('!'); return 0; }
