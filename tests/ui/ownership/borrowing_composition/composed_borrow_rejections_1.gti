// Composed borrows keep every owner borrowed: owner writes, temporary owners and aliases are rejected.
//@ check-fail

namespace case_temporary_owner {
struct PairView {
  int& first;
  int& second;
  PairView(int& a, int& b) : first(a), second(b) {}
  int sum() { return first + second; }
  int sum_with(int other) { return first + second + other; }
  int mutate_argument(mut int& other) { other = 9; return first + second; }
};
int entry() {
  int a = 1; PairView view{a, 2}; return view.sum();  //~ ERROR GTI-S2012 //~ ERROR GTI-S2045
}
}

