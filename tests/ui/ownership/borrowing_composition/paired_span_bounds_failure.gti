// Out-of-range paired-span first, second and subspan fail with index_out_of_bounds after cleanup.
//@ run-fail
//@ exit-code: 70
//@ stdout: cleaned
//@ stderr-contains: : runtime error[GTI-R0007]: index_out_of_bounds in
//@ revisions: shorter_first shorter_second subspan_count subspan_offset
//@[shorter_first] args: shorter-first
//@[shorter_second] args: shorter-second
//@[subspan_count] args: subspan-count
//@[subspan_offset] args: subspan-offset
import std.paired_span;
import std.vector;
import std.string;
import std.memory;
class Guard {
  std::unique_ptr<int> token;
public:
  Guard() : token(std::make_unique<int>(7)) {}
  ~Guard() { if (this.token != nullptr) std::println("cleaned"); }
};
int run(std::string_view which) {
  Guard guard{};
  mut std::vector<int> first{}; first.push_back(1); first.push_back(2);
  mut std::vector<int> second{}; second.push_back(3);
  auto view = std::paired_span<int, int>(first.as_span(), second.as_span());
  if (which == "shorter-first") { [[discard]] view.first(std::size_t(1)); }
  if (which == "shorter-second") { [[discard]] view.second(std::size_t(1)); }
  if (which == "subspan-count") { [[discard]] view.subspan(std::size_t(1), std::size_t(1)); }
  if (which == "subspan-offset") { [[discard]] view.subspan(std::size_t(2), std::size_t(0)); }
  return 0;
}
int main(int argc, std::vector<std::string> argv) { return run(argv[1].view()); }
