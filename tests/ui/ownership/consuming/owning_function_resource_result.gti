// Public erased callbacks publish owned results and clean failures exactly once.
//@ run-pass
//@ revisions: default producer later-failure
//@[default] stdout: 6
//@[default] stdout: 6
//@[default] stdout: 9
//@[producer] run-fail
//@[producer] args: producer
//@[producer] exit-code: 70
//@[producer] stdout: 9
//@[producer] stderr-contains: owning_function_resource_result.gti:13: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[later-failure] run-fail
//@[later-failure] args: later failure
//@[later-failure] exit-code: 70
//@[later-failure] stdout: 6
//@[later-failure] stdout: 6
//@[later-failure] stdout: 9
//@[later-failure] stderr-contains: owning_function_resource_result.gti:21: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- owning_function_resource_result.gti
import std.functional;
import std.string;
import std.vector;

class Resource {
  int identity;
public:
  Resource(int identity) : identity(identity) {}
  ~Resource() { std::println(this.identity); }
  int read() { return this.identity; }
};

Resource produce(int divisor) { return Resource(12 / divisor); }

int main(int argc, std::vector<std::string> argv) {
  Resource caller{9};
  std::function<Resource(int)> callback{produce};
  int divisor = argc == 2 ? 0 : 2;
  Resource result = callback(divisor);
  std::println(result.read());
  int later = 6 / (argc == 3 ? 0 : 1);
  return later - 6;
}
