// Consuming receivers retain caller-owned full-expression cleanup.
//@ run-pass
//@ revisions: default body later-argument
//@[default] stdout: 2
//@[default] stdout: 3
//@[default] stdout: 4
//@[default] stdout: 1
//@[default] stdout: 5
//@[default] stdout: 9
//@[body] run-fail
//@[body] args: body
//@[body] exit-code: 70
//@[body] stdout: 2
//@[body] stdout: 1
//@[body] stdout: 9
//@[body] stderr-contains: consuming_receiver_lifetime.gti:11: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[later-argument] run-fail
//@[later-argument] args: later argument
//@[later-argument] exit-code: 70
//@[later-argument] stdout: 2
//@[later-argument] stdout: 3
//@[later-argument] stdout: 1
//@[later-argument] stdout: 9
//@[later-argument] stderr-contains: consuming_receiver_lifetime.gti:17: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- consuming_receiver_lifetime.gti
import std.string;
import std.vector;

class Receiver {
  int identity;
public:
  Receiver(int identity) : identity(identity) {}
  ~Receiver() { std::println(this.identity); }
  int operator()(int divisor) && {
    std::println(2);
    return 12 / divisor;
  }
};

int later(int divisor) {
  std::println(3);
  return 6 / divisor;
}

int combine(int left, int right) {
  std::println(4);
  return left + right;
}

int main(int argc, std::vector<std::string> argv) {
  Receiver caller{9};
  Receiver callback{1};
  int body_divisor = argc == 2 ? 0 : 1;
  int later_divisor = argc == 3 ? 0 : 1;
  int value = combine(std::move(callback)(body_divisor), later(later_divisor));
  std::println(5);
  return value - 18;
}
