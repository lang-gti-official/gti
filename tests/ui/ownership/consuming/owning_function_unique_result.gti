// Public erased callbacks publish owned results and clean failures exactly once.
//@ run-pass
//@ revisions: default producer later-failure
//@[default] stdout: 6
//@[default] stdout: 6
//@[default] stdout: 9
//@[producer] run-fail
//@[producer] args: producer
//@[producer] exit-code: 70
//@[producer] stdout: 9
//@[producer] stderr-contains: owning_function_unique_result.gti:15: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[later-failure] run-fail
//@[later-failure] args: later failure
//@[later-failure] exit-code: 70
//@[later-failure] stdout: 6
//@[later-failure] stdout: 6
//@[later-failure] stdout: 9
//@[later-failure] stderr-contains: owning_function_unique_result.gti:26: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- owning_function_unique_result.gti
import std.functional;
import std.memory;
import std.string;
import std.vector;

class Resource {
  int identity;
public:
  Resource(int identity) : identity(identity) {}
  ~Resource() { std::println(this.identity); }
  int read() { return this.identity; }
};

std::unique_ptr<Resource> produce(int divisor) {
  int value = 12 / divisor;
  return std::make_unique<Resource>(value);
}

int main(int argc, std::vector<std::string> argv) {
  Resource caller{9};
  std::function<std::unique_ptr<Resource>(int)> callback{produce};
  auto copy = callback.clone();
  int divisor = argc == 2 ? 0 : 2;
  auto result = copy(divisor);
  std::println(result->read());
  int later = 6 / (argc == 3 ? 0 : 1);
  return later - 6;
}
