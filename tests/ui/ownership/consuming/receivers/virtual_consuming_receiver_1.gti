// Virtual consuming receiver: read/mutable override cannot replace a consuming interface requirement.
import std.string;
import std.vector;

interface Operation {
  int operator()(int divisor) &&;
};

class Receiver : public Operation {
  int identity;
public:
  Receiver(int identity) : identity(identity) {}
  ~Receiver() { std::println(this.identity); }
  int operator()(int divisor)  override {  //~ ERROR GTI-S2042
    std::println(2);
    return 12 / divisor;
  }
};

int later(int divisor) { std::println(3); return 6 / divisor; }
int combine(int left, int right) { std::println(4); return left + right; }

int main(int argc, std::vector<std::string> argv) {
  Receiver caller{9};  //~ ERROR GTI-S2044
  Receiver callback{1};  //~ ERROR GTI-S2044
  int body_divisor = argc == 2 ? 0 : 1;
  int later_divisor = argc == 3 ? 0 : 1;
  int value = combine(std::move(callback)(body_divisor), later(later_divisor));
  std::println(5);
  return value - 18;
}
