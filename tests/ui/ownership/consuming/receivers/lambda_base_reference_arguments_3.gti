// Lambda base reference arguments: an unrelated class or read-only derived object for a lambda's base reference fails in semantics, not in MIR.
interface Operation { int run(int value); };
class Increment : public Operation {
public:
  Increment() {}
  int run(int value) override { return value + 1; }
};
class Unrelated { public: Unrelated() {} };
int main() { auto write = [](mut Operation& s, int v) -> int { return s.run(v); }; Increment concrete{}; return write(concrete, 40); }  //~ ERROR GTI-S2003
