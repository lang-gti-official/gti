//@[run3] stderr-contains: consuming_call_assignment.gti:25: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[run4] run-fail
//@[run4] args: fresh method failure
//@[run4] exit-code: 70
//@[run4] stdout: 10
