// Tryable propagation: the program is accepted.
//@ check-pass
class Guard {
public:
  int& owner;
  Guard(int& value) : owner(value) {}
  ~Guard() {}
};
class Envelope {
public:
  Guard guard;
  Envelope(Guard value) : guard(std::move(value)) {}
};

int main() {
  int owner = 7;
  Guard guard{owner};
  return guard.owner - 7;
}
