// Error propagation converts payload enums only on the failure path.
//@ run-pass
//@ stdout: converted

enum SourceError { invalid(int code) };
enum TargetError { source(int code) };
for concept std::from<TargetError, SourceError> {
  TargetError from(SourceError error) {
    std::println("converted");
    switch (error) {
      case SourceError::invalid(code): return TargetError::source(code + 1);
    }
  }
};
expected<int, SourceError> source(bool fail) {
  if (fail) return unexpected(SourceError::invalid(41));
  return 7;
}
expected<int, TargetError> target(bool fail) { return ?source(fail) + 1; }
int main() {
  auto success = target(false);
  if (!success.has_value() || success.value() != 8) return 1;
  auto failure = target(true);
  if (failure.has_value()) return 2;
  switch (failure.error()) {
    case TargetError::source(code): return code == 42 ? 0 : 3;
  }
}
