};
expected<Resource&, int> lookup(Resource& owner, bool fail) {
  if (fail) { return unexpected(9); }
  return owner;
}

int run() {
  Resource& alias = lookup(Resource(7), false).expect("required");  //~ ERROR GTI-S2017 //~ ERROR GTI-S2017
  return alias.read();
