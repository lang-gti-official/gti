// Negative: negative extraction case has valid source syntax.
class Resource {
  mut int value;
public:
  Resource(int value) : value(value) {}
  Resource(Resource& other) = delete;
  Resource(Resource&& other) = default;
  int read() { return value; }
  void set(int replacement) mut { value = replacement; }
};
expected<Resource&, int> lookup(Resource& owner, bool fail) {
  if (fail) { return unexpected(9); }
  return owner;
}
expected<int, int> run() { mut Resource owner{7}; Resource& alias = ?lookup(owner, false); alias.set(8); return alias.read(); }  //~ ERROR GTI-S2000
