// Prefix ? through std::tryable consumes operands once and cleans up before returning the residual, per phase.
//@ run-pass
//@ revisions: phase0 phase1 phase2 phase3 phase4 phase5 phase6
//@[phase0] stdout: 1
//@[phase0] stdout: -1
//@[phase0] stdout: 2
//@[phase0] stdout: -2
//@[phase0] stdout: 30
//@[phase0] stdout: 10
//@[phase0] stdout: 107
//@[phase0] stdout: 3
//@[phase0] stdout: 6
//@[phase0] stdout: -6
//@[phase0] stdout: 60
//@[phase0] stdout: 11
//@[phase0] stdout: -11
//@[phase1] run-fail
//@[phase1] exit-code: 7
//@[phase1] args: phase
//@[phase1] stdout: 5
//@[phase1] stdout: 3
//@[phase1] stdout: -3
//@[phase1] stdout: 4
//@[phase1] stdout: -4
//@[phase1] stdout: -5
//@[phase2] run-fail
//@[phase2] exit-code: 2
//@[phase2] args: phase phase
//@[phase2] stdout: 5
//@[phase2] stdout: 3
//@[phase2] stdout: -3
//@[phase2] stdout: 8
//@[phase2] stdout: 9
//@[phase2] stdout: -9
//@[phase2] stdout: -8
//@[phase2] stdout: -5
//@[phase3] run-fail
//@[phase3] exit-code: 4
//@[phase3] args: phase phase phase
//@[phase3] stdout: 5
//@[phase3] stdout: 3
//@[phase3] stdout: -3
//@[phase3] stdout: -5
//@[phase4] run-fail
//@[phase4] exit-code: 6
//@[phase4] args: phase phase phase phase
//@[phase4] stdout: 5
//@[phase4] stdout: 3
//@[phase4] stdout: -3
//@[phase4] stdout: -5
//@[phase5] run-fail
//@[phase5] exit-code: 9
//@[phase5] args: phase phase phase phase phase
//@[phase5] stdout: 5
//@[phase5] stdout: 3
//@[phase5] stdout: -3
//@[phase5] stdout: -5
//@[phase6] run-fail
//@[phase6] exit-code: 11
//@[phase6] args: phase phase phase phase phase phase
//@[phase6] stdout: 5
//@[phase6] stdout: 3
//@[phase6] stdout: -3
//@[phase6] stdout: -5
// Prefix `?` through `std::tryable` on user types. Construction prints a
// tracked id and destruction its negation, so each phase's trace follows from
// this source alone: an operand is consumed exactly once, by take_value on
// success or take_residual on failure, and the failure path cleans the full
// expression's earlier temporaries and then the enclosing scope.
import std.string;
import std.vector;

class Tracked {
  int id;

public:
  Tracked(int value) : id(value) { std::println(std::to_string(value)); }
  ~Tracked() { std::println(std::to_string(-this.id)); }
  int read() { return this.id; }
};

struct Rejected {
  int code;
  Rejected(int value) : code(value) {}
};

// A result whose tag traces the operand's lifetime.
class Checked<T> {
public:
  T value;
  int code;
  Tracked tag;
  Checked(T payload, int id, int failure)
      : value(payload), code(failure), tag(Tracked(id)) {}
};

for <std::copyable T> concept std::tryable<Checked<T>> {
  using value_type = T;
  using residual_type = Rejected;
  bool has_value(Checked<T>& result) { return result.code == 0; }
  T<a> take_value<lifetime a>(Checked<T, a> result) { return result.value; }
  Rejected take_residual(Checked<T> result) { return Rejected(result.code); }
};

// A status with nothing to produce: `?` on it is a statement.
struct Done {
  int code;
  Done(int value) : code(value) {}
};

for concept std::tryable<Done> {
  using value_type = void;
  using residual_type = Rejected;
  bool has_value(Done& done) { return done.code == 0; }
  void take_value(Done done) {}
  Rejected take_residual(Done done) { return Rejected(done.code); }
};

// A copyable result: a named operand is copied, not consumed.
struct Flag {
  int value;
  int code;
  Flag(int payload, int failure) : value(payload), code(failure) {}
};

for concept std::tryable<Flag> {
  using value_type = int;
  using residual_type = Rejected;
  bool has_value(Flag& flag) { return flag.code == 0; }
  int take_value(Flag flag) { return flag.value; }
  Rejected take_residual(Flag flag) { return Rejected(flag.code); }
};

class Status {
public:
  int code;
  Status(int value) : code(value) {}
  implicit Status(Rejected rejected) : code(rejected.code) {}
};

Checked<int> make(int id, int value, int failure) {
  return Checked<int>(value, id, failure);
}

Done check(int failure) { return Done(failure); }

Flag flag_of(int value, int failure) { return Flag(value, failure); }

// A receiver borrowed for a call stays staged across `?` in its argument.
class Total {
public:
  mut int sum;
  Total() : sum(0) {}
  void add(int value) mut { this.sum += value; }
};

Status successes() {
  int first = ?make(1, 10, 0);
  Checked<int> held = make(2, 20, 0);
  int second = ?std::move(held);
  std::println(std::to_string(first + second));
  ?check(0);
  Flag flag{5, 0};
  int twice = ?flag + ?flag;
  std::println(std::to_string(twice));
  // `?` in a conditional arm or on the right of `||` runs only when reached.
  int arm = flag.value > 0 ? ?flag_of(7, 0) : 0;
  bool either = arm < 0 || ?flag_of(1, 0) > 0;
  std::println(std::to_string(arm + (either ? 100 : 0)));
  mut Total total{};
  for (mut int index = 1; index < 3; index++) {
    total.add(?flag_of(index, 0));
  }
  std::println(std::to_string(total.sum));
  return Status(0);
}

Status early(int phase) {
  Tracked guard{5};
  int first = ?make(3, 30, 0);
  if (phase == 2) {
    int total = Tracked(8).read() + ?make(9, 90, 2);
    std::println(std::to_string(total));
  }
  ?check(phase == 3 ? 4 : 0);
  if (phase == 4 || phase == 5) {
    // A residual from a conditional arm or from the right of `||` returns
    // before the enclosing expression completes.
    int arm = phase == 4 ? ?flag_of(1, 6) : 0;
    bool either = arm > 0 || ?flag_of(2, 9) > 0;
    std::println(std::to_string(arm + (either ? 1 : 0)));
  }
  if (phase == 6) {
    // A residual in an argument returns before the staged receiver's call.
    mut Total total{};
    total.add(?flag_of(1, 0));
    total.add(?flag_of(2, 11));
    std::println(std::to_string(total.sum));
  }
  int second = ?make(4, 40, 7);
  std::println(std::to_string(first + second));
  return Status(0);
}

// Generic code names the associated type and may constrain it.
Status forward<T>(T result)
  requires std::tryable<T> && std::integral<std::tryable<T>::value_type> {
  std::tryable<T>::value_type value = ?std::move(result);
  std::println(std::to_string(value));
  return Status(0);
}

// The residual is the return type itself.
Rejected first_failure(int failure) {
  int value = ?make(11, 110, failure);
  return Rejected(value);
}

int run(int phase) {
  if (phase == 0) {
    Status status = successes();
    Status forwarded = forward(make(6, 60, 0));
    Rejected direct = first_failure(3);
    return status.code + forwarded.code + direct.code - 3;
  }
  return early(phase).code;
}

int main(int argc, std::vector<std::string> argv) {
  return run(argc - 1);
}
