// Lifetime and effects: constructors, operators, aggregate relays, forwarding and cleanup preserve persistent-loan protection.
//@ execution-profile: concurrent
thread_local mut int value = 1;
void modify() { value = 2; }
int initialize() { modify(); return 3; } int read(int copied = initialize()) { return copied; } int main() { int& borrowed = value; int copied = read(); return borrowed + copied; }  //~ ERROR GTI-S2045
