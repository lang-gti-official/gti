thread_local mut int32_t guarded = 1; thread_local mut int32_t other = 2; thread_local mut int32_t third = 3; void leaf<T>(int32_t& fixed, T& element) { guarded = 9; } 
void selected<Args...>(Args... args) {
  int32_t& fixed = guarded;
  (leaf(fixed, args), ...);
}
