// Pack fold storage effects: zero concrete invocations create no fixed-input borrow.
//@ check-pass
//@ require-function-definitions
mut int32_t guarded = 1; mut int32_t other = 2;
void leaf<T>(int32_t& input, T& element) { guarded = 3; }
void folded<Args...>(Args... args) { (leaf(guarded, args), ...); }
int main() { int32_t& held = guarded; folded(); return held; }
