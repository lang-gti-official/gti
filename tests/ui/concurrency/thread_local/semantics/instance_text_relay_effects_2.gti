// Instance text relay effects: the same payload/accessor relay permits disjoint TLS mutation through both concrete query orders.
//@ check-pass
//@ execution-profile: concurrent
//@ require-function-definitions
import std.panic;
import std.string;
thread_local mut std::string value{"owned text"};
thread_local mut std::string other{"other text"};
void modify() { value.append("!"); }
enum Slot<T> { full(T value), empty };
class Holder<T> {
public:
  Slot<T> slot;
  Holder(T value) : slot(Slot<T>::full(std::move(value))) {}
  T& get() {
    switch (this.slot) {
    case Slot<T>::full(auto& value): return value;
    case Slot<T>::empty: std::panic("empty holder");
    }
  }
  T& again() { return this.get(); }
};
int selected<uint64_t Mode>() {
  if constexpr (Mode == 0) {
    int first = 0;
    int second = 1;
    int third = 2;
    return first + second + third;
  } else {
    modify();
    return 1;
  }
}
int main() { Holder<std::string_view> held = Holder<std::string_view>(other.view()); std::string_view borrowed = held.again(); int first = selected<0>(); int second = selected<1>(); return borrowed.empty() ? first : second; }
