// Deferred probe isolation: actually forced deferred temporary cleanup conflicts with the retained TLS origin in either query order.
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int value = 1;
thread_local mut int other = 2;
void modify() { value = 2; }
struct Cleanup { ~Cleanup() { modify(); }  public: Cleanup() = default; };
bool inspect(Cleanup& input) { return true; }
void observe(bool value) {}
#macro ignore(bool value) {}
#macro force(bool value) { observe(value); }

int selected<uint64_t Mode>() {
  if constexpr (Mode == 0) {
    int first = 0;
    int second = 1;
    int third = 2;
    ignore!(inspect(Cleanup()));
    return first + second + third;
  } else {
force!(inspect(Cleanup())); return 1; } }int main() { int& borrowed = value; int first = selected<1>(); int second = selected<0>(); return borrowed + first + second; }  //~ ERROR GTI-S2045
