// Lifetime and effects: constructors, operators, aggregate relays, forwarding and cleanup preserve persistent-loan protection.
//@ execution-profile: concurrent
thread_local mut int value = 1;
void modify() { value = 2; }
struct Cleanup { ~Cleanup() { modify(); }  public: Cleanup() = default; }; int main() { mut Cleanup destination{}; int& borrowed = value; destination = Cleanup(); return borrowed; }  //~ ERROR GTI-S2045
