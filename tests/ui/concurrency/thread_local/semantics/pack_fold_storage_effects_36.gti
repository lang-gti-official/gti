// Pack fold storage effects: an empty fold does not initialize any later fixed TLS input.
//@ check-pass
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int32_t first = 1;
thread_local mut int32_t other = 2;
int32_t initialize() { return first; } thread_local mut int32_t later = initialize(); void leaf<T>(mut int32_t& input, int32_t& second, T& element) {} void folded<Args...>(Args... args) { (leaf(first, later, args), ...); } int main() { folded(); return 0; }
