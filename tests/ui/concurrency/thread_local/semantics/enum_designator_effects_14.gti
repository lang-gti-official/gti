// Enum designator effects: an owning local's scope cleanup conflicts with a reference that is used after that scope ends.
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int32_t guarded = 1; thread_local mut int32_t other = 2; 
class Cleanup {
public:
  Cleanup() {}
  ~Cleanup() { guarded = 3; }
};
enum Payload { owned(Cleanup value), empty };

int main() {
  int32_t& held = guarded;
  { Payload owned = Payload::owned(Cleanup()); }  //~ ERROR GTI-S2045
  return held;
}
