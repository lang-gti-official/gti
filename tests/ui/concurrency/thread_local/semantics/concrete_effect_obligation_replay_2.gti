// Concrete effect obligation replay: a selected zero expansion replays the dependent obligation without executing a hidden conflicting write in either declaration order.
//@ check-pass
//@ require-function-definitions
mut int32_t guarded = 1; mut int32_t other = 2; mut int32_t third = 3; void leaf<T>(int32_t& fixed, T& element) { guarded = 9; }
void selected<Args...>(Args... args) {
  int32_t& fixed = guarded;
  (leaf(fixed, args), ...);
}
int main() { selected(); return 0; }
