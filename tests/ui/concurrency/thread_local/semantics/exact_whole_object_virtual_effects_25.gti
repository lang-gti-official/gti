// Exact whole object virtual effects: under-construction this does not establish a complete dynamic class or erase the unresolved virtual boundary.
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int guarded = 1; thread_local mut int other = 2; 
class Base { public: virtual int read() { return 1; }  public: Base() = default; };
class Reader : public Base {
public:
  Reader() {
    int& held = guarded;
    int result = this.read();  //~ ERROR GTI-S2045
    if (result == held) {}
  }
  int read() override { return 2; }
};
int main() { Reader reader{}; return 0; }
