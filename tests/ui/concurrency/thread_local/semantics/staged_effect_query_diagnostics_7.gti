// Staged effect query diagnostics: an invalid runtime effect query cannot contaminate a different valid staged key or permit MIR in either demand order.
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int guarded = 1;
class Selected<T, uint64_t Width> {
public:
  int value;
  constexpr Selected(int input) : value(input) {
    static_assert(sizeof(T) == Width, "staged exact body");  //~ ERROR GTI-S2079
  }
};
constexpr int read<T, uint64_t Width>() {
  Selected<T, Width> value{42};
  return value.value;
}

void check<T, uint64_t Width>() {
  static_assert(read<T, Width>() == 42, "staged exact value");
}
int runtime() { Selected<int64_t, 4> value{1}; return value.value; } int main() { int& held = guarded; check<int32_t, 4>(); return runtime() + held; }
