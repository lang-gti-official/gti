// Deferred probe isolation: deferred probe isolation preserves disjoint-owner execution through both concrete query orders.
//@ check-pass
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int value = 1;
thread_local mut int other = 2;
void modify() { value = 2; }
struct Cleanup { ~Cleanup() { modify(); }  public: Cleanup() = default; };
bool inspect(Cleanup& input) { return true; }
void observe(bool value) {}
#macro ignore(bool value) {}
#macro force(bool value) { observe(value); }

int selected<uint64_t Mode>() {
  if constexpr (Mode == 0) {
    int first = 0;
    int second = 1;
    int third = 2;
    ignore!(inspect(Cleanup()));
    return first + second + third;
  } else {
ignore!(inspect(Cleanup())); bool seen = inspect(Cleanup()); return seen ? 1 : 0; } }int main() { int& borrowed = other; int first = selected<1>(); int second = selected<0>(); return borrowed + first + second; }
