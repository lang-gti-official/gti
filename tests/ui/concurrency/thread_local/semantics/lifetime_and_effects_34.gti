// Lifetime and effects: TLS first-use initializer effects cannot hide a conflicting storage access.
//@ execution-profile: concurrent
thread_local mut int value = 1;
void modify() { value = 2; }
int initialize() { modify(); return 4; } int read() { thread_local mut int other = initialize(); return other; } int main() { int& borrowed = value; int copied = read(); return borrowed + copied; }  //~ WARN GTI-S2096 //~ ERROR GTI-S2045
