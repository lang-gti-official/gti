// Pack fold storage effects: an exclusive direct persistent fixed input protects against its own target's hidden read.
//@ require-function-definitions
mut int32_t guarded = 1; mut int32_t other = 2;
void read(int32_t& input) { int32_t copy = input; }
void leaf<T>(mut int32_t& input, T& element) { read(guarded); input += 1; }
void folded<Args...>(Args... args) { (leaf(guarded, args), ...); }  //~ ERROR GTI-S2045
int main() { folded(1); return 0; }
