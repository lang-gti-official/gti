// Requirement probe isolation: requirement probes preserve disjoint-owner effects in both concrete query orders without importing caller cleanup frames.
//@ check-pass
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int value = 1;
thread_local mut int other = 2;
void modify() { value = 2; }
struct Cleanup { ~Cleanup() { modify(); }  public: Cleanup() = default; };
bool inspect(Cleanup& input) { return true; }
bool with_flag(Cleanup& input, bool flag) { return flag; }

int selected<uint64_t Mode>() {
  if constexpr (Mode == 0) {
    int first = 0;
    int second = 1;
    int third = 2;
    bool checked = requires { { inspect(Cleanup()) } -> bool; };
    return checked ? first + second + third : 0;
  } else {
bool checked = requires { { inspect(Cleanup()) } -> bool; }; bool seen = inspect(Cleanup()); return checked && seen ? 1 : 0; } }int main() { int& borrowed = other; int first = selected<0>(); int second = selected<1>(); return borrowed + first + second; }
