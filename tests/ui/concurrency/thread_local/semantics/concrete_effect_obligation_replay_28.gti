// Concrete effect obligation replay: query-qualified local effect owners preserve distinct disjoint lambda specializations in both orders.
//@ check-pass
//@ execution-profile: concurrent
//@ require-function-definitions
thread_local mut int32_t guarded = 1; thread_local mut int32_t other = 2; thread_local mut int32_t third = 3;
void selected<uint64_t Mode>() {
  if constexpr (Mode < 2) {
    int32_t& held = guarded;
    auto hidden = []() -> void {
      if constexpr (Mode == 0) { other = 9; }
      else { third = 9; }
    };
    hidden();
    int32_t copy = held;
  }
}
int main() { selected<1>(); selected<0>(); return 0; }
