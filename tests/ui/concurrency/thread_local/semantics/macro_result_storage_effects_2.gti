// Macro result storage effects: discarding a real owning macro result executes its conflicting cleanup before the persistent loan ends.
//@ require-function-definitions
mut int guarded = 1; mut int other = 2; mut int third = 3;
struct Cleanup {
  Cleanup() {}
  Cleanup(Cleanup& other) = delete;
  Cleanup(Cleanup&& other) = default;
  ~Cleanup() { guarded = 9; }
};
#macro Cleanup owned() { return Cleanup(); }
#macro Cleanup nested_owned() { return owned!(); }

int main() {
  int& held = guarded;
  [[discard]] nested_owned!();  //~ ERROR GTI-S2045
  return held;
}
