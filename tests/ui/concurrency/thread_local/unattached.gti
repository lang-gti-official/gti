// A thread-local read from a foreign, unattached thread reports GTI-R0013.
//@ run-fail
//@ exit-code: 70
//@ stderr-contains: GTI-R0013
// --- main.gti
import std.format;
class State {
  int32_t id;
public:
  State(int32_t id) : id(id) { std::println("init {}", this.id); }
  int32_t read() { return this.id; }
  ~State() { std::println("drop {}", this.id); }
};
thread_local mut State first = State(1);
thread_local mut State second = State(2);
thread_local mut State unused = State(99);
using Callback = () -> int32_t;
extern "C" { void gti_tls_call_unattached(Callback callback); }
int32_t read_state() { return first.read(); }
int main() {
  unsafe { gti_tls_call_unattached(read_state); }
  return 0;
}
// --- unattached.cpp
#include <cstdint>
#include <thread>

extern "C" void gti_tls_call_unattached(std::int32_t (*callback)()) {
  // Deliberately bypass GTI's checked manual/managed entry protocol. The test
  // proves first-use rejection before constructor effects or registration.
  std::thread foreign([=] { (void)callback(); });
  foreign.join();
}
