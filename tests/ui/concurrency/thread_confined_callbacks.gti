// Thread-confined native callbacks: binding, foreign-thread rejection and the failure firewall.
//@ run-pass
//@ revisions: mode0 mode1 mode2 mode3 mode4 mode5
//@ execution-profile: concurrent
//@[mode0] env: GTI_CONFINED_TEST_MODE=0
//@[mode1] run-fail
//@[mode1] exit-code: 86
//@[mode1] env: GTI_CONFINED_TEST_MODE=1
//@[mode2] run-fail
//@[mode2] exit-code: 70
//@[mode2] env: GTI_CONFINED_TEST_MODE=2
//@[mode2] stdout: callback-cleaned
//@[mode2] stderr-contains: GTI-R0002
//@[mode3] run-fail
//@[mode3] exit-code: 86
//@[mode3] env: GTI_CONFINED_TEST_MODE=3
//@[mode4] run-fail
//@[mode4] exit-code: 70
//@[mode4] env: GTI_CONFINED_TEST_MODE=4
//@[mode4] stdout: callback-cleaned
//@[mode4] stderr-contains: GTI-R0002
//@[mode5] run-fail
//@[mode5] exit-code: 86
//@[mode5] env: GTI_CONFINED_TEST_MODE=5
// --- thread_confined_callbacks.gti
import std.cthread;
import std.thread;
using Transform = (int32_t) -> int32_t;
extern "C" {
  int32_t confined_mode();
  int32_t confined_invoke(Transform callback, int32_t value);
  int32_t confined_foreign(Transform callback);
  void confined_save(Transform callback);
  int32_t confined_saved();
  int32_t confined_zero();
  void confined_clean();
}
class Guard { public: Guard() {} ~Guard() { confined_clean(); } };
[[thread_confined_callback]] int32_t identity(int32_t value) { return value; }
[[thread_confined_callback]] int32_t worker_identity(int32_t value) { return value; }
[[thread_confined_callback]] int32_t failure(int32_t value) {
  Guard guard{};
  return value / confined_zero();
}
[[thread_confined_callback]] int32_t nested(int32_t value) {
  unsafe { return confined_invoke(identity, value); }
}
int main() {
  int32_t mode = confined_mode();
  Transform callback = identity;
  if (mode == 1) { unsafe { return confined_foreign(callback); } }
  if (mode == 2) { unsafe { return confined_invoke(failure, 1); } }
  if (mode == 0) {
    unsafe {
      if (confined_invoke(callback, 7) != 7) { return 1; }
      if (confined_invoke(nested, 9) != 9) { return 2; }
      if (confined_invoke(identity, 11) != 11) { return 3; }
    }
  }
  mut std::thread_result<int32_t> worker{};
  auto started = worker.start([mode]() -> int32_t {
    if (mode == 3) {
      // The conversion itself must fail, even though its result is unused.
      Transform wrong = identity;
      return 3;
    }
    unsafe {
      if (mode == 4) { return confined_invoke(failure, 1); }
      if (mode == 5) { confined_save(worker_identity); return 0; }
      return confined_invoke(worker_identity, 0);
    }
  });
  if (!started.has_value()) { return 4; }
  auto joined = worker.join();
  if (!joined.has_value()) { return 5; }
  if (mode == 5) { return confined_saved(); }
  return joined.value();
}
// --- thread_confined_context.cpp
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <exception>
#include <thread>
using Transform = std::int32_t (*)(std::int32_t);
static Transform saved = nullptr;
extern "C" std::int32_t confined_mode() {
  std::set_terminate([] { std::_Exit(86); });
  const char *mode = std::getenv("GTI_CONFINED_TEST_MODE");
  return mode ? std::atoi(mode) : 0;
}
extern "C" std::int32_t confined_invoke(Transform callback,
                                        std::int32_t value) {
  return callback(value);
}
extern "C" std::int32_t confined_foreign(Transform callback) {
  std::thread worker([=] { (void)callback(1); });
  worker.join();
  return 9;
}
extern "C" void confined_save(Transform callback) { saved = callback; }
extern "C" std::int32_t confined_saved() { return saved(1); }
extern "C" std::int32_t confined_zero() { return 0; }
extern "C" void confined_clean() {
  std::puts("callback-cleaned");
  std::fflush(stdout);
}
