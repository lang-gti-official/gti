// Semantic boundaries: an outstanding guard should statically exclude moving its owner.
//@ execution-profile: concurrent
import std.mutex;
int main() {
  std::mutex<int32_t> value{1};
  std::mutex_guard<int32_t> guard = value.lock();
  std::mutex<int32_t> moved = std::move(value);  //~ ERROR GTI-S2017
  return 0;
}
