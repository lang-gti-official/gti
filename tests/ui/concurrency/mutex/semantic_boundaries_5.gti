// Semantic boundaries: an outstanding guard should statically exclude relocking its owner.
//@ execution-profile: concurrent
import std.mutex;
int main() {
  std::mutex<int32_t> value{1};
  std::mutex_guard<int32_t> first = value.lock();
  std::mutex_guard<int32_t> second = value.lock();  //~ ERROR GTI-S2017
  return 0;
}
