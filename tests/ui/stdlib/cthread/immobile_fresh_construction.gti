// An immobile object constructed fresh in place needs no move.
//@ run-pass
//@ execution-profile: concurrent
// --- immobile_fresh_construction.gti
// Ordinary construction does not transfer an existing object's identity.
class Stationary {
public:
  int32_t value;
  Stationary(int32_t initial) : value(initial) {}
  Stationary(Stationary& other) = delete;
  Stationary(Stationary&& other) = delete;
};
Stationary shared{41};

class Value {
public:
  mut int32_t value;
  Value(int32_t initial) : value(initial) {}
};
class Snapshot {
public:
  int32_t observed;
  Snapshot(Value copied, int32_t ignored) : observed(copied.value) {}
};
int32_t change(mut Value& value) { value.value = 9; return 0; }

int main() {
  Stationary local = Stationary(42);
  mut Value value{7};
  Snapshot snapshot{value, change(value)};
  return shared.value == 41 && local.value == 42 &&
         snapshot.observed == 7 && value.value == 9 ? 0 : 1;
}
// --- cthread_once_context.cpp
#include "gti/cthread.h"
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <exception>
#include <thread>
namespace {
std::int32_t counts[4] = {};
}
extern "C" void once_arrive() {
  static std::atomic<int> arrived{0};
  arrived.fetch_add(1);
  while (arrived.load() != 8) {
    std::this_thread::yield();
  }
}
extern "C" void once_write(std::int32_t slot) { ++counts[slot]; }
extern "C" std::int32_t once_read(std::int32_t slot) { return counts[slot]; }
extern "C" std::int32_t once_zero() { return 0; }
extern "C" void once_cleanup() {
  std::fputs("once-cleaned\n", stdout);
  std::fflush(stdout);
}
extern "C" void once_owner_cleanup() {
  std::fputs("owner-cleaned\n", stdout);
  std::fflush(stdout);
}
extern "C" void once_terminal() {
  std::set_terminate([] { std::_Exit(86); });
}
extern "C" void once_unregistered(gti_once_initializer_v1 callback) {
  callback();
}
extern "C" void once_foreign(gti_once_initializer_v1 callback) {
  std::thread worker([=] { gti_rt_once_invoke_v1(callback); });
  worker.join();
}
