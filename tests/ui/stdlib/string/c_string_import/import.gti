// Inbound C strings copy exact bytes and own their storage.
//@ run-pass
//@ stdout: live=0
// --- c_string_import.gti
import std.string;
import std.memory;
import std.panic;

using ErrorCallback = (int32_t, c_string) -> void;
extern "C" {
  c_string foreign_message();
  c_string foreign_owned_message();
  void foreign_release_message(c_string text);
  int32_t foreign_live_owners();
  c_string foreign_empty();
  c_string foreign_embedded();
  c_string foreign_bytes();
  c_string foreign_large();
  void foreign_size_limit(uint64_t limit);
  void foreign_rewrite();
  void foreign_callback(ErrorCallback callback);
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
  uint64_t adoption_bytes();
  void adoption_fail_at(uint64_t allocation);
  void adoption_check_cleanup();
}

// Native bytes have an external lifetime contract. This ordinary RAII
// wrapper retains the native pointer and releases it after copying.
class NativeText {
  c_string text;
public:
  unsafe NativeText(c_string input) : text(input) {}
  NativeText(NativeText&) = delete;
  NativeText(NativeText&&) = delete;
  ~NativeText() { foreign_release_message(this.text); }
  std::string copy() {
    if (this.text == nullptr) { return std::string(); }
    unsafe { return std::string(this.text); }
  }
};

void receive_error(int32_t code, c_string description) {
  unsafe {
    auto copied = std::string(description);
    if (code != 7 || copied.view() != "callback description") {
      std::panic("Callback text mismatch");
    }
  }
}

int main() {
  unsafe {
    {
      auto owned = NativeText(foreign_owned_message());
      auto copied_native = owned.copy();
      if (foreign_live_owners() != 1 || copied_native.view() != "native") { return 16; }
      auto absent = NativeText(nullptr);
      auto copied_absent = absent.copy();
      if (!copied_absent.empty()) { return 17; }
    }
    if (foreign_live_owners() != 0) { return 18; }
    c_string no_address = nullptr;
    if (std::c_string_bytes(no_address) != nullptr) { return 14; }
    const uint8_t* address = std::c_string_bytes(foreign_message());
    if (address[0] != uint8_t('G')) { return 15; }
    // Failure is recoverable and does not leak or abort.
    adoption_fail_at(uint64_t(1));
    {
      auto failed = std::string::try_from_c_string(foreign_message());
      if (failed || failed.error() != std::c_string_errc::resource_exhausted) { return 1; }
    }
    adoption_count_end();
    adoption_check_cleanup();

    foreign_size_limit(uint64_t(3));
    auto overflow = std::string::try_from_c_string(foreign_message());
    foreign_size_limit(uint64_t(0));
    if (overflow || overflow.error() != std::c_string_errc::size_overflow) { return 11; }

    adoption_count_begin();
    auto null_text = std::string::try_from_c_string(nullptr);
    auto empty = std::string::try_from_c_string(foreign_empty());
    auto empty_owned = std::string(foreign_empty());
    if (null_text || null_text.error() != std::c_string_errc::null_pointer) { return 2; }
    if (!empty || empty.value().size() != uint64_t(0) || empty_owned.size() != uint64_t(0)) { return 3; }
    if (adoption_allocations() != uint64_t(0)) { return 4; }
    adoption_count_end();

    adoption_count_begin();
    auto text = std::string(foreign_message());
    if (adoption_allocations() != uint64_t(1) || adoption_bytes() != uint64_t(11)) { return 5; }
    adoption_count_end();
    foreign_rewrite();
    if (text.view() != "GLFW error") { return 6; }

    auto terminated = std::string(foreign_embedded());
    if (terminated.view() != "one") { return 7; }
    auto binary = std::string::try_from_c_string(foreign_bytes());
    if (!binary || binary.value().size() != uint64_t(255)) { return 8; }
    for (mut uint64_t i = 0; i < uint64_t(255); i++) {
      if (binary.value()[i] != char(uint8_t(i + uint64_t(1)))) { return 9; }
    }
    foreign_callback(receive_error);

    adoption_count_begin();
    auto large = std::string::try_from_c_string(foreign_large());
    if (!large || large.value().size() != uint64_t(65536) ||
        large.value()[uint64_t(65535)] != 'x') { return 12; }
    if (adoption_allocations() != uint64_t(1) || adoption_bytes() != uint64_t(65537)) { return 13; }
    adoption_count_end();

    mut std::string owner{"owned input"};
    mut std::string copied{};
    {
      c_string pointer = owner.c_string();
      copied = std::string(pointer);
    }
    owner.clear();
    if (copied.view() != "owned input") { return 10; }
  }
  return 0;
}
// --- c_string_import.cpp
#include <cstdint>
#include <cstdlib>
#include <cstring>

namespace {
char message[] = "GLFW error";
std::int32_t nativeOwners = 0;
char bytes[256]{};
char large[65537]{};
} // namespace
extern "C" const char *foreign_message() { return message; }
extern "C" void foreign_rewrite() { message[0] = 'X'; }
extern "C" const char *foreign_empty() { return ""; }
extern "C" const char *foreign_embedded() { return "one\0two"; }
extern "C" const char *foreign_bytes() {
  for (unsigned i = 1; i < 256; ++i)
    bytes[i - 1] = static_cast<char>(i);
  return bytes;
}
extern "C" void foreign_callback(void (*callback)(std::int32_t, const char *)) {
  callback(7, "callback description");
}
extern "C" const char *foreign_large() {
  for (unsigned i = 0; i < 65536; ++i)
    large[i] = 'x';
  return large;
}

extern "C" const char *foreign_owned_message() {
  char *text = static_cast<char *>(std::malloc(7));
  if (text != nullptr) {
    std::memcpy(text, "native", 7);
    ++nativeOwners;
  }
  return text;
}
extern "C" void foreign_release_message(const char *text) {
  if (text != nullptr) {
    --nativeOwners;
    std::free(const_cast<char *>(text));
  }
}
extern "C" std::int32_t foreign_live_owners() { return nativeOwners; }
// --- c_string_allocation_provider.cpp
// Reuse the established process-allocation oracle, with a controllable native
// size limit to test overflow without scanning an impossibly large object.
#define gti_rt_native_size_max_v1 original_native_size_max
#include "allocation_counts.h"
#undef gti_rt_native_size_max_v1

namespace {
std::uint64_t selected_limit = 0;
}
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return selected_limit ? selected_limit : original_native_size_max();
}
extern "C" void foreign_size_limit(std::uint64_t limit) {
  selected_limit = limit;
}
// --- allocation_counts.h
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <new>
#if defined(_WIN32)
#include <malloc.h>
#else
#include <sys/resource.h>
#endif

namespace {
// Cleanup markers must remain visible even when exhaustion immediately aborts.
struct ConfigureAllocationProcess {
  ConfigureAllocationProcess() {
    std::setvbuf(stdout, nullptr, _IONBF, 0);
#if !defined(_WIN32)
    const rlimit limit{0, 0};
    setrlimit(RLIMIT_CORE, &limit);
#endif
  }
} configureAllocationProcess;
bool enabled = false;
std::uint64_t allocations = 0;
std::uint64_t bytes = 0;
std::uint64_t fail_at = 0;
bool audit_cleanup = false;
enum class Path { LegacyAligned, Process };
struct Region {
  void *address = nullptr;
  Path path = Path::Process;
  bool audited = false;
};
Region regions[4096]{};
std::size_t live_count = 0;

bool failed_attempt(std::size_t size) {
  if (!enabled)
    return false;
  ++allocations;
  bytes += size;
  if (fail_at == 0 || allocations != fail_at)
    return false;
  fail_at = 0; // Cleanup can itself print through allocating library code.
  return true;
}

void remember(void *address, Path path) {
  if (!address)
    return;
  for (const auto &region : regions)
    if (region.address == address)
      std::abort();
  for (auto &region : regions) {
    if (!region.address) {
      // Startup argv allocations precede the observation window. Track their
      // exact release too, without including them in scenario counts/leaks.
      region = {address, path, audit_cleanup};
      live_count += audit_cleanup ? 1 : 0;
      return;
    }
  }
  std::abort(); // Never silently lose a live allocation's identity.
}

void retire(void *address, Path path) {
  if (!address)
    return;
  for (auto &region : regions) {
    if (region.address == address) {
      if (region.path != path)
        std::abort();
      if (region.audited) {
        if (live_count == 0)
          std::abort();
        --live_count;
      }
      region = {};
      return;
    }
  }
  std::abort(); // A wrong-provider, untracked or duplicate release is a bug.
}
} // namespace

void *operator new(std::size_t size, std::align_val_t alignment,
                   const std::nothrow_t &) noexcept {
  if (failed_attempt(size))
    return nullptr;
  void *result = nullptr;
  const auto aligned = static_cast<std::size_t>(alignment);
#if defined(_WIN32)
  result = _aligned_malloc(size,
                           aligned < sizeof(void *) ? sizeof(void *) : aligned);
#else
  if (posix_memalign(&result,
                     aligned < sizeof(void *) ? sizeof(void *) : aligned,
                     size) != 0)
    return nullptr;
#endif
  remember(result, Path::LegacyAligned);
  return result;
}

void operator delete(void *pointer, std::align_val_t) noexcept {
  retire(pointer, Path::LegacyAligned);
#if defined(_WIN32)
  _aligned_free(pointer);
#else
  std::free(pointer);
#endif
}

// Inject the real source process-provider boundary, rather than observing an
// obsolete container representation's allocation implementation. These exact
// adapters avoid pulling the production adapter object from the runtime
// archive.
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return (std::numeric_limits<std::size_t>::max)();
}
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t size,
                                          std::uint64_t alignment) {
  if (failed_attempt(static_cast<std::size_t>(size)))
    return nullptr;
  void *address = _aligned_malloc(static_cast<std::size_t>(size),
                                  static_cast<std::size_t>(alignment));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  retire(address, Path::Process);
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  if (failed_attempt(static_cast<std::size_t>(bytes)))
    return nullptr;
  void *address = std::malloc(static_cast<std::size_t>(bytes));
  remember(address, Path::Process);
  return address;
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t size,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  if (failed_attempt(static_cast<std::size_t>(size))) {
    *status = ENOMEM;
    return nullptr;
  }
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(size));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) {
  retire(address, Path::Process);
  std::free(address);
}
#endif

extern "C" void adoption_count_begin() {
  allocations = 0;
  bytes = 0;
  enabled = true;
}
extern "C" void adoption_count_end() { enabled = false; }
extern "C" void adoption_trace(std::int32_t value) {
  std::printf("%d\n", static_cast<int>(value));
}
extern "C" std::uint64_t adoption_allocations() { return allocations; }
extern "C" std::uint64_t adoption_bytes() { return bytes; }
extern "C" void adoption_fail_at(std::uint64_t allocation) {
  if (live_count != 0)
    std::abort(); // Reset must never erase leaks from an earlier failure
                  // window.
  adoption_count_begin();
  fail_at = allocation;
  audit_cleanup = true;
}
// Called by the outermost GTI guard after URL and temporary cleanup. GTI's
// terminal failure deliberately does not run unmanaged C++ static destructors.
extern "C" void adoption_check_cleanup() {
  std::printf("live=%zu\n", live_count);
  audit_cleanup = false;
}
