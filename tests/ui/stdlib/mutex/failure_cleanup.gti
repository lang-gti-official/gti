// A worker failing while holding a guard unlocks the mutex before the failure propagates.
//@ run-fail
//@ execution-profile: concurrent
//@ exit-code: 70
//@ stdout: waiter acquired
//@ stderr-contains: mutex_failure_cleanup.gti:13: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- mutex_failure_cleanup.gti
import std.atomic;
import std.mutex;
import std.thread;

std::mutex<int32_t> protected_value{0};
std::atomic<bool> worker_locked{false};

int main() {
  auto worker_started = std::thread::start([]() -> void {
    mut std::mutex_guard<int32_t> guard = protected_value.lock();  //~ WARN GTI-S2096
    worker_locked.store(true);
    int32_t zero = 0;
    int32_t failed = 1 / zero;
  });
  if (!worker_started.has_value()) { return 1; }
  mut std::thread worker = std::move(worker_started).value();

  while (!worker_locked.load()) {}
  auto waiter_started = std::thread::start([]() -> void {
    std::mutex_guard<int32_t> guard = protected_value.lock();
    std::println("waiter acquired");
  });
  if (!waiter_started.has_value()) { return 2; }
  mut std::thread waiter = std::move(waiter_started).value();  //~ WARN GTI-S2096

  auto worker_joined = worker.join();
  return 3;
}
