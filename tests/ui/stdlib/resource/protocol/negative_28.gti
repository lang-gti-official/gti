// Negative: a live vector element prevents owner invalidation: values.try_reserve(std::size_t(8)).value();.
import std.resource;
import std.memory;

import std.resource_vector;
int use(std::resource_ref<std::process_resource> resource) {
  mut std::resource_vector<int,std::process_resource> values{resource};
  values.emplace_back(42);
  int& element = values.get(std::size_t(0));
values.try_reserve(std::size_t(8)).value();  //~ ERROR GTI-S2017
  return element;

}
int main() { return 0; }
