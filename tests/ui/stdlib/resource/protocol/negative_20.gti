// Negative: a live element borrow prevents invalidation: slots.try_reserve_prefix(std::size_t(8), std::size_t(1)).value();.
import std.resource;
import std.memory;

int use(std::resource_ref<std::process_resource> resource) {
  mut std::resource_storage<int,std::process_resource> slots{resource};
  slots.try_allocate(std::size_t(1)).value();
  slots.emplace(std::size_t(0),42);
  int& element = slots.get(std::size_t(0));
slots.try_reserve_prefix(std::size_t(8), std::size_t(1)).value();  //~ ERROR GTI-S2017
  return element;
}
int main() { return 0; }
