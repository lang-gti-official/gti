// Negative: an element reference cannot escape its local container.
import std.resource;
import std.memory;

import std.resource_vector;
int& leak(std::resource_ref<std::process_resource> resource) {
  mut std::resource_vector<int,std::process_resource> values{resource};
  values.emplace_back(42);
  return values.get(std::size_t(0));  //~ ERROR GTI-S2017
}
int main() { return 0; }
