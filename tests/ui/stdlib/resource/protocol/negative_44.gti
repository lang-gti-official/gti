// Negative: a growable container rejects elements it would need to relocate.
import std.resource;
import std.memory;

import std.resource_vector;
struct Resource {
  unsafe expected<std::raw_allocation,std::alloc_errc> allocate(std::layout request) {
    return unexpected(std::alloc_errc::resource_exhausted);
  }
  unsafe void release(std::raw_allocation allocation) {}
  void reset() mut {}
public:
  Resource() = default;
};
class Fixed {
  int value;
public:
  Fixed(int value) : value(value) {}
  Fixed(Fixed& other) = delete;
  Fixed(Fixed&& other) = delete;
};

int use(std::resource_ref<Resource> resource) {
  std::resource_vector<Fixed,Resource> values{resource};  //~ ERROR GTI-S2029
  return 0;
}
int main() { return 0; }
