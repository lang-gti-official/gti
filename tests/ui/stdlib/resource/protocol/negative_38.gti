// Negative: a live vector element prevents growth or mutable access: values.push_back(7);.
import std.resource;
import std.memory;

import std.resource_vector;
int use(std::resource_ref<std::process_resource> resource) {
  mut std::resource_vector<int,std::process_resource> values{resource};
  values.emplace_back(42);
  int& element = values.get(std::size_t(0));
  values.push_back(7);  //~ ERROR GTI-S2017
  return element;
}
int main() { return 0; }
