// A borrowed writer uses the owner's buffer, formatting, width, and position.
//@ run-pass
import std.ostream;
import std.io;
import std.memory;

void write_value(mut std::ostream out) {
  out << std::setw(3) << 31 << ' ';
  out.put('x').flush();
}

int main() {
  mut std::byte_buffer bytes{std::size_t(6)};
  {
    mut auto buffer = std::io::memory_stream(bytes.as_mutable_span());
    mut std::basic_ostream<std::io::memory_stream> output{std::move(buffer)};
    output << std::hex << std::uppercase << std::setfill('_');
    write_value(output.as_ostream());
    if (!output.good() || output.width() != 0 || output.tellp() != 5) { return 1; }
    output << 15;
  }
  std::string_view expected = "_1F xF";
  for (mut std::size_t i = 0; i < expected.size(); i++) {
    if (bytes[i] != uint8_t(expected[i])) { return 2; }
  }
  return 0;
}
