// Checked mutable slices and generic buffered transports execute through MIR.
//@ run-pass
//@ revisions: default constructor cleanup-fails forward-copied-error forward-cleanup-can-fail
//@[default] stdout: 1
//@[default] stdout: 2
//@[default] stdout: 3
//@[constructor] run-fail
//@[constructor] args: constructor
//@[constructor] exit-code: 70
//@[constructor] stdout: 2
//@[constructor] stderr-contains: passive_error_cleanup.gti:7: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[cleanup-fails] run-fail
//@[cleanup-fails] args: cleanup fails
//@[cleanup-fails] exit-code: 70
//@[cleanup-fails] stdout: 1
//@[cleanup-fails] stdout: 2
//@[cleanup-fails] stderr-contains: passive_error_cleanup.gti:16: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[forward-copied-error] args: forward copied error
//@[forward-copied-error] stdout: 1
//@[forward-copied-error] stdout: 2
//@[forward-copied-error] stdout: 2
//@[forward-copied-error] stdout: 4
//@[forward-cleanup-can-fail] run-fail
//@[forward-cleanup-can-fail] args: forward cleanup can fail
//@[forward-cleanup-can-fail] exit-code: 70
//@[forward-cleanup-can-fail] stdout: 1
//@[forward-cleanup-can-fail] stdout: 2
//@[forward-cleanup-can-fail] stdout: 2
//@[forward-cleanup-can-fail] stderr-contains: passive_error_cleanup.gti:16: runtime error[GTI-R0002]: division_by_zero in integer_division
// --- passive_error_cleanup.gti
import std.string;
import std.vector;

// The payload owns nothing, but its construction has observable effects.
struct Failure {
  int code;
  Failure(int divisor) : code(9 / divisor) { std::println(1); }
};

class Guard {
  int divisor;
public:
  Guard(int divisor) : divisor(divisor) {}
  ~Guard() {
    std::println(2);
    int checked = 7 / this.divisor;
  }
};

expected<int, Failure> operation(int constructor_divisor, int cleanup_divisor) {
  Guard guard{cleanup_divisor};
  std::string local{"owning local"};
  auto view = local.view();
  if (view.empty()) { return 0; }
  return unexpected(Failure(constructor_divisor));
}

expected<int, Failure> forward(int cleanup_divisor) {
  auto result = operation(1, 1);
  Guard guard{cleanup_divisor};
  return unexpected(result.error());
}

int main(int argc, std::vector<std::string> argv) {
  if (argc >= 4) {
    auto forwarded = forward(argc == 4 ? 1 : 0);
    if (forwarded || forwarded.error().code != 9) { return 2; }
    std::println(4);
    return 0;
  }
  auto result = operation(argc == 2 ? 0 : 1, argc == 3 ? 0 : 1);
  if (result || result.error().code != 9) { return 1; }
  std::println(3);
  return 0;
}
