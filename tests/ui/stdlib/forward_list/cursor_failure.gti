// Misusing a forward_list cursor fails with GTI-R0016 after exact cleanup.
//@ run-fail
//@ exit-code: 70
//@ stdout: 3
//@ stdout: 2
//@ stdout: 1
//@ stdout: cleaned
//@ stderr-contains: : runtime error[GTI-R0016]: invalid_container_argument in container_argument
//@ revisions: f0 f1 f2 f3 f4
//@[f1] args: fail
//@[f2] args: fail fail
//@[f3] args: fail fail fail
//@[f4] args: fail fail fail fail
import std.forward_list;
import std.string;
import std.vector;
import std.array;
import std.algorithm;

class TraversalGuard {
public:
  ~TraversalGuard() { std::println("cleaned"); }
public:
  TraversalGuard() = default;
};

class TrackedNode {
public:
  int32_t identity;
  TrackedNode(int32_t identity) : identity(identity) {}
  TrackedNode(TrackedNode& other) = delete;
  TrackedNode(TrackedNode&& other) = delete;
  ~TrackedNode() { std::println(this.identity); }
};

int main(int argc, std::vector<std::string> argv) {
  TraversalGuard guard{};
  mut std::forward_list<TrackedNode> owned{};
  [[discard]] owned.emplace_front(1);
  [[discard]] owned.emplace_front(2);
  [[discard]] owned.emplace_front(3);
  mut std::forward_list<int32_t> values{};
  if (argc == 1) {
    auto empty = values.begin();
    return *empty;
  } else if (argc == 2) {
    mut auto empty = values.begin();
    ++empty;
  } else if (argc == 3) {
    mut auto empty = values.begin_mut();
    *empty = 1;
  } else if (argc == 4) {
    mut auto empty = values.begin_mut();
    ++empty;
  } else {
    values.push_front(0);
    std::array<int32_t, 2> source = std::array<int32_t, 2>({1, 2});
    std::copy(source.begin(), source.end(), values.begin_mut());
  }
  return 1;
}
