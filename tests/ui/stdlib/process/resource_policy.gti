// Process resource policy queries answer through a test resource provider.
//@ run-pass
// --- process_resource_policy.gti
import std.resource;
import std.memory;

extern "C" {
  void provider_test_mode(int32_t mode);
  int32_t provider_test_calls();
  int32_t provider_test_ordinary_calls();
  int32_t provider_test_releases();
  void free(void* address);
  int32_t provider_test_region(void* address, uint64_t bytes, uint64_t alignment);
}
#if target.os != "windows"
extern "C" {
  c_int posix_memalign(void** address, c_size_t alignment, c_size_t bytes);
}
#endif

int main() {
  std::process_resource provider{};
  unsafe {
    // The standard library must not reserve an application's libc binding.
    free(nullptr);
    provider_test_mode(0);
    auto bad_zero = provider.allocate(std::layout(uint64_t(0), uint64_t(0)));
    auto bad_three = provider.allocate(std::layout(uint64_t(16), uint64_t(3)));
    if (bad_zero || bad_zero.error() != std::alloc_errc::invalid_alignment) { return 1; }
    if (bad_three || bad_three.error() != std::alloc_errc::invalid_alignment) { return 2; }
    if (provider_test_calls() != 0) { return 3; }

    // Target layout determines the native limit. A host adapter cannot narrow
    // it; a separate source fault-injection case exercises the overflow branch.
    provider_test_mode(1);
    auto within_target = provider.allocate(std::layout(uint64_t(4096), uint64_t(8))).expect("target-sized allocation");
    // Force a real region: counting a replaceable process allocator does not
    // prohibit eliding an otherwise unused allocation/release pair.
    if (provider_test_region(within_target.address, within_target.bytes, within_target.alignment) != 0) { return 22; }
    provider.release(within_target);
    if (provider_test_calls() != 1 || provider_test_releases() != 1) { return 4; }
    provider_test_mode(0);

    auto empty = provider.allocate(std::layout(uint64_t(0), uint64_t(64))).expect("empty allocation");
    if (empty.address != nullptr || empty.bytes != 0 || empty.alignment != 64 || empty.id != 0) { return 7; }
    provider.release(empty);
    if (provider_test_calls() != 0 || provider_test_releases() != 0) { return 8; }

    provider_test_mode(0);
    auto first = provider.allocate(std::layout(uint64_t(13), uint64_t(1))).expect("first region");
    auto second = provider.allocate(std::layout(uint64_t(31), uint64_t(4096))).expect("second region");
    if (first.address == second.address || first.alignment != 1 || second.alignment != 4096) { return 9; }
    if (provider_test_region(first.address, first.bytes, first.alignment) != 0 ||
        provider_test_region(second.address, second.bytes, second.alignment) != 0) { return 10; }
    provider.release(first);
    provider.release(second);
    if (provider_test_calls() != 2 || provider_test_releases() != 2) { return 11; }

#if target.os != "windows"
    if (provider_test_ordinary_calls() != 1) { return 16; }
    provider_test_mode(0);
    uint64_t pointer_bytes = std::layout_of<void*>().bytes;
    uint64_t pointer_alignment = std::layout_of<void*>().alignment;
    auto fitting = provider.allocate(std::layout(pointer_bytes, pointer_alignment)).expect("pointer witness");
    if (provider_test_region(fitting.address, fitting.bytes, fitting.alignment) != 0) { return 23; }
    if (provider_test_ordinary_calls() != 1) { return 17; }
    provider.release(fitting);
    auto too_small = provider.allocate(std::layout(pointer_bytes - uint64_t(1), pointer_alignment)).expect("small aligned");
    if (provider_test_region(too_small.address, too_small.bytes, too_small.alignment) != 0) { return 24; }
    if (provider_test_ordinary_calls() != 1) { return 18; }
    provider.release(too_small);
    auto too_aligned = provider.allocate(std::layout(pointer_bytes, pointer_alignment * uint64_t(2))).expect("over aligned");
    if (provider_test_region(too_aligned.address, too_aligned.bytes, too_aligned.alignment) != 0) { return 25; }
    if (provider_test_ordinary_calls() != 1 || provider_test_calls() != 3) { return 19; }
    provider.release(too_aligned);
    if (provider_test_releases() != 3) { return 20; }
    provider_test_mode(2);
    auto ordinary_exhausted = provider.allocate(std::layout(uint64_t(1), uint64_t(1)));
    if (ordinary_exhausted) {
      auto& region = ordinary_exhausted.value();
      if (provider_test_region(region.address, region.bytes, region.alignment) != 0) { return 26; }
      provider.release(region);
      return 21;
    }
    if (ordinary_exhausted.error() != std::alloc_errc::resource_exhausted ||
        provider_test_ordinary_calls() != 1 || provider_test_releases() != 0) { return 21; }
#endif
    provider_test_mode(2);
    auto exhausted = provider.allocate(std::layout(uint64_t(16), uint64_t(8)));
    if (exhausted) {
      auto& region = exhausted.value();
      if (provider_test_region(region.address, region.bytes, region.alignment) != 0) { return 27; }
      provider.release(region);
      return 12;
    }
    if (exhausted.error() != std::alloc_errc::resource_exhausted) { return 12; }
#if target.os != "windows"
    provider_test_mode(3);
    auto invalid = provider.allocate(std::layout(uint64_t(16), uint64_t(4096)));
    if (invalid || invalid.error() != std::alloc_errc::invalid_alignment) { return 13; }
    provider_test_mode(4);
    auto other = provider.allocate(std::layout(uint64_t(16), uint64_t(4096)));
    if (other || other.error() != std::alloc_errc::invalid_region) { return 14; }
#endif
    provider_test_mode(5);
    auto null_success = provider.allocate(std::layout(uint64_t(16), uint64_t(4096)));
    if (null_success || null_success.error() != std::alloc_errc::resource_exhausted) { return 15; }
  }
  return 0;
}
// --- provider.cpp
#include <array>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdlib>
#include <limits>
#if defined(_WIN32)
#include <malloc.h>
#endif

namespace {
int mode = 0;
int calls = 0;
int ordinary_calls = 0;
int releases = 0;
int size_queries = 0;
int fail_on_call = 0;
bool observing = false;
struct Region {
  void *address = nullptr;
  int identity = 0;
};
std::array<Region, 256> regions{};
std::array<int, 64> events{};
std::array<std::uint64_t, 16> requested_bytes{};
int event_count = 0;

void remember(void *address) {
  if (!address)
    return;
  for (auto &region : regions) {
    if (!region.address) {
      // Source-defined argv containers use this same process provider before
      // main begins. Retain their descriptors for exact release checking, but
      // do not attribute them to the scenario's allocation/event counters.
      region = {address, observing ? calls : 0};
      return;
    }
  }
  std::abort();
}

void event(int value) {
  if (event_count == static_cast<int>(events.size()))
    std::abort();
  events[event_count++] = value;
}

void retire(void *address) {
  for (auto &region : regions) {
    if (region.address && region.address == address) {
      if (region.identity != 0) {
        event(-region.identity);
        ++releases;
      }
      region = {};
      return;
    }
  }
  std::abort(); // Wrong provider, empty or duplicate release.
}
} // namespace

extern "C" void provider_test_mode(std::int32_t selected) {
  for (const auto &region : regions)
    if (region.address && region.identity != 0)
      std::abort(); // A reset must not hide leaked regions.
  observing = true;
  mode = selected;
  calls = 0;
  ordinary_calls = 0;
  releases = 0;
  size_queries = 0;
  fail_on_call = 0;
  event_count = 0;
}
extern "C" std::int32_t provider_test_ordinary_calls() {
  return ordinary_calls;
}
extern "C" std::int32_t provider_test_calls() { return calls; }
extern "C" std::int32_t provider_test_releases() { return releases; }
extern "C" std::int32_t provider_test_size_queries() { return size_queries; }
extern "C" std::uint64_t provider_test_bytes(std::int32_t attempt) {
  if (attempt < 1 || attempt > calls ||
      attempt > static_cast<int>(requested_bytes.size()))
    std::abort();
  return requested_bytes[attempt - 1];
}
extern "C" void provider_test_fail_on_call(std::int32_t selected) {
  fail_on_call = selected;
}
extern "C" void provider_test_event(std::int32_t value) { event(value); }
extern "C" std::int32_t provider_test_events() { return event_count; }
extern "C" std::int32_t provider_test_event_at(std::int32_t index) {
  if (index < 0 || index >= event_count)
    std::abort();
  return events[index];
}
#if defined(GTI_TEST_PROCESS_OWNERS)
extern "C" std::int32_t provider_test_process_owners() {
  return GTI_TEST_PROCESS_OWNERS;
}
extern "C" void provider_test_observe_storage(const void *address) {
  if (!address)
    std::abort();
}
#endif
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  if (observing)
    ++size_queries;
  // Scenario selection precedes allocation; the target limit remains stable
  // throughout each allocation transaction, including both sparse regions.
  return mode == 1 ? 4095 : (std::numeric_limits<std::size_t>::max)();
}
// Keep the observation seam in this injected adapter set too: pulling the
// production memory object from the runtime archive would also pull its
// allocation definitions and conflict with this fixture's injected provider.
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t bytes,
                                          std::uint64_t alignment) {
  if (observing) {
    ++calls;
    requested_bytes.at(calls - 1) = bytes;
  }
  if (mode >= 2 || (observing && fail_on_call > 0 && calls == fail_on_call))
    return nullptr;
  if (bytes == 0 || alignment == 0 || (alignment & (alignment - 1)) != 0)
    std::abort();
  void *address = _aligned_malloc(static_cast<std::size_t>(bytes),
                                  static_cast<std::size_t>(alignment));
  remember(address);
  return address;
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  retire(address);
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  if (observing) {
    ++calls;
    ++ordinary_calls;
    requested_bytes.at(calls - 1) = bytes;
  }
  if (mode >= 2 || (observing && fail_on_call > 0 && calls == fail_on_call))
    return nullptr;
  if (bytes == 0)
    std::abort();
  void *address = std::malloc(static_cast<std::size_t>(bytes));
  remember(address);
  return address;
}
extern "C" void *gti_rt_realloc_v1(void *address, std::uint64_t bytes) {
  // Deterministic exhaustion after the old live prefix has been populated.
  // The source caller must abort without publishing a null region or cleanup.
  if (std::getenv("GTI_TEST_FAIL_GROWTH"))
    return nullptr;
  if (observing) {
    ++calls;
    ++ordinary_calls;
    requested_bytes.at(calls - 1) = bytes;
  }
  if (mode >= 2 || (observing && fail_on_call > 0 && calls == fail_on_call))
    return nullptr;
  for (auto &region : regions) {
    if (region.address == address) {
      void *result = std::realloc(address, static_cast<std::size_t>(bytes));
      if (result)
        region.address = result;
      return result;
    }
  }
  std::abort();
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t bytes,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  if (observing) {
    ++calls;
    requested_bytes.at(calls - 1) = bytes;
  }
  if (observing && fail_on_call > 0 && calls == fail_on_call) {
    *status = ENOMEM;
    return nullptr;
  }
  if (mode >= 2) {
    *status = mode == 2 ? ENOMEM : mode == 3 ? EINVAL : mode == 4 ? -123 : 0;
    return nullptr;
  }
  if (bytes == 0 || alignment < sizeof(void *) ||
      alignment % sizeof(void *) != 0 || (alignment & (alignment - 1)) != 0) {
    std::abort(); // Source policy must normalize before invoking this adapter.
  }
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(bytes));
  remember(address);
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) {
  retire(address);
  std::free(address);
}
#endif
extern "C" std::int32_t provider_test_region(void *address, std::uint64_t bytes,
                                             std::uint64_t alignment) {
  if (!address || reinterpret_cast<std::uintptr_t>(address) % alignment != 0)
    return 1;
  auto *data = static_cast<unsigned char *>(address);
  for (std::uint64_t index = 0; index < bytes; ++index)
    data[index] = static_cast<unsigned char>(index);
  for (std::uint64_t index = 0; index < bytes; ++index)
    if (data[index] != static_cast<unsigned char>(index))
      return 2;
  return 0;
}
