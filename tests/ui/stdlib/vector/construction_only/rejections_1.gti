// Vectors reject copying move-only elements, elements without move construction, use of a borrowed element after its owner changes, and growth under a live element borrow.
//@ check-fail
import std.optional;
import std.string;
import std.vector;

namespace case_copy_assignment {
struct Envelope {
  std::optional<std::string> payload{};
public:
  Envelope() = default;
};

int entry() {
  mut Envelope target{};
  Envelope source{};
  target = source;  //~ ERROR GTI-S2003
  return 0;
}
}

namespace case_copy_concept {
struct Envelope {
  std::optional<std::string> payload{};
public:
  Envelope() = default;
};

bool requires_copy<std::copyable T>(T& input) { return true; }
int entry() { Envelope input{}; return requires_copy(input) ? 0 : 1; }  //~ ERROR GTI-S2029
}

namespace case_deleted_move {
class Immovable {
public:
  Immovable() {}
  Immovable(Immovable& other) = delete;
  Immovable(Immovable&& other) = delete;
};
int entry() { std::vector<Immovable> values{}; return 0; }  //~ ERROR GTI-S2029
}

namespace case_borrowed_element {
struct View { int& value; View(int& source) : value(source) {} };
int entry() {
  mut int owner = 1;
  mut std::vector<View> values{};
  values.push_back(View(owner));
  owner = 2;  //~ ERROR GTI-S2017
  return values[std::size_t(0)].value;
}
}

int main() { return 0; }
