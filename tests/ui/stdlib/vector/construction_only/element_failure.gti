// A failing element constructor during vector construction destroys the built elements once; a second failure stops cleanup.
//@ run-pass
//@ revisions: r0 r1 r2
//@[r0] stdout: 2
//@[r0] stdout: 3
//@[r0] stdout: 1
//@[r0] stdout: 9
//@[r1] args: fail
//@[r1] stdout: 2
//@[r1] stdout: 3
//@[r1] stdout: 1
//@[r1] stdout: 9
//@[r1] run-fail
//@[r1] exit-code: 70
//@[r1] stderr-contains: main.gti:38: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[r2] args: fail fail
//@[r2] stdout: 2
//@[r2] stdout: 3
//@[r2] run-fail
//@[r2] exit-code: 70
//@[r2] stderr-contains: main.gti:38: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0002] at main.gti:38; secondary [GTI-R0002]
import std.optional;
import std.string;
import std.vector;

class Message {
  std::optional<std::string> text;
  int number;
  int divisor;
public:
  Message(int initial, int cleanup_divisor)
      : text(std::optional<std::string>(std::string("owned"))),
        number(initial), divisor(cleanup_divisor) {}
  Message(Message& other) = delete;
  Message(Message&& other) = default;
  ~Message() {
    std::println(this.number);
    int result = 1 / this.divisor;
  }
};

int main(int argc, std::vector<std::string> argv) {
  Message caller = Message(9, 1);
  mut std::vector<Message> messages{};
  messages.push_back(Message(1, 1));
  messages.push_back(Message(2, argc > 1 ? 0 : 1));
  messages.push_back(Message(3, argc > 2 ? 0 : 1));
  messages.reserve(std::size_t(8));
  messages.erase(std::size_t(1));
  return 0;
}
