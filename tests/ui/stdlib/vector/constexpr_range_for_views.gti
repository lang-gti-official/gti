// Range-based for over vectors of owning elements, std::span and std::array
// runs during constant evaluation exactly as it does at run time.
//@ run-pass
import std.array;
import std.span;
import std.string;
import std.vector;

constexpr std::vector<int> make_values(int count) {
  mut std::vector<int> values{};
  for (mut int i = 1; i <= count; i++) { values.push_back(i); }
  return values;
}

// Owning elements are borrowed by the loop and destroyed with the vector.
constexpr std::size_t text_lengths() {
  mut std::vector<std::string> words{};
  words.push_back(std::string("ab"));
  words.push_back(std::string("cde"));
  mut std::size_t total = 0;
  for (auto& word : words) { total += word.size(); }
  for (auto& word : words) {
    if (word.size() == std::size_t(3)) { return total; }
  }
  return std::size_t(0);
}

constexpr int span_sum() {
  std::vector<int> values = make_values(5);
  std::span<int> view = values.as_span();
  mut int sum = 0;
  for (auto x : view.subspan(std::size_t(1), std::size_t(3))) { sum += x; }
  return sum;
}

constexpr int array_sum() {
  std::array<int, 3> values = std::array<int, 3>({4, 5, 6});
  mut int sum = 0;
  for (auto& x : values) { sum += x; }
  return sum;
}

static_assert(text_lengths() == std::size_t(5));
static_assert(span_sum() == 9);
static_assert(array_sum() == 15);

int main() {
  if (text_lengths() != std::size_t(5) || span_sum() != 9 || array_sum() != 15) { return 1; }
  return 0;
}
