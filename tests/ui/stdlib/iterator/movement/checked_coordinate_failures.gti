int positive_distance_overflow() {
  auto result = std::detail::checked_iterator_difference(std::size_t(9223372036854775808), std::size_t(0));
  return 0;
}

int negative_distance_overflow() {
  auto result = std::detail::checked_iterator_difference(std::size_t(0), std::size_t(9223372036854775809));
  return 0;
}

int minimum_offset_before_begin() {
  auto result = std::detail::checked_iterator_position(std::size_t(0), std::size_t(0), std::size_t(3), std::ptrdiff_t(-9223372036854775807) - std::ptrdiff_t(1));
  return 0;
}

int minimum_subtraction_after_end() {
  auto result = std::detail::checked_iterator_position(std::size_t(0), std::size_t(0), std::size_t(3), std::ptrdiff_t(-9223372036854775807) - std::ptrdiff_t(1), true);
  return 0;
}

