// An element reference tied to its container keeps the container borrowed:
// the container cannot be mutated or moved while the reference is live, and
// a mutable cursor's results stay tied to the cursor so two dereferences
// cannot alias.
import std.format;
import std.vector;

void mutate_while_live() {
  mut std::vector<int> values{};
  values.push_back(1);
  int& first = *values.begin();
  values.push_back(2);  //~ ERROR GTI-S2017
  std::println("{}", first);
}

void move_while_live() {
  mut std::vector<int> values{};
  values.push_back(1);
  int& first = *values.begin();
  std::vector<int> moved = std::move(values);  //~ ERROR GTI-S2017
  std::println("{} {}", first, moved.size());
}

void mutable_alias() {
  mut std::vector<int> values{};
  values.push_back(1);
  mut auto it = values.begin_mut();
  mut int& a = *it;
  mut int& b = *it;  //~ ERROR GTI-S2017
  a = 2;
  b = 3;
}

int main() { return 0; }
