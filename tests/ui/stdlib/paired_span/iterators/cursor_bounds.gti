// Paired-span cursors read or moved out of range fail with the bounds or argument report.
//@ run-fail
//@ exit-code: 70
//@ revisions: a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11
//@[a0] stderr-contains: runtime error[GTI-R0016]
//@[a1] args: argument
//@[a1] stderr-contains: runtime error[GTI-R0016]
//@[a2] args: argument argument
//@[a2] stderr-contains: runtime error[GTI-R0007]
//@[a3] args: argument argument argument
//@[a3] stderr-contains: runtime error[GTI-R0016]
//@[a4] args: argument argument argument argument
//@[a4] stderr-contains: runtime error[GTI-R0016]
//@[a5] args: argument argument argument argument argument
//@[a5] stderr-contains: runtime error[GTI-R0016]
//@[a6] args: argument argument argument argument argument argument
//@[a6] stderr-contains: runtime error[GTI-R0007]
//@[a7] args: argument argument argument argument argument argument argument
//@[a7] stderr-contains: runtime error[GTI-R0016]
//@[a8] args: argument argument argument argument argument argument argument argument
//@[a8] stderr-contains: runtime error[GTI-R0016]
//@[a9] args: argument argument argument argument argument argument argument argument argument
//@[a9] stderr-contains: runtime error[GTI-R0016]
//@[a10] args: argument argument argument argument argument argument argument argument argument argument
//@[a10] stderr-contains: runtime error[GTI-R0016]
//@[a11] args: argument argument argument argument argument argument argument argument argument argument argument
//@[a11] stderr-contains: runtime error[GTI-R0016]
import std.paired_span;
import std.vector;
import std.string;
int main(int argc, std::vector<std::string> argv) {
  std::vector<int> left = {1, 2, 3};
  std::vector<int> right = {4, 5};
  auto pairs = std::paired_span<int, int>(left.as_span(), right.as_span());
  mut auto current = pairs.begin();
  if (argc == 1) { --current; }
  if (argc == 2) { current += std::ptrdiff_t(3); }
  if (argc == 3) { current += std::ptrdiff_t(2); return (*current).first(); }
  if (argc == 5) {
    mut auto reverse = pairs.rbegin();
    reverse += std::ptrdiff_t(2);
    return (*reverse).first();
  }
  if (argc == 6) {
    auto tail = pairs.subspan(std::size_t(1), std::size_t(1));
    mut auto reverse = tail.rbegin();
    reverse += std::ptrdiff_t(2);
    return (*reverse).second();
  }
  if (argc == 7) {
    auto selected = current[std::ptrdiff_t(2)];
    return selected.first();
  }
  if (argc == 8) {
    auto reverse = pairs.rbegin();
    auto selected = reverse[std::ptrdiff_t(3)];
    return selected.second();
  }
  if (argc == 9) {
    auto reverse = pairs.rbegin();
    auto selected = reverse[std::ptrdiff_t(2)];
    return selected.first();
  }
  if (argc == 10) {
    current += std::ptrdiff_t(2);
    ++current;
  }
  if (argc == 11) {
    mut auto reverse = pairs.rbegin();
    ++reverse;
    ++reverse;
    ++reverse;
  }
  if (argc == 12) {
    mut auto reverse = pairs.rbegin();
    --reverse;
  }
  auto tail = pairs.subspan(std::size_t(1), std::size_t(1));
  mut auto limited = tail.begin();
  limited -= std::ptrdiff_t(1);
  return (*limited).second();
}
