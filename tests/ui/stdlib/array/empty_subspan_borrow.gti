// A copied empty subspan retains the array borrow after its parent span is dropped.
import std.array;
import std.span;

std::span<int, source> tail<lifetime source>(std::array<int, 2>&<source> owner) {
  auto parent = owner.as_span();
  return parent.subspan(parent.size(), std::size_t(0));
}

int main() {
  mut std::array<int, 2> owner{};
  auto child = tail(owner);
  auto copy = child;
  owner[std::size_t(0)] = 1;  //~ ERROR GTI-S2017
  return copy.empty() ? 0 : 1;
}
