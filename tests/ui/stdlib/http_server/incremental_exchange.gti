// Decode split HTTP requests and resume each output prefix without duplicating wire bytes.
//@ run-pass
import std.http;
import std.io;
import std.string;

std::byte_buffer octets(std::string_view text) {
  mut std::byte_buffer bytes{};
  for (mut std::size_t i = 0; i < text.size(); i++) { bytes.push_back(uint8_t(text[i])); }
  return std::move(bytes);
}

expected<int, std::http::server_error> exercise() {
  std::http::server_limits limits{};
  mut auto codec = ?std::http::server_codec::open(limits);
  auto first = octets("POST /monitors HTTP/1.1\r\nHo");
  auto a = first.as_span();
  auto partial = ?codec.parse_head(a);
  if (partial.head.has_value() || partial.consumed != a.size()) { return 1; }
  auto second = octets("st: localhost\r\nTransfer-Encoding: chunked\r\nExpect: 100-continue\r\n\r\n");
  auto b = second.as_span();
  auto parsed = ?codec.parse_head(b);
  if (!parsed.head || parsed.head.value().method_text() != "POST" ||
      parsed.head.value().effective_authority() != "localhost") { return 2; }
  ?codec.begin_continue();
  mut std::string wire{};
  while (true) {
    mut std::size_t committed = 0;
    {
      auto pending = codec.next_output();
      if (!pending) { return 10; }
      auto& step = pending.value();
      switch (step.kind()) {
      case std::http::output_kind::framing:
        wire.push_back(char(step.bytes()[0]));
        committed = 1;
        break;
      case std::http::output_kind::body: return 3;
      case std::http::output_kind::flush: break;
      }
    }
    if (committed == 0) { break; }
    ?codec.advance_output(committed);
  }
  if (wire.view() != "HTTP/1.1 100 Continue\r\n\r\n" || ?codec.finish_flush() != std::http::disposition::continue_sent) { return 4; }
  auto upload = octets("2;tag=yes\r\nab\r\n0\r\nX-End: yes\r\n\r\nGET / HTTP/1.1\r\nHost: localhost\r\n\r\n");
  auto u = upload.as_span();
  mut auto backing = octets("?");
  mut std::string decoded{};
  mut std::size_t consumed = 0;
  while (consumed < u.size()) {
    auto one = u.subspan(consumed, std::size_t(1));
    mut auto dst = backing.as_mutable_span();
    auto body = ?codec.parse_body(one, dst);
    if (body.consumed != std::size_t(1)) { return 5; }
    consumed += body.consumed;
    if (body.written > 0) { decoded.push_back(char(dst[0])); }
    if (body.state == std::http::body_state::body_end) { break; }
  }
  if (decoded.view() != "ab") { return 6; }
  auto head = ?std::http::response_head::create(uint16_t(200));
  ?codec.begin_response(head, std::size_t(2), std::http::connection_policy::automatic);
  wire.clear();
  mut std::size_t body_count = 0;
  while (true) {
    mut bool flush = false;
    {
      auto pending = codec.next_output();
      if (!pending) { return 10; }
      auto& step = pending.value();
      switch (step.kind()) {
      case std::http::output_kind::framing: wire.push_back(char(step.bytes()[0])); break;
      case std::http::output_kind::body: body_count++; break;
      case std::http::output_kind::flush: flush = true; break;
      }
    }
    if (flush) { break; }
    ?codec.advance_output(std::size_t(1));
  }
  if (wire.view() != "HTTP/1.1 200 \r\nContent-Length: 2\r\n\r\n" || body_count != 2) { return 7; }
  if (?codec.finish_flush() != std::http::disposition::reusable) { return 8; }
  auto pipeline = u.subspan(consumed, u.size() - consumed);
  auto next = ?codec.parse_head(pipeline);
  return next.head.has_value() && next.head.value().raw_target() == "/" ? 0 : 9;
}
int main() { return exercise().expect("valid exchange"); }
