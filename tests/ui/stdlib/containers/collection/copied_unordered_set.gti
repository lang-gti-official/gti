// A std::unordered_set brace list copies no owning element: a named std::string must be moved in.
//@ check-fail
import std.unordered_set;
import std.string;
int main() {
  std::string named{"owned"};
  std::unordered_set<std::string> values = {named};  //~ ERROR GTI-S2092
  return int(values.size());
}
