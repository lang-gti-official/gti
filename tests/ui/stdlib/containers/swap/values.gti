// Container swaps exchange exact values and capacity without allocating (native oracle).
//@ run-pass
// --- container_swap.gti
import std.vector;
import std.string;
import std.span;
import std.forward_list;
import std.filesystem;
import std.memory;

extern "C" {
void swap_observe_allocations();
uint64_t swap_allocation_count();
}

int main() {
  mut std::vector<int32_t> a = std::vector<int32_t>();
  mut std::vector<int32_t> b = std::vector<int32_t>();
  swap_observe_allocations();
  a.reserve(std::size_t(17));
  b.reserve(std::size_t(5));
  // Positive control: the observer must see actual storage allocations.
  if (swap_allocation_count() != uint64_t(2)) { return 15; }
  a.push_back(1);
  a.push_back(2);
  b.push_back(9);
  swap_observe_allocations();
  a.swap(b);
  if (swap_allocation_count() != uint64_t(0) ||
      a.capacity() != std::size_t(5) || b.capacity() != std::size_t(17) ||
      a.size() != std::size_t(1) || b.size() != std::size_t(2) ||
      a.front() != 9 || b.front() != 1 || b.back() != 2) { return 1; }
  for (mut int32_t& value : b) { value += 10; }
  {
    std::span<int32_t> view = b.as_span();
    if (view[std::size_t(1)] != 12) { return 2; }
  }
  a.clear();
  a.swap(b);
  if (!b.empty() || a.front() != 11) { return 3; }
  b.push_back(7);
  a.swap(b);
  if (a.front() != 7 || b.back() != 12) { return 4; }
  a.clear();
  b.clear();
  a.swap(b);
  if (!a.empty() || !b.empty()) { return 5; }

  mut std::vector<std::unique_ptr<int32_t>> owners =
      std::vector<std::unique_ptr<int32_t>>();
  mut std::vector<std::unique_ptr<int32_t>> empty =
      std::vector<std::unique_ptr<int32_t>>();
  owners.push_back(std::make_unique<int32_t>(42));
  swap_observe_allocations();
  owners.swap(empty);
  if (swap_allocation_count() != uint64_t(0) || !owners.empty() ||
      *empty.front() != 42) { return 6; }
  auto moved = std::move(empty);
  if (*moved.front() != 42) { return 7; }

  swap_observe_allocations();
  mut std::string x = std::string("a\0b");
  mut std::string y = std::string("longer");
  x.reserve(std::size_t(19));
  y.reserve(std::size_t(31));
  if (swap_allocation_count() != uint64_t(4)) { return 17; }
  swap_observe_allocations();
  for (mut int index = 0; index < 101; index++) { x.swap(y); }
  if (swap_allocation_count() != uint64_t(0) || x != "longer" ||
      y.size() != std::size_t(3) || y[std::size_t(1)] != '\0' ||
      x.capacity() != std::size_t(31) || y.capacity() != std::size_t(19)) { return 8; }
  { std::string_view view = y.view(); if (view[std::size_t(2)] != 'b') { return 9; } }
  x.clear();
  x.swap(y);
  y.push_back('z');
  if (x.size() != std::size_t(3) || y != "z") { return 10; }
  x.clear();
  y.clear();
  x.swap(y);
  if (!x.empty() || !y.empty()) { return 11; }

  mut std::forward_list<int32_t> left = std::forward_list<int32_t>();
  mut std::forward_list<int32_t> right = std::forward_list<int32_t>();
  left.swap(right);
  swap_observe_allocations();
  left.push_front(2);
  left.push_front(1);
  // Node allocation uses the other no-throw allocation seam.
  if (swap_allocation_count() != uint64_t(2)) { return 16; }
  swap_observe_allocations();
  left.swap(right);
  if (swap_allocation_count() != uint64_t(0) || !left.empty() || right.front() != 1) { return 12; }
  right.pop_front();
  left.push_front(3);
  swap_observe_allocations();
  left.swap(right);
  if (swap_allocation_count() != uint64_t(0) || left.front() != 2 || right.front() != 3) { return 13; }

  mut std::filesystem::path first = std::filesystem::path("/first/a.txt");
  mut std::filesystem::path second = std::filesystem::path("/second/b.gti");
  swap_observe_allocations();
  first.swap(second);
  if (swap_allocation_count() != uint64_t(0) ||
      first.string() != "/second/b.gti" || second.string() != "/first/a.txt") { return 14; }
  return 0;
}
// --- container_swap_oracle.cpp
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdlib>
#include <limits>
#include <new>
#if defined(_WIN32)
#include <malloc.h>
#endif

namespace {
std::uint64_t allocations = 0;
}

extern "C" void swap_observe_allocations() { allocations = 0; }
extern "C" std::uint64_t swap_allocation_count() { return allocations; }

// Nodes still use the no-throw native allocation boundary.
// Delegate allocation to the ordinary throwing overloads, including alignment.
void *operator new(std::size_t size, const std::nothrow_t &) noexcept {
  ++allocations;
  try {
    return ::operator new(size);
  } catch (const std::bad_alloc &) {
    return nullptr;
  }
}

void *operator new(std::size_t size, std::align_val_t alignment,
                   const std::nothrow_t &) noexcept {
  ++allocations;
  try {
    return ::operator new(size, alignment);
  } catch (const std::bad_alloc &) {
    return nullptr;
  }
}

// Source-owned vectors and strings allocate through the process provider.
// Supply its complete adapter object, keeping allocation/release matched and
// avoiding accidental linkage of a second production provider definition.
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return (std::numeric_limits<std::size_t>::max)();
}
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t bytes,
                                          std::uint64_t alignment) {
  ++allocations;
  return _aligned_malloc(static_cast<std::size_t>(bytes),
                         static_cast<std::size_t>(alignment));
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  ++allocations;
  return std::malloc(static_cast<std::size_t>(bytes));
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t bytes,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  ++allocations;
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(bytes));
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) { std::free(address); }
#endif
