// A vector cannot swap with an immutable one.
//@ check-fail
import std.vector;
int main() {
mut std::vector<int32_t> a = std::vector<int32_t>();
mut std::vector<int32_t> b = std::vector<int32_t>();
std::vector<int32_t> fixed = std::vector<int32_t>();
a.swap(fixed);  //~ ERROR GTI-S2017
return 0;
}
