// A forward_list cannot swap with an immutable one.
//@ check-fail
import std.forward_list;
int main() {
mut std::forward_list<int32_t> a = std::forward_list<int32_t>();
mut std::forward_list<int32_t> b = std::forward_list<int32_t>();
std::forward_list<int32_t> fixed = std::forward_list<int32_t>();
a.swap(fixed);  //~ ERROR GTI-S2017
return 0;
}
