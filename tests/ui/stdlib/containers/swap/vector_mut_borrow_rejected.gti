// A vector cannot swap while an element is mutably borrowed.
//@ check-fail
import std.vector;
int main() {
mut std::vector<int32_t> a = std::vector<int32_t>();
mut std::vector<int32_t> b = std::vector<int32_t>();
mut int32_t& held = a.front();
b.swap(a); std::println(held);  //~ ERROR GTI-S2017
return 0;
}
