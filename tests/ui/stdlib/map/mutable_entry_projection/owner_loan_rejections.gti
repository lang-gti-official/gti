// A live mutable map projection blocks clearing or moving its owner and advancing its cursor.
import std.map;
import std.unordered_map;
import std.string;
import std.utility;

int map_case_clear_owner() {
  mut std::map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  mut auto& projected = *cursor; values.clear(); return projected.mapped();  //~ ERROR GTI-S2017
}

int map_case_move_owner() {
  mut std::map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  mut auto& projected = *cursor; auto moved = std::move(values); return projected.mapped();  //~ ERROR GTI-S2017
}

int map_case_advance_with_mapped() {
  mut std::map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  mut int& mapped = cursor->mapped(); ++cursor; return mapped;  //~ ERROR GTI-S2017
}

int map_case_advance_with_key() {
  mut std::map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  int& key = cursor->key(); ++cursor; return key;  //~ ERROR GTI-S2017
}

int unordered_map_case_clear_owner() {
  mut std::unordered_map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  mut auto& projected = *cursor; values.clear(); return projected.mapped();  //~ ERROR GTI-S2017
}

int unordered_map_case_move_owner() {
  mut std::unordered_map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  mut auto& projected = *cursor; auto moved = std::move(values); return projected.mapped();  //~ ERROR GTI-S2017
}

int unordered_map_case_advance_with_mapped() {
  mut std::unordered_map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  mut int& mapped = cursor->mapped(); ++cursor; return mapped;  //~ ERROR GTI-S2017
}

int unordered_map_case_advance_with_key() {
  mut std::unordered_map<int,int> values{}; [[discard]] values.insert(1,10); mut auto cursor = values.begin_mut();
  int& key = cursor->key(); ++cursor; return key;  //~ ERROR GTI-S2017
}

int main() { return 0; }
