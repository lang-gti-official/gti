// Dereferencing or stepping a mutable map cursor past either end fails with GTI-R0016 and runs cleanup.
//@ run-fail
//@ exit-code: 70
//@ stdout: 20
//@ stdout: 10
//@ stderr-contains: runtime error[GTI-R0016]:
//@ revisions: a1 a2 a3 a4 a5 a6 a7 a8
//@[a2] args: fail
//@[a3] args: fail fail
//@[a4] args: fail fail fail
//@[a5] args: fail fail fail fail
//@[a6] args: fail fail fail fail fail
//@[a7] args: fail fail fail fail fail fail
//@[a8] args: fail fail fail fail fail fail fail
import std.map;
import std.unordered_map;
import std.string;
import std.vector;

class Marker {
  int value;
public:
  Marker(int value) : value(value) {}
  ~Marker() { std::println(this.value); }
};

int main(int argc, std::vector<std::string> argv) {
  Marker first{10};
  Marker second{20};
  if (argc <= 6) {
    mut std::map<int,int> values{};
    [[discard]] values.insert(1,10);
    if (argc == 1) { mut auto end = values.end_mut(); [[discard]] end->mapped(); }
    else if (argc == 2) { mut auto first = values.begin_mut(); --first; }
    else if (argc == 3) { mut auto end = values.end_mut(); ++end; }
    else if (argc == 4) { mut auto end = values.rend_mut(); [[discard]] end->mapped(); }
    else if (argc == 5) { mut auto first = values.rbegin_mut(); --first; }
    else { mut auto end = values.rend_mut(); ++end; }
  } else {
    mut std::unordered_map<int,int> values{};
    if (argc == 7) { mut auto end = values.end_mut(); [[discard]] end->mapped(); }
    else { mut auto end = values.end_mut(); ++end; }
  }
  return 99;
}
