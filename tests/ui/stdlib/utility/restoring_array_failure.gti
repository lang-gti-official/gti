//@[run2] stdout: 2
//@[run2] stdout: 1
//@[run2] stderr-contains: restoring_array_failure.gti:11: runtime error[GTI-R0017]: panic: "array replacement construction"
//@[run3] run-fail
//@[run3] args: after exchange
//@[run3] exit-code: 70
//@[run3] stdout: 2
//@[run3] stdout: 1
//@[run3] stdout: 4
//@[run3] stdout: 3
//@[run3] stderr-contains: restoring_array_failure.gti:42: runtime error[GTI-R0017]: panic: "after array exchange"
//@[run4] run-fail
//@[run4] args: return cleanup failure
//@[run4] exit-code: 70
//@[run4] stdout: 2
//@[run4] stdout: 1
//@[run4] stdout: 4
