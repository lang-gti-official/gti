// Restoring exchange transports every eligible owning result shape.
//@ run-pass
//@ revisions: run1 run2 run3 run4 run5
//@[run1] stdout: 2
//@[run1] stdout: 1
//@[run1] stdout: 4
//@[run1] stdout: 3
//@[run2] run-fail
//@[run2] args: construction
//@[run2] exit-code: 70
