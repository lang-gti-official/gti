// A UTF-8 decoder keeps its input borrowed: clearing the owner while the decoder lives is rejected.
//@ check-fail
import std.encoding;
import std.string;

int main() {
  mut std::string owner = "hello";
  auto view = owner.view();
  mut std::encoding::utf8::decoder cursor{view};
  owner.clear();  //~ ERROR GTI-S2017
  auto scalar = cursor.next();
  return scalar ? 0 : 1;
}
