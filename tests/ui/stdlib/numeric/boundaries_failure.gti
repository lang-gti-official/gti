// Numeric boundary failures report the library site after cleaning up the caller.
//@ run-fail
//@ revisions: argc2 argc3 argc4 argc5 argc6 argc7 argc8 argc9 argc10 argc11 argc12 argc13 argc14 argc15
//@[argc2] exit-code: 70
//@[argc2] args: x
//@[argc2] stdout: cleaned
//@[argc2] stderr-contains: <std/numeric>:
//@[argc2] stderr-contains: GTI-R0006]: numeric_conversion_out_of_range in numeric_cast
//@[argc3] exit-code: 70
//@[argc3] args: x x
