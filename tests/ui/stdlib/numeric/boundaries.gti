}

bool check_uint64_t() {
  for (mut int32_t i = 0; i < 256; i++) {
    uint64_t a = numeric_input_uint64_t(i);
    for (mut int32_t j = 0; j < 256; j++) {
      uint64_t b = numeric_input_uint64_t(j);
      if (std::midpoint<uint64_t>(a, b) != numeric_midpoint_uint64_t(a, b)) { return false; }
      if (numeric_gcd_fits_uint64_t(a, b) != 0 &&
          std::gcd<uint64_t>(a, b) != numeric_gcd_uint64_t(a, b)) { return false; }
      if (numeric_lcm_fits_uint64_t(a, b) != 0 &&
          std::lcm<uint64_t>(a, b) != numeric_lcm_uint64_t(a, b)) { return false; }
    }
  }
  return true;
}

int main() {
  if (std::MAX_UINT64 != uint64_t(18446744073709551615)) { return 21; }
  if (negative_gcd != 6 || minimum_gcd != 2 || zero_gcd != 0) { return 20; }
  if (midpoint_low_high != -1 || midpoint_high_low != 0 ||
      midpoint_low_low != minimum_int64) { return 22; }
  if (midpoint_zero_max != uint64_t(9223372036854775807) ||
      midpoint_max_zero != uint64_t(9223372036854775808)) { return 23; }
  if (midpoint_int8_extremes != -1 || midpoint_int8_negative != -4 ||
      midpoint_uint8_odd != 128 || midpoint_double != 2.5d) { return 24; }
  // The constant and runtime evaluations agree on the same operands.
  if (std::midpoint(minimum_int64, maximum_int64) != midpoint_low_high ||
      std::midpoint(maximum_int64, minimum_int64) != midpoint_high_low ||
      std::midpoint(std::MAX_UINT64, uint64_t(0)) != midpoint_max_zero) { return 25; }
  if (!check_int8_t()) { return 1; }
  if (!check_uint8_t()) { return 2; }
  if (!check_int16_t()) { return 3; }
  if (!check_uint16_t()) { return 4; }
  if (!check_int32_t()) { return 5; }
  if (!check_uint32_t()) { return 6; }
  if (!check_int64_t()) { return 7; }
  if (!check_uint64_t()) { return 8; }
  for (mut int32_t i = 0; i < 256; i++) {
    float a = numeric_input_float(i);
    double x = numeric_input_double(i);
    for (mut int32_t j = 0; j < 256; j++) {
      float b = numeric_input_float(j);
      double y = numeric_input_double(j);
      if (numeric_midpoint_float(a, b, std::midpoint<float>(a, b)) == 0) { return 30; }
      if (numeric_midpoint_double(x, y, std::midpoint<double>(x, y)) == 0) { return 31; }
    }
  }
  return 0;
}
// --- numeric_boundaries_oracle.cpp
#include <array>
#include <bit>
#include <cmath>
#include <cstdint>
#include <limits>
#include <numeric>
#include <type_traits>

namespace {
std::uint64_t bits(std::uint64_t i) {
  // Fixed test data only, not a production hashing implementation.
  i += UINT64_C(0x9e3779b97f4a7c15);
  i = (i ^ (i >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);
  i = (i ^ (i >> 27)) * UINT64_C(0x94d049bb133111eb);
  return i ^ (i >> 31);
}
template <class T> T input(std::int32_t i) {
  using U = std::make_unsigned_t<T>;
  if constexpr (sizeof(T) == 1) {
    return std::bit_cast<T>(static_cast<U>(i));
  } else {
    constexpr T lo = std::numeric_limits<T>::min();
    constexpr T hi = std::numeric_limits<T>::max();
    constexpr std::array<T, 12> edges{
        lo,   T(lo + 1), T(lo + 2), hi,   T(hi - 1), T(hi - 2),
        T(0), T(1),      T(2),      T(3), T(hi / 2), T(hi / 2 + 1)};
    if (i < static_cast<std::int32_t>(edges.size()))
      return edges[i];
    return std::bit_cast<T>(
        static_cast<U>(bits(static_cast<std::uint64_t>(i))));
  }
}
template <class T> auto magnitude(T value) {
  using U = std::make_unsigned_t<T>;
  U raw = static_cast<U>(value);
  if constexpr (std::is_signed_v<T>) {
    if (value < 0)
      return U(U(0) - raw);
  }
  return raw;
}
template <class T> auto gcd(T a, T b) {
  return std::gcd(magnitude(a), magnitude(b));
}
template <class T> bool gcdFits(T a, T b) {
  return gcd(a, b) <=
         static_cast<std::make_unsigned_t<T>>(std::numeric_limits<T>::max());
}
template <class T> bool lcmFits(T a, T b) {
  auto x = magnitude(a), y = magnitude(b);
  if (x == 0 || y == 0)
    return true;
  auto q = x / std::gcd(x, y);
  return q <=
         static_cast<std::make_unsigned_t<T>>(std::numeric_limits<T>::max()) /
             y;
}
template <class T> T lcm(T a, T b) {
  auto x = magnitude(a), y = magnitude(b);
  if (x == 0 || y == 0)
    return 0;
  return static_cast<T>((x / std::gcd(x, y)) * y);
}
template <class T, class U> T floatingInput(std::int32_t i) {
  constexpr T tiny = std::numeric_limits<T>::denorm_min();
  constexpr T small = std::numeric_limits<T>::min();
  constexpr T huge = std::numeric_limits<T>::max();
  constexpr T infinity = std::numeric_limits<T>::infinity();
  constexpr std::array<T, 22> edges{
      T(0),           T(-0.0),     tiny,
      -tiny,          T(tiny * 2), T(tiny * 3),
      small,          -small,      huge,
      -huge,          T(huge / 2), T(-huge / 2),
      T(1),           T(-1),       T(2),
      T(-2),          T(0.5),      T(-0.5),
      infinity,       -infinity,   std::numeric_limits<T>::quiet_NaN(),
      T(small + tiny)};
  if (i < static_cast<std::int32_t>(edges.size()))
    return edges[i];
  return std::bit_cast<T>(static_cast<U>(bits(static_cast<std::uint64_t>(i))));
}
template <class T, class U> bool midpointMatches(T a, T b, T actual) {
  const T expected = std::midpoint(a, b);
  if (std::isnan(expected))
    return std::isnan(actual);
  return std::bit_cast<U>(actual) == std::bit_cast<U>(expected);
}
} // namespace
extern "C" std::int8_t numeric_input_int8_t(std::int32_t i) {
  return input<std::int8_t>(i);
}
extern "C" std::int8_t numeric_gcd_int8_t(std::int8_t a, std::int8_t b) {
  return static_cast<std::int8_t>(gcd(a, b));
}
extern "C" std::int8_t numeric_lcm_int8_t(std::int8_t a, std::int8_t b) {
  return lcm(a, b);
}
extern "C" std::int32_t numeric_gcd_fits_int8_t(std::int8_t a, std::int8_t b) {
  return gcdFits(a, b);
}
extern "C" std::int32_t numeric_lcm_fits_int8_t(std::int8_t a, std::int8_t b) {
  return lcmFits(a, b);
}
extern "C" std::int8_t numeric_midpoint_int8_t(std::int8_t a, std::int8_t b) {
  return std::midpoint(a, b);
}
extern "C" std::uint8_t numeric_input_uint8_t(std::int32_t i) {
