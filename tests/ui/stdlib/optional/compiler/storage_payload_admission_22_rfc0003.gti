// Storage payload admission: fixed-array and dynamic storage admit moved owner-dependent text.
//@ check-pass
import std.string;
import std.vector;
int main() { mut std::string owner{"owned"}; std::string_view view = owner.view(); mut std::vector<std::string_view> values{}; values.push_back(std::move(view)); return int(values[0].size()); }  //~ WARN GTI-S2096
