// Storage payload admission: moving a view into storage retains its owner through element use.
import std.string;
import std.vector;
int main() { mut std::string owner{"owned"}; std::string_view view = owner.view(); std::string_view values[1] = {std::move(view)}; owner.clear(); return int(values[0].size()); }  //~ ERROR GTI-S2017
