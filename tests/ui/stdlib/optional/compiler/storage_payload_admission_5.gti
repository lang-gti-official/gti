// Storage payload admission: class-owned publication does not merge errors from distinct concrete instances that share the same generic source span.
class Broken<uint64_t N> {
  static_assert(N > 2, "class constraint");  //~ ERROR GTI-S2079 //~ ERROR GTI-S2079
public:
  Broken() {
    static_assert(N > 0, "first constructor constraint");  //~ ERROR GTI-S2079
    static_assert(N > 1, "second constructor constraint");  //~ ERROR GTI-S2079 //~ ERROR GTI-S2079
  }
};
int main() {
  Broken<0> first = Broken<0>();
  Broken<1> second = Broken<1>();
  return 0;
}
