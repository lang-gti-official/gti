// Storage payload admission: ordinary enum storage retains dynamic text, including moved views.
//@ check-pass
import std.string;
enum Text { empty, value(std::string_view text) };
int main() { mut std::string owner{"owned"}; std::string_view view = owner.view(); auto text = Text::value(std::move(view)); switch (text) { case Text::value(selected): return int(selected.size()); case Text::empty: return 0; } }  //~ WARN GTI-S2096
