// Storage payload admission: source-defined owning storage admits a borrowed-carrier payload (RFC 0003 shared borrowed storage); its loans stay tied to the referent.
import std.optional;
import std.vector;
class View {
  int& source;
public:
  View(int& value) : source(value) {}
};
int main() { int source = 7; std::vector<View> item{}; return 0; }
