// std::erase_if over a map rejects a predicate taking a mutable entry.
//@ check-fail
import std.algorithm;
import std.vector;
import std.array;
import std.map;
class Once {
public:
  Once() = default;
  bool operator()(int& value) && { return true; }
};
int main() { mut std::vector<int> values = {1, 2}; mut std::map<int, int> entries{}; std::erase_if(entries, [](mut std::map<int, int>::value_type& e) -> bool { e.second = 0; return true; }); return 0; }  //~ ERROR GTI-S2029
