// std::erase_if rejects a fixed-size std::array.
//@ check-fail
import std.algorithm;
import std.vector;
import std.array;
import std.map;
class Once {
public:
  Once() = default;
  bool operator()(int& value) && { return true; }
};
int main() { mut std::vector<int> values = {1, 2}; mut std::array<int, 2> fixed{}; std::erase_if(fixed, [](int& v) -> bool { return true; }); return 0; }  //~ ERROR GTI-S2012
