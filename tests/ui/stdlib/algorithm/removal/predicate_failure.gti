// A panicking removal predicate unwinds and drops every element exactly once.
//@ run-fail
//@ exit-code: 70
//@ stderr-contains: main.gti:15: runtime error[GTI-R0017]: panic: "removal predicate failed"
//@ stdout: 4
//@ stdout: 3
//@ stdout: 2
//@ stdout: 0
//@ stdout: 1
// --- main.gti
import std.vector;
import std.cstdio;
import std.panic;
struct Resource {
  int id;
  Resource(int id) : id(id) {}
  Resource(Resource& other) = delete;
  Resource(Resource&& other) = default;
  ~Resource() { std::println(this.id); }
};
int main() {
  mut std::vector<Resource> values{};
  for (mut int i = 0; i < 5; i++) { values.push_back(Resource(i)); }
  [[discard]] std::erase_if(values, [](Resource& value) -> bool {
    if (value.id == 3) { std::panic("removal predicate failed"); }
    return value.id % 2 == 0;
  });
  return 0;
}
