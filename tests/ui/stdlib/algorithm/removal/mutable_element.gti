// std::erase_if rejects a predicate taking a mutable element.
//@ check-fail
import std.algorithm;
import std.vector;
import std.array;
import std.map;
class Once {
public:
  Once() = default;
  bool operator()(int& value) && { return true; }
};
int main() { mut std::vector<int> values = {1, 2}; std::erase_if(values, [](mut int& v) -> bool { v = 0; return true; }); return 0; }  //~ ERROR GTI-S2029
