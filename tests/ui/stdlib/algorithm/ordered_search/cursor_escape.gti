// A partition_point cursor into a local cannot be returned as derived from a parameter.
//@ check-fail
import std.algorithm;
import std.functional;
import std.vector;
class OncePredicate {
public:
  bool operator()(int& value) && { return value < 2; }
public:
  OncePredicate() = default;
};
class OnceComparator {
public:
  bool operator()(int& left, int& right) && { return left < right; }
public:
  OnceComparator() = default;
};
std::vector<int>::const_iterator escape(std::vector<int>& external) {
  std::vector<int> values = {1, 2, 3};
  return std::partition_point(values.begin(), values.end(), [](int& value) -> bool { return value < 2; });  //~ ERROR GTI-S2045 must derive from read-only parameter 'external'
}
int main() { return 0; }
