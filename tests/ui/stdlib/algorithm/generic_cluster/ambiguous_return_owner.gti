// A borrowing result with two borrowed parameters has an ambiguous elided region.
//@ check-fail
import std.vector;

std::vector<int32_t>::const_iterator ambiguous_owner(  //~ ERROR GTI-S2017 The returned borrowing value's elided region is ambiguous among 2 borrowed parameters
    bool select_first, mut std::vector<int32_t>::const_iterator first,
    mut std::vector<int32_t>::const_iterator second) {
  if (select_first) {
    return std::move(first);
  }
  return std::move(second);
}

int main() {
  mut std::vector<int32_t> values = std::vector<int32_t>({1, 2, 3});
  mut auto first = values.begin();
  mut auto second = values.begin();
  mut auto selected = ambiguous_owner(
      true, std::move(first), std::move(second));
  if (*selected != 1) {
    return 1;
  }
  return 0;
}
