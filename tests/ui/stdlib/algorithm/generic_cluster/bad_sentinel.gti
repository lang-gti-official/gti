// A sentinel that is not a sentinel_for its iterator is rejected.
//@ check-fail
import std.algorithm;

class sentinel { public: sentinel() = default; };

class iterator {
  mut int32_t current;

public:
  iterator(int32_t initial) : current(initial) {}

  int32_t& operator*() {
    return this.current;
  }

  void operator++() mut {
    this.current++;
  }
};

int main() {
  int32_t needle = 1;
  std::find(iterator(0), sentinel(), needle);  //~ ERROR GTI-S2029 satisfy concept 'std::sentinel_for
  return 0;
}
