// std::copy's returned cursor keeps the destination exclusively borrowed against reads.
//@ check-fail
import std.algorithm;
import std.vector;
int main() { std::vector<int> source = {1}; mut std::vector<int> destination = {0, 0}; mut auto next = std::copy(source.begin(), source.end(), destination.begin_mut()); int value = destination[std::size_t(0)]; *next = value; return 0; }  //~ ERROR GTI-S2017
