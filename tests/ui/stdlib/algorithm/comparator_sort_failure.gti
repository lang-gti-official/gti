// A failing comparator, probe or element destructor stops std::sort with its site and runs owned cleanup.
//@ run-pass
//@ revisions: ok comparison median monotonic destructor
//@[ok] stdout: call
//@[ok] stdout: call
//@[ok] stdout: call
//@[ok] stdout: call
//@[ok] stdout: call
//@[ok] stdout: call
//@[ok] stdout: comparator
//@[ok] stdout: 6
//@[ok] stdout: 1
//@[ok] stdout: 2
//@[ok] stdout: 3
//@[ok] stdout: 4
//@[ok] stdout: outer
//@[comparison] run-fail
//@[comparison] exit-code: 70
//@[comparison] args: comparison
//@[comparison] stdout: call
//@[comparison] stdout: call
//@[comparison] stdout: call
//@[comparison] stdout: call
//@[comparison] stdout: comparator
//@[comparison] stdout: 4
//@[comparison] stdout: outer
//@[comparison] stderr-contains: main.gti:91: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[median] run-fail
//@[median] exit-code: 70
//@[median] args: median selection comparison failure
//@[median] stdout: call
//@[median] stdout: call
//@[median] stdout: call
//@[median] stdout: call
//@[median] stdout: comparator
//@[median] stdout: 4
//@[median] stdout: outer
//@[median] stderr-contains: main.gti:93: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[monotonic] run-fail
//@[monotonic] exit-code: 70
//@[monotonic] args: monotonic probe failure
//@[monotonic] stdout: call
//@[monotonic] stdout: call
//@[monotonic] stdout: call
//@[monotonic] stdout: call
//@[monotonic] stdout: comparator
//@[monotonic] stdout: 4
//@[monotonic] stdout: outer
//@[monotonic] stderr-contains: main.gti:92: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[destructor] run-fail
//@[destructor] exit-code: 70
//@[destructor] args: destructor failure
//@[destructor] stdout: call
//@[destructor] stdout: call
//@[destructor] stdout: call
//@[destructor] stdout: call
//@[destructor] stdout: call
//@[destructor] stdout: call
//@[destructor] stdout: comparator
//@[destructor] stdout: 6
//@[destructor] stdout: outer
//@[destructor] stderr-contains: main.gti:86: runtime error[GTI-R0002]: division_by_zero in integer_division
import std.algorithm;
import std.string;
import std.vector;

mut int mode = 0;

class Guard {
  std::string name;
public:
  Guard(std::string name) : name(std::move(name)) {}
  ~Guard() { std::println(this.name.view()); }
};

class Ordering {
  std::string name = std::string("comparator");
  mut int calls = 0;
public:
  Ordering() {}
  Ordering(Ordering& other) = delete;
  Ordering(Ordering&& other) = default;
  ~Ordering() {
    std::println(this.name.view());
    std::println(this.calls);
    if (mode == 3) { int failure = 1 / (mode - 3); }
  }
  bool operator()(int& left, int& right) mut {
    this.calls++;
    Guard call{std::string("call")};
    if (mode == 2 && this.calls == 4) { int failure = 1 / (mode - 2); }
    if (mode == 4 && this.calls == 4) { int failure = 1 / (mode - 4); }
    if (mode == 5 && this.calls == 4) { int failure = 1 / (mode - 5); }
    return left < right;
  }
};

int main(int argc, std::vector<std::string> argv) {
  mode = argc;
  Guard outer{std::string("outer")};
  mut std::vector<int> values = {4, 3, 2, 1};
  if (mode == 4 || mode == 5) {
    values.clear();
    for (mut int i = 0; i < 32; i++) { values.push_back(mode == 4 ? i : (i * 17) % 32); }
  }
  std::sort(values, Ordering());
  for (auto& value : values) { std::println(value); }
  return 0;
}
