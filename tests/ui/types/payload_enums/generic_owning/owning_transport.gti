//@[later_argument_after_move] args: later-argument-after-move
//@[later_argument_after_move] run-fail
//@[later_argument_after_move] exit-code: 70
//@[later_argument_after_move] stderr-contains: division_by_zero
//@[later_argument_after_move] stdout: 7
//@[later_argument_after_move] stdout: 9
//@[callee_failure] args: callee-failure
