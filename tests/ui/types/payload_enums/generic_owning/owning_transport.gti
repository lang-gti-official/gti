//@[constructor_later_argument_failure] stdout: 9
import std.string;
import std.optional;
import std.vector;

mut int32_t drops = 0;

class Resource {
public:
  Resource(int32_t identity) : identity(identity) {}
  Resource(Resource&& other) = default;
  ~Resource() {
    drops = drops + 1;
    std::println(this.identity);
  }
  int32_t id() { return this.identity; }
private:
  int32_t identity;
};

enum class Event { message(Resource resource), idle };

int32_t id(Event& event) {
  switch (event) {
  case Event::message(auto& resource): return resource.id();
  case Event::idle: return 0;
  }
}

T relay<T>(T value) { return std::move(value); }

// Deliberately unrelated to a public container: generic ownership must use
// the exact concrete field and callable identities, not library spellings.
class Envelope<T> {
public:
  Envelope(T value) : value(std::move(value)) {}
  T& get() { return this.value; }
  void replace(T replacement) mut { this.value = std::move(replacement); }
  T extract() && { return std::move(this.value); }
private:
  mut T value;
};

void exercise() {
  Event source = relay(Event::message(Resource(1)));
  mut Envelope<Event> packet = Envelope<Event>(std::move(source));
  packet.replace(Event::message(Resource(2)));
  if (id(packet.get()) != 2) { std::println(99); }
  Event extracted = std::move(packet).extract();

  mut std::vector<Event> events{};
  events.push_back(std::move(extracted));
  events.push_back(Event::idle);
  events.push_back(Event::message(Resource(3)));
  events.reserve(std::size_t(12));
  mut int32_t total = 0;
  for (auto& event : events) { total = total + id(event); }
  if (total != 5) { std::println(99); }

  mut std::optional<Event> selected =
      std::optional<Event>(Event::message(Resource(4)));
  if (id(selected.value()) != 4) { std::println(99); }
  selected.reset();
}
namespace case_call_binding_publication {
Event produce(int divisor) {
  Resource guard = Resource(9);
  return Event::message(Resource(4 / divisor));
}
int entry() {
  {
    auto event = produce(1);
    if (drops != 1 || id(event) != 4) return 1;
  }
  return drops == 2 ? 0 : 2;
}
}
namespace case_call_binding_publication_failure {
Event produce(int divisor) {
  Resource guard = Resource(9);
  return Event::message(Resource(4 / divisor));
}
int entry() {
  auto event = produce(0);
  return id(event);
}
}
namespace case_consuming_binding_publication {
Event produce() { return Event::message(Resource(4)); }
int entry() {
  {
    auto event = produce();
    switch (std::move(event)) {
      case Event::idle: return 1;
      case Event::message(resource): {
        if (resource.id() != 4 || drops != 0) return 2;
        break;
      }
    }
  }
  return drops == 1 ? 0 : 3;
}
}
namespace case_consuming_binding_publication_failure {
Event produce() { return Event::message(Resource(4)); }
int consume(int divisor) {
  auto event = produce();
  switch (std::move(event)) {
    case Event::idle: return 1;
    case Event::message(resource): return resource.id() / divisor;
  }
}
int entry() { return consume(0); }
}
namespace case_generic_owner_capture {
int entry() {
  {
    Envelope<Event> packet = Envelope<Event>(Event::message(Resource(5)));
    auto callback = [owned = std::move(packet)]() -> int32_t {
      return id(owned.get());
    };
    if (callback() != 5) { return 1; }
  }
  return drops == 1 ? 0 : 1;
}
}
namespace case_partial_owner {
class Partial<T> {
  T completed;
  int32_t checked;
public:
  Partial(T value, int32_t divisor)
      : completed(std::move(value)), checked(int32_t(1) / divisor) {}
};
int entry() {
  Partial<Event> value = Partial<Event>(Event::message(Resource(7)), 0);
  return 1;
}
}
namespace case_later_argument_failure {
void accept<T>(T first, int32_t second) {}
int entry() {
  Resource caller = Resource(9);
  mut int32_t divisor = 0;  //~ WARN GTI-S2096
  accept(Event::message(Resource(7)), int32_t(1) / divisor);
  return 1;
}
}
namespace case_later_argument_after_move {
void accept<T>(T first, int32_t second) {}
int entry() {
  Resource caller = Resource(9);
  Event event = Event::message(Resource(7));
  mut int32_t divisor = 0;  //~ WARN GTI-S2096
  accept(std::move(event), int32_t(1) / divisor);
  return 1;
}
}
namespace case_callee_failure {
void accept<T>(T first, int32_t divisor) {
  Resource local = Resource(6);
  int32_t checked = int32_t(1) / divisor;
}
int entry() {
  Resource caller = Resource(9);
  accept(Event::message(Resource(7)), 0);
  return 1;
}
}
namespace case_constructor_later_argument_failure {
class Sink<T> {
public:
  Sink(T first, int32_t second) {}
public:
  Sink() = default;
};
int entry() {
  Resource caller = Resource(9);
  mut int32_t divisor = 0;  //~ WARN GTI-S2096
  Sink<Event> sink = Sink<Event>(Event::message(Resource(7)), int32_t(1) / divisor);
  return 1;
}
}

int main(int argc, std::vector<std::string> argv) {
  if (argc < 2) {
    exercise();
    return drops == 4 ? 0 : 1;
  }
  if (argv[std::size_t(1)] == "call-binding-publication") { return case_call_binding_publication::entry(); }
  if (argv[std::size_t(1)] == "call-binding-publication-failure") { return case_call_binding_publication_failure::entry(); }
  if (argv[std::size_t(1)] == "consuming-binding-publication") { return case_consuming_binding_publication::entry(); }
  if (argv[std::size_t(1)] == "consuming-binding-publication-failure") { return case_consuming_binding_publication_failure::entry(); }
  if (argv[std::size_t(1)] == "generic-owner-capture") { return case_generic_owner_capture::entry(); }
  if (argv[std::size_t(1)] == "partial-owner") { return case_partial_owner::entry(); }
  if (argv[std::size_t(1)] == "later-argument-failure") { return case_later_argument_failure::entry(); }
  if (argv[std::size_t(1)] == "later-argument-after-move") { return case_later_argument_after_move::entry(); }
  if (argv[std::size_t(1)] == "callee-failure") { return case_callee_failure::entry(); }
  if (argv[std::size_t(1)] == "constructor-later-argument-failure") { return case_constructor_later_argument_failure::entry(); }
  return 100;
}
