// Generic owning sums keep exact payload transport through calls, bindings, envelopes and containers, and clean up on failure.
//@ run-pass
//@ stdout: 1
//@ stdout: 4
//@ stdout: 3
//@ stdout: 2
//@ revisions: success call_binding_publication call_binding_publication_failure consuming_binding_publication consuming_binding_publication_failure generic_owner_capture partial_owner later_argument_failure later_argument_after_move callee_failure constructor_later_argument_failure
