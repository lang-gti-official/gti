namespace case_mismatched_construction {
enum Event<T, U = T, uint64_t Channel = 3> {
  idle,
  item(T value),
  pair(T first, U second)
};

int entry() { Event<int32_t> event = Event<int64_t>::item(int64_t(1)); return 0; }  //~ ERROR GTI-S2003
}

