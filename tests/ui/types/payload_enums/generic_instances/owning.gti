namespace case_nested_result_later_argument_success {
void accept(Event<Resource> first, int32_t second) {
  if (id(first) != 7 || second != 3) { std::println(99); }
}
int entry() {
  accept(relay(Event<Resource>::item(Resource(7))), 3);
  return drops == 1 ? 0 : 1;
}
}

