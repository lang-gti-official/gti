// Invalid class type packs: invalid class pack must be rejected by semantics: class Pack<Args...> { public: Pack() = default; }; class Bad<Args...> { using type = Pack<Args..., int>;  public: Bad() = default; };.
class Pack<Args...> { public: Pack() = default; }; class Bad<Args...> { using type = Pack<Args..., int>;  public: Bad() = default; };  //~ ERROR GTI-S2023
