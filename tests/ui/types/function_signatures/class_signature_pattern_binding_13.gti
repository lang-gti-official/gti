// Class signature pattern binding: invalid class pattern must fail in the frontend: class C<R(Args...)> { public: C() = default; }; class F<S> { C<S> field{};  public: F() = default; }; F<int> bad{};.
class C<R(Args...)> { public: C() = default; }; class F<S> { C<S> field{};  public: F() = default; }; F<int> bad{};  //~ ERROR GTI-S2023 //~ ERROR GTI-S2023
