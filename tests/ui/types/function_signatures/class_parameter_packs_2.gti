// Class parameter packs: read-only reference elements are valid concrete owner-pack parameters.
//@ check-pass
class Relay<Args...> { public: void send(Args... args) {} int operator()(Args... args) { return 0; }  public: Relay() = default; }; int main() { Relay<int&> value{}; int number = 1; value.send(number); return value(number); }
