// Concrete generic reanalysis preserves checked arithmetic conversions without changing deduction.
//@ run-pass
T relay<T>(T value) { return value; }
uint64_t target(uint64_t value) { return value; }
uint64_t generic<T>(T value) { return target(32 * 32); }
int main() {
  int deduced = relay(32 * 32);
  return deduced == 1024 && generic(0) == 1024 ? 0 : 1;
}
