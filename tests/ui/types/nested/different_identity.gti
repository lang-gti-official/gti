// Nested types of the same name in different classes are distinct types.
//@ check-fail
struct A { struct N { int value; };  public: A() = default; }; struct B { struct N { int value; };  public: B() = default; }; void take(A::N value) {} int main() { B::N b{}; take(b); return 0; }  //~ ERROR GTI-S2012 //~ ERROR GTI-S2003 Argument 1 has type 'B::N' but the parameter requires 'A::N'
