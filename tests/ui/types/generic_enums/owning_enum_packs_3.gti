// Owning enum packs: forwarding a move-only enum element twice is rejected in semantics.
class Token {
public:
  Token() {}
  Token(Token& other) = delete;
  Token(Token&& other) = default;
  ~Token() {}
};
enum Event { Empty, Owned(Token token) };

void sink<Args...>(Args... args) {}
void relay<Args...>(Args... args) { sink(args...); sink(args...); }  //~ ERROR GTI-S2018
int main() { relay(Event::Owned(Token())); return 0; }
