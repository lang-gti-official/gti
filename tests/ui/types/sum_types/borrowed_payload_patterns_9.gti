// Borrowed payload patterns: a live payload loan blocks enum replacement.
class resource {
  mut int32_t count = 3;
public:
  resource() {}
  resource(resource& other) = delete;
  resource(resource&& other) = default;
  void add() mut { this.count++; }
  int32_t read() { return this.count; }
};
enum class data { empty, some(resource item) };

int main() {
  mut data value = data::some(resource());
  switch (value) {
    case data::some(auto& item): value = data::empty; return item.read();  //~ ERROR GTI-S2017
    case data::empty: return 0;
  }
}
