public:
  leaf() {}
  ~leaf() { drops = drops + 1; }
  mut int32_t value = 7;
};
enum class holder { one(leaf value), none };
int main() {
  holder held = holder::one(leaf());
  switch (held) {
  case holder::one:
    break;
  case holder::none:
    break;
  }
  return 0;
}
