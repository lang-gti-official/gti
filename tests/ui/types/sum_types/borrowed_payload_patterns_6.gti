// Borrowed payload patterns: pattern borrows require stable original owner storage.
class resource {
  mut int32_t count = 3;
public:
  resource() {}
  resource(resource& other) = delete;
  resource(resource&& other) = default;
  void add() mut { this.count++; }
  int32_t read() { return this.count; }
};
enum class data { empty, some(resource item) };

int main() {
  switch (data::some(resource())) {
    case data::some(auto& item): return item.read();  //~ ERROR GTI-S2067
    case data::empty: return 0;
  }
}
