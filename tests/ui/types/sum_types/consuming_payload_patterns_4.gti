// Consuming payload patterns: a consumed subject cannot supply a borrowed payload binding.
class resource {
  int32_t id;
public:
  resource(int32_t value) : id(value) {}
  ~resource() {}
  int32_t read() { return this.id; }
};
enum class data {
  empty,
  some(resource item),
  pair(resource left, resource right),
  mixed(resource item, int32_t code),
};
data make(int32_t id) { return data::some(resource(id)); }

int main() {
  switch (make(1)) {
  case data::some(auto& item):  //~ ERROR GTI-S2067
    return item.read();
  default:
    return 0;
  }
}
