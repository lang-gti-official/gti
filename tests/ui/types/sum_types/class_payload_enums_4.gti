// Class payload enums: a borrowed class payload cannot substitute a dead local for its declared caller origin.
class carrier {
  int32_t& source;
public:
  carrier(int32_t& value) : source(value) {}
};
enum holder { one(carrier value), none };
holder<a> escape<lifetime a>(int32_t&<a> owner) {
  int32_t local = 3;
  carrier value = carrier(local);
  return holder::one(value);  //~ ERROR GTI-S2045
}
int main() {
  int32_t owner = 7;
  holder result = escape(owner);
  return 0;
}
