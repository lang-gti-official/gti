// Class payload enums: polymorphic callable families should retain the stable early owning payload-enum boundary diagnostic.
class resource {
public:
  resource() {}
  ~resource() {}
};
enum class holder { one(resource value), none };
interface relay {
public:
  virtual holder pass(holder value) = 0;  //~ ERROR GTI-S2041 //~ ERROR GTI-S2067 //~ ERROR GTI-S2067
};
int main() { return 0; }
