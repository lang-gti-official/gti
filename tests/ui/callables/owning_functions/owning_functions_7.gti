// Owning functions: concrete nominal pack forwarding retains exact argument order and types.
struct Nullary { int operator()() { return 4; }  public: Nullary() = default; };
struct Binary { int operator()(int value, bool enabled) { return enabled ? value : 0; }  public: Binary() = default; };
int forward<Callable, Args...>(Callable callable, Args... args) {
  return callable(args...);  //~ ERROR GTI-S2022
}
int main() {
  Nullary zero{};
  Binary two{};
  int first = forward(std::move(zero));
  return forward(std::move(two), true, first) - 4;
}
