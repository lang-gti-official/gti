// Borrowing captures: erased-reference-retains-capture-origin is rejected with a user diagnostic, not an ICE.
import std.memory;
int main() {
  mut int owner = 3;
  auto callback = [&owner]() -> int { return owner; };
  std::erased_object& erased = std::erase_ref(callback);
  owner = 5;  //~ ERROR GTI-S2017
  unsafe { int& wrong = std::restore_ref<int>(erased); return wrong; }
}
