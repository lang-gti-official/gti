// Contextual diagnostics and boundaries: a callable context admitting two overloads should diagnose ambiguity instead of ranking them.
void invoke<Function>(Function function) {
  int32_t value = 1;
  function(value);
}
void selected(int32_t value) {}
void selected(int32_t& value) {}
int main() {
  invoke(selected);  //~ ERROR GTI-S2090
  return 0;
}
