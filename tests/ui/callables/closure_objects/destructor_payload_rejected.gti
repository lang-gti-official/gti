// A payload with a user destructor is not an inline polymorphic payload.
//@ check-fail
import std.polymorphic;
import std.string;

interface shape { int area(); };

class square : public shape {
  int side;
public:
  square(int side) : side(side) {}
  int area() override { return this.side * this.side; }
};

class noisy : public shape {
public:
  noisy() {}
  ~noisy() { std::println("bye"); }
  int area() override { return 1; }
};
int need<M>() requires std::inline_polymorphic_payload<M, shape> { return 1; }
int main() { return need<noisy>(); }  //~ ERROR GTI-S2029
