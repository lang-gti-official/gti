// Stored callables: owned callable respects the exact wrapper transfer assertion: [[unsafe_share]].
import std.string;
[[unsafe_share]] class Reviewed<T> {
  T* pointer = nullptr;
public:
  Reviewed() {}
};
void retain<T>(T callback) {}
int main() {
  Reviewed<int> owner{};
  auto callback = [owner = std::move(owner)]() -> int { return 1; };
  retain(std::move(callback));  //~ ERROR GTI-S2046
  return 0;
}
