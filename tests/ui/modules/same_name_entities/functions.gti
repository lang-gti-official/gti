// Two imported modules each declaring helper functions of the same name link and keep their own meanings.
//@ run-pass
// --- main.gti
import "left.gti"; import "right.gti"; int main(){return left()+right()-42;}
// --- left.gti
export module left;int helper(){return 20;} export int left(){return helper();}
// --- right.gti
export module right;int helper(){return 22;} export int right(){return helper();}
