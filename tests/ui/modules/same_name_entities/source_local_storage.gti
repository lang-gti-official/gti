// Two imported modules each declaring source-local static storage of the same name link and keep their own meanings.
//@ run-pass
// --- main.gti
import "left.gti"; import "right.gti"; int main(){return left()+right()-42;}
// --- left.gti
export module left;static int value=20; export int left(){return value;}
// --- right.gti
export module right;static int value=22; export int right(){return value;}
