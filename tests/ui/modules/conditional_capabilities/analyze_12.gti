// Analyze: source storage must not erase payload denial or a resource owner's checked external borrow.
import std.memory;
import std.resource;

[[unsafe_owned, unsafe_transfer(T), unsafe_share(T)]] class Reviewed<T> {
  T* pointer = nullptr;
public:
  Reviewed() {}
  ~Reviewed() {}
};
[[no_transfer]] struct Affine { int id = 0;  public: Affine() = default; };
[[no_share]] struct Exclusive { int id = 0;  public: Exclusive() = default; };
enum Packet<T> { item(T value) };
enum Metadata<T> { item(int value) };
void consume<std::transferable T>(T value) {}
void observe<std::shareable T>(T& value) {}
void relay<std::transferable T>(T value) { consume(Reviewed<T>()); }
int main() { std::allocator allocator{}; auto slots = allocator.try_storage<Exclusive>(std::size_t(1)).expect("allocate"); observe(slots); return 0; }  //~ ERROR GTI-S2029
