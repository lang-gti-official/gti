// An #error in a shared imported module is reported once as a configuration diagnostic.
// --- main.gti
import "first.gti";
import "second.gti";
int main() { return first_value() + second_value(); }
// --- first.gti
export module first;
#define MODULE_LOCAL
#define SECOND_ONLY
#define STARTED
import "parent.gti";
import "flags.gti";
import "parent.gti";
#if defined(ENABLED) || !defined(STARTED) || !defined(MODULE_LOCAL)  //~ WARN GTI-S2075
#error "module imports must preserve the caller's flags"
#endif
export int first_value() { return parent_value(); }
// --- second.gti
export module second;
#define MODULE_LOCAL
#define SECOND_ONLY
#define STARTED
import "parent.gti";
import "flags.gti";
import "parent.gti";
#if defined(ENABLED) || !defined(STARTED) || !defined(MODULE_LOCAL)  //~ WARN GTI-S2075
#error "module imports must preserve the caller's flags"
#endif
export int second_value() { return parent_value(); }
// --- parent.gti
export module parent;
import "flags.gti";
#if defined(ENABLED) || defined(SECOND_ONLY) || defined(STARTED)  //~ WARN GTI-S2075
#error "an imported module changed its caller's configuration"
#endif
export int parent_value() { return flag_value(); }  //~ ERROR GTI-S2001
// --- flags.gti
export module flags;
#error "changed module overlay"  //~ ERROR GTI-S2047 changed module overlay
