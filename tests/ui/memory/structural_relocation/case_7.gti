// Structural_relocation: invalid structural relocation is rejected before lowering.
    struct Parcel<T> {
      T item;
      int& loan;
      Parcel(T item, int& loan) : item(std::move(item)), loan(loan) {}
    };
    void accept<std::relocatable U>() {}
    void check<T>() requires std::relocatable<T> { accept<Parcel<T>>(); }  //~ ERROR GTI-S2029
    int main() { return 0; }
