// Two live classes cannot store overlapping mutable references.
//@ check-fail
import std.panic;

mut int constructed = 0;
mut int destroyed = 0;
class Pinned {
  mut Pinned* constructed_at = nullptr;
  int id;
public:
  Pinned(int id) : id(id) {
    this.constructed_at = &this;
    constructed = constructed * 10 + id;
  }
  Pinned(Pinned&) = delete;
  Pinned(Pinned&&) = delete;
  ~Pinned() {
    if (this.constructed_at != &this) { std::panic("relocated pinned object"); }
    destroyed = destroyed * 10 + this.id;
  }
  bool stable() { return this.constructed_at == &this; }
};
Pinned make(int id) { return Pinned(id); }
Pinned relay(int id) { return make(id); }
mut int& select(mut int& value) { return value; } class View { mut int& value; public: View(mut int& value) : value(select(value)) {} int read() { return this.value; } }; int main() { mut int value = 1; View first{value}; View second{value}; return first.read() + second.read(); }  //~ ERROR GTI-S2017
