// A forwarded Expected result's cleanup failure after a primary failure reports GTI-R0014 with both sites.
//@ run-pass
//@ revisions: ok primary secondary
//@[ok] stdout: 7
//@[ok] stdout: 3
//@[ok] stdout: 8
//@[ok] stdout: 9
//@[primary] args: primary
//@[primary] stdout: 7
//@[primary] stdout: 8
//@[primary] stdout: 9
//@[primary] run-fail
//@[primary] exit-code: 70
//@[primary] stderr-contains: main.gti:47: runtime error[GTI-R0002]: division_by_zero in integer_division
//@[secondary] args: primary secondary
//@[secondary] stdout: 7
//@[secondary] stdout: 8
//@[secondary] run-fail
//@[secondary] exit-code: 70
//@[secondary] stderr-contains: main.gti:37: runtime error[GTI-R0014]: failure_during_cleanup; primary [GTI-R0002] at main.gti:47; secondary [GTI-R0002]
import std.memory;
import std.string;
import std.vector;

mut int mode = 0;
void checked(int value) {}

class ResultOwner {
  int number;
public:
  ResultOwner(int number) : number(number) {}
  ResultOwner(ResultOwner& other) = delete;
  ResultOwner(ResultOwner&& other) = default;
  int id() { return this.number; }
  ~ResultOwner() {
    std::println(8);
    checked(1 / (mode - 2)); // result cleanup
  }
};

class BeforePublication {
public:
  BeforePublication() {}
  ~BeforePublication() {
    std::println(7);
    int divisor = mode == 0 ? 1 : 0;
    checked(1 / divisor); // primary cleanup
  }
};

class Caller {
public:
  Caller() {}
  ~Caller() { std::println(9); }
};

expected<ResultOwner, std::string> produce() { return ResultOwner(3); }
expected<ResultOwner, std::string> forward() {
  BeforePublication pending{};
  return produce();
}

int main(int argc, std::vector<std::string> argv) {
  mode = argc - 1;
  Caller caller{};
  auto result = forward();
  std::println(result.value().id());
  return 0;
}
