// Pool, resource-storage and SIMD-mask iteration allocates nothing and preserves complete state.
//@ run-pass
// --- sparse_mask_iterator_allocations.gti
import std.memory;
import std.resource;
import std.simd;

extern "C" {
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
}

// Fixed sparse slots and mask state are populated before measurement.
int main() {
  mut auto allocated = std::try_make_pool<int>(std::size_t(7));
  if (!allocated) { return 10; }
  mut auto pool = std::move(allocated).value();
  [[discard]] pool.try_insert(10);
  [[discard]] pool.try_insert(99);
  [[discard]] pool.try_insert(20);
  [[discard]] pool.try_insert(88);
  [[discard]] pool.try_insert(30);
  pool.erase(std::size_t(1));
  pool.erase(std::size_t(3));
  {
    adoption_count_begin();
    mut int checksum = 0;
    for (mut int round = 0; round < 64; round++) {
      auto end = pool.end();
      auto rend = pool.rend();
      mut int count = 0;
      for (mut auto cursor = pool.begin(); cursor != end; ++cursor) {
        checksum += *cursor;
        count++;
      }
      if (count != 3) { return 1; }
      {
        auto first = pool.begin();
        mut auto independent = first;
        ++independent;
        if (*first != 10 || *independent != 20 || first == independent) { return 2; }
      }
      mut int next_value = 30;
      for (mut auto cursor = pool.rbegin(); cursor != rend; ++cursor) {
        if (*cursor != next_value) { return 3; }
        checksum += *cursor;
        next_value -= 10;
      }
      if (next_value != 0) { return 4; }
      {
        mut auto cursor = pool.begin_mut();
        while (cursor != end) { *cursor += 1; ++cursor; }
      }
      {
        mut auto cursor = pool.rbegin_mut();
        while (cursor != rend) { *cursor -= 1; ++cursor; }
      }
    }
    adoption_count_end();
    if (adoption_allocations() != uint64_t(0) || checksum != 7680) { return 5; }
  }
  if (pool.get(std::size_t(0)) != 10 || pool.get(std::size_t(2)) != 20 ||
      pool.get(std::size_t(4)) != 30 || pool.size() != std::size_t(3) ||
      pool.capacity() != std::size_t(7)) { return 12; }
  for (mut std::size_t index = 0; index < std::size_t(7); index++) {
    bool live = index == std::size_t(0) || index == std::size_t(2) || index == std::size_t(4);
    if (pool.contains(index) != live) { return 12; }
  }

  std::process_resource process{};
  unsafe {
    auto resource = std::bind_resource(process);
    mut std::resource_storage<int, std::process_resource> slots{resource};
    if (!slots.try_allocate(std::size_t(9))) { return 13; }
    slots.emplace(std::size_t(1), 10);
    slots.emplace(std::size_t(4), 20);
    slots.emplace(std::size_t(8), 30);
    {
      adoption_count_begin();
      mut int checksum = 0;
      for (mut int round = 0; round < 64; round++) {
        auto end = slots.end();
        auto rend = slots.rend();
        mut int count = 0;
        for (mut auto cursor = slots.begin(); cursor != end; ++cursor) {
          checksum += *cursor;
          count++;
        }
        if (count != 3) { return 1; }
        {
          auto first = slots.begin();
          mut auto independent = first;
          ++independent;
          if (*first != 10 || *independent != 20 || first == independent) { return 2; }
        }
        mut int next_value = 30;
        for (mut auto cursor = slots.rbegin(); cursor != rend; ++cursor) {
          if (*cursor != next_value) { return 3; }
          checksum += *cursor;
          next_value -= 10;
        }
        if (next_value != 0) { return 4; }
        {
          mut auto cursor = slots.begin_mut();
          while (cursor != end) { *cursor += 1; ++cursor; }
        }
        {
          mut auto cursor = slots.rbegin_mut();
          while (cursor != rend) { *cursor -= 1; ++cursor; }
        }
      }
      adoption_count_end();
      if (adoption_allocations() != uint64_t(0) || checksum != 7680) { return 5; }
    }
    for (mut std::size_t index = 0; index < std::size_t(9); index++) {
      bool live = index == std::size_t(1) || index == std::size_t(4) || index == std::size_t(8);
      if (slots.initialized(index) != live) { return 15; }
    }
    if (slots.get(std::size_t(1)) != 10 || slots.get(std::size_t(4)) != 20 ||
        slots.get(std::size_t(8)) != 30) { return 16; }
  }
  mut std::simd_mask<8> mask{};
  for (mut std::size_t index = 0; index < std::size_t(8); index++) {
    mask.set(index, index % std::size_t(2) == std::size_t(0));
  }
  {
    adoption_count_begin();
    mut int checksum = 0;
    for (mut int round = 0; round < 64; round++) {
      auto end = mask.end();
      auto rend = mask.rend();
      mut int index = 0;
      for (mut auto cursor = mask.begin(); cursor != end; ++cursor) {
        if (*cursor != (index % 2 == 0)) { return 1; }
        if (*cursor) { checksum += index + 1; }
        index++;
      }
      if (index != 8) { return 2; }
      {
        auto first = mask.begin();
        mut auto independent = first;
        ++independent;
        if (!*first || *independent || first == independent) { return 3; }
      }
      index = 7;
      for (mut auto cursor = mask.rbegin(); cursor != rend; ++cursor) {
        if (*cursor != (index % 2 == 0)) { return 4; }
        if (*cursor) { checksum += index + 1; }
        index--;
      }
      if (index != -1) { return 5; }
      {
        mut auto cursor = mask.begin_mut();
        while (cursor != end) { *cursor = !*cursor; ++cursor; }
      }
      {
        mut auto cursor = mask.rbegin_mut();
        while (cursor != rend) { *cursor = !*cursor; ++cursor; }
      }
    }
    adoption_count_end();
    if (adoption_allocations() != uint64_t(0) || checksum != 2048 || mask.count() != std::size_t(4)) { return 17; }
  }
  for (mut std::size_t index = 0; index < std::size_t(8); index++) {
    if (mask[index] != (index % std::size_t(2) == std::size_t(0))) { return 18; }
  }
  return 0;
}
// --- allocation_counts.cpp
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <new>
#if defined(_WIN32)
#include <malloc.h>
#else
#include <sys/resource.h>
#endif

namespace {
// Cleanup markers must remain visible even when exhaustion immediately aborts.
struct ConfigureAllocationProcess {
  ConfigureAllocationProcess() {
    std::setvbuf(stdout, nullptr, _IONBF, 0);
#if !defined(_WIN32)
    const rlimit limit{0, 0};
    setrlimit(RLIMIT_CORE, &limit);
#endif
  }
} configureAllocationProcess;
bool enabled = false;
std::uint64_t allocations = 0;
std::uint64_t bytes = 0;
std::uint64_t fail_at = 0;
bool audit_cleanup = false;
enum class Path { LegacyAligned, Process };
struct Region {
  void *address = nullptr;
  Path path = Path::Process;
  bool audited = false;
};
Region regions[4096]{};
std::size_t live_count = 0;

bool failed_attempt(std::size_t size) {
  if (!enabled)
    return false;
  ++allocations;
  bytes += size;
  if (fail_at == 0 || allocations != fail_at)
    return false;
  fail_at = 0; // Cleanup can itself print through allocating library code.
  return true;
}

void remember(void *address, Path path) {
  if (!address)
    return;
  for (const auto &region : regions)
    if (region.address == address)
      std::abort();
  for (auto &region : regions) {
    if (!region.address) {
      // Startup argv allocations precede the observation window. Track their
      // exact release too, without including them in scenario counts/leaks.
      region = {address, path, audit_cleanup};
      live_count += audit_cleanup ? 1 : 0;
      return;
    }
  }
  std::abort(); // Never silently lose a live allocation's identity.
}

void retire(void *address, Path path) {
  if (!address)
    return;
  for (auto &region : regions) {
    if (region.address == address) {
      if (region.path != path)
        std::abort();
      if (region.audited) {
        if (live_count == 0)
          std::abort();
        --live_count;
      }
      region = {};
      return;
    }
  }
  std::abort(); // A wrong-provider, untracked or duplicate release is a bug.
}
} // namespace

void *operator new(std::size_t size, std::align_val_t alignment,
                   const std::nothrow_t &) noexcept {
  if (failed_attempt(size))
    return nullptr;
  void *result = nullptr;
  const auto aligned = static_cast<std::size_t>(alignment);
#if defined(_WIN32)
  result = _aligned_malloc(size,
                           aligned < sizeof(void *) ? sizeof(void *) : aligned);
#else
  if (posix_memalign(&result,
                     aligned < sizeof(void *) ? sizeof(void *) : aligned,
                     size) != 0)
    return nullptr;
#endif
  remember(result, Path::LegacyAligned);
  return result;
}

void operator delete(void *pointer, std::align_val_t) noexcept {
  retire(pointer, Path::LegacyAligned);
#if defined(_WIN32)
  _aligned_free(pointer);
#else
  std::free(pointer);
#endif
}

// Inject the real source process-provider boundary, rather than observing an
// obsolete container representation's allocation implementation. These exact
// adapters avoid pulling the production adapter object from the runtime
// archive.
extern "C" std::uint64_t gti_rt_native_size_max_v1() {
  return (std::numeric_limits<std::size_t>::max)();
}
extern "C" std::int32_t gti_rt_address_is_aligned_v1(const void *address,
                                                     std::uint64_t alignment) {
  if (!address || alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      alignment > (std::numeric_limits<std::uintptr_t>::max)())
    return 0;
  return reinterpret_cast<std::uintptr_t>(address) % alignment == 0;
}
#if defined(_WIN32)
extern "C" void *gti_rt_aligned_malloc_v1(std::uint64_t size,
                                          std::uint64_t alignment) {
  if (failed_attempt(static_cast<std::size_t>(size)))
    return nullptr;
  void *address = _aligned_malloc(static_cast<std::size_t>(size),
                                  static_cast<std::size_t>(alignment));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_aligned_free_v1(void *address) {
  retire(address, Path::Process);
  _aligned_free(address);
}
#else
extern "C" std::uint64_t gti_rt_posix_pointer_size_v1() {
  return sizeof(void *);
}
extern "C" std::int32_t gti_rt_posix_enomem_v1() { return ENOMEM; }
extern "C" std::int32_t gti_rt_posix_einval_v1() { return EINVAL; }
extern "C" void *gti_rt_malloc_v1(std::uint64_t bytes) {
  if (failed_attempt(static_cast<std::size_t>(bytes)))
    return nullptr;
  void *address = std::malloc(static_cast<std::size_t>(bytes));
  remember(address, Path::Process);
  return address;
}
extern "C" void *gti_rt_realloc_v1(void *address, std::uint64_t size) {
  if (failed_attempt(size))
    return nullptr;
  for (auto &region : regions) {
    if (region.address == address && region.path == Path::Process) {
      void *result = std::realloc(address, static_cast<std::size_t>(size));
      if (result)
        region.address = result;
      return result;
    }
  }
  std::abort();
}
extern "C" void *gti_rt_posix_memalign_v1(std::uint64_t size,
                                          std::uint64_t alignment,
                                          std::int32_t *status) {
  if (failed_attempt(static_cast<std::size_t>(size))) {
    *status = ENOMEM;
    return nullptr;
  }
  void *address = nullptr;
  *status = posix_memalign(&address, static_cast<std::size_t>(alignment),
                           static_cast<std::size_t>(size));
  remember(address, Path::Process);
  return address;
}
extern "C" void gti_rt_posix_free_v1(void *address) {
  retire(address, Path::Process);
  std::free(address);
}
#endif

extern "C" void adoption_count_begin() {
  allocations = 0;
  bytes = 0;
  enabled = true;
}
extern "C" void adoption_count_end() { enabled = false; }
extern "C" void adoption_trace(std::int32_t value) {
  std::printf("%d\n", static_cast<int>(value));
}
extern "C" std::uint64_t adoption_allocations() { return allocations; }
extern "C" std::uint64_t adoption_bytes() { return bytes; }
extern "C" void adoption_fail_at(std::uint64_t allocation) {
  if (live_count != 0)
    std::abort(); // Reset must never erase leaks from an earlier failure
                  // window.
  adoption_count_begin();
  fail_at = allocation;
  audit_cleanup = true;
}
// Called by the outermost GTI guard after URL and temporary cleanup. GTI's
// terminal failure deliberately does not run unmanaged C++ static destructors.
extern "C" void adoption_check_cleanup() {
  std::printf("live=%zu\n", live_count);
  audit_cleanup = false;
}
