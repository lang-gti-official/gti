// Storage, arena, pool and SIMD cursors stepped or read out of range fail with their report and run cleanup.
//@ run-fail
//@ exit-code: 70
//@ stdout: 20
//@ stdout: 10
//@ revisions: a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18
//@[a1] stderr-contains: runtime error[GTI-R0007]:
//@[a2] args: fail
//@[a2] stderr-contains: runtime error[GTI-R0016]:
//@[a3] args: fail fail
//@[a3] stderr-contains: runtime error[GTI-R0016]:
//@[a4] args: fail fail fail
//@[a4] stderr-contains: runtime error[GTI-R0016]:
//@[a5] args: fail fail fail fail
//@[a5] stderr-contains: runtime error[GTI-R0016]:
//@[a6] args: fail fail fail fail fail
//@[a6] stderr-contains: runtime error[GTI-R0016]:
//@[a7] args: fail fail fail fail fail fail
//@[a7] stderr-contains: runtime error[GTI-R0016]:
//@[a8] args: fail fail fail fail fail fail fail
//@[a8] stderr-contains: runtime error[GTI-R0007]:
//@[a9] args: fail fail fail fail fail fail fail fail
//@[a9] stderr-contains: runtime error[GTI-R0016]:
//@[a10] args: fail fail fail fail fail fail fail fail fail
//@[a10] stderr-contains: runtime error[GTI-R0016]:
//@[a11] args: fail fail fail fail fail fail fail fail fail fail
//@[a11] stderr-contains: runtime error[GTI-R0016]:
//@[a12] args: fail fail fail fail fail fail fail fail fail fail fail
//@[a12] stderr-contains: runtime error[GTI-R0007]:
//@[a13] args: fail fail fail fail fail fail fail fail fail fail fail fail
//@[a13] stderr-contains: runtime error[GTI-R0016]:
//@[a14] args: fail fail fail fail fail fail fail fail fail fail fail fail fail
//@[a14] stderr-contains: runtime error[GTI-R0016]:
//@[a15] args: fail fail fail fail fail fail fail fail fail fail fail fail fail fail
//@[a15] stderr-contains: runtime error[GTI-R0016]:
//@[a16] args: fail fail fail fail fail fail fail fail fail fail fail fail fail fail fail
//@[a16] stderr-contains: runtime error[GTI-R0016]:
//@[a17] args: fail fail fail fail fail fail fail fail fail fail fail fail fail fail fail fail
//@[a17] stderr-contains: runtime error[GTI-R0016]:
//@[a18] args: fail fail fail fail fail fail fail fail fail fail fail fail fail fail fail fail fail
//@[a18] stderr-contains: runtime error[GTI-R0016]:
import std.memory;
import std.simd;
import std.vector;
import std.string;

class Drop {
  int id;
public:
  Drop(int id) : id(id) {}
  ~Drop() { std::println(this.id); }
};

int main(int argc, std::vector<std::string> argv) {
  std::allocator allocator{};
  mut auto guards_allocated = allocator.try_storage<Drop>(std::size_t(5));
  if (!guards_allocated) { return 1; }
  mut auto guards = std::move(guards_allocated).value();
  guards.emplace(std::size_t(1), 10);
  guards.emplace(std::size_t(4), 20);

  if (argc >= 13 && argc <= 15) {
    mut auto allocated = allocator.try_storage<int>(std::size_t(4));
    if (!allocated) { return 4; }
    mut auto values = std::move(allocated).value();
    if (argc == 13) {
      values.construct(std::size_t(2), 1);
      mut auto reverse = values.rbegin();
      --reverse;
    } else if (argc == 14) {
      mut auto reverse = values.rend_mut();
      ++reverse;
    } else {
      auto reverse = values.rbegin();
      return *reverse;
    }
    return 99;
  }
  if (argc == 16) {
    mut auto allocated = std::try_make_arena<int>(std::size_t(5));
    if (!allocated) { return 5; }
    mut auto values = std::move(allocated).value();
    [[discard]] values.try_insert(42);
    mut auto reverse = values.rbegin_mut();
    reverse += std::ptrdiff_t(2);
    return 99;
  }
  if (argc >= 17) {
    mut std::simd_mask<4> values{};
    if (argc == 17) {
      auto reverse = values.rend_mut();
      return *reverse ? 6 : 7;
    }
    mut auto reverse = values.rbegin_mut();
    reverse -= std::ptrdiff_t(-9223372036854775807) - std::ptrdiff_t(1);
    return 99;
  }

  if (argc <= 4) {
    mut auto allocated = allocator.try_storage<int>(std::size_t(4));
    if (!allocated) { return 2; }
    mut auto values = std::move(allocated).value();
    if (argc == 1) {
      auto end = values.end_iterator();
      return *end;
    }
    if (argc == 2) {
      mut auto empty = values.begin();
      --empty;
    } else if (argc == 3) {
      mut auto end = values.end_mut();
      ++end;
    } else {
      values.construct(std::size_t(2), 1);
      mut auto first = values.begin();
      --first;
    }
  } else if (argc <= 8) {
    mut auto allocated = std::try_make_arena<int>(std::size_t(5));
    if (!allocated) { return 3; }
    mut auto values = std::move(allocated).value();
    [[discard]] values.try_insert(42);
    mut auto cursor = values.begin_mut();
    if (argc == 5) {
      --cursor;
    } else if (argc == 6) {
      cursor += std::ptrdiff_t(2);
    } else if (argc == 7) {
      cursor -= std::ptrdiff_t(-9223372036854775807) - std::ptrdiff_t(1);
    } else {
      return cursor[std::ptrdiff_t(1)];
    }
  } else {
    mut std::simd_mask<4> values{};
    mut auto cursor = values.begin_mut();
    if (argc == 9) {
      --cursor;
    } else if (argc == 10) {
      cursor += std::ptrdiff_t(4);
      ++cursor;
    } else if (argc == 11) {
      cursor -= std::ptrdiff_t(-9223372036854775807) - std::ptrdiff_t(1);
    } else {
      return cursor[std::ptrdiff_t(4)] ? 4 : 5;
    }
  }
  return 99;
}
