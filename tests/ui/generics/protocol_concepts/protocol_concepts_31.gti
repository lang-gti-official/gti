// Protocol concepts: rejected with GTI-S2029, GTI-S2123.
concept measurable<T> {
  typename unit_type;
  unit_type measure(T& item);
  bool is_empty(T& item);
};
struct Meters {
  int value;
  Meters(int amount) : value(amount) {}
};
class Rope {
public:
  int length;
  Rope(int amount) : length(amount) {}
};
class Crate<T> {
public:
  T item;
  int count;
  Crate(T stored, int amount) : item(stored), count(amount) {}
};
for <unknown_constraint T> concept measurable<Crate<T>> {  //~ ERROR GTI-S2029 //~ ERROR GTI-S2123
using unit_type = int;
int measure(Crate<T>& item) { return 1; }
};
int main() { return 0; }
