// Protocol concepts: rejected with GTI-S2003, GTI-S2123.
concept measurable<T> {
  typename unit_type;
  unit_type measure(T& item);
  bool is_empty(T& item);
};
struct Meters {
  int value;
  Meters(int amount) : value(amount) {}
};
class Rope {
public:
  int length;
  Rope(int amount) : length(amount) {}
};
class Crate<T> {
public:
  T item;
  int count;
  Crate(T stored, int amount) : item(stored), count(amount) {}
};

int main() {
  measurable<Rope>::unit_type length = Meters(1);  //~ ERROR GTI-S2123 //~ ERROR GTI-S2003
  return 0;
}
