// The else branch of a concept condition does not get its members.
//@ check-fail
concept sized<T> = requires(T& v) { { v.size() } -> uint64_t; };
int f<T>(T& v) { if constexpr(sized<T>) { return 0; } else { return int(v.size()); } } int main() { int x = 1; return f(x); }  //~ ERROR GTI-S2000 Member access requires
