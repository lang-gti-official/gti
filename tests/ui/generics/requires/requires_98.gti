// General requires: a different instantiation is checked on a reused query catalog diagnostic.
constexpr bool compact<T>() { return sizeof(T) <= uint64_t(8); }
concept small<T> = compact<T>();
concept doubles<T> = requires(T& value) {
  { value.read() + value.read() } -> int;
};
struct Lane<uint64_t N> {
  int slots[N] = {};
  int read() { return 1; }
public:
  Lane() = default;
};
struct Probe<T> {
  T level;
  T read() { return this.level; }
public:
  Probe(T input) : level(input) {}
};
class Sealed {
  int read() { return 2; }
public:
  Sealed() = default;
};
int take<doubles T>(T& value) { return 1; }
int fit<small T>(T& value) { return 1; }

int main() { Probe<int> a{1}; Probe<bool> b{true}; return take(a) + take(b); }  //~ ERROR GTI-S2029
