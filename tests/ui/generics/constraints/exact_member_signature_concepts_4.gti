// Exact member signature concepts: signature requirements must reject receiver, access, arity, result, static and private mismatches.
concept accepts<C, V> = requires(mut C& receiver, V& input, mut V& output) {
  { receiver.apply(input, output) } -> int;
};
int invoke<C>(mut C& receiver, int& input, mut int& output)
    requires accepts<C, int> { return receiver.apply(input, output); }
struct Processor { int apply(int input, mut int& output) mut { return 1; } };int main() { mut Processor p{}; int input = 7; mut int output = 0; return invoke(p, input, output); }  //~ ERROR GTI-S2012 //~ ERROR GTI-S2029
