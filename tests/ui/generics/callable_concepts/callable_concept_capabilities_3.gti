// Callable concept capabilities: analysis result.
import std.functional;
class once_only {
public:
  bool operator()(int32_t& value) && { return value > 0; }
public:
  once_only() = default;
};
bool inspect<Function>(int32_t value, mut Function function)
  requires std::predicate<Function, int32_t> {
  return function(value);
}
int main() { return inspect(1, once_only()) ? 0 : 1; }  //~ ERROR GTI-S2029
