// Callable concept capabilities: analysis result.
import std.functional;
class borrowed_result {
public:
  int32_t& operator()(int32_t& value) { return value; }  //~ ERROR GTI-S2017
public:
  borrowed_result() = default;
};
int32_t transform<Function>(int32_t value, mut Function function)
  requires std::operation<Function, int32_t, int32_t> {
  return function(value);
}
int main() { return transform(1, borrowed_result()) - 1; }  //~ ERROR GTI-S2029
