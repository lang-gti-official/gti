// Aliases: an unused alias cannot bypass its concrete class constraint.
class Key {
  int value;
public:
  Key(int value) : value(value) {}
  bool operator==(Key& other) { return this.value == other.value; }
  bool operator!=(Key& other) { return this.value != other.value; }
};
class Policy<std::equality_comparable T> {
public:
  Policy() {}
};

class Missing { public: Missing() {} };
using Unused = Policy<Missing>;  //~ ERROR GTI-S2029
int main() { return 0; }
