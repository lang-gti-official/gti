// Whole-type bindings constrained to incompatible types keep heads disjoint.
concept reading<A, B> { int read(A a, B b); };
struct Box<T> { T value; Box(T value) : value(std::move(value)) {} };
for <T> concept reading<T, T> {
  int read(T a, T b) { return 1; }
};
for <U> concept reading<Box<U>, int> {
  int read(Box<U> a, int b) { return 2; }
};
int main() { return reading<int, int>::read(1, 2) - 1; }
