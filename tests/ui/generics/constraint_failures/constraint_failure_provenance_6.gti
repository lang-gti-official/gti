// Constraint failure provenance: nested generic inference must distinguish the actual argument type from the leaf type it supplies.
concept snapshots<T> = requires(T& value) { { value.snapshot() } -> int; };
struct Holder<T> { public: Holder() = default; };
struct Item { public: Item() = default; };
int read<T>(Holder<T>& value) requires snapshots<T> { return 0; }
int main() { Holder<Item> value{}; return read(value); }  //~ ERROR GTI-S2029 Argument 1 has type 'Holder<Item>'
