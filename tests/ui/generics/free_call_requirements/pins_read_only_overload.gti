// A mutable place uses the read-only overload proven by the requirement.
//@ run-pass
int describe(int& error) { return 12; }
int describe(mut int& error) { return 25; }

concept Described<E> = requires(E& error) {
  { describe(error) } -> int;
};

int checked<E>(mut E& error) requires Described<E> {
  return describe(error);
}

int main() {
  mut int error = 2;
  return checked(error) != 12 ? 1 : 0;
}
