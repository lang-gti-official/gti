// Container scaffold surfaces: mutating an owner while a copied read-only span is live should be rejected by the ordinary retained-loan rule.
import std.vector;
import std.span;
int main() {
  mut std::vector<int> values = std::vector<int>({1, 2});
  std::span<int> view = values.as_span();
  values.push_back(3);  //~ ERROR GTI-S2017
  return view.empty() ? 0 : 1;
}
