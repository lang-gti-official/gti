// A view formal's local copy reassigned in an `if` to a sub-view of that formal joins its owners (the reported ICE).
//@ run-pass
import std.string_view;

bool is_true(std::string_view entry) {
  mut std::string_view value = entry;
  if (entry.size() > 1u64) {
    value = entry.substr(1u64, entry.size() - 1u64);
  }
  return value == "true";
}

int main() {
  if (is_true("xtrue")) return 0;
  return 1;
}
