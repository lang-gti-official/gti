// Both possible substrings depend on their storage, even after the conditional.
import std.string;

std::string make_text() {
  mut std::string result{};
  result.push_back('x');
  return result;
}

int use(bool trim) {
  mut std::string owner = make_text();
  mut std::string_view text = owner.view();
  if (trim) text = text.substr(1u64);
  owner.clear();  //~ ERROR GTI-S2017
  return text.empty() ? 0 : 1;
}

int main() { return use(true); }
