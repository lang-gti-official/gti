// Moving a payload through a constant branch preserves its active alternative.
//@ run-pass
//@ opt: O3
//@ reason: Constant branch folding must respect path-sensitive dependency facts.
import std.utility;
enum State { empty, number(int64_t value) };
int consume(State value) {
  switch (value) {
  case State::number(auto& n): return n == 200 ? 0 : 1;
  default: return 2;
  }
}
int main() {
  mut State value = State::empty;
  if (true) { value = State::number(200); }
  return consume(std::move(value));
}
