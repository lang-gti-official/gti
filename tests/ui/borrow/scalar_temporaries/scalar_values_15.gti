// Scalar values: lazy scalar temporary is path-local.
//@ check-pass
enum Color { Red, Green };
int read(int& value) { return value; }
int make() { return 42; }
Color pick() { return Color::Red; }
bool red(Color& value) { return value == Color::Red; }
int main() { bool skip = false; return skip && read(1 / (make() - 42)) == 1 ? 1 : 0; }
