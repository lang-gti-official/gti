// A consumed temporary's shared stored group taken from a mutable reference relays a read-only result.
//@ run-pass
//@ exit-code: 0

// `Reader(mine)` stores a shared reference made from the caller's
// `mut Box&<a>`. The shared group suspends that exclusive authority; the
// consumed method's result joins the group's readers and outlives the
// temporary, returned or bound.
struct Box {
  mut int value;
  Box(int v) : value(v) {}
};
class Reader<lifetime owner> {
  Box&<owner> direct;
public:
  Reader(Box&<owner> direct) : direct(direct) {}
  int&<owner> consumed() && { return this.direct.value; }
};
int&<a> returned<lifetime a>(mut Box&<a> mine) {
  return Reader(mine).consumed();
}
int bound<lifetime a>(mut Box&<a> mine) {
  int& kept = Reader(mine).consumed();
  int seen = mine.value;
  return kept + seen;
}
int main() {
  mut Box mine{9};
  if (returned(mine) != 9) { return 1; }
  if (bound(mine) != 18) { return 2; }
  mine.value = 4;
  return returned(mine) == 4 ? 0 : 3;
}
