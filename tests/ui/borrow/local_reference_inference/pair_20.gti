// Pair: no source case reaches an internal backend error.
struct Record { mut int count = 1;  public: Record() = default; };
class Owner {
  mut int count = 7;
public:
  Owner() = default;
  Owner(Owner& other) = delete;
  Owner(Owner&& other) = default;
  int read() { return count; }
  void set(int value) mut { count = value; }
  int& field() { return this.count; }
  mut int& field_mut() mut { return this.count; }
};
expected<Owner&, int> lookup(Owner& owner, bool fail) {
  if (fail) { return unexpected(9); }
  return owner;
}
int main() { mut Record owner{}; auto& alias = owner;
    owner.count = 2; return alias.count; }  //~ ERROR GTI-S2017
