// Borrowed storage: owned construction record field protects owner.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.memory;
class Number { public: mut int value; Number(int input) : value(input) {} };
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  mut Number owner{42};
  mut std::uninitialized<Reading> storage{};
  unsafe {
    Reading* address = storage.data();
    std::construct_owned_at<Reading, std::uninitialized<Reading>, int&>(address, storage, owner.value);
    owner.value = 99;  //~ ERROR GTI-S2017 Cannot assign to storage while an overlapping borrow may still be live.
    auto selected = std::borrow_owned_at(address, storage);
    std::destroy_at(address);
    return selected.read() == 42 ? 0 : 1;
  }
}
