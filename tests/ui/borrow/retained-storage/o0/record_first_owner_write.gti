// Borrowed storage: record first owner write.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
struct Labels<lifetime a, lifetime b> {
  std::string_view<a> first; std::string_view<b> second;
  Labels(std::string_view<a> x, std::string_view<b> y):first(x),second(y){}
};
int main() {
  mut std::string first{"first"}; std::string second{"second"};
  Labels labels{first.view(),second.view()};
  first.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return labels.first == "first" && labels.second == "second" ? 0 : 1;
}
