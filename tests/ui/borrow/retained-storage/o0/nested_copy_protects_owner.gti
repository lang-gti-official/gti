// Borrowed storage: nested copy protects owner.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
int main() {
  mut std::string owner{"retained"}; mut std::string_view outer = "";
  { mut std::string_view inner = ""; inner = owner.view(); outer = inner; }
  owner.clear(); return outer == "retained" ? 0 : 1;  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
}
