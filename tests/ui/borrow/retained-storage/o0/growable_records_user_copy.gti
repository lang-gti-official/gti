// Borrowed storage: growable records user copy.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
T copy_borrowed<T>(T& value)
    requires std::copy_constructible<T> { return value; }
int main() {
  int first = 11; int second = 22;
  mut std::vector<Reading> values{};
  values.push_back(Reading(first));
  values.push_back(Reading(second));
  Reading selected = copy_borrowed(values[0]);
  values.reserve(32);
  return selected.read() == 11 ? 0 : 1;
}
