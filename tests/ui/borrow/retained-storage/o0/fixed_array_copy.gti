// Borrowed storage: fixed array copy.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
int main() {
  std::string first{"first"}; std::string second{"second"};
  std::string_view views[2] = {first.view(), second.view()};
  auto copied = views;
  return copied[0] == "first" && copied[1] == "second" ? 0 : 1;
}
