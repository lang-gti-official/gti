// Borrowed storage: growable records element replacement rejects expired owner.
//@ check-fail
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11;
  mut std::vector<Reading> values{};
  values.emplace_back(Reading(first));
  auto old = values[0];
  { int second = 22;
    values[0] = Reading(second);
  }
  values.reserve(32);  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
  auto current = values[0];
  return old.read() == 11 && current.read() == 22 ? 0 : 1;
}
