// Borrowed storage: growable records emplace return protects second.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; mut int second = 22;
  mut std::vector<Reading> values{};
  values.emplace_back(Reading(first));
  mut Reading& added = values.emplace_back(Reading(second));
  auto selected = added;
  values.reserve(32);
  second = 99;  //~ ERROR GTI-S2017 Cannot assign to storage while an overlapping borrow may still be live.
  return selected.read() == 22 && values.size() == 2 && values[0].read() == 11 && values[1].read() == 22 ? 0 : 1;
}
