// Borrowed storage: growable views adapter user copy rejects ended storage.
//@ check-fail
import std.string;
import std.utility;
import std.vector;
class BorrowedAccess<std::vector_element T, lifetime source> {
  std::vector<T>&<source> owner;
public:
  BorrowedAccess(std::vector<T>&<source> input) : owner(input) {}
  T& get(std::size_t index) { return this.owner[index]; }
};
int main() {
  std::string first{"first"}; std::string second{"second"};
  mut std::string_view selected = "";
  {
  mut std::vector<std::string_view> values{};
  values.push_back(first.view());
  values.push_back(second.view());
  values.reserve(32);
  auto adapter = BorrowedAccess<std::string_view>(values);
  selected = adapter.get(0);
  }
  return selected == "first" ? 0 : 1;  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
}
