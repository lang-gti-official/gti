// Borrowed storage: fixed array return unrelated region.
//@ check-fail
import std.string;
import std.utility;
std::string_view<a>[2] pair_views<lifetime a, lifetime b>(std::string_view<a> first, std::string_view<b> second) {
  return {first, second};
}
int main() {
  std::string first{"first"}; std::string second{"second"};
  auto values = pair_views(first.view(), second.view());
  return values[0] == "first" && values[1] == "second" ? 0 : 1;  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
}
