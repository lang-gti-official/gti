// Borrowed storage: owned storage relocate record.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.memory;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int owner = 42;
  mut std::uninitialized<Reading> destination{};
  {
    mut std::uninitialized<Reading> source{};
    unsafe {
      std::initialize_owned_at(source.data(), source, Reading(owner));
      std::relocate_owned_at(destination.data(), destination, source.data(), source);
    }
  }
  unsafe {
    Reading selected = std::borrow_owned_at(destination.data(), destination);
    return selected.read() == 42 ? 0 : 1;
  }
}
