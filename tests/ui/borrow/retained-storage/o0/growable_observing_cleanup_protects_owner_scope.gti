// Borrowed storage: growable observing cleanup protects owner scope.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.vector;
import std.string;
class Observed {
  int& source;
public:
  Observed(int& input) : source(input) {}
  ~Observed() { std::println(this.source); }
};
int main() {  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
  mut std::vector<Observed> values{};
  { int owner = 11; values.push_back(Observed(owner)); }
  return 0;
}
