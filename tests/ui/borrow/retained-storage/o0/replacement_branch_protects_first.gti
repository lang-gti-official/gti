// Borrowed storage: replacement branch protects first.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
int check(bool replace) {
  mut std::string first{"first"}; mut std::string second{"second"};  //~ WARN GTI-S2096 Mutable binding 'second' is never used mutably.
  mut std::string_view view = first.view();
  if (replace) { view = second.view(); }
  first.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return view == "second" ? 0 : 1;
}
int main() { return check(true); }
