// Borrowed storage: fixed array reference record outlives storage.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; int second = 22;
  mut Reading selected{first};
  {
  Reading values[2] = {Reading(first), Reading(second)};
  selected = values[1];
  }
  return selected.read() == 22 ? 0 : 1;
}
