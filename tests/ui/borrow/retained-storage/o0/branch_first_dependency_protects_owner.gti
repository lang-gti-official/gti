// Borrowed storage: branch first dependency protects owner.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
int check(bool choose) {
  mut std::string owner{"borrowed"};
  mut std::string_view view = "literal";
  if (choose) { view = owner.view(); }
  owner.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return view == (choose ? "borrowed" : "literal") ? 0 : 1;
}
int main() { return check(true) + check(false); }
