// Borrowed storage: replacement loop protects inner owner.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
int main() {
  mut std::string_view view = "";
  for (mut int i = 0; i < 2; i += 1) {
    std::string owner{"short"}; view = owner.view();
  }
  return view == "short" ? 0 : 1;  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
}
