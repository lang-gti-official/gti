// Borrowed storage: constructor retained view protects owner.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.string;
class Borrowed {
  std::string_view text;
public:
  Borrowed(std::string_view input) : text(input) {}
  std::size_t size() { return this.text.size(); }
};
int main() {
  mut std::string local{"kept"};
  Borrowed value{local.view()};
  local.push_back('!');  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return value.size() == 4 ? 0 : 1;
}
