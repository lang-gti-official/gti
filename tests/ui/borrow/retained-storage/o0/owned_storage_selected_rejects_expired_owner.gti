// Borrowed storage: owned storage selected rejects expired owner.
//@ check-fail
import std.string;
import std.utility;
import std.memory;
int main() {
  mut std::string_view selected = "";
  {
    std::string owner{"borrowed"};
    mut std::uninitialized<std::string_view> storage{};
    unsafe {
      std::string_view* address = storage.data();
      std::initialize_owned_at(address, storage, owner.view());
      selected = std::borrow_owned_at(address, storage);
    }
  }
  return selected == "borrowed" ? 0 : 1;  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
}
