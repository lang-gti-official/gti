// Borrowed storage: constructor iterator copy is independent.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.string;
int main() {
  mut std::string source{"hello"};
  std::string copy{source.begin(), source.end()};
  source.push_back('!');
  return copy == "hello" && source == "hello!" ? 0 : 1;
}
