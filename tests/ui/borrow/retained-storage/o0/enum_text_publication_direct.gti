// Borrowed storage: enum text publication direct.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;

enum Text { empty, value(std::string_view text) };
int main() {
  mut std::string owner{"owned"};  //~ WARN GTI-S2096 Mutable binding 'owner' is never used mutably.
  std::string_view view = owner.view();
  auto text = Text::value(owner.view());
  switch (text) {
    case Text::value(selected): return selected == "owned" ? 0 : 1;
    case Text::empty: return 2;
  }
}
