// Borrowed storage: fixed array reference records protects second.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; mut int second = 22;
  Reading values[2] = {Reading(first), Reading(second)};
  auto copied = values;
  second = 99;  //~ ERROR GTI-S2017 Cannot assign to storage while an overlapping borrow may still be live.
  return copied[0].read() == 11 && copied[1].read() == 22 ? 0 : 1;
}
