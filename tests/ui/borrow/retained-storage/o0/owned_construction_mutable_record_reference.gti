// Borrowed storage: owned construction mutable record reference.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.memory;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int owner = 42;
  mut std::uninitialized<Reading> storage{};
  unsafe {
    Reading* address = storage.data();
    std::construct_owned_at(address, storage, Reading(owner));
    mut Reading& selected = std::borrow_owned_mut_at(address, storage);
    return selected.read() == 42 ? 0 : 1;
  }
}
