// Borrowed storage: field forward protects owner.
//@ check-fail
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
struct BorrowedCell<T> {
  mut T value;
  BorrowedCell(T initial):value(initial){}
  void put(T input) mut { this.value = input; }
  void forward(T input) mut { this.put(input); }
};
int main() {
  mut std::string owner{"borrowed"};
  mut BorrowedCell<std::string_view> cell{"initial"};
  cell.forward(owner.view());
  owner.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return cell.value == "borrowed" ? 0 : 1;
}
