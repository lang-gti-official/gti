// Borrowed storage: growable records shared access without reserve.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; int second = 22;
  mut std::vector<Reading> values{};
  values.push_back(Reading(first));
  values.push_back(Reading(second));
  std::vector<Reading>& shared = values;
  return shared.size() == 2 && shared[0].read() == 11 && shared[1].read() == 22 ? 0 : 1;
}
