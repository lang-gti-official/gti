// Borrowed storage: fixed array one owner.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
int main() {
  std::string first{"first"}; std::string second{"second"};
  std::string_view views[2] = {first.view(), "second"};
  return views[0] == "first" && views[1] == "second" ? 0 : 1;
}
