// Borrowed storage: growable views shared access.
//@ run-pass
//@ stderr-empty
import std.string;
import std.utility;
import std.vector;
int main() {
  std::string first{"first"}; std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.push_back(first.view());
  values.push_back(second.view());
  values.reserve(32);
  std::vector<std::string_view>& shared = values;
  return shared.size() == 2 && shared[0] == "first" && shared[1] == "second" ? 0 : 1;
}
