// Borrowed storage: owned construction record local replacement.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  mut int first = 11;
  int second = 22;
  mut Reading selected{first};
  selected = Reading(second);
  first = 99;
  return selected.read() == 22 ? 0 : 1;
}
