// Borrowed storage: owned construction record rejects expired owner.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
import std.memory;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  mut std::uninitialized<Reading> storage{};
  {
    int owner = 42;
    unsafe {
      std::construct_owned_at<Reading, std::uninitialized<Reading>, int&>(storage.data(), storage, owner);
    }
  }
  unsafe {
    Reading* address = storage.data();  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
    auto selected = std::borrow_owned_at(address, storage);
    std::destroy_at(address);
    return selected.read() == 42 ? 0 : 1;
  }
}
