// Borrowed storage: growable records adapter user protects first.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
class BorrowedAccess<std::vector_element T, lifetime source> {
  std::vector<T>&<source> owner;
public:
  BorrowedAccess(std::vector<T>&<source> input) : owner(input) {}
  T& get(std::size_t index) { return this.owner[index]; }
};
int main() {
  mut int first = 11; int second = 22;
  mut std::vector<Reading> values{};
  values.push_back(Reading(first));
  values.push_back(Reading(second));
  values.reserve(32);
  auto adapter = BorrowedAccess<Reading>(values);
  auto selected = adapter.get(0);
  first = 99;  //~ ERROR GTI-S2017 Cannot assign to storage while an overlapping borrow may still be live.
  return selected.read() == 11 ? 0 : 1;
}
