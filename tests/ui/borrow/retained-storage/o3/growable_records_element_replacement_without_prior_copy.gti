// Borrowed storage: growable records element replacement without prior copy.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; int second = 22;
  mut std::vector<Reading> values{};
  values.emplace_back(Reading(first));
  values[0] = Reading(second);
  values.reserve(32);
  auto current = values[0];
  return current.read() == 22 ? 0 : 1;
}
