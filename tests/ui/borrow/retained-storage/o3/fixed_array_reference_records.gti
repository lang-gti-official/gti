// Borrowed storage: fixed array reference records.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; int second = 22;
  Reading values[2] = {Reading(first), Reading(second)};
  auto copied = values;
  return copied[0].read() == 11 && copied[1].read() == 22 ? 0 : 1;
}
