// Borrowed storage: record replacement captured reference protects owner.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;

int& read_reference(int& value) { return value; }

class ReadCarrier {
public:
  int& referent;
  ReadCarrier(int& source) : referent(source) {}
};
int use() {
  mut int first_owner = 1;
  mut int second_owner = 2;
  mut ReadCarrier left = ReadCarrier(first_owner);
  ReadCarrier right = ReadCarrier(second_owner);
  left = right;
  first_owner = 3;
  int& held = read_reference(left.referent);
  left = ReadCarrier(first_owner);
  second_owner = 4;  //~ ERROR GTI-S2017 Cannot assign to storage while an overlapping borrow may still be live.
  return held - 2;
}
int main() { return use(); }
