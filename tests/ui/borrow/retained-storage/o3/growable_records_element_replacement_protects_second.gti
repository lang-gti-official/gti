// Borrowed storage: growable records element replacement protects second.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; mut int second = 22;
  mut std::vector<Reading> values{};
  values.emplace_back(Reading(first));
  auto old = values[0];
  values[0] = Reading(second);
  values.reserve(32);
  second = 99;  //~ ERROR GTI-S2017 Cannot assign to storage while an overlapping borrow may still be live.
  auto current = values[0];
  return old.read() == 11 && current.read() == 22 ? 0 : 1;
}
