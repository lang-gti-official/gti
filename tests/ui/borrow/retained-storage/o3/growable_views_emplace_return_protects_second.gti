// Borrowed storage: growable views emplace return protects second.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.vector;
int main() {
  std::string first{"first"}; mut std::string second{"second"};
  mut std::vector<std::string_view> values{};
  values.emplace_back(first.view());
  mut std::string_view& added = values.emplace_back(second.view());
  auto selected = added;
  values.reserve(32);
  second.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return selected == "second" && values.size() == 2 && values[0] == "first" && values[1] == "second" ? 0 : 1;
}
