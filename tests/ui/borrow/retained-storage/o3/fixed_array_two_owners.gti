// Borrowed storage: fixed array two owners.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
int main() {
  std::string first{"first"}; std::string second{"second"};
  std::string_view views[2] = {first.view(), second.view()};
  return views[0] == "first" && views[1] == "second" ? 0 : 1;
}
