// Borrowed storage: growable records emplace return.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; int second = 22;
  mut std::vector<Reading> values{};
  values.emplace_back(Reading(first));
  mut Reading& added = values.emplace_back(Reading(second));
  auto selected = added;
  values.reserve(32);
  return selected.read() == 22 && values.size() == 2 && values[0].read() == 11 && values[1].read() == 22 ? 0 : 1;
}
