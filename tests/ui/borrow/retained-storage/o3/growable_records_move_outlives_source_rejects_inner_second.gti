// Borrowed storage: growable records move outlives source rejects inner second.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11;
  mut std::vector<Reading> copied{};
  {
  int second = 22;
  mut std::vector<Reading> values{};
  values.push_back(Reading(first));
  values.push_back(Reading(second));
  mut std::vector<Reading> temporary = std::move(values);
  temporary.swap(copied);
  }
  copied.reserve(32);  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
  return copied.size() == 2 && copied[0].read() == 11 && copied[1].read() == 22 ? 0 : 1;
}
