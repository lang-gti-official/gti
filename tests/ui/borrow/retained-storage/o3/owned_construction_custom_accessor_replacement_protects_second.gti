// Borrowed storage: owned construction custom accessor replacement protects second.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
import std.memory;
class RawSlots<std::layout_queryable T> {
public:
  mut std::uninitialized<T> left{};
  mut std::uninitialized<T> right{};
  RawSlots() = default;
  mut T& operator[](int index) mut {
    unsafe { return std::borrow_owned_mut_at(this.left.data(), this); }
  }
};
int main() {
  std::string first{"first"}; mut std::string second{"second"};
  mut RawSlots<std::string_view> storage{};
  unsafe {
    std::string_view* left = storage.left.data();
    std::string_view* right = storage.right.data();
    std::initialize_owned_at(left, storage, first.view());
    std::initialize_owned_at(right, storage, "unused");
    auto old = storage[0];
    storage[0] = second.view();
    second.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
    std::string_view selected = storage[0];
    return old == "first" && selected == "second" ? 0 : 1;
  }
}
