// Borrowed storage: growable records element reference blocks growth.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
import std.vector;
class Reading {
  int& value;
public:
  Reading(int& input) : value(input) {}
  int read() { return this.value; }
};
int main() {
  int first = 11; int second = 22;
  mut std::vector<Reading> values{};
  values.push_back(Reading(first));
  values.push_back(Reading(second));
  Reading& element = values[0];
  values.reserve(32);  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  if (element.read() != 11) { return 2; }
  return values.size() == 2 && values[0].read() == 11 && values[1].read() == 22 ? 0 : 1;
}
