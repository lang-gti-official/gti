// Borrowed storage: fixed slots selected protects second.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
struct FixedSlots<T, uint64_t Capacity> {
  mut T values[Capacity];
  mut uint64_t used;
  FixedSlots():values({}),used(0){}
  bool push(T value) mut {
    if (this.used == Capacity) { return false; }
    this.values[this.used] = value;
    this.used += 1;
    return true;
  }
  T at(uint64_t index) { return this.values[index]; }
  uint64_t size() { return this.used; }
};
int main() {
  std::string first{"first"}; mut std::string second{"second"};
  mut std::string_view selected = "";
  {
    mut FixedSlots<std::string_view, 2> slots{};
    if (!slots.push(first.view()) || !slots.push(second.view())) { return 1; }
    selected = slots.at(0);
  }
  second.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return selected == "first" ? 0 : 2;
}
