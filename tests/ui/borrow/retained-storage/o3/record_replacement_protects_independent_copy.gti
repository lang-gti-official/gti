// Borrowed storage: record replacement protects independent copy.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;


class ReadCarrier {
public:
  int& referent;
  ReadCarrier(int& source) : referent(source) {}
};
int use() {
  mut int first_owner = 1;
  mut int second_owner = 2;  //~ WARN GTI-S2096 Mutable binding 'second_owner' is never used mutably.
  mut ReadCarrier left = ReadCarrier(first_owner);
  ReadCarrier right = ReadCarrier(second_owner);
  ReadCarrier copied = left;
  left = right;
  first_owner = 3;  //~ ERROR GTI-S2017 Cannot assign to storage while an overlapping borrow may still be live.
  return copied.referent - 1;
}
int main() { return use(); }
