// Borrowed storage: local escape through store.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
int main() {
  mut std::string_view view = "initial";
  { std::string local{"short"}; view = local.view(); }
  return view == "short" ? 0 : 1;  //~ ERROR GTI-S2017 Cannot use a borrowed value after its owner or retained dependency has become unavailable.
}
