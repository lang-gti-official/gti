// Borrowed storage: copy retains old owner.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
int main() {
  mut std::string first{"first"}; std::string second{"second"};
  mut std::string_view view = first.view(); auto copy = view;
  view = second.view(); first.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  return copy == "first" && view == "second" ? 0 : 1;
}
