// Borrowed storage: fixed array local alias control.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
int main() {
  mut std::string first{"first"}; mut std::string second{"second"};  //~ WARN GTI-S2096 Mutable binding 'first' is never used mutably.
//~| WARN GTI-S2096 Mutable binding 'second' is never used mutably.
  std::string_view views[2] = {first.view(), second.view()};
  auto& alias = views;

  return alias[0] == "first" && alias[1] == "second" ? 0 : 1;
}
