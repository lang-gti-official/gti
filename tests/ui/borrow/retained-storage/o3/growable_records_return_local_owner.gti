// Borrowed storage: growable records return local owner.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
import std.vector;
class Reading<lifetime a> {
  int&<a> value;
public:
  Reading(int&<a> input) : value(input) {}
  int read() { return this.value; }
};
Reading<a> pick<lifetime a>(int&<a> first, int&<a> second) {
  int local = 99;
  mut std::vector<Reading<a>> values{};
  values.push_back(Reading<a>(local)); values.push_back(Reading<a>(second));
  Reading<a> selected = values[0];
  values.reserve(32);
  return selected;  //~ ERROR GTI-S2017 A returned borrow does not outlive the function: it depends on storage the function owns.
}
int main() {
  int first = 11; int second = 22;
  Reading selected = pick(first, second);
  return selected.read() == 11 ? 0 : 1;
}
