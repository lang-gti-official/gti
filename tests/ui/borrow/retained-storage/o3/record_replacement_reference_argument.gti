// Borrowed storage: record replacement reference argument.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
int read_reference(int& value) { return value; }


class ReadCarrier {
public:
  int& referent;
  ReadCarrier(int& source) : referent(source) {}
};
int use() {
  mut int first_owner = 1;
  mut int second_owner = 2;  //~ WARN GTI-S2096 Mutable binding 'second_owner' is never used mutably.
  mut ReadCarrier left = ReadCarrier(first_owner);
  ReadCarrier right = ReadCarrier(second_owner);
  left = right;
  first_owner = 3;
  return read_reference(left.referent) - 2;
}
int main() { return use(); }
