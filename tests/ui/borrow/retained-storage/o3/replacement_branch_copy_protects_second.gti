// Borrowed storage: replacement branch copy protects second.
//@ check-fail
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
//@ diagnostic-note: Retained borrow originates here.
import std.string;
import std.utility;
int check(bool replace) {
  std::string first{"first"}; mut std::string second{"second"};
  mut std::string_view view = first.view();
  if (replace) { view = second.view(); }
  auto copied = view; view = "replacement";
  second.clear();  //~ ERROR GTI-S2017 Mutable method cannot use move-only storage while a reference borrowed from it may still be live.
  if (replace) { return copied == "second" ? 0 : 1; }
  return copied == "first" ? 0 : 2;
}
int main() { return check(true) + check(false); }
