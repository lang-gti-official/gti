// Borrowed storage: branch first dependency one arm.
//@ run-pass
//@ stderr-empty
//@ opt: O3
//@ reason: Preserve optimized borrowed-storage execution and rejection coverage.
import std.string;
import std.utility;
int check(bool choose) {
  std::string owner{"borrowed"};
  mut std::string_view view = "literal";
  if (choose) { view = owner.view(); }
  return view == (choose ? "borrowed" : "literal") ? 0 : 1;
}
int main() { return check(true) + check(false); }
