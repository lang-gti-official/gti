// A whole-receiver subview retains both independently supplied external owners.
//@ run-pass
struct Pair {
  int& left;
  int& right;
  Pair(int& left, int& right) : left(left), right(right) {}
  Pair subview() { return Pair(this.left, this.right); }
  int sum() { return this.left + this.right; }
};
int main() {
  int left = 3;
  int right = 5;
  auto view = Pair(left, right);
  auto tail = view.subview();
  return tail.sum() - 8;
}
