// Shared projections keep the source owner borrowed until their last use.
struct Pair<lifetime a> {
  int&<a> left;
  int&<a> right;
  Pair(int&<a> left, int&<a> right) : left(left), right(right) {}
  Pair<a> entries() { return Pair<a>(this.left, this.right); }
  int sum() { return this.left + this.right; }
};
struct Owner {
  mut int left = 1;
  mut int right = 2;
  Owner() = default;
  Pair<this> view() { return Pair<this>(this.left, this.right); }
};
int main() {
  mut Owner owner{};
  auto view = owner.view();
  auto iterator = view.entries();
  owner.right = 9;  //~ ERROR GTI-S2017
  return iterator.sum() - 3;
}
