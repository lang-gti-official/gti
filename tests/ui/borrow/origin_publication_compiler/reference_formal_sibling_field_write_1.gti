// Reference formal sibling field write: #394 a sibling-field subscript write in a range-for over a field of a mut reference formal is accepted.
//@ check-pass
import std.vector;
struct State {
  mut {
    std::vector<int> dirty;
    std::vector<int> visited;
  }
  State() : dirty(std::vector<int>()), visited(std::vector<int>()) {}
};
void clear(mut State& st) {
  for (int word : st.dirty) { st.visited[std::size_t(word)] = 0; }
}

int main() {
  mut State st = State();
  st.visited.push_back(5);
  st.dirty.push_back(0);
  clear(st);
  return st.visited[std::size_t(0)];
}
