// Field reborrow: a shared external child does not freeze unrelated owned receiver fields.
//@ check-pass
class Read {
  int& value;
public:
  Read(int& value) : value(value) {}
  int get() { return this.value; }
};
class Write {
  mut int& value;
public:
  Write(mut int& value) : value(value) {}
  Read read() { return Read(this.value); }
  void bump() mut { this.value++; }
};
class Holder {
  mut Write value; mut int count = 0;
public:
  Holder(Write value) : value(std::move(value)) {}
  int get() mut { auto view = this.value.read(); this.count++; return view.get(); }
};
int main() {
  mut int value = 4;
  Write writer{value};
  mut Holder holder{std::move(writer)};
  return holder.get() - 4;
}
