// Field reborrow: a live shared descendant still excludes mutable formal access.
class Read {
  int& value;
public:
  Read(int& value) : value(value) {}
  int get() { return this.value; } Read subview() { return Read(this.value); }
};
class Write {
  mut int& value;
public:
  Write(mut int& value) : value(value) {}
  Read read() { return Read(this.value); }
  void bump() mut { this.value++; }
};
class Holder {
  mut Write value;
public:
  Holder(Write value) : value(std::move(value)) {}
  int get() { auto view = this.value.read(); auto child = view.subview(); return child.get(); }
};
int through_formal(mut Write& input, mut Write& unrelated) { auto view = input.read(); auto child = view.subview(); input.bump(); return child.get(); } int main() {  //~ ERROR GTI-S2017
  mut int value = 4;
  Write writer{value};
  Holder holder{std::move(writer)};
  return holder.get() - 4;
}
