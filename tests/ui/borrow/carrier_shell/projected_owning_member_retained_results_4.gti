// Projected owning member retained results: owning projected receiver preserves a retained borrowed value.
//@ check-pass
import std.string;
class View {
  int& value;
public:
  View(int& source) : value(source) {}
  int read() { return this.value; }
};
struct Leaf {
  mut std::string storage = std::string("owned");
  mut int value = 4;
  int& reference() { return this.value; }
  View view() { return View(this.value); }
public:
  Leaf() = default;
};
struct Record { mut Leaf leaf{};  public: Record() = default; };
class Owner {
  mut Record record{};
public:
  mut Record& get() mut { return this.record; }
  void change() mut { this.record.leaf.value += 1; }
public:
  Owner() = default;
};

int main() { mut Owner owner{}; { View retained = owner.get().leaf.view(); if (retained.read() != 4) { return 1; } } owner.change(); return 0; }
