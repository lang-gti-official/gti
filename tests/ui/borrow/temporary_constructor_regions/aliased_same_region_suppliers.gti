// A local reference retains both valid external constructor suppliers.
class Two<lifetime o> {
  int&<o> x;
  int&<o> y;
public:
  Two(int&<o> x, int&<o> y) : x(x), y(y) {}
  int&<o> pick(bool s) && { if (s) { return this.x; } return this.y; }
};
int&<a> relay<lifetime a>(int&<a> keep, int&<a> other) {
  int& result = Two(keep, other).pick(false);
  return result;
}
int main() { int a = 1; int b = 2; return relay(a, b) - 2; }
