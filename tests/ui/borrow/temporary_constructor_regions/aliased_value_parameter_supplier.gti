// Binding a temporary result to a reference does not discard secondary owners.
class Two<lifetime o> {
  int&<o> x;
  int&<o> y;
public:
  Two(int&<o> x, int&<o> y) : x(x), y(y) {}
  int&<o> pick(bool s) && { if (s) { return this.x; } return this.y; }
};
int&<a> relay<lifetime a>(int&<a> keep, int value) {
  int& result = Two(keep, value).pick(false); //~ ERROR GTI-S2017
  return result;
}
int main() { return 0; }
