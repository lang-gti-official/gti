// Nested calls preserve valid temporary suppliers.
class Two<lifetime o> {
  int&<o> x;
  int&<o> y;
public:
  Two(int&<o> x, int&<o> y) : x(x), y(y) {}
  int&<o> pick(bool s) && { if (s) { return this.x; } return this.y; }
};
int&<a> identity<lifetime a>(int&<a> input) { return input; }
int&<a> relay<lifetime a>(int&<a> keep, int&<a> other) {
  return identity(Two(keep, other).pick(false));
}
int main() { return 0; }
