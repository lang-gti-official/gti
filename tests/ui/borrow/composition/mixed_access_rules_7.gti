// Mixed access rules: a shared first field cannot make an exclusive carrier copyable.
struct Mixed {
  int& read;
  mut int& write;
  mut int& other;
  Mixed(int& a, mut int& b, mut int& c) : read(a), write(b), other(c) {}
  int update() mut { write = read; other = write + 1; return other; }
};
struct MutableFirst {
  mut int& write;
  int& read;
  mut int& other;
  MutableFirst(mut int& a, int& b, mut int& c) : write(a), read(b), other(c) {}
  int update() mut { write = read; other = write + 1; return other; }
};
struct State { mut int a = 1; mut int b = 2; mut int c = 3; State() = default; };
int main() {
  mut int a = 1; mut int b = 2; mut int c = 3;
mut Mixed v{a, b, c}; auto copied = v; return copied.update();  //~ ERROR GTI-S2003 //~ ERROR GTI-S2000
}
