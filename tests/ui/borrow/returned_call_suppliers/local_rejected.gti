// A returned local reference bound to a region call cannot carry a local supplier out of the function.
struct Box {
  mut int value;
  Box(int v) : value(v) {}
};
class Reader<lifetime owner> {
  Box&<owner> direct;
public:
  Reader(Box&<owner> direct) : direct(direct) {}
  int&<owner> pick(bool stored, int&<owner> fallback) && {
    if (stored) { return this.direct.value; }
    return fallback;
  }
};
int&<r> either<lifetime r>(int&<r> first, int&<r> second) { return second; }

int&<a> bound<lifetime a>(int&<a> keep) {
  int local = 42;
  int& kept = either(keep, local);  //~ ERROR GTI-S2127
  return kept;
}
int&<a> realiased<lifetime a>(int&<a> keep) {
  int local = 42;
  int& kept = either(keep, local);  //~ ERROR GTI-S2127
  int& again = kept;
  return again;
}
int&<a> init_statement<lifetime a>(int&<a> keep) {
  int local = 42;
  if (int& kept = either(keep, local); kept > 0) {  //~ ERROR GTI-S2127
    return kept;
  }
  return keep;
}
int&<a> nested<lifetime a>(int&<a> keep) {
  int local = 42;
  int& kept = either(keep, either(keep, local));  //~ ERROR GTI-S2127
  return kept;
}
int&<a> temporary<lifetime a>(Box&<a> mine) {
  int local = 42;
  int& kept = Reader(mine).pick(false, local);  //~ ERROR GTI-S2127
  return kept;
}
int main() { return 0; }
