// Negative: copied nested view keeps its actual resource borrowed.
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

class View<lifetime r> {
  Resource&<r> owner;
public:
  View(Resource&<r> owner) : owner(owner) {}
  Resource&<r> get() { return this.owner; }
};
class Wrapper<lifetime r> {
  View<r> view;
  mut int scratch;
public:
  Wrapper(Resource&<r> owner) : view(View(owner)), scratch(0) {}
  // The copied view carries the stored region, not the wrapper shell.
  View<r> binding() { return this.view; }
  void touch() mut { this.scratch++; }
  int inspect() mut {
    auto copy = this.binding();
    this.touch();
    return copy.get().value;
  }
};

int main() { mut Resource resource{}; Wrapper wrapper{resource};
  auto view = wrapper.binding(); resource.reset(); return view.get().value;  //~ ERROR GTI-S2017
}
