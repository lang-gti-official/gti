// Positive: shared independent guards and whole movement.
//@ check-pass
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

int main() {
  mut Resource owner{};
  { Guard first{owner}; Guard second{owner}; auto moved = std::move(first); }
  owner.reset(); return observed - 14;
}
