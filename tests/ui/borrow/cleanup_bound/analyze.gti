// Analyze: cleanup-bound carrier from a by-reference capture's referent.
//@ check-pass
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

class Station {
  Resource resource;
public:
  Station() {}
  Guard watch() { return Guard(this.resource); }
};
class Depot {
  mut Station station;
public:
  Depot() {}
  mut Station& get() mut { return this.station; }
};

int main() {
  Station station{};
  auto observe = [&station]() -> int {
    auto guard = station.watch();
    return 1;
  };
  return observe() + observe() - 2;
}
