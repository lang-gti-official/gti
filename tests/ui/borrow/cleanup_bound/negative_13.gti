// Negative: last use cannot release cleanup dependency.
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

int main() { mut Resource owner{}; Guard guard{owner}; owner.reset(); return 0; }  //~ ERROR GTI-S2017
