// Negative: cleanup cannot upgrade a shared reference.
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

class Bad {
  Resource& resource;
public:
  Bad(Resource& resource) : resource(resource) {}
  ~Bad() { this.resource.reset(); }  //~ ERROR GTI-S2000
};
int main() { Resource owner{}; Bad guard{owner}; return 0; }
