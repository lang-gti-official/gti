// Negative: copied passive view remains protected through the owning wrapper cleanup.
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

struct PlainView {
  Resource& resource;
  PlainView(Resource& resource) : resource(resource) {}
};
class ViewOwner {
  PlainView view;
public:
  ViewOwner(PlainView view) : view(view) {}
  ~ViewOwner() { observed += this.view.resource.value; }
};

int main() { mut Resource resource{}; PlainView view{resource};
  ViewOwner owner{view}; resource.reset(); return 0;  //~ ERROR GTI-S2017
}
