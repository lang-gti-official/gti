// Negative: arbitrary factory calls do not fabricate constructor summaries.
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

Guard acquire(Resource& resource) { return Guard(resource); }
class Outer {
  Guard guard;
public:
  Outer(Resource& resource) : guard(acquire(resource)) {}  //~ ERROR GTI-S2045
};
int main() { Resource owner{}; Outer bad{owner}; return 0; }  //~ ERROR GTI-S2045
