// Negative: composed local resource cannot escape.
import std.utility;
mut int observed = 0;
struct Resource {
  mut int value = 7;
  void reset() mut { this.value = 9; }
public:
  Resource() = default;
};
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed += this.resource.value; }
};
class Box<T> {
  T item;
public:
  Box(T item) : item(std::move(item)) {}
};

class Outer {
  Guard guard;
public:
  Outer(Resource& resource) : guard(Guard(resource)) {}
};
Outer bad() { Resource local{}; return Outer(local); }  //~ ERROR GTI-S2127
int main() { auto escaped = bad(); return 0; }
