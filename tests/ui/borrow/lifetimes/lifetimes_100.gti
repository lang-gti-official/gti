// Lifetimes: rejected with GTI-S2017.
struct Base {
  mut int left = 1;
  Base() = default;
};
struct Derived : public Base {
  mut int right = 2;
  Derived() = default;
};
int bump(mut int& first, mut int& second) {
  first = first + 1;
  second = second + 1;
  return first + second;
}
int main() { mut Derived pair{}; return bump(pair.left, pair.left) - 5; }  //~ ERROR GTI-S2017
