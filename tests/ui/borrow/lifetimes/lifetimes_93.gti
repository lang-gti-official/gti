// Lifetimes: the program is accepted.
//@ analyze-pass
//@ no-prelude
class View<lifetime a> {
  int&<a> value;
public:
  View(int&<a> input) : value(input) {}
  int&<a> get() { return this.value; }
};
int&<a> use<lifetime a>(int&<a> input) {
  View<a> view{input};
  return view.get();
}
int main() { int value = 7; return use(value) - 7; }
