// A local alias relays a union result only from a parameter in the union's region.
struct Table {
  mut int values[4];
  Table() : values({10, 20, 30, 40}) {}
  bool has(uint64_t key) { return key < uint64_t(4); }
  int& at(uint64_t key) { return this.values[key]; }
};
int&<r> pick<lifetime r>(int&<r> only) { return only; }
class View<lifetime a> {
  Table&<a> table;
public:
  View(Table&<a> table) : table(table) {}
  int&<a> other_region<lifetime b>(int&<b> other) {
    int& local = other;
    return pick(local);  //~ ERROR GTI-S2017
  }
  int&<a> local_storage(int&<a> fallback) {
    int value = 2;
    int& local = value;
    return pick(local);  //~ ERROR GTI-S2017
  }
};

int main() { return 0; }
