// While a stored-region union result lives, both its table and its argument stay borrowed.
struct Table {
  mut int values[4];
  Table() : values({10, 20, 30, 40}) {}
  bool has(uint64_t key) { return key < uint64_t(4); }
  int& at(uint64_t key) { return this.values[key]; }
  mut int& at_mut(uint64_t key) mut { return this.values[key]; }
};
class View<lifetime a> {
  Table&<a> table;
  int owned;
public:
  View(Table&<a> table) : table(table), owned(1) {}
  int&<a> get_or(uint64_t key, int&<a> fallback) {
    if (this.table.has(key)) { return this.table.at(key); }
    return fallback;
  }
  int&<a> take_or(uint64_t key, int&<a> fallback) && {
    if (this.table.has(key)) { return this.table.at(key); }
    return fallback;
  }
};

int fallback_written() {
  Table table{};
  mut int fallback = 7;
  View view = View(table);
  int& result = view.get_or(uint64_t(9), fallback);
  fallback = 8;  //~ ERROR GTI-S2017
  return result;
}
int table_mutated() {
  mut Table table{};
  int fallback = 7;
  View view = View(table);
  int& result = view.get_or(uint64_t(1), fallback);
  table.at_mut(uint64_t(1)) = 0;  //~ ERROR GTI-S2017
  return result;
}
int consumed_fallback_written() {
  Table table{};
  mut int fallback = 7;
  int& result = View(table).take_or(uint64_t(9), fallback);
  fallback = 8;  //~ ERROR GTI-S2017
  return result;
}
int main() { return 0; }
