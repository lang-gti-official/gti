// A reference returned from either of two arguments stays tied to both.
//@ run-pass
class Box {
  mut int32_t value;

public:
  Box(int32_t initial) : value(initial) {}
  mut int32_t& write() mut { return this.value; }
  int32_t& observe() { return this.value; }
  int32_t read() { return this.value; }
  void store(int32_t next) mut { this.value = next; }
};

class Boxes {
public:
  Boxes() = default;
  mut Box left = Box(1);
  mut Box right = Box(2);
};

class Pair {
public:
  Pair() {}
  mut int32_t first = 3;
  mut int32_t second = 4;
};

int32_t& pick(int32_t& candidate) { return candidate; }

int32_t& choose(int32_t& candidate, bool flag) {
  if (flag) { return candidate; }
  return candidate;
}

int main() {
  mut int32_t value = 3;
  if (choose(value, true) != 3 || choose(value, false) != 3) {
    return 1;
  }
  value = 17;
  if (choose(value, true) != 17 || choose(value, false) != 17) {
    return 2;
  }
  return 0;
}
