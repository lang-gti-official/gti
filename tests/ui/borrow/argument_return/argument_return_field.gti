// A reference to an argument field may be returned.
//@ run-pass
class Box {
  mut int32_t value;

public:
  Box(int32_t initial) : value(initial) {}
  mut int32_t& write() mut { return this.value; }
  int32_t& observe() { return this.value; }
  int32_t read() { return this.value; }
  void store(int32_t next) mut { this.value = next; }
};

class Boxes {
public:
  Boxes() = default;
  mut Box left = Box(1);
  mut Box right = Box(2);
};

class Pair {
public:
  Pair() {}
  mut int32_t first = 3;
  mut int32_t second = 4;
};

int32_t& pick(int32_t& candidate) { return candidate; }

int main() {
  mut Pair pair = Pair();
  pair.first = 11;
  {
    int32_t& borrowed = pick(pair.first);
    if (borrowed != 11) {
      return 1;
    }
  }
  pair.first = 23;
  {
    int32_t& borrowed = pick(pair.first);
    if (borrowed != 23) {
      return 2;
    }
  }
  if (pair.second != 4) {
    return 3;
  }
  return 0;
}
