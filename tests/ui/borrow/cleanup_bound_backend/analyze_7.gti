// Analyze: local or owned-parameter cleanup-bound child cannot escape.
import std.utility;
mut int observed = 0;
struct Resource { int value = 7;  public: Resource() = default; };
class Guard {
  Resource& resource;
public:
  Guard(Resource& resource) : resource(resource) {}
  ~Guard() { observed = this.resource.value; }
  Resource& read() { return this.resource; }
};

class View {
  Resource& resource;
public:
  View(Resource& resource) : resource(resource) {}
  Resource& read() { return this.resource; }
};
class GuardRef {
  Guard& guard;
public:
  GuardRef(Guard& guard) : guard(guard) {}
  ~GuardRef() { observed = 1; }
};
Resource& escape(Resource& resource) { Guard guard{resource}; View view{guard.read()}; return view.read(); }  //~ ERROR GTI-S2017
int main() { return 0; }
