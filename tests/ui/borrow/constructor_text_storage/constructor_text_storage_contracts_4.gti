// Constructor text storage contracts: constructor field storage cannot erase a dynamic text owner.
import std.string;
import std.utility;
import std.memory;
struct Label {
  std::string_view text;
  constexpr Label(std::string_view input = "default") : text((input)) {}
};
struct Box<T> {
  T value;
  Box(T input) : value(std::move(input)) {}
};
struct CLabel {
  c_string text;
  CLabel(c_string input) : text(input) {}
};
struct Borrowed {
  std::string_view& text;
  Borrowed(std::string_view& input) : text(input) {}
  std::size_t size() { return this.text.size(); }
};
Label escape() { std::string owner = std::string("abc"); return Label(owner.view()); }  //~ ERROR GTI-S2045
