// Constructor text storage contracts: a conditional cannot erase an operand's dynamic text dependency.
import std.string;
import std.utility;
import std.memory;
struct Label {
  std::string_view text;
  constexpr Label(std::string_view input = "default") : text((input)) {}
};
struct Box<T> {
  T value;
  Box(T input) : value(std::move(input)) {}
};
struct CLabel {
  c_string text;
  CLabel(c_string input) : text(input) {}
};
struct Borrowed {
  std::string_view& text;
  Borrowed(std::string_view& input) : text(input) {}
  std::size_t size() { return this.text.size(); }
};
struct Relay { std::string_view text; Relay(std::string_view input) : text((true ? input : "")) {} };  //~ ERROR GTI-S2051
