// Constructor text storage contracts: a dynamic caller cannot satisfy the ownerless input obligation of pair.
import std.string;
import std.utility;
import std.memory;
struct Label {
  std::string_view text;
  constexpr Label(std::string_view input = "default") : text((input)) {}
};
struct Box<T> {
  T value;
  Box(T input) : value(std::move(input)) {}
};
struct CLabel {
  c_string text;
  CLabel(c_string input) : text(input) {}
};
struct Borrowed {
  std::string_view& text;
  Borrowed(std::string_view& input) : text(input) {}
  std::size_t size() { return this.text.size(); }
};
void pair(std::string_view input) { std::pair<std::string_view, int32_t> saved{input, 1}; } int main() { std::string owner = std::string("abc"); pair(owner.view()); return 0; }  //~ ERROR GTI-S2045
