// Constructor text storage contracts: stored view rejection relates the initializer and offers no unsafe automatic ownership rewrite.
import std.string;
import std.utility;
import std.memory;
struct Label {
  std::string_view text;
  constexpr Label(std::string_view input = "default") : text((input)) {}
};
struct Box<T> {
  T value;
  Box(T input) : value(std::move(input)) {}
};
struct CLabel {
  c_string text;
  CLabel(c_string input) : text(input) {}
};
struct Borrowed {
  std::string_view& text;
  Borrowed(std::string_view& input) : text(input) {}
  std::size_t size() { return this.text.size(); }
};
void caller(std::string_view input) { Label saved{input}; }
int main() { std::string owner = std::string("abc");
  caller(owner.view()); return 0; }  //~ ERROR GTI-S2045
