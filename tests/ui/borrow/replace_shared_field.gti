// Replacing a carrier field makes a subsequent method read the new referent.
//@ run-pass
class ReadView {
  int& item;
public:
  ReadView(int& item) : item(item) {}
  int& read() { return this.item; }
};
struct Pair {
  mut ReadView first;
  Pair(ReadView view) : first(view) {}
};

int main() {
  int a = 1;
  int b = 2;
  mut auto result = Pair(ReadView(a));
  result.first = ReadView(b);
  return result.first.read() - 2;
}
