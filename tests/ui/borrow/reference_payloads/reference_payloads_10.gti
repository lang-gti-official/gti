// Reference payloads: the program is accepted.
//@ check-pass
enum Pair { empty, both(mut int& first, mut int& second) };
int consume(mut Pair input) {
  switch (std::move(input)) {
  case Pair::both(first, second): {
    auto& child = first;
    second = 9;
    return child + second;
  }
  case Pair::empty: return 0;
  }
}
int main() { mut int a = 1; mut int b = 2; return consume(Pair::both(a, b)) - 10; }  //~ WARN GTI-S2096 //~ WARN GTI-S2096
