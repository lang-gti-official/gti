// Reference payloads: whole-value replacement of an enum whose payload is a
// shared-reference class carrier is accepted (RFC 0003 shared borrowed storage).
class carrier {
  int32_t& source;
public:
  carrier(int32_t& value) : source(value) {}
};
enum holder { one(carrier value), none };

int main() {
  int32_t backing = 3;
  carrier value = carrier(backing);
  mut holder first = holder::one(value);
  holder second = holder::one(value);
  first = second;
  return 0;
}
