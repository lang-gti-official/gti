// Reference payloads: rejected with GTI-S2017.
import std.panic;
enum BorrowedCell<T> { empty, value(T& owner) };
class GenericView<T> {
  mut BorrowedCell<T> cell;
public:
  GenericView(T& owner) : cell(BorrowedCell<T>::value(owner)) {}
  T& read() {
    switch (this.cell) {
    case BorrowedCell<T>::value(auto& owner): return owner;
    case BorrowedCell<T>::empty: std::panic("empty");
    }
  }
};
int main() { mut int owner = 1; auto view = GenericView<int>(owner); GenericView<int> copied = view; owner = 2; return copied.read(); }  //~ ERROR GTI-S2017
