// A fallible return preserves the field selected by an accessor.
//@ run-pass
enum class LookupError { missing };

struct Record {
  int first = 11;
  int selected = 37;
  Record() = default;
  int& get() { return this.selected; }
};

expected<int&, LookupError> lookup(Record& record, bool present) {
  if (!present)
    return unexpected(LookupError::missing);
  return record.get();
}

int main() {
  Record record{};
  auto found = lookup(record, true);
  if (!found.has_value() || found.value() != 37)
    return 1;
  auto missing = lookup(record, false);
  if (missing.has_value() || missing.error() != LookupError::missing)
    return 2;
  return 0;
}
