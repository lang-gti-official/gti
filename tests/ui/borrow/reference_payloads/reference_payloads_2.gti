// Reference payloads: the program is accepted.
//@ check-pass
enum Reading { empty, item(mut int& value) };

int inspect(mut Reading input) {
  switch (input) {
case Reading::item(mut auto& value): return value;

  case Reading::empty: return 0;
  }
}
int main() { mut int x = 7; return inspect(Reading::item(x)) - 7; }  //~ WARN GTI-S2096
