// std::unordered_map's subscript requires a default-initializable mapped type.
//@ check-fail
import std.unordered_map;
class NoDefault { public:
  int value; NoDefault(int initial) : value(initial) {}
  NoDefault(NoDefault& other) = delete;
  NoDefault(NoDefault&& other) = default;
};
int main() { mut std::unordered_map<int, NoDefault> values{}; return values[1].value; }  //~ ERROR GTI-S2029 default_initializable<NoDefault>
