// Conversion operators: rejected with GTI-S2068.
class Globals {
public:
  struct Source {
    operator bool() { return Globals::later > 0; }
   public: Source() = default; };
  static bool tested = Source() ? true : false;  //~ ERROR GTI-S2068
  static mut int32_t later = 5;
public:
  Globals() = default;
};
int main() { return Globals::tested ? 1 : 0; }
