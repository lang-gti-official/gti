// Conversion operators: rejected with GTI-S2003.
struct UserId {
  int64_t value;
  UserId(int64_t raw) : value(raw) {}
};
struct RawId {
  int64_t raw;
  RawId(int64_t value) : raw(value) {}
  operator UserId() { return UserId(this.raw); }
  implicit operator int64_t() { return this.raw; }
};
UserId give(RawId raw) { return raw; }  //~ ERROR GTI-S2003
int main() { return 0; }
