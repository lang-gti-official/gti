// A failure inside a parenthesised class construction drops what was built.
//@ run-fail
//@ exit-code: 70
//@ stderr-contains: main.gti:14: runtime error[GTI-R0017]: panic: "grouped construction failed"
//@ stdout: 2
//@ stdout: 1
// --- main.gti
import std.panic;

class Guard {
  int number;
public:
  Guard(int initial) : number(initial) {}
  ~Guard() { std::println(this.number); }
};

class Failing {
  Guard field;
public:
  Failing() : field(Guard(2)) {
    std::panic("grouped construction failed"); // failure-site
  }
  ~Failing() { std::println(99); }
};

int main() {
  Guard earlier = Guard(1);
  Failing never_published = (((Failing())));
  return 0;
}
