// A conditional class expression (first branch) as a consumer that uses it as an operator operand publishes one object.
//@ run-pass
import std.vector;
class Value {
  int number;
public:
  Value(int value) : number(value) {}
  int get() { return this.number; }
  Value twin() { return Value(this.number); }
  Value operator+(Value& other) { return Value(this.number + other.number); }
};
int consume(Value value) { return value.get(); }
Value relay(Value value) { return value; }

int main() {
Value named = Value(5);
mut std::vector<Value> bag{};  //~ WARN GTI-S2096
bool flag = true;
Value zero = Value(0); return ((flag ? Value(3) : Value(7)) + zero).get() == 3 ? 0 : 1;
}
