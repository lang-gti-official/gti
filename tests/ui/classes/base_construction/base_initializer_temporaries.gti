// Base-initializer temporaries end after the base is built and exactly once on any failure.
//@ run-pass
//@ revisions: ok p1 p2 p3
//@[p1] run-fail
//@[p1] args: phase
//@[p1] exit-code: 70
//@[p1] stdout: 1
//@[p1] stdout: 2
//@[p1] stdout: 102
//@[p1] stdout: 101
//@[p1] stderr-contains: main.gti:13: runtime error[GTI-R0002]
//@[p2] run-fail
//@[p2] args: phase phase
//@[p2] exit-code: 70
//@[p2] stdout: 1
//@[p2] stdout: 2
//@[p2] stdout: 30
//@[p2] stdout: 102
//@[p2] stdout: 101
//@[p2] stderr-contains: main.gti:31: runtime error[GTI-R0002]
//@[p3] run-fail
//@[p3] args: phase phase phase
//@[p3] exit-code: 70
//@[p3] stdout: 1
//@[p3] stdout: 2
//@[p3] stdout: 30
//@[p3] stdout: 102
//@[p3] stdout: 101
//@[p3] stdout: 50
//@[p3] stdout: 130
//@[p3] stderr-contains: main.gti:47: runtime error[GTI-R0002]
//@[ok] stdout: 1
//@[ok] stdout: 2
//@[ok] stdout: 30
//@[ok] stdout: 102
//@[ok] stdout: 101
//@[ok] stdout: 50
//@[ok] stdout: 150
//@[ok] stdout: 130
// --- main.gti
import std.string;
import std.vector;

mut int phase = 0;
class Probe {
  int id;
public:
  Probe(int id) : id(id) { std::println(id); }
  ~Probe() { std::println(this.id + 100); }
  int scaled(int factor) {
    if (phase == 1 && this.id == 2) {
      int zero = 0;
      int failed = factor / zero;
    }
    return this.id * factor;
  }
};
struct Plain {
  int value;
  Plain(int value) : value(value) {}
};
int weigh(Probe& probe) { return probe.scaled(10); }
Plain make_plain(int value) { return Plain(value); }
class Foundation {
public:
  int score;
  Foundation(int first, int second, int third) : score(first + second + third) {
    std::println(30);
    if (phase == 2) {
      int zero = 0;
      int failed = score / zero;
    }
  }
  ~Foundation() { std::println(130); }
};
// Each base argument goes through temporaries of the base initializer: a
// method receiver, a reference argument, and field reads of a returned and a
// constructed value. Both probes stay alive until the base is built.
class Building : public Foundation {
public:
  Building(int seed)
      : Foundation(Probe(seed).scaled(3), weigh(Probe(seed + 1)),
                   make_plain(4).value + Plain(5).value) {
    std::println(50);
    if (phase == 3) {
      int zero = 0;
      int failed = phase / zero;
    }
  }
  ~Building() { std::println(150); }
};
int main(int argc, std::vector<std::string> argv) {
  phase = argc - 1;
  Building value = Building(1);
  return value.score - 32;
}
