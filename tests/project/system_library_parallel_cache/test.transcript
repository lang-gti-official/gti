// Unresolved system libraries retain every parallel LLVM object and reuse it across worker counts.
$ gti build --release --codegen-units 4 --codegen-threads 1 --verbose
stderr: gti: cache bypassed
!stderr: reused compiled GTI object
$ cp changed.c answer.c
$ gti run --release --codegen-units 4 --codegen-threads 2 --verbose
? 9
stderr: reused compiled GTI object; relinking
$ python3 check_record.py validate
$ python3 check_record.py trailing
$ gti run --release --codegen-units 4 --codegen-threads 4 --verbose
? 9
stderr: ignored corrupt compiled GTI object
!stderr: reused compiled GTI object
$ cp changed.gti main.gti
$ gti run --release --codegen-units 4 --codegen-threads 1 --verbose
? 10
!stderr: reused compiled GTI object
$ gti run --release --codegen-units 1 --verbose
? 10
!stderr: reused compiled GTI object
