// The same public import supplies early constants and separately linked calls.
import "math.gti";
import std.random;

static_assert(std::abs(-3.5) == 3.5);

int main() {
  if (std::sqrt(9.0) != 3.0 || std::floor(-1.5) != -2.0) { return 1; }
  mut std::random_engine engine{uint64_t(0)};
  if (engine() != uint64_t(0x53175d61490b23df)) { return 4; }
  if (engine() != uint64_t(0x61da6f3dc380d507)) { return 5; }
  if (!std::isnan(std::sqrt(-1.0))) { return 2; }
#ifdef APP_FEATURE
  return 0;
#else
  return 3;
#endif
}
