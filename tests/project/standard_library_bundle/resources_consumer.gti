// Installed test-resource recipes preserve ordinary creation and cleanup without source.
import std.testing.resources;
import std.filesystem;
int main() {
  mut auto directory = std::testing::temporary_directory::create().expect("create temporary directory");
  std::filesystem::path location{directory.path().view()};
  if (!std::filesystem::exists(location).expect("directory exists")) { return 1; }
  directory.remove().expect("remove temporary directory");
  return std::filesystem::exists(location).expect("directory removed") ? 2 : 0;
}
