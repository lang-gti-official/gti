// An inferred library with an unrepresentable public constant retains its complete source API.
$ cd app
$ gti check
$ gti run --verbose
stderr: using source interface for
$ sh -c "test -z \"$(find build -name '*.gtilib' -print)\""
$ cd ../dependency
$ gti build
? 65
stderr: public declaration requires source interface metadata
$ cp ../source-only.toml gti.toml
$ cp ../main-interface.gti src/main.gti
$ cd ../app
$ gti run
$ sh -c "test -z \"$(find build -name '*.gtilib' -print)\""
