// A normal dependency and a same-package library build once and survive an application-only edit.
$ cd app
$ gti run
$ sh -c "test -f build/gti/dev/*/client-lib.gtilib && test -f build/gti/packages/arithmetic/dev/*/arithmetic.gtilib"
$ sh -c "sed 's/answer() == 42/answer() > 41/' src/main.gti > edit && mv edit src/main.gti"
$ gti build --verbose
stderr: gti: cache hit (compiled library source/configuration/dependency fingerprints match)
$ gti run --no-build
$ sh -c "sed 's/return 42/return 0/' ../math/src/detail.gti > edit && mv edit ../math/src/detail.gti"
$ gti run
? 1
