// Linking a system library reuses unchanged GTI code, relinks changed native code and recompiles edited GTI sources.
$ gti build --release --verbose
stderr: gti: cache bypassed
!stderr: reused compiled GTI object
$ cp changed.c answer.c
$ gti run --release --verbose
? 9
stderr: reused compiled GTI object; relinking
$ cp changed.gti main.gti
$ gti run --release --verbose
? 10
!stderr: reused compiled GTI object
$ python3 -c "from pathlib import Path; [p.write_bytes(b'corrupt') for p in Path('build/gti/cache/compile-object-v1').iterdir()]"
$ gti run --release --verbose
? 10
stderr: ignored corrupt compiled GTI object
!stderr: reused compiled GTI object
