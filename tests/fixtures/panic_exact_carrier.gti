#include <std/panic>

namespace sample {
class Reader<T> {
public:
  int read() { return 1; }
public:
  Reader() = default;
};
}

class sample::Reader<int> {
public:
  int read() { return 2; }
public:
  Reader() = default;
};

struct Unrelated { public: Unrelated() = default; };
int invoke<F>(F callback) { return callback(); }

int main() {
  sample::Reader<int> exact{};
  sample::Reader<Unrelated> primary{};
  int selected = exact.read() + primary.read() + invoke([]() -> int { return 3; });
  std::panic("selected {}", selected); // exact-carrier-site
}
