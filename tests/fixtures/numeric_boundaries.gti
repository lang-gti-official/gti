  return true;
}

bool check_int64_t() {
  for (mut int32_t i = 0; i < 256; i++) {
    int64_t a = numeric_input_int64_t(i);
    for (mut int32_t j = 0; j < 256; j++) {
      int64_t b = numeric_input_int64_t(j);
      if (std::midpoint<int64_t>(a, b) != numeric_midpoint_int64_t(a, b)) { return false; }
      if (numeric_gcd_fits_int64_t(a, b) != 0 &&
          std::gcd<int64_t>(a, b) != numeric_gcd_int64_t(a, b)) { return false; }
      if (numeric_lcm_fits_int64_t(a, b) != 0 &&
          std::lcm<int64_t>(a, b) != numeric_lcm_int64_t(a, b)) { return false; }
    }
  }
  return true;
}

bool check_uint64_t() {
  for (mut int32_t i = 0; i < 256; i++) {
    uint64_t a = numeric_input_uint64_t(i);
    for (mut int32_t j = 0; j < 256; j++) {
      uint64_t b = numeric_input_uint64_t(j);
      if (std::midpoint<uint64_t>(a, b) != numeric_midpoint_uint64_t(a, b)) { return false; }
      if (numeric_gcd_fits_uint64_t(a, b) != 0 &&
          std::gcd<uint64_t>(a, b) != numeric_gcd_uint64_t(a, b)) { return false; }
      if (numeric_lcm_fits_uint64_t(a, b) != 0 &&
          std::lcm<uint64_t>(a, b) != numeric_lcm_uint64_t(a, b)) { return false; }
    }
  }
  return true;
}

int main() {
  if (std::MAX_UINT64 != uint64_t(18446744073709551615)) { return 21; }
  if (negative_gcd != 6 || minimum_gcd != 2 || zero_gcd != 0) { return 20; }
  if (!check_int8_t()) { return 1; }
  if (!check_uint8_t()) { return 2; }
  if (!check_int16_t()) { return 3; }
  if (!check_uint16_t()) { return 4; }
  if (!check_int32_t()) { return 5; }
  if (!check_uint32_t()) { return 6; }
  if (!check_int64_t()) { return 7; }
  if (!check_uint64_t()) { return 8; }
  for (mut int32_t i = 0; i < 256; i++) {
    float a = numeric_input_float(i);
    double x = numeric_input_double(i);
    for (mut int32_t j = 0; j < 256; j++) {
      float b = numeric_input_float(j);
      double y = numeric_input_double(j);
      if (numeric_midpoint_float(a, b, std::midpoint<float>(a, b)) == 0) { return 30; }
      if (numeric_midpoint_double(x, y, std::midpoint<double>(x, y)) == 0) { return 31; }
    }
  }
  return 0;
}
