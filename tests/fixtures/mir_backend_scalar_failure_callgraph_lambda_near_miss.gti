int32_t checked_increment(int32_t value) {
  return value + 1;
}

int32_t compatibility_lambda_owner(int32_t value) {
  auto reverse = [](int32_t argument) -> int32_t {
    return checked_increment(argument);
  };
  return value;
}

int main() {
  int32_t result = checked_increment(40);
  if (result != 41) {
    return 1;
  }
  return 0;
}
