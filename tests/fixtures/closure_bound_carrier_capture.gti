#include <std/format>

// A closure that moves in a cleanup-bound carrier is itself one: the
// carrier's destructor reads its reference when the closure is destroyed, so
// the borrow lasts until then, through moves and by-value passing.

class Watcher {
  int32_t& target;
  int32_t id;
public:
  Watcher(int32_t& target, int32_t id) : target(target), id(id) {}
  int32_t read() { return this.target * 10 + this.id; }
  ~Watcher() { std::println("watcher {} saw {}", this.id, this.target); }
};

int32_t consume<F>(F reader) { return reader(); }

int main() {
  mut int32_t base = 4;
  mut int32_t total = 0;
  {
    Watcher watcher = Watcher(base, 1);
    auto reader = [held = std::move(watcher)]() -> int32_t { return held.read(); };
    total += reader();
    std::println("closure still in scope");
  }
  base = 5;
  {
    Watcher watcher = Watcher(base, 2);
    auto reader = [held = std::move(watcher)]() -> int32_t { return held.read(); };
    auto moved = std::move(reader);
    total += moved();
  }
  base = 6;
  {
    Watcher watcher = Watcher(base, 3);
    auto reader = [held = std::move(watcher)]() -> int32_t { return held.read(); };
    total += consume(std::move(reader)) + 1;
    std::println("after consume");
  }
  base = 7;
  std::println("total {}", total);
  return total == 41 + 52 + 64 ? 0 : 1;
}
