import std.memory;

struct checked_cleanup {
  mut int value;
  constexpr checked_cleanup(int value) : value(value) {}
  constexpr operator bool() { return this.value == 7; }
  ~checked_cleanup() {
    if (this.value != 7) {
      int invalid = 1 / (this.value - this.value);
    }
    this.value = 0;
  }
};

constexpr int local_cleanup() {
  checked_cleanup value = checked_cleanup(7);
  if (!value) { return 0; }
  return value.value + 1;
}

static_assert(local_cleanup() == 8);

constexpr int allocate_scalar() {
  auto owner = std::make_unique<int>(7);
  return *owner + 1;
}

constexpr int forward_allocation<Args...>(Args... values) {
  auto owner = std::make_unique<int>(values...);
  return *owner;
}

static_assert(forward_allocation() == 0);
static_assert(forward_allocation(7) == 7);

static_assert(allocate_scalar() == 8);

constexpr int allocate_class() {
  auto owner = std::make_unique<checked_cleanup>(7);
  return owner->value;
}

constexpr int change_owner() {
  mut auto left = std::make_unique<int>(3);
  mut auto right = std::make_unique<int>(5);
  *left += 1;
  left.swap(right);
  int result = *left * 10 + *right;
  right.reset();
  if (right != nullptr) { return 0; }
  left = nullptr;
  return !left ? result : 0;
}

constexpr std::unique_ptr<int> return_owner(int value) {
  auto owner = std::make_unique<int>(value);
  return owner;
}

struct owned_record {
  std::unique_ptr<checked_cleanup> value;
  int id;
  constexpr owned_record(std::unique_ptr<checked_cleanup> value, int id)
      : value(std::move(value)), id(id) {}
  ~owned_record() {
    // The user body runs while its owning fields are still alive. Their
    // canonical recursive cleanup follows the body, exactly once.
    if (this.value->value != 7) { int failure = 1 / (this.id - this.id); }
  }
};

constexpr int nested_owner() {
  auto owner = std::make_unique<owned_record>(
      std::make_unique<checked_cleanup>(7), 4);
  return owner->value->value + owner->id;
}

enum class allocation_error { invalid };
constexpr expected<std::unique_ptr<int>, allocation_error> maybe_owner(bool yes) {
  if (!yes) { return unexpected(allocation_error::invalid); }
  return return_owner(9);
}

constexpr expected<int, allocation_error> compose_owner(bool yes) {
  auto value = ?maybe_owner(yes);
  return *value;
}

constexpr int composed_owner() { return compose_owner(true).value(); }

constexpr int reuse_heap() {
  mut auto first = std::make_unique<int>(1);
  first.reset();
  auto second = std::make_unique<int>(2);
  return *second;
}

constexpr int owner_array() {
  std::unique_ptr<checked_cleanup> values[2] = {
      std::make_unique<checked_cleanup>(7), std::make_unique<checked_cleanup>(7)};
  return values[0]->value + values[1]->value;
}

constexpr expected<int, std::unique_ptr<checked_cleanup>> owning_error() {
  return unexpected(std::make_unique<checked_cleanup>(7));
}

constexpr int observe_error() {
  auto result = owning_error();
  return result.error()->value;
}

constexpr int loop_cleanup() {
  mut int total = 0;
  for (mut int i = 0; i < 4; i++) {
    auto value = std::make_unique<checked_cleanup>(7);
    total += value->value;
    if (i == 0) { continue; }
    break;
  }
  return total;
}

struct pair_value {
  int first;
  int second;
  constexpr pair_value(int first, int second) : first(first), second(second) {}
};

constexpr int packed_pair<Args...>(Args... values) {
  auto value = std::make_unique<pair_value>(values...);
  return value->first + value->second;
}

struct constructed_packet<T> {
  T value;
  constexpr constructed_packet<Args...>(Args... args) : value(T(args...)) {}
};

constexpr constructed_packet<int> empty_pack = constructed_packet<int>();
constexpr constructed_packet<int> single_pack = constructed_packet<int>(9);
static_assert(empty_pack.value == 0 && single_pack.value == 9);

constexpr int early_cleanup(bool early) {
  auto value = std::make_unique<checked_cleanup>(7);
  if (early) { return 2; }
  return value->value;
}

static_assert(allocate_class() == 7);
static_assert(change_owner() == 54);
static_assert(nested_owner() == 11);
static_assert(compose_owner(true).value() == 9);
static_assert(compose_owner(false).error() == allocation_error::invalid);
static_assert(reuse_heap() == 2);
static_assert(owner_array() == 14);
static_assert(observe_error() == 7);
static_assert(loop_cleanup() == 14);
static_assert(packed_pair(4, 5) == 9);
static_assert(early_cleanup(true) == 2 && early_cleanup(false) == 7);

int main() {
  if (local_cleanup() != 8 || allocate_scalar() != 8) { return 1; }
  if (allocate_class() != 7 || change_owner() != 54 || nested_owner() != 11) { return 2; }
  auto success = compose_owner(true);
  auto error = compose_owner(false);
  if (success.value() != 9 || error.error() != allocation_error::invalid) { return 3; }
  if (reuse_heap() != 2 || owner_array() != 14) { return 5; }
  if (observe_error() != 7 || loop_cleanup() != 14 || packed_pair(4, 5) != 9) { return 6; }
  auto runtime_empty = constructed_packet<int>();
  auto runtime_single = constructed_packet<int>(9);
  if (runtime_empty.value != empty_pack.value || runtime_single.value != single_pack.value) { return 7; }
  return early_cleanup(true) == 2 && early_cleanup(false) == 7 ? 0 : 4;
}
