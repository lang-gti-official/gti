#include <std/resource_vector>
#include <std/resource>
#include <std/memory>
#include <std/panic>
#include <std/string>
#include <std/vector>

class Provider {
  std::process_resource process{};
public:
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    unsafe { return this.process.allocate(request); }
  }
  unsafe void release(std::raw_allocation allocation) {
    std::println(900);
    unsafe { this.process.release(allocation); }
  }
  ~Provider() { std::println(901); }
public:
  Provider() = default;
};
class Element {
  int id;
  int divisor;
public:
  Element(int id, int divisor) : id(id), divisor(divisor) {}
  ~Element() {
    std::println(this.id);
    int checked = 1 / this.divisor;
  }
};
void consume(std::resource_vector<Element, Provider> values, bool branch) {
  auto first = std::move(values);
  auto second = std::move(first);
  if (second.size() != std::size_t(2)) { std::panic("bad owner transfer"); }
  if (branch) { auto left = std::move(second); }
  else { auto right = std::move(second); }
}
void exercise(std::resource_ref<Provider> resource, int divisor, bool explicit_release) {
  mut std::resource_vector<Element, Provider> elements{resource};
  elements.emplace_back(1, 1);
  elements.emplace_back(2, divisor);
  if (explicit_release) { elements.release(); }
  else { consume(std::move(elements), divisor == 0); }
}
int main(int argc, std::vector<std::string> argv) {
  Provider provider{};
  unsafe {
    auto resource = std::bind_resource(provider);
    exercise(resource, argc == 2 || argc == 3 ? 0 : 1, argc > 2);
  }
  return 0;
}
