import std.vector;
import std.string;
import std.memory;
import std.meta;

mut int drops = 0;
class Ticket {
  int number;
  std::unique_ptr<int> resource;
public:
  Ticket(int number) : number(number), resource(std::make_unique<int>(number)) {}
  Ticket(Ticket& other) = delete;
  Ticket(Ticket&& other) = default;
  int value() { return *this.resource; }
  ~Ticket() { drops++; }
};

// An unrelated source implements the structural owned-value protocol in GTI.
// It need not be a container or use storage/lifetime intrinsics.
class Countdown {
  mut int next;
public:
  Countdown(int count) : next(count) {}
  bool has_next() { return this.next > 0; }
  Ticket take_next() mut {
    int value = this.next;
    this.next--;
    return Ticket(value);
  }
};

std::vector<Ticket> tickets() {
  mut std::vector<Ticket> values{};
  values.emplace_back(1);
  values.emplace_back(2);
  values.emplace_back(3);
  return std::move(values);
}

int early_return() {
  for (auto ticket : tickets().into_range()) { return ticket.value(); }
  return 0;
}

concept produces<R, T> = std::move_constructible<R> &&
    std::meta::is_borrow_free<R>() &&
    requires(R& source) { { source.has_next() } -> bool; } &&
    requires(mut R& source) { { source.take_next() } -> T; };

int consume<R, T>(R source) requires produces<R, T> &&
    std::move_constructible<T> && std::meta::is_borrow_free<T>() {
  mut int count = 0;
  for (auto item : std::move(source)) { count++; }
  return count;
}

int consume_vector<std::vector_element T>(std::vector<T> source) {
  mut int count = 0;
  for (auto item : std::move(source).into_range()) { count++; }
  return count;
}

int main() {
  {
    auto values = tickets();
    mut int sum = 0;
    for (auto ticket : std::move(values).into_range()) {
      if (ticket.value() == 2) { continue; }
      sum += ticket.value();
    }
    if (sum != 4 || drops != 3) { return 1; }
  }
  {
    for (auto ticket : tickets().into_range()) {
      if (ticket.value() != 1) { return 2; }
      break;
    }
    if (drops != 6) { return 3; }
  }
  if (early_return() != 1 || drops != 9) { return 4; }
  {
    std::vector<Ticket> empty{};
    for (auto ticket : std::move(empty).into_range()) { return 5; }
    if (drops != 9) { return 6; }
  }
  {
    Countdown source{3};
    mut int sum = 0;
    for (auto ticket : std::move(source)) { sum += ticket.value(); }
    if (sum != 6 || drops != 12) { return 7; }
  }
  if (consume<Countdown, Ticket>(Countdown(3)) != 3 || drops != 15) { return 9; }
  if (consume_vector(tickets()) != 3 || drops != 18) { return 10; }
  {
    mut std::vector<std::string> words{};
    words.emplace_back("one");
    words.emplace_back("two");
    mut std::vector<std::string> collected{};
    for (auto word : std::move(words).into_range()) {
      collected.push_back(std::move(word));
    }
    if (collected.size() != 2 || collected[std::size_t(0)].view() != "one" ||
        collected[std::size_t(1)].view() != "two") {
      return 8;
    }
  }
  return 0;
}
