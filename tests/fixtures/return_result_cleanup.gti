import std.string;
import std.vector;
import std.memory;

class Token {
  int identity;
  int divisor;
public:
  Token(int identity, int divisor) : identity(identity), divisor(divisor) {}
  ~Token() {
    std::println(this.identity);
    int checked = 1 / this.divisor;
  }
};

Token produce(int divisor, int cleanup_divisor) {
  int checked = 1 / divisor;
  return Token(1, cleanup_divisor);
}

Token return_call(int divisor, int result_divisor) {
  Token guard{2, divisor};
  return produce(1, result_divisor);
}

Token return_move(int divisor, int result_divisor) {
  Token guard{2, divisor};
  auto result = produce(1, result_divisor);
  return std::move(result);
}

Token return_construct(int divisor, int result_divisor) {
  Token guard{2, divisor};
  return Token(1, result_divisor);
}

expected<Token, int> return_expected(int divisor, int result_divisor) {
  Token guard{2, divisor};
  auto result = produce(1, result_divisor);
  return std::move(result);
}

std::storage<Token> return_storage(int divisor, int result_divisor) {
  Token guard{2, divisor};
  std::allocator allocator{};
  mut auto allocation = allocator.try_storage<Token>(std::size_t(1));
  mut auto result = std::move(allocation).value();
  result.construct(std::size_t(0), Token(1, result_divisor));
  return std::move(result);
}

class Quiet {
public:
  Quiet() {}
  ~Quiet() { std::println(1); }
};

Quiet return_infallible(int divisor) {
  Token guard{2, divisor};
  return Quiet();
}

class CallableOwner<T> {
  T callback;
public:
  CallableOwner(T callback) : callback(std::move(callback)) {}
};

CallableOwner<T> return_callable<T>(T callback, Token guard) {
  return CallableOwner<T>(std::move(callback));
}

int main(int argc, std::vector<std::string> argv) {
  Token caller{9, 1};
  if (argc <= 3) {
    auto result = return_call(argc == 1 ? 1 : 0, argc == 3 ? 0 : 1);
  } else if (argc <= 6) {
    auto result = return_move(argc == 4 ? 1 : 0, argc == 6 ? 0 : 1);
  } else if (argc <= 9) {
    auto result = return_construct(argc == 7 ? 1 : 0, argc == 9 ? 0 : 1);
  } else if (argc <= 12) {
    auto result = return_expected(argc == 10 ? 1 : 0, argc == 12 ? 0 : 1);
  } else if (argc <= 15) {
    auto result = return_storage(argc == 13 ? 1 : 0, argc == 15 ? 0 : 1);
  } else if (argc <= 17) {
    auto result = return_infallible(argc == 16 ? 1 : 0);
  } else {
    Token captured{1, argc == 20 ? 0 : 1};
    auto callback = [captured = std::move(captured)]() -> void {};
    auto result = return_callable(std::move(callback), Token(2, argc == 18 ? 1 : 0));
  }
  return 0;
}
