import std.algorithm;
import std.array;
import std.vector;
import std.numeric;

int exercise<std::integral T>(T smallest, T largest, int count, int shape) {
  mut std::array<T, 8> keys{};
  keys[0] = smallest;
  keys[1] = largest;
  keys[2] = T(0);
  keys[3] = T(1);
  keys[4] = T(2);
  keys[5] = T(3);
  keys[6] = T(smallest + T(1));
  keys[7] = T(largest - T(1));
  mut std::array<int, 8> counts{};
  mut std::vector<T> values{};
  values.reserve(std::size_t(count));
  for (mut int i = 0; i < count; i++) {
    mut int key = (i * 137 + i / 64) % 8;
    if (shape == 1) { key = 0; }
    if (shape == 2) { key = i % 2; }
    if (shape == 3) { key = i < count / 2 ? 6 : 7; }
    T value = keys[std::size_t(key)];
    values.push_back(value);
    for (mut std::size_t k = 0; k < std::size_t(8); k++) {
      if (keys[k] == value) { counts[k]++; break; }
    }
  }
  std::sort(values);
  for (mut std::size_t i = 0; i < values.size(); i++) {
    T value = values[i];
    if (i > std::size_t(0) && value < values[i - std::size_t(1)]) { return 1; }
    mut bool found = false;
    for (mut std::size_t k = 0; k < std::size_t(8); k++) {
      if (keys[k] == value) { counts[k]--; found = true; break; }
    }
    if (!found) { return 2; }
  }
  for (mut std::size_t k = 0; k < std::size_t(8); k++) {
    if (counts[k] != 0) { return 3; }
  }
  return 0;
}

int widths(int count, int shape) {
  if (exercise(int8_t(-128), int8_t(127), count, shape) != 0) { return 11; }
  if (exercise(int16_t(-32768), int16_t(32767), count, shape) != 0) { return 12; }
  if (exercise(int32_t(-2147483647) - int32_t(1), int32_t(2147483647), count, shape) != 0) { return 13; }
  if (exercise(int64_t(-9223372036854775807) - int64_t(1), int64_t(9223372036854775807), count, shape) != 0) { return 14; }
  if (exercise(uint8_t(0), uint8_t(255), count, shape) != 0) { return 15; }
  if (exercise(uint16_t(0), uint16_t(65535), count, shape) != 0) { return 16; }
  if (exercise(uint32_t(0), ~uint32_t(0), count, shape) != 0) { return 17; }
  if (exercise(uint64_t(0), ~uint64_t(0), count, shape) != 0) { return 18; }
  return 0;
}

// An independent insertion-sort oracle checks full-width bit patterns,
// narrow/high-byte distributions, duplicates and deep common prefixes.
int wide_values() {
  for (mut int shape = 0; shape < 5; shape++) {
    mut std::vector<uint64_t> values{};
    mut std::array<uint64_t, 257> reference{};
    mut uint64_t state = uint64_t(17);
    for (mut std::size_t i = 0; i < std::size_t(257); i++) {
      state = std::wrapping_add(std::wrapping_mul(state, uint64_t(6364136223846793005)), uint64_t(1442695040888963407));
      mut uint64_t value = state;
      if (shape == 1) { value &= uint64_t(65535); }
      if (shape == 2) { value = (state & uint64_t(65535)) << uint64_t(48); }
      if (shape == 3) { value = (state & uint64_t(255)) << uint64_t(24); }
      if (shape == 4) { value = i < std::size_t(8) ? uint64_t(1) << (uint64_t(i) * uint64_t(8)) : state & uint64_t(15); }
      values.push_back(value);
      mut std::size_t at = i;
      while (at > std::size_t(0) && value < reference[at - std::size_t(1)]) {
        reference[at] = reference[at - std::size_t(1)];
        at--;
      }
      reference[at] = value;
    }
    std::sort(values);
    for (mut std::size_t i = 0; i < values.size(); i++) {
      if (values[i] != reference[i]) { return 20 + shape; }
    }
  }
  return 0;
}

int main() {
  int wide = wide_values();
  if (wide != 0) { return wide; }
  int sizes[12] = {0, 1, 16, 32, 33, 127, 128, 129, 255, 256, 1024, 8192};
  for (int& count : sizes) {
    for (mut int shape = 0; shape < 4; shape++) {
      int result = widths(count, shape);
      if (result != 0) { return result; }
    }
  }
  return 0;
}
