import std.string;
import std.vector;
class Pattern {
  int marker;
public:
  Pattern(int divisor) : marker(7 / divisor) { std::println("pattern"); } // producer-failure
  ~Pattern() { std::println(this.marker); }
};
class Result {
  std::string_view text;
public:
  Result(std::string_view text) : text(text) {}
  std::string_view view() { return this.text; }
};
int later(int divisor) { return 0 / divisor; } // later-failure
Result match(std::string_view text, Pattern& pattern, int unused, int divisor) {
  std::println("match");
  int checked = 1 / divisor; // body-failure
  return Result(text);
}
int main(int argc, std::vector<std::string> argv) {
  std::string owner{"hello"};
  Result result = match(owner.view(), Pattern(argc == 2 ? 0 : 1),
                        later(argc == 3 ? 0 : 1), argc == 4 ? 0 : 1);
  std::println(result.view());
  return 0;
}
