import std.detail_iterator;

int main() {
  std::size_t maximum = std::size_t(18446744073709551615);
  std::size_t signed_maximum = std::size_t(9223372036854775807);
  std::ptrdiff_t minimum = std::ptrdiff_t(-9223372036854775807) - std::ptrdiff_t(1);
  if (std::detail::checked_iterator_difference(maximum, maximum) != 0) { return 1; }
  if (std::detail::checked_iterator_difference(maximum, maximum - std::size_t(3)) != 3) { return 2; }
  if (std::detail::checked_iterator_difference(maximum - std::size_t(3), maximum) != -3) { return 3; }
  if (std::detail::checked_iterator_difference(signed_maximum, std::size_t(0)) !=
      std::ptrdiff_t(9223372036854775807)) { return 4; }
  if (std::detail::checked_iterator_difference(std::size_t(0), signed_maximum + std::size_t(1)) != minimum) { return 5; }
  if (std::detail::checked_iterator_position(maximum, std::size_t(0), maximum,
      minimum) != signed_maximum) { return 6; }
  if (std::detail::checked_iterator_position(std::size_t(0), std::size_t(0), maximum,
      minimum, true) != signed_maximum + std::size_t(1)) { return 7; }
  if (std::detail::checked_iterator_element(maximum, maximum - std::size_t(3), maximum,
      std::ptrdiff_t(1), true) != maximum - std::size_t(2)) { return 8; }
  // A one-step result may be an endpoint. No signed conversion limits a
  // perfectly representable coordinate in the full unsigned domain.
  if (std::detail::checked_iterator_step<>(std::size_t(0), std::size_t(0), std::size_t(1)) != 1) { return 9; }
  if (std::detail::checked_iterator_step<0, 1>(std::size_t(1), std::size_t(0), std::size_t(1)) != 0) { return 10; }
  if (std::detail::checked_iterator_step<1>(std::size_t(8), std::size_t(5), std::size_t(8)) != 7) { return 11; }
  if (std::detail::checked_iterator_step<1, 1>(std::size_t(5), std::size_t(5), std::size_t(8)) != 6) { return 12; }
  if (std::detail::checked_iterator_step<>(maximum - std::size_t(1), maximum - std::size_t(3), maximum) != maximum) { return 13; }
  if (std::detail::checked_iterator_step<0, 1>(maximum, std::size_t(0), maximum) != maximum - std::size_t(1)) { return 14; }
  if (std::detail::checked_iterator_step<1>(maximum, maximum - std::size_t(3), maximum) != maximum - std::size_t(1)) { return 15; }
  if (std::detail::checked_iterator_step<1, 1>(maximum - std::size_t(1), std::size_t(0), maximum) != maximum) { return 16; }
  if (std::detail::checked_iterator_step<>(std::size_t(5), std::size_t(5), std::size_t(8)) != 6) { return 17; }
  if (std::detail::checked_iterator_step<0, 1>(std::size_t(6), std::size_t(5), std::size_t(8)) != 5) { return 18; }
  // Like the existing cursor policy, every nonzero Reverse value is reverse.
  if (std::detail::checked_iterator_step<42>(std::size_t(8), std::size_t(5), std::size_t(8)) != 7) { return 19; }
  if (std::detail::checked_iterator_step<42, 99>(std::size_t(5), std::size_t(5), std::size_t(8)) != 6) { return 20; }
  return 0;
}
