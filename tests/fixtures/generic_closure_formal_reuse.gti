// A constructor copies its closure parameter into a field and then uses that
// parameter again in a body that can fail: it copies it into a local that it
// moves into a call, or passes it straight to a call beside a call on the
// field. A struct capture gives the closure a lexical drop, a number capture
// a trivial one, and every closure instance of one class shares its native
// constructor template. A closure field after another field, and a struct
// parameter copied into a field and passed on again, take the same route.
// The last call fails inside the constructor body when given an argument.
#include <std/string>
#include <std/utility>
#include <std/vector>

int call<F>(F f) { return f(); }

class Keeper<F> {
public:
  F callback;
  mut int seen;
  Keeper(F f) : callback(f), seen(0) {
    F spare = f;
    this.seen = call(std::move(spare));
  }
  int invoke() { return callback(); }
};

class Passer<F> {
public:
  F callback;
  mut int seen;
  Passer(F f) : callback(f), seen(0) {
    this.seen = call(f) + call(this.callback);
  }
};

class Tagged<F> {
public:
  int tag;
  F callback;
  mut int seen;
  Tagged(F f, int tag) : tag(tag), callback(f), seen(0) {
    F copy = f;
    this.seen = call(copy) + tag;
  }
};

int keep<F>(F f) {
  Keeper<F> value = Keeper<F>(f);
  return value.seen + value.invoke();
}

int pass<F>(F f) {
  Passer<F> value = Passer<F>(f);
  return value.seen;
}

int tagged<F>(F f) {
  Tagged<F> value = Tagged<F>(f, 100);
  return value.seen + value.tag;
}

struct Offset {
  int amount;
  Offset(int amount) : amount(amount) {}
};

int amount(Offset offset) { return offset.amount; }

class Stamp {
public:
  Offset origin;
  int total;
  Stamp(Offset offset) : origin(offset), total(amount(offset)) {}
};

class Scaled {
public:
  Offset origin;
  mut int total;
  Scaled(Offset offset, int factor) : origin(offset), total(0) {
    this.total = amount(offset) * factor;
  }
};

int main(int argc, std::vector<std::string> argv) {
  int k = 3;
  Offset offset{4};
  std::println(keep([offset]() -> int { return offset.amount; }));
  std::println(keep([k]() -> int { return k; }));
  std::println(pass([offset]() -> int { return offset.amount; }));
  std::println(pass([k]() -> int { return k; }));
  std::println(tagged([offset]() -> int { return offset.amount; }));
  std::println(tagged([k]() -> int { return k; }));
  Stamp stamp{offset};
  std::println(stamp.total + stamp.origin.amount);
  Scaled scaled{offset, 10};
  std::println(scaled.total + scaled.origin.amount);
  int divisor = argc == 1 ? 1 : 0;
  std::println(keep([offset, divisor]() -> int { return offset.amount / divisor; }));
  return 0;
}
