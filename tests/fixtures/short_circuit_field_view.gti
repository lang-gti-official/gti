#include <std/string>
#include <std/utility>
#include <std/vector>

// A field of an owning temporary read inside the right operand of && or ||,
// or inside a conditional arm. The temporary exists only when its operand
// runs; its field is read in place, and it is destroyed exactly once at the
// end of the full expression, or by the failure cleanup if a later operand
// fails.
mut int32_t destroyed = 0;

class counted {
public:
  int32_t number;
  counted(int32_t number) : number(number) {}
  ~counted() { destroyed += 1; }
};

// Reports its destruction.
class traced {
public:
  int32_t number;
  traced(int32_t number) : number(number) {}
  ~traced() { std::println(this.number); }
};

struct named_value {
  std::string text;
  named_value(std::string text) : text(std::move(text)) {}
};

// The checked addition can fail.
int32_t bump(int32_t value) { return value + 1; }

counted make_counted(int32_t number) { return counted(number); }

traced make_traced(int32_t number) { return traced(number); }

named_value make_named() { return named_value(std::string("abc")); }

int32_t check(bool yes) {
  bool no = !yes;
  if (!(no || make_counted(5).number == 5)) { return 1; }
  if (destroyed != 1) { return 2; }
  // The right operand does not run, so no temporary exists.
  if (!(yes || make_counted(6).number == 0)) { return 3; }
  if (destroyed != 1) { return 4; }
  if (!(yes && make_counted(7).number == 7)) { return 5; }
  if (destroyed != 2) { return 6; }
  int32_t chosen = yes ? make_counted(8).number : 0;
  if (chosen != 8 || destroyed != 3) { return 7; }
  // A field lent to one call while the temporary is live.
  if (!(no || int32_t(make_named().text.size()) == 3)) { return 8; }
  if (!((no || make_counted(9).number == 9) &&
        (yes || make_counted(10).number == 0))) {
    return 9;
  }
  if (destroyed != 4) { return 10; }
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 3; index++) {
    if (index > 5 || make_counted(index).number == index) { total += 1; }
  }
  if (total != 3 || destroyed != 7) { return 11; }
  if (!(no || make_traced(1).number == 1)) { return 12; }
  return 0;
}

int main(int argc, std::vector<std::string> argv) {
  bool yes = argc > 0;
  if (argc == 2) {
    // The temporary exists when the later operand fails.
    return (!yes || make_traced(7).number + bump(2147483647) == 0) ? 1 : 0;
  }
  if (argc == 3) {
    return (!yes || bump(2147483647) == make_traced(9).number) ? 1 : 0;
  }
  int32_t status = check(yes);
  std::println(destroyed);
  return status;
}
