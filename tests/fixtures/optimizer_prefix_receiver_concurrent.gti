import std.memory;
import std.prefix_query_probe;
import std.atomic;
import std.vector;
import std.string;

class SyncAudit { public: SyncAudit() {} ~SyncAudit() { std::println(99); } };
class SyncValue { public: mut uint64_t value; SyncValue() : value(9) {} };
uint64_t synchronized_read(mut SyncValue& value, bool fail) {
  mut std::detail::prefix_owner<uint64_t> storage{uint64_t(4)};
  std::atomic<uint64_t> signal{uint64_t(0)};
  uint64_t observed = signal.load(std::memory_order_acquire());
  if (observed != uint64_t(0)) { return uint64_t(0); }
  if (fail) { value.value = uint64_t(18446744073709551615); }
  return value.value * uint64_t(2);
}
int repeated_atomic(bool changed) {
  std::atomic<int32_t> signal{int32_t(0)};
  for (mut int32_t iteration = 0; iteration < 2; iteration++) {
    int32_t observed = signal.load(std::memory_order_acquire());
    int32_t checked = observed + int32_t(2147483647);
    if (checked != int32_t(2147483647)) { return 2; }
    signal.store(changed ? int32_t(1) : int32_t(0), std::memory_order_release());
  }
  return 0;
}

int main(int argc, std::vector<std::string> argv) {
  SyncAudit audit{};
  if (argc == 3 || argc == 4) { return repeated_atomic(argc == 4); }
  if (argc == 5 || argc == 6) { return std::detail::repeated_alignment(argc == 6); }
  mut SyncValue value{};
  return synchronized_read(value, argc > 1) == uint64_t(18) ? 0 : 1;
}
