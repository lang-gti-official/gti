#include <std/memory>

struct Entry {
  int number;
  Entry(int number) : number(number) {}
  ~Entry() { std::println(this.number); }
};

int main() {
  mut std::detail::prefix_owner<Entry> entries{uint64_t(4)};
  entries.append(1);
  entries.append(2);
  entries.append(3);
  entries.erase(uint64_t(1));
  if (entries.length() != uint64_t(2) || entries.read(uint64_t(1)).number != 3) { return 1; }
  entries.insert(uint64_t(1), Entry(4));
  entries.swap_elements(uint64_t(0), uint64_t(2));
  mut std::detail::prefix_owner<Entry> replacement{uint64_t(8)};
  entries.relocate_to(replacement);
  if (entries.length() != uint64_t(0) || replacement.length() != uint64_t(3)) { return 2; }
  replacement.pop();
  replacement.clear();
  return 0;
}
