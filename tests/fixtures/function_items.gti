// @coverage-profile: concurrent
import std.algorithm;
import std.functional;
import std.thread;
import std.vector;

namespace tasks {
bool positive(int32_t& value) { return value > 0; }
void observe(int32_t& value) {}
void run() {}
int32_t answer() { return 42; }
}

interface Operation { int32_t run(int32_t value); };
class Increment : public Operation {
public:
  Increment() {}
  int32_t run(int32_t value) override { return value + 1; }
};

namespace operations {
int32_t inspect(Operation& selected, int32_t value) {
  return selected.run(value);
}
int32_t update(mut Operation& selected, int32_t value) {
  return selected.run(value);
}
}

// The function item's exact base-reference parameter receives a derived
// object, as an ordinary direct call to the same function would.
int32_t apply_to_increment<Function>(Function function) {
  Increment concrete{};
  return function(concrete, 40);
}
int32_t apply_to_mutable_increment<Function>(Function function) {
  mut Increment concrete{};
  return function(concrete, 41);
}

int main() {
  mut std::vector<int32_t> values = std::vector<int32_t>({1, 2, 3});
  auto positive_count = std::count_if(values, tasks::positive);
  if (positive_count != 3) {
    return 1;
  }
  [[discard]] std::for_each(values, tasks::observe);
  std::invoke_once(tasks::run);

  auto started = std::thread::start(tasks::run);
  if (!started.has_value()) {
    return 2;
  }
  mut std::thread worker = std::move(started).value();
  auto joined = worker.join();
  if (!joined.has_value()) {
    return 3;
  }

  mut std::thread_result<int32_t> result =
      std::thread_result<int32_t>();
  auto result_started = result.start(tasks::answer);
  if (!result_started.has_value()) {
    return 4;
  }
  auto answer = result.join();
  if (!answer.has_value() || answer.value() != 42) {
    return 5;
  }
  if (apply_to_increment(operations::inspect) != 41 ||
      apply_to_mutable_increment(operations::update) != 42) {
    return 6;
  }
  return 0;
}
