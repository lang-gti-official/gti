struct Resource { int value = 42; };
class View {
  Resource& owner;
public:
  View(Resource& owner) : owner(owner) {}
  Resource& get() { return this.owner; }
};
class Wrapper {
  View view;
  mut int reads = 0;
public:
  Wrapper(View view) : view(view) {}
  int read() mut {
    this.reads++;
    return this.view.get().value;
  }
  int count() { return this.reads; }
  ~Wrapper() {}
};
int main() {
  Resource resource{};
  View view{resource};
  mut Wrapper wrapper{view};
  int value = wrapper.read();
  int count = wrapper.count();
  return value + count - 43;
}
