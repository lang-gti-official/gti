#include <std/resource_vector>
#include <std/resource>
#include <std/memory>
#include <std/string>
#include <std/vector>

// A failing element constructor during growable-container emplacement keeps
// its original failure identity: partial members roll back, the published
// prefix is destroyed exactly once and the region returns to its resource.
class ReportingResource {
  std::process_resource process{};
public:
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    unsafe { return this.process.allocate(request); }
  }
  unsafe void release(std::raw_allocation allocation) {
    std::println(900);
    unsafe { this.process.release(allocation); }
  }
  ~ReportingResource() { std::println(901); }
public:
  ReportingResource() = default;
};
class Part {
  int id;
public:
  Part(int id) : id(id) {}
  ~Part() { std::println(100 + this.id); }
};
class Element {
  Part part;
  std::string text;
  int id;
public:
  Element(int id, int divisor)
      : part(Part(id)), text(std::string("owning")), id(id) {
    int checked = 1 / divisor;
  }
  ~Element() { std::println(this.id); }
};
void exercise(std::resource_ref<ReportingResource> resource, int divisor) {
  mut std::resource_vector<Element, ReportingResource> elements{resource};
  elements.try_reserve(std::size_t(2)).expect("test allocation failed");
  elements.emplace_back(1, 1);
  elements.try_emplace_back(2, divisor).expect("test growth failed");
}
int main(int argc, std::vector<std::string> argv) {
  ReportingResource resource{};
  unsafe {
    auto bound = std::bind_resource(resource);
    exercise(bound, argc > 1 ? 0 : 1);
  }
  return 0;
}
