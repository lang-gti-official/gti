interface Reader { int read(); };
interface Extra { int extra(); };
[[c_abi]] struct Foreign { int data; };

class Solo {
public:
  virtual int read() { return 3; }
  ~Solo() { int observed = this.read(); }
public:
  Solo() = default;
};

class Impl : public Reader, public Extra {
public:
  int read() override { return 4; }
  int extra() override { return 6; }
public:
  Impl() = default;
};

class Leaf : public Reader, public Solo {
  int quotient;
public:
  Leaf(int divisor) : Solo(), quotient(12 / divisor) {}
  int read() override { return 5; }
  ~Leaf() { int observed = this.read(); }
};

class SourceDefault {
public:
  SourceDefault() {}
  virtual int read() { return 7; }
};

class Scheduled {
  int value = 8;
public:
  virtual int read() { return this.value; }
public:
  Scheduled() = default;
};

class Stateful : public Solo { public: Stateful() = default; };

int evaluate(int divisor) {
  Solo first{};
  Impl second{};
  Leaf third{divisor};
  SourceDefault source{};
  Scheduled scheduled{};
  Stateful stateful{};
  return first.read() + second.read() + third.read() - 12;
}

int main() { return evaluate(2); }
