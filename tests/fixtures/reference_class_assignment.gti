#include <std/string>
#include <std/memory>
#include <std/vector>

struct Point {
  mut int32_t value;
  Point(int32_t value) : value(value) {}
};

void fresh(mut Point& target) { target = Point(3); }
void copied(mut Point& target, Point source) { target = source; }
void moved(mut Point& target, Point source) { target = std::move(source); }
Point make_point() { return Point(8); }
void returned(mut Point& target) { target = make_point(); }

void text(mut std::string& target) { target = std::string("new"); }
void moved_text(mut std::string& target, std::string source) {
  target = std::move(source);
}
std::string make_text() { return std::string("returned"); }
void returned_text(mut std::string& target) { target = make_text(); }
void reset_vector(mut std::vector<int32_t>& target) {
  target = std::vector<int32_t>();
}

mut int32_t drops = 0;
mut int32_t sum = 0;
class Tracked {
  int32_t value;
public:
  Tracked(int32_t value) : value(value) {}
  ~Tracked() { drops += 1; sum += this.value; }
  int32_t get() { return this.value; }
};
void replace_tracked(mut Tracked& target) { target = Tracked(7); }

class Owner {
  std::unique_ptr<int32_t> value;
public:
  Owner(int32_t value) : value(std::make_unique<int32_t>(value)) {}
  int32_t get() { return *this.value; }
};
void replace_owner(mut Owner& target) { target = Owner(11); }
Owner make_owner(int32_t value) { return Owner(value); }

// A user-defined writable cursor is not a container/compiler special case.
// Its selected reference return owns permission even when the enclosing
// assignment's contextual value information is read-only.
class OwnerCursor {
  mut Owner& target;
public:
  OwnerCursor(mut Owner& target) : target(target) {}
  mut Owner& operator*() mut { return this.target; }
};
void replace_through_cursor(mut Owner& target) {
  mut OwnerCursor cursor{target};
  *cursor = make_owner(17);
  *cursor = make_owner(19);
}

// A cleanup-free result replaces its referent through the same cursor shape:
// the returned value stages in representation-only storage and the two-phase
// reference activates immediately before the commit.
class PointCursor {
  mut Point& target;
public:
  PointCursor(mut Point& target) : target(target) {}
  mut Point& operator*() mut { return this.target; }
};
Point make_numbered(int32_t value) {
  if (value < 0) { return Point(0); }
  return Point(value);
}
void replace_point_through_cursor(mut Point& target) {
  mut PointCursor cursor{target};
  *cursor = make_numbered(21);
  *cursor = make_numbered(23);
}

int main() {
  mut Point point{1};
  fresh(point);
  if (point.value != 3) return 1;
  copied(point, Point(4));
  if (point.value != 4) return 2;
  moved(point, Point(5));
  if (point.value != 5) return 3;
  returned(point);
  if (point.value != 8) return 4;
  {
    mut Point& alias = point;
    alias = Point(9);
    if (alias.value != 9) return 5;
  }
  if (point.value != 9) return 6;
  replace_point_through_cursor(point);
  if (point.value != 23) return 18;
  mut std::string name{"old"};
  text(name);
  if (name != "new") return 7;
  moved_text(name, std::string("moved"));
  if (name != "moved") return 8;
  returned_text(name);
  if (name != "returned") return 9;
  {
    mut std::string& alias = name;
    alias = std::string("alias");
    if (alias != "alias") return 10;
  }
  mut std::string names[2] = {std::string("first"), std::string("second")};
  {
    mut std::string& element = names[1];
    element = std::string("changed");
    if (element != "changed") return 11;
  }
  if (names[0] != "first" || names[1] != "changed") return 12;
  {
    mut Tracked tracked{2};
    replace_tracked(tracked);
    if (tracked.get() != 7 || drops != 1 || sum != 2) return 13;
  }
  if (drops != 2 || sum != 9) return 14;
  mut Owner owned{10};
  replace_owner(owned);
  if (owned.get() != 11) return 15;
  replace_through_cursor(owned);
  if (owned.get() != 19) return 17;
  mut std::vector<int32_t> values{};
  values.push_back(42);
  reset_vector(values);
  if (!values.empty()) return 16;
  return 0;
}
