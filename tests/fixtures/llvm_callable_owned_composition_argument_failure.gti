import std.memory;
import std.panic;

mut int cleanup_trace = 0;
mut int payload_drops = 0;

class Payload {
public:
  Payload() {}
  ~Payload() {
    payload_drops++;
    cleanup_trace = cleanup_trace * 10 + 7;
  }
};

class Marker {
  int identity;
public:
  Marker(int identity) : identity(identity) {}
  Marker(Marker& other) = delete;
  Marker(Marker&& other) = default;
  ~Marker() { cleanup_trace = cleanup_trace * 10 + this.identity; }
};

class Observe {
public:
  Observe() {}
  ~Observe() {
    if (cleanup_trace != 271 || payload_drops != 1)
      std::panic("owned callable argument rollback drift");
  }
};

int fail_argument() {
  std::panic("owned callable later argument failed");
  return 0;
}

int consume<F>(F callable, int value) {
  return std::move(callable)(value);
}

int main() {
  Observe observe{};
  auto owner = std::make_shared<Payload>();
  Marker first{1};
  Marker second{2};
  return consume(
      [first = std::move(first), owner = std::move(owner),
       second = std::move(second)](int value) -> int { return value; },
      fail_argument());
}
