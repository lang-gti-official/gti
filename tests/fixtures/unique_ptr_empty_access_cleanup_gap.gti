// Completion-campaign reproducer: empty owner access still reaches the
// terminal C++ compatibility helper rather than the MIR cleanup/status path.
// The language's structured failure path must clean the live marker before
// reporting GTI-R0008; a native abort is not completion evidence for that path.
#include <std/memory>

class marker {
public:
  ~marker() { std::println("cleanup"); }
};

int main() {
  marker live = marker();
  std::unique_ptr<int32_t> empty = std::unique_ptr<int32_t>();
  return *empty;
}
