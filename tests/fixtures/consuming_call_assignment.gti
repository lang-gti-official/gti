#include <std/string>
#include <std/vector>

mut int stage = 0;

class Builder {
  mut std::string name;
  int identity;
  int divisor;
public:
  Builder(int identity) : name(std::string("b")), identity(identity),
      divisor(stage == 4 && identity == 10 ? 0 : 1) {
    std::println(identity);
  }
  Builder(Builder& other) = delete;
  Builder(Builder&& other) = default;
  ~Builder() {
    std::println(this.identity);
    int checked = 1 / this.divisor;
  }
  Builder with(std::string_view suffix) && {
    this.name.append(suffix);
    std::println(2);
    int divisor = stage == 2 || stage == 3 ? 0 : 1;
    int checked = 2 / divisor;
    return std::move(this);
  }
  bool ok() { return this.name.view() == "bx"; }
};

class Guard {
public:
  Guard() {}
  ~Guard() { std::println(90); }
};

int main(int argc, std::vector<std::string> argv) {
  stage = argc - 1;
  Guard guard{};
  mut Builder value = Builder(10);
  if (stage == 0 || stage == 2) {
    value = std::move(value).with("x");
  } else {
    value = Builder(20).with("x");
  }
  if (!value.ok()) { return 1; }
  std::println(4);
  return 0;
}
