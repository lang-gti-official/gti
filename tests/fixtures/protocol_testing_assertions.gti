import std.testing;
import std.format;
import std.string;

// This user type has only a protocol implementation, no legacy formatter.
struct Reading {
  int value;
  Reading(int number) : value(number) {}
  bool operator==(Reading& other) { return this.value == other.value; }
  bool operator!=(Reading& other) { return this.value != other.value; }
};
for concept std::formatting<Reading> {
  expected<void, std::format_errc> format(Reading& value, mut std::string& output,
                                         std::format_spec& spec) {
    return std::formatting<int>::format(value.value, output, spec);
  }
};

int main() {
  Reading actual{3};
  Reading same{3};
  std::testing::check_eq!(actual, same);
  Reading different{4};
  std::testing::check_eq!(actual, different, "protocol-only assertion");
  return 0;
}
