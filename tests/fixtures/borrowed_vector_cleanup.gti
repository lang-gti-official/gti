import std.string;
import std.vector;

class Observed {
  int& source;
public:
  Observed(int& input, int divisor) : source(input) {
    int checked = input / divisor;
    if (checked < 0) { std::println(checked); }
  }
  ~Observed() { std::println(this.source); }
};

int main(int argc, std::vector<std::string> argv) {
  int first = 11;
  int second = 22;
  int divisor = argc == 1 ? 1 : 0;
  mut std::vector<Observed> values{};
  values.reserve(1);
  values.push_back(Observed(first, 1));
  values.push_back(Observed(second, divisor));
  values.reserve(16);
  return 0;
}
