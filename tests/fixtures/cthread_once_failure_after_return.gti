#include <std/cthread>
#include <std/thread>
extern "C" { int32_t once_zero(); void once_cleanup(); void once_owner_cleanup(); }
class Guard { public: Guard() {} ~Guard() { once_cleanup(); } };
class Owner { public: Owner() {} ~Owner() { once_owner_cleanup(); } };
std::once_flag flag{};
void initialize() {}
int main() {
  mut std::thread_result<int32_t> task{};
  auto started = task.start([]() -> int32_t {
    unsafe { std::call_once(flag, initialize); }
    Guard guard{};
    return 100 / once_zero();
  });
  if (!started.has_value()) { return 2; }
  Owner owner{};
  auto joined = task.join();
  return 1;
}
