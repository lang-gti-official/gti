// A reference selected from a payload enum that a local value holds. The
// local may come from a call result or a direct construction, may be a field
// of a class value, and may be generic. The carrier's dependency names the
// caller's owner only as provenance: the selected reference is read from the
// payload itself, and a write through it reaches that owner. A loop that
// cannot write the carrier selects from it on every iteration.
enum Slot { item(int& value), empty };

Slot borrow_slot(int& owner, bool present) {
  if (!present) { return Slot::empty; }
  return Slot::item(owner);
}

int read_parameter(int& owner) {
  auto slot = borrow_slot(owner, true);
  switch (slot) {
  case Slot::item(auto& value): return value;
  case Slot::empty: return -1;
  }
}

enum Edit { item(mut int& value), empty };

Edit edit_slot(mut int& owner, bool present) {
  if (!present) { return Edit::empty; }
  return Edit::item(owner);
}

void bump(mut int& owner) {
  mut auto slot = edit_slot(owner, true);
  switch (slot) {
  case Edit::item(mut auto& value): value += 1; return;
  case Edit::empty: return;
  }
}

enum MaybeRef<T> { some(T value), none(int code) };

MaybeRef<int&> find(int& owner, bool present) {
  if (!present) { return MaybeRef<int&>::none(4); }
  return MaybeRef<int&>::some(owner);
}

class Holder {
public:
  Slot slot;
  Holder(int& owner) : slot(Slot::item(owner)) {}
  Holder() : slot(Slot::empty) {}
};

Holder hold(int& owner, bool present) {
  if (!present) { return Holder(); }
  return Holder(owner);
}

enum Pair { both(int& first, int& second), none };

Pair pair_of(int& first, int& second) { return Pair::both(first, second); }

// A loop that cannot write its carrier selects from it on every iteration.
int sum_selected(int& owner, int count) {
  auto slot = borrow_slot(owner, true);
  mut int total = 0;
  for (mut int index = 0; index < count; index += 1) {
    switch (slot) {
    case Slot::item(auto& value): total += value; break;
    case Slot::empty: return -1;
    }
  }
  return total;
}

int sum_parameter(Slot& slot, int count) {
  mut int total = 0;
  mut int index = 0;
  while (index < count) {
    index += 1;
    switch (slot) {
    case Slot::item(auto& value): total += value; break;
    case Slot::empty: continue;
    }
  }
  return total;
}

int main() {
  int local = 19;
  auto called = borrow_slot(local, true);
  switch (called) {
  case Slot::item(auto& value): if (value != 19) { return 1; } break;
  case Slot::empty: return 2;
  }
  auto missing = borrow_slot(local, false);
  switch (missing) {
  case Slot::item(auto& value): return value == 19 ? 3 : 30;
  case Slot::empty: break;
  }
  auto direct = Slot::item(local);
  switch (direct) {
  case Slot::item(auto& value): if (value != 19) { return 4; } break;
  case Slot::empty: return 5;
  }
  if (read_parameter(local) != 19) { return 6; }

  mut int counter = 7;
  bump(counter);
  bump(counter);
  if (counter != 9) { return 7; }
  mut auto edit = edit_slot(counter, true);
  switch (edit) {
  case Edit::item(mut auto& value): value += 10; if (value != 19) { return 8; } break;
  case Edit::empty: return 9;
  }

  auto found = find(local, true);
  switch (found) {
  case MaybeRef<int&>::some(auto& value): if (value != 19) { return 10; } break;
  case MaybeRef<int&>::none: return 11;
  }

  auto holder = hold(local, true);
  switch (holder.slot) {
  case Slot::item(auto& value): if (value != 19) { return 12; } break;
  case Slot::empty: return 13;
  }
  auto vacant = hold(local, false);
  switch (vacant.slot) {
  case Slot::item(auto& value): return value == 19 ? 14 : 40;
  case Slot::empty: break;
  }

  int right = 23;
  auto pair = pair_of(local, right);
  switch (pair) {
  case Pair::both(auto& first, second): if (first + second != 42) { return 15; } break;
  case Pair::none: return 16;
  }

  if (sum_selected(local, 3) != 57) { return 19; }
  if (sum_parameter(called, 2) != 38 || sum_parameter(missing, 2) != 0) {
    return 20;
  }
  // A class field and a generic carrier select inside nested loops.
  mut int nested = 0;
  mut int outer = 0;
  do {
    for (mut int inner = 0; inner < 2; inner += 1) {
      switch (holder.slot) {
      case Slot::item(auto& value): nested += value; break;
      case Slot::empty: return 21;
      }
      switch (found) {
      case MaybeRef<int&>::some(auto& value): nested += value; break;
      case MaybeRef<int&>::none: return 22;
      }
    }
    outer += 1;
  } while (outer < 2);
  if (nested != 152) { return 23; }
  // A second switch selects again from the same carrier.
  switch (called) {
  case Slot::item(auto& again): return again == 19 ? 0 : 17;
  case Slot::empty: return 18;
  }
}
