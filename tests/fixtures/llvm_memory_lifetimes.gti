import std.memory;

mut int trace = 0;
class Ticket {
public:
  int id;
  Ticket(int id) : id(id) { trace = trace * 10 + id; }
  ~Ticket() { trace = trace * 10 + this.id; }
};

// A borrowed constructor input is used only during construction; the object
// stores an owned scalar and remains usable after the input scope ends.
class ReadTicket {
public:
  int id;
  ReadTicket(int& source) : id(source) {}
};

int main() {
  mut std::uninitialized<Ticket> source{};
  mut std::uninitialized<Ticket> destination{};
  unsafe {
    std::construct_at(source.data(), 3);
    std::relocate_at(destination.data(), source.data());
    if (trace != 3) { return 1; }
    if ((*destination.data()).id != 3) { return 2; }
    std::destroy_at(destination.data());
    if (trace != 33) { return 3; }
    std::construct_at(source.data(), 4);
    std::destroy_at(source.data());
  }
  if (trace != 3344) { return 4; }
  mut std::uninitialized<ReadTicket> borrowed_input{};
  unsafe {
    {
      int number = 7;
      std::construct_at(borrowed_input.data(), number);
    }
    if ((*borrowed_input.data()).id != 7) { return 5; }
    std::destroy_at(borrowed_input.data());
  }
  return 0;
}
