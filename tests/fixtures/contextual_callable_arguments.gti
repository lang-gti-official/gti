#include <std/memory>
#include <std/string>
#include <std/vector>

class Invoke {
public:
  ~Invoke() { std::println(9); }
  int operator()(int value) { return value; }
public:
  Invoke() = default;
};

int invoke<Callable>(Callable callback, int first_divisor, int second_divisor) {
  auto sink = [](int value) -> int { return value; };
  Invoke object{};
  int first = sink(callback(first_divisor));
  return first + object(callback(second_divisor));
}

int main(int argc, std::vector<std::string> argv) {
  auto callback = [](int value) -> int {
    std::println(value);
    return 6 / value;
  };
  return invoke(std::move(callback), argc == 2 ? 0 : 3, argc == 3 ? 0 : 2) - 5;
}
