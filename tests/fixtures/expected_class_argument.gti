#include <std/string>
#include <std/utility>
#include <std/vector>

// An Expected<Class, E> call result passed directly to a by-value function or
// constructor parameter. A cleanup-free result has no MIR drop; it is staged in
// representation-only storage between the producer's success and the
// consuming call or construction. A named binding copied into the same
// parameters stages its copy the same way and keeps its own value.
struct pair_value {
  int32_t first = 0;
  int32_t second = 0;
  pair_value(int32_t first, int32_t second) : first(first), second(second) {}
};

// A cleanup-free class error alternative.
struct code_value {
  int32_t code = 0;
  code_value(int32_t code) : code(code) {}
};

// An owning payload keeps MIR's value drop and its transfer slot.
struct named_value {
  std::string text;
  named_value(std::string text) : text(std::move(text)) {}
};

expected<pair_value, int32_t> make_pair(bool ok) {
  if (ok) { return pair_value(5, 7); }
  return unexpected(4);
}

expected<pair_value, code_value> make_coded(bool ok) {
  if (ok) { return pair_value(2, 3); }
  return unexpected(code_value(9));
}

expected<named_value, int32_t> make_named(bool ok) {
  if (ok) { return named_value(std::string("payload")); }
  return unexpected(int32_t(6));
}

int32_t bump(int32_t value) { return value + 1; }

int32_t read_pair(expected<pair_value, int32_t> result) {
  return result ? result.value().first + result.value().second
                : 100 + result.error();
}

int32_t read_between(int32_t before, expected<pair_value, int32_t> result,
                     int32_t after) {
  return result ? before * result.value().first + after
                : before + after - result.error();
}

int32_t read_coded(expected<pair_value, code_value> result) {
  return result ? result.value().first * result.value().second
                : 100 + result.error().code;
}

int32_t read_named(expected<named_value, int32_t> result) {
  return result ? int32_t(result.value().text.size()) : 100 + result.error();
}

class reader {
  int32_t offset;
public:
  reader(int32_t offset) : offset(offset) {}
  int32_t read(expected<pair_value, int32_t> result) {
    return result ? result.value().second + this.offset
                  : this.offset - result.error();
  }
};

// A failure-propagating caller stages the argument in its transformed body.
expected<int32_t, int32_t> relay(bool ok) {
  return read_pair(make_pair(ok));
}

// The same result may initialize an ordinary constructor's by-value parameter.
class pair_holder {
public:
  int32_t total;
  pair_holder(expected<pair_value, int32_t> result)
      : total(result ? result.value().first + result.value().second
                     : 100 + result.error()) {}
  int32_t get() { return this.total; }
};

class between_holder {
public:
  int32_t total;
  between_holder(int32_t before, expected<pair_value, int32_t> result,
                 int32_t after)
      : total(result ? before * result.value().first + after
                     : before + after - result.error()) {}
};

class coded_holder {
public:
  int32_t total;
  coded_holder(expected<pair_value, code_value> result)
      : total(result ? result.value().first * result.value().second
                     : 100 + result.error().code) {}
};

// A constructed owner with a destructor consumes the result the same way.
class tracked_holder {
public:
  int32_t total;
  tracked_holder(expected<pair_value, int32_t> result)
      : total(result ? result.value().first : 100 + result.error()) {}
  ~tracked_holder() {}
};

// An owning payload keeps MIR's value drop and its transfer slot.
class named_holder {
public:
  int32_t size;
  named_holder(expected<named_value, int32_t> result)
      : size(result ? int32_t(result.value().text.size())
                    : 100 + result.error()) {}
};

int32_t read_holder(pair_holder holder) { return holder.total; }

// A by-value parameter is itself a named binding that a call may copy.
int32_t forward_pair(expected<pair_value, int32_t> result) {
  return read_pair(result);
}

// A payload with its own default constructor. Staging a copy never
// default-constructs the payload.
struct defaulted_value {
  int32_t value = 0;
  defaulted_value() : value(9) {}
  defaulted_value(int32_t value) : value(value) {}
};

expected<defaulted_value, int32_t> make_defaulted(bool ok) {
  if (ok) { return defaulted_value(3); }
  return unexpected(5);
}

int32_t read_defaulted(expected<defaulted_value, int32_t> result) {
  return result ? result.value().value : 100 + result.error();
}

int32_t forward_defaulted(expected<defaulted_value, int32_t> result) {
  return read_defaulted(result);
}

// A failure-propagating caller copies one named binding twice.
expected<int32_t, int32_t> relay_copied(bool ok) {
  expected<pair_value, int32_t> made = make_pair(ok);
  return read_pair(made) + read_pair(made);
}

// A constructor body copies its local into another constructor's parameter.
class copying_holder {
public:
  mut int32_t total = 0;
  copying_holder(bool ok) {
    expected<pair_value, int32_t> made = make_pair(ok);
    pair_holder held{made};
    this.total = held.total + read_pair(made);
  }
};

expected<int32_t, int32_t> relay_holder(bool ok) {
  pair_holder holder{make_pair(ok)};
  return holder.total;
}

int main(int argc, std::vector<std::string> argv) {
  bool yes = argc > 0;
  bool no = !yes;
  if (argc == 2) {
    // A later argument fails after the staged result was published.
    return read_between(1, make_pair(yes), bump(2147483647));
  }
  if (argc == 3) {
    // A later constructor argument fails after the staged result was
    // published.
    between_holder failing{1, make_pair(yes), bump(2147483647)};
    return failing.total;
  }
  if (argc == 4) {
    // A later argument fails after the copied binding was staged.
    expected<pair_value, int32_t> staged = make_pair(yes);
    return read_between(1, staged, bump(2147483647));
  }
  if (argc == 5) {
    // A later constructor argument fails after the copied binding was staged.
    expected<pair_value, int32_t> staged = make_pair(yes);
    between_holder failing{1, staged, bump(2147483647)};
    return failing.total;
  }
  if (read_pair(make_pair(yes)) != 12) { return 1; }
  if (read_pair(make_pair(no)) != 104) { return 2; }
  if (read_between(3, make_pair(yes), 4) != 19) { return 3; }
  if (read_between(3, make_pair(no), 4) != 3) { return 4; }
  if (read_coded(make_coded(yes)) != 6) { return 5; }
  if (read_coded(make_coded(no)) != 109) { return 6; }
  if (read_named(make_named(yes)) != 7) { return 7; }
  if (read_named(make_named(no)) != 106) { return 8; }
  reader view{10};
  if (view.read(make_pair(yes)) != 17) { return 9; }
  if (view.read(make_pair(no)) != 6) { return 10; }
  auto relayed = relay(yes);
  if (!relayed || relayed.value() != 12) { return 11; }
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 3; index++) {
    total += read_pair(make_pair(index != 1));
  }
  if (total != 128) { return 12; }
  pair_holder held{make_pair(yes)};
  if (held.total != 12) { return 13; }
  pair_holder held_error{make_pair(no)};
  if (held_error.total != 104) { return 14; }
  between_holder spaced{3, make_pair(yes), 4};
  if (spaced.total != 19) { return 15; }
  between_holder spaced_error{3, make_pair(no), 4};
  if (spaced_error.total != 3) { return 16; }
  coded_holder coded_result{make_coded(yes)};
  if (coded_result.total != 6) { return 17; }
  coded_holder coded_error{make_coded(no)};
  if (coded_error.total != 109) { return 18; }
  tracked_holder tracked{make_pair(yes)};
  if (tracked.total != 5) { return 19; }
  tracked_holder tracked_error{make_pair(no)};
  if (tracked_error.total != 104) { return 20; }
  named_holder named{make_named(yes)};
  if (named.size != 7) { return 21; }
  named_holder named_error{make_named(no)};
  if (named_error.size != 106) { return 22; }
  if (pair_holder(make_pair(yes)).get() != 12) { return 23; }
  if (read_holder(pair_holder(make_pair(no))) != 104) { return 24; }
  auto relayed_holder = relay_holder(no);
  if (!relayed_holder || relayed_holder.value() != 104) { return 25; }
  mut int32_t held_total = 0;
  for (mut int32_t index = 0; index < 3; index++) {
    pair_holder looped{make_pair(index != 1)};
    held_total += looped.total;
  }
  if (held_total != 128) { return 26; }
  // Named bindings copied into the same parameters keep their own values.
  expected<pair_value, int32_t> local = make_pair(yes);
  expected<pair_value, int32_t> local_error = make_pair(no);
  if (read_pair(local) != 12) { return 27; }
  if (read_pair(local_error) != 104) { return 28; }
  if (read_between(3, local, 4) + read_pair(local) != 31) { return 29; }
  if (read_between(3, local_error, 4) != 3) { return 30; }
  expected<pair_value, code_value> local_coded = make_coded(yes);
  expected<pair_value, code_value> local_coded_error = make_coded(no);
  if (read_coded(local_coded) != 6) { return 31; }
  if (read_coded(local_coded_error) != 109) { return 32; }
  if (view.read(local) != 17 || view.read(local_error) != 6) { return 33; }
  if (forward_pair(local) != 12 || forward_pair(local_error) != 104) {
    return 34;
  }
  auto relayed_copy = relay_copied(yes);
  if (!relayed_copy || relayed_copy.value() != 24) { return 35; }
  mut int32_t copied_total = 0;
  for (mut int32_t index = 0; index < 3; index++) {
    expected<pair_value, int32_t> each = make_pair(index != 1);
    copied_total += read_pair(each);
  }
  if (copied_total != 128) { return 36; }
  pair_holder copied_held{local};
  if (copied_held.total != 12) { return 37; }
  between_holder copied_between{3, local_error, 4};
  if (copied_between.total != 3) { return 38; }
  coded_holder copied_coded{local_coded_error};
  if (copied_coded.total != 109) { return 39; }
  tracked_holder copied_tracked{local};
  if (copied_tracked.total != 5) { return 40; }
  if (pair_holder(local_error).get() != 104) { return 41; }
  copying_holder nested{yes};
  if (nested.total != 24) { return 42; }
  if (local.value().first != 5 || local_error.error() != 4) { return 43; }
  if (forward_defaulted(make_defaulted(yes)) != 3 ||
      forward_defaulted(make_defaulted(no)) != 105) {
    return 44;
  }
  return 0;
}
