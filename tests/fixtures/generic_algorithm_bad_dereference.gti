#include <std/algorithm>

class sentinel {
  int32_t final_value;

public:
  sentinel(int32_t value) : final_value(value) {}

  int32_t value() {
    return this.final_value;
  }
};

class iterator {
  mut int32_t current;

public:
  iterator(int32_t initial) : current(initial) {}

  int32_t& operator*() {
    return this.current;
  }

  void operator++() mut {
    this.current++;
  }

  bool operator!=(sentinel& last) {
    return this.current != last.value();
  }
};

int main() {
  uint64_t needle = uint64_t(1);
  std::count(iterator(0), sentinel(2), needle);
  return 0;
}
