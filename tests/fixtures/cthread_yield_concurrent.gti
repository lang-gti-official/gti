#include <std/cthread>
#include <std/atomic>
#include <std/thread>

std::atomic<int32_t> completed{0};

void worker() {
  for (mut int index = 0; index < 16; index++) {
    std::thrd_yield();
    [[discard]] completed.fetch_add(1);
  }
}

int main() {
  mut std::thread_result<int32_t> child = std::thread_result<int32_t>();
  auto started = child.start([]() -> int32_t {
    worker();
    return 7;
  });
  if (!started.has_value()) { return 1; }
  worker();
  auto joined = child.join();
  if (!joined.has_value() || joined.value() != 7) { return 2; }
  // Join and atomic accesses supply ordering. Yield alone supplies none.
  if (completed.load() != 32) { return 3; }
  return 0;
}
