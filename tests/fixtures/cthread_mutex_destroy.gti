import std.cthread;

extern "C" { void cthread_mutex_terminal(); }

int main() {
  cthread_mutex_terminal();
  mut std::mtx_t mutex = 0;
  unsafe {
    if (std::mtx_init(mutex, std::mtx_plain) != std::thrd_success) { return 1; }
    if (std::mtx_lock(mutex) != std::thrd_success) { return 2; }
    std::mtx_destroy(mutex);
  }
  return 3;
}
