#include <std/json>
#include <std/algorithm>
#include <std/paired_span>
#include <std/string>
#include <std/span>

extern "C" {
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
}

class MemberCount {
  mut std::size_t count = 0;
public:
  void operator()(std::paired_span<std::string, std::json::value>::value_type& entry) mut {
    if (!entry.first().empty() && entry.second().is_number()) { this.count++; }
  }
  std::size_t result() { return this.count; }
};

int main() {
  mut auto object = std::json::value::object();
  [[discard]] object.set("first", std::json::value::integer(int64_t(10)));
  [[discard]] object.set("second", std::json::value::integer(int64_t(20)));
  [[discard]] object.set("third", std::json::value::integer(int64_t(30)));
  auto empty = std::json::value::object();
  adoption_count_begin();
  {
    auto keys = object.keys();
    auto values = object.values();
    if (keys.size() != std::size_t(3) || values.size() != keys.size()) { return 1; }
    mut auto cursor = keys.rbegin();
    if (*cursor != "third") { return 2; }
    ++cursor;
    if (*cursor != "second") { return 3; }
    mut std::size_t visited = 0;
    for (auto& key : keys) {
      if (key.empty()) { return 4; }
      visited++;
    }
    for (auto& item : values) {
      if (!item.is_number()) { return 5; }
      visited++;
    }
    if (visited != std::size_t(6)) { return 6; }
  }
  {
    auto members = object.members();
    mut auto last = members.rend_iterator();
    --last;
    if (last->first() != "first" || !last->second().is_number()) { return 7; }
    auto count = std::for_each(members.begin(), members.end(), MemberCount());
    if (count.result() != std::size_t(3)) { return 8; }
    mut std::size_t visited = 0;
    for (auto& entry : object.members()) {
      if (entry.first().empty() || !entry.second().is_number()) { return 9; }
      visited++;
    }
    if (visited != std::size_t(3)) { return 10; }
  }
  {
    mut auto writable = object.values_mut();
    mut auto cursor = writable.rbegin_mut();
    *cursor = std::json::value::boolean(true);
    ++cursor;
    *cursor = std::json::value::boolean(false);
  }
  for (mut auto& item : object.values_mut()) {
    item = std::json::value::boolean(true);
  }
  for (auto& item : object.values()) {
    auto flag = item.as_boolean();
    if (!flag || !flag.value()) { return 11; }
  }
  if (object.key_at(std::size_t(0)) != "first" ||
      object.key_at(std::size_t(1)) != "second" ||
      object.key_at(std::size_t(2)) != "third") { return 12; }
  if (!empty.keys().empty() || !empty.values().empty() || !empty.members().empty()) { return 13; }
  for (auto& entry : empty.members()) { return 14; }
  adoption_count_end();
  if (adoption_allocations() != uint64_t(0)) { return 15; }
  return 0;
}
