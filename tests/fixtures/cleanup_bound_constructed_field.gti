#include <std/string>
#include <std/vector>

struct Resource {
  int id;
  int cleanupDivisor;
  Resource(int id, int cleanupDivisor = 1) : id(id), cleanupDivisor(cleanupDivisor) {}
  ~Resource() { std::println(100 + this.id); }
};
class PairGuard {
  Resource& left;
  Resource& right;
public:
  PairGuard(Resource& left, Resource& right) : left(left), right(right) {}
  ~PairGuard() {
    std::println(this.left.id);
    int cleanup = 1 / this.left.cleanupDivisor;
    std::println(this.right.id);
  }
};
class Reversed {
  PairGuard pair;
public:
  Reversed(Resource& first, Resource& second, int divisor)
      : pair(PairGuard(second, first)) {
    int primary = 1 / divisor;
  }
};
int main(int argc, std::vector<std::string> argv) {
  Resource first{10};
  Resource second{20, argc < 3 ? 1 : 0};
  Reversed owner{first, second, argc == 1 || argc == 4 ? 1 : 0};
  std::println(77);
  return 0;
}
