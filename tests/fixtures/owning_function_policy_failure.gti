import std.functional;
import std.string;
import std.vector;

extern "C" { void gti_test_fail_scalar_allocation(int32_t enabled); }

class Resource {
  int identity;
public:
  Resource(int identity) : identity(identity) {}
  ~Resource() { std::println(this.identity); }
  int read() { return this.identity; }
};

int identity(int value) { return value; }

int main(int argc, std::vector<std::string> argv) {
  Resource caller{9};
  if (argc == 1) {
    std::function<int(int)> callback{};
    return callback(1);
  }
  if (argc == 2) {
    mut std::function<int(int) mut> callback{};
    return callback(1);
  }
  if (argc == 3) {
    std::move_only_function<int(int)> callback{};
    return callback(1);
  }
  if (argc == 4) {
    mut std::move_only_function<int(int) mut> callback{};
    return callback(1);
  }
  if (argc == 5) {
    unsafe { gti_test_fail_scalar_allocation(1); }
    Resource capture{8};
    std::move_only_function<int()> callback{
        [capture = std::move(capture)]() -> int { return capture.read(); }};
    return callback();
  }
  if (argc == 6) {
    // Four retained words exceed the inline slot, so the clone allocates.
    int64_t a = 1;
    int64_t b = 2;
    int64_t c = 3;
    int64_t d = 4;
    std::function<int(int)> callback{
        [a, b, c, d](int value) -> int { return value + int(a + b + c + d); }};
    unsafe { gti_test_fail_scalar_allocation(1); }
    auto copy = callback.clone();
    return copy(1);
  }
  if (argc == 9) {
    std::function<int(int) &&> callback{};
    return std::move(callback)(1);
  }
  if (argc == 10) {
    std::move_only_function<int(int) &&> callback{};
    return std::move(callback)(1);
  }
  if (argc == 11) {
    unsafe { gti_test_fail_scalar_allocation(1); }
    Resource capture{8};
    std::move_only_function<int() &&> callback{
        [capture = std::move(capture)]() -> int { return capture.read(); }};
    return std::move(callback)();
  }
  if (argc == 12) {
    // The once-invoked clone must also exceed the inline slot to allocate.
    int64_t a = 1;
    int64_t b = 2;
    int64_t c = 3;
    int64_t d = 4;
    std::function<int(int) &&> callback{
        [a, b, c, d](int value) -> int { return value + int(a + b + c + d); }};
    unsafe { gti_test_fail_scalar_allocation(1); }
    auto copy = callback.clone();
    return std::move(copy)(1);
  }
  if (argc == 13) {
    // A small target is cloned inline: no allocation can fail.
    std::function<int(int)> callback{identity};
    unsafe { gti_test_fail_scalar_allocation(1); }
    auto copy = callback.clone();
    return copy(41) + 1;
  }
  if (argc == 14) {
    // Replacing with a small target needs no allocation either.
    int offset = 40;
    mut std::move_only_function<int() mut> callback{};
    unsafe { gti_test_fail_scalar_allocation(1); }
    callback.replace([offset]() -> int { return offset + 2; });
    return callback();
  }
  if (argc == 15) {
    // Small once-invoked targets clone inline while allocation is disabled.
    std::function<int(int) &&> callback{identity};
    unsafe { gti_test_fail_scalar_allocation(1); }
    auto copy = callback.clone();
    return std::move(copy)(41) + 1;
  }
  Resource original{7};
  mut std::move_only_function<int()> callback{
      [original = std::move(original)]() -> int { return original.read(); }};
  Resource replacement{8};
  if (argc == 7) {
    unsafe { gti_test_fail_scalar_allocation(1); }
  }
  callback.replace([replacement = std::move(replacement)]() -> int {
    return replacement.read();
  });
  std::println(callback());
  callback.reset();
  return callback.empty() ? 0 : 1;
}
