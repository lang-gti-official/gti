#include <std/atomic>
#include <std/mutex>

std::atomic<int32_t> drops{0};

class Payload {
  int32_t value;
public:
  Payload(int32_t value) : value(value) {}
  Payload(Payload& other) = delete;
  Payload(Payload&& other) = default;
  int32_t read() { return this.value; }
  ~Payload() { drops.store(drops.load() * 10 + this.value); }
};

int main() {
  {
    mut std::mutex<Payload> values[2] = {
      std::mutex<Payload>(Payload(1)), std::mutex<Payload>(Payload(2))
    };
    std::mutex<Payload> moved = std::move(values[0]);
    if (drops.load() != 0) { return 1; }
    std::mutex_guard<Payload> guard = moved.lock();
    if (guard.get().read() != 1) { return 2; }
  }
  return drops.load() == 12 ? 0 : 3;
}
