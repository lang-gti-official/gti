import std.charconv;
import std.format;
import std.string;

class unsupported_format_value { public: unsupported_format_value() = default; };
// A supported formatter may still reject a dynamic value. Unsupported static
// types are checked separately by the constraint-diagnostic tests.
class std::formatter<unsupported_format_value> {
public:
  expected<void, std::format_errc> format(unsupported_format_value& value,
      mut std::string& output, std::format_spec& spec) {
    return unexpected(std::format_errc::unsupported_argument);
  }
public:
  formatter() = default;
};

int main() {
  mut auto empty = std::try_format("plain {{text}}");
  if (!empty || empty.value() != "plain {text}") {
    return 1;
  }
  mut auto formatted = std::try_format("{}:{}", int32_t(-4), uint64_t(9));
  if (!formatted || formatted.value() != "-4:9") {
    return 2;
  }
  mut std::string host = std::string("gitea.example");
  std::string_view method = "api/v1/user";
  mut auto endpoint =
      std::try_format("https://{}/{}", host.view(), method);
  if (!endpoint ||
      endpoint.value() != "https://gitea.example/api/v1/user") {
    return 3;
  }
  mut auto widths = std::try_format("{}|{}|{}|{}|{}|{}|{}|{}", int8_t(-128),
                                uint8_t(255), int16_t(-32768),
                                uint16_t(65535), int32_t(-2147483647 - 1),
                                uint32_t(4294967295),
                                int64_t(-9223372036854775807 - 1),
                                uint64_t(18446744073709551615));
  if (!widths ||
      widths.value() !=
          "-128|255|-32768|65535|-2147483648|4294967295|-9223372036854775808|18446744073709551615") {
    return 11;
  }
  mut std::string bytes = std::string();
  bytes.push_back('A');
  bytes.push_back('\0');
  bytes.push_back('B');
  mut auto counted = std::try_format("<{}>", bytes.view());
  if (!counted || counted.value().size() != std::size_t(5) ||
      counted.value()[std::size_t(0)] != '<' ||
      counted.value()[std::size_t(1)] != 'A' ||
      counted.value()[std::size_t(2)] != '\0' ||
      counted.value()[std::size_t(3)] != 'B' ||
      counted.value()[std::size_t(4)] != '>') {
    return 12;
  }
  mut std::string owned_argument = std::string("owned");
  mut auto heterogeneous =
      std::try_format("{}|{}|{}|{}|{}|{}", true, false, 'X', int32_t(-7),
                  1.25, std::move(owned_argument));
  if (!heterogeneous ||
      heterogeneous.value() != "true|false|X|-7|1.25|owned") {
    return 4;
  }
  mut auto unsupported = std::try_format("{}", unsupported_format_value());
  if (unsupported ||
      unsupported.error() != std::format_errc::unsupported_argument) {
    return 5;
  }
  mut auto binary64 = std::try_format("{}", 1.5d);
  if (!binary64 || binary64.value() != "1.5") {
    return 6;
  }
  mut auto unsupported_print =
      std::try_print("LEAK {}", unsupported_format_value());
  if (unsupported_print ||
      unsupported_print.error() != std::print_errc::unsupported_argument) {
    return 7;
  }
  auto invalid = std::try_format("{");
  if (invalid or invalid.error() != std::format_errc::invalid_format) {
    return 8;
  }
  auto mismatch = std::try_format("{} {}", int32_t(1));
  if (mismatch or
      mismatch.error() != std::format_errc::argument_count_mismatch) {
    return 9;
  }
  auto first = std::try_print("value={} host={}", int32_t(7), host.view());
  auto second = std::try_println(" ok={} enabled={}", uint8_t(1), true);
  auto third = std::try_print("{} {}", 1);
  auto fourth = std::try_println("done");
  if (!first || !second || third or !fourth) {
    return 10;
  }

  mut auto indexed =
      std::try_format("{1:*^7s}|{0:+#010x}|{1:.3s}", uint32_t(42), "abcdef");
  if (!indexed || indexed.value() != "abcdef*|+0x000002a|abc") {
    return 13;
  }
  mut auto numeric = std::try_format("{:08x}|{:#8b}|{:<5d}|{:c}",
                                 uint16_t(42), uint8_t(5), int32_t(-7),
                                 uint8_t(65));
  if (!numeric || numeric.value() != "0000002a|   0b101|-7   |A") {
    return 14;
  }
  mut auto centered = std::try_format("{:^9.4s}|{:>12.6f}", "truncate", 1.25);
  if (!centered || centered.value() != "  trun   |    1.250000") {
    return 15;
  }

  mut std::string destination = std::string("prefix:");
  auto appended = std::try_format_to(destination, " {}", int32_t(7));
  if (!appended || destination != "prefix: 7") {
    return 16;
  }
  auto rejected =
      std::try_format_to(destination, " leak {}", unsupported_format_value());
  if (rejected ||
      rejected.error() != std::format_errc::unsupported_argument ||
      destination != "prefix: 7") {
    return 17;
  }

  auto mixed_indexing = std::try_format("{0} {}", int32_t(1), int32_t(2));
  if (mixed_indexing ||
      mixed_indexing.error() != std::format_errc::invalid_format) {
    return 18;
  }
  auto bad_index = std::try_format("{2}", int32_t(1), int32_t(2));
  if (bad_index ||
      bad_index.error() != std::format_errc::argument_count_mismatch) {
    return 19;
  }
  auto bad_specifier = std::try_format("{:+s}", "text");
  if (bad_specifier ||
      bad_specifier.error() != std::format_errc::invalid_format) {
    return 20;
  }

  mut auto floating =
      std::try_format("{:.2f}|{:.3e}|{:#.5g}|{:G}|{:+010.2f}", 1.25d,
                  12.5d, 12.0d, 12.5d, -3.5d);
  if (!floating ||
      floating.value() != "1.25|1.250e+01|12.000|12.5|-000003.50") {
    return 21;
  }
  mut auto alternate_default =
      std::try_format("{:#}|{:#}|{:#.6g}", 1.5d, 0.0d, 1.5d);
  if (!alternate_default ||
      alternate_default.value() != "1.5|0.|1.50000") {
    return 23;
  }
  mut double infinity = 0.0d;
  mut double not_a_number = 0.0d;
  auto parsed_infinity = std::from_chars("inf", infinity);
  auto parsed_nan = std::from_chars("nan", not_a_number);
  if (parsed_infinity.ec != std::parse_errc::none ||
      parsed_nan.ec != std::parse_errc::none) {
    return 25;
  }
  mut auto special = std::try_format("{:08}|{:08}|{:08}", infinity, -infinity,
                                 not_a_number);
  if (!special || special.value() != "     inf|    -inf|     nan") {
    return 24;
  }
  auto excessive_precision = std::try_format("{:.3000f}", 1.0d);
  if (excessive_precision ||
      excessive_precision.error() != std::format_errc::invalid_format) {
    return 22;
  }
  return 0;
}
