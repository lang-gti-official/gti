import std.algorithm;
import std.panic;
import std.string;
import std.vector;

mut uint64_t comparisons = 0;
mut int comparator_drops = 0;

extern "C" {
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
}

class Ordering {
  std::string label;
  bool descending;
  mut uint64_t calls = uint64_t(0);
public:
  Ordering(bool descending) : label(std::string("owning comparator")), descending(descending) {}
  Ordering(Ordering& other) = delete;
  Ordering(Ordering&& other) = default;
  ~Ordering() {
    if (this.calls != comparisons) { std::panic("comparator state was not retained"); }
    comparator_drops++;
  }
  bool operator()(int& left, int& right) mut {
    this.calls++;
    comparisons++;
    return this.descending ? left > right : left < right;
  }
};

int exercise(int count, int shape, bool descending) {
  mut std::vector<int> values{};
  mut std::vector<int> frequencies{};
  values.reserve(std::size_t(count));
  frequencies.resize(std::size_t(count));
  for (mut int i = 0; i < count; i++) {
    mut int value = i;
    if (shape == 0) { value = count - i - 1; }
    if (shape == 2) { value = 0; }
    if (shape == 3) { value = i <= count / 2 ? i : count - i; }
    if (shape == 4) { value = i % 2 == 0 && i + 1 < count ? i + 1 : i - 1; }
    if (shape == 5) { value = (i * 137 + 43) % count; }
    if (shape == 6) { value = i < count / 2 ? count / 2 : count - i - 1; }
    if (shape == 7 && i == count - 1) { value = 0; }
    if (shape == 8) { value = i / 4; }
    if (shape == 9 && i == count - 2) { value = count - 1; }
    if (shape == 9 && i == count - 1) { value = count - 2; }
    if (shape == 10) { value = (count - i - 1) / 4; }
    values.push_back(value);
    frequencies[std::size_t(value)]++;
  }
  comparisons = uint64_t(0);
  int drops_before = comparator_drops;
  Ordering ordering{descending};
  unsafe { adoption_count_begin(); }
  std::sort(values, std::move(ordering));
  mut uint64_t allocations = uint64_t(0);
  unsafe {
    adoption_count_end();
    allocations = adoption_allocations();
  }
  if (allocations != uint64_t(0)) { return 6; }
  if (comparator_drops != drops_before + 1) { return 1; }
  for (mut std::size_t i = std::size_t(0); i < values.size(); i++) {
    int current = values[i];
    if (current < 0 || current >= count) { return 2; }
    frequencies[std::size_t(current)]--;
    if (i > std::size_t(0)) {
      int previous = values[i - std::size_t(1)];
      if (descending ? previous < current : previous > current) { return 3; }
    }
  }
  for (auto& remaining : frequencies) { if (remaining != 0) { return 4; } }
  // Introsort stays within 2*n*(ceil(log2(n))+1) comparisons on these shapes;
  // algorithm_sort_adversary.gti checks its O(n log n) worst case.
  mut uint64_t levels = uint64_t(0);
  mut std::size_t width = std::size_t(1);
  while (width < values.size()) { width *= std::size_t(2); levels++; }
  if (comparisons > uint64_t(2) * uint64_t(count) * (levels + uint64_t(1))) { return 7; }
  // Whole ascending/reverse/equivalent runs take at most two comparisons
  // per adjacent pair, including equivalent prefixes and plateaus.
  if (count > 16 && (shape <= 2 || shape == 6 || shape == 8 || shape == 10) &&
      comparisons > uint64_t(2) * uint64_t(count - 1)) { return 8; }
  if (shape == 0 && !descending) { std::println(comparisons); }
  return 0;
}

class NumericLess<std::numeric T> {
public:
  NumericLess() {}
  bool operator()(T& left, T& right) { return left < right; }
};

// Compare the infallible builtin insertion path with the general comparator
// path, including empty/one-element owners, duplicates and partition edges.
bool scalar_insertions<std::numeric T>() {
  for (mut int count = 0; count <= 65; count++) {
    for (mut int shape = 0; shape < 4; shape++) {
      mut std::vector<T> values{};
      mut std::vector<T> oracle{};
      for (mut int i = 0; i < count; i++) {
        mut int input = (i * 37 + 13) % 29;
        if (shape == 1) { input = count - i; }
        if (shape == 2) { input = 7; }
        if (shape == 3) { input = (count - i) / 4; }
        values.push_back(T(input));
        oracle.push_back(T(input));
      }
      std::sort(values);
      std::sort(oracle, NumericLess<T>());
      for (mut std::size_t i = 0; i < values.size(); i++) {
        if (values[i] != oracle[i]) { return false; }
        if (i > std::size_t(0) && values[i] < values[i - std::size_t(1)]) {
          return false;
        }
      }
    }
  }
  return true;
}

class UnorderedItem {
  int value;
public:
  UnorderedItem(int value) : value(value) {}
  int key() { return this.value; }
};
class ItemLess {
public:
  ItemLess() {}
  bool operator()(UnorderedItem& left, UnorderedItem& right) {
    return left.key() < right.key();
  }
};

int main() {
  if (!scalar_insertions<int32_t>() || !scalar_insertions<uint64_t>() ||
      !scalar_insertions<double>()) { return 10; }
  mut std::vector<int32_t> extremes = {
    int32_t(2147483647), int32_t(-2147483647) - int32_t(1), int32_t(0),
    int32_t(-1), int32_t(2147483647), int32_t(-2147483647) - int32_t(1)};
  std::sort(extremes);
  int32_t expected[6] = {int32_t(-2147483647) - int32_t(1),
    int32_t(-2147483647) - int32_t(1), int32_t(-1), int32_t(0),
    int32_t(2147483647), int32_t(2147483647)};
  for (mut std::size_t i = std::size_t(0); i < std::size_t(6); i++) {
    if (extremes[i] != expected[i]) { return 11; }
  }
  // Custom-comparator elements need no builtin ordering relation.
  mut std::vector<UnorderedItem> items{};
  items.emplace_back(3); items.emplace_back(1); items.emplace_back(2);
  std::sort(items, ItemLess());
  if (items[std::size_t(0)].key() != 1 || items[std::size_t(1)].key() != 2 ||
      items[std::size_t(2)].key() != 3) {
    return 12;
  }
  for (mut int count = 128; count <= 1024; count *= 2) {
    for (mut int shape = 0; shape < 11; shape++) {
      int result = exercise(count, shape, false);
      if (result != 0) { return result; }
      int reverse = exercise(count, shape, true);
      if (reverse != 0) { return reverse; }
    }
  }
  // Exercise insertion, sampling, block-window and residual boundaries.
  int boundaries[17] = {2, 15, 16, 17, 31, 32, 33, 39, 40, 41,
                       63, 64, 65, 127, 129, 255, 257};
  for (int& count : boundaries) {
    for (mut int shape = 1; shape < 11; shape++) {
      if (exercise(count, shape, false) != 0 ||
          exercise(count, shape, true) != 0) { return 9; }
    }
  }
  if (exercise(0, 1, false) != 0 || exercise(1, 1, false) != 0) { return 5; }
  return 0;
}
