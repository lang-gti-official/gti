#include <std/memory>
extern "C" {
  void opaque_pointer_effect(int* pointer);
  void* malloc(uint64_t bytes);
  void free(void* address);
}

class ZeroSequence {
  mut int* pointer = nullptr;
  mut uint64_t live = 0;
public:
  ZeroSequence(int* pointer) : pointer(pointer) {}
  uint64_t size() { return this.live; }
  unsafe void append_default() mut {
    unsafe { std::construct_at(this.pointer + this.live); }
    this.live += uint64_t(1);
  }
  unsafe int& at(uint64_t index) {
    unsafe { return std::assume_ref(this.pointer + index, this); }
  }
};

unsafe int default_sequence(ZeroSequence& sequence) {
  unsafe {
    int& value = sequence.at(uint64_t(4095));
    return value + 1;
  }
}

unsafe void initialize_zero(int* pointer) {
  unsafe { std::construct_at(pointer); }
}

unsafe int default_scalar(int* pointer) {
  unsafe {
    std::construct_at(pointer);
    return *pointer + 1;
  }
}

unsafe int default_forwarded(int* pointer) {
  unsafe {
    initialize_zero(pointer);
    return *pointer + 1;
  }
}

unsafe uint64_t default_unsigned(uint64_t* pointer) {
  unsafe {
    std::construct_at(pointer);
    return *pointer + uint64_t(1);
  }
}

unsafe int bad_default_explicit(int* pointer) {
  unsafe {
    std::construct_at(pointer, 2147483647);
    return *pointer + 1;
  }
}

unsafe int bad_default_native(int* pointer) {
  unsafe {
    initialize_zero(pointer);
    opaque_pointer_effect(pointer);
    return *pointer + 1;
  }
}

unsafe int bad_default_other(int* pointer, int* other) {
  unsafe {
    std::construct_at(pointer, 2147483647);
    initialize_zero(other);
    return *pointer + 1;
  }
}

unsafe int bad_default_lifetime(int* pointer) {
  unsafe {
    initialize_zero(pointer);
    std::destroy_at(pointer);
    std::construct_at(pointer, 2147483647);
    return *pointer + 1;
  }
}

int main() {
  mut std::uninitialized<int> first{};
  mut std::uninitialized<int> second{};
  mut std::uninitialized<uint64_t> wide{};
  unsafe {
    if (false) return bad_default_explicit(first.data());
    if (false) return bad_default_native(first.data());
    if (false) return bad_default_other(first.data(), second.data());
    if (false) return bad_default_lifetime(first.data());
    int direct = default_scalar(first.data());
    int forwarded = default_forwarded(second.data());
    uint64_t unsigned_value = default_unsigned(wide.data());
    std::destroy_at(wide.data());
    std::destroy_at(second.data());
    std::destroy_at(first.data());
    void* bytes = malloc(uint64_t(16384));
    if (bytes == nullptr) return 1;
    int* pointer = std::typed_address<int>(bytes);
    mut ZeroSequence sequence{pointer};
    while (sequence.size() < uint64_t(4096)) {
      sequence.append_default();
    }
    int last = default_sequence(sequence);
    for (mut uint64_t index = 0; index < uint64_t(4096); index++) {
      std::destroy_at(pointer + index);
    }
    free(bytes);
    return direct == 1 && forwarded == 1 && unsigned_value == uint64_t(1) && last == 1 ? 0 : 1;
  }
}
