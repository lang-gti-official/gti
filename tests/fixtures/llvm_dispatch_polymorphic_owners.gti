#include <std/memory>

// Owners of interface and base views destroy the complete allocated object
// exactly once, whatever static view they hold. Destructors record explicit
// IDs; they do not observe virtual state. The harness derives failure and
// rollback mains from the exact marker below.
mut int events = 0;
mut int expected_cleanup = 0;

void record(int value) { events = events * 10 + value; }

interface Reader { int read(); };
interface Writer { void write(int value) mut; };

class Part {
  int tag;
public:
  Part(int tag) : tag(tag) {}
  ~Part() { record(this.tag); }
};

class Root {
  mut int state = 31;
public:
  Root() { record(1); }
  ~Root() { record(4); }
  virtual int phase() { return 1; }
  virtual int fail(int divisor) { return 12 / divisor; }
  int root_value() { return this.state; }
};

// Reader precedes the state base, so Root and Writer views have nonzero
// offsets from the complete object and from its allocation.
class Leaf : public Reader, public Root, public Writer {
  mut int payload;
  Part part{5};
public:
  Leaf(int payload) : Root(), payload(12 / payload) { record(2); }
  ~Leaf() { record(3); }
  int phase() override { return 2; }
  int read() override { return this.payload; }
  void write(int value) mut override { this.payload = value; }
  int fail(int divisor) override {
    record(6);
    return 120 / divisor;
  }
};

// An unrelated complete class implementing the same interfaces in the
// opposite order, without a state base.
class Pair : public Writer, public Reader {
  mut int value;
public:
  Pair(int value) : value(value) {}
  ~Pair() { record(9); }
  int read() override { return this.value * 2; }
  void write(int value) mut override { this.value = value; }
};

// A stateless implementation uses its generated empty default, which
// installs its dispatch state directly in the allocation.
class Silent : public Writer, public Reader {
public:
  int read() override { return 11; }
  void write(int value) mut override {}
public:
  Silent() = default;
};

class Guard {
public:
  Guard() {}
  ~Guard() {
    // A wrong trace creates a SECOND failure while unwinding. The harness
    // requires only the original division failure and rejects GTI-R0014.
    int checked_cleanup = 1 / (events == expected_cleanup ? 1 : 0);
  }
};

std::unique_ptr<Reader> make_reader(bool leaf) {
  if (leaf) { return std::upcast_unique<Reader, Leaf>(std::make_unique<Leaf>(3)); }
  return std::upcast_unique<Reader, Pair>(std::make_unique<Pair>(8));
}

int consume(std::unique_ptr<Reader> owner) { return owner->read(); }

int invoke_failure(Root& value, int divisor) { return value.fail(divisor); }

// POLYMORPHIC_OWNERS_MAIN
int main() {
  {
    std::unique_ptr<Reader> reader = make_reader(true);
    if (reader->read() != 4 || events != 12) { return 1; }
  }
  // ~Leaf, its Part field, then the Root base: once, through a Reader view.
  if (events != 12354) { return 2; }
  events = 0;
  {
    mut std::unique_ptr<Writer> writer =
        std::upcast_unique<Writer, Leaf>(std::make_unique<Leaf>(4));
    writer->write(23);
    mut std::unique_ptr<Root> root =
        std::upcast_unique<Root, Leaf>(std::make_unique<Leaf>(6));
    if (root->phase() != 2 || root->root_value() != 31) { return 3; }
    root.reset();
    if (events != 1212354) { return 4; }
    root.reset();
    events = 0;
  }
  if (events != 354) { return 5; }
  events = 0;
  {
    std::unique_ptr<Reader> pair = make_reader(false);
    mut std::unique_ptr<Writer> second =
        std::upcast_unique<Writer, Pair>(std::make_unique<Pair>(4));
    second->write(5);
    if (pair->read() != 16) { return 6; }
  }
  if (events != 99) { return 7; }
  events = 0;
  // A by-value owner parameter is destroyed by its callee.
  if (consume(make_reader(false)) != 16 || events != 9) { return 8; }
  events = 0;
  {
    mut std::unique_ptr<Leaf> exact = std::make_unique<Leaf>(12);
    exact->write(8);
    std::unique_ptr<Reader> moved = std::upcast_unique<Reader, Leaf>(std::move(exact));
    if (moved->read() != 8) { return 9; }
  }
  if (events != 12354) { return 10; }
  std::unique_ptr<Reader> silent = std::upcast_unique<Reader, Silent>(std::make_unique<Silent>());
  return silent->read() == 11 ? 0 : 11;
}
