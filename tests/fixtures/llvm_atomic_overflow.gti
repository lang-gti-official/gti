import std.atomic;
import std.panic;

std::atomic<int32_t> value{2147483647};

class Observe {
public:
  ~Observe() {
    if (value.load() != 2147483647) {
      std::panic("atomic overflow published an update");
    }
  }
public:
  Observe() = default;
};

int main() {
  Observe observe{};
  [[discard]] value.fetch_add(1);
  return 1;
}
