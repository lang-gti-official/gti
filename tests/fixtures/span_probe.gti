#include <std/vector>
#include <std/span>

int32_t main() {
  mut std::vector<int32_t> values = std::vector<int32_t>({1, 2, 3});
  std::span<int32_t> view = values.as_span();
  std::span<int32_t> middle = view.subspan(std::size_t(1), std::size_t(2));
  return middle.size() == 2 && middle.front() == 2 && middle.back() == 3 ? 0
                                                                         : 1;
}
