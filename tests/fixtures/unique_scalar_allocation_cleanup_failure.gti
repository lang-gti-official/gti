import std.memory;

extern "C" {
  void gti_test_fail_scalar_allocation(int32_t enabled);
  int32_t gti_test_observe_scalar_allocation(const int32_t* value);
}

class failing_cleanup {
public:
  ~failing_cleanup() {
    std::println("cleanup");
    auto owner = std::make_unique<int32_t>(7);
    unsafe { [[discard]] gti_test_observe_scalar_allocation(&*owner); }
  }
public:
  failing_cleanup() = default;
};

int32_t fail(int32_t divisor) {
  failing_cleanup live = failing_cleanup();
  unsafe { gti_test_fail_scalar_allocation(1); }
  return 1 / divisor;
}

int main() { return fail(0); }
