import std.vector;
import std.functional;

class Container<K, C = std::less<K>> {
  mut std::vector<int> data{};
  C compare;
public:
  Container() requires std::default_initializable<C> : compare(C()) {}
  bool less(K& a, K& b) { return this.compare(a, b); }
};
int main() {
  Container<int> c{};
  int a = 1;
  int b = 2;
  return c.less(a, b) ? 0 : 1;
}
