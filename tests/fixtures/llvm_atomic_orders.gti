#include <std/atomic>

bool pair<S, F>(S success, F failure) {
  std::atomic<int32_t> value{1};
  auto yes = value.compare_exchange_strong(1, 2, success, failure);
  auto no = value.compare_exchange_strong(1, 3, success, failure);
  return yes.exchanged() && yes.observed() == 1 &&
         !no.exchanged() && no.observed() == 2 && value.load() == 2;
}

bool single<Order>(Order order) {
  std::atomic<int32_t> value{1};
  if (value.exchange(2, order) != 1) { return false; }
  auto yes = value.compare_exchange_strong(2, 3, order);
  auto no = value.compare_exchange_strong(2, 4, order);
  return yes.exchanged() && yes.observed() == 2 &&
         !no.exchanged() && no.observed() == 3;
}

int main() {
  std::atomic<int32_t> value{0};
  value.store(1, std::memory_order_relaxed());
  if (value.load(std::memory_order_relaxed()) != 1) { return 1; }
  value.store(2, std::memory_order_release());
  if (value.load(std::memory_order_acquire()) != 2) { return 2; }
  value.store(3, std::memory_order_seq_cst());
  if (value.load(std::memory_order_seq_cst()) != 3) { return 3; }
  if (!single(std::memory_order_relaxed()) ||
      !single(std::memory_order_acquire()) ||
      !single(std::memory_order_release()) ||
      !single(std::memory_order_acq_rel()) ||
      !single(std::memory_order_seq_cst())) { return 4; }
  if (!pair(std::memory_order_relaxed(), std::memory_order_relaxed()) ||
      !pair(std::memory_order_acquire(), std::memory_order_relaxed()) ||
      !pair(std::memory_order_acquire(), std::memory_order_acquire()) ||
      !pair(std::memory_order_release(), std::memory_order_relaxed()) ||
      !pair(std::memory_order_acq_rel(), std::memory_order_relaxed()) ||
      !pair(std::memory_order_acq_rel(), std::memory_order_acquire()) ||
      !pair(std::memory_order_seq_cst(), std::memory_order_relaxed()) ||
      !pair(std::memory_order_seq_cst(), std::memory_order_acquire()) ||
      !pair(std::memory_order_seq_cst(), std::memory_order_seq_cst())) { return 5; }
  return 0;
}
