#include <std/string>
#include <std/vector>

class Resource {
public:
  int divisor;
  Resource(int divisor) : divisor(divisor) {}
  ~Resource() { std::println(99); }
};
class Trace {
  int id;
public:
  Trace(int id) : id(id) {}
  ~Trace() { std::println(this.id); }
};
class Guard {
  Resource& resource;
  Trace trace;
public:
  Guard(Resource& resource) : resource(resource), trace(Trace(55)) {}
  ~Guard() {
    std::println(41);
    int cleanup = 7 / this.resource.divisor;
  }
};
class Box<T> {
  T item;
public:
  Box(T item, int divisor) : item(std::move(item)) {
    int primary = 1 / divisor;
  }
};
int main(int argc, std::vector<std::string> argv) {
  Resource resource{argc > 2 ? 0 : 1};
  Box<Guard> box{Guard(resource), argc == 2 or argc == 3 ? 0 : 1};
  return 0;
}
