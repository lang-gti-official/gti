#include <std/functional>
#include <std/memory>
#include <std/string>

class Increment {
public:
  int operator()(int value) && { return value + 1; }
};

int add(int left, int right) { return left + right; }

int main() {
  std::function<int(int) &&> calculate{Increment()};
  auto copy = calculate.clone();
  if (std::move(calculate)(3) != 4) { return 1; }
  if (std::move(copy)(4) != 5) { return 2; }
  std::function<int(int, int) &&> item{add};
  if (std::move(item)(2, 3) != 5) { return 3; }
  auto resource = std::make_unique<int>(7);
  std::move_only_function<int() &&> capture{
      [value = std::move(resource)]() -> int { return *value; }};
  if (std::move(capture)() != 7) { return 4; }
  std::move_only_function<void() &&> action{[]() -> void { std::println(9); }};
  std::move(action)();
  return 0;
}
