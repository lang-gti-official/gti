#include <std/memory>

struct Prefix { Prefix() = default; ~Prefix() { std::println(7); } };
struct Payload {
  Prefix prefix{};
  Payload(int divisor) {
    std::println(1);
    std::println(12 / divisor);
  }
  ~Payload() { std::println(8); }
};
struct Caller { Caller() = default; ~Caller() { std::println(99); } };
int main() {
  Caller caller{};
  auto owner = std::make_shared<Payload>(0);
  return 0;
}
