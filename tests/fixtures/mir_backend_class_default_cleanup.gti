mut int32_t cleanup_trace = 0;

class Early {
public:
  ~Early() {
    cleanup_trace = 1;
  }
public:
  Early() = default;
};

class Late {
public:
  ~Late() {
    cleanup_trace = 2;
  }
public:
  Late() = default;
};

int32_t selected_default_cleanup() {
  Early early{};
  Late late{};
  return cleanup_trace;
}

class ExplicitDefault {
public:
  ExplicitDefault() {}
  ~ExplicitDefault() {}
};

uint32_t compatibility_declared_constructor() {
  ExplicitDefault value{};
  return 0;
}

class FieldOwner {
  uint32_t value = 3;

public:
  ~FieldOwner() {}
public:
  FieldOwner() = default;
};

uint32_t compatibility_field_owner() {
  FieldOwner value{};
  return 0;
}

void compatibility_nested_scope() {
  {
    Early value{};
  }
}

uint32_t compatibility_branch(bool choose) {
  if (choose) {
    Late value{};
  }
  return 0;
}

class CheckedCleanup {
public:
  ~CheckedCleanup() {
    cleanup_trace += 1;
  }
public:
  CheckedCleanup() = default;
};

void compatibility_checked_cleanup() {
  CheckedCleanup value{};
}

int main() {
  int32_t first = selected_default_cleanup();
  if (first != 0 or cleanup_trace != 1) {
    return 1;
  }

  int32_t second = selected_default_cleanup();
  if (second != 1 or cleanup_trace != 1) {
    return 2;
  }
  // These bodies are part of the lifecycle emission/runtime contract, so
  // exercise them rather than relying on emission of unreachable functions.
  if (compatibility_declared_constructor() != 0 or
      compatibility_field_owner() != 0) {
    return 3;
  }
  compatibility_nested_scope();
  if (cleanup_trace != 1 or compatibility_branch(true) != 0 or
      cleanup_trace != 2) {
    return 4;
  }
  compatibility_checked_cleanup();
  if (cleanup_trace != 3) {
    return 5;
  }
  return 0;
}
