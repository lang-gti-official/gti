import std.panic;

using Failure = () -> void;

class TargetGuard {
public:
  ~TargetGuard() { std::println("target cleanup"); }
public:
  TargetGuard() = default;
};
class CallerGuard {
public:
  ~CallerGuard() { std::println("caller cleanup"); }
public:
  CallerGuard() = default;
};
void fail_inside_callback() {
  TargetGuard guard{};
  std::panic("native callback failure");
}
int main() {
  CallerGuard guard{};
  Failure callback = fail_inside_callback;
  unsafe { callback(); }
  return 0;
}
