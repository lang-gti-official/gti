import std.algorithm;
import std.array;
import std.panic;
import std.string;
import std.vector;

constexpr std::array<int, 3> constant_values = std::array<int, 3>({4, 5, 6});
static_assert(constant_values.size() == 3);

class Resource {
  int identity;
  std::string label;
public:
  Resource(int id) : identity(id), label(std::string("resource")) {}
  Resource(Resource& other) = delete;
  Resource clone() { std::panic("sorting must never clone"); }
  int id() { return this.identity; }
};

class Compare {
  mut int comparisons = 0;
  int limit;
public:
  Compare(int limit) : limit(limit) {}
  bool operator()(Resource& left, Resource& right) mut {
    this.comparisons++;
    if (this.comparisons > this.limit) { std::panic("comparison budget exceeded"); }
    return left.id() < right.id();
  }
};

class QuietResource {
  int identity;
public:
  QuietResource(int id) : identity(id) {}
  QuietResource(QuietResource& other) = delete;
  ~QuietResource() {}
  int id() { return this.identity; }
};

// Exact calls for 24 values with three equal values at each level. This
// observes discovery's equivalent prefix, then every fixed-direction pair.
class MonotonicTrace {
  int direction;
  mut int calls = 0;
public:
  MonotonicTrace(int direction) : direction(direction) {}
  bool operator()(int& left, int& right) mut {
    mut int expected_left = this.direction < 0 ? 7 : 0;
    mut int expected_right = expected_left;
    if (this.direction != 0 && this.calls >= 4) {
      if (this.calls == 4) {
        expected_left = this.direction < 0 ? 6 : 1;
      } else if (this.direction > 0 && this.calls == 5) {
        expected_right = 1;
      } else {
        int index = this.calls - (this.direction > 0 ? 2 : 1);
        expected_left = this.direction > 0 ? index / 3 : 7 - (index - 1) / 3;
        expected_right = this.direction > 0 ? (index - 1) / 3 : 7 - index / 3;
      }
    }
    if (left != expected_left || right != expected_right) {
      std::panic("monotonic comparison order changed");
    }
    this.calls++;
    return left < right;
  }
  ~MonotonicTrace() {
    int expected = this.direction > 0 ? 26 : this.direction < 0 ? 25 : 46;
    if (this.calls != expected) { std::panic("monotonic comparison count changed"); }
  }
};

mut int block_drops[257] = {};
class BlockResource {
  int identity;
public:
  BlockResource(int identity) : identity(identity) {}
  BlockResource(BlockResource& other) = delete;
  BlockResource clone() { std::panic("block sort must not clone"); }
  int id() { return this.identity; }
  ~BlockResource() { block_drops[std::size_t(this.identity)]++; }
};
class BlockAudit {
public:
  BlockAudit() {}
  ~BlockAudit() {
    for (mut int index = 0; index < 257; index++) {
      if (block_drops[std::size_t(index)] != 1) { std::panic("block permutation lost"); }
    }
    std::println("block permutation preserved");
  }
};
class BlockCompare {
  int fail_at;
  mut int calls = 0;
public:
  BlockCompare(int fail_at) : fail_at(fail_at) {}
  bool operator()(BlockResource& left, BlockResource& right) mut {
    this.calls++;
    if (this.calls == this.fail_at) { std::panic("block comparison failed"); }
    return left.id() < right.id();
  }
};

int main(int argc, std::vector<std::string> argv) {
  if (argc > 1) {
    BlockAudit audit{};
    mut std::vector<BlockResource> blocks{};
    for (mut int index = 0; index < 257; index++) {
      blocks.push_back(BlockResource((index * 37) % 257));
    }
    // Fail during window filling, after previous paired swaps, or in a later
    // partition. Destruction proves each original resource survived exactly once.
    int fail_at = argc == 2 ? 25 : argc == 3 ? 100 : argc == 4 ? 200 : 0;
    std::sort(blocks, BlockCompare(fail_at));
    for (mut int index = 0; index < 257; index++) {
      if (blocks[std::size_t(index)].id() != index) { return 22; }
    }
    return 0;
  }
  for (mut int direction = -1; direction <= 1; direction++) {
    mut std::vector<int> monotonic{};
    for (mut int index = 0; index < 24; index++) {
      monotonic.push_back(direction < 0 ? 7 - index / 3 : direction > 0 ? index / 3 : 0);
    }
    std::sort(monotonic, MonotonicTrace(direction));
    for (mut int index = 0; index < 24; index++) {
      if (monotonic[std::size_t(index)] != (direction == 0 ? 0 : index / 3)) { return 21; }
    }
  }
  mut std::array<int, 0> empty_array{};
  mut std::array<int, 0> other_empty_array{};
  empty_array.swap(other_empty_array);
  if (!empty_array.empty() || !other_empty_array.empty()) { return 20; }
  mut std::array<QuietResource, 2> quiet = std::array<QuietResource, 2>({QuietResource(1), QuietResource(2)});
  quiet.swap_elements(std::size_t(0), std::size_t(1));
  if (quiet[0].id() != 2 || quiet[1].id() != 1) { return 5; }
  mut std::vector<Resource> resources{};
  std::sort(resources, Compare(0));
  std::reverse(resources);
  resources.push_back(Resource(0));
  std::sort(resources, Compare(0));
  std::reverse(resources);
  // 37 is coprime to 97: all 97 distinct identities occur exactly once.
  for (mut int index = 1; index < 97; index++) {
    resources.push_back(Resource((index * 37) % 97));
  }
  // A conservative 2*n*ceil(log2(n)) upper bound for these inputs.
  std::sort(resources, Compare(1358));
  for (mut int index = 0; index < 97; index++) {
    if (resources[std::size_t(index)].id() != index) { return 1; }
  }
  std::reverse(resources);
  for (mut int index = 0; index < 97; index++) {
    if (resources[std::size_t(index)].id() != 96 - index) { return 2; }
  }
  // The reverse and already sorted move-only paths have a linear budget;
  // no copied pivot, clone, or replacement allocation is permitted.
  std::sort(resources, Compare(194));
  std::sort(resources, Compare(194));
  for (mut int index = 0; index < 97; index++) {
    if (resources[std::size_t(index)].id() != index) { return 3; }
  }

  // The default relation also preserves duplicate counts and ordering.
  mut std::vector<int> repeated{};
  std::sort(repeated);
  repeated.push_back(0);
  std::sort(repeated);
  for (mut int index = 1; index < 115; index++) {
    repeated.push_back((index * 7) % 23);
  }
  std::sort(repeated);
  for (mut int index = 0; index < 115; index++) {
    if (repeated[std::size_t(index)] != index / 5) { return 4; }
  }
  return 0;
}
