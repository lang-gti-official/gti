#include <std/memory>

class Box {
  mut int& value;
public:
  Box(mut int& value) : value(value) {}
  int read() { return this.value; }
  void add(int amount) mut { this.value += amount; }
};

int read_erased(std::erased_object& object) {
  unsafe {
    Box& box = std::restore_ref<Box>(object);
    return box.read();
  }
}

void add_erased(mut std::erased_object& object, int amount) {
  unsafe {
    mut Box& box = std::restore_mut<Box>(object);
    box.add(amount);
  }
}

// These unrelated source helpers prove that backend admission follows the
// verifier's exact restoration chain rather than recognizing a stdlib name.
unsafe Box& relay_read(std::erased_object& object) {
  unsafe {
    Box& box = std::restore_ref<Box>(object);
    return box;
  }
}

unsafe mut Box& relay_mut(mut std::erased_object& object) {
  unsafe {
    mut Box& box = std::restore_mut<Box>(object);
    return box;
  }
}

int main() {
  mut int value = 7;
  mut Box box{value};
  {
    std::erased_object& object = std::erase_ref(box);
    if (read_erased(object) != 7) return 1;
    unsafe {
      Box& relayed = relay_read(object);
      if (relayed.read() != 7) return 3;
    }
  }
  {
    mut std::erased_object& object = std::erase_mut(box);
    add_erased(object, 5);
    unsafe {
      mut Box& relayed = relay_mut(object);
      relayed.add(4);
    }
  }
  return box.read() == 16 ? 0 : 2;
}
