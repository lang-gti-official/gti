#include <std/string>
#include <std/vector>

// Expected<Class, E> call results whose success class has no default
// constructor, published without value-initializing the Expected: directly
// into a constructor field as its member initializer, or into the storage a
// conditional join shares between its arms.
struct item_value {
  int32_t number;
  item_value(int32_t number) : number(number) {}
};

struct code_value {
  int32_t code;
  code_value(int32_t code) : code(code) {}
};

// A failure-free producer returns the Expected by value.
expected<item_value, int32_t> make_item(bool ok) {
  if (ok) { return item_value(7); }
  return unexpected(int32_t(3));
}

// A producer that can fail publishes the Expected on its success edge.
expected<item_value, int32_t> make_checked(int32_t value) {
  return item_value(value + 1);
}

expected<item_value, code_value> make_coded(bool ok) {
  if (ok) { return item_value(4); }
  return unexpected(code_value(9));
}

int32_t read(expected<item_value, int32_t> result) {
  return result ? result.value().number : 100 + result.error();
}

struct box {
  expected<item_value, int32_t> item;
  expected<item_value, code_value> coded;
  box(bool ok) : item(make_item(ok)), coded(make_coded(!ok)) {}
};

struct checked_box {
  expected<item_value, int32_t> item;
  checked_box(int32_t value) : item(make_checked(value)) {}
};

expected<item_value, int32_t> pick(bool ok) {
  return ok ? make_item(true) : make_item(false);
}

int main(int argc, std::vector<std::string> argv) {
  bool yes = argc > 0;
  bool no = !yes;
  if (argc == 2) {
    return (no ? make_item(true) : make_item(false)).value().number;
  }
  if (argc == 3) {
    return (yes ? make_checked(2147483647) : make_checked(1)).value().number;
  }
  if (argc == 4) {
    checked_box failing{2147483647};
    return failing.item.value().number;
  }
  box success{yes};
  if (success.item.value().number != 7 || success.coded.error().code != 9) {
    return 1;
  }
  box failure{no};
  if (failure.item.error() != 3 || failure.coded.value().number != 4) {
    return 2;
  }
  checked_box checked{6};
  if (checked.item.value().number != 7) { return 3; }
  if (!(yes ? make_item(true) : make_item(false)).has_value()) { return 4; }
  if ((yes ? make_item(false) : make_item(true)) ? true : false) { return 5; }
  if ((yes ? make_item(true) : make_item(false)).value().number != 7) {
    return 6;
  }
  if ((no ? make_item(true) : make_item(false)).error() != 3) { return 7; }
  if ((no ? make_checked(1) : make_checked(6)).value().number != 7) {
    return 8;
  }
  if (read(no ? make_item(true) : make_item(false)) != 103) { return 9; }
  expected<item_value, int32_t> bound = yes ? make_item(true) : make_item(false);
  if (bound.value().number != 7) { return 10; }
  if (!(yes ? make_item(true) : (no ? make_item(true) : make_item(false)))
           .has_value()) {
    return 11;
  }
  if (pick(yes).value().number != 7 || pick(no).error() != 3) { return 12; }
  mut int32_t states = 0;
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 4; index++) {
    if ((index % 2 == 0 ? make_item(true) : make_item(false)).has_value()) {
      states += 1;
    }
    box looped{index != 1};
    total += looped.item ? looped.item.value().number : looped.item.error();
  }
  if (states != 2 || total != 24) { return 13; }
  return 0;
}
