import std.assert;
import std.string;
import std.source_location;

struct Observations {
  static mut int conditions = 0;
  static mut int messages = 0;
  static mut int recorded = 0;
  static mut uint32_t source_line = uint32_t(0);
  static mut int local_evaluations = 0;
  static mut int text_evaluations = 0;
  static mut int local_drops = 0;
  static mut int local_drop_order = 0;
  static mut int loop_visits = 0;
  static mut int loop_bodies = 0;
public:
  Observations() = default;
};

struct Record {
  std::string text;
  Record(std::string value) : text(std::move(value)) {}
};

struct LocalOwner {
  std::string text;
  int number;
  LocalOwner(std::string value, int identity) :
      text(std::move(value)), number(identity) {}
  ~LocalOwner() {
    Observations::local_drops++;
    Observations::local_drop_order = Observations::local_drop_order * 10 + number;
  }
};

std::string local_payload() {
  Observations::text_evaluations++;
  return std::string("local payload");
}

bool check_state() {
  Observations::conditions++;
  return true;
}

int expensive_message() {
  Observations::messages++;
  return 42;
}

bool consume_condition(std::string value) { return !value.empty(); }

namespace application {
  void record(int number) { Observations::recorded = number; }
  bool has_text(Record& value) { return !value.text.empty(); }
  void visit_loop() { Observations::loop_visits++; }
  void finish_loop_body() { Observations::loop_bodies++; }

  // This application API uses exactly the same mechanism as std::assert.
  #macro when(bool enabled, int value) {
    if (enabled) { record(value); }
  }

  #macro repeat(int value) { record(value); record(value); }

  #macro hygienic(int value) {
    int saved = 99;
    std::assert(saved == 99);
    record(value);
  }

  #macro once(bool enabled, int value) {
    if (enabled) {
      int saved = value;
      record(saved + saved);
    }
  }

  #macro owned_once(bool enabled, std::string value) {
    if (enabled) {
      LocalOwner owned{value, 7};
      std::assert(owned.text.view() == "local payload");
      std::assert(!owned.text.empty());
    }
  }

  #macro borrowed_twice(Record value) {
    Record& held = value;
    std::assert(has_text(held));
    std::assert(has_text(held));
  }

  #macro loop_owners(int count) {
    int limit = count;
    for (mut int index = 0; index < limit; ++index) {
      LocalOwner owned{std::string("for owner"), index + 1};
      visit_loop();
      if (index == 1) { continue; }
      if (index == 3) { break; }
      finish_loop_body();
    }
    mut int step = 0;
    while (step < 1) {
      LocalOwner owned{std::string("while owner"), 5};
      ++step;
      continue;
    }
    do {
      LocalOwner owned{std::string("do owner"), 6};
      break;
    } while (true);
  }

  void consume_record(Record value) { std::assert(!value.text.empty()); }

  #macro inspect(bool enabled, Record value) {
    if (enabled) { std::assert(has_text(value)); }
  }

  #macro choose(bool first, Record left, Record right) {
    if (first) { consume_record(left); } else { consume_record(right); }
  }

  #macro invoke_if<F>(bool enabled, F operation) {
    if (enabled) { operation(); }
  }

  void record_location(std::source_location location) {
    Observations::source_line = location.line();
  }

  #macro remember(bool enabled,
      std::source_location location = std::source_location::current()) {
    if (enabled) { record_location(location); }
  }
}

int main() {
  int record = 99; // Must not shadow application::record in its helper body.
  mut int local = 0;
  std::assert(local++ == 0, "unexpected count {}", expensive_message());
  std::assert(check_state(), "unexpected state {}", expensive_message());
  std::debug_assert(check_state(), "debug state {}", expensive_message());
  mut int repeated = 0;
  application::repeat(repeated++);
  if (repeated != 2 || Observations::recorded != 1) { return 9; }
  int saved = 17;
  application::once(true, saved);
  if (saved != 17 || Observations::recorded != 34) { return 10; }
  std::assert([]() -> bool {
    int saved = 23;
    application::hygienic(saved);
    return Observations::recorded == 23;
  }());
  if (Observations::recorded != 23) { return 16; }
  application::once(false, Observations::local_evaluations++);
  if (Observations::local_evaluations != 0) { return 11; }
  application::once(true, Observations::local_evaluations++);
  if (Observations::local_evaluations != 1 || Observations::recorded != 0) { return 12; }
  application::owned_once(false, local_payload());
  if (Observations::text_evaluations != 0 || Observations::local_drops != 0) { return 13; }
  mut int bounds = 6;
  application::loop_owners(bounds++);
  if (Observations::loop_visits != 4 || Observations::loop_bodies != 2 ||
      Observations::local_drops != 6 || Observations::local_drop_order != 123456 ||
      bounds != 7) { return 14; }
  application::owned_once(true, local_payload());
  if (Observations::text_evaluations != 1 || Observations::local_drops != 7 ||
      Observations::local_drop_order != 1234567) { return 15; }
  application::when(false, expensive_message());
  application::when(true, 7);
  auto callback = []() -> void { Observations::recorded = 8; };
  application::invoke_if(false, callback);
  if (Observations::recorded != 7) { return 7; }
  application::invoke_if(true, callback);
  application::remember(false);
  application::remember(true);
  uint32_t next_line = std::source_location::current().line();
  if (Observations::source_line + uint32_t(1) != next_line) { return 8; }
  Record inspected{std::string("read, not copied or moved")};
  application::inspect(true, inspected);
  application::borrowed_twice(inspected);
  if (inspected.text.view() != "read, not copied or moved") { return 6; }
  Record selected{std::string("consumed once")};
  application::choose(std::debug_assertions_enabled,
                      std::move(selected), std::move(selected));
  std::string owner{"retained"};
  std::assert(true, "{}", std::move(owner));
  std::string condition_owner{"owned condition"};
  std::debug_assert(consume_condition(std::move(condition_owner)));
#ifdef NDEBUG
  if (condition_owner.view() != "owned condition") { return 5; }
#endif
  if (owner.view() != "retained") { return 1; }
  if (local != 1 || record != 99 || Observations::messages != 0 || Observations::recorded != 8) {
    return 2;
  }
#ifdef NDEBUG
  if (Observations::conditions != 1) { return 3; }
#else
  if (Observations::conditions != 2) { return 4; }
#endif
  return 0;
}
