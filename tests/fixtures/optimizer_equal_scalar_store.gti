import std.string;
import std.vector;
import std.memory;
class Cell {
public:
  mut uint64_t value;
  Cell(uint64_t initial) : value(initial) {}
  void send_zero(mut Cell& right) mut {
    right.value = this.value;
    this.value = uint64_t(0);
  }
  void send_five(mut Cell& right) mut {
    right.value = this.value;
    this.value = uint64_t(5);
  }
  uint64_t read() { return this.value; }
};
uint64_t equal_store() {
  mut Cell left{uint64_t(0)};
  mut Cell right{uint64_t(0)};
  left.send_zero(right);
  return right.read() * uint64_t(18446744073709551615);
}
uint64_t same_nonzero() {
  mut Cell left{uint64_t(5)};
  mut Cell right{uint64_t(5)};
  left.send_five(right);
  return right.read() * uint64_t(3);
}
uint64_t changed_store(mut Cell& value) {
  value.value = uint64_t(0);
  value.value = uint64_t(18446744073709551615);
  return value.value * uint64_t(2);
}
class Audit { public: Audit() {} ~Audit() { std::println(99); } };
uint64_t raw_store(mut Cell& value) {
  value.value = uint64_t(0);
  unsafe { uint64_t* pointer = &value.value; *pointer = uint64_t(18446744073709551615); }
  return value.value * uint64_t(2);
}
uint64_t conditional_store(mut Cell& value, bool change) {
  value.value = uint64_t(0);
  if (change) value.value = uint64_t(18446744073709551615);
  return value.value * uint64_t(2);
}
// Byte access may partially overlap any live scalar; it is not a typed
// whole-object store and must invalidate the preexisting zero fact.
uint64_t overlapping_byte_store(mut Cell& value) {
  value.value = uint64_t(0);
  unsafe {
    uint8_t* bytes = std::typed_address<uint8_t>(std::erase_address(&value.value));
    bytes[uint64_t(0)] = uint8_t(2);
  }
  return value.value * uint64_t(18446744073709551615);
}
int main(int argc, std::vector<std::string> argv) {
  Audit audit{};
  mut Cell left{uint64_t(7)};
  mut Cell right{uint64_t(9)};
  if (argc == 1) return equal_store() == uint64_t(0) ? 0 : 1;
  if (argc == 2) return same_nonzero() == uint64_t(15) ? 0 : 1;
  if (argc == 3) return changed_store(right) == uint64_t(0) ? 0 : 1;
  if (argc == 4) return raw_store(right) == uint64_t(0) ? 0 : 1;
  if (argc == 7) return overlapping_byte_store(right) == uint64_t(0) ? 0 : 1;
  return conditional_store(right, argc == 6) == uint64_t(0) ? 0 : 1;
}
