mut int32_t constructions = 0;

class plain_t {
public:
  plain_t() { constructions += 1; }
  plain_t(plain_t& other) = default;

  int32_t get() { return this.value; }

  mut int32_t value = 1;
};

int32_t if_position() {
  if (plain_t().value == 1) {
    return 1;
  }
  return 0;
}

int32_t while_position() {
  mut bool pending = true;
  mut int32_t result = 0;
  while (pending && plain_t().value == 1) {
    result = 1;
    pending = false;
  }
  return result;
}

int32_t switch_position() {
  switch (plain_t().value) {
  case 1:
    return 1;
  default:
    return 0;
  }
}

int32_t accept_scalar(int32_t value) { return value; }

int32_t argument_position() { return accept_scalar(plain_t().value); }

int32_t return_position() { return plain_t().value; }

int32_t index_position() {
  int32_t values[2] = {0, 1};
  return values[plain_t().value];
}

int32_t initializer_position() {
  int32_t value = plain_t().value;
  return value;
}

int32_t compound_assignment_position() {
  mut int32_t value = 0;
  value += plain_t().value;
  return value;
}

plain_t make_plain() { return plain_t(); }

int32_t controls() {
  mut int32_t total = 0;
  total += plain_t().get();
  total += make_plain().value;
  total += make_plain().get();
  plain_t local = plain_t();
  total += local.value;
  return total;
}

mut int32_t argument_evaluations = 0;
mut int32_t factory_evaluations = 0;

int32_t next_argument() {
  argument_evaluations += 1;
  return argument_evaluations;
}

class Fixed {
public:
  int32_t value;
  Fixed(int32_t initial) : value(initial) { constructions += 1; }
  Fixed(Fixed& other) = delete;
  Fixed(Fixed&& other) = delete;
};

class Stamp {
public:
  int32_t value;
  Stamp(int32_t initial) : value(initial) { constructions += 1; }
  Stamp(Stamp& other) = delete;
  Stamp(Stamp&& other) = delete;
};

Fixed make_fixed(int32_t initial) {
  factory_evaluations += 1;
  return Fixed(initial);
}

int32_t immovable_observations() {
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 5; index += 1) {
    // Both slots must be constructed exactly once and retired before reuse.
    // The result is observed, never copied or moved.
    total += make_fixed(next_argument()).value;
    total += Stamp(next_argument()).value;
  }
  return total;
}

int32_t main() {
  int32_t total = if_position() + while_position() + switch_position() +
                  argument_position() + return_position() + index_position() +
                  initializer_position() + compound_assignment_position() +
                  controls() + immovable_observations();
  if (constructions != 22 || argument_evaluations != 10 ||
      factory_evaluations != 5) {
    return 1;
  }
  return total - 67;
}
