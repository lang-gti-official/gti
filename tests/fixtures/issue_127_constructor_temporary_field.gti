mut int32_t constructions = 0;

class plain_t {
public:
  plain_t() { constructions += 1; }
  plain_t(plain_t& other) = default;

  int32_t get() { return this.value; }

  mut int32_t value = 1;
};

int32_t if_position() {
  if (plain_t().value == 1) {
    return 1;
  }
  return 0;
}

int32_t while_position() {
  mut bool pending = true;
  mut int32_t result = 0;
  while (pending && plain_t().value == 1) {
    result = 1;
    pending = false;
  }
  return result;
}

int32_t switch_position() {
  switch (plain_t().value) {
  case 1:
    return 1;
  default:
    return 0;
  }
}

int32_t accept_scalar(int32_t value) { return value; }

int32_t argument_position() { return accept_scalar(plain_t().value); }

int32_t return_position() { return plain_t().value; }

int32_t index_position() {
  int32_t values[2] = {0, 1};
  return values[plain_t().value];
}

int32_t initializer_position() {
  int32_t value = plain_t().value;
  return value;
}

int32_t compound_assignment_position() {
  mut int32_t value = 0;
  value += plain_t().value;
  return value;
}

plain_t make_plain() { return plain_t(); }

int32_t controls() {
  mut int32_t total = 0;
  total += plain_t().get();
  total += make_plain().value;
  total += make_plain().get();
  plain_t local = plain_t();
  total += local.value;
  return total;
}

mut int32_t argument_evaluations = 0;
mut int32_t factory_evaluations = 0;

int32_t next_argument() {
  argument_evaluations += 1;
  return argument_evaluations;
}

class Fixed {
public:
  int32_t value;
  Fixed(int32_t initial) : value(initial) { constructions += 1; }
  Fixed(Fixed& other) = delete;
  Fixed(Fixed&& other) = delete;
};

class Stamp {
public:
  int32_t value;
  Stamp(int32_t initial) : value(initial) { constructions += 1; }
  Stamp(Stamp& other) = delete;
  Stamp(Stamp&& other) = delete;
};

Fixed make_fixed(int32_t initial) {
  factory_evaluations += 1;
  return Fixed(initial);
}

int32_t immovable_observations() {
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 5; index += 1) {
    // Both slots must be constructed exactly once and retired before reuse.
    // The result is observed, never copied or moved.
    total += make_fixed(next_argument()).value;
    total += Stamp(next_argument()).value;
  }
  return total;
}

// A class with a destructor keeps its temporary in MIR's own result slot. Each
// field is read before the temporary is destroyed at the end of its full
// expression, and every temporary is destroyed exactly once.
mut int32_t drops = 0;

struct tag_t {
  int32_t code;
  tag_t(int32_t code) : code(code) {}
  int32_t twice() { return this.code * 2; }
};

class tracked_t {
public:
  int32_t count;
  tag_t tag;
  tracked_t(int32_t initial) : count(initial), tag(tag_t(initial)) {}
  ~tracked_t() { drops += 1; }
};

// A constructor that can fail publishes its result on its success edge.
class checked_t {
public:
  int32_t count;
  checked_t(int32_t initial) : count(initial + 1) {}
  ~checked_t() { drops += 1; }
};

class defaulted_t {
public:
  mut int32_t count = 1;
  ~defaulted_t() { drops += 1; }
};

class field_reader_t {
public:
  int32_t declared = tracked_t(1).count;
  int32_t initialized;
  field_reader_t() : initialized(checked_t(0).count) {}
};

class base_reader_t {
public:
  int32_t stored;
  base_reader_t(int32_t value) : stored(value) {}
};

// The base argument's temporary lives until the base is constructed.
class derived_reader_t : public base_reader_t {
public:
  derived_reader_t() : base_reader_t(tracked_t(1).count) {}
};

int32_t owning_if_position() {
  if (tracked_t(1).count == 1) {
    return 1;
  }
  return 0;
}

int32_t owning_while_position() {
  mut bool pending = true;
  mut int32_t result = 0;
  while (pending && tracked_t(1).count == 1) {
    result = 1;
    pending = false;
  }
  return result;
}

int32_t owning_switch_position() {
  switch (tracked_t(1).count) {
  case 1:
    return 1;
  default:
    return 0;
  }
}

int32_t owning_argument_position() {
  return accept_scalar(tracked_t(1).count);
}

int32_t owning_return_position() { return tracked_t(1).count; }

int32_t owning_index_position() {
  int32_t values[2] = {0, 1};
  return values[tracked_t(1).count];
}

int32_t owning_initializer_position() {
  int32_t value = tracked_t(1).count;
  return value;
}

int32_t owning_compound_assignment_position() {
  mut int32_t value = 0;
  value += tracked_t(1).count;
  return value;
}

int32_t owning_short_circuit_position() {
  bool skip = false;
  if (skip || tracked_t(1).count == 1) {
    return 1;
  }
  return 0;
}

// The read happens before the destruction that ends its full expression.
int32_t owning_full_expression_order() {
  int32_t before = drops;
  int32_t observed = tracked_t(1).count + drops - before;
  return observed + drops - before - 1;
}

int32_t owning_nested_and_lent_fields() {
  return tracked_t(1).tag.code + tracked_t(1).tag.twice() - 2;
}

int32_t owning_construction_kinds() {
  return checked_t(0).count + defaulted_t().count - 1;
}

int32_t owning_loop_position() {
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 3; index += 1) {
    total += tracked_t(index).count;
  }
  return total - 2;
}

int32_t owning_field_initializers() {
  field_reader_t reader{};
  return reader.declared + reader.initialized - 1;
}

int32_t owning_base_initializer() {
  derived_reader_t reader = derived_reader_t();
  return reader.stored;
}

int32_t owning_observations() {
  return owning_if_position() + owning_while_position() +
         owning_switch_position() + owning_argument_position() +
         owning_return_position() + owning_index_position() +
         owning_initializer_position() +
         owning_compound_assignment_position() +
         owning_short_circuit_position() + owning_full_expression_order() +
         owning_nested_and_lent_fields() + owning_construction_kinds() +
         owning_loop_position() + owning_field_initializers() +
         owning_base_initializer();
}

// A cleanup-free temporary may be read through a nested field chain. MIR keeps
// each shorter chain as an untouched place on the same temporary; the read
// still goes through the temporary's one value slot, which retires after it.
mut int32_t nested_constructions = 0;

class word_t {
public:
  std::string_view text;
  int32_t kind;
  word_t(std::string_view text, int32_t kind) : text(text), kind(kind) {
    nested_constructions += 1;
  }
  int32_t twice() { return this.kind * 2; }
};

class phrase_t {
public:
  word_t word;
  phrase_t(word_t word) : word(word) { nested_constructions += 1; }
};

class sentence_t {
public:
  phrase_t phrase;
  int32_t tail;
  sentence_t(phrase_t phrase, int32_t tail) : phrase(phrase), tail(tail) {
    nested_constructions += 1;
  }
};

class anchored_t {
public:
  word_t word;
  anchored_t(int32_t kind) : word(word_t("anchored", kind)) {
    nested_constructions += 1;
  }
  anchored_t(anchored_t& other) = delete;
  anchored_t(anchored_t&& other) = delete;
};

class level_t {
public:
  int32_t value;
  level_t(int32_t value) : value(value) { nested_constructions += 1; }
};

class tier_t {
public:
  level_t level;
  tier_t(int32_t value) : level(level_t(value)) { nested_constructions += 1; }
};

struct corner_t {
  mut int32_t x = 0;
  mut int32_t y = 0;
};

struct span_t {
  mut corner_t low;
  mut corner_t high;
};

phrase_t make_phrase(int32_t kind) { return phrase_t(word_t("made", kind)); }

span_t make_span(int32_t x) {
  mut span_t span{};
  span.low.x = x;
  return span;
}

int32_t nested_initializer_position() {
  int32_t kind = phrase_t(word_t("scalar", 1)).word.kind;
  return kind;
}

int32_t nested_text_position() {
  std::string_view text = phrase_t(word_t("words", 2)).word.text;
  return text.size() == 5 ? 1 : 0;
}

int32_t nested_observer_position() {
  return phrase_t(word_t("four", 3)).word.text.size() == 4 ? 1 : 0;
}

int32_t nested_member_position() {
  return sentence_t(phrase_t(word_t("member", 4)), 0).phrase.word.twice() ==
                 8
             ? 1
             : 0;
}

int32_t nested_deep_position() {
  return sentence_t(phrase_t(word_t("deep", 1)), 9).phrase.word.kind;
}

int32_t nested_short_circuit_position() {
  bool skip = false;
  if (skip || phrase_t(word_t("either", 1)).word.kind == 1) {
    return 1;
  }
  return 0;
}

// The one Move out of a cleanup-free conditional join stages the joined
// object for its read.
int32_t nested_join_position() {
  bool left = false;
  return (left ? tier_t(2) : tier_t(1)).level.value;
}

int32_t nested_call_position() { return make_phrase(1).word.kind; }

int32_t nested_aggregate_call_position() { return make_span(1).low.x; }

int32_t nested_moved_position() {
  phrase_t local = phrase_t(word_t("moved", 1));
  return std::move(local).word.kind;
}

int32_t nested_lambda_position() {
  auto make = [](int32_t kind) -> phrase_t {
    return phrase_t(word_t("lambda", kind));
  };
  return make(1).word.kind;
}

int32_t nested_immovable_loop() {
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 3; index += 1) {
    // Each iteration publishes into the same slot after the last one retired.
    total += anchored_t(index).word.kind;
  }
  return total == 3 ? 1 : 0;
}

// A cleanup-free conditional join may take arms that pass a class by value to
// their constructor, or that build a class holding a text view. Its one Move
// still stages the joined object for its read.
int32_t join_transfer_position() {
  bool left = true;
  return (left ? phrase_t(word_t("one", 1)) : phrase_t(word_t("two", 2)))
      .word.kind;
}

int32_t join_text_position() {
  bool left = false;
  return (left ? word_t("left", 2) : word_t("right", 1)).kind;
}

int32_t join_text_view_position() {
  bool left = true;
  std::string_view text = (left ? word_t("view", 1) : word_t("other", 2)).text;
  return text.size() == 4 ? 1 : 0;
}

int32_t join_text_observer_position() {
  bool left = false;
  return (left ? word_t("a", 1) : word_t("abc", 2)).text.size() == 3 ? 1 : 0;
}

int32_t join_text_method_position() {
  bool left = true;
  return (left ? word_t("m", 3) : word_t("n", 4)).twice() == 6 ? 1 : 0;
}

int32_t join_transfer_loop() {
  mut int32_t total = 0;
  for (mut int32_t index = 0; index < 4; index += 1) {
    // Each iteration reuses the join storage and the value slot.
    total += (index % 2 == 0 ? phrase_t(word_t("even", index))
                             : phrase_t(word_t("odd", index)))
                 .word.kind;
  }
  return total == 6 ? 1 : 0;
}

int32_t join_observations() {
  return join_transfer_position() + join_text_position() +
         join_text_view_position() + join_text_observer_position() +
         join_text_method_position() + join_transfer_loop();
}

int32_t nested_observations() {
  return nested_initializer_position() + nested_text_position() +
         nested_observer_position() + nested_member_position() +
         nested_deep_position() + nested_short_circuit_position() +
         nested_join_position() + nested_call_position() +
         nested_aggregate_call_position() + nested_moved_position() +
         nested_lambda_position() + nested_immovable_loop();
}

int32_t main() {
  int32_t total = if_position() + while_position() + switch_position() +
                  argument_position() + return_position() + index_position() +
                  initializer_position() + compound_assignment_position() +
                  controls() + immovable_observations();
  if (constructions != 22 || argument_evaluations != 10 ||
      factory_evaluations != 5) {
    return 1;
  }
  if (owning_observations() != 15 || drops != 20) {
    return 2;
  }
  if (nested_observations() != 12 || nested_constructions != 28) {
    return 3;
  }
  if (join_observations() != 6 || nested_constructions != 42) {
    return 4;
  }
  return total - 67;
}
