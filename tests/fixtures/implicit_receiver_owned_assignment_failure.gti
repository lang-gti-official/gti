import std.string;

struct Details {
  mut std::string title = std::string("initial");
public:
  Details() = default;
};
struct Marker {
  ~Marker() { std::println("cleaned"); }
public:
  Marker() = default;
};
class Owner {
  mut Marker marker{};
  mut Details details{};
public:
  Owner(std::string_view title, int divisor) {
    details.title = std::string(title);
    int result = 10 / divisor;
  }
public:
  Owner() = default;
};
int main() {
  Owner owner{"replacement", 0};
  return 0;
}
