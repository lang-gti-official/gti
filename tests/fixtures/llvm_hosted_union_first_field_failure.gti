import std.panic;
mut int trace = 0;
class Marker {
  int value;
public:
  Marker(int value) : value(value) {}
  int read() { return this.value; }
  ~Marker() { trace = trace * 10 + this.value; }
};
thread_local Marker early{1};
thread_local Marker late{2};
union Overlay { mut uint64_t value; mut double other; };
uint64_t first_input(bool success) {
  if (success) { return uint64_t(7); }
  std::panic("union first-field initialization failure");
}
int main() {
  [[discard]] early.read();
  [[discard]] late.read();
  Marker local{3};
  Overlay unpublished{first_input(false)};
  trace = 9999;
  return 0;
}
