import std.memory;

class Meter {
public:
  mut uint64_t count;
  mut uint64_t spare = uint64_t(0);
  Meter(uint64_t value) : count(value) {}
  uint64_t read() { return this.count; }
  uint64_t relay() { return this.read(); }
  uint64_t choose(bool first) {
    if (first) return this.count;
    return this.spare;
  }
  uint64_t mutable_read() mut { return this.count; }
};

class Counter {
public:
  mut uint64_t count = uint64_t(0);
  Counter(uint64_t target) {
    while (this.relay() < target) { this.step(); }
  }
  uint64_t read() { return this.count; }
  uint64_t relay() { return this.read(); }
  void step() mut {
    if (this.count < uint64_t(4)) { this.count++; }
  }
public:
  Counter() = default;
};

class Envelope {
public:
  mut Meter inner;
  Envelope(uint64_t value) : inner(Meter(value)) {}
  uint64_t read() { return this.inner.relay(); }
};

uint64_t guarded_nested(Envelope& envelope) {
  if (envelope.read() < uint64_t(4)) {
    return envelope.inner.count + uint64_t(1);
  }
  return uint64_t(0);
}

uint64_t observe_counter(Counter& counter) { return counter.read(); }

uint64_t guarded(Meter& meter) {
  if (meter.relay() < uint64_t(4)) { return meter.count + uint64_t(1); }
  return uint64_t(0);
}

uint64_t disjoint(mut Meter& meter) {
  if (meter.read() < uint64_t(4)) {
    meter.spare = uint64_t(18446744073709551615);
    return meter.count + uint64_t(1);
  }
  return uint64_t(0);
}

uint64_t later_argument(mut Meter& meter) {
  meter.count = uint64_t(18446744073709551615);
  return uint64_t(4);
}

uint64_t order_changed(mut Meter& meter) {
  if (meter.read() < later_argument(meter)) {
    return meter.count + uint64_t(1);
  }
  return uint64_t(0);
}

uint64_t cached_local(mut Meter& meter) {
  uint64_t old = meter.read();
  meter.count = uint64_t(18446744073709551615);
  if (old < uint64_t(4)) { return meter.count + uint64_t(1); }
  return uint64_t(0);
}

uint64_t ambiguous(Meter& meter) {
  if (meter.choose(false) < uint64_t(4)) {
    return meter.count + uint64_t(1);
  }
  return uint64_t(0);
}

uint64_t direct_changed(mut Meter& meter) {
  if (meter.read() < uint64_t(4)) {
    meter.count = uint64_t(18446744073709551615);
    return meter.count + uint64_t(1);
  }
  return uint64_t(0);
}

uint64_t mutable_changed(mut Meter& meter) {
  if (meter.mutable_read() < later_argument(meter)) {
    return meter.count + uint64_t(1);
  }
  return uint64_t(0);
}

uint64_t raw_changed(mut Meter& meter) {
  if (meter.read() < uint64_t(4)) {
    unsafe { *(&meter.count) = uint64_t(18446744073709551615); }
    return meter.count + uint64_t(1);
  }
  return uint64_t(0);
}

uint64_t from_copy(Meter meter) { return meter.count; }
uint64_t copy_snapshot(mut Meter& meter) {
  if (from_copy(meter) < later_argument(meter)) {
    return meter.count + uint64_t(1);
  }
  return uint64_t(0);
}

int main() {
  mut Meter meter{uint64_t(3)};
  Meter huge{uint64_t(18446744073709551615)};
  if (guarded(meter) != uint64_t(4) || guarded(huge) != uint64_t(0)) return 1;
  if (disjoint(meter) != uint64_t(4)) return 2;
  Envelope small{uint64_t(3)};
  Envelope large{uint64_t(18446744073709551615)};
  if (guarded_nested(small) != uint64_t(4) ||
      guarded_nested(large) != uint64_t(0)) return 4;
  Counter counter{uint64_t(4)};
  if (observe_counter(counter) != uint64_t(4)) return 3;
  if (true) return int(order_changed(meter));
  if (false) return int(cached_local(meter));
  if (false) return int(ambiguous(huge));
  if (false) return int(direct_changed(meter));
  if (false) return int(mutable_changed(meter));
  if (false) return int(raw_changed(meter));
  return int(copy_snapshot(meter));
}
