mut int32_t cleanup_bits = 0;
mut int32_t first_close = 0;

class CheckedDestructor {
public:
  int32_t bit;

  CheckedDestructor(int32_t value) : bit(value) {}

  ~CheckedDestructor() {
    cleanup_bits = cleanup_bits | this.bit;
    if (first_close == 0) {
      first_close = this.bit;
    }
    this.bit + 1;
  }
};

int32_t checked_increment(int32_t value) {
  CheckedDestructor scope = CheckedDestructor(1);
  return value + 1;
}

int main() {
  int32_t result = checked_increment(40);
  if (result != 41) {
    return 1;
  }
  return 0;
}
