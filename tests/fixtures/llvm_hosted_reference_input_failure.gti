import std.panic;
mut int trace = 0;
class Marker {
  int value;
public:
  Marker(int value) : value(value) {}
  int read() { return this.value; }
  ~Marker() { trace = trace * 10 + this.value; }
};
thread_local Marker early{1};
thread_local Marker late{2};
unsafe Marker& checked_marker(Marker& value) { return value; }
int consume(Marker& value, int extra) {
  trace = 9999;
  return value.read() + extra;
}
int fail_later() {
  std::panic("borrowed argument failure");
}
int main() {
  [[discard]] early.read();
  [[discard]] late.read();
  Marker local{3};
  unsafe { return consume(checked_marker(local), fail_later()); }
}
