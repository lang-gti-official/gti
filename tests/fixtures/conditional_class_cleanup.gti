mut int constructed = 0;
mut int destroyed = 0;
mut int last_destroyed = 0;

class Reading {
  int number;
public:
  Reading(int initial) : number(initial) { constructed += 1; }
  Reading(Reading& other) = delete;
  ~Reading() {
    destroyed += 1;
    last_destroyed = this.number;
  }
  int read() { return this.number; }
};

int check(bool left) {
  int before = destroyed;
  int wanted = left ? 3 : 7;
  for (mut int index = 0; index < 4; ++index) {
    {
      Reading selected = left ? Reading(3) : Reading(7);
      if (selected.read() != wanted || destroyed != before + index) { return 1; }
    }
    if (destroyed != before + index + 1 || last_destroyed != wanted) { return 2; }
  }
  return 0;
}

int main() {
  if (check(true) != 0 || check(false) != 0) { return 1; }
  if (constructed != 8 || destroyed != 8) { return 2; }
  return 0;
}
