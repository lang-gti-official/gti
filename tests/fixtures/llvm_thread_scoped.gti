#include <std/thread>

// Scoped tasks borrow disjoint caller state and are cleaned in reverse
// argument order on the caller after every worker joined.
struct tally { mut int32_t left = 0; mut int32_t right = 0; };

[[unsafe_transfer]] class add_left {
  mut int32_t& target;
  int32_t amount;
public:
  add_left(mut int32_t& target, int32_t amount)
      : target(target), amount(amount) {}
  void operator()() mut { this.target += this.amount; }
  ~add_left() { std::println("left task cleaned"); }
};

[[unsafe_transfer]] class set_right {
  mut int32_t& target;
public:
  set_right(mut int32_t& target) : target(target) {}
  void operator()() && { this.target = 9; }
  ~set_right() { std::println("right task cleaned"); }
};

class reader {
  int32_t& source;
public:
  reader(int32_t& source) : source(source) {}
  void operator()() { if (this.source != 5) { std::println("bad read"); } }
};

void noop() {}

int main() {
  mut tally values{};
  if (!std::parallel_invoke(add_left(values.left, 4),
                            set_right(values.right))) {
    return 1;
  }
  std::println(values.left + values.right);
  int32_t shared = 5;
  if (!std::parallel_invoke(reader(shared), reader(shared), noop)) {
    return 2;
  }
  if (!std::parallel_invoke()) { return 3; }
  values.left += 1;
  std::println(values.left);
  return 0;
}
