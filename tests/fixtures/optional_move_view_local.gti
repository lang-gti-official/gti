#include <std/optional>
#include <std/string>

int main() {
  std::optional<std::string_view> empty{};
  if (empty.has_value()) { return 1; }
  std::string owner{"owned"};
  std::string_view view = owner.view();
  std::string_view moved = std::move(view);
  return moved.size() == std::size_t(5) ? 0 : 2;
}
