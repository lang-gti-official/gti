class FailureCleanup {
public:
  int32_t bit;

  FailureCleanup(int32_t value) : bit(value) {
    value + 1;
  }

  ~FailureCleanup() {
    this.bit + 1;
  }
};

int32_t checked_increment(int32_t value) {
  FailureCleanup scope = FailureCleanup(1);
  return value + 1;
}

int main() {
  int32_t result = checked_increment(40);
  if (result != 41) {
    return 1;
  }
  return 0;
}
