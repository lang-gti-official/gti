#include <std/forward_list>
#include <std/string>
#include <std/vector>

class item {
public:
  int32_t key;
  int32_t divisor;
  item() : key(0), divisor(1) {}
  item(int32_t value, int32_t denominator) : key(value), divisor(denominator) {}
  item(item& other) = delete;
  item(item&& other) = default;
  ~item() { std::println(this.key); }
  bool operator==(item& other) {
    return this.key / this.divisor == other.key / other.divisor;
  }
  bool operator!=(item& other) { return this.key != other.key; }
  bool operator<(item& other) {
    return this.key / this.divisor < other.key / other.divisor;
  }
  bool operator<=(item& other) { return this.key <= other.key; }
  bool operator>(item& other) { return this.key > other.key; }
  bool operator>=(item& other) { return this.key >= other.key; }
};

int main(int argc, std::vector<std::string> argv) {
  int32_t divisor = argc == 1 ? 1 : 0;
  mut std::forward_list<item> values = std::forward_list<item>();
  values.push_front(item(3, divisor));
  values.push_front(item(1, divisor));
  values.push_front(item(2, divisor));
  if (argc == 3) {
    [[discard]] values.unique();
  } else {
    values.sort();
  }
  values.reverse();
  values.clear();
  values.resize(std::size_t(2));
  values.clear();
  values.push_front(item(4, 1));
  values.push_front(item(5, 1));
  return 0;
}
