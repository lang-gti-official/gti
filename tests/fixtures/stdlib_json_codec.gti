#include <std/json>
#include <std/string>
#include <std/vector>

class user {
  uint64_t user_id;
  std::string user_login;

public:
  user(uint64_t id, std::string login)
      : user_id(id), user_login(std::move(login)) {}

  user(user& other) = delete;
  user(user&& other) = default;

  uint64_t id() {
    return this.user_id;
  }

  std::string& login() {
    return this.user_login;
  }
};

class std::json::codec<user> {
public:
  expected<user, std::json::error> decode(std::json::value& input) {
    mut auto id = input.get_uint64("id");
    if (!id) {
      return unexpected(std::move(id).error());
    }
    mut auto login = input.get_string("login");
    if (!login) {
      return unexpected(std::move(login).error());
    }
    mut std::string owned_login = std::move(login).value();
    return user(id.value(), std::move(owned_login));
  }

  expected<std::json::value, std::json::error> encode(user& input) {
    mut std::json::value output = std::json::value::object();
    mut auto id = output.set("id", input.id());
    if (!id) {
      return unexpected(std::move(id).error());
    }
    mut auto login = output.set("login", input.login().view());
    if (!login) {
      return unexpected(std::move(login).error());
    }
    return std::move(output);
  }
};

int main() {
  mut auto decoded =
      std::json::decode<user>("{\"id\":7,\"login\":\"octocat\"}");
  if (!decoded) {
    return 1;
  }
  mut user account = std::move(decoded).value();
  if (account.id() != uint64_t(7) || account.login() != "octocat") {
    return 2;
  }

  mut auto encoded_value = std::json::encode<user>(account);
  if (!encoded_value) {
    return 3;
  }
  mut std::json::value document = std::move(encoded_value).value();
  mut std::string text = std::json::stringify(document);
  if (text != "{\"id\":7,\"login\":\"octocat\"}") {
    return 4;
  }

  mut auto users = std::json::decode_array<user>(
      "[{\"id\":1,\"login\":\"one\"},{\"id\":2,\"login\":\"two\"}]");
  if (!users) {
    return 5;
  }
  mut std::vector<user> values = std::move(users).value();
  if (values.size() != 2 || values[std::size_t(1)].id() != uint64_t(2)) {
    return 6;
  }

  auto invalid_users =
      std::json::decode_array<user>("[{\"id\":1,\"login\":\"one\"},{\"id\":2}]");
  if (invalid_users ||
      invalid_users.error().code() != std::json::errc::missing_key ||
      invalid_users.error().path() != "/1/login") {
    return 7;
  }
  return 0;
}
