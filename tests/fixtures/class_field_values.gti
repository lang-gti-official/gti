#include <std/utility>

struct Value {
  mut int number = 7;
public:
  Value() = default;
};

Value make_value(int number) {
  mut Value result{};
  result.number = number;
  return result;
}

struct Pair {
  mut Value first = Value();
  mut Value second{};
public:
  Pair() = default;
};

class UserValue {
public:
  int number;
  UserValue(int initial) : number(initial) {}
};

class Holder {
public:
  mut Value first = Value();
  mut Value second = Value();
  mut UserValue user = UserValue(1);
  Holder() {}
  void replace(Value value) mut {
    this.first = value;
    this.second = make_value(11);
    this.first = this.second;
  }
};

class ExplicitDefault {
public:
  mut Value value;
  ExplicitDefault() : value(Value()) {}
};

class NestedDefault {
public:
  Pair values{};
  NestedDefault() {}
};

struct Item {
  int port = 80;
  Value value{};
public:
  Item() = default;
};

struct Box {
  mut Pair values{};
public:
  Box() = default;
};

int main() {
  mut Box holder{};
  mut Holder methods = Holder();
  Value copy = {.number = 3};
  holder.values.first = copy;
  holder.values.second = holder.values.first;
  if (holder.values.second.number != 3) { return 1; }
  holder.values.first = make_value(5);
  holder.values.first = Value();
  if (holder.values.first.number != 7) { return 4; }
  holder.values.second = make_value(6);
  methods.user = UserValue(6);
  Value moved = {.number = 9};
  holder.values.first = std::move(moved);
  if (holder.values.first.number != 9 || holder.values.second.number != 6 ||
      methods.user.number != 6) { return 2; }
  methods.replace(copy);
  ExplicitDefault explicit_default = ExplicitDefault();
  NestedDefault nested_default = NestedDefault();
  Item omitted = {.port = 1};
  Item explicit_value = {.port = 2, .value = {.number = 13}};
  if (methods.first.number != 11 || methods.second.number != 11 ||
      explicit_default.value.number != 7 || nested_default.values.first.number != 7 ||
      nested_default.values.second.number != 7 || omitted.value.number != 7 ||
      explicit_value.value.number != 13) { return 3; }
  return 0;
}
