import std.string;
import std.vector;

class Trace {
public:
  Trace() {}
  ~Trace() { std::println("cleanup"); }
};

namespace raw {
// Caller guarantees that pointer addresses a live initialized int32_t.
unsafe int32_t read(const int32_t* pointer) {
  unsafe { return *pointer; }
}

unsafe T relay<T>(T value) { return value; }

unsafe int32_t divide(int32_t numerator, int32_t divisor) {
  Trace inner = Trace();
  return numerator / divisor;
}
}

concept readable<T> = requires(T& source) {
  unsafe { source.read() } -> int32_t;
};
struct Reader {
  const int32_t* pointer = nullptr;
  unsafe int32_t read() { unsafe { return *this.pointer; } }
  unsafe static int32_t identity(int32_t value) { return value; }
public:
  Reader() = default;
};
unsafe int32_t read_generic<T>(T& source) requires readable<T> {
  unsafe { return source.read(); }
}

int main(int argc, std::vector<std::string> argv) {
  Trace outer = Trace();
  int32_t value = 42;
  Reader reader{.pointer = &value};
  unsafe {
    if (Reader::identity(read_generic(reader)) != 42) { return 3; }
    if (raw::relay(raw::read(&value)) != 42) { return 1; }
    int32_t divisor = argc > 1 ? 0 : 2;
    return raw::divide(value, divisor) == 21 ? 0 : 2;
  }
}
