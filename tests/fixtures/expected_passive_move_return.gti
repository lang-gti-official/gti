#include <std/utility>

class Descriptor {
  int value;
public:
  Descriptor(int value) : value(value) {}
  int read() { return this.value; }
};
expected<Descriptor,int> produce() { return Descriptor(42); }
expected<Descriptor,int> relay() {
  auto result = produce();
  return std::move(result);
}
int main() {
  auto result = relay();
  if (!result) { return 1; }
  return result.value().read() - 42;
}
