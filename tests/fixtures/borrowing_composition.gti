struct BorrowedPair {
  int& left;
  int& right;

  BorrowedPair(int& first, int& second) : left(first), right(second) {}

  int sum() { return left + right; }
};

struct DuplicatedView {
  int& first;
  int& second;
  DuplicatedView(int& value) : first(value), second(value) {}
  int sum() { return first + second; }
};

BorrowedPair make_view(int& first, int& second) {
  return BorrowedPair(first, second);
}

BorrowedPair forward_view(BorrowedPair view) {
  return view;
}

int observe_forwarded(BorrowedPair view) {
  // Entry dependencies protect caller-owned referents, not this value shell.
  return forward_view(view).sum();
}

int observe_forwarded_reference(BorrowedPair& view) {
  return forward_view(view).sum();
}

BorrowedPair reversed_view(int& first, int& second) {
  return BorrowedPair(second, first);
}

struct Reading {
  int& value;
  Reading(int& source) : value(source) {}
};

struct Readings {
  Reading first;
  Reading second;
  Readings(Reading left, Reading right) : first(left), second(right) {}
};

Readings combine_readings(Reading left, Reading right) {
  return Readings(left, right);
}

Readings reverse_readings(Reading left, Reading right) {
  return Readings(right, left);
}

struct UpdateContext {
  int& step;
  mut int& left;
  mut int& right;
  UpdateContext(int& amount, mut int& first, mut int& second)
      : step(amount), left(first), right(second) {}
  void update() mut { this.left += this.step; this.right += this.step; }
};

T transfer_context<T>(T value) { return std::move(value); }

int branch_transfer(bool outer, bool inner) {
  int step = 2;
  mut int left = 0;
  mut int right = 0;
  UpdateContext initial{step, left, right};
  if (outer) {
    if (inner) {
      mut auto active = transfer_context<UpdateContext>(std::move(initial));
      active.update();
    } else {
      mut auto active = transfer_context<UpdateContext>(std::move(initial));
      active.update();
      active.update();
    }
  } else {
    mut auto active = transfer_context<UpdateContext>(std::move(initial));
    active.update();
    active.update();
    active.update();
  }
  return left + right;
}

int terminating_branch_transfer(bool early) {
  int step = 3;
  mut int left = 0;
  mut int right = 0;
  UpdateContext initial{step, left, right};
  if (early) {
    return 1;
  } else {
    mut auto active = transfer_context<UpdateContext>(std::move(initial));
    active.update();
  }
  return left + right;
}

int loop_transfer() {
  int step = 2;
  mut int left = 0;
  mut int right = 0;
  for (mut int index = 0; index < 3; index++) {
    UpdateContext initial{step, left, right};
    UpdateContext intermediate = transfer_context<UpdateContext>(std::move(initial));
    mut auto active = transfer_context<UpdateContext>(std::move(intermediate));
    active.update();
  }
  return left + right;
}

int main() {
  if (branch_transfer(true, true) != 4 || branch_transfer(true, false) != 8 ||
      branch_transfer(false, true) != 12 || branch_transfer(false, false) != 12 ||
      terminating_branch_transfer(true) != 1 ||
      terminating_branch_transfer(false) != 6 || loop_transfer() != 12) { return 10; }
  mut int first = 20;
  mut int second = 22;
  BorrowedPair pair{first, second};
  BorrowedPair copied = pair;
  if (copied.sum() != 42) { return 1; }
  // Both independent owner dependencies end after the last use of all copies.
  first = 30;
  second = 12;
  BorrowedPair same_owner{first, first};
  if (same_owner.sum() != 60) { return 2; }
  DuplicatedView duplicated{first};
  if (duplicated.sum() != 60) { return 6; }
  BorrowedPair final_pair{first, second};
  if (final_pair.sum() != 42) { return 3; }
  if (observe_forwarded(final_pair) != 42) { return 7; }
  if (observe_forwarded_reference(final_pair) != 42) { return 8; }
  Reading left{first};
  Reading right{second};
  auto readings = combine_readings(left, right);
  auto reversed = reverse_readings(left, right);
  auto repeated = combine_readings(left, left);
  if (readings.first.value != 30 || readings.second.value != 12 ||
      reversed.first.value != 12 || reversed.second.value != 30 ||
      repeated.first.value != 30 || repeated.second.value != 30) { return 9; }
  auto factory = make_view(first, second);
  auto forwarded = forward_view(factory);
  if (reversed_view(first, second).sum() != 42) { return 5; }
  auto moved = forward_view(std::move(forwarded));
  return moved.sum() == 42 ? 0 : 4;
}
