import std.thread;

// A second failure while a worker frame cleans up after its first failure is
// the terminal GTI-R0014 envelope. The remaining worker frames are abandoned
// and the joining thread reports the exact envelope.
class fails_on_cleanup {
public:
  ~fails_on_cleanup() {
    int32_t zero = 0;
    int32_t value = 1 / zero;
  }
public:
  fails_on_cleanup() = default;
};

[[unsafe_transfer]] class witness {
public:
  ~witness() { std::println("abandoned witness must not print"); }
public:
  witness() = default;
};

void body() {
  witness kept{};
  fails_on_cleanup first{};
  int32_t zero = 0;
  int32_t value = 5 / zero;
}

int main() {
  auto started = std::thread::start(body);
  if (!started) { return 1; }
  mut std::thread worker = std::move(started).value();
  [[discard]] worker.join();
  return 0;
}
