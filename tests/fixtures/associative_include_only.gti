import std.map;
import std.unordered_map;

// Concrete signature dependencies must exist even when the generic owner is
// never instantiated. This is deliberately not a pair/map construction test.
struct SignatureValue<T> { T value; };
class UnusedOwner<T> {
public:
  SignatureValue<int> result();
  void accept(SignatureValue<bool> value);
public:
  UnusedOwner() = default;
};

int main() { return 0; }
