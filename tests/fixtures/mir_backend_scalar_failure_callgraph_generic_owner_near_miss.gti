mut int32_t cleanup_bits = 0;
mut int32_t first_close = 0;

class FailureScope {
public:
  int32_t bit;

  FailureScope(int32_t value) : bit(value) {}

  ~FailureScope() {
    cleanup_bits = cleanup_bits | this.bit;
    if (first_close == 0) {
      first_close = this.bit;
    }
  }
};

class CompatibilityOwner<T> {
public:
  T values[1];

  CompatibilityOwner(T value) : values({value}) {}
};

int32_t compatibility_generic_owner(CompatibilityOwner<FailureScope> owner) {
  return 0;
}

int32_t checked_increment(int32_t value) {
  FailureScope scope = FailureScope(1);
  return value + 1;
}

int main() {
  int32_t result = checked_increment(40);
  if (result != 41) {
    return 1;
  }
  return 0;
}
