import std.string;
extern "C" {
  uint64_t recursion_input();
  int32_t recursion_depth();
}
class Audit {
public:
  Audit() {}
  ~Audit() { std::println(99); }
};
uint64_t bounded_tree(int32_t depth, uint64_t value) {
  if (depth == 0) { return value % uint64_t(251); }
  return bounded_tree(depth - 1, (value * uint64_t(17) + uint64_t(3)) % uint64_t(1000003)) +
         bounded_tree(depth - 1, (value * uint64_t(13) + uint64_t(7)) % uint64_t(1000003));
}
int main() {
  Audit audit{};
  std::println(bounded_tree(recursion_depth(), recursion_input()));
  return 0;
}
