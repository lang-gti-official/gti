// Unique and shared owners hold mutex-bearing values in their allocation;
// the mutex keeps its native identity there and is destroyed with the owner.
import std.memory;
import std.resource;
import std.mutex;
// An ordinary application supplies the raw allocation's cleanup policy.
class RawLease {
  mut std::process_resource process;
  mut std::raw_allocation allocation;
public:
  RawLease() : process(std::process_resource()), allocation(std::raw_allocation()) {}
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) mut {
    unsafe { return this.process.allocate(request); }
  }
  unsafe void attach(std::raw_allocation value) mut { this.allocation = value; }
  ~RawLease() { unsafe { this.process.release(this.allocation); } }
};
class Account {
public:
  mut std::mutex<int32_t> balance;
  int32_t id;
  Account(int32_t id, int32_t start) : balance(std::mutex<int32_t>(start)), id(id) {}
};
int32_t deposit(Account& account, int32_t amount) {
  mut auto guard = account.balance.lock();
  mut int32_t& value = guard.get();
  value += amount;
  return value;
}
// Independent raw-lifetime client: no shared-owner policy or intrinsic.
int raw_lifetime() {
  mut RawLease lease{};
  unsafe {
    auto result = lease.allocate(std::layout_of<Account>());
    if (!result) { return 5; }
    auto region = result.value();
    lease.attach(region);
    Account* object = std::typed_address<Account>(region.address);
    std::construct_at(object, int32_t(3), int32_t(30));
    mut int32_t observed = 0;
    {
      Account& account = std::assume_ref(object, lease);
      observed = deposit(account, 2);
    }
    std::destroy_at(object);
    return observed == 32 ? 0 : 6;
  }
}
int main() {
  if (raw_lifetime() != 0) { return 5; }
  auto shared = std::make_shared<Account>(1, 10);
  auto other = shared.clone();
  if (deposit(*other, 5) != 15) { return 1; }
  if (shared.use_count() != std::size_t(2)) { return 2; }
  auto unique = std::make_unique<Account>(2, 20);
  if (deposit(*unique, 1) != 21 || deposit(*shared, 1) != 16) { return 3; }
  auto counter = std::make_shared<std::mutex<int32_t>>(0);
  {
    mut auto guard = counter->lock();
    mut int32_t& value = guard.get();
    value += 3;
  }
  auto guard = counter->lock();
  return guard.get() == 3 ? 0 : 4;
}
