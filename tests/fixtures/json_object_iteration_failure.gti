#include <std/json>
#include <std/string>
#include <std/vector>
#include <std/span>
#include <std/paired_span>

class IterationDrop {
  int id;
public:
  IterationDrop(int id) : id(id) {}
  ~IterationDrop() { std::println(this.id); }
};

int main(int argc, std::vector<std::string> argv) {
  IterationDrop outer{10};
  mut auto wrong = std::json::value::boolean(false);
  mut auto empty = std::json::value::object();
  IterationDrop inner{20};
  if (argc == 1) { auto keys = wrong.keys(); }
  else if (argc == 2) { auto values = wrong.values(); }
  else if (argc == 3) { auto values = wrong.values_mut(); }
  else if (argc == 4) { auto members = wrong.members(); }
  else if (argc == 5) { auto keys = empty.keys(); auto& key = keys.front(); }
  else if (argc == 6) { auto values = empty.values(); auto& item = values.front(); }
  else { auto members = empty.members(); auto cursor = members.begin(); auto& entry = *cursor; }
  return 99;
}
