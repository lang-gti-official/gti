#include <std/meta>

namespace tags {
[[attribute]] struct key { std::string_view name = ""; };
}

struct Player {
  [[tags::key("hp")]]
  uint32_t health = 100;
  bool alive = true;
};

enum class color { red = 1, green = 2 };

enum class fail { nope };
class QueryBase { public: virtual int read() { return 1; } };
class QueryLeaf : public QueryBase {};
class QueryCleanup { public: ~QueryCleanup() {} };
struct fixed_producer {
  expected<std::meta::field_type<T, I>, fail> produce<T, uint64_t I>(std::meta::field<T, I> field) mut {
    if constexpr (std::meta::type_of<std::meta::field_type<T, I>>().is_bool()) {
      return false;
    } else {
      return std::meta::field_type<T, I>(5);
    }
  }
};

int main() {
  static_assert(std::meta::has_active_cleanup<QueryCleanup>());
  static_assert(!std::meta::type<QueryLeaf>().has_active_cleanup());
  static_assert(std::meta::is_polymorphic<QueryBase>());
  static_assert(std::meta::type<QueryLeaf>().is_polymorphic());
  static_assert(std::meta::is_public_base_of<QueryBase, QueryLeaf>());
  static_assert(std::meta::type<QueryLeaf>().has_public_base<QueryBase>());
  Player player = {.health = uint32_t(7), .alive = false};
  mut uint64_t checksum = 0;
  constexpr for (auto field : std::meta::fields_of<Player>()) {
    checksum = checksum + field.index() + field.name().size();
    if constexpr (field.type().is_integral()) {
      checksum = checksum + uint64_t(field.get(player));
    }
    if (!field.is_public()) { return 1; }
  }
  if (checksum != uint64_t(19)) { return 2; }
  if (std::meta::name_of<Player>() != "Player") { return 3; }
  if (!std::meta::is_struct<Player>() || std::meta::is_class<Player>()) { return 4; }
  if (!std::meta::is_integral<uint32_t>() || !std::meta::is_bool<bool>() ||
      !std::meta::is_floating_point<double>() || !std::meta::is_text<std::string_view>()) {
    return 5;
  }
  if (std::meta::type_of<Player>().field_count() != uint64_t(2)) { return 6; }
  mut uint64_t tagged = 0;
  constexpr for (auto field : std::meta::fields_of<Player>()) {
    if constexpr (field.has_attribute<tags::key>()) {
      if (field.attribute<tags::key>().name != "hp") { return 7; }
      tagged = tagged + 1;
    }
  }
  if (tagged != 1 || std::meta::type_of<color>().enumerator_count() != uint64_t(2)) { return 8; }
  mut fixed_producer source{};
  mut auto built = std::meta::construct<Player, fail, fixed_producer>(source);
  if (!built) { return 9; }
  Player made = std::move(built).value();
  if (made.health != 5 || made.alive) { return 10; }
  if (std::meta::type_of<Player>().method_count() != uint64_t(0) || std::meta::type_of<Player>().line() == uint64_t(0)) { return 11; }
  if (std::meta::primary_name_of<Player>() != "Player" || std::meta::type_of<Player>().primary_name() != "Player") { return 12; }
  return 0;
}
