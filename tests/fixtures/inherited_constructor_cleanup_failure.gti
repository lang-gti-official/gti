#include <std/memory>
#include <std/string>

// A constructor's primary failure must survive a second failure while cleaning
// its completed base: status 70 and GTI-R0014 must name both division sites.
mut int32_t zero = 0;

class Resource {
public:
  Resource() {}
  ~Resource() {
    std::println("base-cleanup");
    int32_t secondary = 11 / zero;
  }
};

class Base {
  std::unique_ptr<Resource> resource;
public:
  Base() : resource(std::make_unique<Resource>()) {}
  virtual int32_t read() = 0;
};

class Derived : public Base {
  int32_t checked;
public:
  Derived() : Base(), checked(7 / zero) {}
  int32_t read() override { return this.checked; }
};

int main() {
  auto owner = std::make_unique<Derived>();
  return owner->read();
}
