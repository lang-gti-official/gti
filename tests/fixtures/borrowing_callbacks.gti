int observe<F>(F& callback) { return callback(); }
void modify<F>(mut F& callback, int amount) { callback(amount); }

struct State {
  mut int selected = 3;
  int size = 8;
public:
  State() = default;
};

int main() {
  int initial = 12;
  auto read = [&initial]() -> int { return initial; };
  if (read() != 12) return 1;
  if (observe(read) != 12) return 2;

  mut int count = 0;
  mut auto increment = [mut &count](int step) -> void { count += step; };
  increment(3);
  modify(increment, 4);
  if (count != 7) return 3;

  mut State state{};
  mut int& selected = state.selected;
  int& size = state.size;
  mut auto clamp = [mut &selected, &size]() -> void {
    selected = size - 1;
  };
  clamp();
  if (state.selected != 7) return 4;

  int right = 9;
  int left = 4;
  auto difference = [&right, &left]() -> int { return right - left; };
  if (difference() != 5) return 5;
  return 0;
}
