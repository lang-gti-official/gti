import std.string;
import std.vector;
import std.memory;

class Token {
public:
  int value;
  Token(int initial) : value(initial) {}
  Token(Token& other) = delete;
  Token(Token&& other) = default;
  ~Token() { std::println(this.value); }
};

enum Event { None, Key(int code) };

struct Box {
  Event event;
  Box(Event value) : event(value) {}
  ~Box() {
    switch (this.event) {
      case Event::None: std::println(0); break;
      case Event::Key(code): std::println(code); break;
    }
  }
};

void relay<Args...>(int divisor, Args... args) {
  auto owner = std::make_unique<Box>(args...);
  int result = 1 / divisor;
}

int main(int argc, std::vector<std::string> argv) {
  relay(1, Event::None);
  Token caller = Token(9);
  relay(argc == 1 ? 1 : 0, Event::Key(1));
  return 0;
}
