import std.memory;

mut int trace = 0;
class Ticket {
public:
  int id;
  Ticket(int id) : id(id) { trace = trace * 10 + id; }
  ~Ticket() { trace = trace * 10 + this.id; }
};

int main() {
  mut std::uninitialized<Ticket> source{};
  mut std::uninitialized<Ticket> destination{};
  unsafe {
    // The public construction API transfers a completed value into storage;
    // relocation and destruction must preserve its exact lifetime trace.
    std::construct_at<Ticket>(source.data(), Ticket(3));
    std::relocate_at(destination.data(), source.data());
    if (trace != 3 || (*destination.data()).id != 3) { return 1; }
    std::destroy_at(destination.data());
    if (trace != 33) { return 2; }
    std::construct_at<Ticket>(source.data(), Ticket(4));
    std::destroy_at(source.data());
  }
  return trace == 3344 ? 0 : 3;
}
