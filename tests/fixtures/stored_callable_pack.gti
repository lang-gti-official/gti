import std.string;
import std.vector;

class Token {
  int identity;
  int cleanup_divisor;
public:
  Token(int identity, int cleanup_divisor)
      : identity(identity), cleanup_divisor(cleanup_divisor) {}
  ~Token() {
    std::println(this.identity);
    int result = 1 / this.cleanup_divisor;
  }
  int read() { return this.identity; }
};

void accept<Args...>(int divisor, Args... args) {
  int checked = 1 / divisor;
}

void relay<Args...>(int divisor, Args... args) {
  accept(divisor, args...);
}

int main(int argc, std::vector<std::string> argv) {
  // The same generic declarations must keep distinct MIR bodies for empty,
  // single-closure, mixed passive, and owned-capture argument packs.
  relay(1);
  int offset = 7;
  auto single = [offset]() -> int { return offset; };
  relay(1, std::move(single));
  auto passive_left = [offset]() -> int { return offset; };
  auto passive_right = [offset]() -> int { return offset; };
  relay(1, std::move(passive_left), 7, std::move(passive_right));
  Token caller{9, 1};
  Token first{1, argc == 5 ? 0 : 1};
  Token second{2, argc == 2 || argc == 4 || argc == 5 ? 0 : 1};
  auto left = [first = std::move(first)]() -> int { return first.read(); };
  auto right = [second = std::move(second)]() -> int { return second.read(); };
  relay(argc == 3 || argc == 4 ? 0 : 1, std::move(left), 7, std::move(right));
  return 0;
}
