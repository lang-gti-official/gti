import std.mutex;

extern "C" {
  void gti_test_active_begin();
  void gti_test_record_payload(int32_t value);
  int32_t gti_test_active_payload_value(int32_t field);
}

class Payload {
  int32_t value;
public:
  Payload(int32_t value) : value(value) {}
  Payload(Payload& other) = delete;
  Payload(Payload&& other) = default;
  ~Payload() {
    gti_test_record_payload(this.value);
    int32_t checked = 12 / this.value;
  }
};

class Cell {
  std::mutex<Payload> first;
  std::mutex<Payload> last;
public:
  Cell() : first(std::mutex<Payload>(Payload(gti_test_active_payload_value(1)))),
           last(std::mutex<Payload>(Payload(gti_test_active_payload_value(2)))) {}
};

enum NestedPayload { empty, owned(std::mutex<Payload> value) };

int main() {
  gti_test_active_begin();
  Cell value{};
  std::mutex<NestedPayload> nested{NestedPayload::owned(
      std::mutex<Payload>(Payload(gti_test_active_payload_value(3))))};
  return 0;
}
