#include <std/paired_span>
#include <std/vector>
#include <std/string>
#include <std/iterator>
#include <std/algorithm>

extern "C" {
  void adoption_count_begin();
  void adoption_count_end();
  uint64_t adoption_allocations();
}

void require_random<I>(I cursor) requires std::random_access_iterator<I> {}

class PairCounter {
  mut int total = 0;
public:
  void operator()(std::paired_span<int, std::string>::value_type& entry) mut {
    this.total += entry.first();
  }
  int result() { return this.total; }
};

int main() {
  std::vector<int> keys = {10, 20, 30};
  std::vector<std::string> labels = {std::string("one"), std::string("two")};
  auto pairs = std::paired_span<int, std::string>(keys.as_span(), labels.as_span());
  adoption_count_begin();
  require_random(pairs.begin());
  mut int total = 0;
  for (auto& entry : pairs) {
    total += entry.first();
    if (entry.second().empty()) { return 1; }
  }
  if (total != 30) { return 2; }
  auto counter = std::for_each(pairs.begin(), pairs.end(), PairCounter());
  if (counter.result() != 30) { return 13; }
  mut auto first = pairs.begin();
  auto copy = first;
  first += std::ptrdiff_t(2);
  if (first != pairs.end()) { return 3; }
  --first;
  if ((*first).first() != 20 || (*first).second() != "two" || (*copy).first() != 10) { return 4; }
  first -= std::ptrdiff_t(1);
  if (first - pairs.end() != std::ptrdiff_t(2)) { return 5; }
  auto tail = pairs.subspan(std::size_t(1), std::size_t(1));
  mut auto last = tail.end_iterator();
  --last;
  if ((*last).first() != 20) { return 6; }
  require_random(pairs.rbegin());
  mut auto reverse = pairs.crbegin();
  auto reverse_copy = reverse;
  if ((*reverse).first() != 20 || (*reverse).second() != "two" || reverse - pairs.crend() != std::ptrdiff_t(2)) { return 10; }
  ++reverse;
  if ((*reverse).first() != 10 || (*reverse_copy).first() != 20) { return 11; }
  reverse -= std::ptrdiff_t(1);
  if ((*reverse).first() != 20) { return 12; }
  std::vector<int> empty_keys{};
  auto empty = std::paired_span<int, std::string>(empty_keys.as_span(), labels.as_span());
  if (empty.begin() != empty.end()) { return 7; }
  for (auto& entry : empty) { return 8; }
  adoption_count_end();
  if (adoption_allocations() != uint64_t(0)) { return 9; }
  return 0;
}
