#include <std/memory>
#include <std/vector>

// A mutable owner selects the read-only `operator->` and `operator*` steps
// for read-only bindings, so two read-only references through the same
// mutable smart pointer coexist, as two read-only accessor results do.
class Dir {
public:
  mut std::vector<int32_t> items = std::vector<int32_t>();
  Dir() = default;
};

int main() {
  mut std::unique_ptr<Dir> root = std::make_unique<Dir>();
  root->items.push_back(1);
  std::vector<int32_t>& viewed = root->items;
  std::vector<int32_t>& starred = (*root).items;
  return viewed.size() + starred.size() == std::size_t(2) ? 0 : 1;
}
