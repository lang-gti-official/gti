import std.string;
import std.vector;

class Token {
public:
  int value;
  int divisor;
  Token(int initial, int cleanup_divisor) : value(initial), divisor(cleanup_divisor) {}
  ~Token() {
    std::println(this.value);
    int result = 1 / this.divisor;
  }
};

void ignore<Args...>(int divisor, Args... args) {
  int result = 1 / divisor;
}

void relay<Args...>(int divisor, Args... args) {
  ignore(divisor, args...);
}

int main(int argc, std::vector<std::string> argv) {
  relay(1);
  relay(1, Token(3, 1));
  relay(1, std::string("owned pack text"), Token(4, 1));
  int body_divisor = argc < 3 ? 1 : 0;
  int cleanup_divisor = argc == 2 || argc == 4 ? 0 : 1;
  Token caller = Token(9, 1);
  relay(body_divisor, Token(1, cleanup_divisor), Token(2, 1));
  return 0;
}
