extern "C" {
  int native_bridge(int input, const int* slot);
  int native_cleanup(int input, const int* slot);
}
struct Marker {
  mut int& slot;
  int input;
  bool foreign;
  Marker(int value, mut int& target, bool invoke_foreign)
      : slot(target), input(value), foreign(invoke_foreign) {}
  ~Marker() {
    if (slot == 0) { slot = 1; }
    else { slot = 2; }
    if (foreign) { unsafe { int result = native_cleanup(input, &slot); } }
    if (input == 2) { int secondary = input + 1; }
  }
};
int leaf(int input, mut int& slot) {
  Marker marker{input, slot, false};
  unsafe { return native_bridge(input, &marker.slot) + 1; }
}
int middle(int input, mut int& leaf_slot, mut int& middle_slot) {
  Marker marker{input, middle_slot, true};
  return leaf(input, leaf_slot);
}
int sample(int input, mut int& leaf_slot, mut int& middle_slot, mut int& outer_slot) {
  Marker marker{input, outer_slot, false};
  return middle(input, leaf_slot, middle_slot);
}
