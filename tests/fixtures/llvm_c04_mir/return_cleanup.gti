struct Marker {
  mut int& slot;
  Marker(mut int& target) : slot(target) {}
  ~Marker() {
    if (slot == 0) { slot = 1; }
    else { slot = 2; }
  }
};

struct Gate {
  int input;
  Gate(int value) : input(value) {}
  ~Gate() {
    if (input == 2147483647) {
      int overflow = input + 1;
    }
  }
};

Marker make(int input, mut int& result_slot) {
  Gate local{input};
  return Marker(result_slot);
}

int sample(int input, mut int& first, mut int& second, mut int& outer) {
  Marker local{outer};
  Marker middle{second};
  Marker result = make(input, first);
  return input + 1;
}
