#include <std/functional>

struct Marker {
  mut int& slot;
  Marker(mut int& target) : slot(target) {}
  ~Marker() { if (slot == 0) { slot = 1; } else { slot = 2; } }
};

int left(int input, mut int& slot) {
  Marker marker{slot};
  return input + 1;
}
int right(int input, mut int& slot) {
  Marker marker{slot};
  return 1 + input;
}
int middle(int input, mut int& leaf_slot, mut int& middle_slot) {
  Marker marker{middle_slot};
  mut std::function_ptr<int(int, mut int&)> selected{left};
  std::function_ptr<int(int, mut int&)> alternative{right};
  if (input % 2 != 0) {
    selected = alternative;
  }
  return selected(input, leaf_slot);
}
int sample(int input, mut int& leaf_slot, mut int& middle_slot, mut int& outer_slot) {
  Marker marker{outer_slot};
  return middle(input, leaf_slot, middle_slot);
}
