#include <std/string>

namespace application {
using Item = int;
struct Shadowing {
  Item item{};
  struct Item { int value = 9;  public: Item() = default; };
public:
  Shadowing() = default;
};
class Aliases {
  struct Secret { int value = 11;  public: Secret() = default; };
public:
  using Public = Secret;
public:
  Aliases() = default;
};
struct Standalone { struct Child { int value = 13;  public: Child() = default; };  public: Standalone() = default; };
using Alias = Standalone;
struct Ordering {
  struct First {
    Later value{};
   public: First() = default; };
  struct Later { int value = 17;  public: Later() = default; };
public:
  Ordering() = default;
};
struct Inheritance {
  struct Derived : public Base { Derived() : Base() {} };
  struct Base { int value; Base() : value(23) {} };
public:
  Inheritance() = default;
};
struct Graph {
  struct A { B* next = nullptr;  public: A() = default; };
  struct B { A* next = nullptr;  public: B() = default; };
public:
  Graph() = default;
};
struct CrossA {
  struct Child { CrossB::Child* peer = nullptr;  public: Child() = default; };
  Child child{};
public:
  CrossA() = default;
};
struct CrossB {
  struct Child { CrossA::Child* peer = nullptr;  public: Child() = default; };
  Child child{};
public:
  CrossB() = default;
};
[[no_transfer, no_share]] struct Policies {
  struct Value { int value = 29;  public: Value() = default; };
public:
  Policies() = default;
};
T transfer_value<std::transferable T>(T value) { return value; }
void share_value<std::shareable T>(T& value) {}
struct Borrowing {
  class Value {
    std::string text;
    int number = 31;
  public:
    Value(std::string input) : text(std::move(input)) {}
    [[borrowed_from(this)]] int& code() { return number; }
    uint64_t length() { return text.size(); }
  };
public:
  Borrowing() = default;
};
class LexicalAccess {
  using count = int;
  static int code = 37;
  int number;
  LexicalAccess(int value) : number(value) {}
  LexicalAccess() : number(37) {}
  int get() { return number; }
public:
  struct Child {
    count read() {
      LexicalAccess value{code};
      return value.number + value.get() - code;
    }
    int default_value() { LexicalAccess value{}; return value.get(); }
    struct Grandchild { int read() { return LexicalAccess::code; }  public: Grandchild() = default; };
   public: Child() = default; };
  struct GenericChild<T> {
    using value_type = T;
    int read() { return code; }
   public: GenericChild() = default; };
};
class NestedBase {
  int value;
  NestedBase(int input) : value(input) {}
public:
  struct Child : public NestedBase {
    Child() : NestedBase(41) {}
    int read() { return value; }
  };
};
struct Config {
  struct Network {
    int port = 8080;
    struct Retry {
      int count = 3;
     public: Retry() = default; };
    Retry retry{};
   public: Network() = default; };

  class Logging {
    int level;
  public:
    Logging(int value) : level(value) {}
    int verbosity() { return level; }
  };

  struct Box<T> {
    T value;
  };

  using NetworkType = Network;
  Network network{};
  Logging logging{2};
public:
  Config() = default;
};

class Service {
  struct Secret {
    int value = 7;
   public: Secret() = default; };
public:
  int secret_value() {
    Secret secret{};
    return secret.value;
  }
public:
  Service() = default;
};
}

application::Ordering::Later global{};

int main() {
  application::Config config{};
  application::Config::Network network{};
  application::Config::Network::Retry retry{};
  application::Config::NetworkType alias{};
  application::Config::Box<int> box{.value = 5};
  application::Service service{};
  application::Shadowing shadow{};
  application::Aliases::Public exposed{};
  application::Alias::Child standalone{};
  application::Ordering::First ordered{};
  application::Inheritance::Derived derived{};
  application::Graph::A graph{};
  application::CrossA cross_a{};
  application::CrossB cross_b{};
  application::Policies::Value policy = application::transfer_value(application::Policies::Value());
  application::share_value(policy);
  application::Borrowing::Value source = application::Borrowing::Value(std::string("nested"));
  {
    int& borrowed = source.code();
    if (borrowed != 31) { return 2; }
  }
  application::Borrowing::Value moved = std::move(source);
  application::LexicalAccess::Child lexical{};
  application::LexicalAccess::Child::Grandchild grandchild{};
  application::LexicalAccess::GenericChild<int> generic_child{};
  application::LexicalAccess::GenericChild<int>::value_type alias_value = 3;
  application::NestedBase::Child inherited_receiver{};
  if (config.network.port != 8080 || network.retry.count != 3 ||
      retry.count != 3 || alias.port != 8080 ||
      config.logging.verbosity() != 2 || box.value != 5 ||
      service.secret_value() != 7 || shadow.item.value != 9 ||
      exposed.value != 11 || standalone.value != 13 ||
      ordered.value.value != 17 || global.value != 17 ||
      derived.value != 23 || graph.next != nullptr || policy.value != 29 ||
      moved.length() != 6 || cross_a.child.peer != nullptr ||
      cross_b.child.peer != nullptr || lexical.read() != 37 ||
      lexical.default_value() != 37 || grandchild.read() != 37 ||
      generic_child.read() != 37 || alias_value != 3 ||
      inherited_receiver.read() != 41) {
    return 1;
  }
  std::println("nested types");
  return 0;
}
