class thing {
public:
  thing() {}
  mut int32_t value = 0;
};

mut thing g = thing();
mut int32_t table[4] = {};

int32_t read_global() {
  return g.value;
}

void write_global(int32_t value) {
  g.value = value;
}

int main() {
  if (read_global() != 0) {
    return 1;
  }
  write_global(int32_t(37));
  if (read_global() != 37) {
    return 2;
  }
  table[std::size_t(1)] = 11;
  return table[std::size_t(1)] == 11 ? 0 : 3;
}
