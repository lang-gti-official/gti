import std.string;
import std.vector;
import std.memory;

class Token {
public:
  mut int id;
  Token(int value) : id(value) {}
  Token(Token& other) = delete;
  Token(Token&& other) = default;
  ~Token() { std::println(this.id); }
};
enum Event<T> { Empty, Owned(T value) };

int id(Event<Token>& event) {
  switch (event) {
    case Event<Token>::Empty: return 0;
    case Event<Token>::Owned(auto& token): return token.id;
  }
}
Event<Token> produce(int id, int divisor) {
  Token token = Token(id);
  int guard = 1 / divisor;
  return Event<Token>::Owned(std::move(token));
}
struct Holder {
  Event<Token>[2] values;
  int guard;
  Holder(int divisor)
      : values({Event<Token>::Owned(Token(1)), Event<Token>::Owned(Token(2))}),
        guard(1 / divisor) {}
  ~Holder() { std::println(8); }
};

int main(int argc, std::vector<std::string> argv) {
  Token outer = Token(9);
  if (argc <= 3) {
    Event<Token> values[3] = {
        Event<Token>::Owned(Token(1)), Event<Token>::Empty,
        produce(2, argc == 2 ? 0 : 1)};
    if (id(values[0]) != 1 || id(values[1]) != 0 || id(values[2]) != 2) return 1;
    int guard = 1 / (argc == 3 ? 0 : 1);
  } else if (argc == 4) {
    Event<Token> grid[2][2] = {
        {Event<Token>::Owned(Token(1)), Event<Token>::Empty},
        {Event<Token>::Owned(Token(2)), Event<Token>::Owned(Token(3))}};
    if (id(grid[argc - 4][0]) != 1 || id(grid[1][1]) != 3) return 2;
  } else if (argc == 5) {
    auto source = Event<Token>::Owned(Token(1));
    mut Event<Token> values[2] = {std::move(source), Event<Token>::Owned(Token(2))};
    auto extracted = std::move(values[0]);
    if (id(extracted) != 1 || id(values[1]) != 2) return 3;
  } else if (argc == 6) {
    mut Event<Token> values[2] = {Event<Token>::Owned(Token(1)), Event<Token>::Owned(Token(2))};
    values[0] = Event<Token>::Owned(Token(3));
    if (id(values[0]) != 3) return 4;
  } else if (argc <= 8) {
    Holder holder = Holder(argc == 8 ? 0 : 1);
    if (id(holder.values[0]) != 1 || id(holder.values[1]) != 2) return 5;
  } else if (argc <= 10) {
    Event<Token> values[2] = {Event<Token>::Owned(Token(1)), Event<Token>::Owned(Token(2))};
    if (id(values[argc - 8]) != 2) return 6;
  } else if (argc == 11) {
    Event<Token> values[2] = {Event<Token>::Owned(Token(1)), Event<Token>::Owned(Token(2))};
    auto moved = std::move(values);
    if (id(moved[0]) != 1 || id(moved[1]) != 2) return 7;
  } else if (argc == 12) {
    mut Event<Token> values[2] = {Event<Token>::Owned(Token(1)), Event<Token>::Owned(Token(2))};
    values[0] = produce(3, 0);
  } else {
    mut Event<Token> values[2] = {Event<Token>::Owned(Token(1)), Event<Token>::Owned(Token(2))};
    auto received = std::move(values[0]);
    values[0] = Event<Token>::Owned(Token(3));
    if (id(received) != 1 || id(values[0]) != 3) return 8;
  }
  return 0;
}
