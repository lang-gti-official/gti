#include <std/mutex>

int main() {
  std::mutex<int32_t> value{1};
  {
    std::mutex_guard<int32_t> guard = value.lock();
    mut std::mutex_guard<int32_t> moved = std::move(guard);
    mut int32_t& current = moved.get();
    current = current + 1;
  }
  std::mutex_guard<int32_t> guard = value.lock();
  return guard.get() == 2 ? 0 : 1;
}
