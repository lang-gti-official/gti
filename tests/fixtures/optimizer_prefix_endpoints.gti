import std.memory;
import std.vector;
import std.string;
import std.atomic;

class Audit { public: Audit() {} ~Audit() { std::println(99); } };

// An application-owned carrier: its public identity supplies no compiler rule.
class Parcel {
  mut std::detail::prefix_owner<int32_t> slots;
public:
  Parcel(uint64_t capacity) : slots(std::detail::prefix_owner<int32_t>(capacity)) {}
  void append(int32_t value) mut { this.slots.append_value(value); }
  void send(mut Parcel& target) mut { this.slots.relocate_to(target.slots); }
  void grow(uint64_t capacity) mut {
    mut std::detail::prefix_owner<int32_t> replacement{capacity};
    this.slots.relocate_to(replacement);
    this.slots = std::move(replacement);
  }
  uint64_t size() { return this.slots.length(); }
  int32_t read(uint64_t index) { return this.slots.read(index); }
  int32_t& borrow(uint64_t index) { return this.slots.read(index); }
  void overwrite(int32_t value) mut { this.slots.read_mut(uint64_t(0)) = value; }
};

uint64_t fresh_endpoint_positive() {
  Audit audit{};
  mut Parcel source{uint64_t(4)};
  mut Parcel destination{uint64_t(8)};
  source.send(destination);
  return destination.size() * uint64_t(2);
}
uint64_t grown_endpoint_positive() {
  Audit audit{};
  mut Parcel value{uint64_t(4)};
  value.append(int32_t(9));
  value.grow(uint64_t(8));
  return value.size() * uint64_t(2);
}
int32_t grown_value_control() {
  Audit audit{};
  mut Parcel value{uint64_t(4)};
  value.append(int32_t(2147483647));
  value.grow(uint64_t(8));
  return value.borrow(uint64_t(0)) * int32_t(2);
}
uint64_t reserved_endpoint_positive() {
  Audit audit{};
  mut std::vector<int32_t> values{};
  values.reserve(uint64_t(8));
  return values.size() * uint64_t(18446744073709551615);
}
class UnprovenEndpoint {
  mut uint64_t value = uint64_t(9);
public:
  UnprovenEndpoint() {}
  void raw_change() mut {
    unsafe { uint64_t* pointer = &this.value; *pointer = uint64_t(18446744073709551615); }
  }
  void conditional_change(bool change) mut { if (change) { this.raw_change(); } }
  uint64_t read() { return this.value; }
};
uint64_t opaque_postcondition_negative() {
  Audit audit{};
  mut UnprovenEndpoint value{};
  value.raw_change();
  return value.read() * uint64_t(2);
}
uint64_t conditional_postcondition_negative(bool change) {
  Audit audit{};
  mut UnprovenEndpoint value{};
  value.conditional_change(change);
  return value.read() * uint64_t(2);
}
mut int32_t cleanup_count = 0;
class Counted {
public:
  Counted() {}
  Counted(Counted& other) = delete;
  Counted(Counted&& other) = default;
  ~Counted() { cleanup_count++; }
};
int32_t moved_cleanup_positive() {
  cleanup_count = 0;
  { mut Counted source{}; { mut Counted target = std::move(source); } }
  return cleanup_count;
}
int32_t conditional_cleanup(bool move_source) {
  cleanup_count = 0;
  { mut Counted source{};
    if (move_source) { mut Counted target = std::move(source); }
  }
  return cleanup_count;
}
int32_t reinitialized_cleanup() {
  cleanup_count = 0;
  { mut Counted source{};
    { mut Counted target = std::move(source); source = Counted(); }
  }
  return cleanup_count;
}
int main(int argc, std::vector<std::string> argv) {
  if (argc == 1) { return fresh_endpoint_positive() == uint64_t(0) ? 0 : 1; }
  if (argc == 2) { return grown_endpoint_positive() == uint64_t(2) ? 0 : 1; }
  if (argc == 3) { return grown_value_control(); }
  if (argc == 8) { return reserved_endpoint_positive() == uint64_t(0) ? 0 : 1; }
  if (argc == 9) { return opaque_postcondition_negative() == uint64_t(18) ? 0 : 1; }
  if (argc == 10 || argc == 11) { return conditional_postcondition_negative(argc == 11) == uint64_t(18) ? 0 : 1; }
  Audit audit{};
  if (argc == 4) { return moved_cleanup_positive() == int32_t(1) ? 0 : 1; }
  if (argc == 5) { return conditional_cleanup(true) == int32_t(1) ? 0 : 1; }
  if (argc == 6) { return conditional_cleanup(false) == int32_t(1) ? 0 : 1; }
  return reinitialized_cleanup() == int32_t(2) ? 0 : 1;
}
