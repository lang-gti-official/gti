import std.string;
import std.utility;
import std.vector;

// Moving a cleanup-free expected<T, E> into a new binding. The move
// constructs the binding from its source: no intermediate value-initializes
// a success payload the program never constructs, which a class without a
// default constructor does not even have.
struct point {
  mut int32_t x;
  mut int32_t y;
};

class token {
  int32_t id;
public:
  token(int32_t id) : id(id) {}
  int32_t value() { return this.id; }
};

// This payload has a default constructor; its move takes the same route.
struct sized {
  mut int32_t width = 1;
  mut int32_t height = 2;
public:
  sized() = default;
};

expected<point, int32_t> make_point(int32_t x) {
  point made = {.x = x, .y = x + 1};
  return made;
}

expected<point, int32_t> missing_point(int32_t code) {
  return unexpected(code);
}

expected<token, int32_t> make_token(int32_t id) { return token(id); }

expected<sized, int32_t> make_sized(int32_t width) {
  sized made = {.width = width};
  return made;
}

int32_t next(int32_t value) { return value + 1; }

int main(int argc, std::vector<std::string> argv) {
  mut auto first = make_point(3);
  auto moved = std::move(first);
  std::println(moved.value().x + moved.value().y);
  first = make_point(10);
  auto again = std::move(first);
  std::println(again.value().y);

  auto failed = missing_point(4);
  auto moved_failure = std::move(failed);
  std::println(moved_failure.error());

  mut int32_t total = 0;
  for (mut int32_t i = 1; i < 4; i++) {
    auto item = make_token(i);
    auto taken = std::move(item);
    total += taken.value().value();
  }
  std::println(total);

  auto made = make_sized(5);
  auto resized = std::move(made);
  std::println(resized.value().width + resized.value().height);

  // A failure while every moved binding is still live.
  if (argc == 2) {
    std::println(next(2147483645 + argc));
  }
  return 0;
}
