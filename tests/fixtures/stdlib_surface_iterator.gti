#include <std/iterator>
#include <std/vector>

class audit_iterator {
  mut std::size_t index;
  mut int32_t values[4] = {1, 2, 3, 4};

public:
  audit_iterator(std::size_t initial) : index(initial) {}

  int32_t& operator*() {
    return this.values[this.index];
  }

  void operator++() mut {
    this.index++;
  }

  bool operator!=(audit_iterator& other) {
    return this.index != other.index;
  }
};

int main() {
  mut audit_iterator unsigned_advance = audit_iterator(std::size_t(0));
  std::advance(unsigned_advance, std::size_t(3));
  if (*unsigned_advance != 4 ||
      std::distance(audit_iterator(std::size_t(0)),
                    audit_iterator(std::size_t(4))) != 4) {
    return 1;
  }

  mut audit_iterator next_one =
      std::next(audit_iterator(std::size_t(0)));
  mut audit_iterator next_unsigned = std::next(
      audit_iterator(std::size_t(0)), std::size_t(3));
  if (*next_one != 2 || *next_unsigned != 4) {
    return 2;
  }

  mut std::vector<int32_t> values =
      std::vector<int32_t>({10, 20, 30, 40});
  mut auto owner_tied_begin = values.begin();
  std::size_t owner_tied_distance = std::size_t(2);
  mut auto owner_tied_next =
      std::next(std::move(owner_tied_begin), owner_tied_distance);
  if (*owner_tied_next != 30 ||
      std::distance(values.begin(), values.end()) != 4) {
    return 3;
  }
  return 0;
}
