#include <std/string>
#include <std/vector>

enum class item_error { unavailable };
class Item {
public:
  Item() {}
  Item(Item& other) = delete;
  Item(Item&& other) = default;
  ~Item() { std::println("item cleaned"); }
};
class Guard {
public:
  ~Guard() { std::println("caller cleaned"); }
public:
  Guard() = default;
};
expected<Item, item_error> produce() { return Item(); }
int checked(int index) { return 12 / (2 - index); }
void consume(Item value, int number) {}
class Sink {
public:
  void accept(Item value, int number) mut {}
public:
  Sink() = default;
};
expected<void, item_error> run(bool member) {
  mut Sink sink = Sink();
  for (mut int index = 0; index < 4; index++) {
    if (member) { sink.accept(?produce(), checked(index)); }
    else { consume(?produce(), checked(index)); }
  }
  return;
}
int main(int argc, std::vector<std::string> arguments) {
  Guard guard = Guard();
  auto result = run(argc > 1);
  return result.has_value() ? 0 : 1;
}
