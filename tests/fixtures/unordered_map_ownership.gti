import std.unordered_map;
import std.memory;
import std.string;

mut int constructions = 0;
mut int destructions = 0;

class Payload {
  int value;
public:
  Payload(int value) : value(value) { constructions++; }
  Payload(Payload& other) = delete;
  Payload(Payload&& other) = default;
  ~Payload() { destructions++; }
  int read() { return this.value; }
};

mut int page_constructions = 0;
mut int page_destructions = 0;
class PagePayload<uint64_t Padding> {
  uint8_t padding[Padding] = {};
  int value;
public:
  PagePayload(int value) : value(value) { page_constructions++; }
  PagePayload(PagePayload<Padding>& other) = delete;
  PagePayload(PagePayload<Padding>&& other) = default;
  ~PagePayload() { page_destructions++; }
  int read() { return this.value; }
};

// Exercise all page extents, reuse at both sides of page boundaries, stable
// addresses across growth/rehash/owner movement, and exact live-slot cleanup.
bool page_boundaries<uint64_t Padding>() {
  page_constructions = 0;
  page_destructions = 0;
  {
    mut std::unordered_map<int, PagePayload<Padding>> values{};
    values.reserve(std::size_t(17));
    for (mut int key = 0; key < 33; key++) {
      [[discard]] values.try_emplace(key, key);
    }
    int observed = 17;
    const PagePayload<Padding>* address = &values.at(observed);
    for (mut int key = 33; key < 130; key++) {
      [[discard]] values.try_emplace(key, key);
    }
    int removed[5] = {0, 63, 64, 127, 128};
    for (int& key : removed) {
      if (values.erase(key) != 1) { return false; }
    }
    if (page_constructions != 130 || page_destructions != 5) { return false; }
    for (int& key : removed) { [[discard]] values.try_emplace(key, key + 1000); }
    [[discard]] values.try_emplace(observed, -1);
    if (page_constructions != 135 || page_destructions != 5) { return false; }
    values.rehash(std::size_t(521));
    mut auto transferred = std::move(values);
    if (address != &transferred.at(observed)) { return false; }
    mut std::size_t seen = 0;
    for (auto& entry : transferred) {
      mut int expected = entry.first;
      if (expected == 0 || expected == 63 || expected == 64 ||
          expected == 127 || expected == 128) { expected += 1000; }
      if (entry.second.read() != expected) { return false; }
      seen++;
    }
    if (seen != std::size_t(130)) { return false; }
    transferred.clear();
    if (page_destructions != 135 || !transferred.empty()) { return false; }
    [[discard]] transferred.try_emplace(9, 99);
  }
  return page_constructions == 136 && page_destructions == 136;
}

int main() {
  {
    mut std::unordered_map<std::string, std::unique_ptr<int>> owners{};
    [[discard]] owners.insert(std::string("first"), std::make_unique<int>(17));
    [[discard]] owners.insert(std::string("second"), std::make_unique<int>(23));
    std::string first = std::string("first");
    if (*owners.at(first) != 17) { return 1; }
    {
      auto duplicate = owners.insert(std::string("first"), std::make_unique<int>(99));
      if (duplicate.second) { return 2; }
    }
    if (*owners.at(first) != 17) { return 3; }
    {
      auto assigned = owners.insert_or_assign(std::string("first"), std::make_unique<int>(31));
      if (assigned.second) { return 14; }
    }
    if (*owners.at(first) != 31) { return 15; }
    {
      auto inserted = owners.insert_or_assign(std::string("third"), std::make_unique<int>(41));
      if (!inserted.second) { return 16; }
    }
    owners.rehash(std::size_t(50));
    if (*owners.at(first) != 31) { return 4; }
    if (owners.erase(first) != 1) { return 5; }
    mut auto transferred = std::move(owners);
    std::string second = std::string("second");
    if (*transferred.at(second) != 23) { return 6; }
    transferred.clear();
  }
  {
    mut std::unordered_map<int, Payload> values{};
    {
      auto inserted = values.try_emplace(1, 11);
      if (!inserted.second) { return 7; }
    }
    {
      auto duplicate = values.try_emplace(1, 22);
      if (duplicate.second || constructions != 1) { return 8; }
    }
    {
      auto inserted = values.try_emplace(2, 33);
      if (!inserted.second || constructions != 2) { return 9; }
    }
    int key = 1;
    if (values.at(key).read() != 11) { return 10; }
    if (values.erase(key) != 1 || destructions != 1) { return 11; }
    values.clear();
    if (destructions != 2) { return 12; }
  }
  if (constructions != 2 || destructions != 2) { return 13; }
  if (!page_boundaries<1>() || !page_boundaries<96>() ||
      !page_boundaries<512>()) { return 17; }
  return 0;
}
