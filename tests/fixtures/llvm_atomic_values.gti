#include <std/atomic>

bool roundtrip<std::atomic_scalar T>(T first, T second, T third) {
  std::atomic<T> value{first};
  if (value.load() != first) { return false; }
  value.store(second);
  if (value.exchange(third) != second) { return false; }
  auto success = value.compare_exchange_strong(third, second);
  auto failure = value.compare_exchange_strong(third, first);
  if (!success.exchanged() || success.observed() != third ||
      failure.exchanged() || failure.observed() != second ||
      value.load() != second) { return false; }
  std::atomic<T> moved = std::move(value);
  return moved.load() == second;
}

int main() {
  if (!roundtrip(false, true, false) ||
      !roundtrip(int8_t(-128), int8_t(127), int8_t(0)) ||
      !roundtrip(int16_t(-32768), int16_t(32767), int16_t(0)) ||
      !roundtrip(int32_t(-2147483647 - 1), int32_t(2147483647), int32_t(0)) ||
      !roundtrip(int64_t(-9223372036854775807 - 1), int64_t(9223372036854775807), int64_t(0)) ||
      !roundtrip(uint8_t(0), uint8_t(255), uint8_t(1)) ||
      !roundtrip(uint16_t(0), uint16_t(65535), uint16_t(1)) ||
      !roundtrip(uint32_t(0), uint32_t(4294967295), uint32_t(1)) ||
      !roundtrip(uint64_t(0), uint64_t(18446744073709551615), uint64_t(1))) {
    return 1;
  }
  return 0;
}
