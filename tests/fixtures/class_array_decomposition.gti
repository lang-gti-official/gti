extern "C" {
  void mark_constructor();
  int32_t constructed_count();
}

struct Range {
  mut int32_t lo;
  mut int32_t hi;
  Range(int32_t lo, int32_t hi) : lo(lo), hi(hi) {
    mark_constructor();
  }
  int32_t width() { return this.hi - this.lo; }
};

int main() {
  mut Range ranges[2] = {Range(0, 1), Range(5, 8)};
  auto [first, second] = ranges;
  if (first.hi + second.lo != 6 || first.width() + second.width() != 4) { return 1; }
  // Structured binding owns an independent copy, not references to ranges.
  ranges[0].lo = 99;
  if (first.lo != 0) { return 2; }
  // Copy construction must not invent ordinary/default construction.
  return constructed_count() == 2 ? 0 : 3;
}
