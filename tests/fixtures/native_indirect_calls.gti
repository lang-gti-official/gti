using Binary = (int32_t, int32_t) -> int32_t;
using Unary = (int32_t) -> int32_t;
using Factory = () -> Unary;
using Writer = (int32_t*, int32_t) -> void;
using ViewLength = (std::string_view) -> int32_t;
[[c_abi]] struct Point { mut int32_t x; mut int32_t y; };
using PointTransform = (Point) -> Point;
[[c_abi]] struct Dispatch { Binary combine; Factory factory; Writer write; };

extern "C" {
  Binary obtain_binary();
  Factory obtain_factory();
  Dispatch obtain_dispatch();
  Point obtain_point();
  PointTransform obtain_point_transform();
  ViewLength obtain_view_length();
  int32_t next_argument(int32_t digit);
  int32_t trace_value();
  void clear_trace();
}

int32_t clear_callback(mut Binary& callback) {
  callback = nullptr;
  return 5;
}

int32_t invoke_generic<F>(F callback, int32_t value) {
  unsafe { return callback(value); }
}

int32_t invoke_pack<F, Args...>(F callback, Args... values) {
  unsafe { return callback(values...); }
}

int32_t gti_view_length(std::string_view value) {
  if (value == "hello") { return 5; }
  return 0;
}

int main() {
  unsafe {
    clear_trace();
    if (obtain_binary()(next_argument(2), next_argument(3)) != 23) { return 1; }
    if (trace_value() != 1234) { return 2; }

    clear_trace();
    mut Binary saved = obtain_binary();
    if (saved == nullptr) { return 3; }
    // The callee value is copied before evaluating the argument that clears
    // its source binding. Late loading the callee would call a null address.
    if (saved(clear_callback(saved), 6) != 56) { return 4; }
    if (saved != nullptr) { return 5; }

    Dispatch table = obtain_dispatch();
    if (table.combine(7, 8) != 78) { return 6; }
    if (table.factory()(41) != 42) { return 7; }
    Factory factory = obtain_factory();
    Unary increment = factory();
    if (invoke_generic(increment, 41) != 42) { return 8; }
    if (invoke_pack(table.combine, 4, 2) != 42) { return 12; }

    mut int32_t value = 0;
    table.write(&value, 99);
    if (value != 99) { return 9; }

    PointTransform transform = obtain_point_transform();
    Point point = transform(obtain_point());
    if (point.x != 5 || point.y != 8) { return 10; }
    Point nested = transform(transform(obtain_point()));
    if (nested.x != 7 || nested.y != 16) { return 14; }
    mut Point reassigned = obtain_point();
    reassigned = transform(reassigned);
    if (reassigned.x != 5 || reassigned.y != 8) { return 15; }
    ViewLength length = obtain_view_length();
    if (length("hello") != 5) { return 11; }
    ViewLength adapted = gti_view_length;
    if (adapted("hello") != 5) { return 13; }
  }
  return 0;
}
