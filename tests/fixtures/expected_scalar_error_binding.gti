import std.string;

class Payload {
  int number;
public:
  Payload(int value) : number(value) { std::println(98); }
  ~Payload() { std::println(99); }
};

int main() {
  for (mut int index = 0; index < 3; index++) {
    expected<int, int> error = unexpected(index + 10);
    std::println(error.error());
  }
  expected<Payload, int> inactive = unexpected(31);
  std::println(inactive.error());
  expected<void, int> empty = unexpected(42);
  std::println(empty.error());
  return 0;
}
