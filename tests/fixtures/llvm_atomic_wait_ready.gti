#include <std/atomic>

bool ready<std::atomic_scalar T>(T old, T changed) {
  std::atomic<T> value{changed};
  value.wait(old);
  value.wait(old, std::memory_order_relaxed());
  value.wait(old, std::memory_order_acquire());
  value.wait(old, std::memory_order_seq_cst());
  value.notify_one();
  value.notify_all();
  return value.load() == changed;
}

int main() {
  if (!ready(false, true) ||
      !ready(int8_t(-128), int8_t(127)) ||
      !ready(int16_t(-32768), int16_t(32767)) ||
      !ready(int32_t(-2147483647 - 1), int32_t(2147483647)) ||
      !ready(int64_t(-9223372036854775807 - 1), int64_t(9223372036854775807)) ||
      !ready(uint8_t(255), uint8_t(0)) ||
      !ready(uint16_t(65535), uint16_t(0)) ||
      !ready(uint32_t(4294967295), uint32_t(0)) ||
      !ready(uint64_t(18446744073709551615), uint64_t(0))) {
    return 1;
  }
  return 0;
}
