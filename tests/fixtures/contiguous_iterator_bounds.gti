#include <std/string>
#include <std/vector>
#include <std/span>
#include <std/resource_vector>
#include <std/resource>

int main(int argc, std::vector<std::string> argv) {
  mut std::vector<int> values = {1, 2, 3, 4};
  if (argc == 1) {
    auto whole = values.as_span();
    auto middle = whole.subspan(std::size_t(1), std::size_t(2));
    mut auto current = middle.begin();
    --current;
    return *current;
  }
  if (argc == 2) {
    auto whole = values.as_span();
    auto middle = whole.subspan(std::size_t(1), std::size_t(2));
    mut auto current = middle.begin();
    current += std::ptrdiff_t(3);
    return 0;
  }
  if (argc == 3) {
    auto whole = values.as_span();
    auto middle = whole.subspan(std::size_t(1), std::size_t(2));
    mut auto current = middle.begin();
    current += std::ptrdiff_t(2);
    return *current;
  }
  if (argc == 4) {
    std::string text{"abc"};
    mut auto current = text.begin();
    current += std::ptrdiff_t(3);
    char selected = *current;
    return selected == 'a' ? 0 : 1;
  }
  if (argc == 5) {
    mut auto whole = values.as_mutable_span();
    mut auto middle = whole.subspan(std::size_t(1), std::size_t(2));
    mut auto current = middle.begin_mut();
    current[std::ptrdiff_t(-1)] = 99;
    return 0;
  }
  if (argc == 6) {
    std::string text{"abc"};
    mut auto current = text.begin();
    current -= std::ptrdiff_t(-9223372036854775807) - std::ptrdiff_t(1);
    return 0;
  }
  if (argc == 7) {
    std::process_resource process{};
    unsafe {
      auto resource = std::bind_resource(process);
      mut std::resource_vector<int, std::process_resource> owned{resource};
      owned.push_back(1);
      mut auto current = owned.begin();
      ++current;
      ++current;
    }
  }
  if (argc == 8) {
    std::string text{"abc"};
    mut auto current = text.rbegin();
    current += std::ptrdiff_t(3);
    char selected = *current;
    return selected == 'a' ? 0 : 1;
  }
  if (argc == 9) {
    auto whole = values.as_span();
    auto empty = whole.subspan(std::size_t(2), std::size_t(0));
    auto current = empty.rbegin();
    return *current;
  }
  if (argc == 10) {
    mut auto whole = values.as_mutable_span();
    mut auto middle = whole.subspan(std::size_t(1), std::size_t(2));
    mut auto current = middle.rbegin_mut();
    current += std::ptrdiff_t(3);
    return 0;
  }
  if (argc == 11) {
    auto whole = values.as_span();
    auto middle = whole.subspan(std::size_t(1), std::size_t(2));
    mut auto current = middle.rbegin();
    current += std::ptrdiff_t(2);
    ++current;
    return 0;
  }
  if (argc == 12) {
    mut std::string text{"abc"};
    mut auto current = text.rbegin_mut();
    current[std::ptrdiff_t(-1)] = 'x';
    return 0;
  }
  return 0;
}
