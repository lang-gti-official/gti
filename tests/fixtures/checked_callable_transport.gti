import std.functional;

struct Adder {
  int offset;
  Adder(int offset) : offset(offset) {}
  int operator()(int value) mut { return value + this.offset; }
};

int main() {
  std::function_ptr<int(int)> increment{
    [](int value) -> int { return value + 1; }
  };
  if (increment(3) != 4) return 1;
  mut Adder callable{4};
  mut std::function_ref<int(int) mut> view{callable};
  if (view(3) != 7) return 2;
  return 0;
}
