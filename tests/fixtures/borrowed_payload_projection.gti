import std.vector;

struct members {
  mut std::vector<int32_t> names{};
  mut std::vector<int32_t> values{};
public:
  members() = default;
};
enum class data { object(members fields) };

int main() {
  mut members fields{};
  fields.names.push_back(3);
  fields.values.push_back(7);
  data input = data::object(std::move(fields));
  switch (input) {
    case data::object(auto& object):
      mut std::vector<int32_t> result{};
      result.push_back(object.names[std::size_t(0)]);
      result.push_back(object.values[std::size_t(0)]);
      return result[std::size_t(0)] == 3 && result[std::size_t(1)] == 7 ? 0 : 1;
  }
}
