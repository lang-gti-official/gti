mut int drops = 0;
class Ticket {
  int id;
public:
  Ticket(int id) : id(id) {}
  ~Ticket() { drops = drops * 10 + this.id; }
};
int leaf(int value) { Ticket local{1}; return value + 1; }
int outer(int value) { Ticket local{2}; return leaf(value); }
int main() { return outer(6) == 7 && drops == 12 ? 0 : 1; }
