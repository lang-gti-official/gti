#include <std/source_location>

mut int effects = 0;
mut int drops = 0;
mut int propagation_continuations = 0;

class Owner {
  int number;
public:
  Owner(int value) : number(value) {}
  Owner(Owner& other) = delete;
  Owner(Owner&& other) = default;
  ~Owner() { drops += 1; }
  int read() { return this.number; }
};

int effect(int value) { effects += 1; return value; }
#macro int choose(bool enabled, int first, int second) {
  if (enabled) { return first; }
  return second;
}
#macro int once(int value) {
  int saved = value;
  return saved + saved;
}
#macro int nested(int value) { return choose(true, once(value), 0); }
#macro int local_loop(int value) {
  for (mut int index = 0; index < 4; ++index) {
    if (index == 2) { return value; }
  }
  return 0;
}
#macro Owner owned(bool enabled, Owner first, Owner second) {
  Owner guard{99};
  if (enabled) { return first; }
  return second;
}
#macro Owner local(int value) { Owner saved{value}; return saved; }
int observe_owner(Owner& owner) { return owner.read(); }
#macro int read_borrowed(Owner expression) {
  Owner& saved = expression;
  return saved.read();
}
#macro int invoke<F>(F action) { return action(); }
#macro stop() { return; }

struct Box {
  int value;
  implicit Box(int value) : value(value) {}
};
#macro Box boxed(int value) { return Box(value); }
int observe_box(Box& box) { return box.value; }
int consume_box(Box box) { return box.value; }
struct Flag {
  operator bool() { return true; }
  implicit operator int() { return 19; }
public:
  Flag() = default;
};
#macro Flag flag() { return Flag(); }
Box boxed_result() { return choose(true, 41, 0); }
#macro int guarded(int expression) { Owner guard{71}; return expression; }
expected<int, int> fallible(bool fail) {
  if (fail) { return unexpected(13); }
  return 31;
}
#macro expected<int, int> result(bool fail) { return fallible(fail); }
expected<int, int> forwarded(bool fail) {
  Owner caller{72};
  return guarded(?result(fail));
}
expected<int, int> continued(bool fail) {
  Owner caller{73};
  int result = guarded(?fallible(fail));
  propagation_continuations += 1;
  return result + 1;
}
#macro std::source_location here(
    std::source_location location = std::source_location::current()) {
  return location;
}

mut int initializer_drops = 0;
class InitOwner {
public:
  InitOwner() {}
  InitOwner(InitOwner& other) = delete;
  InitOwner(InitOwner&& other) = default;
  ~InitOwner() { initializer_drops += 1; }
};
struct InitPair {
  int first;
  int second;
  InitPair(int first, int second) : first(first), second(second) {}
};
#macro T typed_relay<T>(T expression) { return expression; }
#macro T initial_value<T>(T expression) {
  InitOwner owner{};
  mut auto saved = expression;
  saved += T(1);
  auto& alias = saved;
  InitPair pair{2, 3};
  auto [left, right] = pair;
  return typed_relay(alias + T(left + right));
}
struct InitRecord {
  int field = initial_value(7);
  static int shared = initial_value(9);
  uint64_t wide = initial_value(uint64_t(5));
public:
  InitRecord() = default;
};
int initialized_global = initial_value(3);
namespace setup { int namespaced = initial_value(4); }

int main() {
  if (choose(false, effect(9), nested(effect(5))) != 10 || effects != 1) { return 1; }
  if (local_loop(effect(7)) != 7 || effects != 2) { return 2; }
  if (invoke([]() -> int { return 4; }) != 4) { return 3; }
  stop();
  {
    Owner untouched{11};
    Owner selected = owned(false, std::move(untouched), local(17));
    if (untouched.read() != 11 || selected.read() != 17 || drops != 1) { return 4; }
  }
  if (drops != 3) { return 5; }
  {
    Owner observed{23};
    if (read_borrowed(observed) != 23) { return 6; }
    Owner transferred = std::move(observed);
    if (transferred.read() != 23) { return 7; }
  }
  if (drops != 4) { return 8; }
  Box initialized = choose(true, 17, 0);
  Box returned = boxed_result();
  if (initialized.value != 17 || returned.value != 41) { return 9; }
  int converted = flag();
  if (!flag() || converted != 19) { return 15; }
  auto success = forwarded(false);
  if (!success || success.value() != 31 || drops != 6) { return 10; }
  auto failure = forwarded(true);
  if (failure || failure.error() != 13 || drops != 8) { return 11; }
  auto continued_success = continued(false);
  if (!continued_success || continued_success.value() != 32 || drops != 10 ||
      propagation_continuations != 1) { return 12; }
  auto continued_failure = continued(true);
  if (continued_failure || continued_failure.error() != 13 || drops != 12 ||
      propagation_continuations != 1) { return 13; }
  std::source_location direct = std::source_location::current(); std::source_location defaulted = here();
  if (defaulted.line() != direct.line() || defaulted.file_name() != direct.file_name() ||
      defaulted.function_name() != "main") { return 14; }
  int before_argument = drops;
  int observed_owner = observe_owner(local(83));
  if (observed_owner != 83 || drops != before_argument + 1) { return 19; }
  int observed_box = observe_box(boxed(89));
  if (observed_box != 89) { return 20; }
  if (consume_box(boxed(97)) != 97) { return 21; }
  if (initializer_drops != 3 || initialized_global != 9 || setup::namespaced != 10 ||
      InitRecord::shared != 15) { return 16; }
  InitRecord record{};
  if (record.field != 13 || record.wide != uint64_t(11) || initializer_drops != 5) {
    return 17;
  }
  return 0;
}
