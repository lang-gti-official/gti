import std.string;
import std.vector;

mut int zero = 0;

struct Ticket {
  std::string text;
  Ticket() : text(std::string("resource")) {}
  ~Ticket() { std::println(7); }
};

struct TextOwner {
  std::string_view& text;
  Ticket ticket;
  TextOwner(std::string_view& input, Ticket resource, bool fail)
      : text(input), ticket(std::move(resource)) {
    if (fail) {
      int constructor_failure = 1 / zero;
    }
  }
  std::size_t size() { return this.text.size(); }
};

struct TextReader {
  std::string_view& text;
  TextReader(std::string_view& input) : text(input) {}
  std::size_t size() { return this.text.size(); }
  std::string_view read() { return this.text; }
  std::string_view read_implicit() { return text; }
};

std::string_view& relay_text(std::string_view& input) { return input; }

struct CReader {
  c_string& text;
  CReader(c_string& input) : text(input) {}
  c_string read() { return this.text; }
};
c_string& relay_c_text(c_string& input) { return input; }
c_string& nested_c_text(c_string& input) { return relay_c_text(input); }

std::size_t copied_size(std::string_view& input) {
  std::string_view copy = input;
  return copy.size();
}

std::size_t inspect(std::string_view input, bool fail) {
  TextOwner reader{relay_text(input), Ticket(), fail};
  return reader.size();
}

int main(int argc, std::vector<std::string> argv) {
  std::string_view literal = "literal";
  std::string_view alias = literal;
  std::string_view& reference = alias;
  TextReader static_reader{relay_text(reference)};
  if (static_reader.size() != std::size_t(7)) { return 1; }
  std::string_view copied_static = static_reader.read();
  if (copied_static.size() != std::size_t(7)) { return 4; }
  mut std::string owner = std::string("dynamic");
  {
    std::string_view view = owner.view();
    TextReader reader{relay_text(view)};
    std::string_view copy = reader.read();
    if (copy.size() != std::size_t(7)) { return 5; }
    std::string_view implicit_copy = reader.read_implicit();
    if (implicit_copy.size() != std::size_t(7)) { return 6; }
    c_string pointer = owner.c_string();
    c_string& pointer_reference = relay_c_text(pointer);
    CReader direct_c_reader{pointer_reference};
    c_string direct_c_copy = direct_c_reader.read();
    CReader c_reader{nested_c_text(pointer_reference)};
    c_string c_copy = c_reader.read();
    unsafe {
      std::string direct_copy{direct_c_copy};
      std::string nested_copy{c_copy};
      if (direct_copy.size() != std::size_t(7) ||
          nested_copy.size() != std::size_t(7)) { return 7; }
    }
    c_string empty = nullptr;
    CReader empty_reader{empty};
  }
  if (inspect(owner.view(), argc > 1) != std::size_t(7)) { return 2; }
  std::string_view dynamic = owner.view();
  TextReader dynamic_reader{dynamic};
  std::string_view read = dynamic_reader.read();
  if (read != "dynamic" || copied_size(dynamic) != std::size_t(7)) { return 4; }
  // The adapter and its external dependency both retired, without consuming
  // the original owner. Its resource was destroyed exactly once.
  owner.clear();
  return owner.empty() ? 0 : 3;
}
