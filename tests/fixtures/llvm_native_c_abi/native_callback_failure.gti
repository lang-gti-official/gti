using Operation = (int32_t) -> int32_t;
extern "C" {
  int32_t native_callback_failure_invoke(Operation operation);
  void native_callback_cleanup();
}
struct Guard { ~Guard() { native_callback_cleanup(); } };
int32_t fail(int32_t value) { Guard guard{}; return 100 / value; }
int main() {
  Operation operation = fail;
  unsafe { return native_callback_failure_invoke(operation); }
}
