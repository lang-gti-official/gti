    native_callback_slots = table;
    native_callback_slots.scalar = scalar;
    native_callback_record_slot = pair;
    if (native_callback_slots.scalar(35) != 42) return 11;
    auto global_result = native_callback_record_slot(native_callback_pair_make());
    if (global_result.b != uint64_t(31)) return 12;
    auto global_table = native_callback_slots;
    if (native_callback_table_check(global_table) != 1) return 13;
    native_callback_record_slot = nullptr;
    if (native_callback_record_slot != nullptr) return 14;
