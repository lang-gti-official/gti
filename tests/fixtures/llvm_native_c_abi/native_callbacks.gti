using PairOperation = (CallbackPair) -> CallbackPair;
using LargeOperation = (CallbackLarge) -> CallbackLarge;
using HfaOperation = (CallbackHfa) -> CallbackHfa;
using ViewOperation = (std::string_view) -> uint64_t;
using Selector = (Scalar) -> Scalar;
