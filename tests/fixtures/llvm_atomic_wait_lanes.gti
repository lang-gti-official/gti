import std.atomic;

// Source-verified release/acquire plans for the test-only native parking lanes.
// No GTI wait, worker, or foreign-object admission is claimed by this fixture.
bool lane<std::atomic_scalar T>(T value) {
  std::atomic<T> storage{value};
  storage.store(value, std::memory_order_release());
  return storage.load(std::memory_order_acquire()) == value;
}

int main() {
  if (!lane(uint8_t(255)) || !lane(uint16_t(65535)) ||
      !lane(uint32_t(4294967295)) ||
      !lane(uint64_t(18446744073709551615))) {
    return 1;
  }
  return 0;
}
