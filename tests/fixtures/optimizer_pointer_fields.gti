#include <std/memory>

unsafe void initialize_field_target(int* address, int value) {
  unsafe { std::construct_at(address, value); }
}

class AddressPair {
public:
  mut int* slot = nullptr;
  mut int* other = nullptr;
  mut int count = 0;
  AddressPair(int* slot, int* other) : slot(slot), other(other) {}

  unsafe void initialize(int value) {
    unsafe { std::construct_at(this.slot, value); }
  }

  unsafe void initialize_next() {
    unsafe { std::construct_at(this.slot + 1, 7); }
  }

  unsafe void initialize_conditionally(bool condition) {
    if (condition) {
      unsafe { std::construct_at(this.slot, 7); }
    }
  }

  unsafe void initialize_then_write_alias() {
    unsafe {
      std::construct_at(this.slot, 7);
      *this.other = 2147483647;
    }
  }

  unsafe int constructed_member_call() {
    unsafe {
      this.initialize(7);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int constructed_member_offset() {
    unsafe {
      this.initialize_next();
      int* pointer = this.slot + 1;
      return *pointer + 1;
    }
  }

  unsafe int constructed_field_metadata() mut {
    if (this.count != 0) return 0;
    unsafe {
      std::construct_at(this.slot, 7);
      this.count = 1;
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_member_value() {
    unsafe {
      this.initialize(2147483647);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_member_conditional() {
    unsafe {
      this.initialize_conditionally(false);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_member_alias() {
    unsafe {
      this.initialize_then_write_alias();
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int constructed_field() {
    unsafe {
      std::construct_at(this.slot, 7);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int constructed_field_relay() {
    unsafe {
      initialize_field_target(this.slot, 7);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int constructed_field_offset() {
    unsafe {
      std::construct_at(this.slot + 1, 7);
      int* pointer = this.slot + 1;
      return *pointer + 1;
    }
  }

  unsafe int constructed_copied_field() mut {
    unsafe {
      this.other = this.slot;
      std::construct_at(this.other, 7);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_field_value() {
    unsafe {
      std::construct_at(this.slot, 2147483647);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_field_hole() {
    unsafe {
      std::construct_at(this.slot, 7);
      int* pointer = this.slot + 1;
      return *pointer + 1;
    }
  }

  unsafe int bad_field_alias() {
    unsafe {
      std::construct_at(this.slot, 7);
      *this.other = 2147483647;
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_field_redirect() mut {
    unsafe {
      std::construct_at(this.slot, 7);
      this.slot = this.other;
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_field_old_address() mut {
    unsafe {
      int* old = this.slot;
      this.slot = this.other;
      std::construct_at(old, 7);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }

  unsafe int bad_field_replacement() {
    unsafe {
      std::construct_at(this.slot, 7);
      std::destroy_at(this.slot);
      std::construct_at(this.slot, 2147483647);
      int* pointer = this.slot;
      return *pointer + 1;
    }
  }
};

struct NestedAddresses {
  mut AddressPair addresses;
  NestedAddresses(int* slot, int* other) : addresses(AddressPair(slot, other)) {}
};

unsafe void initialize_nested_field(NestedAddresses& nested, int value) {
  unsafe { std::construct_at(nested.addresses.slot, value); }
}

unsafe int constructed_reference_call(NestedAddresses& nested) {
  unsafe {
    initialize_nested_field(nested, 7);
    int* pointer = nested.addresses.slot;
    return *pointer + 1;
  }
}

unsafe int constructed_reference_metadata(mut NestedAddresses& nested) {
  if (nested.addresses.count != 0) return 0;
  unsafe {
    std::construct_at(nested.addresses.slot, 7);
    nested.addresses.count = 1;
    int* pointer = nested.addresses.slot;
    return *pointer + 1;
  }
}

unsafe int constructed_reference_field(AddressPair& addresses) {
  unsafe {
    std::construct_at(addresses.slot, 7);
    int* pointer = addresses.slot;
    return *pointer + 1;
  }
}

unsafe int constructed_nested_field(NestedAddresses& nested) {
  unsafe {
    std::construct_at(nested.addresses.slot, 7);
    int* pointer = nested.addresses.slot;
    return *pointer + 1;
  }
}

struct Metadata {
  mut int count = 0;
};

unsafe int constructed_with_metadata(mut Metadata& metadata, int* address) {
  if (metadata.count != 0) return 0;
  unsafe {
    std::construct_at(address, 7);
    metadata.count = 1;
    int* pointer = address;
    return *pointer + 1;
  }
}

unsafe int constructed_metadata_relay(mut Metadata& metadata, int* address) {
  if (metadata.count != 0) return 0;
  unsafe {
    initialize_field_target(address, 7);
    metadata.count = 1;
    int* pointer = address;
    return *pointer + 1;
  }
}

unsafe int bad_reconstructed_metadata(mut Metadata& metadata, int* address) {
  unsafe {
    std::destroy_at(&metadata.count);
    initialize_field_target(address, 7);
    // This fact is established AFTER construction; it cannot prove that
    // address and metadata.count occupy disjoint storage.
    if (metadata.count != 7) return 0;
    metadata.count = 2147483647;
    int* pointer = address;
    return *pointer + 1;
  }
}

unsafe int bad_metadata_alias(mut Metadata& metadata, int* alias, int* address) {
  if (metadata.count != 0) return 0;
  unsafe {
    std::destroy_at(alias);
    initialize_field_target(address, 7);
    if (metadata.count != 7) return 0;
    metadata.count = 2147483647;
    int* pointer = address;
    return *pointer + 1;
  }
}

int main() {
  mut std::uninitialized<int> storage{};
  mut int pair[2] = {0, 2147483647};
  mut Metadata metadata{};
  unsafe {
    mut AddressPair addresses{storage.data(), &pair[1]};
    AddressPair aliasing{storage.data(), storage.data()};
    mut NestedAddresses nested{storage.data(), &pair[1]};
    if (false) return addresses.bad_field_value();
    if (false) {
      std::destroy_at(&pair[0]);
      AddressPair holes{&pair[0], &pair[1]};
      return holes.bad_field_hole();
    }
    if (false) return aliasing.bad_field_alias();
    if (false) return addresses.bad_field_redirect();
    if (false) return addresses.bad_field_old_address();
    if (false) return addresses.bad_field_replacement();
    if (false) return addresses.bad_member_value();
    if (false) {
      AddressPair existing{&pair[1], &pair[1]};
      return existing.bad_member_conditional();
    }
    if (false) return aliasing.bad_member_alias();
    if (false) return bad_reconstructed_metadata(metadata, &metadata.count);
    if (false) return bad_metadata_alias(metadata, &metadata.count, &metadata.count);
    if (constructed_with_metadata(metadata, storage.data()) != 8) return 10;
    std::destroy_at(storage.data());
    metadata.count = 0;
    if (constructed_metadata_relay(metadata, storage.data()) != 8) return 11;
    std::destroy_at(storage.data());
    if (addresses.constructed_field_metadata() != 8) return 12;
    std::destroy_at(storage.data());
    if (constructed_reference_metadata(nested) != 8) return 13;
    std::destroy_at(storage.data());
    addresses.initialize_conditionally(true);
    std::destroy_at(storage.data());
    if (addresses.constructed_member_call() != 8) return 7;
    std::destroy_at(storage.data());
    if (constructed_reference_call(nested) != 8) return 8;
    std::destroy_at(storage.data());
    if (addresses.constructed_field() != 8) return 1;
    std::destroy_at(storage.data());
    if (addresses.constructed_field_relay() != 8) return 2;
    std::destroy_at(storage.data());
    if (constructed_reference_field(addresses) != 8) return 3;
    std::destroy_at(storage.data());
    if (constructed_nested_field(nested) != 8) return 4;
    std::destroy_at(storage.data());
    if (addresses.constructed_copied_field() != 8) return 6;
    std::destroy_at(storage.data());
    std::destroy_at(&pair[1]);
    AddressPair offset{&pair[0], &pair[0]};
    if (offset.constructed_field_offset() != 8) return 5;
    std::destroy_at(&pair[1]);
    if (offset.constructed_member_offset() != 8) return 9;
  }
  return 0;
}
