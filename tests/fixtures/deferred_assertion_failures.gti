#include <std/assert>
#include <std/panic>
#include <std/cstdio>
#include <std/string>
#include <std/thread>
#include <std/vector>

struct Guard {
  int number;
  Guard(int value) : number(value) {}
  ~Guard() {
    if (number == 1) {
      [[discard]] std::try_write_stderr("outer\n");
    } else {
      [[discard]] std::try_write_stderr("inner\n");
    }
  }
};

struct CleanupPanic {
  ~CleanupPanic() { std::assert(false, "cleanup assertion"); } // secondary
};

[[track_caller]] void tracked_wrapper() {
  std::assert(false, "through tracked wrapper");
}

namespace application {
  #macro require(bool condition, std::string_view reason) {
    if (!condition) { std::panic(reason); }
  }
}

std::string fail_message() {
  std::panic("message computation failed"); // message-computation
}

bool ordered_condition() {
  [[discard]] std::try_write_stderr("condition\n");
  return false;
}
std::string_view ordered_pattern() {
  [[discard]] std::try_write_stderr("pattern\n");
  return "ordered {} then {}";
}
int ordered_argument(int number) {
  if (number == 1) { [[discard]] std::try_write_stderr("first\n"); }
  else { [[discard]] std::try_write_stderr("second\n"); }
  return number;
}

int main(int argc, std::vector<std::string> argv) {
  Guard outer{1};
  if (argc == 1) {
    std::assert(true, "never evaluated {}", fail_message());
    return 0;
  }
  Guard inner{2};
  if (argc == 2) {
    std::assert(false); // plain
  }
  if (argc == 3) {
    std::string message{"owned payload"};
    std::assert(false, "failure: {}", message.view()); // formatted
  }
  if (argc == 4) {
    std::debug_assert(false, "debug failure"); // debug
    return 0;
  }
  if (argc == 5) {
    tracked_wrapper(); // tracked-caller
  }
  if (argc == 6) {
    application::require(false, "application failure"); // application
  }
  if (argc == 7) {
    std::assert(false, "{}", fail_message());
  }
  if (argc == 8) {
    CleanupPanic cleanup{};
    std::assert(false, "primary assertion"); // primary
  }
  if (argc == 9 || argc == 10) {
    auto started = std::thread::start([]() -> void {
      Guard worker{2};
      std::assert(false, "worker assertion"); // worker
    });
    if (!started) { return 99; }
    mut std::thread worker = std::move(started).value();
    if (argc == 9) {
      auto joined = worker.join();
      if (!joined) { return 98; }
    }
  }
  if (argc == 11) {
    std::assert(ordered_condition(), ordered_pattern(), ordered_argument(1), ordered_argument(2)); // ordered
  }
  return 0;
}
