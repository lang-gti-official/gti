import std.assert;
import std.panic;
import std.cstdio;
import std.string;
import std.thread;
import std.vector;

struct Guard {
  int number;
  Guard(int value) : number(value) {}
  ~Guard() {
    if (number == 1) {
      [[discard]] std::try_write_stderr("outer\n");
    } else {
      [[discard]] std::try_write_stderr("inner\n");
    }
  }
};

struct CleanupPanic {
  ~CleanupPanic() { std::assert(false, "cleanup assertion"); } // secondary
public:
  CleanupPanic() = default;
};

struct MacroOwner {
  std::string label;
  MacroOwner(std::string value) : label(std::move(value)) {}
  ~MacroOwner() { [[discard]] std::try_write_stderr(label.view()); }
};

[[track_caller]] void tracked_wrapper() {
  std::assert(false, "through tracked wrapper");
}

namespace application {
  [[track_caller]] #macro default_condition(int value) {
    std::assert(value > 0);
  }

  [[track_caller]] #macro default_debug_condition(int value) {
    std::debug_assert(value > 0);
  }

  #macro require(bool condition, std::string_view reason) {
    if (!condition) { std::panic(reason); }
  }

  [[track_caller]] #macro local_failure(bool fail, std::string label) {
    MacroOwner owned{label};
    if (fail) { std::panic("macro local failure"); }
  }

  [[track_caller]] #macro local_loop(bool fail, int count) {
    bool should_fail = fail;
    int limit = count;
    for (mut int index = 0; index < limit; ++index) {
      MacroOwner owned{std::string("iteration\n")};
      if (index == 0) { continue; }
      if (index == 2) {
        if (should_fail) { std::panic("macro loop failure"); }
        break;
      }
    }
  }
}

std::string fail_message() {
  std::panic("message computation failed"); // message-computation
}

bool ordered_condition() {
  [[discard]] std::try_write_stderr("condition\n");
  return false;
}
std::string_view ordered_pattern() {
  [[discard]] std::try_write_stderr("pattern\n");
  return "ordered {} then {}";
}
int ordered_argument(int number) {
  if (number == 1) { [[discard]] std::try_write_stderr("first\n"); }
  else { [[discard]] std::try_write_stderr("second\n"); }
  return number;
}

int main(int argc, std::vector<std::string> argv) {
  Guard outer{1};
  if (argc == 1) {
    std::assert(true, "never evaluated {}", fail_message());
    return 0;
  }
  Guard inner{2};
  if (argc == 2) {
    std::assert(false); // plain
  }
  if (argc == 3) {
    std::string message{"owned payload"};
    std::assert(false, "failure: {}", message.view()); // formatted
  }
  if (argc == 4) {
    std::debug_assert(false, "debug failure"); // debug
    return 0;
  }
  if (argc == 5) {
    tracked_wrapper(); // tracked-caller
  }
  if (argc == 6) {
    application::require(false, "application failure"); // application
  }
  if (argc == 7) {
    std::assert(false, "{}", fail_message());
  }
  if (argc == 8) {
    CleanupPanic cleanup{};
    std::assert(false, "primary assertion"); // primary
  }
  if (argc == 9 || argc == 10) {
    auto started = std::thread::start([]() -> void {
      Guard worker{2};
      std::assert(false, "worker assertion"); // worker
    });
    if (!started) { return 99; }
    mut std::thread worker = std::move(started).value();
    if (argc == 9) {
      auto joined = worker.join();
      if (!joined) { return 98; }
    }
  }
  if (argc == 11) {
    std::assert(ordered_condition(), ordered_pattern(), ordered_argument(1), ordered_argument(2)); // ordered
  }
  if (argc == 12) {
    application::local_failure(true, std::string("macro\n")); // macro-local-panic
  }
  if (argc == 13) {
    application::local_failure(false, std::string("macro\n"));
  }
  if (argc == 14) {
    application::local_loop(true, 6); // macro-loop-panic
  }
  if (argc == 15) {
    application::local_loop(false, 6);
  }
  if (argc == 16) {
    application::default_condition(0); // synthesized-default
  }
  if (argc == 17) {
    application::default_debug_condition(0); // synthesized-debug-default
  }
  return 0;
}
