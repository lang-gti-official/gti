import std.utility;

struct Resource { int value = 7;  public: Resource() = default; };
// Both carriers name their stored region, so a copied view depends on the
// external owner rather than on the wrapper that holds it.
class View<lifetime data> {
  Resource&<data> owner;
public:
  View(Resource&<data> owner) : owner(owner) {}
  Resource&<data> get() { return this.owner; }
};
class Wrapper<lifetime data> {
  View<data> view;
  mut int count;
public:
  Wrapper(Resource&<data> owner) : view(View(owner)), count(0) {}
  View<data> binding() { return this.view; }
  void touch() mut { this.count++; }
  int inspect() mut {
    auto copy = this.binding();
    this.touch();
    return copy.get().value;
  }
};
int main() {
  Resource owner{};
  mut Wrapper wrapper{owner};
  auto copied = wrapper.binding();
  wrapper.touch();
  return copied.get().value + wrapper.inspect() - 14;
}
