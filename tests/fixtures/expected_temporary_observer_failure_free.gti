enum class item_error { unavailable };
mut int destroyed = 0;
class Item {
public:
  Item() {}
  Item(Item& other) = delete;
  Item(Item&& other) = default;
  ~Item() { destroyed++; }
};
expected<Item, item_error> produce(bool success) {
  if (success) { return Item(); }
  return unexpected(item_error::unavailable);
}
int main() {
  for (mut int index = 0; index < 4; index++) {
    if (!produce(true).has_value()) { return 1; }
    if (destroyed != index + 1) { return 2; }
    if (produce(false).has_value()) { return 3; }
    if (destroyed != index + 1) { return 4; }
  }
  for (mut int index = 0; index < 4; index++) {
    if (index < 0 || produce(true).has_value()) {}
    if (destroyed != index + 5) { return 5; }
    if (index >= 0 || produce(true).has_value()) {}
    if (destroyed != index + 5) { return 6; }
  }
  return 0;
}
