// Dependent class assertions that require staged reflection hold for every
// concrete instance: the class and its constructor both reanalyse it, an
// assertion may reflect on its own instance or on one that reflects back,
// and instances reached by constant evaluation or a global initializer are
// checked in their isolated workers.
#include <std/meta>

class Box<T> {
  static_assert(!std::meta::type<T>().is_void(), "no void");
  mut T value;
public:
  Box(T value) : value(value) {}
  T get() { return value; }
};

class Node<T> {
  static_assert(std::meta::type<Node<T>>().field_count() == uint64_t(1),
                "one field");
  T value;
public:
  Node(T value) : value(value) {}
  T get() { return value; }
};

class Left<T> {
  static_assert(std::meta::type<Right<T>>().field_count() == uint64_t(1),
                "right has one field");
  T value;
public:
  Left(T value) : value(value) {}
  T get() { return value; }
};

class Right<T> {
  static_assert(std::meta::type<Left<T>>().field_count() == uint64_t(1),
                "left has one field");
  T value;
public:
  Right(T value) : value(value) {}
  T get() { return value; }
};

class Cell<T> {
  static_assert(!std::meta::type<T>().is_void(), "no void cell");
  T value;
public:
  constexpr Cell(T value) : value(value) {}
  constexpr T get() { return value; }
};

constexpr int32_t read_cell() {
  Cell<int32_t> cell = Cell<int32_t>(7);
  return cell.get();
}
static_assert(read_cell() == 7);

Cell<int64_t> global_cell = Cell<int64_t>(int64_t(40));

int main() {
  Box<int32_t> box = Box<int32_t>(1);
  Box<bool> flag = Box<bool>(true);
  Node<int32_t> node = Node<int32_t>(2);
  Left<int32_t> left = Left<int32_t>(3);
  Right<int32_t> right = Right<int32_t>(4);
  constexpr int32_t cell = read_cell();
  if (!flag.get()) {
    return 1;
  }
  int64_t total =
      int64_t(box.get() + node.get() + left.get() + right.get() + cell) +
      global_cell.get();
  return total == int64_t(57) ? 0 : 2;
}
