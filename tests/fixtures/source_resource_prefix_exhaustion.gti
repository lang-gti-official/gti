import std.resource_vector;
import std.resource;
import std.memory;
import std.string;
import std.vector;

class FailingResource {
public:
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    // Application resource calls remain observable, even though this provider
    // can never allocate. The process-allocation elision permission is distinct.
    std::println(11);
    return unexpected(std::alloc_errc::resource_exhausted);
  }
  unsafe void release(std::raw_allocation allocation) { std::println(77); }
  ~FailingResource() { std::println(91); }
public:
  FailingResource() = default;
};

class Item {
  int value;
public:
  Item(int value) : value(value) { std::println(this.value); }
  ~Item() { std::println(88); }
};

int main(int argc, std::vector<std::string> argv) {
  FailingResource provider{};
  unsafe {
    auto resource = std::bind_resource(provider);
    mut std::resource_vector<Item, FailingResource> values{resource};
    if (argc == 1) { values.reserve(std::size_t(1)); }
    // A plain push keeps its prepared owning argument alive until the abort.
    if (argc == 2) { values.push_back(Item(8)); }
    // Emplacement must not execute the element constructor before growth.
    if (argc == 3) { values.emplace_back(9); }
    if (argc == 4) {
      auto result = values.try_push_back(Item(8));
      if (result || result.error() != std::alloc_errc::resource_exhausted ||
          !values.empty() || values.capacity() != std::size_t(0)) { return 1; }
      // Fallible failure returns normally and destroys its consumed argument.
      return 0;
    }
  }
  return 2;
}
