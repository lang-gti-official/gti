#include <std/memory>

int copied_address() {
  mut int value = 7;
  unsafe {
    int* first = &value;
    int* second = first;
    return *second + 1;
  }
}

int replaced_address() {
  mut int first = 7;
  mut int second = 9;
  unsafe {
    mut int* pointer = &first;
    int before = *pointer;
    pointer = &second;
    int after = *pointer;
    return before + after;
  }
}

class Meter {
  mut int value = 7;
public:
  Meter() {}
  int read_address() {
    unsafe {
      const int* pointer = &this.value;
      return *pointer + 1;
    }
  }
};

int joined_same(bool choose) {
  mut int value = 7;
  unsafe {
    mut int* pointer = &value;
    if (choose) { pointer = &value; }
    return *pointer + 1;
  }
}

int bad_replaced() {
  mut int first = 7;
  mut int second = 2147483647;
  unsafe {
    mut int* pointer = &first;
    pointer = &second;
    return *pointer + 1;
  }
}

int bad_joined(bool choose) {
  mut int first = 7;
  mut int second = 2147483647;
  unsafe {
    mut int* pointer = &first;
    if (choose) { pointer = &second; }
    return *pointer + 1;
  }
}

int bad_alias() {
  mut int value = 7;
  unsafe {
    int* pointer = &value;
    mut int& alias = value;
    alias = 2147483647;
    return *pointer + 1;
  }
}

int bad_raw_write() {
  mut int value = 7;
  unsafe {
    int* pointer = &value;
    *pointer = 2147483647;
    return *pointer + 1;
  }
}

struct PointerHolder {
  mut int* address = nullptr;
};

int bad_pointer_alias() {
  mut int first = 7;
  mut int second = 2147483647;
  mut PointerHolder owner{};
  unsafe {
    owner.address = &first;
    mut PointerHolder& alias = owner;
    alias.address = &second;
    int* pointer = owner.address;
    return *pointer + 1;
  }
}

int bad_lifetime() {
  mut int value = 7;
  unsafe {
    int* pointer = &value;
    std::destroy_at(pointer);
    std::construct_at(pointer, 2147483647);
    return *pointer + 1;
  }
}

int main() {
  Meter meter{};
  if (copied_address() != 8 || replaced_address() != 16 ||
      meter.read_address() != 8 || joined_same(true) != 8) return 1;
  if (false) return bad_replaced();
  if (false) return bad_joined(true);
  if (false) return bad_alias();
  if (false) return bad_raw_write();
  if (false) return bad_pointer_alias();
  if (false) return bad_lifetime();
  return 0;
}
