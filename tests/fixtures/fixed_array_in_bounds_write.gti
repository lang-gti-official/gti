int main() {
  mut int32_t cells[4] = {};
  mut std::size_t index = std::size_t(0);
  while (index < std::size_t(2)) {
    index++;
  }
  cells[index] = 7;
  cells[index] += 5;
  cells[std::size_t(1)] = 3;
  if (cells[std::size_t(2)] == 12 and cells[std::size_t(1)] == 3 and
      cells[std::size_t(0)] == 0 and cells[std::size_t(3)] == 0) {
    return 0;
  }
  return 1;
}
