// Issue #331: assignment through a mutable resource_vector subscript.
import std.resource_vector;
import std.resource;
import std.memory;

int32_t probe(std::resource_ref<std::process_resource> resource) {
  mut std::resource_vector<int32_t, std::process_resource> values{resource};
  values.push_back(5);
  values.push_back(6);
  values[std::size_t(0)] = 60;
  values[std::size_t(1)] = values[std::size_t(0)] + 1;
  return values[std::size_t(0)] + values[std::size_t(1)];
}

int main() {
  std::process_resource heap{};
  mut int32_t total = 0;
  unsafe { total = probe(std::bind_resource(heap)); }
  return total == 121 ? 0 : 1;
}
