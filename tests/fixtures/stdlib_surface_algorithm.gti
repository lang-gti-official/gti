#include <std/algorithm>
#include <std/vector>

mut int32_t algorithm_sum = 0;

class audit_iterator {
  mut std::size_t index;
  mut int32_t values[4] = {1, 2, 3, 4};

public:
  audit_iterator(std::size_t initial) : index(initial) {}

  int32_t& operator*() {
    return this.values[this.index];
  }

  void operator++() mut {
    this.index++;
  }

  bool operator!=(audit_iterator& other) {
    return this.index != other.index;
  }
};

class positive {
public:
  bool operator()(int32_t& value) {
    return value > 0;
  }
};

class even {
public:
  bool operator()(int32_t& value) {
    return value % 2 == 0;
  }
};

class sum_values {
public:
  void operator()(int32_t& value) {
    algorithm_sum += value;
  }
};

int main() {
  if (std::min(3, 4) != 3 || std::max(3, 4) != 4 ||
      std::clamp(7, 1, 5) != 5 ||
      !std::all_of(audit_iterator(std::size_t(0)),
                   audit_iterator(std::size_t(4)), positive()) ||
      !std::any_of(audit_iterator(std::size_t(0)),
                   audit_iterator(std::size_t(4)), even()) ||
      std::none_of(audit_iterator(std::size_t(0)),
                   audit_iterator(std::size_t(4)), positive()) ||
      std::count_if(audit_iterator(std::size_t(0)),
                    audit_iterator(std::size_t(4)), even()) != 2) {
    return 1;
  }

  mut audit_iterator found = std::find_if(
      audit_iterator(std::size_t(0)), audit_iterator(std::size_t(4)), even());
  mut audit_iterator not_found = std::find_if_not(
      audit_iterator(std::size_t(0)), audit_iterator(std::size_t(4)), even());
  if (*found != 2 || *not_found != 1) {
    return 2;
  }

  mut std::vector<int32_t> values =
      std::vector<int32_t>({1, 3, 5, 7, 9});
  mut auto first = values.begin();
  mut auto copied = first;
  ++copied;
  if (*first != 1 || *copied != 3) {
    return 3;
  }

  int32_t first_value = 1;
  int32_t middle_value = 5;
  int32_t last_value = 9;
  int32_t below = 0;
  int32_t gap = 6;
  int32_t above = 10;
  if (!std::binary_search(values.begin(), values.end(), first_value) ||
      !std::binary_search(values.begin(), values.end(), middle_value) ||
      !std::binary_search(values.begin(), values.end(), last_value) ||
      std::binary_search(values.begin(), values.end(), below) ||
      std::binary_search(values.begin(), values.end(), gap) ||
      std::binary_search(values.begin(), values.end(), above)) {
    return 4;
  }

  mut std::vector<int32_t> empty{};
  if (std::binary_search(empty.begin(), empty.end(), first_value)) {
    return 5;
  }

  int32_t exact_value = 3;
  mut audit_iterator exact_found = std::find(
      audit_iterator(std::size_t(0)), audit_iterator(std::size_t(4)),
      exact_value);
  if (*exact_found != 3 ||
      std::count(audit_iterator(std::size_t(0)),
                 audit_iterator(std::size_t(4)), exact_value) != 1) {
    return 6;
  }

  sum_values returned_sum = std::for_each(
      audit_iterator(std::size_t(0)), audit_iterator(std::size_t(4)),
      sum_values());
  int32_t extra = 5;
  returned_sum(extra);
  if (algorithm_sum != 15) {
    return 7;
  }

  mut std::vector<int32_t> source = std::vector<int32_t>({5, 1, 4, 2});
  mut std::vector<int32_t> destination =
      std::vector<int32_t>(std::size_t(4));
  std::copy(source.begin(), source.end(), destination.begin_mut());
  if (destination[std::size_t(0)] != 5 || destination[std::size_t(3)] != 2) {
    return 8;
  }

  int32_t nine = 9;
  std::fill(destination, nine);
  if (destination[std::size_t(0)] != 9 || destination[std::size_t(3)] != 9) {
    return 9;
  }

  mut std::vector<int32_t> doubled = std::vector<int32_t>(std::size_t(4));
  std::transform(source, doubled,
                 [](int32_t& value) -> int32_t { return value * 2; });
  if (doubled[std::size_t(0)] != 10 || doubled[std::size_t(2)] != 8) {
    return 10;
  }

  std::sort(source);
  if (source[std::size_t(0)] != 1 || source[std::size_t(1)] != 2 ||
      source[std::size_t(2)] != 4 || source[std::size_t(3)] != 5) {
    return 11;
  }

  std::reverse(source);
  if (source[std::size_t(0)] != 5 || source[std::size_t(3)] != 1) {
    return 12;
  }
  return 0;
}
