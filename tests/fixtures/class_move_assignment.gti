#include <std/string>

mut int32_t drops_total = 0;
mut int32_t dropped_tag_sum = 0;

class tracked {
 public:
  tracked(int32_t tag) : tag_(tag) {}
  ~tracked() {
    drops_total = drops_total + 1;
    dropped_tag_sum = dropped_tag_sum + this.tag_;
  }
  int32_t tag() { return this.tag_; }

 private:
  int32_t tag_;
};

class pair {
 public:
  pair(int32_t first, int32_t second) : first_(first), second_(second) {}
  int32_t first() { return this.first_; }
  int32_t second() { return this.second_; }

 private:
  int32_t first_;
  int32_t second_;
};

int32_t check_string_move() {
  mut std::string target = std::string("first");
  mut std::string replacement = std::string("second");
  target = std::move(replacement);
  if (target == "second") {
    return 0;
  }
  return 1;
}

int32_t check_tracked_move() {
  {
    mut tracked target = tracked(1);
    mut tracked replacement = tracked(2);
    target = std::move(replacement);
    if (target.tag() != 2) {
      return 1;
    }
    // The replaced value (tag 1) dropped exactly once at the assignment;
    // neither moved-from shell ran the destructor body.
    if (drops_total != 1 || dropped_tag_sum != 1) {
      return 2;
    }
  }
  // Scope exit dropped only the surviving value (tag 2) exactly once.
  if (drops_total != 2 || dropped_tag_sum != 3) {
    return 3;
  }
  return 0;
}

int32_t check_conditional_move() {
  mut std::string target = std::string("first");
  if (target.size() > 2) {
    mut std::string replacement = std::string("second");
    target = std::move(replacement);
  }
  if (target == "second") {
    return 0;
  }
  return 1;
}

int32_t check_passive_copy_assignment() {
  mut pair target = pair(1, 2);
  mut pair replacement = pair(3, 4);
  target = replacement;
  if (target.first() != 3 || target.second() != 4 ||
      replacement.first() != 3) {
    return 1;
  }
  return 0;
}

int main() {
  int32_t string_move = check_string_move();
  if (string_move != 0) {
    return string_move;
  }
  int32_t tracked_move = check_tracked_move();
  if (tracked_move != 0) {
    return 10 + tracked_move;
  }
  int32_t conditional_move = check_conditional_move();
  if (conditional_move != 0) {
    return 20 + conditional_move;
  }
  int32_t passive_copy = check_passive_copy_assignment();
  if (passive_copy != 0) {
    return 30 + passive_copy;
  }
  return 0;
}
