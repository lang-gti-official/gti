#include <std/cthread>
#include <std/thread>
using Transform = (int32_t) -> int32_t;
extern "C" {
  int32_t confined_mode();
  int32_t confined_invoke(Transform callback, int32_t value);
  int32_t confined_foreign(Transform callback);
  void confined_save(Transform callback);
  int32_t confined_saved();
  int32_t confined_zero();
  void confined_clean();
}
class Guard { public: Guard() {} ~Guard() { confined_clean(); } };
[[thread_confined_callback]] int32_t identity(int32_t value) { return value; }
[[thread_confined_callback]] int32_t worker_identity(int32_t value) { return value; }
[[thread_confined_callback]] int32_t failure(int32_t value) {
  Guard guard{};
  return value / confined_zero();
}
[[thread_confined_callback]] int32_t nested(int32_t value) {
  unsafe { return confined_invoke(identity, value); }
}
int main() {
  int32_t mode = confined_mode();
  Transform callback = identity;
  if (mode == 1) { unsafe { return confined_foreign(callback); } }
  if (mode == 2) { unsafe { return confined_invoke(failure, 1); } }
  if (mode == 0) {
    unsafe {
      if (confined_invoke(callback, 7) != 7) { return 1; }
      if (confined_invoke(nested, 9) != 9) { return 2; }
      if (confined_invoke(identity, 11) != 11) { return 3; }
    }
  }
  mut std::thread_result<int32_t> worker{};
  auto started = worker.start([mode]() -> int32_t {
    if (mode == 3) {
      // The conversion itself must fail, even though its result is unused.
      Transform wrong = identity;
      return 3;
    }
    unsafe {
      if (mode == 4) { return confined_invoke(failure, 1); }
      if (mode == 5) { confined_save(worker_identity); return 0; }
      return confined_invoke(worker_identity, 0);
    }
  });
  if (!started.has_value()) { return 4; }
  auto joined = worker.join();
  if (!joined.has_value()) { return 5; }
  if (mode == 5) { return confined_saved(); }
  return joined.value();
}
