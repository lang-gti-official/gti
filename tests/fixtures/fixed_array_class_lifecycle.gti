mut bool constructed_first = false;
mut bool constructed_second = false;
mut bool constructed_third = false;
mut bool destroyed_first = false;
mut bool destroyed_second = false;
mut bool destroyed_third = false;

class leaf {
public:
  leaf() {}
  mut int32_t value = 7;
};

class implicit_leaf {
public:
  mut int32_t value = 11;
public:
  implicit_leaf() = default;
};

class empty {
public:
  empty() {}
};

class item {
public:
  item() {
    if (!constructed_first) {
      constructed_first = true;
    } else if (!constructed_second) {
      constructed_second = true;
    } else {
      constructed_third = true;
    }
  }

  ~item() {
    if (!destroyed_first) {
      destroyed_first = true;
    } else if (!destroyed_second) {
      destroyed_second = true;
    } else {
      destroyed_third = true;
    }
  }
};

mut int32_t counted_constructions = 0;
mut int32_t counted_destructions = 0;

class counted {
public:
  counted() { counted_constructions = counted_constructions + 1; }
  ~counted() { counted_destructions = counted_destructions + 1; }
  mut int32_t value = 3;
};

mut leaf global_leaves[2] = {};
mut leaf global_grid[2][2] = {};

int main() {
  mut leaf local_leaves[2] = {};
  mut implicit_leaf local_implicit_leaves[2] = {};
  mut empty local_empty[2] = {};
  if (global_leaves[std::size_t(0)].value != 7 ||
      local_leaves[std::size_t(1)].value != 7 ||
      local_implicit_leaves[std::size_t(0)].value != 11) {
    return 3;
  }

  // Multidimensional fixed arrays share the flat form's per-leaf default
  // construction, element access, and reverse-order destruction (issue #145).
  mut leaf local_grid[2][2] = {};
  mut leaf local_cube[2][1][2] = {};
  local_grid[0][1].value = 21;
  if (global_grid[1][1].value != 7 || local_grid[0][1].value != 21 ||
      local_grid[1][0].value != 7 || local_cube[1][0][1].value != 7) {
    return 4;
  }

  {
    mut counted counted_grid[2][2] = {};
    if (counted_constructions != 4 || counted_destructions != 0 ||
        counted_grid[1][1].value != 3) {
      return 5;
    }
  }
  if (counted_constructions != 4 || counted_destructions != 4) {
    return 6;
  }

  {
    mut item items[3] = {};
    if (!constructed_first || !constructed_second || !constructed_third ||
        destroyed_first || destroyed_second || destroyed_third) {
      return 1;
    }
  }
  return destroyed_first && destroyed_second && destroyed_third ? 0 : 2;
}
