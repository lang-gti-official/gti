#include <std/string>
#include <std/vector>

class Resource {
  int identity;
public:
  Resource(int identity) : identity(identity) {}
  ~Resource() { std::println(this.identity); }
  int read() { return this.identity; }
};

int consume<F>(F callback, int value) {
  return callback();
}

int main(int argc, std::vector<std::string> argv) {
  Resource caller{9};
  Resource capture{7};
  int divisor = argc == 2 ? 0 : 1;
  return consume([capture = std::move(capture)]() -> int {
    return capture.read();
  }, 12 / divisor) - 7;
}
