import std.panic;
mut int trace = 0;
class Marker {
  int value;
public:
  [[inline]] Marker(int value) : value(value) {}
  int read() { return this.value; }
  [[cold, noinline]] ~Marker() { trace = trace * 10 + this.value; }
};
thread_local Marker early{1};
thread_local Marker late{2};
[[noreturn]] void report_invalid_coordinate(uint8_t row, uint8_t column) {
  Marker local{5};
  std::panic("Invalid coordinate: row={}, column={}", row, column);
}
struct Coordinate {
  Marker field;
  uint8_t row;
  uint8_t column;
  [[inline]] Coordinate(uint8_t row, uint8_t column) : field(Marker(4)), row(row), column(column) {
    if (row >= 9 || column >= 9) { report_invalid_coordinate(row, column); }
  }
};
int main() {
  [[discard]] early.read();
  [[discard]] late.read();
  Marker local{3};
  {
    Coordinate valid{8, 7};
    if (valid.row != 8 || valid.column != 7) { std::panic("incorrect valid coordinate"); }
  }
  if (trace != 4) { std::panic("incorrect successful cleanup"); }
  trace = 0;
  Coordinate invalid{9, 2};
  trace = 9999;
  return 0;
}
