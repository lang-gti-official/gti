import std.string;
import std.numeric;

extern "C" {
  int32_t square_mode();
  int64_t square_input();
}

class SquareCleanup {
public:
  SquareCleanup() {}
  ~SquareCleanup() { std::println(99); }
};

int32_t square32(int32_t value) { return value * value + int32_t(7); }
int32_t weighted32(int32_t value) { return (value * int32_t(3)) * value + int32_t(7); }
int64_t square64(int64_t value) { return value * value + int64_t(7); }
uint64_t unsigned64(uint64_t value) { return value * value + uint64_t(7); }
uint32_t unsigned32(uint32_t value) { return value * value + uint32_t(7); }
int32_t different(int32_t left, int32_t right) { return left * right + int32_t(7); }
int32_t different_weighted(int32_t left, int32_t right) {
  return (left * int32_t(3)) * right + int32_t(7);
}
int32_t wrapped_weighted(int32_t value) {
  return std::wrapping_mul(value, int32_t(3)) * value + int32_t(7);
}

int main() {
  SquareCleanup cleanup{};
  int32_t mode = square_mode();
  int64_t input = square_input();
  if (mode < 4) { std::println(square32(int32_t(input))); }
  else if (mode < 8) { std::println(weighted32(int32_t(input))); }
  else if (mode < 12) { std::println(square64(input)); }
  else if (mode < 14) { std::println(unsigned64(uint64_t(input))); }
  else if (mode == 14) { std::println(different(1, int32_t(input))); }
  else if (mode == 15) {
    int32_t result = wrapped_weighted(int32_t(input));
    if (result >= 0) { return 50; }
    std::println(result);
  }
  else if (mode == 16) { std::println(different_weighted(int32_t(input), 1)); }
  else if (mode < 19) { std::println(unsigned32(uint32_t(input))); }
  else if (mode < 21) { std::println(square32(int32_t(input))); }
  else if (mode == 21) { std::println(weighted32(int32_t(input))); }
  else { std::println(unsigned64(uint64_t(input))); }
  return 0;
}
