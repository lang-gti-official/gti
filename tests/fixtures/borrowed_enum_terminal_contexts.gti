import std.panic;
import std.string;
import std.vector;

enum Observed<lifetime data> { ready(int&<data> owner), missing };
// The accessors name the stored region: a view outlives its observation.
class Observation<lifetime data> {
  mut Observed<data> state;
public:
  Observation(int&<data> owner) : state(Observed::ready(owner)) {}
  Observation() : state(Observed::missing) {}
  int&<data> view() {
    switch (this.state) {
    case Observed::ready(auto& owner): return owner;
    case Observed::missing: std::panic("missing observation");
    }
  }
  int&<data> take() && {
    switch (this.state) {
    case Observed::ready(auto& owner): return owner;
    case Observed::missing: std::panic("missing consumed observation");
    }
  }
};
class Guard {
public:
  ~Guard() { std::println(99); }
public:
  Guard() = default;
};
int accept(int& value) { return value; }
int&<a> reference_path<lifetime a>(int&<a> value) {
  auto absent = Observation();
  return absent.view();
}
int main(int argc, std::vector<std::string> argv) {
  Guard guard{};
  int owner = 42;
  if (argc == 1) {
    auto present = Observation(owner);
    return present.view() - 42;
  }
  if (argc == 2) {
    auto absent = Observation();
    int& ref = absent.view();
    return ref;
  }
  if (argc == 3) {
    auto absent = Observation();
    return accept(absent.view());
  }
  if (argc == 4) {
    mut auto absent = Observation();
    return std::move(absent).take();
  }
  return reference_path(owner);
}
