class Lens {
  int& value;
public:
  Lens(int& value) : value(value) {}
  int read() { return this.value; }
};

Lens view(int& value) { return Lens(value); }
Lens relay(int& value) { return Lens(Lens(view(value))); }

int main() {
  int owner = 7;
  Lens result = Lens((relay(owner)));
  return result.read() == 7 ? 0 : 1;
}
