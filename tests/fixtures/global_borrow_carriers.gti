// User-defined carriers that borrow static storage. Each result's complete
// dependency contract names the global itself, whether the carrier is a
// payload enum or a class over one.
enum lookup_state<T> { found(T payload), missing };

class lookup<T> {
  mut lookup_state<T> state;
public:
  implicit lookup(T value) : state(lookup_state<T>::found(std::move(value))) {}
  lookup(bool) : state(lookup_state<T>::missing) {}
};

class lookup<T&> {
  mut lookup_state<T&> state;
public:
  implicit lookup(T& value) : state(lookup_state<T&>::found(value)) {}
  lookup(bool) : state(lookup_state<T&>::missing) {}

  bool present() {
    switch (this.state) {
    case lookup_state<T&>::found: return true;
    case lookup_state<T&>::missing: return false;
    }
  }

  T read_or(T fallback) {
    switch (this.state) {
    case lookup_state<T&>::found(auto& value): return value;
    case lookup_state<T&>::missing: return fallback;
    }
  }

  T take_or(T fallback) && {
    switch (this.state) {
    case lookup_state<T&>::found(auto& value): return value;
    case lookup_state<T&>::missing: return fallback;
    }
  }
};

enum slot { item(int32_t& value), empty };

int32_t global_value = 19;

lookup<int32_t&> find_global(bool present) {
  if (!present) {
    return lookup<int32_t&>(false);
  }
  return global_value;
}

lookup<int32_t&> find_parameter(int32_t& value, bool present) {
  if (!present) {
    return lookup<int32_t&>(false);
  }
  return value;
}

slot select_global(bool present) {
  if (!present) {
    return slot::empty;
  }
  return slot::item(global_value);
}

// Consuming a read-only carrier, fresh or moved, transfers its shell; it
// does not claim exclusive access to the owner another carrier still reads.
int32_t consume_while_borrowed(int32_t& owner) {
  auto first = find_parameter(owner, true);
  int32_t fresh = find_parameter(owner, true).take_or(0);
  auto second = find_parameter(owner, true);
  int32_t moved = std::move(second).take_or(0);
  return first.read_or(0) + fresh + moved;
}

int32_t consume_global_while_borrowed() {
  auto first = find_global(true);
  auto second = find_global(true);
  int32_t moved = std::move(second).take_or(0);
  int32_t fresh = find_global(true).take_or(0);
  return first.read_or(0) + moved + fresh;
}

bool occupied(slot value) {
  switch (value) {
  case slot::item: return true;
  case slot::empty: return false;
  }
}

int main() {
  auto found = find_global(true);
  if (!found.present() || found.read_or(0) != 19) {
    return 1;
  }
  auto missing = find_global(false);
  if (missing.present() || missing.read_or(5) != 5) {
    return 2;
  }
  int32_t local = 4;
  auto parameter = find_parameter(local, true);
  if (parameter.read_or(0) != 4) {
    return 3;
  }
  if (consume_while_borrowed(local) != 12 ||
      consume_global_while_borrowed() != 57) {
    return 5;
  }
  auto selected = select_global(true);
  auto empty = select_global(false);
  if (!occupied(selected) || occupied(empty)) {
    return 4;
  }
  return 0;
}
