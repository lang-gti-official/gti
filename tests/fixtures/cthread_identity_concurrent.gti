import std.cthread;
import std.thread;
import std.atomic;

std::atomic<uint64_t> observed{uint64_t(0)};

int32_t worker(void* context) {
  std::thrd_t identity = std::thrd_current();
  observed.store(identity);
  std::thrd_yield();
  return std::thrd_equal(identity, std::thrd_current()) == 1 ? 42 : 7;
}

int main() {
  std::thrd_t initial = std::thrd_current();
  mut std::thrd_t previous = initial;
  for (mut int index = 0; index < 32; index++) {
    mut std::thread_result<uint64_t> managed = std::thread_result<uint64_t>();
    auto started = managed.start([]() -> uint64_t { return std::thrd_current(); });
    if (!started.has_value()) { return 1; }
    auto joined = managed.join();
    if (!joined.has_value()) { return 2; }
    std::thrd_t managed_id = joined.value();
    if (managed_id == 0 || managed_id == initial || managed_id == previous) { return 3; }
    mut std::thrd_t handle = 0;
    mut int32_t result = 0;
    unsafe {
      if (std::thrd_create(handle, worker, nullptr) != std::thrd_success) { return 4; }
      if (std::thrd_join(handle, result) != std::thrd_success) { return 5; }
      if (std::thrd_join(managed_id, nullptr) != std::thrd_error) { return 6; }
      if (std::thrd_join(initial, nullptr) != std::thrd_error) { return 7; }
    }
    if (result != 42 || std::thrd_equal(handle, observed.load()) != 1) { return 8; }
    if (handle == managed_id || handle == initial || handle == previous) { return 9; }
    previous = handle;
  }
  return std::thrd_equal(initial, std::thrd_current()) == 1 ? 0 : 10;
}
