import std.mutex;

extern "C" {
  void gti_test_program_ready();
  int32_t gti_test_program_gate(int32_t stage);
  void gti_test_program_tls_observe();
}

class Local {
public:
  void touch() {}
  ~Local() { gti_test_program_tls_observe(); }
public:
  Local() = default;
};
thread_local Local local{};

int32_t before = 12 / gti_test_program_gate(0);

class Box {
  std::mutex<int32_t> value;
public:
  Box() : value(std::mutex<int32_t>(7)) {
    int32_t checked = 12 / gti_test_program_gate(1);
  }
};

Box first{};
class Registry {
public:
  static Box last{};
public:
  Registry() = default;
};

int32_t after = 12 / gti_test_program_gate(2);

int main() {
  gti_test_program_ready();
  local.touch();
  int32_t checked = 12 / gti_test_program_gate(3);
