#include <std/json>
#include <std/string>

class Response {
public:
  std::string body() { return std::string("{\"token\":\"owned\"}"); }
};

expected<std::string, int> token(Response& response) {
  mut auto parsed = std::json::parse(response.body().view());
  if (!parsed) return unexpected(1);
  auto found = parsed.value().get_string("token");
  if (!found) return unexpected(2);
  return found.value().clone();
}

int main() {
  Response response{};
  auto result = token(response);
  return result && result.value() == "owned" ? 0 : 1;
}
