import std.algorithm;
import std.vector;

class difference {
public:
  int32_t operator()(int32_t& left, int32_t& right) {
    return left - right;
  }
public:
  difference() = default;
};

int main() {
  mut std::vector<int32_t> values = std::vector<int32_t>({2, 1});
  std::sort(values, difference());
  return 0;
}
