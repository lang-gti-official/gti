import std.resource_vector;
import std.resource;
import std.memory;
import std.numeric;
import std.string;
import std.vector;
import std.panic;

mut int live_items = 0;
mut int destroyed_items = 0;
mut int destruction_order = 0;

class Item {
  std::string text;
  int id;
public:
  Item(int id) : text(std::string("owned")), id(id) { live_items++; }
  int value() { return this.id; }
  ~Item() {
    live_items--;
    destroyed_items += this.id;
    destruction_order = destruction_order * 10 + this.id;
  }
};

struct Counts {
  mut uint64_t attempts = 0;
  mut uint64_t acquisitions = 0;
  mut uint64_t releases = 0;
  mut uint64_t first_bytes = 0;
  mut uint64_t second_alignment = 0;
  mut int live_at_release = 0;
  mut void* addresses[8] = {};
  mut uint64_t extents[8] = {};
  mut uint64_t alignments[8] = {};
  mut uint64_t native_ids[8] = {};
  mut uint64_t live_regions = 0;
public:
  Counts() = default;
};

// A source-defined resource makes the exact region policy observable. Its
// stronger descriptor alignment must survive subsequent prefix growth.
[[no_transfer, no_share]]
class RecordingResource {
  std::process_resource process{};
  uint64_t budget;
  uint64_t identity;
  mut std::unique_ptr<Counts> counts;
  mut Counts* state = nullptr;
public:
  RecordingResource(uint64_t budget, uint64_t identity)
      : budget(budget), identity(identity), counts(std::make_unique<Counts>()) {
    this.state = &*this.counts;
  }
  unsafe expected<std::raw_allocation, std::alloc_errc> allocate(std::layout request) {
    unsafe {
      this.state->attempts++;
      if (this.state->attempts == uint64_t(1)) {
        this.state->first_bytes = request.bytes;
      }
      if (this.state->attempts == uint64_t(2)) {
        this.state->second_alignment = request.alignment;
      }
      if (this.state->acquisitions == this.budget) {
        return unexpected(std::alloc_errc::resource_exhausted);
      }
      mut uint64_t alignment = request.alignment;
      if (alignment < uint64_t(64)) { alignment = uint64_t(64); }
      uint64_t index = this.state->acquisitions;
      if (index >= uint64_t(8)) { std::panic("unexpected resource allocation"); }
      auto allocated = this.process.allocate(std::layout(request.bytes, alignment));
      if (!allocated) { return unexpected(allocated.error()); }
      std::raw_allocation actual = std::move(allocated).value();
      this.state->addresses[index] = actual.address;
      this.state->extents[index] = actual.bytes;
      this.state->alignments[index] = actual.alignment;
      this.state->native_ids[index] = actual.id;
      this.state->live_regions |= uint64_t(1) << index;
      this.state->acquisitions++;
      // Provider identity and region identity are both visible to the owner.
      // Release must preserve this full returned descriptor, not just counts.
      uint64_t id = this.identity * uint64_t(16) + index + uint64_t(1);
      return std::raw_allocation(actual.address, actual.bytes, actual.alignment, id);
    }
  }
  unsafe void release(std::raw_allocation allocation) {
    unsafe {
      if (allocation.id / uint64_t(16) != this.identity) {
        std::panic("wrong resource provider"); // wrong-provider
      }
      uint64_t region = allocation.id % uint64_t(16);
      if (region == uint64_t(0) || region > this.state->acquisitions) {
        std::panic("wrong resource region identity"); // wrong-region
      }
      uint64_t index = region - uint64_t(1);
      uint64_t bit = uint64_t(1) << index;
      if ((this.state->live_regions & bit) == uint64_t(0)) {
        std::panic("duplicate resource release"); // duplicate-release
      }
      if (allocation.address != this.state->addresses[index] ||
          allocation.bytes != this.state->extents[index] ||
          allocation.alignment != this.state->alignments[index]) {
        std::panic("mismatched resource descriptor"); // descriptor-mismatch
      }
      // Mark retirement before the native release; a repeated descriptor can
      // never be accepted even if the native allocator reuses its address.
      this.state->live_regions &= ~bit;
      this.state->releases++;
      this.state->live_at_release = live_items;
      this.process.release(std::raw_allocation(allocation.address,
          allocation.bytes, allocation.alignment, this.state->native_ids[index]));
    }
  }
  uint64_t attempts() { unsafe { return this.state->attempts; } }
  uint64_t acquisitions() { unsafe { return this.state->acquisitions; } }
  uint64_t releases() { unsafe { return this.state->releases; } }
  uint64_t first_bytes() { unsafe { return this.state->first_bytes; } }
  uint64_t second_alignment() { unsafe { return this.state->second_alignment; } }
  int live_at_release() { unsafe { return this.state->live_at_release; } }
  std::raw_allocation descriptor(uint64_t index) {
    unsafe {
      if (index >= this.state->acquisitions) { std::panic("missing resource region"); }
      uint64_t id = this.identity * uint64_t(16) + index + uint64_t(1);
      return std::raw_allocation(this.state->addresses[index],
          this.state->extents[index], this.state->alignments[index], id);
    }
  }
  ~RecordingResource() {
    unsafe {
      if (this.state->live_regions != uint64_t(0) ||
          this.state->acquisitions != this.state->releases) {
        std::panic("resource descriptor leaked");
      }
    }
  }
};

// Test the source slot policy directly: public reserve deliberately skips an
// already sufficient allocation, so it cannot exercise allocation rejection.
int initial_prefix_publication(std::resource_ref<RecordingResource> resource,
                               bool explicit_alignment) {
  mut gti_internal::prefix_slots<int, std::detail::resource_lease<RecordingResource>> values{
      std::detail::resource_lease<RecordingResource>(resource)};
  if (!values.try_allocate(uint64_t(0)) ||
      !values.try_allocate(uint64_t(0), uint64_t(128)) ||
      values.length() != uint64_t(0) || values.capacity() != uint64_t(0) ||
      resource.get().attempts() != uint64_t(0)) { return 40; }
  if (explicit_alignment) {
    if (!values.try_allocate(uint64_t(2), uint64_t(128))) { return 41; }
  } else {
    if (!values.try_allocate(uint64_t(2))) { return 42; }
  }
  if (values.length() != uint64_t(0) || values.capacity() != uint64_t(2) ||
      resource.get().acquisitions() != uint64_t(1)) { return 43; }
  values.append(91);
  auto rejected = values.try_allocate(uint64_t(4));
  auto rejected_aligned = values.try_allocate(uint64_t(0), uint64_t(128));
  if (rejected || rejected.error() != std::alloc_errc::invalid_state ||
      rejected_aligned || rejected_aligned.error() != std::alloc_errc::invalid_state ||
      values.length() != uint64_t(1) || values.capacity() != uint64_t(2) ||
      values.read(uint64_t(0)) != 91 || resource.get().attempts() != uint64_t(1) ||
      resource.get().releases() != uint64_t(0)) { return 44; }
  return 0;
}

int failed_initial_allocation(std::resource_ref<RecordingResource> resource) {
  mut gti_internal::prefix_slots<int, std::detail::resource_lease<RecordingResource>> values{
      std::detail::resource_lease<RecordingResource>(resource)};
  auto failed = values.try_allocate(uint64_t(2));
  auto failed_aligned = values.try_allocate(uint64_t(2), uint64_t(128));
  if (failed || failed.error() != std::alloc_errc::resource_exhausted ||
      failed_aligned || failed_aligned.error() != std::alloc_errc::resource_exhausted ||
      values.length() != uint64_t(0) || values.capacity() != uint64_t(0) ||
      resource.get().attempts() != uint64_t(2) ||
      resource.get().acquisitions() != uint64_t(0) ||
      resource.get().releases() != uint64_t(0)) { return 45; }
  return 0;
}

int failed_growth(std::resource_ref<RecordingResource> resource) {
  mut std::resource_vector<Item, RecordingResource> values{resource};
  if (!values.try_reserve(std::size_t(0)) || resource.get().attempts() != 0) { return 1; }
  auto overflow = values.try_reserve(std::MAX_UINT64);
  if (overflow || overflow.error() != std::alloc_errc::size_overflow ||
      resource.get().attempts() != 0) { return 2; }
  if (!values.try_reserve(std::size_t(1)) || resource.get().acquisitions() != 1 ||
      resource.get().first_bytes() != std::layout_of<Item>().bytes) { return 3; }
  if (!values.try_emplace_back(7)) { return 4; }
  auto growth = values.try_reserve(std::size_t(8));
  if (growth || growth.error() != std::alloc_errc::resource_exhausted ||
      values.size() != std::size_t(1) || values.capacity() != std::size_t(1) ||
      values.front().value() != 7 || live_items != 1 || destroyed_items != 0 ||
      resource.get().acquisitions() != 1 || resource.get().releases() != 0 ||
      resource.get().second_alignment() != uint64_t(64)) { return 5; }
  auto pushed = values.try_push_back(Item(9));
  if (pushed || pushed.error() != std::alloc_errc::resource_exhausted ||
      values.size() != std::size_t(1) || values.front().value() != 7 ||
      live_items != 1 || destroyed_items != 9 ||
      resource.get().attempts() != 3 || resource.get().releases() != 0) { return 6; }
  return 0;
}

int growth_and_reuse(std::resource_ref<RecordingResource> resource) {
  mut std::resource_vector<Item, RecordingResource> values{resource};
  if (!values.try_reserve(std::size_t(2))) { return 10; }
  values.emplace_back(1);
  values.emplace_back(2);
  if (!values.try_reserve(std::size_t(8)) || values.size() != std::size_t(2) ||
      values.capacity() != std::size_t(8) || values.front().value() != 1 ||
      values.back().value() != 2 || live_items != 2 || destroyed_items != 0 ||
      resource.get().acquisitions() != 2 || resource.get().releases() != 1 ||
      resource.get().live_at_release() != 2 ||
      resource.get().second_alignment() != uint64_t(64)) { return 11; }
  mut int sum = 0;
  for (auto& value : values) { sum += value.value(); }
  if (sum != 3) { return 12; }
  values.clear();
  if (!values.empty() || values.capacity() != std::size_t(8) ||
      live_items != 0 || destruction_order != 21 || resource.get().releases() != 1) { return 13; }
  values.emplace_back(3);
  values.release();
  if (!values.empty() || values.capacity() != std::size_t(0) || live_items != 0 ||
      destroyed_items != 6 || resource.get().releases() != 2 ||
      resource.get().live_at_release() != 0) { return 14; }
  values.emplace_back(4);
  auto moved = std::move(values);
  if (moved.size() != std::size_t(1) || moved.front().value() != 4 ||
      resource.get().acquisitions() != 3) { return 15; }
  return 0;
}

// Exercise the observation guard itself. These deliberately malformed unsafe
// release attempts must panic before returning any native bytes. Both vectors
// then clean up their original descriptors through their original providers;
// their destructors verify this even on the terminal-failure path.
int reject_descriptor(std::string_view mode) {
  RecordingResource first{uint64_t(1), uint64_t(5)};
  RecordingResource second{uint64_t(1), uint64_t(6)};
  unsafe {
    auto first_binding = std::bind_resource(first);
    auto second_binding = std::bind_resource(second);
    mut std::resource_vector<int, RecordingResource> left{first_binding};
    mut std::resource_vector<int, RecordingResource> right{second_binding};
    left.push_back(7);
    right.push_back(9);
    std::raw_allocation original = first.descriptor(uint64_t(0));
    if (mode == "wrong-provider") { second.release(original); }
    if (mode == "address") {
      first.release(std::raw_allocation(nullptr, original.bytes, original.alignment, original.id));
    }
    if (mode == "extent") {
      first.release(std::raw_allocation(original.address, original.bytes + uint64_t(1), original.alignment, original.id));
    }
    if (mode == "alignment") {
      first.release(std::raw_allocation(original.address, original.bytes, original.alignment * uint64_t(2), original.id));
    }
    if (mode == "identity") {
      first.release(std::raw_allocation(original.address, original.bytes, original.alignment, original.id + uint64_t(1)));
    }
    if (mode == "duplicate") {
      left.release();
      first.release(original);
    }
  }
  return 99;
}

mut int published_drops = 0;
class PublishedValue {
  int value;
public:
  PublishedValue(int value) : value(value) {}
  int read() { return this.value; }
  ~PublishedValue() { published_drops = published_drops * 10 + this.value; }
};

bool published_prefix() {
  {
    mut std::detail::prefix_owner<PublishedValue> values{uint64_t(3)};
    unsafe {
      PublishedValue* first = values.address();
      std::construct_at(first, 1);
      std::construct_at(first + uint64_t(1), 2);
      values.set_initialized_length_unchecked(uint64_t(2));
    }
    if (values.length() != uint64_t(2) || values.read(uint64_t(1)).read() != 2 ||
        published_drops != 0) { return false; }
    values.clear();
    if (published_drops != 21) { return false; }
    unsafe {
      std::construct_at(values.address(), 3);
      values.set_initialized_length_unchecked(uint64_t(1));
    }
  }
  return published_drops == 213;
}

int main(int argc, std::vector<std::string> argv) {
  if (argc > 1) { return reject_descriptor(argv[std::size_t(1)].view()); }
  if (!published_prefix()) { return 80; }
  {
    RecordingResource resource{uint64_t(0), uint64_t(7)};
    unsafe {
      auto binding = std::bind_resource(resource);
      int status = failed_initial_allocation(binding);
      if (status != 0) { return status; }
    }
    if (resource.acquisitions() != uint64_t(0) || resource.releases() != uint64_t(0)) { return 46; }
  }
  {
    RecordingResource resource{uint64_t(2), uint64_t(8)};
    unsafe {
      auto binding = std::bind_resource(resource);
      int ordinary = initial_prefix_publication(binding, false);
      if (ordinary != 0) { return ordinary; }
    }
    if (resource.acquisitions() != uint64_t(1) || resource.releases() != uint64_t(1)) { return 47; }
  }
  {
    RecordingResource resource{uint64_t(2), uint64_t(9)};
    unsafe {
      auto binding = std::bind_resource(resource);
      int aligned = initial_prefix_publication(binding, true);
      if (aligned != 0) { return aligned; }
    }
    if (resource.acquisitions() != uint64_t(1) || resource.releases() != uint64_t(1)) { return 48; }
  }
  {
    RecordingResource resource{uint64_t(1), uint64_t(1)};
    unsafe {
      auto binding = std::bind_resource(resource);
      int status = failed_growth(binding);
      if (status != 0) { return status; }
    }
    if (live_items != 0 || destroyed_items != 16 || resource.acquisitions() != 1 ||
        resource.releases() != 1 || resource.live_at_release() != 0) { return 7; }
  }
  destroyed_items = 0;
  destruction_order = 0;
  {
    RecordingResource resource{uint64_t(3), uint64_t(2)};
    unsafe {
      auto binding = std::bind_resource(resource);
      int status = growth_and_reuse(binding);
      if (status != 0) { return status; }
    }
    if (live_items != 0 || destroyed_items != 10 || resource.acquisitions() != 3 ||
        resource.releases() != 3 || resource.live_at_release() != 0) { return 16; }
  }
  {
    RecordingResource first{uint64_t(1), uint64_t(3)};
    RecordingResource second{uint64_t(1), uint64_t(4)};
    unsafe {
      auto first_binding = std::bind_resource(first);
      auto second_binding = std::bind_resource(second);
      mut std::resource_vector<Item, RecordingResource> left{first_binding};
      mut std::resource_vector<Item, RecordingResource> right{second_binding};
      left.emplace_back(5);
      right.emplace_back(6);
      auto moved = std::move(left);
      if (moved.front().value() != 5 || right.front().value() != 6 ||
          first.acquisitions() != 1 || second.acquisitions() != 1) { return 17; }
    }
    if (live_items != 0 || destroyed_items != 21 ||
        first.releases() != 1 || second.releases() != 1) { return 18; }
  }
  return 0;
}
