import std.vector;
import std.string;
import std.span;
import std.memory;

std::span<T> relay_span<T>(std::span<T> view) requires std::storage_element<T> {
  return std::move(view);
}

std::span<T> move_span<T>(std::span<T> view) requires std::storage_element<T> {
  return std::move(view);
}

std::string_view relay_string_view(std::string_view view) {
  return view;
}

int32_t sum_span(std::span<int32_t> view) {
  mut int32_t result = 0;
  for (int32_t value : view) {
    result += value;
  }
  return result;
}

int32_t main() {
  mut std::vector<int32_t> values =
      std::vector<int32_t>({1, 2, 3, 4});
  {
    std::span<int32_t> complete = values.as_span();
    std::span<int32_t> middle = complete.subspan(std::size_t(1),
                                                 std::size_t(2));
    std::span<int32_t> copied = middle;
    std::span<int32_t> relayed =
        relay_span<int32_t>(std::move(copied));
    mut std::span<int32_t> moved =
        move_span<int32_t>(std::move(relayed));
    std::span<int32_t> sum_input = moved;
    int32_t sum = sum_span(std::move(sum_input));
    if (moved.size() != 2 || moved.empty() || moved.front() != 2 ||
        moved.back() != 3 || moved[std::size_t(1)] != 3 ||
        sum != 5) {
      return 1;
    }
  }

  values.push_back(5);
  {
    std::span<int32_t> complete = values.as_span();
    std::span<int32_t> empty = complete.first(std::size_t(0));
    std::span<int32_t> sum_input = empty;
    int32_t sum = sum_span(std::move(sum_input));
    if (!empty.empty() || empty.size() != 0 || sum != 0) {
      return 2;
    }
  }

  mut std::string text = std::string("span");
  {
    std::span<char> characters = text.as_span();
    std::span<char> suffix = characters.last(std::size_t(2));
    if (characters.size() != 4 || characters.front() != 's' ||
        suffix.front() != 'a') {
      return 3;
    }
  }
  text.push_back('!');
  {
    std::string_view direct = text.view();
    std::string_view copied = direct;
    std::string_view relayed = relay_string_view(copied);
    if (direct.size() != 5 || direct.empty() || direct[0] != 's' ||
        relayed[4] != '!') {
      return 4;
    }
  }
  text.push_back('?');

  mut std::string empty_text = std::string("");
  {
    std::string_view empty_view = empty_text.view();
    if (!empty_view.empty() || empty_view.size() != 0) {
      return 5;
    }
  }
  empty_text.push_back('x');
  return text.size() == 6 && empty_text.size() == 1 ? 0 : 6;
}
