import std.string_view;
import std.memory;
unsafe std::string_view select_text(int& first, int& second, const char* bytes) {
  unsafe { return std::assume_string_view(bytes, std::size_t(3), second); }
}
std::string_view relay_text(int& first, int& second, const char* bytes) {
  unsafe { return select_text(first, second, bytes); }
}
int main() {
  int first = 11;
  int second = 22;
  char bytes[5] = {'x', 'a', '\0', 'b', 'y'};
  const char* data = &bytes[std::size_t(1)];
  std::string_view result = relay_text(first, second, data);
  return result.size() == std::size_t(3) && result == "a\0b" ? 0 : 1;
}
