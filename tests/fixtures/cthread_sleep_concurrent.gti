#include <std/cthread>
#include <std/thread>

int32_t worker(void* ignored) {
  std::timespec duration = std::timespec(int64_t(0), int64_t(1));
  return std::thrd_sleep(duration);
}

int main() {
  mut std::thread_result<int32_t> managed = std::thread_result<int32_t>();
  auto started = managed.start([]() -> int32_t {
    return std::thrd_sleep(std::timespec(int64_t(0), int64_t(1)));
  });
  if (!started.has_value()) { return 1; }
  auto joined = managed.join();
  if (!joined.has_value() || joined.value() != 0) { return 2; }
  mut std::thrd_t manual = 0;
  mut int32_t result = -1;
  unsafe {
    if (std::thrd_create(manual, worker, nullptr) != std::thrd_success) { return 3; }
    if (std::thrd_join(manual, result) != std::thrd_success) { return 4; }
  }
  return result == 0 ? 0 : 5;
}
