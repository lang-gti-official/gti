unsafe int& checked_identity(int& value) {
  return value;
}

mut int released = 0;

struct Cleanup {
  ~Cleanup() { released += 1; }
public:
  Cleanup() = default;
};

int main() {
  int value = 42;
  {
    Cleanup guard{};
    unsafe {
      if (checked_identity(value) != 42) {
        return 1;
      }
    }
  }
  return released == 1 ? 0 : 2;
}
