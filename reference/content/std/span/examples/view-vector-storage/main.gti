#include <std/span>
#include <std/vector>

int main() {
  mut std::vector<int32_t> values =
      std::vector<int32_t>({2, 4, 6, 8});
  {
    std::span<int32_t> complete = values.as_span();
    std::span<int32_t> middle =
        complete.subspan(std::size_t(1), std::size_t(2));
    if (middle.size() != 2 || middle.front() != 4 || middle.back() != 6) {
      return 1;
    }
  }
  values.push_back(10);
  return values.size() == 5 ? 0 : 2;
}
