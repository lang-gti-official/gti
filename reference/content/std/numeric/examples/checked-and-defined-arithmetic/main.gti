#include <std/numeric>

int main() {
  mut auto sum = std::checked_add(int32_t(20), int32_t(22));
  if (!sum || sum.value() != 42 ||
      std::checked_mul(uint8_t(200), uint8_t(2)).has_value() ||
      std::wrapping_add(int8_t(127), int8_t(1)) != int8_t(-128) ||
      std::saturating_mul(uint8_t(200), uint8_t(2)) != uint8_t(255) ||
      std::gcd(int32_t(-54), int32_t(24)) != 6 ||
      std::lcm(int32_t(0), int32_t(0)) != 0 ||
      std::lcm(int32_t(-6), int32_t(8)) != 24 ||
      std::midpoint(int32_t(5), int32_t(2)) != 4 ||
      std::midpoint(int32_t(2), int32_t(5)) != 3 ||
      std::midpoint(int32_t(-2147483648), int32_t(2147483647)) != -1 ||
      std::midpoint<double>(1.0d, 2.0d) != 1.5d ||
      std::MAX_UINT64 != uint64_t(18446744073709551615)) {
    return 1;
  }
  return 0;
}
