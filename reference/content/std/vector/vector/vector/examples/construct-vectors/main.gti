#include <std/vector>

int main() {
  std::vector<int32_t> empty = std::vector<int32_t>();
  std::vector<int32_t> sized =
      std::vector<int32_t>(std::size_t(3));
  mut std::vector<int32_t> values =
      std::vector<int32_t>({4, 7, 9});
  std::vector<int32_t> moved = std::move(values);

  std::println(empty.size());
  std::println(sized.size());
  std::println(moved[std::size_t(1)]);
  return 0;
}
