#include <std/vector>

int main() {
  std::vector<int32_t> values =
      std::vector<int32_t>({2, 4, 6});
  mut auto cursor = values.begin();
  auto finish = values.end();
  mut std::size_t count = std::size_t(0);

  while (cursor != finish) {
    count++;
    ++cursor;
  }

  std::println(count);
  return 0;
}
