#include <std/vector>

int main() {
  mut std::vector<int32_t> values =
      std::vector<int32_t>({4, 7, 9});
  values.push_back(12);

  mut int32_t total = 0;
  for (int32_t value : values) {
    total += value;
  }

  std::println(total);
  std::println(values.size());
  mut std::vector<int32_t> other = std::vector<int32_t>();
  values.swap(other);
  if (!values.empty() || other.back() != 12) { return 1; }
  return 0;
}
