#include <std/vector>

int main() {
  std::vector<int32_t> values =
      std::vector<int32_t>({2, 4, 6});
  mut auto cursor = values.begin();
  auto finish = values.end();
  mut int32_t total = 0;

  while (cursor != finish) {
    total += *cursor;
    ++cursor;
  }

  std::println(total);
  return 0;
}
