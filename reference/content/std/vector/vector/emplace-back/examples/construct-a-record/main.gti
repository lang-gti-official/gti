#include <std/vector>

class Reading {
  int32_t measurement;
  int32_t channel;

public:
  Reading(int32_t value, int32_t source)
      : measurement(value), channel(source) {}

  int32_t combined() {
    return this.measurement + this.channel;
  }
};

int main() {
  mut std::vector<Reading> readings = std::vector<Reading>();
  {
    mut Reading& added = readings.emplace_back(7, 2);
    std::println(added.combined());
  }
  return 0;
}
