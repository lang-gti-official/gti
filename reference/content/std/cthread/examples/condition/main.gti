#include <std/cthread>

int main() {
  mut std::cnd_t condition = 0;
  mut std::mtx_t mutex = 0;
  unsafe {
    if (std::cnd_init(condition) != std::thrd_success) { return 1; }
    if (std::mtx_init(mutex, std::mtx_plain) != std::thrd_success) {
      std::cnd_destroy(condition);
      return 2;
    }
    if (std::mtx_lock(mutex) != std::thrd_success) {
      std::mtx_destroy(mutex);
      std::cnd_destroy(condition);
      return 3;
    }
    std::timespec expired = std::timespec(int64_t(0), int64_t(0));
    int32_t waited = std::cnd_timedwait(condition, mutex, expired);
    int32_t unlocked = std::mtx_unlock(mutex);
    std::cnd_destroy(condition);
    std::mtx_destroy(mutex);
    if (waited != std::thrd_timedout || unlocked != std::thrd_success) { return 4; }
  }
  return 0;
}
