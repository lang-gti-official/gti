#include <std/cthread>

std::once_flag flag{std::ONCE_FLAG_INIT};
std::atomic<int32_t> initialized{0};

void initialize() {
  initialized.store(initialized.load() + 1);
}

int main() {
  unsafe {
    std::call_once(flag, initialize);
    std::call_once(flag, initialize);
  }
  return initialized.load() == 1 ? 0 : 1;
}
