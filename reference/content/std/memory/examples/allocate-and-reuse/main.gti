#include <std/memory>

int main() {
  mut auto created = std::try_make_pool<int32_t>(std::size_t(2));
  if (!created) {
    return 1;
  }
  mut std::pool<int32_t> values = std::move(created).value();
  mut auto first = values.try_insert(int32_t(7));
  mut auto second = values.try_insert(int32_t(9));
  if (!first || !second || values.get(first.value()) != 7) {
    return 2;
  }

  values.erase(first.value());
  mut auto reused = values.try_insert(int32_t(11));
  if (!reused || reused.value() != first.value() ||
      values.get(reused.value()) != 11) {
    return 3;
  }
  return 0;
}
