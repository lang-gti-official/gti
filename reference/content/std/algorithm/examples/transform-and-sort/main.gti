#include <std/algorithm>
#include <std/vector>

int main() {
  mut std::vector<int32_t> source =
      std::vector<int32_t>({5, 1, 4, 2});
  mut std::vector<int32_t> destination =
      std::vector<int32_t>(std::size_t(4));

  std::copy(source.begin(), source.end(), destination.begin_mut());
  std::transform(source, destination,
                 [](int32_t& value) -> int32_t { return value * 2; });
  std::sort(destination);
  std::reverse(destination);

  if (destination[std::size_t(0)] != 10 ||
      destination[std::size_t(3)] != 2) {
    return 1;
  }
  return 0;
}
