#include <std/optional>

int main() {
  mut std::optional<int32_t> value{};
  if (value.has_value()) {
    return 1;
  }

  [[discard]] value.emplace(int32_t(41));
  mut int32_t& stored = value.value();
  stored += int32_t(1);
  if (!value || *value != int32_t(42)) {
    return 2;
  }

  value.reset();
  return value.value_or(int32_t(7)) == int32_t(7) ? 0 : 3;
}
