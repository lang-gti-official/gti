{
  "name": "@gti/reference",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "api:generate": "tsx scripts/generate-api-index.ts",
    "content:generate": "tsx scripts/generate-content.ts",
    "content:check": "tsx scripts/generate-content.ts --check",
    "examples:verify": "tsx scripts/verify-examples.ts",
    "examples:contract-smoke": "tsx scripts/verify-examples.ts --content test/fixtures/valid-project/content --api .cache/documentation-index.json",
    "predev": "pnpm content:generate",
    "dev": "next dev",
    "prebuild": "pnpm content:generate",
    "build": "next build",
    "typecheck": "pnpm content:generate && tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.2",
    "gray-matter": "4.0.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/mdx": "2.0.14",
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
