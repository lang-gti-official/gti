// title: Pathname decomposition
// unit: filesystem
// std::filesystem::path is pure pathname manipulation, decomposed the same
// way C++ defines it. No filesystem access is involved.

#include <std/filesystem>
#include <std/string>

int main() {
  mut std::filesystem::path archive = std::filesystem::path();
  archive.assign("/data/logs/build.tar.gz");

  mut std::filesystem::path name = archive.filename();
  mut std::string nameText = name.string();
  std::print("filename:  ");
  std::print(nameText);
  std::print('\n');

  mut std::filesystem::path base = archive.stem();
  mut std::string baseText = base.string();
  std::print("stem:      ");
  std::print(baseText);
  std::print('\n');

  mut std::filesystem::path suffix = archive.extension();
  mut std::string suffixText = suffix.string();
  std::print("extension: ");
  std::print(suffixText);
  std::print('\n');

  mut std::filesystem::path parent = archive.parent_path();
  mut std::string parentText = parent.string();
  std::print("parent:    ");
  std::print(parentText);
  std::print('\n');
  return 0;
}
