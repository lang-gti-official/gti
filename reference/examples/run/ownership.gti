// title: Explicit ownership
// unit: string
// std::string is a move-only owner: copying is never implicit. A transfer is
// spelled std::move, and a duplicate is spelled clone().

#include <std/string>

int main() {
  mut std::string original = std::string("owned text");

  // An explicit duplicate: both values are independently owned.
  mut std::string copy = original.clone();
  copy.append(" (copy)");

  std::print(original);
  std::print('\n');
  std::print(copy);
  std::print('\n');

  // An explicit transfer: `moved` owns the buffer now.
  mut std::string moved = std::move(original);
  std::print(moved);
  std::print('\n');
  return 0;
}
