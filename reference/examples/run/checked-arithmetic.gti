// title: Checked-by-default arithmetic
// unit: numeric
// Plain arithmetic is checked: overflow is a defined runtime failure, never
// silent wraparound. When wrapping or saturating behaviour is intended, the
// program says so with the explicit families from <std/numeric>.

#include <std/numeric>

int main() {
  uint8_t nearMax = 250;

  // Explicit wraparound: 250 + 10 wraps to 4 in eight bits.
  uint8_t wrapped = std::wrapping_add(nearMax, uint8_t(10));
  std::print("wrapping_add(250, 10) = ");
  std::print(wrapped);
  std::print('\n');

  // Explicit saturation: the result clamps to the maximum instead.
  uint8_t clamped = std::saturating_add(nearMax, uint8_t(10));
  std::print("saturating_add(250, 10) = ");
  std::print(clamped);
  std::print('\n');

  // The checked family reports overflow as a value instead of failing.
  expected<uint8_t, std::arithmetic_errc> sum =
      std::checked_add(nearMax, uint8_t(10));
  if (!sum.has_value()) {
    std::println("checked_add(250, 10) reports out-of-range");
  }
  return 0;
}
