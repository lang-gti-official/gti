export module glfw;

// GTI binding for the public GLFW 3.4 C API.
//
// Generated against the official GLFW 3.4 glfw3.h:
// https://github.com/glfw/glfw/blob/3.4/include/GLFW/glfw3.h
//
// Native linkage is owned by this package's gti.toml. Consumers declare the
// package dependency and import its registered glfw module through their alias.
//
// ABI notes:
// - GLFW's C int and unsigned int are mapped to int32_t and uint32_t.
// - GLFW's size_t allocator arguments are uint64_t on GTI's supported 64-bit
//   native targets.
// - The Vulkan aliases match the 64-bit Vulkan ABI used by GTI targets.
// - GTI callback adapters are same-thread callbacks. GLFW documents that its
//   error callback may run on any thread, so do not pass a GTI free function as
//   GLFWerrorfun unless the call is guaranteed to re-enter on the registering
//   thread. A true native function pointer remains ABI-safe.
//
// This binding is derived from GLFW, which is distributed under the zlib/libpng
// license. Copyright (c) 2002-2006 Marcus Geelnard and
// Copyright (c) 2006-2019 Camilla Löwy.

export [[c_opaque]] struct GLFWmonitor;
export [[c_opaque]] struct GLFWwindow;
export [[c_opaque]] struct GLFWcursor;
export [[c_opaque]] struct VkAllocationCallbacks;

export using VkInstance = void*;
export using VkPhysicalDevice = void*;
export using VkSurfaceKHR = uint64_t;
export using VkResult = int32_t;

export using GLFWglproc = () -> void;
export using GLFWvkproc = () -> void;
export using PFN_vkVoidFunction = () -> void;
export using PFN_vkGetInstanceProcAddr = (VkInstance, c_string) -> PFN_vkVoidFunction;

export using GLFWallocatefun = (uint64_t, void*) -> void*;
export using GLFWreallocatefun = (void*, uint64_t, void*) -> void*;
export using GLFWdeallocatefun = (void*, void*) -> void;
export using GLFWerrorfun = (int32_t, c_string) -> void;
export using GLFWwindowposfun = (GLFWwindow*, int32_t, int32_t) -> void;
export using GLFWwindowsizefun = (GLFWwindow*, int32_t, int32_t) -> void;
export using GLFWwindowclosefun = (GLFWwindow*) -> void;
export using GLFWwindowrefreshfun = (GLFWwindow*) -> void;
export using GLFWwindowfocusfun = (GLFWwindow*, int32_t) -> void;
export using GLFWwindowiconifyfun = (GLFWwindow*, int32_t) -> void;
export using GLFWwindowmaximizefun = (GLFWwindow*, int32_t) -> void;
export using GLFWframebuffersizefun = (GLFWwindow*, int32_t, int32_t) -> void;
export using GLFWwindowcontentscalefun = (GLFWwindow*, float, float) -> void;
export using GLFWmousebuttonfun = (GLFWwindow*, int32_t, int32_t, int32_t) -> void;
export using GLFWcursorposfun = (GLFWwindow*, double, double) -> void;
export using GLFWcursorenterfun = (GLFWwindow*, int32_t) -> void;
export using GLFWscrollfun = (GLFWwindow*, double, double) -> void;
export using GLFWkeyfun = (GLFWwindow*, int32_t, int32_t, int32_t, int32_t) -> void;
export using GLFWcharfun = (GLFWwindow*, uint32_t) -> void;
export using GLFWcharmodsfun = (GLFWwindow*, uint32_t, int32_t) -> void;
export using GLFWdropfun = (GLFWwindow*, int32_t, c_string *) -> void;
export using GLFWmonitorfun = (GLFWmonitor*, int32_t) -> void;
export using GLFWjoystickfun = (int32_t, int32_t) -> void;

export [[c_abi]] struct GLFWvidmode {
  int32_t width;
  int32_t height;
  int32_t redBits;
  int32_t greenBits;
  int32_t blueBits;
  int32_t refreshRate;
};

export [[c_abi]] struct GLFWgammaramp {
  uint16_t* red;
  uint16_t* green;
  uint16_t* blue;
  uint32_t size;
};

export [[c_abi]] struct GLFWimage {
  int32_t width;
  int32_t height;
  uint8_t* pixels;
};

export [[c_abi]] struct GLFWgamepadstate {
  uint8_t buttons[15];
  float axes[6];
};

export [[c_abi]] struct GLFWallocator {
  GLFWallocatefun allocate;
  GLFWreallocatefun reallocate;
  GLFWdeallocatefun deallocate;
  void* user;
};

