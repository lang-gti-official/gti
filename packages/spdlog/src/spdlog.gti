}

sink_ptr ringbuffer_sink_st(std::size_t capacity) {
  return ringbuffer_sink_mt(capacity);
}

expected<sink_ptr, errc> basic_file_sink_mt(std::string_view filename,
                                             bool truncate = false) {
  expected<std::unique_ptr<std::FILE>, std::io_errc> opened =
      std::fopen(filename,
                 truncate ? std::file_mode::write : std::file_mode::append);
  if (!opened) { return unexpected(errc::open_failed); }
  mut auto concrete = std::make_shared<sinks::basic_file_sink_mt>(
      std::move(opened).value());
  return std::upcast_shared<sinks::sink, sinks::basic_file_sink_mt>(
      std::move(concrete));
}

expected<sink_ptr, errc> basic_file_sink_st(std::string_view filename,
                                             bool truncate = false) {
  return basic_file_sink_mt(filename, truncate);
}

expected<sink_ptr, errc>
rotating_file_sink_mt(std::string_view filename, std::size_t maximum_size,
                      std::size_t maximum_files,
                      bool rotate_on_open = false) {
  if (maximum_size == std::size_t(0) ||
      maximum_files == std::size_t(0)) {
    return unexpected(errc::invalid_argument);
  }
  expected<std::unique_ptr<std::FILE>, std::io_errc> opened =
      std::fopen(filename, std::file_mode::append);
  if (!opened) { return unexpected(errc::open_failed); }
  expected<uint64_t, std::filesystem::errc> measured =
      std::filesystem::file_size(filename);
  if (!measured) { return unexpected(errc::io_error); }
  std::size_t initial_size = std::size_t(measured.value());
  mut auto concrete = std::make_shared<sinks::rotating_file_sink_mt>(
      filename, maximum_size, maximum_files, initial_size,
      std::move(opened).value());
  if (rotate_on_open && initial_size > std::size_t(0)) {
    expected<void, errc> rotated = concrete->rotate_now();
    if (!rotated) { return unexpected(rotated.error()); }
  }
  return std::upcast_shared<sinks::sink, sinks::rotating_file_sink_mt>(
      std::move(concrete));
}

expected<sink_ptr, errc>
rotating_file_sink_st(std::string_view filename, std::size_t maximum_size,
                      std::size_t maximum_files,
                      bool rotate_on_open = false) {
  return rotating_file_sink_mt(filename, maximum_size, maximum_files,
                               rotate_on_open);
}

logger_ptr make_logger(std::string_view name, sink_ptr target) {
  return std::make_shared<logger>(name, std::move(target));
}

logger_ptr stdout_logger_mt(std::string_view name) {
  return make_logger(name, stdout_sink_mt());
}

logger_ptr stdout_logger_st(std::string_view name) {
  return stdout_logger_mt(name);
}

logger_ptr stderr_logger_mt(std::string_view name) {
  return make_logger(name, stderr_sink_mt());
}

logger_ptr stderr_logger_st(std::string_view name) {
  return stderr_logger_mt(name);
}

logger_ptr stdout_color_mt(std::string_view name,
                           color_mode colors = color_mode::automatic) {
  return make_logger(name, stdout_color_sink_mt(colors));
}

logger_ptr stdout_color_st(std::string_view name,
                           color_mode colors = color_mode::automatic) {
  return stdout_color_mt(name, colors);
}

logger_ptr stderr_color_mt(std::string_view name,
                           color_mode colors = color_mode::automatic) {
  return make_logger(name, stderr_color_sink_mt(colors));
}

logger_ptr stderr_color_st(std::string_view name,
                           color_mode colors = color_mode::automatic) {
  return stderr_color_mt(name, colors);
}

expected<logger_ptr, errc> basic_logger_mt(std::string_view name,
                                           std::string_view filename,
                                           bool truncate = false) {
  expected<sink_ptr, errc> target =
      basic_file_sink_mt(filename, truncate);
  if (!target) { return unexpected(target.error()); }
  return make_logger(name, std::move(target).value());
}

expected<logger_ptr, errc> basic_logger_st(std::string_view name,
                                           std::string_view filename,
                                           bool truncate = false) {
  return basic_logger_mt(name, filename, truncate);
}

expected<logger_ptr, errc>
rotating_logger_mt(std::string_view name, std::string_view filename,
                   std::size_t maximum_size, std::size_t maximum_files,
                   bool rotate_on_open = false) {
  expected<sink_ptr, errc> target = rotating_file_sink_mt(
      filename, maximum_size, maximum_files, rotate_on_open);
  if (!target) { return unexpected(target.error()); }
  return make_logger(name, std::move(target).value());
}

expected<logger_ptr, errc>
rotating_logger_st(std::string_view name, std::string_view filename,
                   std::size_t maximum_size, std::size_t maximum_files,
                   bool rotate_on_open = false) {
  return rotating_logger_mt(name, filename, maximum_size, maximum_files,
                            rotate_on_open);
}

}
