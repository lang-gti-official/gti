// Parsed fields in constructor order. Both halves of the recipe use this list.
GTI_TEMPLATE_EXPR(Assign, &Assign::path, &Assign::oper, &Assign::value)
GTI_TEMPLATE_EXPR(ArrayInitializer, &ArrayInitializer::brace, &ArrayInitializer::elements, &ArrayInitializer::closingBrace)
GTI_TEMPLATE_EXPR(Binary, &Binary::left, &Binary::oper, &Binary::right)
GTI_TEMPLATE_EXPR(Call, &Call::callee, &Call::typeArguments, &Call::paren, &Call::arguments)
GTI_TEMPLATE_EXPR(ConditionalExpr, &ConditionalExpr::condition, &ConditionalExpr::question, &ConditionalExpr::thenExpression, &ConditionalExpr::colon, &ConditionalExpr::elseExpression)
GTI_TEMPLATE_EXPR(Conversion, &Conversion::targetType, &Conversion::paren, &Conversion::value)
GTI_TEMPLATE_EXPR(DirectInitializer, &DirectInitializer::brace, &DirectInitializer::arguments, &DirectInitializer::closingBrace, &DirectInitializer::designators)
GTI_TEMPLATE_EXPR(DereferenceSet, &DereferenceSet::dereference, &DereferenceSet::object, &DereferenceSet::oper, &DereferenceSet::value)
GTI_TEMPLATE_EXPR(PlaceSet, &PlaceSet::target, &PlaceSet::oper, &PlaceSet::value)
GTI_TEMPLATE_EXPR(Get, &Get::object, &Get::access, &Get::name)
GTI_TEMPLATE_EXPR(Grouping, &Grouping::expression, &Grouping::unsafeKeyword)
GTI_TEMPLATE_EXPR(Index, &Index::object, &Index::bracket, &Index::index)
GTI_TEMPLATE_EXPR(IndexSet, &IndexSet::object, &IndexSet::bracket, &IndexSet::index, &IndexSet::oper, &IndexSet::value)
GTI_TEMPLATE_EXPR(Logical, &Logical::left, &Logical::oper, &Logical::right)
GTI_TEMPLATE_EXPR(Postfix, &Postfix::expression, &Postfix::oper)
GTI_TEMPLATE_EXPR(QualifiedName, &QualifiedName::name, &QualifiedName::ownerType)
GTI_TEMPLATE_EXPR(This, &This::keyword)
GTI_TEMPLATE_EXPR(Set, &Set::object, &Set::access, &Set::name, &Set::oper, &Set::value)
GTI_TEMPLATE_EXPR(Unary, &Unary::oper, &Unary::right)
GTI_TEMPLATE_EXPR(Variable, &Variable::name)
