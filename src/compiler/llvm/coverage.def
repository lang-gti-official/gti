// Explicit native-backend ledger. Every switch is compiled exhaustively.
// Pending is not implementation evidence. MustBeAbsent rows never erase execution.
// Executable implementation claims must use
// LLVM_COVERAGE_IMPLEMENTED("ctest", "case-or-profile"). Bare implementation
// claims are deliberately invalid: changing state must also name concrete
// acceptance evidence. Pending rows never inherit an execution test.
// LLVM_COVERAGE_IMPLEMENTED_GAP("reason") preserves an existing implementation
// classification while reporting that promotion evidence is still missing.
// The common negative drift control is llvm_coverage_exhaustiveness.

LLVM_COVERAGE_BEGIN(SemanticType::Kind)
LLVM_COVERAGE_ENTRY(Unknown, 4, VerifiedNonExecuting, MustBeAbsent, "symbolic/source-only type must not require runtime storage")
LLVM_COVERAGE_ENTRY(Void, 4, LLVM_COVERAGE_IMPLEMENTED("llvm_scalar_execution", "globals"), None, "scalar native execution; unsupported storage, ownership and dispatch remain separately gated")
