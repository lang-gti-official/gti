#include <std/iterator>
#include <std/numeric>
#include <std/vector>

concept readable_as<Iterator, T> =
    std::input_iterator<Iterator> &&
    std::accumulates_into<Iterator, T>;

T sum<Iterator, Sentinel, std::numeric T>(
    mut Iterator first, Sentinel last, mut T initial)
  requires readable_as<Iterator, T> &&
           std::sentinel_for<Sentinel, Iterator> {
  return std::accumulate(
      std::move(first), std::move(last), std::move(initial));
}

int main() {
  mut std::vector<int> values{};
  values.push_back(1);
  values.push_back(2);
  values.push_back(3);

  int total = sum(values.begin(), values.end(), 0);
  if (total == 6) {
    return 0;
  }
  return 1;
}
