mut int32_t drops = 0;

class resource {
public:
  resource(int32_t identifier) : identifier(identifier) {}
  ~resource() { drops++; }

  int32_t id() { return this.identifier; }

private:
  int32_t identifier;
};

enum class event {
  acquired(resource value),
  idle,
};

int32_t observe(event& value) {
  switch (value) {
  case event::acquired:
    return 1;
  case event::idle:
    return 0;
  }
}

void transfer_active_alternative() {
  event source = event::acquired(resource(7));
  event staged = std::move(source);
  mut event destination = event::acquired(resource(8));
  destination = std::move(staged);

  // Move-only payloads are currently observed with a tag-only pattern.
  switch (destination) {
  case event::acquired:
    break;
  case event::idle:
    break;
  }
  if (observe(destination) != 1) {
    drops = drops + 100;
  }
}

int main() {
  transfer_active_alternative();
  // Assignment drops the replaced payload, then scope exit drops the
  // transferred active payload.
  if (drops != 2) {
    return 1;
  }

  // A unit alternative owns no resource and runs no payload destructor.
  event waiting = event::idle;
  return drops == 2 ? 0 : 2;
}
