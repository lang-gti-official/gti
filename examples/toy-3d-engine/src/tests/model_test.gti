import "../engine/math.gti";
import "../engine/model.gti";
import std.memory;
int main() {
  mut std::unique_ptr<toy3d::Model> model =
      std::make_unique<toy3d::Model>();
  if (!model->load_demo()) {
    return 1;
  }
  if (model->triangle_count() != uint32_t(8)) {
    return 2;
  }

  mut float x = 0.0;
  mut float y = 0.0;
  mut float z = 0.0;
  mut float normal_x = 0.0;
  mut float normal_y = 0.0;
  mut float normal_z = 0.0;
  if (!model->vertex(uint32_t(0), uint32_t(0), x, y, z, normal_x,
                     normal_y, normal_z)) {
    return 3;
  }
  if (!toy3d::near(x, 0.0, 0.0001) ||
      !toy3d::near(y, 1.5, 0.0001) ||
      !toy3d::near(z, 0.0, 0.0001)) {
    return 4;
  }
  if (model->vertex(uint32_t(99), uint32_t(0), x, y, z, normal_x, normal_y,
                    normal_z)) {
    return 5;
  }

  model->shutdown();
  if (model->triangle_count() != uint32_t(0)) {
    return 6;
  }
  return 0;
}
