#include <std/algorithm>
#include <std/iterator>
#include <std/vector>

// A self-contained, copyable endpoint can be taken by value. The compiler
// establishes the same protocol for application types and library cursors.
class stop {
  std::size_t position_;
public:
  stop(std::size_t position) : position_(position) {}
  std::size_t position() { return this.position_; }
};
class cursor {
  fixed_readings& owner;
  mut std::size_t index;
public:
  cursor(fixed_readings& owner, std::size_t index) : owner(owner), index(index) {}
  int32_t& operator*() { return this.owner.at(this.index); }
  void operator++() mut { this.index++; }
  bool operator!=(stop end) { return this.index != end.position(); }
  std::ptrdiff_t operator-(stop end) {
    return std::ptrdiff_t(end.position()) - std::ptrdiff_t(this.index);
  }
};
class fixed_readings {
  int32_t[3] values = {2, 4, 6};
public:
  int32_t& at(std::size_t index) { return this.values[index]; }
  cursor begin() { return cursor(this, std::size_t(0)); }
  stop end() { return stop(std::size_t(3)); }
};

class readings {
  mut std::vector<int32_t> values = std::vector<int32_t>({2, 4, 6});

public:
  readings() = default;

  std::detail::vector_iterator<int32_t> begin() {
    return this.values.begin();
  }

  std::detail::vector_mut_iterator<int32_t> begin_mut() mut {
    return this.values.begin_mut();
  }

  std::detail::vector_sentinel end() {
    return this.values.end();
  }

  std::size_t size() {
    return this.values.size();
  }

  int32_t at(std::size_t index) {
    return this.values[index];
  }
};

class positive {
public:
  bool operator()(int32_t& value) {
    return value > 0;
  }
};

std::size_t measured_size<Range>(Range& range)
  requires std::sized_range<Range> {
  return range.size();
}

int main() {
  fixed_readings application{};
  mut int32_t sum = 0;
  for (int32_t reading : application) { sum += reading; }
  if (sum != 12 || std::distance(application.begin(), application.end()) != 3 ||
      !(application.begin() != application.end())) { return 3; }
  mut readings samples{};
  mut int32_t[3] fixed = {1, 3, 5};

  if (!std::all_of(samples, positive()) ||
      !std::all_of(fixed, positive())) {
    return 1;
  }

  int32_t replacement = 7;
  std::fill(samples, replacement);
  std::fill(fixed, replacement);

  return (samples.at(std::size_t(1)) == 7 && fixed[1] == 7 &&
          measured_size(samples) == std::size_t(3) &&
          measured_size(fixed) == std::size_t(3))
             ? 0
             : 2;
}
