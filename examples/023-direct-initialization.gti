class Reading<T> {
  mut T value;

public:
  Reading(T initial) : value(initial) {}

  T get() {
    return this.value;
  }

  void set(T next) mut {
    this.value = next;
  }
};

using IntReading = Reading < int >;

class Dashboard {
  mut Reading<int> initial{7};

public:
  int value() {
    return this.initial.get();
  }

  // Copyable class values can replace an initialized mutable field.
  void replace(Reading<int> next) mut {
    this.initial = next;
  }
public:
  Dashboard() = default;
};

struct DefaultReading {
  int value = 7;
public:
  DefaultReading() = default;
};

class DefaultDashboard {
public:
  DefaultReading reading = DefaultReading();
  DefaultDashboard() {}
};

struct Settings {
  int port = 80;
  DefaultReading reading{};
public:
  Settings() = default;
};

struct Indicator {
  int level = 9;
public:
  Indicator() = default;
};

struct Panel {
  // This selects real construction, not an empty or nullable state.
  Indicator indicator;
public:
  Panel() = default;
};

namespace layers {
  struct Layer<uint64_t N> {
    Layer<N - 1> inner;
    int value = 1;
   public: Layer() = default; };
}

// Exact concrete identities make this nested by-value layout finite.
struct layers::Layer<0> {
  int value = 100;
public:
  Layer() = default;
};

int main() {
  Reading<int> fixed{1};
  mut Reading<int> changing{2};
  changing.set(3);
  IntReading aliased{4};
  mut Dashboard dashboard{};
  dashboard.replace(fixed);
  // A generated default can initialize a field in a user constructor.
  DefaultDashboard defaults = DefaultDashboard();
  // Omitted designated fields retain their declaration's brace default.
  Settings settings = {.port = 8080};
  Panel panel{};
  layers::Layer<2> nested{};

  // `auto` remains the alternative when the constructor states the type.
  auto inferred = Reading<int>(5);

  if (fixed.get() == 1 && changing.get() == 3 and aliased.get() == 4 and dashboard.value() == 1 and inferred.get() == 5 and defaults.reading.value == 7 and settings.reading.value == 7 && panel.indicator.level == 9 && nested.inner.inner.value == 100) {
    return 0;
  }
  return 1;
}
