namespace math {
uint64_t multiply(uint64_t left, uint64_t right) {
  return left * right;
}

float multiply(float left, float right) {
  return left * right;
}
}

struct Label {
  std::string_view for_value(uint64_t value) {
    return "uint64_t overload";
  }

  std::string_view for_value(float value) {
    return "float overload";
  }
};

int main() {
  uint64_t whole = math::multiply(uint64_t(6), uint64_t(7));
  float decimal = math::multiply(1.5, 2.0);

  Label label = Label();
  std::println(label.for_value(whole));
  std::println(label.for_value(decimal));

  int checked = int(whole);
  if (checked != 42) {
    return 1;
  }
  return 0;
}
