// GTI supplies exact-width signed and unsigned integer types.
// The `_t` spellings are canonical; suffix-less names remain exact aliases.
int64_t combine(int8_t small, int16_t medium, int32_t regular, int64_t large) {
  return small + medium + regular + large;
}

int main() {
  int8_t small = 8;
  int16_t medium = 16;
  int32_t regular = 32;
  int64_t large = 64;
  int64_t total = combine(small, medium, regular, large);
  mut int64_t adjusted = total;
  adjusted *= 2;
  adjusted /= 2;
  adjusted %= 17;
  adjusted <<= 1;
  adjusted >>= 1;
  adjusted |= 16;
  adjusted ^= 1;
  adjusted &= 31;

  // Integer arithmetic is checked; bitwise operators use C++-like precedence.
  int64_t flags = (adjusted & 15) | 16;
  int64_t shifted = flags << 1;
  int64_t bucket = shifted % 7;

  if (bucket >= 0) {
    std::println("integer arithmetic and bit operations completed");
    return 0;
  }
  return 1;
}
