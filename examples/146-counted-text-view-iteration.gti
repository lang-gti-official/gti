// Counted views keep the same checked owner dependency during iteration.
// Import the view interface to name its public iterator aliases.
import std.string;
import std.string_view;
import std.iterator;
// An application wrapper names the public iterator types without importing
// the library's private implementation namespace.
class TextRange {
  std::string_view& text;
public:
  TextRange(std::string_view& text) : text(text) {}
  std::string_view_iterator begin() { return this.text.begin(); }
  std::string_view_sentinel end() { return this.text.end(); }
  std::string_view_reverse_iterator rbegin() { return this.text.rbegin(); }
  std::string_view_sentinel rend() { return this.text.rend(); }
};

int main() {
  std::string owner{"systems"};
  std::string_view text = owner.view();

  mut std::size_t count = 0;
  for (char& character : text) {
    if (character != text[count]) { return 1; }
    count++;
  }
  if (count != std::size_t(7)) { return 2; }

  TextRange wrapped{text};
  if (std::distance(wrapped.begin(), wrapped.end()) != std::ptrdiff_t(7)) { return 8; }
  if (std::distance(wrapped.rbegin(), wrapped.rend()) != std::ptrdiff_t(7)) { return 9; }
  mut auto reverse = wrapped.rbegin();
  if (*reverse != 's') { return 3; }
  reverse += std::ptrdiff_t(2);
  if (*reverse != 'e') { return 4; }

  mut auto cursor = text.iterator_at(std::size_t(3));
  if (*cursor != 't') { return 5; }
  --cursor;
  if (*cursor != 's') { return 6; }
  if (std::distance(text.cbegin(), text.cend()) != std::ptrdiff_t(7)) { return 7; }

  // Dereference yields a code-unit value. The loop's readonly reference names
  // one iteration-local copy, not a typed reference into the byte view.
  // Retained cursors exclude mutation/movement of a dynamic owner, and neither
  // a local view shell nor its cursor escapes.
  return 0;
}
