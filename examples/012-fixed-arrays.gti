using SampleCount = std::size_t;

int sum(int values[4]) {
  mut int total = 0;
  for (mut int index = 0; index < 4; index++) {
    total += values[index];
  }
  return total;
}

class Pair<T> {
  T values[2];

public:
  Pair(T left, T right) : values({left, right}) {}

  T first() {
    return this.values[0];
  }
};

struct Coordinate { mut int32_t x = 0;  public: Coordinate() = default; };
union NativeWord { mut int32_t integer; mut float real; };
struct Samples { mut int values[2] = {5, 8};  public: Samples() = default; };
class Coordinates {
  Coordinate values[2] = {};
public:
  int first_x() { return this.values[0].x; }
public:
  Coordinates() = default;
};

int main() {
  mut int values[4] = {1, 2, 3, 4};
  values[2] = 10;

  int grid[2][2] = {{1, 2}, {3, 4}};
  Pair<int> pair = Pair<int>(7, 8);
  SampleCount count = values.size();
  int8_t bytes[2] = {-128, -2};
  Coordinate origin{.x = 9};
  Coordinate coordinates[2] = {origin, origin};
  mut Samples samples{};
  Samples* pointer = &samples;
  // Raw record access remains unsafe; its fixed arrays remain checked.
  unsafe {
    int* last = &pointer->values[1];
    *last = 10;
    if ((*pointer).values[1] != 10) { return 1; }
  }
  Coordinates defaults{};
  if (defaults.first_x() != 0) { return 1; }
  NativeWord words[2] = {};
  // Unions are passive, but choosing and interpreting a member remains unsafe.
  unsafe {
    if (words[1].integer != 0) {
      return 1;
    }
  }

  if (count == 4 and sum(values) == 17 and grid[1][0] == 3 and
      pair.first() == 7 and bytes[0] == -128 and
      coordinates[1].x == 9) {
    std::println("fixed arrays keep their bounds");
    return 0;
  }
  return 1;
}
