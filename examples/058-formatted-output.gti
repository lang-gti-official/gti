import std.format;
import std.string;
int main() {
  // This cross-backend example opts into runtime pattern validation. On LLVM,
  // use std::format("...", args...) for compile-time literal checking.
  // Convenience formatting returns an owner; failure reports the caller and
  // terminates through GTI cleanup. No expected extraction is needed.
  auto message = std::runtime_format("frame={} score={} bounds={{}}", uint64_t(12), int32_t(-40));
  std::println(message);

  // Choose try_ when the application wants to recover from formatting or
  // stdout submission failure.
  auto written = std::try_runtime_println("lives={} coins={}", uint8_t(3), uint16_t(65535));
  if (!written) {
    return 2;
  }
  return 0;
}
