void consume<Args...>(Args... values) {}

void forward<Args...>(Args... values) {
  consume(values...);
  consume(0, values...);
}

T keep_first<T, Rest...>(T first, Rest... rest) {
  forward(rest...);
  return first;
}

class Samples {
  int values[3];
public:
  Samples(int initial[3]) : values(initial) {}
  int sum() { return this.values[0] + this.values[1] + this.values[2]; }
};

T construct<T, Args...>(Args... values) {
  return T(values...);
}

// Concrete pack lanes also select ordinary fixed-arity functions.
int add(int first, int second = 5) { return first + second; }
int add_forwarded<Args...>(Args... values) { return add(values...); }

class SumBase {
  int total;
public:
  SumBase(int first, int second) : total(first + second) {}
  int sum() { return this.total; }
};

class SumDerived : public SumBase {
public:
  SumDerived<Args...>(Args... values) : SumBase(values...) {}
};

int main() {
  forward();
  forward(1, true, "gti");

  int inferred = keep_first(7, false, "tail");
  int explicit_types = keep_first<int, std::string_view>(9, "tail");

  // Passive fixed arrays retain their value and exact extent through the pack.
  int seed[3] = {1, 2, 3};
  Samples copied = construct<Samples>(seed);
  forward(seed); // Each expansion copies the array; seed remains available.

  SumDerived inherited{2, 4};

  if (inferred == 7 and explicit_types == 9 and copied.sum() == 6 and
      add_forwarded(3) == 8 and inherited.sum() == 6) {
    return 0;
  }
  return 1;
}
