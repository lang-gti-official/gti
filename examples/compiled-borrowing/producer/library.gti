export module borrowed_api;

export struct Sample { mut int value = 0; };

export int&<a> read<lifetime a>(int&<a> value) { return value; }
export mut int&<a> edit<lifetime a>(mut int&<a> value) { return value; }
export int load(int& value) { return value; }
export void store(mut int& value, int next) { value = next; }
export int&<a> choose<lifetime a>(int& first, int&<a> second) {
    return second;
}
export Sample&<a> read_sample<lifetime a>(Sample&<a> value) { return value; }
export mut Sample&<a> edit_sample<lifetime a>(mut Sample&<a> value) { return value; }
export int load_sample(Sample& value) { return value.value; }
