// Every public std.name unit is an explicit module. Importing exposes only
// that module's exported declarations: std.vector imports std.span internally,
// but std::span stays invisible here until this file imports std.span too.
// An application interface can deliberately re-export a standard module with
// `export import std.vector;`.
import std.format;
import std.string;
import std.vector;

int32_t total(std::vector<int32_t>& values) {
  mut int32_t sum = 0;
  for (int32_t value : values) {
    sum = sum + value;
  }
  return sum;
}

int main() {
  mut std::vector<int32_t> values{};
  values.push_back(19);
  values.push_back(23);
  std::string source = std::string("standard modules");
  std::println(std::format("{} values from {}", values.size(), source.view()));
  std::println(std::format("total {}", total(values)));
  return 0;
}
