concept signed_value<T> =
    std::signed_numeric<T> && std::copyable<T>;

T absolute<signed_value T>(T value) {
  if (value < T(0)) {
    return T(-value);
  }
  return value;
}

// A unary structural annotation supplies exact operations throughout the
// class, including its cleanup body. This is not an interface or inheritance.
concept readable<T> = requires(T& source) { { source.read() } -> int; };
struct Meter { int read() { return 7; } };
mut int final_sample = 0;
class Session<readable T> {
  T& source;
public:
  Session(T& source) : source(source) {}
  int read() { return this.source.read(); }
  ~Session() { final_sample = this.source.read(); }
};

// All guaranteed trailing-clause facts are available when admitting a
// dependent compound argument; their source order does not define the proof.
class Box<std::copyable T> {
  T value;
public:
  Box(T value) : value(value) {}
  T get() { return this.value; }
};
concept boxed_int<B> = requires(B& box) { { box.get() } -> int; };
int read_box<T>(Box<T>& box)
  requires boxed_int<Box<T>> && std::copyable<T> {
  return box.get();
}

int main() {
  Box<int> box{7};
  if (read_box(box) != 7) { return 3; }
  Meter meter{};
  { Session<Meter> session{meter}; if (session.read() != 7) { return 1; } }
  if (final_sample != 7) { return 2; }
  if (absolute(-4) == 4) {
    return 0;
  }
  return 1;
}
