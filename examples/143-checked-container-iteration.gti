#include <std/forward_list>
#include <std/vector>
#include <std/list>
#include <std/map>
#include <std/set>

int main() {
  // Shared cursors are independently positioned copies, but both retain the
  // owner. Changing or moving the owner while either is used is rejected.
  mut std::forward_list<int> jobs{};
  jobs.push_front(3);
  jobs.push_front(2);
  jobs.push_front(1);
  mut auto first = jobs.cbegin();
  auto saved = first;
  ++first;
  if (*saved != 1 || *first != 2) { return 1; }

  mut std::vector<int> values = {10, 20, 30};
  {
    // Exclusive cursors are move-only. Moving the position does not duplicate
    // permission to write; the owner becomes available again after this scope.
    auto end = values.rend();
    mut auto cursor = values.rbegin_mut();
    while (cursor != end) {
      *cursor += 1;
      ++cursor;
    }
  }
  if (values[std::size_t(0)] != 11 || values[std::size_t(2)] != 31) { return 2; }

  // Linked reverse traversal follows predecessor links rather than indexing
  // from the head. A distinct sentinel marks exhaustion without another loan.
  std::list<int> chain = {1, 2, 3};
  {
    mut auto cursor = chain.crbegin();
    auto end = chain.crend();
    mut int next_value = 3;
    while (cursor != end) {
      if (*cursor != next_value) { return 3; }
      next_value--;
      ++cursor;
    }
  }

  mut std::map<int, int> priorities{};
  [[discard]] priorities.insert(2, 20);
  [[discard]] priorities.insert(1, 10);
  [[discard]] priorities.insert(3, 30);
  {
    mut auto highest = priorities.rbegin_mut();
    highest->mapped() = 31; // Mapped values are mutable; keys are not.
  }
  int key = 3;
  if (priorities.at(key) != 31) { return 4; }

  std::set<int> ordered = {2, 1, 3};
  auto largest = ordered.rbegin();
  if (*largest != 3) { return 5; }
  std::println("Checked forward, reverse and mutable iteration");
  return 0;
}
