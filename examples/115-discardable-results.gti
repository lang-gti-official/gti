#include <std/memory>
#include <std/optional>
#include <std/string>
#include <std/vector>

// The mutation is the operation; the returned reference is optional.
struct Counter {
  mut int value = 0;

  [[discardable, borrowed_from(this)]]
  mut int& add(int amount) mut {
    this.value += amount;
    return this.value;
  }
};

// Unannotated APIs still require using or explicitly discarding the result.
int calculate() { return 42; }

int main() {
  mut Counter counter{};
  counter.add(2);
  mut int& total = counter.add(3);
  if (total != 5) { return 1; }
  // The checked borrow has ended; another mutation is now permitted.
  [[discard]] counter.add(4); // Explicit discard remains legal too.
  [[discard]] calculate();

  std::allocator allocator{};
  mut auto allocated = allocator.try_storage<int>(std::size_t(1));
  if (!allocated) { return 2; } // Allocation results are not discardable.
  mut auto slots = std::move(allocated).value();
  slots.emplace(std::size_t(0), counter.value);
  if (slots.get(std::size_t(0)) != 9) { return 3; }

  // These calls keep the new values; their returned references are optional.
  mut std::optional<std::string> slot{};
  slot.emplace("old");
  slot.emplace("new");
  if (slot.value().view() != "new") { return 4; }

  mut std::vector<int> values{};
  values.emplace_back(1);
  values.emplace_back(2); // The ignored borrow ends before this next mutation.
  {
    mut int& added = values.emplace_back(3);
    added = 4; // The same API still permits using the returned reference.
  }
  return values.back() == 4 ? 0 : 5;
}
