class Report {
  mut int value;

public:
  Report(int value) : value(value) {}

  int add(int amount) mut {
    this.value += amount;
    return this.value;
  }

  int code() { return this.value; }
};

Report make_report(int value) { return Report(value); }

// A fresh receiver may also call a virtual member, an override or an
// interface implementation. Dynamic dispatch still selects the body that runs;
// the temporary is borrowed for the call and destroyed with the statement.
interface Meter {
  int record(int amount) mut;
};

class Doubling : public Meter {
  mut int total;

public:
  Doubling(int start) : total(start) {}

  int record(int amount) mut override {
    this.total += 2 * amount;
    return this.total;
  }
};

int inspect(Report& report) { return report.code(); }

int inspect_pair(Report& first, Report& second) {
  return first.code() * 10 + second.code();
}

int main() {
  // A fresh value may use a mutable receiver for this full expression.
  int updated = Report(4).add(3);

  // A read-only reference parameter may observe a fresh self-contained value
  // for one call. The temporary is destroyed at the statement boundary.
  int observed = inspect(make_report(5));

  // Built-in assignment returns a fresh copy of the committed destination.
  // A conditional joins its selected class value into one fresh temporary.
  mut Report destination = Report(1);
  Report replacement = Report(8);
  int assigned = inspect(destination = replacement);
  int selected = inspect(true ? destination : replacement);

  // Each argument observes the copy at its written position. The second
  // assignment does not change the first temporary's snapshot.
  int snapshots = inspect_pair(destination = Report(2),
                               destination = Report(3));

  // The mutable override runs on the fresh receiver.
  int recorded = Doubling(1).record(3);

  return updated == 7 and observed == 5 and recorded == 7 and
                 assigned == 8 and selected == 8 and snapshots == 23 and
                 destination.code() == 3
             ? 0
             : 1;
}
