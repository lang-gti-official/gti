static int build_number = 24;

static int adjusted_build(int offset) {
  return build_number + offset;
}

namespace build {
  static int release_offset = 1;
}

class Session {
public:
  static int maximum = 4;
  static mut int active = 0;

  static int count() {
    return active;
  }

  ~Session() {}
};

int main() {
  Session::active = 1;
  int total = Session::count() + Session::maximum + adjusted_build(1) +
              build::release_offset;
  if (total == 31) {
    std::println("static members work");
  }
  return 0;
}
