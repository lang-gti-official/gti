#include <std/thread>
#include <std/memory>
#include <std/mutex>
#include <std/functional>
#include <std/optional>
#include <std/string>

// A passive process payload needs only native-shell retirement after workers
// and TLS finish. Source destructors/owning payloads still require local scope.
std::mutex<int> global_progress{0};

// An owning sum replaces alternatives by construction, so its payload needs
// no assignment operation. A mutex remains non-relocatable and nonassignable.
enum pending_message { empty, ready(std::mutex<std::string> message) };

class message {
  int32_t value;

public:
  message(int32_t value) : value(value) {}
  int32_t read() { return this.value; }
};

class final_task {
public:
  void operator()() { std::println("autojoin task"); }
public:
  final_task() = default;
};

// Scoped jobs can borrow existing engine data instead of allocating owners
// for it. These two jobs write disjoint fields of the same parent object.
struct positions { mut int left = 0; mut int right = 0;  public: positions() = default; };
class advance_position {
  mut int& position;
public:
  advance_position(mut int& position) : position(position) {}
  void operator()() mut { this.position += 1; }
};

int main() {
  auto first_started = std::thread::start(
      []() -> void {
        mut auto guard = global_progress.lock();
        guard.get() = 1;
        std::println("first task");
      });
  if (!first_started.has_value()) {
    return 1;
  }
  mut std::thread first = std::move(first_started).value();
  mut std::thread moved = std::move(first);
  auto first_joined = moved.join();
  if (!first_joined.has_value() || moved.joinable()) {
    return 2;
  }
  {
    auto guard = global_progress.lock();
    if (guard.get() != 1) return 2;
  }

  auto owned = std::make_unique<message>(42);
  auto second_started = std::thread::start(
      [task_message = std::move(owned)]() -> void {
        std::println(task_message->read());
      });
  if (!second_started.has_value()) {
    return 3;
  }
  mut std::thread second = std::move(second_started).value();
  auto second_joined = second.join();
  if (!second_joined.has_value()) {
    return 4;
  }

  final_task task = final_task();
  auto third_started = std::thread::start(std::move(task));
  if (!third_started.has_value()) {
    return 5;
  }
  mut std::thread third = std::move(third_started).value();

  // Dynamic shared state does not require a global. The mutex serializes
  // payload access; the shared owner keeps it alive until all workers finish.
  auto counter = std::make_shared<std::mutex<int>>(0);
  auto worker_counter = counter.clone();
  std::transfer_function<void()> job{
      [state = std::move(worker_counter)]() -> void {
        mut auto guard = state->lock();
        mut int& value = guard.get();
        value += 1;
      }};
  auto fourth_started = std::thread::start(std::move(job));
  if (!fourth_started) return 6;
  mut auto fourth = std::move(fourth_started).value();
  if (!fourth.join()) return 7;
  {
    auto guard = counter->lock();
    if (guard.get() != 1) return 8;
  }

  mut positions frame{};
  if (!std::parallel_invoke(advance_position(frame.left),
                            advance_position(frame.right))) return 9;
  // Join-all has completed, so the parent can access both fields again.
  if (frame.left != 1 || frame.right != 1) return 10;
  frame.left += frame.right;

  mut auto pending = pending_message::ready(
      std::mutex<std::string>(std::string("frame")));
  pending = pending_message::empty;
  pending = pending_message::ready(std::mutex<std::string>(std::string("next")));
  mut auto reusable = std::optional<std::mutex<std::string>>(
      std::mutex<std::string>(std::string("ready")));
  reusable.reset();
  [[discard]] reusable.emplace(std::string("again"));
  if (!reusable) return 11;

  // `third` autojoins at scope exit. GTI intentionally provides no detached
  // public thread handle in this managed-thread slice.
  return 0;
}
