#include <std/json>
#include <std/string>
#include <std/vector>

// A class with an invariant is not a plain struct, so reflection cannot build
// it field by field. A codec specialization says how the type reads and
// writes JSON; every struct that contains the type uses it automatically.
class User {
  uint64_t id_;
  std::string login_;
public:
  User(uint64_t id, std::string login) : id_(id), login_(std::move(login)) {}
  uint64_t id() { return this.id_; }
  std::string_view login() { return this.login_.view(); }
};

// The wire shape of a User: a plain struct the codec converts to and from.
struct user_record {
  uint64_t id = 0;
  std::string login = std::string("");
};

class std::json::codec<User> {
public:
  expected<void, std::json::error> encode(User& input, mut std::string& out) {
    user_record record = {.id = input.id(), .login = std::string(input.login())};
    std::string text = ?std::json::encode(record);
    out.append(text.view());
    return;
  }
  expected<User, std::json::error> decode(std::string_view text) {
    user_record record = ?std::json::decode<user_record>(text);
    return User(record.id, std::string(record.login.view()));
  }
};

struct team {
  std::string name = std::string("");
  std::vector<User> members = std::vector<User>();
};

int main() {
  auto decoded = std::json::decode<User>("{\"id\":7,\"login\":\"alice\"}");
  if (!decoded) { std::println(decoded.error().description()); return 1; }
  User user = std::move(decoded).value();
  std::println(user.login());
  auto encoded = std::json::encode(user);
  if (!encoded) { return 2; }
  std::println(encoded.value().view());

  // Containers of codec types need nothing more.
  auto roster = std::json::decode<team>(
      "{\"name\":\"core\",\"members\":[{\"id\":1,\"login\":\"one\"},{\"id\":2,\"login\":\"two\"}]}");
  if (!roster) { return 3; }
  team crew = std::move(roster).value();
  if (crew.members.size() != std::size_t(2)) { return 3; }
  for (auto& account : crew.members) { std::println(account.login()); }

  // A failure inside a codec keeps its JSON Pointer, including the element.
  auto invalid = std::json::decode<team>("{\"name\":\"core\",\"members\":[{\"id\":1}]}");
  if (invalid || invalid.error().path.view() != "/members/0/login") { return 4; }
  std::println(invalid.error().path.view());
  return 0;
}
