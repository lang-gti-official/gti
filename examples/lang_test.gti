include "math.gti"

namespace engine {
namespace graphics {
void render() {}
}
}

namespace gfx = engine::graphics;

class Box<T> {
  T value;

public:
  Box(T value) : value(value) {}
  T get() { return self.value; }
};

T identity<T>(T value) { return value; }

#if target.vendor == "apple"
string platform_name() { return "Apple"; }
#elif target.os == "windows"
string platform_name() { return "Windows"; }
#else
string platform_name() { return "Other"; }
#endif

class Counter {
  mut int value;

#if target.arch == "arm64"
  int word_bits = 64;
#else
  int word_bits = 32;
#endif

public:
  Counter(int initial) : value(initial) {}

  int tick(int amount) mut {
    self.value += amount;
    return self.value;
  }
};

struct FrameStats {
  int rendered = 0;

private:
  int dropped = 0;

public:
  int total() {
    return self.rendered + self.dropped;
  }
};

expected<int, string> load_score(bool fail) {
  if (fail) {
    return unexpected("score data is unavailable");
  }
  return 3;
}

int main() {
  std::println("GTI compiler example");
  std::println(platform_name());
  engine::graphics::render();
  gfx::render();

#if target.arch == "arm64"
  std::println("ARM64 target");
#else
  std::println("non-ARM64 target");
#endif

  expected<int, string> loaded_score = load_score(false);
  if (!loaded_score) {
    std::println(loaded_score.error());
    return 1;
  }

  Box<int> score_box = Box<int>(loaded_score.value());
  mut int score = identity(score_box.get());
  mut Counter counter = Counter(score);
  score = counter.tick(1);

  for (mut int frame = 0; frame < 5; frame++) {
    score += clamp(frame * 3, 0, 10);
  }

  while (score < 20) {
    score++;
  }

  int flags = ((score & 15) | 16) ^ 2;
  int shifted = (flags << 2) >> 1;
  int inverted = ~shifted;
  int bucket = inverted % 7;

  bool reachedTarget = score >= 20 and score != 0 and bucket <= 0;
  if (reachedTarget) {
    score += 1;
  } else {
    score = 0;
  }

  [[discard]] clamp(score, 0, 20);
  return 0;
}
