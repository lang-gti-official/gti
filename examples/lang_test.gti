include "math.gti"

namespace engine {
namespace graphics {
void render() {}
}
}

namespace gfx = engine::graphics;

#if target.vendor == "apple"
string platform_name() { return "Apple"; }
#elif target.os == "windows"
string platform_name() { return "Windows"; }
#else
string platform_name() { return "Other"; }
#endif

class Counter {
  mut int value = 0;

#if target.arch == "arm64"
  int word_bits = 64;
#else
  int word_bits = 32;
#endif

  int tick(int amount) {
    self.value += amount;
    return self.value;
  }
};

expected<int, string> load_score(bool fail) {
  if (fail) {
    return unexpected("score data is unavailable");
  }
  return 3;
}

int main() {
  std::println("GTI compiler example");
  std::println(platform_name());
  engine::graphics::render();
  gfx::render();

#if target.arch == "arm64"
  std::println("ARM64 target");
#else
  std::println("non-ARM64 target");
#endif

  expected<int, string> loaded_score = load_score(false);
  if (!loaded_score) {
    std::println(loaded_score.error());
    return 1;
  }

  mut int score = loaded_score.value();

  for (mut int frame = 0; frame < 5; frame++) {
    score += clamp(frame * 3, 0, 10);
  }

  while (score < 20) {
    score++;
  }

  bool reachedTarget = score >= 20 and score != 0;
  if (reachedTarget) {
    score += 1;
  } else {
    score = 0;
  }

  [[discard]] clamp(score, 0, 20);
  return 0;
}
