// Named nested types organize a schema without capturing an outer object.
// Reflected JSON recursively follows fields, not lexical declaration scopes.
#include <std/experimental/json>
#include <std/string>

struct Config {
  struct Network {
    std::string host = std::string("localhost");
    uint16_t port = 8080;
    struct Retry {
      uint32_t attempts = 3;
    };
    Retry retry{};
  };
  class Logging {
  public:
    bool enabled = true;
  };
  Network network{};
  Logging logging{};
};

int main() {
  Config::Network::Retry retry{.attempts = uint32_t(5)};
  mut auto decoded = std::experimental::json::decode<Config>(
      "{\"network\":{\"host\":\"example.org\",\"port\":443,"
      "\"retry\":{\"attempts\":5}},\"logging\":{\"enabled\":true}}");
  if (!decoded) {
    std::println(decoded.error().description());
    return 1;
  }
  Config config = std::move(decoded).value();
  if (config.network.retry.attempts != retry.attempts) {
    return 2;
  }
  mut auto encoded = std::experimental::json::encode(config);
  if (!encoded) {
    return 3;
  }
  std::println(encoded.value().view());
  return 0;
}
