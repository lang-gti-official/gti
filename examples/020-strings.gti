import std.string;
int main() {
  std::string_view literal = "engine";
  if (literal.size() != 6 or literal.empty() or literal[0] != 'e') {
    return 1;
  }

  mut std::string name = std::string(literal);
  name.push_back(' ');
  name.append("runtime");

  mut std::string copy = name.clone();
  copy[0] = 'E';

  // Escapes: control bytes, one hexadecimal code unit, and a Unicode scalar
  // written as UTF-8 (U+00E9 is two code units).
  std::string_view escaped = "\t\x41\u00e9";
  if (escaped.size() != 4 or escaped[1] != 'A') {
    return 1;
  }

  if (name == "engine runtime" and copy.size() == 14 and copy[0] == 'E') {
    return 0;
  }
  return 1;
}
