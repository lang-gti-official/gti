// Typed macros use ordinary calls, but force argument expressions at each use.
// There is no asynchronous work, runtime thunk, or textual token replacement.
#include <std/assert>
#include <std/string>

struct Sample {
  int value = 7;
};

struct Observations {
  static mut int value = 0;
  static mut int text_values = 0;
  static mut int bounds = 0;
  static mut int steps = 0;
};

namespace application {
  void record(int value) { Observations::value = value; }
  void record(bool value) { std::assert(value); }
  void inspect(Sample& value) { std::assert(value.value == 7); }
  void consume(std::string value) { std::assert(!value.empty()); }

  #macro report(int value = 7) { record(value); }
  #macro report(bool value) { record(value); }

  #macro when<T>(bool enabled, T value) {
    if (enabled) { report(value); }
  }

  #macro repeat(int value) { record(value); record(value); }
  #macro positive<T>(T value) requires std::numeric<T> {
    std::assert(value > T(0));
  }
  #macro inspect_when(bool enabled, Sample value) {
    if (enabled) { inspect(value); }
  }
  #macro consume_when(bool enabled, std::string value) {
    if (enabled) { consume(value); }
  }

  // An ordinary local deliberately evaluates an expression exactly once.
  // Its written name cannot capture an equally named caller argument.
  #macro record_twice_once(bool enabled, int value) {
    if (enabled) {
      int saved = value;
      record(saved + saved);
    }
  }

  #macro inspect_twice(Sample value) {
    Sample& saved = value;
    inspect(saved);
    inspect(saved);
  }

  std::string fresh_text() {
    Observations::text_values++;
    return std::string("evaluated once");
  }

  #macro keep_text_once(bool enabled, std::string value) {
    if (enabled) {
      std::string saved = value;
      std::assert(saved.view() == "evaluated once");
      std::assert(!saved.empty());
    } // The macro owns and deterministically destroys this one string.
  }

  int next_bound() { Observations::bounds++; return 6; }
  void step() { Observations::steps++; }

  #macro bounded_steps(int count) {
    int limit = count;
    for (mut int index = 0; index < limit; ++index) {
      if (index == 1) { continue; }
      if (index == 3) { break; }
      step();
    }
  }
}

int main() {
  // Body lookup belongs to application, not to this unrelated local name.
  int record = 99;
  application::report();
  std::assert(Observations::value == 7);
  application::report(true);
  application::when<int>(true, 12);
  application::positive(12);
  std::assert(Observations::value == 12);

  mut int evaluations = 0;
  application::when(false, evaluations++);
  std::assert(evaluations == 0);
  application::repeat(evaluations++);
  std::assert(evaluations == 2 && Observations::value == 1);

  // Typed expression parameters do not create eager by-value parameter copies.
  Sample sample{};
  application::inspect_when(true, sample);
  std::string owner{"still owned"};
  application::consume_when(false, std::move(owner));
  std::assert(owner.view() == "still owned");

  int saved = 9;
  application::record_twice_once(true, saved);
  std::assert(saved == 9 && Observations::value == 18);
  application::record_twice_once(false, evaluations++);
  application::record_twice_once(true, evaluations++);
  std::assert(evaluations == 3 && Observations::value == 4);

  // A named checked borrow and an owning value use ordinary GTI lifetimes.
  application::inspect_twice(sample);
  application::keep_text_once(false, application::fresh_text());
  std::assert(Observations::text_values == 0);
  application::keep_text_once(true, application::fresh_text());
  std::assert(Observations::text_values == 1);
  application::bounded_steps(application::next_bound());
  std::assert(Observations::bounds == 1 && Observations::steps == 2);
  std::assert(record == 99);
  std::println("Typed macros passed");
  return 0;
}
