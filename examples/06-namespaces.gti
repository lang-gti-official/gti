// A namespace path is shorthand for nested blocks:
// namespace engine { namespace graphics { ... } }
// The same namespaces may be reopened using either spelling.
namespace engine::graphics {
void render() {
  std::println("rendering through a qualified name");
}
}

// An alias gives a nested namespace a shorter name.
namespace gfx = engine::graphics;

int main() {
  engine::graphics::render();
  gfx::render();
  return 0;
}
