export module telemetry_api;
namespace domain { namespace telemetry {
    export struct Point { int64_t reading = 7000000000; Point() = default; };
    export Point echo(Point value) { return value; }
    export int count(int value) { return value + 2; }
    export int64_t count(int64_t value) { return value + 3; }
    int count(bool value) { if (value) { return 1; } return 0; }
} }
