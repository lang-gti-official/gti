// Source-defined contracts combine ordinary expressions with compiler-verified
// reflection facts. Checking a requirement never executes the expression.
#include <std/meta>
#include <std/memory>
#include <std/functional>
#include <std/iterator>
#include <std/algorithm>

// A source predicate can inspect a fixed generic declaration before its payload
// type is concrete. Reflection does not grant access: the expression query must
// independently prove the cursor borrow.
struct GenericCell<T> {
  T value;
  GenericCell(T initial) : value(initial) {}
  T& operator*() { return this.value; }
};
constexpr bool declares_reference<T>() {
  mut bool found = false;
  constexpr for (auto method : std::meta::lookup_operators_of<T>()) {
    if constexpr (method.name() == "operator*") {
      found = method.result().is_reference();
    }
  }
  return found;
}
concept symbolically_readable_cell<T> = declares_reference<T>() && requires(T& cell) {
  { *cell } -> auto& [[borrowed_from(cell)]];
};
int accepts_cell<symbolically_readable_cell T>(T& cell) { return 1; }
int forwards_cell<T>(GenericCell<T>& cell) { return accepts_cell(cell); }

struct Finish { int position = 8; };
struct Position {
  int position = 3;
  bool operator!=(Finish& end) { return this.position != end.position; }
  std::ptrdiff_t operator-(Finish& end) {
    return std::ptrdiff_t(this.position - end.position);
  }
};
struct IsPositive {
  bool operator()(int& value) { return value > 0; }
};
// A user-defined range uses the same loop query as an array or a library range.
struct CountEnd {};
struct CountCursor {
  mut int value = 1;
  // Value-producing iterators are materialized by the ordinary range loop.
  int operator*() { return this.value; }
  void operator++() mut { this.value++; }
  bool operator!=(CountEnd& end) { return this.value <= 3; }
};
struct Counts {
  CountCursor begin() { return CountCursor(); }
  CountEnd end() { return CountEnd(); }
  std::size_t size() { return std::size_t(3); }
};
std::size_t measured_size<R>(R& range) requires std::sized_range<R> {
  return range.size();
}
concept integer_range<R> = requires(R& range) {
  for (int& value : range) {}
};
concept positive_elements<R> = requires(R& range) {
  for (auto& element : range) {
    static_assert(requires { { IsPositive()(element) } -> bool; });
  }
};
int count_sum<R>(R& range) requires integer_range<R> {
  mut int total = 0;
  for (int& value : range) { total += value; }
  return total;
}
std::ptrdiff_t remaining<I, S>(I& position, S& end)
    requires std::sized_sentinel_for<S, I> {
  return -(position - end);
}

concept adds_to<L, R, Result> = requires(L& left, R& right) {
  { left + right } -> Result;
};

concept default_constructible<T> = requires {
  { T() } -> T;
};

concept constructed_from<T, Arg> = requires(Arg& argument) {
  { T(argument) } -> T;
};

concept invokes<F, Arg, Result> = requires(F& function, Arg& argument) {
  { function(argument) } -> Result;
};

// A reference result names the borrowed input that bounds its lifetime.
concept readable_cell<C, T> = requires(C& owner) {
  { *owner } -> T& [[borrowed_from(owner)]];
};
concept editable_cell<C, T> = requires(mut C& owner) {
  { owner.edit() } -> mut T& [[borrowed_from(owner)]];
};
concept observable_cell<C> = requires(C& owner) { { *owner }; };
concept inferred_editable_cell<C> = requires(mut C& owner) {
  { *owner } -> mut auto& [[borrowed_from(owner)]];
};
bool matches_cell<C>(C& owner, int value) requires observable_cell<C> {
  return *owner == value;
}
void assign_cell<C>(mut C& owner, int value) requires inferred_editable_cell<C> {
  *owner = value;
}
struct Cell {
  mut int value = 0;
  int& operator*() { return this.value; }
  mut int& operator*() mut { return this.value; }
  mut int& operator[](std::ptrdiff_t offset) mut { return this.value; }
  mut int& edit() mut { return this.value; }
};
[[borrowed_from(owner)]] T& peek_cell<C, T>(C& owner)
    requires readable_cell<C, T> { return *owner; }
[[borrowed_from(owner)]] mut T& edit_cell<C, T>(mut C& owner)
    requires editable_cell<C, T> { return owner.edit(); }
void put_cell<C>(mut C& owner, int value) requires std::writes_to<C, int> {
  *owner = value;
}
void put_cell_at<C>(mut C& owner, std::ptrdiff_t offset, int value)
    requires std::subscripts_to_mut<C, int> { owner[offset] = value; }

concept integer_type<T> = std::meta::is_integral<T>();
concept transferable_value<T> = std::meta::is_transferable<T>();

// Distinct alternatives retain their common facts, not the facts of either
// alternative alone. Both signed and unsigned integers support addition.
concept signed_or_unsigned<T> =
    std::meta::is_signed_integral<T>() || std::meta::is_unsigned_integral<T>();
T next_number<signed_or_unsigned T>(T value) { return value + 1; }

// A user-defined storage policy has the same facts available as std/memory.
// Borrow-free does not mean that stored raw pointers are valid or owned.
concept detached_object<T> =
    std::meta::has_object_layout<T>() && std::meta::is_borrow_free<T>();
std::uninitialized<T> empty_slot<T>()
    requires detached_object<T> && std::bitwise_relocatable<T> {
  return std::uninitialized<T>();
}

concept math_value<T> =
    adds_to<T, T, T> && std::copyable<T> && default_constructible<T>;

struct Distance {
  int value = 0;
  bool operator==(Distance& other) { return this.value == other.value; }
  bool operator!=(Distance& other) { return this.value != other.value; }
  bool operator<(Distance& other) { return this.value < other.value; }
  bool operator<=(Distance& other) { return this.value <= other.value; }
  bool operator>(Distance& other) { return this.value > other.value; }
  bool operator>=(Distance& other) { return this.value >= other.value; }
  Distance operator+(Distance& other) {
    Distance result{.value = this.value + other.value};
    return result;
  }
};

class Counter {
  int value;
public:
  Counter(int& value) : value(value) {}
  int read() { return this.value; }
};

struct Doubler {
  int operator()(int& value) { return value * 2; }
};

// A consuming operation can be queried in ordinary source. No invocation or
// cleanup runs while checking the query; the actual call owns and retires it.
concept final_task<F> = requires(F task) {
  { std::move(task)() } -> void;
};
mut int task_calls = 0;
mut int task_drops = 0;
class FinalTask {
public:
  FinalTask() {}
  FinalTask(FinalTask& other) = delete;
  FinalTask(FinalTask&& other) = default;
  ~FinalTask() { task_drops += 1; }
  void operator()() && { task_calls += 1; }
};
void finish<final_task F>(F task) { std::move(task)(); }

class RuntimeObject {
public:
  virtual int value() { return 1; }
};
// Naming a runtime-only type does not create an object of that type. This
// works for ordinary user tags as well as the library's reflection carriers.
struct TypeTag<T> {
  constexpr TypeTag() {}
  constexpr bool present() { return true; }
};
constexpr bool names_runtime_type<T>() {
  TypeTag<T> tag{};
  return tag.present();
}

// Mutation requirements describe operations on any source type, not just
// iterator categories. A query never performs the mutation itself.
concept adjustable<T> = requires(mut T& value, int amount) {
  { ++value } -> void;
  { --value } -> void;
  { value += amount } -> void;
  { value -= amount } -> void;
};
struct Tally {
  mut int value = 0;
  void operator++() mut { this.value += 1; }
  void operator--() mut { this.value -= 1; }
  void operator+=(int amount) mut { this.value += amount; }
  void operator-=(int amount) mut { this.value -= amount; }
};
struct InheritedTally : public Tally {};
class OwnedNumber {
  int value;
public:
  OwnedNumber(int value) : value(value) {}
  OwnedNumber(OwnedNumber& other) = delete;
  OwnedNumber(OwnedNumber&& other) = default;
  int read() { return this.value; }
};
struct ConsumeNumber {
  int operator()(OwnedNumber number) { return number.read(); }
};
struct AddOwnedLeft {
  int operator()(OwnedNumber number, int& extra) { return number.read() + extra; }
};
struct ArgumentForms {
  int operator()(int number) { return number; }
  int operator()(int& number) { return number + 100; }
};
int consume_integer<F>(F& callable, int number)
    requires std::read_callable<F, int, int> {
  return callable(std::move(number));
}
int consume_number<F>(F& callable, OwnedNumber number)
    requires std::read_callable<F, OwnedNumber, int> {
  return callable(std::move(number));
}
int add_owned_left<F>(F& callable, OwnedNumber number, int& extra)
    requires std::read_binary_callable<F, OwnedNumber, int, int> {
  return callable(std::move(number), extra);
}
void adjust<adjustable T>(mut T& value, int amount) {
  ++value;
  value += amount;
  --value;
  value -= amount;
}

Result invoke<F, Arg, Result>(F& function, Arg& argument)
    requires invokes<F, Arg, Result> {
  return function(argument);
}

// Inline annotation retains the complete source-defined operation contract.
T sum<math_value T>(T& left, T& right) {
  return left + right;
}

bool before<std::totally_ordered T>(T& left, T& right) { return left < right; }

T zero<T>() requires default_constructible<T> {
  return T();
}

// Compiler-verified reflection facts and source operation checks select the
// same ordinary concrete construction. The resource remains source-defined.
mut int live_resources = 0;
class DefaultResource {
public:
  DefaultResource() { live_resources += 1; }
  DefaultResource(DefaultResource& other) = delete;
  DefaultResource(DefaultResource&& other) = default;
  ~DefaultResource() { live_resources -= 1; }
};

class DefaultHolder<T> {
  T value;
public:
  DefaultHolder() requires std::default_initializable<T> : value(T()) {}
};

T default_from_fact<T>() requires std::default_initializable<T> {
  return T();
}

T construct<T, Arg>(Arg& argument) requires constructed_from<T, Arg> {
  return T(argument);
}

T twice<T>(T value) requires integer_type<T> && transferable_value<T> {
  return value + value;
}

enum class status : uint8_t { ready = 0, busy = 1 };

namespace query_hygiene {
  mut int observed = 0;
  #macro inspect(bool query) {
    bool subject = false;
    if (query) { observed += 1; }
  }
  #macro nested(bool query) {
    bool subject = false;
    inspect(query);
  }
  int check() {
    int subject = 7;
    // The macro's later bool local must not capture this caller's int local.
    inspect(requires { { subject + subject } -> int; });
    inspect(requires { { subject } -> bool; }); // false, no increment
    inspect(requires(int& subject) { { subject + subject } -> int; });
    nested(requires { { subject + subject } -> int; });
    nested(requires(int& subject) { { subject + subject } -> int; });
    inspect(requires(int& value) {
      { (requires { { value + value } -> int; }) } -> bool;
    });
    inspect(requires {
      { ([]() -> int { int subject = 2; return subject; })() } -> int;
    });
    inspect(requires(int& value) {
      { ([&value]() -> int { return value; })() } -> int;
    });
    return observed == 7 ? 0 : 1;
  }
}

int main() {
  GenericCell<int> symbolic_payload{3};
  if (forwards_cell(symbolic_payload) != 1) { return 9; }
  mut Cell inferred{};
  assign_cell(inferred, 11);
  if (!matches_cell(inferred, 11)) { return 21; }
  Counts counts{};
  static_assert(requires(Counts& range) {
    for (auto& element : range) {
      static_assert(requires { { IsPositive()(element) } -> bool; });
    }
  });
  if (count_sum(counts) != 6) { return 20; }
  int[3] fixed_counts = {1, 2, 3};
  if (measured_size(counts) != measured_size(fixed_counts)) { return 22; }
  static_assert(requires(int[3]& values) { for (auto& value : values) {} });
  static_assert(!(requires(int[3]& values) { for (mut int& value : values) {} }));
  int[3] positive_values = {1, 2, 3};
  static_assert(std::meta::is_array<int[3]>());
  if (!std::all_of(positive_values, IsPositive())) { return 21; }
  Position position{};
  Finish end{};
  if (remaining(position, end) != std::ptrdiff_t(5)) { return 20; }
  ConsumeNumber consume{};
  AddOwnedLeft add{};
  ArgumentForms forms{};
  // The moved argument selects the owned overload. A named argument would be
  // ambiguous and is still rejected by ordinary overload resolution.
  if (consume_integer(forms, 9) != 9) { return 14; }
  int extra = 5;
  if (consume_number(consume, OwnedNumber(7)) != 7 ||
      add_owned_left(add, OwnedNumber(8), extra) != 13) { return 13; }
  // Independent facts let an application choose its own erased-storage policy.
  // They do not grant permission to skip cleanup or extend a borrow.
  static_assert(std::meta::is_public_base_of<Tally, InheritedTally>());
  static_assert(!std::meta::is_public_base_of<Tally, Tally>());
  static_assert(!std::meta::has_active_cleanup<Tally>());
  static_assert(std::meta::has_active_cleanup<DefaultResource>());
  static_assert(std::meta::is_polymorphic<RuntimeObject>());
  mut Cell cell{};
  {
    mut int& value = edit_cell<Cell, int>(cell);
    value = 12;
  }
  if (peek_cell<Cell, int>(cell) != 12) { return 11; }
  put_cell(cell, 13);
  put_cell_at(cell, std::ptrdiff_t(0), 14);
  if (peek_cell<Cell, int>(cell) != 14) { return 12; }
  static_assert(!(requires(Cell& owner, Cell& other) {
    { *owner } -> int& [[borrowed_from(other)]];
  }));
  static_assert(names_runtime_type<RuntimeObject>());
  static_assert(requires(FinalTask task) {
    { std::move(task)() } -> void;
  });
  if (task_calls != 0 || task_drops != 0) { return 9; }
  finish(FinalTask());
  std::invoke_once(FinalTask());
  if (task_calls != 2 || task_drops != 2) { return 10; }
  mut Tally tally{};
  adjust(tally, 9);
  if (tally.value != 0) { return 7; }
  mut InheritedTally inherited_tally{};
  adjust(inherited_tally, 3);
  if (inherited_tally.value != 0) { return 8; }
  // Declaration-only reflection stays local; lookup reflection includes bases.
  static_assert(std::meta::type<InheritedTally>().method_count() == uint64_t(0));
  constexpr for (auto method : std::meta::lookup_operators_of<InheritedTally>()) {
    static_assert(method.is_mutating());
  }
  if (query_hygiene::check() != 0) { return 4; }
  {
    DefaultResource resource = default_from_fact<DefaultResource>();
    DefaultHolder<DefaultResource> holder{};
    if (live_resources != 2) { return 2; }
  }
  if (live_resources != 0) { return 3; }
  static_assert(std::meta::is_enum_underlying<status, uint8_t>());
  static_assert(std::meta::is_bitwise_relocatable<Distance>());
  static_assert(std::meta::has_object_layout<Distance>());
  static_assert(std::meta::is_borrow_free<Distance>());
  static_assert(!std::meta::is_borrow_free<int&>());
  // General declaration metadata is available to user-defined policies too.
  static_assert(!std::meta::method<Doubler, 0>().is_consuming());
  static_assert(!std::meta::method<Doubler, 0>().is_unsafe());
  static_assert(!std::meta::method<Doubler, 0>().is_generic());
  static_assert(!std::meta::method<Doubler, 0>().is_constrained());
  static_assert(!std::meta::has_object_layout<void>());
  auto vacant = empty_slot<Distance>();
  if (next_number<int>(3) != 4 || next_number<uint64_t>(uint64_t(7)) != uint64_t(8)) {
    return 5;
  }
  static_assert(requires(int& left, int& right) {
    { left + right } -> int;
    { left == right } -> bool;
  });
  static_assert(!(requires(Distance& value) {
    { value + value } -> bool;
  }));

  Distance left{.value = 7};
  Distance right{.value = 9};
  if (!before(left, right)) { return 6; }
  Distance total = sum(left, right);
  Distance empty = zero<Distance>();
  Doubler doubler{};
  int input = 3;
  if (invoke<Doubler, int, int>(doubler, input) != 6) { return 1; }
  int initial = 12;
  Counter counter = construct<Counter, int>(initial);
  return total.value == 16 && empty.value == 0 && counter.read() == 12 &&
                 twice(initial) == 24
             ? 0 : 1;
}
