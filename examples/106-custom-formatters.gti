import std.format;
import std.string;
namespace app {
struct AssetId { uint64_t value; };
struct Point { int x; int y; };
}

// Specializations belong to the package owning the primary or the argument
// type. The application owns AssetId and Point, so both are valid extensions.
class std::formatter<app::AssetId> {
public:
  expected<void, std::format_errc> format(app::AssetId& value,
      mut std::string& output, std::format_spec& spec) {
    // Delegate the common integer specification, including width/base/padding.
    std::formatter<uint64_t> numeric{};
    return numeric.format(value.value, output, spec);
  }
public:
  formatter() = default;
};

class std::formatter<app::Point> {
public:
  expected<void, std::format_errc> format(app::Point& value,
      mut std::string& output, std::format_spec& spec) {
    // This formatter deliberately accepts only the default presentation.
    if (spec.type != '\0' || spec.width != 0 || spec.has_precision ||
        spec.sign != '-' || spec.alternate || spec.zero_pad || spec.alignment != '\0') {
      return unexpected(std::format_errc::invalid_format);
    }
    return std::try_format_to(output, "({}, {})", value.x, value.y);
  }
public:
  formatter() = default;
};

int main() {
  app::AssetId id = {.value = uint64_t(42)};
  app::Point point = {.x = 3, .y = 7};
  std::println("asset={:08x} at {}", id, point);

  // A valid static type can still reject a dynamic format specification.
  mut std::string destination{"unchanged"};
  auto rejected = std::try_format_to(destination, "{:x}", point);
  if (rejected || rejected.error() != std::format_errc::invalid_format ||
      destination != "unchanged") {
    return 1;
  }
  return 0;
}
