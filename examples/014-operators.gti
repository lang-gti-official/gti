struct Value {
  mut int number = 0;

  void increment() mut {
    this.number += 1;
  }
public:
  Value() = default;
};

class Handle {
  mut Value object = Value();
  mut int pointed = 1;
  mut int elements[2] = {2, 3};

public:
  Value& operator->() {
    return this.object;
  }

  mut Value& operator->() mut {
    return this.object;
  }

  int& operator*() {
    return this.pointed;
  }

  mut int& operator*() mut {
    return this.pointed;
  }

  mut int& slot() mut {
    return this.pointed;
  }

  int& operator[](uint64_t index) {
    return this.elements[index];
  }

  mut int& operator[](uint64_t index) mut {
    return this.elements[index];
  }

  int operator()(uint64_t index) {
    return this.elements[index];
  }

  bool operator==(nullptr_t other) {
    return false;
  }

  bool operator!=(nullptr_t other) {
    return true;
  }

  operator bool() {
    return true;
  }
public:
  Handle() = default;
};

// Returning a mutable row composes with another selected subscript. Each
// accessor runs once; a plain store reserves the chain until its RHS reads end.
class Handles {
  mut Handle rows[2] = {};
public:
  Handles() {}
  Handle& operator[](uint64_t index) { return this.rows[index]; }
  mut Handle& operator[](uint64_t index) mut { return this.rows[index]; }
  mut Handle& get() mut { return this.rows[0]; }
};

int main() {
  mut Handle handle = Handle();
  handle->increment();
  *handle = 7;
  // A named mutable-reference accessor is writable, just like operator*.
  // Its target is evaluated once before the right operand.
  handle.slot() = 7;
  (handle.slot()) += 1;
  handle.slot() -= 1;
  *handle = *handle + 1;
  *handle -= 1;
  handle[uint64_t(1)] += 2;
  int called = handle(uint64_t(0));

  mut Handles handles{};
  handles[uint64_t(0)][uint64_t(1)] += 4;
  handles[uint64_t(1)][uint64_t(0)] =
      handles[uint64_t(0)][uint64_t(1)] + 1;
  handles.get()[uint64_t(0)] += 3;
  if (handles[uint64_t(1)][uint64_t(0)] != 8 ||
      handles[uint64_t(0)][uint64_t(0)] != 5) { return 2; }

  if (handle and handle != nullptr and !(handle == nullptr)) {
    return *handle + handle[uint64_t(1)] + called - 14;
  }
  return 1;
}
