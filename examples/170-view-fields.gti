// A value may hold a view of a named local owner in a text field. The value
// carries that owner's read-only dependency, much as a reference field
// carries its referent's, so no text is copied or allocated. Such a value can
// be copied, moved and read, and passed to functions and methods that keep
// its text within the call or return it. It cannot be returned, captured or
// stored itself. A temporary works the same way within its expression, and a
// payload enum's text payload can hold such a view too. A function that
// returns a fresh value over its text parameter hands the caller a value over
// the argument's owner. A method that returns a reference to its text field,
// even on a generic class, reads that field. A class can also hold the view
// in a payload of an enum field, as `std::optional<std::string_view>` does.
#include <std/optional>
#include <std/string>

// A token views its input; it owns no text.
class Token {
public:
  std::string_view text;
  int kind;
  Token(std::string_view text, int kind) : text(text), kind(kind) {}
  uint64_t width() { return this.text.size(); }
  // Returning the text field hands the caller a view of whatever the token
  // views.
  std::string_view spelling() { return this.text; }
  // So does returning a reference to it.
  std::string_view& textRef() { return this.text; }
};

// A generic holder's accessor reads its field in a text instance too.
class Holder<T> {
public:
  T value;
  Holder(T value) : value(value) {}
  T& get() { return this.value; }
};

// A lexeme views its input through a payload.
enum Lexeme { word(std::string_view text), number(int value) };

struct Note {
  std::string_view text;
  int column;
};

// Keeps the token's text within the call, so a relayed token is accepted.
uint64_t measure(Token token) { return token.text.size(); }

// Returns a fresh token over its text: the result views whatever the
// argument views.
Token keyword(std::string_view text) { return Token(text, 2); }

int main() {
  std::string line{"count = 42"};

  // Both values view `line`: the constructor and the designated list publish
  // its dependency at their text fields.
  Token name = Token(line.view(), 1);
  Note note{.text = line.view(), .column = 7};

  // A copy shares the dependency; reading the field yields a view of `line`.
  Token copy = name;
  std::string_view text = copy.text;
  std::println(text);
  std::println(note.column);
  std::println(measure(copy) + name.width());
  // The returned view depends on `line`, as the token does.
  std::string_view spelled = name.spelling();
  std::println(spelled);
  // A temporary token views `line` as well: its field and its returned view
  // depend on `line` beyond the temporary itself.
  std::string_view head = Token(line.view(), 2).text;
  std::println(head.size() + Token(line.view(), 3).spelling().size());
  // The factory's token views `line`, as the token it constructs does.
  Token made = keyword(line.view());
  std::println(made.spelling());
  // Reading through a returned reference views `line`, including through a
  // generic holder.
  std::println(name.textRef());
  Holder<std::string_view> holder = Holder<std::string_view>(line.view());
  std::string_view held = holder.get();
  std::println(held.size());

  // Matching the payload binds a view of `line` as well.
  Lexeme lexeme = Lexeme::word(line.view());
  switch (lexeme) {
  case Lexeme::word(word): std::println(word.size()); break;
  case Lexeme::number(value): std::println(value); break;
  }

  // An optional's payload views `line`: testing it and reading its value
  // keep `line` borrowed. `->` calls the payload view's own members.
  std::optional<std::string_view> maybe =
      std::optional<std::string_view>(line.view());
  if (maybe) {
    std::println(*maybe);
    std::println(maybe->size());
  }

  // While any of these values is live, `line` cannot be mutated, moved or
  // destroyed; for example `line.append("!")` here is rejected.

  // A token over a literal is ownerless: it keeps method calls and storage.
  Token keyword = Token("let", 0);
  std::println(keyword.width());
  return name.kind == 1 && note.text.size() == 10 ? 0 : 1;
}
