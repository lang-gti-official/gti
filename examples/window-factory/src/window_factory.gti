import window;
import std.memory;
import "desktop.gti";
import "headless.gti";
// This file is loaded by the module's registration. Importers need not name
// it and cannot see its private concrete types through `import window`.
std::unique_ptr<Window> Window::Create(window_backend backend) {
  if (backend == window_backend::headless) {
    return std::upcast_unique<Window, HeadlessWindow>(std::make_unique<HeadlessWindow>());
  }
  return std::upcast_unique<Window, DesktopWindow>(std::make_unique<DesktopWindow>());
}
