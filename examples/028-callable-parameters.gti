void apply_twice<T, Operation>(mut T& value, Operation operation) {
  operation(value);
  operation(value);
}

class Replace<T> {
  T replacement;

public:
  Replace(T replacement) : replacement(replacement) {}
  void operator()(mut T& value) { value = this.replacement; }
};

// Borrow a stateful callable without copying it or transferring ownership.
class Counter {
public:
  mut int value = 0;
  Counter() {}
  Counter(Counter& other) = delete;
  Counter(Counter&& other) = default;
  int operator()(int amount) mut {
    this.value += amount;
    return this.value;
  }
};

int pick<Producer>(bool use_producer, mut Producer& produce) {
  // The exact arm type is checked when Producer is instantiated.
  auto result = use_producer ? produce(2) : 7;
  return result;
}

int relay<Producer>(mut Producer& produce) {
  return pick(true, produce);
}

int read<Producer>(Producer& produce) {
  return produce(3);
}

int main() {
  mut int lambda_value = 1;
  auto increment = [](mut int& value) -> void { value++; };
  apply_twice(lambda_value, increment);

  mut int object_value = 2;
  Replace<int> object = Replace<int>(4);
  apply_twice(object_value, object);

  mut Counter counter{};
  if (relay(counter) != 2 || counter.value != 2) return 1;
  if (pick(false, counter) != 7 || counter.value != 2) return 2;

  auto twice = [](int value) -> int { return value * 2; };
  if (read(twice) != 6) return 3;
  return lambda_value + object_value - 7;
}
