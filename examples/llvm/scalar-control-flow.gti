// gti scalar-control-flow.gti --backend llvm -O3 -o scalar-control-flow
// No I/O or ownership services are required; success is exit status zero.
T identity<T>(T value) { return value; }

int fibonacci(int value) {
  if (value < 2) { return value; }
  return fibonacci(value - 1) + fibonacci(value - 2);
}

int main() {
  mut int total = 0;
  for (mut int index = 0; index < 10; index++) {
    if (index == 3) { continue; }
    if (index == 8) { break; }
    total += identity<int>(index);
  }
  if (total != 25 || fibonacci(10) != 55) { return 1; }
  return 0;
}
