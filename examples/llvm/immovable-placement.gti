mut int destroyed = 0;

class Pinned {
  mut Pinned* constructed_at = nullptr;
  int id;

public:
  Pinned(int id) : id(id) { this.constructed_at = &this; }
  Pinned(Pinned&) = delete;
  Pinned(Pinned&&) = delete;
  ~Pinned() { destroyed = destroyed * 10 + this.id; }
  bool stable() { return this.constructed_at == &this; }
};

Pinned make(int id) { return Pinned(id); }
Pinned relay(int id) { return make(id); }

int main() {
  {
    Pinned value = relay(1);
    if (!value.stable()) { return 1; }
  }
  if (destroyed != 1) { return 2; }
  destroyed = 0;
  {
    Pinned values[2][2] = {{relay(1), Pinned(2)}, {Pinned(3), relay(4)}};
    if (!values[0][0].stable() || !values[1][1].stable()) { return 3; }
  }
  return destroyed == 4321 ? 0 : 4;
}
