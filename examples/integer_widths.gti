int64 combine(int8 small, int16 medium, int32 regular, int64 large) {
  return small + medium + regular + large;
}

uint64 combine_unsigned(uint8 small, uint16 medium, uint regular,
                        uint64 large) {
  return regular + small + medium + large;
}

int main() {
  int8 small = 127;
  int16 medium = 32767;
  int regular = 1024;
  int64 large = 4096;
  int64 total = combine(small, medium, regular, large);
  uint8 unsigned_small = 255;
  uint16 unsigned_medium = 65535;
  uint unsigned_regular = 1024;
  uint64 unsigned_large = 4096;
  uint64 unsigned_total = combine_unsigned(
      unsigned_small, unsigned_medium, unsigned_regular, unsigned_large);
  if (total > 0 and unsigned_total > 0) {
    return 0;
  }
  return 1;
}
