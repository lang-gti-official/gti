#include <std/memory>

struct Widget {
public:
  mut int value = 0;

  Widget(int initial) : value(initial) {}

  ~Widget() { std::println("widget dropped"); }

  int read() { return this.value; }

  void increment() mut { this.value += 1; }
};

int inspect(Widget& widget) { return widget.read(); }

class Node {
  std::unique_ptr<Widget> child;

public:
  // Initialize the field directly to its empty owner state.
  Node() : child(nullptr) {}
  bool empty() { return !this.child; }
};

std::unique_ptr<Widget> create_widget(int value) {
  std::unique_ptr<Widget> widget = std::make_unique<Widget>(value);
  return std::move(widget);
}

int main() {
  Node empty_node{};
  if (!empty_node.empty()) { return 2; }
  mut std::unique_ptr<Widget> widget = create_widget(4);
  widget->increment();

  if (widget and widget != nullptr and inspect(*widget) == 5) {
    std::println("ownership worked");
    return 0;
  }
  return 1;
}
