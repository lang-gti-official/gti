import std.string;

class Reading {
  mut int value;

public:
  Reading(int initial) : value(initial) {}

  int& current() {
    return this.value;
  }

  mut int& current_mut() mut {
    return this.value;
  }

  void replace(int next) mut {
    this.value = next;
  }
};

class ReadingView<T> {
  T& value;

public:
  ReadingView(T& source) : value(source) {}

  T read() {
    return this.value;
  }
};

class WritableReadingView {
  mut int& value;

public:
  WritableReadingView(mut int& source) : value(source) {}

  mut int& write() mut {
    return this.value;
  }
};

ReadingView<T> forward_view<T>(ReadingView<T> view) {
  return std::move(view);
}

ReadingView<int> make_reading_view(Reading& owner) {
  ReadingView<int> direct = ReadingView<int>(owner.current());
  return forward_view<int>(std::move(direct));
}

class ReadingViewFactory {
public:
  static ReadingView<int> open(Reading& owner) {
    return make_reading_view(owner);
  }
public:
  ReadingViewFactory() = default;
};

WritableReadingView make_writable_view(mut Reading& owner) {
  return WritableReadingView(owner.current_mut());
}

class LabelBox {
  std::string_view label;
public:
  LabelBox(std::string_view label) : label(label) {}
  std::string_view& get() { return this.label; }
};

class LabelCursor {
  std::string_view& label;
public:
  LabelCursor(std::string_view& label) : label(label) {}
  std::size_t size() { return this.label.size(); }
};

std::string_view relay_label(std::string_view label) { return label; }

std::size_t copied_label_size(std::string_view& label) {
  std::string_view copy = relay_label(label);
  return copy.size();
}

int main() {
  std::string text = std::string("owned");
  std::string_view view = text.view();
  LabelBox box = LabelBox(view);
  // The constructor borrows the exact view returned by get() and keeps
  // its external text owner alive for the cursor's lifetime.
  LabelCursor cursor = LabelCursor(box.get());
  if (cursor.size() != std::size_t(5) ||
      copied_label_size(view) != std::size_t(5)) {
    return 1;
  }

  mut Reading owner = Reading(21);

  {
    ReadingView<int> scoped = ReadingViewFactory::open(owner);
    if (scoped.read() != 21) {
      return 1;
    }
  }

  // The scoped view has been dropped, so mutating its owner is valid.
  owner.replace(42);

  {
    mut WritableReadingView writable = make_writable_view(owner);
    mut int& slot = writable.write();
    slot = 48;
  }

  ReadingView<int> last_use = ReadingViewFactory::open(owner);
  if (last_use.read() != 48) {
    return 1;
  }

  // The retained view remains in lexical scope, but its final use is above.
  // Replacing the owner before that use would be rejected.
  owner.replace(63);

  ReadingView<int> final_view = ReadingViewFactory::open(owner);
  if (final_view.read() == 63) {
    std::println("owner dependency test passed");
    return 0;
  }
  return 1;
}
