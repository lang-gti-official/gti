// Reflected JSON: `<std/json>` encodes and decodes any
// reflectable struct from its fields alone. No codec, no field list, no
// constructor: keys come from the declared names (or a `name` attribute),
// values from the field types, and decoding builds the struct through
// `std::meta::construct`, so a half-decoded object never exists.
import std.json;
import std.optional;
import std.string;
import std.vector;
enum class severity { info, warning, failure };

struct location {
  std::string file = std::string("");
  uint32_t line = 0;
public:
  location() = default;
};

struct report {
  [[std::json::name("msg")]]
  std::string message = std::string("");
  severity level = severity::info;
  location where{};
  std::vector<uint32_t> related = std::vector<uint32_t>();
  std::optional<std::string> fix = std::optional<std::string>();
  [[std::json::ignore]]
  uint64_t cache_key = 0;
public:
  report() = default;
};

int main() {
  std::vector<uint32_t> related = {12, 40};
  report first = {.message = std::string("unused binding \"x\""),
                  .level = severity::warning,
                  .where = {.file = std::string("main.gti"), .line = uint32_t(7)},
                  .related = std::move(related),
                  .cache_key = uint64_t(99)};

  mut auto encoded = std::json::encode(first);
  if (!encoded) {
    return 1;
  }
  std::string text = std::move(encoded).value();
  std::print(text.view());
  std::print("\n");

  mut auto parsed = std::json::decode<report>(text.view());
  if (!parsed) {
    std::print(std::json::describe(parsed.error().code));
    std::print("\n");
    return 1;
  }
  report back = std::move(parsed).value();
  std::print(back.where.file.view());
  std::print(":");
  std::print(std::to_string(float(back.where.line)).view());
  std::print(" ");
  std::print(back.message.view());
  std::print("\n");

  // Pretty output changes whitespace only; an empty optional prints as null.
  mut auto pretty = std::json::encode_pretty(back);
  if (pretty) {
    std::print(pretty.value().view());
    std::print("\n");
  }

  // Failures carry the kind, the byte offset and a JSON Pointer to the value.
  mut auto broken = std::json::decode<report>("{\"msg\":\"m\",\"level\":\"loud\"}");
  if (!broken) {
    std::print(broken.error().description());
    std::print(" at ");
    std::print(broken.error().path.view());
    std::print(" (offset ");
    std::print(std::to_string(float(broken.error().offset)).view());
    std::print(")\n");
  }
  return 0;
}
