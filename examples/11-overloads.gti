namespace math {
uint64 multiply(uint64 left, uint64 right) {
  return left * right;
}

float multiply(float left, float right) {
  return left * right;
}
}

struct Label {
  std::string_view for_value(uint64 value) {
    return "uint64 overload";
  }

  std::string_view for_value(float value) {
    return "float overload";
  }
};

int main() {
  uint64 whole = math::multiply(uint64(6), uint64(7));
  float decimal = math::multiply(1.5, 2.0);

  Label label = Label();
  std::println(label.for_value(whole));
  std::println(label.for_value(decimal));

  int checked = int(whole);
  if (checked != 42) {
    return 1;
  }
  return 0;
}
