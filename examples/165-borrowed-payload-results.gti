// A source-defined fallible view can consume its wrapper while keeping the
// success reference tied to the caller's owner. Its error owns its text.
#include <std/string>
#include <std/panic>

class Reading {
public:
  int& value;
  mut std::string error;

  Reading(int& source, std::string failure)
      : value(source), error(std::move(failure)) {}
};

for concept std::tryable<Reading> {
  using value_type = int&;
  using residual_type = std::string;

  bool has_value(Reading& result) { return result.error.empty(); }
  [[borrowed_from(result)]] int& take_value(Reading result) {
    return result.value;
  }
  std::string take_residual(mut Reading result) {
    return std::move(result.error);
  }
};

struct Status {
  int code;
  Status(int value) : code(value) {}
  implicit Status(std::string error) : code(int(error.size())) {}
};

Status inspect(int& owner, bool fail) {
  Reading result{owner, std::string(fail ? "bad" : "")};
  int& value = ?std::move(result);
  // `result` has been consumed, but `owner` is still alive.
  return Status(value);
}

class Editing {
public:
  mut int& value;
  mut std::string error;
  Editing(mut int& source, std::string failure)
      : value(source), error(std::move(failure)) {}
};

for concept std::tryable<Editing> {
  using value_type = mut int&;
  using residual_type = std::string;
  bool has_value(Editing& result) { return result.error.empty(); }
  [[borrowed_from(result)]] mut int& take_value(mut Editing result) {
    return result.value;
  }
  std::string take_residual(mut Editing result) {
    return std::move(result.error);
  }
};

Status edit(mut int& owner, bool fail) {
  Editing result{owner, std::string(fail ? "bad" : "")};
  mut int& value = ?std::move(result);
  value += 1;
  return Status(value);
}

// A payload enum can implement the same protocol directly.
enum Parse { ready(int value), failed(int code) };
for concept std::tryable<Parse> {
  using value_type = int;
  using residual_type = std::string;
  bool has_value(Parse& result) {
    switch (result) {
      case Parse::ready: return true;
      case Parse::failed: return false;
    }
  }
  int take_value(Parse result) {
    switch (result) {
      case Parse::ready(value): return value;
      case Parse::failed: return 0;
    }
  }
  std::string take_residual(Parse result) {
    switch (result) {
      case Parse::ready: return std::string("");
      case Parse::failed(code): return std::to_string(code);
    }
  }
};

Status parse() {
  int value = ?Parse::ready(12);
  return Status(value);
}

int inspect_parse(Parse& value) {
  switch (value) {
    case Parse::ready(number): return number;
    case Parse::failed: return 0;
  }
}

// Unlike Reading's always-present reference field, only the success
// alternative below borrows. The error owns its string. The checked body of
// take_value selects the exact reference; has_value is not a tag-proof hint.
enum BorrowedParse { ready(int& value), failed(std::string error) };
for concept std::tryable<BorrowedParse> {
  using value_type = int&;
  using residual_type = std::string;
  bool has_value(BorrowedParse& result) {
    switch (result) {
      case BorrowedParse::ready: return true;
      case BorrowedParse::failed: return false;
    }
  }
  [[borrowed_from(result)]] int& take_value(mut BorrowedParse result) {
    switch (std::move(result)) {
      case BorrowedParse::ready(value): return value;
      case BorrowedParse::failed(error): std::panic("not a successful parse");
    }
  }
  std::string take_residual(mut BorrowedParse result) {
    switch (std::move(result)) {
      case BorrowedParse::ready(value): std::panic("not a failed parse");
      case BorrowedParse::failed(error): return std::move(error);
    }
  }
};

[[borrowed_from(owner)]] BorrowedParse borrowed_parse(int& owner, bool fail) {
  if (fail) return BorrowedParse::failed(std::string("bad"));
  return BorrowedParse::ready(owner);
}

Status inspect_borrowed_parse(int& owner, bool fail) {
  mut auto result = borrowed_parse(owner, fail);
  int& value = ?std::move(result);
  return Status(value);
}

int main() {
  int owner = 42;
  std::println(std::to_string(inspect(owner, false).code));
  std::println(std::to_string(inspect(owner, true).code));
  mut int changing = 8;
  std::println(std::to_string(edit(changing, false).code));
  std::println(std::to_string(edit(changing, true).code));
  std::println(std::to_string(changing));
  std::println(std::to_string(parse().code));
  std::println(std::to_string(inspect_borrowed_parse(owner, false).code));
  std::println(std::to_string(inspect_borrowed_parse(owner, true).code));
  // This temporary borrow is an ordinary call, independent of tryable.
  return inspect_parse(Parse::ready(7)) - 7;
}
