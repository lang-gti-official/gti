namespace psych {
// The window, renderer, native events, and editor UI from the C++ engine are
// deliberately absent. A layer keeps only the lifecycle used by the headless
// application loop.
interface Layer {
  uint64_t Id();
  void OnAttach() mut;
  void OnDetach() mut;
  void OnUpdate(uint64_t frame) mut;
  void OnRender() mut;
};
}
