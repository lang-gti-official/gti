#include <events/bindings>

int main() {
  if (sizeof(native::Event) != native::event_size() ||
      alignof(native::EventData) != native::data_alignment()) { return 1; }
  mut auto event = native::make_event();
  // The native tag identifies the initialized alternative. GTI deliberately
  // requires unsafe for every untagged union member access.
  unsafe {
    if (event.kind != c_uint(1) || event.data.number != uint64_t(42)) { return 2; }
    auto copied = native::roundtrip_data(event.data);
    if (copied.number != uint64_t(42)) { return 3; }
    event.kind = c_uint(2);
    event.data.position.x = 3.0;
    event.data.position.y = 4.0;
    if (native::check_event(event) != c_int(1)) { return 4; }
    native::update_event(&event);
    if (event.kind != c_uint(3) || event.data.bytes[15] != uint8_t(99)) { return 5; }
    auto userdata = native::make_userdata();
    if (userdata.pointer != nullptr) { return 6; }
    auto nested = native::make_nested();
    if (nested.data[1].number != uint64_t(42)) { return 7; }
  }
  return 0;
}
