// Type parameters appear directly after a class or function name.
class Box<T> {
  T value;

public:
  Box(T value) : value(value) {}

  T get() {
    return self.value;
  }
};

T identity<T>(T value) {
  return value;
}

int main() {
  // Generic class arguments are explicit at both the type and construction.
  Box<int> boxed = Box<int>(21);

  // Generic function arguments can be inferred from the value argument.
  int value = identity(boxed.get());
  if (value == 21) {
    std::println("generic code keeps its type information");
    return 0;
  }
  return 1;
}
