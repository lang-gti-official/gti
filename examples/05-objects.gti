// Struct members are public by default. Declaration initializers let the
// compiler generate Point() alongside declared constructor overloads.
struct Point {
  int x = 0;
  int y = 0;

  Point(int initial_x, int initial_y) : x(initial_x), y(initial_y) {}
};

// Class members are private by default. A trailing `mut` allows a method to
// write to mutable fields and requires a mutable receiver at the call site.
class Counter {
  mut int value;

public:
  Counter() : value(0) {}
  Counter(int initial) : value(initial) {}

  int current() {
    return this.value;
  }

  int tick() mut {
    this.value += 1;
    return this.value;
  }
};

int main() {
  Point origin = Point();
  Point offset = Point(2, 3);
  mut Counter counter = Counter(origin.x);
  int next = counter.tick();

  if (next == counter.current() and offset.x == 2) {
    std::println("objects use explicit construction");
    return 0;
  }
  return 1;
}
