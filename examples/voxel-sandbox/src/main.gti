// GTI voxel sandbox: an original block-building game written in GTI.
//
//   voxel-sandbox [--seed N] [--render-distance R] [--no-vsync] [--fullscreen]
//                 [--size WxH] [--budget-ms MS]
//                 [--benchmark [--seconds S]] [--report PATH]
//                 [--screenshot SECONDS PATH]
import "game/game.gti";
import std.format;
import std.string;
import std.vector;

// Characters are not numbers in GTI, so map digits explicitly.
int64_t digit_value(char c) {
  std::string_view digits = "0123456789";
  for (mut uint64_t d = uint64_t(0); d < uint64_t(10); d++) {
    if (digits[d] == c) return int64_t(d);
  }
  return -1i64;
}

int64_t parse_int(std::string_view text, int64_t fallback) {
  mut int64_t value = 0;
  mut bool negative = false;
  mut uint64_t i = uint64_t(0);
  if (text.size() == uint64_t(0)) return fallback;
  if (text[0] == '-') {
    negative = true;
    i = uint64_t(1);
  }
  if (i >= text.size()) return fallback;
  while (i < text.size()) {
    char c = text[i];
    int64_t digit = digit_value(c);
    if (digit < 0i64) return fallback;
    value = value * 10i64 + digit;
    if (value > 1000000000i64) return fallback;
    i += uint64_t(1);
  }
  if (negative) return -value;
  return value;
}

void usage() {
  std::println("usage: voxel-sandbox [--seed N] [--render-distance R] [--no-vsync] [--fullscreen]");
  std::println("                     [--size WxH] [--budget-ms MS] [--benchmark [--seconds S]] [--report PATH]");
  std::println("                     [--screenshot SECONDS PATH]");
  std::println("controls: WASD move, mouse look, space jump/up, shift down, ctrl sprint, F fly,");
  std::println("          left click break, right click place, 1-9/Q/E select block, F3 debug, F2 screenshot, Esc release/quit");
}

int main(int argc, std::vector<std::string> argv) {
  mut voxel::GameOptions options = voxel::GameOptions();
  mut uint64_t i = uint64_t(1);
  while (i < argv.size()) {
    std::string_view arg = argv[i].view();
    bool has_value = i + uint64_t(1) < argv.size();
    if (arg == "--help" or arg == "-h") {
      usage();
      return 0;
    } else if (arg == "--seed" and has_value) {
      options.seed = uint32_t(parse_int(argv[i + uint64_t(1)].view(), 1337i64));
      i += uint64_t(1);
    } else if (arg == "--render-distance" and has_value) {
      mut int64_t r = parse_int(argv[i + uint64_t(1)].view(), 10i64);
      if (r < 2i64) r = 2i64;
      if (r > 32i64) r = 32i64;
      options.render_distance = int32_t(r);
      i += uint64_t(1);
    } else if (arg == "--no-vsync") {
      options.vsync = false;
    } else if (arg == "--fullscreen") {
      options.fullscreen = true;
    } else if (arg == "--size" and has_value) {
      std::string_view size = argv[i + uint64_t(1)].view();
      mut uint64_t split = uint64_t(0);
      while (split < size.size() and size[split] != 'x') split += uint64_t(1);
      if (split < size.size()) {
        options.width = int32_t(parse_int(size.substr(uint64_t(0), split), 1600i64));
        uint64_t rest = size.size() - split - uint64_t(1);
        options.height = int32_t(parse_int(size.substr(split + uint64_t(1), rest), 900i64));
      }
      i += uint64_t(1);
    } else if (arg == "--budget-ms" and has_value) {
      options.stream_budget_ms = double(parse_int(argv[i + uint64_t(1)].view(), 6i64));
      i += uint64_t(1);
    } else if (arg == "--benchmark") {
      options.benchmark = true;
      options.vsync = false;
    } else if (arg == "--seconds" and has_value) {
      options.benchmark_seconds = double(parse_int(argv[i + uint64_t(1)].view(), 0i64));
      i += uint64_t(1);
    } else if (arg == "--screenshot" and i + uint64_t(2) < argv.size()) {
      options.screenshot_at = double(parse_int(argv[i + uint64_t(1)].view(), 5i64));
      options.screenshot_path = std::string(argv[i + uint64_t(2)].view());
      i += uint64_t(2);
    } else if (arg == "--report" and has_value) {
      options.report_path = std::string(argv[i + uint64_t(1)].view());
      i += uint64_t(1);
    } else {
      std::println("unknown argument: {}", arg);
      usage();
      return 64;
    }
    i += uint64_t(1);
  }
  if (options.benchmark and options.report_path.size() == uint64_t(0)) {
    options.report_path = std::string("profiles/benchmark.json");
  }
  mut voxel::Game game{};
  return game.run(options);
}
