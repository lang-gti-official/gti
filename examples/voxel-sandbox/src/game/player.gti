// Player movement, collision against the voxel grid and block targeting.
export module player;

import "../core/math.gti";
import "../world/block.gti";
import "../world/world.gti";
import std.cmath;

export namespace voxel {
constexpr float PLAYER_HALF_WIDTH = 0.3;
constexpr float PLAYER_HEIGHT = 1.8;
constexpr float PLAYER_EYE = 1.62;
constexpr float GRAVITY = 28.0;
constexpr float JUMP_SPEED = 8.6;
constexpr float WALK_SPEED = 4.3;
constexpr float SPRINT_SPEED = 6.4;
constexpr float FLY_SPEED = 14.0;
constexpr float REACH = 6.0;

// Movement intent for one frame, produced from the keyboard.
struct MoveInput {
public:
  mut float forward = 0.0; // +1 forward, -1 back
  mut float strafe = 0.0;  // +1 right, -1 left
  mut bool jump = false;
  mut bool descend = false;
  mut bool sprint = false;
  MoveInput() = default;
};

struct RayHit {
public:
  mut bool hit = false;
  mut int32_t x = 0;
  mut int32_t y = 0;
  mut int32_t z = 0;
  // The empty cell in front of the hit face (where a block is placed).
  mut int32_t place_x = 0;
  mut int32_t place_y = 0;
  mut int32_t place_z = 0;
  RayHit() = default;
};

// Amanatides & Woo voxel traversal from `origin` along unit `direction`.
RayHit cast_ray(World& world, Vec3 origin, Vec3 direction, float max_distance) {
  mut RayHit result = RayHit();
  mut int32_t x = floor_to_int(origin.x);
  mut int32_t y = floor_to_int(origin.y);
  mut int32_t z = floor_to_int(origin.z);
  mut int32_t step_x = 0;
  mut int32_t step_y = 0;
  mut int32_t step_z = 0;
  float big = 1000000000000.0;
  mut float t_max_x = big;
  mut float t_max_y = big;
  mut float t_max_z = big;
  mut float t_delta_x = big;
  mut float t_delta_y = big;
  mut float t_delta_z = big;
  if (direction.x > 0.0) {
    step_x = 1;
    t_delta_x = 1.0 / direction.x;
    t_max_x = (float(x) + 1.0 - origin.x) * t_delta_x;
  } else if (direction.x < 0.0) {
    step_x = -1;
    t_delta_x = -1.0 / direction.x;
    t_max_x = (origin.x - float(x)) * t_delta_x;
  }
  if (direction.y > 0.0) {
    step_y = 1;
    t_delta_y = 1.0 / direction.y;
    t_max_y = (float(y) + 1.0 - origin.y) * t_delta_y;
  } else if (direction.y < 0.0) {
    step_y = -1;
    t_delta_y = -1.0 / direction.y;
    t_max_y = (origin.y - float(y)) * t_delta_y;
  }
  if (direction.z > 0.0) {
    step_z = 1;
    t_delta_z = 1.0 / direction.z;
    t_max_z = (float(z) + 1.0 - origin.z) * t_delta_z;
  } else if (direction.z < 0.0) {
    step_z = -1;
    t_delta_z = -1.0 / direction.z;
    t_max_z = (origin.z - float(z)) * t_delta_z;
  }
  mut int32_t previous_x = x;
  mut int32_t previous_y = y;
  mut int32_t previous_z = z;
  mut float travelled = 0.0;
  while (travelled <= max_distance) {
    if (is_targetable(world.get_block(x, y, z))) {
      result.hit = true;
      result.x = x;
      result.y = y;
      result.z = z;
      result.place_x = previous_x;
      result.place_y = previous_y;
      result.place_z = previous_z;
      return result;
    }
    previous_x = x;
    previous_y = y;
    previous_z = z;
    if (t_max_x < t_max_y and t_max_x < t_max_z) {
      x += step_x;
      travelled = t_max_x;
      t_max_x += t_delta_x;
    } else if (t_max_y < t_max_z) {
      y += step_y;
      travelled = t_max_y;
      t_max_y += t_delta_y;
    } else {
      z += step_z;
      travelled = t_max_z;
      t_max_z += t_delta_z;
    }
  }
  return result;
}

class Player {
public:
  mut Vec3 position = Vec3(0.5, 80.0, 0.5); // feet, centre of the box
  mut Vec3 velocity = Vec3();
  mut float yaw = 0.0;
  mut float pitch = 0.0;
  mut bool on_ground = false;
  mut bool flying = false;
  mut bool in_water = false;
  mut bool head_in_water = false;

  Player() {}

  Vec3 eye() { return Vec3(this.position.x, this.position.y + PLAYER_EYE, this.position.z); }
  Vec3 look_direction() { return direction_from(this.yaw, this.pitch); }

  void look(float delta_yaw, float delta_pitch) mut {
    this.yaw += delta_yaw;
    while (this.yaw > PI) this.yaw -= 2.0 * PI;
    while (this.yaw < -PI) this.yaw += 2.0 * PI;
    this.pitch = clampf(this.pitch + delta_pitch, -1.55, 1.55);
  }

  // True when the player's box overlaps any solid block.
  bool collides(World& world, float px, float py, float pz) {
    int32_t x0 = floor_to_int(px - PLAYER_HALF_WIDTH);
    int32_t x1 = floor_to_int(px + PLAYER_HALF_WIDTH - 0.0001);
    int32_t y0 = floor_to_int(py);
    int32_t y1 = floor_to_int(py + PLAYER_HEIGHT - 0.0001);
    int32_t z0 = floor_to_int(pz - PLAYER_HALF_WIDTH);
    int32_t z1 = floor_to_int(pz + PLAYER_HALF_WIDTH - 0.0001);
    for (mut int32_t y = y0; y <= y1; y++) {
      for (mut int32_t z = z0; z <= z1; z++) {
        for (mut int32_t x = x0; x <= x1; x++) {
          if (is_solid(world.get_block(x, y, z))) return true;
        }
      }
    }
    return false;
  }

  // Does the box intersect the unit cell (bx, by, bz)? Used to refuse
  // placing a block inside the player.
  bool overlaps_cell(int32_t bx, int32_t by, int32_t bz) {
    float min_x = this.position.x - PLAYER_HALF_WIDTH;
    float max_x = this.position.x + PLAYER_HALF_WIDTH;
    float min_y = this.position.y;
    float max_y = this.position.y + PLAYER_HEIGHT;
    float min_z = this.position.z - PLAYER_HALF_WIDTH;
    float max_z = this.position.z + PLAYER_HALF_WIDTH;
    return max_x > float(bx) and min_x < float(bx + 1) and max_y > float(by) and
           min_y < float(by + 1) and max_z > float(bz) and min_z < float(bz + 1);
  }

  void update(World& world, MoveInput& input, float seconds) mut {
    mut float remaining = clampf(seconds, 0.0, 0.1);
    while (remaining > 0.0) {
      mut float step = remaining;
      if (step > 0.008) step = 0.008;
      this.step(world, input, step);
      remaining -= step;
    }
  }

  void step(World& world, MoveInput& input, float dt) mut {
    uint8_t feet_block = world.get_block(floor_to_int(this.position.x),
                                         floor_to_int(this.position.y + 0.4),
                                         floor_to_int(this.position.z));
    uint8_t head_block = world.get_block(floor_to_int(this.position.x),
                                         floor_to_int(this.position.y + PLAYER_EYE),
                                         floor_to_int(this.position.z));
    this.in_water = feet_block == WATER;
    this.head_in_water = head_block == WATER;

    // Horizontal intent in world space.
    float sy = std::sin(this.yaw);
    float cy = std::cos(this.yaw);
    mut float wish_x = sy * input.forward + cy * input.strafe;
    mut float wish_z = -cy * input.forward + sy * input.strafe;
    float wish_len = std::sqrt(wish_x * wish_x + wish_z * wish_z);
    if (wish_len > 1.0) {
      wish_x = wish_x / wish_len;
      wish_z = wish_z / wish_len;
    }

    if (this.flying) {
      mut float speed = FLY_SPEED;
      if (input.sprint) speed = FLY_SPEED * 2.2;
      mut float vertical = 0.0;
      if (input.jump) vertical += 1.0;
      if (input.descend) vertical -= 1.0;
      // Fly mode: responsive damping toward the wished velocity.
      float blend = clampf(dt * 12.0, 0.0, 1.0);
      this.velocity.x += (wish_x * speed - this.velocity.x) * blend;
      this.velocity.z += (wish_z * speed - this.velocity.z) * blend;
      this.velocity.y += (vertical * speed - this.velocity.y) * blend;
    } else {
      mut float speed = WALK_SPEED;
      if (input.sprint) speed = SPRINT_SPEED;
      if (this.in_water) speed = speed * 0.55;
      mut float control = 10.0;
      if (!this.on_ground) control = 2.5;
      if (this.in_water) control = 6.0;
      float blend = clampf(dt * control, 0.0, 1.0);
      this.velocity.x += (wish_x * speed - this.velocity.x) * blend;
      this.velocity.z += (wish_z * speed - this.velocity.z) * blend;
      if (this.in_water) {
        this.velocity.y -= GRAVITY * 0.22 * dt;
        if (input.jump) this.velocity.y += 22.0 * dt;
        this.velocity.y = clampf(this.velocity.y, -3.5, 3.2);
      } else {
        this.velocity.y -= GRAVITY * dt;
        if (this.velocity.y < -60.0) this.velocity.y = -60.0;
        if (input.jump and this.on_ground) {
          this.velocity.y = JUMP_SPEED;
        }
      }
    }

    // Axis-separated sweep: resolve y first so landing is crisp.
    this.on_ground = false;
    float ny = this.position.y + this.velocity.y * dt;
    if (this.collides(world, this.position.x, ny, this.position.z)) {
      if (this.velocity.y < 0.0) {
        this.on_ground = true;
        this.position.y = float(floor_to_int(ny)) + 1.0;
        if (this.collides(world, this.position.x, this.position.y, this.position.z)) {
          this.position.y = ny - this.velocity.y * dt;
        }
      }
      this.velocity.y = 0.0;
    } else {
      this.position.y = ny;
    }
    float nx = this.position.x + this.velocity.x * dt;
    if (this.collides(world, nx, this.position.y, this.position.z)) {
      this.velocity.x = 0.0;
    } else {
      this.position.x = nx;
    }
    float nz = this.position.z + this.velocity.z * dt;
    if (this.collides(world, this.position.x, this.position.y, nz)) {
      this.velocity.z = 0.0;
    } else {
      this.position.z = nz;
    }
    if (this.position.y < -20.0) {
      this.position.y = 120.0;
      this.velocity = Vec3();
    }
  }
};
}
