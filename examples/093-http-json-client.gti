import std.http;
import std.io;
import std.cstdio;
import std.json;
import std.string;
import std.vector;
// No arguments: offline URL recipe. URL: GET. URL post: POST a JSON object.
// URL stream FILE: copy a streaming response to a file with bounded scratch.
// See README.md for a reproducible local-server demo (no credentials needed).
struct named {
  std::string name = std::string("");
public:
  named() = default;
};

// The same io::copy works with a file, socket, memory stream, or custom writer.
int stream_file(mut std::http::client& client, std::http::request& request,
                std::string_view destination) {
  auto received = client.send_stream(request);
  if (!received) { return 5; }
  mut auto response = std::move(received).value();
  if (response.status() < uint32_t(200) || response.status() >= uint32_t(300)) {
    return 6;
  }
  auto opened = std::fopen(destination, std::file_mode::write);
  if (!opened) { return 9; }
  mut auto output = std::move(opened).value();
  mut std::byte_buffer bytes{std::size_t(4096)};
  mut auto scratch = bytes.as_mutable_span();
  auto copied = std::io::copy(response, *output, scratch);
  if (!copied) { return 10; }
  auto closed = output->close();
  if (!closed) { return 11; }
  std::println(response.bytes_read());
  return 0;
}

int main(int argc, std::vector<std::string> argv) {
  if (argc == 1) {
    auto base = std::http::url::https("example.com");
    if (!base) { return 1; }
    mut auto endpoint = base.value() / "api" / "users";
    endpoint.add_query_parameter("name", "Alice Smith");
    std::println(endpoint.view());
    std::println("Usage: http-json URL [post | stream FILE]");
    return 0;
  }
  bool streaming = argc == 4 && argv[std::size_t(2)].view() == "stream";
  if (argc > 4 || (argc == 4 && !streaming) ||
      (argc == 3 && argv[std::size_t(2)].view() != "post")) { return 1; }
  auto parsed_url = std::http::url::parse(argv[std::size_t(1)].view());
  if (!parsed_url) { std::println("Invalid HTTP(S) URL"); return 2; }
  auto endpoint = std::move(parsed_url).value();
  mut std::http::request request{
      argc == 3 ? std::http::method::post : std::http::method::get, endpoint};
  // Require HTTPS for HTTPS endpoints; local HTTP demos retain the default.
  if (endpoint.scheme() == "https") {
    request.set_scheme_policy(std::http::scheme_policy::https_only);
  }
  request.set_connect_timeout_ms(uint64_t(2000));
  request.set_timeout_ms(uint64_t(5000));
  request.set_max_response_bytes(uint64_t(65536));
  auto accept = request.set_header("Accept", "application/json");
  if (!accept) { return 3; }
  if (argc == 3) {
    named body = {.name = std::string("tea")};
    auto text = std::json::encode(body);
    auto content_type = request.set_header("Content-Type", "application/json");
    if (!text || !content_type) { return 3; }
    request.set_body(std::move(text).value());
  }
  auto created = std::http::client::create();
  if (!created) { std::println("HTTP client unavailable"); return 4; }
  // Reuse this mutable owner for multiple sends to retain its connection pool.
  mut auto client = std::move(created).value();
  if (streaming) {
    request.set_redirect_policy(std::http::redirect_policy::secure);
    request.set_redirect_limit(uint32_t(5));
    return stream_file(client, request, argv[std::size_t(3)].view());
  }
  auto received = client.send(request);
  if (!received) { std::println("HTTP transport failed"); return 5; }
  auto response = std::move(received).value();
  // A 404/500 is a response, not a transport failure. Check before parsing.
  if (response.status() < uint32_t(200) || response.status() >= uint32_t(300)) {
    std::println("HTTP status rejected");
    std::println(response.status());
    return 6;
  }
  std::string body = response.body();
  auto document = std::json::decode<named>(body.view());
  if (!document) {
    // A schema failure names the field; anything else is malformed text.
    if (document.error().code == std::json::errc::missing_field ||
        document.error().code == std::json::errc::type_mismatch) {
      std::println("Missing or invalid name");
      return 8;
    }
    std::println("Invalid JSON response");
    return 7;
  }
  std::println(document.value().name.view());
  // HTTPS certificate and hostname verification are always enabled.
  return 0;
}
