struct Value {
  mut int number = 0;

  void increment() mut {
    this.number += 1;
  }
};

class Handle {
  mut Value object = Value();
  mut int pointed = 1;
  mut int elements[2] = {2, 3};

public:
  Value& operator->() {
    return this.object;
  }

  mut Value& operator->() mut {
    return this.object;
  }

  int& operator*() {
    return this.pointed;
  }

  mut int& operator*() mut {
    return this.pointed;
  }

  int& operator[](uint64_t index) {
    return this.elements[index];
  }

  mut int& operator[](uint64_t index) mut {
    return this.elements[index];
  }

  int operator()(uint64_t index) {
    return this.elements[index];
  }

  bool operator==(nullptr_t other) {
    return false;
  }

  bool operator!=(nullptr_t other) {
    return true;
  }

  operator bool() {
    return true;
  }
};

int main() {
  mut Handle handle = Handle();
  handle->increment();
  *handle = 7;
  handle[uint64_t(1)] += 2;
  int called = handle(uint64_t(0));

  if (handle and handle != nullptr and !(handle == nullptr)) {
    return *handle + handle[uint64_t(1)] + called - 14;
  }
  return 1;
}
