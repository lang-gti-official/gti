/*
 * Configuration flags are source-ordered, valueless feature switches. They
 * select source before semantic analysis; they are not text macros.
 */
#define FAST_PATH

#if defined(FAST_PATH)
/// Returns the value selected by the active configuration branch.
///
/// Hovering either this declaration or its call shows this Markdown together
/// with the compiler-selected signature.
int selected_value() {
  return 40;
}
#else
int selected_value() {
  return 0;
}
#endif

#undef FAST_PATH

#ifndef FAST_PATH
/// Supplies the portable fallback adjustment.
int final_bias() {
  return 2;
}
#else
int final_bias() {
  return 0;
}
#endif

int main() {
  int answer = selected_value() /* comments can sit inside expressions */ +
               final_bias();
  if (answer != 42) {
    return 1;
  }
  std::println("configuration selected the active source");
  return 0;
}
