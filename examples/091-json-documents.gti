#include <std/json>
#include <std/optional>
#include <std/string>
#include <std/vector>

// A JSON document is an ordinary struct: its fields are the members, their
// types are the value kinds, and <std/json> maps both ways through
// reflection. No schema, codec or field list is written anywhere.
struct repository {
  std::string name = std::string("");
  uint64_t stars = 0;
  std::optional<std::string> license = std::optional<std::string>();
};

struct issue {
  std::string title = std::string("");
  bool open = true;
  std::vector<std::string> labels = std::vector<std::string>();
};

int main() {
  auto parsed = std::json::decode<repository>("{\"name\":\"tea\",\"stars\":42,\"license\":null}");
  if (!parsed) {
    std::println(parsed.error().description());
    return 1;
  }
  // The struct owns its contents; it does not borrow the input text.
  repository document = std::move(parsed).value();
  std::println(document.name.view());
  std::println(document.stars);

  // `null` and an absent member both leave an optional empty; a required
  // field that is absent is an error with the field's path.
  if (document.license.has_value()) { return 2; }
  auto missing = std::json::decode<repository>("{\"stars\":1}");
  if (missing || missing.error().code != std::json::errc::missing_field ||
      missing.error().path.view() != "/name") { return 3; }

  // Building text is encoding a value; the result is recoverable because
  // strings must be valid UTF-8 and floating values finite.
  mut std::vector<std::string> labels = std::vector<std::string>();
  labels.push_back(std::string("documentation"));
  labels.push_back(std::string("good first issue"));
  issue report = {.title = std::string("Improve examples"), .labels = std::move(labels)};
  auto compact = std::json::encode(report);
  if (!compact) { return 4; }
  std::println(compact.value().view());
  for (auto& label : report.labels) {
    std::println(label.view());
  }
  auto readable = std::json::encode_pretty(report);
  if (!readable) { return 4; }
  std::println(readable.value().view());

  // A round trip reproduces the value; member order in the text is free.
  auto back = std::json::decode<issue>("{\"labels\":[\"documentation\",\"good first issue\"],\"open\":true,\"title\":\"Improve examples\"}");
  if (!back || back.value().title.view() != report.title.view() ||
      back.value().labels.size() != std::size_t(2)) { return 5; }

  // Strict grammar: repeated keys, leading zeros and raw control characters
  // are errors with a line and column.
  auto invalid = std::json::decode<repository>("{\"name\":\"a\",\n \"name\":\"b\"}");
  if (invalid || invalid.error().code != std::json::errc::duplicate_key ||
      !invalid.error().has_source_location() || invalid.error().line != std::size_t(2)) { return 6; }
  return 0;
}
