// Target directives select declarations before semantic analysis and codegen.
#if target.vendor == "apple"
std::string_view platform_name() {
  return "Apple platform";
}
#elif target.os == "windows"
std::string_view platform_name() {
  return "Windows platform";
}
#else
std::string_view platform_name() {
  return "another supported platform";
}
#endif

int main() {
  std::string_view platform = platform_name();
  std::println(platform);

  // Directives can also select statements within a function body.
#if target.arch == "arm64"
  std::println("running on arm64");
#else
  std::println("running on a non-arm64 architecture");
#endif
  return 0;
}
