import std.memory;
import std.string;
mut int cleanup_count = 0;

class resource {
  int value;

public:
  resource(int value) : value(value) {}
  resource(resource& other) = delete;
  resource(resource&& other) = default;
  ~resource() { cleanup_count++; }

  int read() { return this.value; }
};

class callable_owner<T> {
  T value;

public:
  callable_owner(T value) : value(std::move(value)) {}
};

T relay<T>(T value) {
  return std::move(value);
}

callable_owner<T> own<T>(T value) {
  return callable_owner<T>(std::move(value));
}

int transport() {
  resource source = resource(42);
  auto operation = [owned = std::move(source)]() -> int {
    return owned.read();
  };

  auto returned = relay(std::move(operation));
  int result = returned();
  auto retained = own(std::move(returned));
  return result;
}

int main() {
  int result = transport();
  // Ordinary source-defined owners remain valid owned captures, including
  // through generic return and field transport. Their reviewed internal raw
  // allocation state is not a borrowed capture and needs no call-site unsafe.
  std::string text{"owned"};
  auto callback = [text = std::move(text)]() -> int { return int(text.size()); };
  auto returned = relay(std::move(callback));
  int size = returned();
  auto retained = own(std::move(returned));
  std::println("owned callable transport completed");
  return result - 42 + cleanup_count - 1 + size - 5;
}
