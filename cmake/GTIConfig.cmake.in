@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if("@GTI_PACKAGE_BUNDLED_LLVM@" STREQUAL "ON")
  set(_gti_llvm_library_dir
      "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/gti/llvm")

  function(_gti_import_llvm_archive target archive)
    if(TARGET "${target}")
      return()
    endif()
    set(archive_path "${_gti_llvm_library_dir}/${archive}")
    if(NOT EXISTS "${archive_path}")
      set(GTI_FOUND FALSE PARENT_SCOPE)
      set(GTI_NOT_FOUND_MESSAGE
          "GTI's bundled LLVM archive is missing: ${archive_path}"
          PARENT_SCOPE)
      return()
    endif()
    add_library("${target}" STATIC IMPORTED)
    set_target_properties("${target}" PROPERTIES IMPORTED_LOCATION
                                                  "${archive_path}")
  endfunction()

  _gti_import_llvm_archive(
    GTI_LLVM::Demangle
    "@CMAKE_STATIC_LIBRARY_PREFIX@LLVMDemangle@CMAKE_STATIC_LIBRARY_SUFFIX@")
  _gti_import_llvm_archive(
    GTI_LLVM::Support
    "@CMAKE_STATIC_LIBRARY_PREFIX@LLVMSupport@CMAKE_STATIC_LIBRARY_SUFFIX@")
  _gti_import_llvm_archive(
    GTI_LLVM::TargetParser
    "@CMAKE_STATIC_LIBRARY_PREFIX@LLVMTargetParser@CMAKE_STATIC_LIBRARY_SUFFIX@")

  if(DEFINED GTI_FOUND AND NOT GTI_FOUND)
    return()
  endif()

  set(_gti_llvm_system_libraries
      "@GTI_BUNDLED_LLVM_SUPPORT_SYSTEM_LIBRARIES@")

  set_target_properties(
    GTI_LLVM::Support
    PROPERTIES INTERFACE_LINK_LIBRARIES
               "GTI_LLVM::Demangle;${_gti_llvm_system_libraries}")
  set_target_properties(
    GTI_LLVM::TargetParser
    PROPERTIES INTERFACE_LINK_LIBRARIES GTI_LLVM::Support)

@GTI_BUNDLED_LLVM_BACKEND_IMPORTS@
  if(DEFINED GTI_FOUND AND NOT GTI_FOUND)
    return()
  endif()

  # libclang ships as the shared C API beside the bundled archives; the
  # installed GTI::bindgen archive resolves it here.
  if(NOT TARGET GTI_LLVM::libclang)
    set(_gti_libclang_path
        "${_gti_llvm_library_dir}/@CMAKE_SHARED_LIBRARY_PREFIX@clang@CMAKE_SHARED_LIBRARY_SUFFIX@")
    if(NOT EXISTS "${_gti_libclang_path}")
      set(GTI_FOUND FALSE)
      set(GTI_NOT_FOUND_MESSAGE
          "GTI's bundled libclang library is missing: ${_gti_libclang_path}")
      return()
    endif()
    add_library(GTI_LLVM::libclang SHARED IMPORTED)
    set_target_properties(GTI_LLVM::libclang PROPERTIES IMPORTED_LOCATION
                                                        "${_gti_libclang_path}")
  endif()
else()
  find_dependency(LLVM @GTI_LLVM_VERSION@ EXACT CONFIG)

  foreach(component IN ITEMS Support TargetParser Demangle)
    if(NOT TARGET "LLVM${component}")
      set(GTI_FOUND FALSE)
      set(GTI_NOT_FOUND_MESSAGE
          "LLVM @GTI_LLVM_VERSION@ does not provide LLVM${component}")
      return()
    endif()
    if(NOT TARGET "GTI_LLVM::${component}")
      add_library("GTI_LLVM::${component}" INTERFACE IMPORTED)
      set_target_properties(
        "GTI_LLVM::${component}"
        PROPERTIES INTERFACE_LINK_LIBRARIES "LLVM${component}")
    endif()
  endforeach()

  if(NOT COMMAND explicit_map_components_to_libraries)
    include("${LLVM_CMAKE_DIR}/LLVM-Config.cmake")
  endif()
  explicit_map_components_to_libraries(_gti_llvm_backend_libraries
                                       core nativecodegen)
  if(NOT _gti_llvm_backend_libraries)
    set(GTI_FOUND FALSE)
    set(GTI_NOT_FOUND_MESSAGE
        "LLVM @GTI_LLVM_VERSION@ does not provide core/nativecodegen")
    return()
  endif()
  if(NOT TARGET GTI_LLVM::Backend)
    add_library(GTI_LLVM::Backend INTERFACE IMPORTED)
    set_target_properties(
      GTI_LLVM::Backend
      PROPERTIES INTERFACE_LINK_LIBRARIES "${_gti_llvm_backend_libraries}")
  endif()

  # The bindgen archive's one clang-project dependency (ADR 021). Clang must
  # be the one matching the LLVM resolved above: a host carrying several
  # clang CMake packages otherwise resolves whichever it finds first, which
  # then references component archives that its distribution never shipped.
  # The hint mirrors GTI's own build-time discovery and anchors the lookup
  # beside the located LLVM package.
  find_dependency(Clang @GTI_LLVM_VERSION@ EXACT CONFIG
                  HINTS "${LLVM_DIR}/../clang")
  if(NOT TARGET libclang)
    set(GTI_FOUND FALSE)
    set(GTI_NOT_FOUND_MESSAGE
        "The Clang package matching LLVM @GTI_LLVM_VERSION@ does not provide libclang")
    return()
  endif()
  if(NOT TARGET GTI_LLVM::libclang)
    add_library(GTI_LLVM::libclang INTERFACE IMPORTED)
    set_target_properties(GTI_LLVM::libclang
                          PROPERTIES INTERFACE_LINK_LIBRARIES libclang)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GTITargets.cmake")
check_required_components(GTI)
