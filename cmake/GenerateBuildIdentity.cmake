if(NOT DEFINED GTI_BUILD_IDENTITY_OUTPUT OR
   "${GTI_BUILD_IDENTITY_OUTPUT}" STREQUAL "")
  message(FATAL_ERROR "GTI_BUILD_IDENTITY_OUTPUT is required")
endif()

set(GTI_SOURCE_COMMIT "")
set(GTI_SOURCE_STATE "unavailable")
if(DEFINED GTI_GIT_EXECUTABLE AND
   NOT "${GTI_GIT_EXECUTABLE}" STREQUAL "" AND
   DEFINED GTI_SOURCE_DIRECTORY AND
   NOT "${GTI_SOURCE_DIRECTORY}" STREQUAL "")
  execute_process(
    COMMAND "${GTI_GIT_EXECUTABLE}" -C "${GTI_SOURCE_DIRECTORY}"
            rev-parse --verify HEAD
    RESULT_VARIABLE GTI_COMMIT_RESULT
    OUTPUT_VARIABLE GTI_COMMIT_OUTPUT
    ERROR_QUIET
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )
  string(LENGTH "${GTI_COMMIT_OUTPUT}" GTI_COMMIT_LENGTH)
  if(GTI_COMMIT_RESULT EQUAL 0 AND GTI_COMMIT_LENGTH EQUAL 40 AND
     GTI_COMMIT_OUTPUT MATCHES "^[0-9a-fA-F]+$")
    string(TOLOWER "${GTI_COMMIT_OUTPUT}" GTI_SOURCE_COMMIT)
    execute_process(
      COMMAND "${GTI_GIT_EXECUTABLE}" -C "${GTI_SOURCE_DIRECTORY}"
              status --porcelain --untracked-files=normal
      RESULT_VARIABLE GTI_STATUS_RESULT
      OUTPUT_VARIABLE GTI_STATUS_OUTPUT
      ERROR_QUIET
    )
    if(GTI_STATUS_RESULT EQUAL 0)
      if("${GTI_STATUS_OUTPUT}" STREQUAL "")
        set(GTI_SOURCE_STATE "clean")
      else()
        set(GTI_SOURCE_STATE "dirty")
      endif()
    else()
      set(GTI_SOURCE_COMMIT "")
    endif()
  endif()
endif()

get_filename_component(GTI_BUILD_IDENTITY_DIRECTORY
                       "${GTI_BUILD_IDENTITY_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${GTI_BUILD_IDENTITY_DIRECTORY}")
set(GTI_BUILD_IDENTITY_TEMPORARY "${GTI_BUILD_IDENTITY_OUTPUT}.tmp")
file(WRITE "${GTI_BUILD_IDENTITY_TEMPORARY}"
     "#pragma once\n"
     "#define GTI_COMPILER_SOURCE_STATE \"${GTI_SOURCE_STATE}\"\n"
     "#define GTI_COMPILER_SOURCE_COMMIT \"${GTI_SOURCE_COMMIT}\"\n")
execute_process(
  COMMAND "${CMAKE_COMMAND}" -E copy_if_different
          "${GTI_BUILD_IDENTITY_TEMPORARY}" "${GTI_BUILD_IDENTITY_OUTPUT}"
  RESULT_VARIABLE GTI_COPY_RESULT
)
file(REMOVE "${GTI_BUILD_IDENTITY_TEMPORARY}")
if(NOT GTI_COPY_RESULT EQUAL 0)
  message(FATAL_ERROR "Failed to publish GTI compiler build identity")
endif()
