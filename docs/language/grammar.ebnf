(* GTI language grammar.

   Terminals are written with their source spelling when the lexer has a fixed
   lexeme, and with the TokenKind name for token classes such as IDENTIFIER or
   INT_LITERAL. PATH_COMPONENT is `[A-Za-z_][A-Za-z0-9_]*` and may have the
   same spelling as a GTI keyword because it occurs inside a standard-library
   path. This file intentionally follows the current token surface in
   include/gti/token.h.

   IDENTIFIER values beginning with `__gti_` are reserved for compiler-
   generated names and are rejected during lexing. C++20/C++23 core keyword
   spellings are also excluded from IDENTIFIER. `delete` is accepted only as
   the special-member policy token. These restrictions do not apply to
   PATH_COMPONENT.

   INT_LITERAL accepts decimal digits, hexadecimal `0x`/`0X` digits, and
   binary `0b`/`0B` digits. Every spelling is decoded as one unsigned
   magnitude no larger than uint64_t before semantic type selection.

   One-level raw pointers use C++-familiar `T*`/`const T*` spelling. Operations
   that form or access raw addresses are gated by lexical `unsafe` blocks.

   Whitespace, `//` line comments, and non-nesting `/* ... */` block comments
   are discarded between tokens. A block comment may span lines and ends at
   the first `*/`; an unterminated block comment is a lexical error. Comment
   delimiters inside string and character literals are literal content.
*)

source-file            = { include-directive | declaration } END_OF_FILE ;

include-directive      = "#include"
                         ( STRING_LITERAL | angle-include-path )
                         [ ";" ] ;

angle-include-path     = "<" PATH_COMPONENT "/" PATH_COMPONENT
                         { "/" PATH_COMPONENT } ">" ;

(* Source loading resolves include directives into a graph of independently
   parsed source units before assembling `program`. Quoted paths are relative
   .gti files. Paths such as `<std/array>` resolve to `std/array.gti` beneath
   the compiler-managed standard-library root and never search the project or
   native C++ include paths. A non-`std` first component is a package alias and
   resolves only through the direct dependency graph explicitly supplied by
   project mode; direct compilation does not discover it from a manifest.
   Quoted paths cannot cross package boundaries when that graph is active.
   All forms are loaded once and may only appear at
   top level. A trailing semicolon is optional. Include cycles are invalid. A
   source unit sees its own declarations, direct includes, and the implicit
   standard prelude; an include's dependencies are not re-exported. This is
   dependency loading, not textual macro preprocessing. Only the entry source
   unit may declare the top-level `main` function.
*)

program                = { declaration } END_OF_FILE ;

declaration            = conditional-declaration
                       | compile-error-directive
                       | concept-declaration
                       | compiler-concept-declaration
                       | class-declaration
                       | enum-declaration
                       | namespace-declaration
                       | type-alias-declaration
                       | extern-c-declaration
                       | [ runtime-binding ] function-declaration
                       | static-variable-declaration
                       | variable-declaration
                       | empty-declaration ;

empty-declaration      = ";" ;

conditional-declaration
                       = "#if" target-condition { declaration }
                         { "#elif" target-condition { declaration } }
                         [ "#else" { declaration } ] "#endif" ;

target-condition       = "target" "." target-property
                         ( "==" | "!=" ) STRING_LITERAL ;

target-property        = "os" | "vendor" | "arch" ;

compile-error-directive
                       = "#error" STRING_LITERAL ;

(* Compile-time conditionals are parsed as GTI syntax. Every branch must be
   syntactically valid, but only the selected host-target branch is analyzed
   and emitted. An active `#error` emits its string as a GTI diagnostic; an
   inactive one has no semantic effect. Directives do not lower to C++
   preprocessor directives. Includes cannot appear inside a compile-time
   conditional. *)

namespace-declaration  = "namespace" IDENTIFIER
                         ( namespace-body | namespace-alias ) ;

namespace-body         = "{" { declaration } "}" ;

namespace-alias        = "=" qualified-name ";" ;

type-alias-declaration = "using" IDENTIFIER "=" type ";" ;

concept-declaration    = "concept" IDENTIFIER
                         "<" concept-parameter-list ">" "="
                         concept-application
                         { ( "&&" | "and" ) concept-application } ";" ;

concept-parameter-list = IDENTIFIER { "," IDENTIFIER } ;

concept-application    = qualified-name "<" IDENTIFIER
                         { "," IDENTIFIER } ">" ;

compiler-concept-declaration
                       = compiler-constraint-binding "concept" IDENTIFIER
                         "<" concept-parameter-list ">" ";" ;

compiler-constraint-binding
                       = "@" "compiler_constraint" "(" STRING_LITERAL ")" ;

(* Source concepts are namespace-scoped declarations over one or more distinct
   type parameters. Their right-hand side is a non-empty conjunction, and every
   application argument must name one of that declaration's type parameters.
   An application supplies the referenced concept's exact arity and may map,
   reorder, or reuse the enclosing parameters. Concepts may be referenced
   before their declaration; cycles are invalid. Disjunction, negation,
   expression requirements, specialization, and constraint-based overload
   ranking are not part of this layer.

   `@compiler_constraint` is reserved syntax. Semantic analysis accepts it only
   for compiler-owned concepts in the trusted prelude's `gti_internal`
   namespace. Each binding maps one declaration to one irreducible unary fact
   or exact structural relationship. Ordinary source cannot create or name a
   binding directly. Compiler-trusted standard-library units may compose a
   bound declaration into public source concepts. *)

enum-declaration       = "enum" "class" IDENTIFIER
                         [ ":" integer-type ]
                         "{" [ enumerator { "," enumerator } [ "," ] ] "}"
                         ";" ;

enumerator             = IDENTIFIER [ parameter-clause ]
                         [ "=" signed-integer-literal ] ;

signed-integer-literal = [ "+" | "-" ] INT_LITERAL ;

(* GTI supports scoped enums only. Enumerators are addressed through
   `EnumName::value` (or a namespace-qualified/aliased enum name) and are not
   injected into the surrounding namespace. Each enum is a distinct nominal
   type: it does not implicitly convert to integers or bool and participates
   only in exact initialization, exact calls, and equality with the same enum
   type. The backing type defaults to int32_t and may be an explicit fixed
   integral primitive. This first layer confines explicit values to signed
   integer literals; duplicate names and values outside the backing range are
   invalid, while duplicate numeric values are allowed.

   If any enumerator has a parameter clause, the declaration is a payload
   enum. A payload enum has no explicit backing type or enumerator initializer.
   A payload alternative is constructed as `EnumName::case(arguments)`; a
   unit alternative is the value `EnumName::case` and is not called. Payload
   field restrictions and exhaustive switch patterns are semantic rules. *)

(* Type aliases are transparent, namespace-scoped names for complete types.
   They are available regardless of declaration order and cannot be generic.
   Alias cycles and aliases whose target contains a reference are invalid;
   keeping `&` at each use site preserves explicit borrow syntax. The standard
   prelude defines `std::size_t` as `uint64_t`, `std::ptrdiff_t` as `int64_t`,
   and `std::string_view` as the compiler-defined counted text-view type. *)

extern-c-declaration   = "extern" STRING_LITERAL "{"
                         { extern-c-function-declaration } "}" ;

extern-c-function-declaration
                       = [ "static" ] [ "mut" ] type IDENTIFIER
                         [ generic-parameter-clause ]
                         parameter-clause ";" ;

(* The linkage string must decode to exactly `"C"`. The block is valid only at
   namespace scope and may contain only bodyless free-function declarations.
   Semantic analysis rejects generics, `static`, writable returns, overloading
   or redeclaration of a program-global C symbol, and every parameter or return
   type outside the bounded native ABI.

   Returns are limited to `void`, the fixed-width signed and unsigned integer
   types, `float`, `double`, valid `[[c_abi]]` records, and one-level raw
   pointers whose pointee is `void`, one of those scalar types, a valid native
   record, or a `[[c_opaque]]` handle. Parameters are immutable by-value
   instances of the same scalar and native-record types, the admitted pointer
   types, plus `std::string_view` as a non-retained counted input buffer. A
   raw-pointer pointee may be qualified with `const`. `int`,
   `uint`, suffix-less fixed-width spellings, and transparent aliases follow
   their resolved fixed-width type. Bool, char, enums, ordinary complete
   classes, expected,
   references, arrays, packs, string-view returns, native variables,
   pointer-to-pointer types, and function pointers are not part of this
   contract. Calling a pointer-bearing C declaration requires an `unsafe`
   block; scalar-only calls and the counted string-view case remain safe. The
   exact function identifier is the native C symbol; a containing GTI namespace
   affects source lookup but does not qualify or mangle that symbol. See
   `native-c-interop.md` and `raw-pointers.md`. *)

runtime-binding        = "@" "runtime" "(" STRING_LITERAL ")" ;

(* Runtime bindings are a legacy compiler-owned, bodyless declaration surface
   restricted to a closed set of validated host-service identities. The
   standard prelude declares its native runtime entry points through the
   bounded `extern "C"` surface above. `@runtime` is not a general FFI.
*)

class-declaration      = [ class-attributes ]
                         class-key IDENTIFIER [ generic-parameter-clause ]
                         [ base-clause ]
                         ( "{" { class-member } "}" ";" | ";" ) ;

class-attributes       = "[[" class-attribute
                         { "," class-attribute } "]]" ;

class-attribute        = IDENTIFIER ;

class-key              = "class" | "struct" | "interface" | "union" ;

base-clause            = ":" base-specifier { "," base-specifier } ;

base-specifier         = [ "public" | "private" ] base-type ;

class-member           = conditional-class-members
                       | compile-error-directive
                       | access-specifier
                       | constructor-declaration
                       | destructor-declaration
                       | operator-declaration
                       | method-declaration
                       | static-variable-declaration
                       | variable-declaration
                       | empty-declaration ;

conditional-class-members
                       = "#if" target-condition { class-member }
                         { "#elif" target-condition { class-member } }
                         [ "#else" { class-member } ] "#endif" ;

access-specifier       = ( "public" | "private" ) ":" ;

(* Class members are private by default and struct members are public by
   default. An access specifier changes the visibility of following members.
   A union is always public and semantic analysis restricts it to passive
   instance fields; the shared parser surface keeps malformed declarations
   recoverable for one focused diagnostic.
   Private members are accessible from methods of their declaring type.

   Inheritance is intentionally narrower than C++. Every base must be written
   with explicit `public` access. A class or struct may have at most one
   state-bearing class/struct base and any number of interface bases. An
   interface may inherit only interfaces. Duplicate bases, inheritance cycles,
   and diamonds are invalid. Private inheritance is accepted by the parser only
   so semantics can recommend composition; `protected` is not a keyword.

   An interface is a public behavior-only contract. It cannot contain access
   labels, fields, constructors, destructors, static methods, or method bodies.
   Every interface method is a declaration-only signature ending with `;`.
   The enclosing `interface` makes the method implicitly virtual and pure, so
   the C++ pure specifier `= 0;` is redundant and ill-formed in an interface.

   An attribute list may precede only a class, struct, or interface. Semantics
   accepts `no_transfer`, `no_share`, `unsafe_transfer`, and `unsafe_share` on
   ordinary classes/structs; interfaces instead accept `transfer` and `share`
   requirements. A non-generic passive struct may use `c_abi` instead to opt
   into the closed native C record contract. It then contains only public
   instance fields from the admitted scalar, one-level pointer, and nested
   native-record family, with no field initializers, bases, access sections,
   methods, static fields, constructors, cleanup, or copy/move policies.
   Initialization belongs in a safe wrapper or native factory. `c_abi` cannot be
   combined with a concurrency capability attribute. The alternative
   declaration-only class form is accepted solely for
   `[[c_opaque]] struct Name;`: it is nongeneric, baseless, has no layout or
   members, and may appear only behind one raw pointer. Other incomplete type
   declarations are rejected with `GTI-S2065`. Identifier syntax is
   deliberately broader so unknown, misplaced, duplicate, and conflicting
   attributes receive a recoverable semantic diagnostic rather than a parser
   cascade (`GTI-S2059` for capability policy, `GTI-S2064` for C ABI records,
   and `GTI-S2065` for opaque handles).

   A class or struct may contain one direct read-only reference field. Every
   constructor must initialize it directly from one exact read-only reference
   parameter. Such a value is move-constructible, noncopyable, and
   nonassignable. Mutable or multiple reference fields, nested or inherited
   borrowed state, user cleanup, global/static/captured storage, and
   dependency-changing assignment are rejected by semantics. An instance
   method may return the direct carrier from its receiver; a free function or
   static method may return it from one eligible read-only parameter. The
   dependency survives concrete generic carrier relays, calls, moves, returns,
   and drops. Mutable/exclusive stored origins or multiple origins remain
   unsupported. *)

constructor-declaration
                       = IDENTIFIER [ generic-parameter-clause ] parameter-clause
                         [ constructor-initializer-list ] block
                       | IDENTIFIER special-constructor-parameter-clause
                         special-member-specifier ;

special-constructor-parameter-clause
                       = "(" base-type ( "&" | "&&" ) [ IDENTIFIER ] ")" ;

special-member-specifier
                       = "=" ( "default" | "delete" ) ";" ;

constructor-initializer-list
                       = ":" constructor-initializer
                         { "," constructor-initializer } ;

constructor-initializer
                       = base-type "(" [ initializer-expression
                         { "," initializer-expression } ] ")" ;

destructor-declaration = "~" IDENTIFIER "(" ")" block ;

method-declaration     = [ "virtual" ] [ "static" ] [ "constexpr" ]
                         [ "mut" ] type IDENTIFIER
                         [ generic-parameter-clause ]
                         parameter-clause [ "mut" ] [ requires-clause ]
                         [ "override" ]
                         method-terminator ;

operator-declaration   = [ "virtual" ] [ "constexpr" ] [ "mut" ] type "operator"
                         call-operator parameter-clause
                         [ call-receiver-qualifier ] [ requires-clause ]
                         [ "override" ] method-terminator
                       | [ "virtual" ] [ "constexpr" ] [ "mut" ] type "operator"
                         non-call-overloadable-operator parameter-clause
                         [ "mut" ] [ requires-clause ] [ "override" ]
                         method-terminator
                       | [ "virtual" ] "operator" "bool" parameter-clause
                         [ "mut" ] [ requires-clause ] [ "override" ]
                         method-terminator ;

method-terminator      = block | ";" | pure-specifier ;

pure-specifier         = "=" INT_LITERAL ";" ;

call-operator          = "(" ")" ;

call-receiver-qualifier
                       = "mut" | "&&" ;

non-call-overloadable-operator
                       = "*" | "->" | "++" | "=" | "[" "]"
                       | "==" | "!=" | "<" | "<=" | ">" | ">=" ;

function-declaration   = [ "static" ] [ "constexpr" ] [ "mut" ] type IDENTIFIER
                         [ generic-parameter-clause ]
                         parameter-clause [ requires-clause ]
                         ( block | ";" ) ;

requires-clause        = "requires" concept-application
                         { ( "&&" | "and" ) concept-application } ;

(* A leading `mut` on a function declaration requires a reference return.
   A free/static borrowed return is accepted when every reachable return
   derives either from one eligible read-only parameter (read-only result only)
   or from one exact namespace-global/non-generic-static place. The latter may
   be writable in the single-threaded profile and retains its exact projection
   path for caller-side conflict checking. *)

generic-parameter-clause
                       = "<" generic-parameter
                         { "," generic-parameter } ">" ;

generic-parameter      = [ generic-constraint ] IDENTIFIER [ "..." ]
                       | ( "uint64_t" | "uint64" ) IDENTIFIER ;

generic-constraint     = qualified-name ;

parameter-clause       = "(" [ parameter-list ] ")" ;

parameter-list         = parameter { "," parameter } ;

parameter              = [ "mut" ] type [ "..." ] [ IDENTIFIER ]
                         { array-extent } ;

(* A constructor name must match its owning class or struct. Constructor calls
   use `Type(arguments)` and are never implicit conversions. Constructors form
   overload sets by exact parameter types; parameter names and by-value `mut`
   do not distinguish signatures. A constructor initializer names either the
   one state-bearing base or an immediate field. The base initializer comes
   first and uses exact constructor matching; field initializers then appear in
   field declaration order. Omitted bases require an accessible zero-argument
   constructor. A field initializer supplies a default when a constructor omits
   that field. All initialization runs before a body that cannot return.
   When no zero-argument overload is declared, the compiler generates `Type()`
   if every field has a declaration initializer, even when other constructor
   overloads exist.

   Copy/move construction and assignment are derived independently from
   lifecycle traits rather than C++ special-member suppression. A class or
   struct may make its copy and move construction policy explicit with one
   public `Type(Type&) = default|delete;` and one public
   `Type(Type&&) = default|delete;` declaration. `T&&` is confined to that move
   policy and is not a general reference or forwarding-reference type.
   Defaulting cannot make a structurally unavailable operation available.
   Custom copy/move bodies remain unavailable until constructor-wide definite
   initialization and active-drop transitions are represented. Copy/move
   assignment remains an independently derived operation.

   A class or struct may declare one public `~Type()` body. It is automatically
   invoked, has an implicitly mutable receiver, cannot return or take
   parameters, and runs before reverse-order field destruction. Cleanup-owning
   values are noncopyable; compiler-generated moves transfer an active-drop
   state so the source cleanup body runs exactly once. Manual destructor calls
   are not syntax. Field immutability remains a GTI semantic rule and is not
   delegated to the C++ representation.

   Methods have read-only receivers by default. A trailing `mut` permits writes
   to mutable fields and requires a mutable object at the call site. The exact
   trailing `&&` receiver qualifier is reserved for `operator()` and consumes
   its receiver; it is not a general rvalue-reference type or a qualifier for
   ordinary methods. A leading `mut` is valid only for a reference return from
   a mutable method. It makes the returned receiver-derived place writable.
   Inside a method or destructor, `this` names the current non-null object and
   uses ordinary `.` member access; it is not a source-level raw pointer. `self`
   remains an IDENTIFIER. *)

(* A class or struct method becomes a virtual root with `virtual`; a pure root
   ends with the exact spelling `= 0;`. Interface signatures instead end with
   `;` and are implicitly virtual and pure. An implementation of an inherited
   virtual signature must use `override`. Parameter types, receiver mutability,
   operator identity, and return type must match exactly; covariant returns and
   method-level generics are not part of virtual dispatch. An override may
   satisfy identical contracts inherited from multiple interfaces.

   A type with an unimplemented pure contract is abstract and cannot be
   constructed by value. Derived-to-base conversion is available only when an
   explicit base reference is initialized or returned; ordinary calls retain
   exact argument matching and objects never slice into base values. Every
   polymorphic type has compiler-generated virtual destruction even though GTI
   exposes no destructor qualifier. *)

(* A static method has no receiver, cannot use `this`, cannot have a trailing
   `mut` qualifier, and cannot overload an instance method with the same name.
   Static operator overloads are invalid. Static data members are owned by the
   class or struct rather than an object, require an in-class initializer, and
   are accessed as `Type::member`; object access is rejected. The current
   qualified-expression grammar does not support static members on generic
   classes or structs. A static method may return a reference from one exact
   global/static place under the reference rules below. Static members do not
   participate in object layout, construction, generated special members, or
   destruction. *)

(* Operator overloads are class or struct members and cannot have method type
   parameters or runtime bindings. `operator*` and `operator->` take no
   parameters and return checked references. `operator=`, `operator[]`, and
   the comparison operators `==`, `!=`, `<`, `<=`, `>`, and `>=` take one
   exact-match parameter. `operator=` requires a mutable receiver. Prefix
   `operator++` takes no parameters, returns void, and requires a mutable
   receiver; postfix overloading is not provided.
   `operator()` takes any number of exact-match parameters and may return any
   otherwise-valid function return type. In addition to the
   ordinary read-only and trailing-`mut` forms, it may use trailing `&&` to
   declare a consuming once-callable receiver. That form is invoked only from
   an explicitly moved named local, by-value parameter, supported writable
   field, or constant-index fixed-array element. A consuming form cannot return
   a reference or tracked borrowed state and cannot be virtual, pure,
   overriding, or an interface requirement.
   Comparisons and contextual `operator bool` return bool and use a read-only
   receiver.
   `operator->`
   performs one checked reference step; recursive proxy lookup is not provided.
   `operator bool` participates only in conditions, logical `and`/`or`
   (`&&`/`||`), and `!`. No free operators, implicit conversions,
   argument-dependent lookup, or synthesized equality candidates are provided.
   Read-only, mutable, and consuming `operator()` overloads may coexist when
   their exact signatures and receiver qualifiers distinguish them. Other
   operators retain only their admitted read-only or mutable forms. *)

(* Functions and methods may share a name when their normalized parameter type
   lists differ. Return types, parameter names, and by-value parameter
   mutability do not distinguish overloads. An ordinary method may pair
   read-only and trailing-`mut` overloads with the same parameter types. A
   read-only receiver can select only the read-only member; a mutable receiver
   prefers the mutable member when both match. For `operator()`, an explicit
   `std::move(value)()` receiver prefers an otherwise exact consuming overload;
   invoking that overload consumes the source under ordinary path-sensitive
   move-state rules. Calls require one unique exact
   parameter match after generic substitution, apart from the bounded raw-
   pointer `nullptr` and added-pointee-`const` compatibility. GTI performs no
   other implicit argument conversions and has no general conversion-ranking
   or best-match rules. Runtime bindings and the main entry point are not
   overloadable.

   Every reachable path through a non-void function, method, operator, or
   lambda must return a value. Active target-condition branches participate in
   this check. A loop prevents fallthrough only when it is proven not to exit.
   The top-level main entry point retains C++'s defined implicit return of
   zero. It is a definition with signature `int main()` or
   `int main(int, std::vector<std::string>)`. Parameter names and ordinary
   by-value `mut` qualifiers do not affect that identity, and aliases may name
   the exact types. The owned argument form requires the canonical imported
   standard-library string and vector identities. No native `char**` or other
   pointer-shaped main signature is provided. *)

variable-declaration   = [ "constexpr" ] [ "mut" ] type IDENTIFIER
                         { array-extent }
                         [ "=" initializer-expression
                         | direct-initializer ] ";" ;

structured-binding-declaration
                       = "auto" "[" IDENTIFIER
                         { "," IDENTIFIER } "]"
                         "=" initializer-expression ";" ;

static-variable-declaration
                       = "static" [ "constexpr" ] [ "mut" ] type IDENTIFIER
                         { array-extent }
                         [ "=" initializer-expression
                         | direct-initializer ] ";" ;

(* At namespace scope, `static` gives a variable or function source-unit
   internal linkage: it is visible only inside the file that declares it and
   may reuse a name used by another source unit. `main` cannot be static.
   Block-scope static declarations are intentionally not supported. *)

(* `constexpr` bindings are immutable and initialized; class and struct fields
   must also be static. The compiler-owned evaluator supports fixed-width
   integers, IEEE-754 binary32 float, IEEE-754 binary64 double, bool, char,
   string_view, nullptr_t, scalar expressions, checked integer operations,
   binary32/binary64 arithmetic and
   comparisons, and explicit numeric conversions. Bounded constexpr free
   functions and static methods add scalar locals, mutation, structured control
   flow, recursion, and calls to available constexpr definitions. Evaluation
   has one 4096-step budget and a 64-call-depth limit.

   `if constexpr` requires a computed bool and analyzes and lowers only its
   selected branch. Generic or instance-function execution, class values,
   allocation, references, arrays, and runtime, intrinsic, or C calls remain
   outside the evaluator. Native C++ constant evaluation is never the GTI
   semantic authority. *)

direct-initializer     = "{" [ assignment-expression
                         { "," assignment-expression } [ "," ] ] "}" ;

type                   = ( raw-pointer-base | base-type )
                         { array-extent } [ "&" ] ;

raw-pointer-base       = [ "const" ] base-type "*" ;

base-type              = primitive-type
                       | user-type
                       | expected-type
                       | "auto"
                       | "nullptr_t"
                       | "void" ;

(* `auto` is accepted only on an initialized local variable declaration,
   including either form of for-loop binding. It infers the initializer's
   complete type without implicit conversion and is immutable unless preceded
   by `mut`. The `auto&` and `mut auto&` reference forms are valid only for a
   range-for element declaration. It is not valid for globals, fields,
   parameters, return types, or array declarators. Plain `auto` never silently
   infers a reference. A braced initializer does not provide a type by itself.
   Inferred values retain their ownership traits, so move-only lvalues still
   require an explicit `std::move`. A lambda initializer also requires an
   immutable binding. *)

(* `T*` and `const T*` are nullable, non-owning, one-level raw-pointer types.
   `const` is valid here only when followed by `*` and makes the pointee
   read-only. Leading declaration `mut` controls whether the pointer binding
   may be reseated; it does not change pointee access. Pointer-to-pointer types,
   references to raw pointers, function pointers, pointer-to-array types, and
   implicit array decay are rejected semantically. A fixed array may contain
   one-level pointer values. Raw-pointer variables and fields require an
   explicit initializer, normally `nullptr`.

   Carrying, copying, assigning, passing, returning, null comparison, compatible
   equality, and adding `const` pointee qualification are safe. Address
   formation, dereference, indexing, arrow access, pointer arithmetic, and a
   pointer-bearing C call require a lexical `unsafe` block. Raw pointers own no
   storage and create no semantic loan. See `raw-pointers.md`. *)

(* A structured binding is one immutable local declaration. Its initializer
   is evaluated once into a hidden owned value, and each visible name denotes
   a read-only projection of that value. The first layer accepts exact-arity
   fixed arrays and flat class/struct values whose direct instance fields are
   all public. It rejects `mut auto`, `auto&`, nested patterns, inherited
   fields, stored references, untyped braced initializers, and partial moves
   of an individual name. Structured bindings are not valid at namespace or
   class scope or in a for-loop initializer. *)

(* Direct initialization is confined to class and struct declarations. The
   declared type supplies the construction target, and the arguments select
   one exact constructor just as in `Type(arguments)`. It is not C++ list
   initialization: primitives, fixed arrays, references, scoped enums,
   `auto`, `Type name = {...}`, and aggregate/initializer-list preference are
   not part of this syntax. Empty braces select an exact zero-argument declared
   or generated constructor. Parenthesized block-scope declarations remain
   invalid so `Type name(arguments)` cannot acquire C++'s declaration
   ambiguity. *)

array-extent           = "[" array-extent-expression "]" ;

array-extent-expression
                       = array-extent-additive-expression ;

array-extent-additive-expression
                       = array-extent-multiplicative-expression
                         { ( "+" | "-" )
                           array-extent-multiplicative-expression } ;

array-extent-multiplicative-expression
                       = array-extent-primary-expression
                         { ( "*" | "/" | "%" )
                           array-extent-primary-expression } ;

array-extent-primary-expression
                       = INT_LITERAL | IDENTIFIER
                       | "(" array-extent-expression ")" ;

initializer-expression
                       = expression | array-initializer ;

array-initializer      = "{" [ initializer-expression
                         { "," initializer-expression } [ "," ] ] "}" ;

(* C++ declarator spelling is canonical for declarations: `int values[4]`.
   Array suffixes may remain attached to a type where no declarator exists,
   such as a generic type argument or array return type. Every extent is either
   a checked arithmetic expression over integer literals and earlier
   non-negative integer constexpr bindings, or one in-scope uint64_t value
   parameter, and is part of the exact type. Concrete arithmetic supports `+`,
   `-`, `*`, `/`, `%`, and parentheses; overflow, negative results, and zero
   divisors are semantic errors. A value parameter must be the complete extent
   until symbolic compile-time expressions are represented in type identity.
   Variable-length arrays are not supported.

   Fixed arrays are inline contiguous values with no pointer decay. An array
   of one-level raw-pointer elements is still an array and does not expose the
   array's address. A non-empty
   initializer must provide exactly one value per element; `{}` value-initializes
   every element and requires a default-initializable element type. Elements
   initialize in increasing index order and destroy in decreasing index order;
   nested initializer temporaries remain in the declaration's full-expression.
   Array copy, move, assignment, and destruction follow the element type.
   Bindings remain immutable unless declared `mut`.

   Indexing accepts integer expressions. Constant out-of-range indexes are
   semantic errors and invalid dynamic indexes terminate with a stable runtime
   diagnostic. `array.size()` returns the compile-time extent as
   `std::size_t` (canonically `uint64_t`) without storing a runtime length. Fixed
   arrays do not expose `.data()`. *)

expected-type          = "expected" "<" type "," type ">" ;

(* `void` is accepted syntactically as a type and restricted semantically to
   function return types, a one-level `void*` pointee, and the value position
   of `expected<void, E>`. The error type E cannot be void. `void*` is opaque:
   it may be carried, compared, passed, and returned, but not dereferenced,
   indexed, used for member access, or used in pointer arithmetic. GTI does not
   implicitly convert between a typed pointer and `void*`.

   `T&` is a non-null read-only borrow and `mut T&` is a writable borrow.
   References may be parameters and local bindings and must bind an addressable
   place. A method may return `T&` only when every returned value is derived
   from `this`; the resulting borrow is tied to the receiver and cannot be
   retained from a temporary receiver. A free function or static method may
   return a read-only reference derived from one eligible `T&` parameter, or a
   read-only/writable reference derived from one exact global/static place in
   the single-threaded profile. Temporary global call borrows end at the full
   expression; retained writable aliases conflict until their lexical scope
   ends. A move-only owner with a retained borrow cannot be moved, replaced, or
   passed to a mutable method until the loan ends. Multi-origin and nested
   references, reference fields outside the confined carrier above, reference
   globals, references over arrays, and references to raw pointers remain
   unsupported.

   `gti_internal::storage<T>` parses through `user-type` but has
   compiler-defined semantics. It is a reserved move-only owner for standard
   library containers. Its allocate, capacity, construct, borrowed read,
   destroy, and relocate operations are ordinary qualified-call syntax
   recognized and checked as compiler intrinsics. A class or struct containing
   storage, directly or through another field, is also move-only after generic
   type substitution. Storage rejects element types containing borrowed state.
   Construction accepts a final variadic argument sequence, selects one exact
   accessible element constructor after concrete pack expansion, and constructs
   directly in an empty slot. Primitive elements accept zero arguments for
   value initialization or one exact value. Relocation requires a movable
   element type. These operations expose no raw address or independent
   deallocation operation.
*)

primitive-type         = integer-type | "float" | "double" | "bool" | "char" ;

integer-type           = signed-integer-type | unsigned-integer-type ;

signed-integer-type    = "int" | "int8_t" | "int16_t" | "int32_t"
                       | "int64_t"
                       | "int8" | "int16" | "int32" | "int64" ;

unsigned-integer-type  = "uint" | "uint8_t" | "uint16_t" | "uint32_t"
                       | "uint64_t"
                       | "uint8" | "uint16" | "uint32" | "uint64" ;

(* `char` is one exact unsigned 8-bit character code unit and remains distinct
   from `uint8_t`. It supports initialization, assignment, and equality with
   another `char`; it does not participate in arithmetic or integer
   constraints. The explicit `uint8_t(character)` form extracts the same eight
   code-unit bits and cannot fail. It does not make `char` numeric, is never
   implicit, and does not add the inverse `char(uint8_t)` conversion. A
   CHARACTER_LITERAL must decode to exactly one code unit and supports `\\`,
   `\'`, `\"`, `\n`, `\r`, `\t`, and `\0` escapes.

   A STRING_LITERAL has type `std::string_view`. It is an immutable counted
   view over static literal storage, so embedded zero bytes are preserved and
   copying the view does not allocate. A view provides `size()`, `empty()`, and
   checked read-only integer indexing that returns `char` by value. A constant
   out-of-range literal index is a semantic error; a dynamic out-of-range index
   terminates with a stable runtime diagnostic.

   The former unqualified `string` keyword is removed. `std::string` is an
   ordinary source-defined standard-library class imported with
   `#include <std/string>`. It owns `char` storage, is move-only to prevent
   implicit allocating copies, and provides explicit `clone()` when duplication
   is intended. It does not expose a dynamic string view until borrowed-view
   lifetimes are represented by the language. *)

(* The `_t` fixed-width spellings are canonical. Their suffix-less forms are
   exact compatibility aliases and the formatter rewrites them to `_t`.
   Both spelling families are lexer-owned primitive types; neither requires a
   source include or a `std::` qualifier.
   `int` is an exact alias for `int32_t`; `uint` is an exact alias for
   `uint32_t`. Integer literals use int32_t, int64_t, or uint64_t according to
   their value, and may initialize any integer type when they are in range.
   Variable conversions may widen only when every source value fits the
   destination. As in C++, arithmetic promotes all 8- and 16-bit integers to
   int32_t. Mixed
   signed/unsigned operands are valid only when the emitted C++ conversion
   cannot reinterpret a possible negative value as unsigned.

   `%`, `~`, `&`, `^`, `|`, `<<`, and `>>` accept integers only. Modulo and
   binary bitwise operators use the arithmetic promotion and safe common-type
   rules above. A shift returns the promoted left operand type. Shift counts
   must be nonnegative and smaller than that type's width. Invalid dynamic
   divisors and shift counts terminate with a GTI runtime error. Signed
   minimum modulo -1 is 0, left shift wraps by bit pattern, and signed right
   shift is arithmetic.

   Signed and unsigned `+`, `-`, and `*` terminate on overflow. Integer `/`
   terminates on zero or signed minimum divided by -1. Unary negation and
   increment/decrement use the same checked arithmetic. Compound assignment
   evaluates its target place once, applies the corresponding checked rule,
   then checks conversion back to the target type. An integer target requires
   an integer right operand. *)

user-type              = qualified-name [ generic-argument-clause ] ;

generic-argument-clause
                       = "<" generic-argument
                         { "," generic-argument } ">" ;

generic-argument       = type | INT_LITERAL ;

qualified-name         = IDENTIFIER { "::" IDENTIFIER } ;

block                  = "{" { block-item } "}" ;

block-item             = conditional-block-items
                       | compile-error-directive
                       | structured-binding-declaration
                       | variable-declaration
                       | statement ;

conditional-block-items
                       = "#if" target-condition { block-item }
                         { "#elif" target-condition { block-item } }
                         [ "#else" { block-item } ] "#endif" ;

statement              = block
                       | unsafe-statement
                       | if-statement
                       | do-while-statement
                       | while-statement
                       | for-statement
                       | range-for-statement
                       | switch-statement
                       | loop-control-statement
                       | return-statement
                       | discarded-expression-statement
                       | expression-statement ;

unsafe-statement       = "unsafe" block ;

(* `unsafe` grants permission for the raw-pointer operations enumerated by the
   type contract only within its ordinary lexical block. Blocks may nest. A
   lambda body starts a new safety context and therefore requires its own
   `unsafe` block. Unsafe code remains subject to all ordinary type, access,
   initialization, ownership, and control-flow checks. The programmer must
   prove pointer validity, lifetime, alignment, type, initialization, bounds,
   provenance, writable access, and native-call requirements as applicable;
   violating one of those obligations is undefined behavior. *)

if-statement           = "if" [ "constexpr" ] "(" expression ")" statement
                         [ "else" statement ] ;

while-statement        = "while" "(" expression ")" statement ;

do-while-statement     = "do" statement "while" "(" expression ")" ";" ;

(* A do-while body executes at least once. `continue` evaluates the condition
   before the next iteration, while `break` exits directly. The condition uses
   the same exact contextual-bool rule and lexical cleanup guarantees as other
   loops. *)

for-statement          = "for" "(" for-init [ expression ] ";" [ expression ] ")"
                         statement ;

for-init               = variable-declaration | expression-statement ;

range-for-statement    = "for" "(" range-for-declaration ":" expression ")"
                         statement ;

range-for-declaration  = [ "mut" ] type IDENTIFIER { array-extent } ;

(* Range-based for uses an ordinary structural protocol rather than a
   compiler-known stdlib type. The range must be a stable addressable value and
   provide exact zero-argument `begin()` and `end()` members. `begin()` returns
   an iterator value; `end()` may return a distinct sentinel value. The
   iterator provides an exact `operator!=(Sentinel&)` with one read-only
   sentinel reference parameter, plus `operator*()` and mutable prefix
   `operator++()` operations. The dereference operator returns a checked
   reference; a by-value loop binding copies that element, while `T&`/`auto&`
   and their leading-`mut` forms bind with the declared access. The compiler
   resolves every operation in semantics and lowers it through HIR/MIR; it does
   not invoke C++ range lookup or recognize `std::vector`/`std::array` names.
   `continue` executes the selected increment operation before the next test.
   Fixed arrays do not yet supply this member protocol. Imported
   standard-library iterators may retain one checked read-only storage borrow
   through the confined stored-reference contract. A free/static factory may
   propagate one such owner dependency from an eligible read-only parameter;
   mutable, nested, or multiple owner-borrowing iterators and dedicated
   range/element loan scopes remain later lifetime layers. *)

switch-statement       = "switch" "(" expression ")"
                         "{" { switch-item } "}" ;

switch-item            = switch-label | block-item ;

switch-label           = "case" logical-or-expression ":" | "default" ":" ;

(* Switch subjects are concrete integer, char, or scoped-enum values. Case
   labels must be compile-time literals, explicitly converted integer
   literals, or enumerators whose type exactly matches the subject; labels do
   not perform implicit conversions. Duplicate values and duplicate default
   labels are invalid. Adjacent labels form one arm. Every executable arm must
   terminate on every path with an explicit break, return, or a valid continue
   inside an enclosing loop, so GTI has no implicit fallthrough. Each arm is a
   lexical scope even without source braces. A payload-enum label is either a
   unit alternative or `EnumName::case(bindings...)`. Bindings are immutable
   copied values local to that arm. Without `default`, every payload variant
   must appear exactly once. *)

loop-control-statement = ( "break" | "continue" ) ";" ;

(* `break` exits the nearest enclosing loop or switch. `continue` advances the
   nearest enclosing loop to its next iteration and remains invalid in a
   switch that is not itself inside a loop. *)

return-statement       = "return" [ initializer-expression ] ";" ;

discarded-expression-statement
                       = "[[" "discard" "]]" expression ";" ;

(* A discarded-expression statement must contain a call to a function with a
   non-void return type. Non-void function results are otherwise required to be
   used by the surrounding expression, stored, passed, or returned.
*)

expression-statement   = [ expression ] ";" ;

(* Expression precedence follows C++ for the currently tokenized operators.
   Precedence does not import C++ evaluation order: GTI evaluates operands,
   call arguments, and initializer constituents strictly left to right under
   Execution Section 4.2. Assignment targets are checked semantically,
   evaluated first and once; syntactically the left side is parsed as a
   logical-or expression. The comma operator sequences its operands but does
   not end the enclosing full-expression.
*)

expression             = comma-expression ;

comma-expression       = assignment-expression { "," assignment-expression } ;

assignment-expression  = conditional-expression
                         [ assignment-operator initializer-expression ] ;

assignment-operator    = "=" | "+=" | "-=" | "*=" | "/=" | "%="
                       | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

conditional-expression = logical-or-expression
                         [ "?" expression ":" assignment-expression ] ;

(* Conditional expressions evaluate the condition first and exactly one arm.
   The condition uses GTI's exact contextual-bool rule. Both arms must have the
   same exact type, and the result is always a value: place arms copy, while a
   move-only place requires explicit `std::move`. Result types containing
   borrowed state remain invalid until MIR can merge branch-selected loans.
*)

logical-or-expression  = logical-and-expression
                         { ( "or" | "||" ) logical-and-expression } ;

logical-and-expression = bitwise-or-expression
                         { ( "and" | "&&" ) bitwise-or-expression } ;

bitwise-or-expression  = bitwise-xor-expression
                         { "|" bitwise-xor-expression } ;

bitwise-xor-expression = bitwise-and-expression
                         { "^" bitwise-and-expression } ;

bitwise-and-expression = equality-expression
                         { "&" equality-expression } ;

equality-expression    = relational-expression
                         { ( "==" | "!=" ) relational-expression } ;

relational-expression  = shift-expression
                         { ( "<" | "<=" | ">" | ">=" ) shift-expression } ;

shift-expression       = additive-expression
                         { ( "<<" | ">>" ) additive-expression } ;

additive-expression    = multiplicative-expression
                         { ( "+" | "-" ) multiplicative-expression } ;

multiplicative-expression
                       = unary-expression
                         { ( "*" | "/" | "%" ) unary-expression } ;

unary-expression       = ( "!" | "+" | "-" | "*" | "&" | "~" | "++" | "--" )
                         unary-expression
                       | postfix-expression ;

postfix-expression     = primary-expression { postfix-suffix } ;

postfix-suffix         = call-suffix | member-suffix | index-suffix
                       | increment-suffix ;

call-suffix            = [ generic-argument-clause ]
                         "(" [ argument-list ] ")" ;

argument-list          = call-argument { "," call-argument }
                       | { call-argument "," } pack-expansion ;

call-argument          = assignment-expression | array-initializer ;

pack-expansion         = IDENTIFIER "..." ;

(* A call evaluates its callable/receiver once, then initializes parameters
   from left to right. A concrete final pack contributes elements at its
   written position in pack order. Invocation begins only after every
   parameter is live.

   A brace argument is not a general expression or `std::initializer_list`.
   It requires one selected exact by-value fixed-array parameter `T[N]` and
   initializes that owned value under the element type and extent supplied by
   the parameter. It does not infer a common element type, prefer a list
   overload, perform CTAD, or add implicit conversions. Empty braces
   value-initialize the selected fixed array. Contextual braces are currently
   available for named function/method calls and constructors, not generic
   `operator()` dispatch. *)

(* Generic declarations introduce named type parameters. A type parameter may
   have one namespace-resolved unary, non-structural concept before its name,
   such as
   `T minimum<std::totally_ordered T>(T left, T right)`. The numeric constraints
   are `std::numeric`, `std::signed_numeric`, `std::integral`,
   `std::signed_integral`, `std::unsigned_integral`, and
   `std::floating_point`. Lifecycle constraints are `std::copyable`,
   `std::movable`, and `std::default_initializable`; comparison constraints are
   `std::equality_comparable` and `std::totally_ordered`. `std::ordered` remains
   a compatibility spelling for total ordering. These public concepts are
   declared by the implicit standard prelude and are available without an
   explicit include. User source may compose them with `concept` declarations.

   Numeric constraints classify integer and floating primitive subsets.
   Lifecycle constraints inspect GTI construction and assignment availability.
   A nominal class satisfies `std::equality_comparable` only when it has exact public,
   read-only bool `operator==` and `operator!=` members taking one read-only
   reference to its own concrete type. `std::totally_ordered` additionally
   requires `operator<`, `operator<=`, `operator>`, and `operator>=` with the
   same shape. No operator is synthesized and no implicit conversion satisfies
   a capability. A constrained type parameter may use its guaranteed operators
   while its generic body is checked. `T(value)` is a checked numeric conversion
   when T satisfies `std::numeric` or a stronger numeric constraint; `T()` is
   valid when T satisfies `std::default_initializable`.

   Every explicit or inferred concrete argument must satisfy its parameter's
   constraint, and every element bound to a constrained pack is checked.
   Passing one symbolic type parameter to another requires the source's
   resolved capability set to contain the destination set. Relationships such
   as signed integral implying integral and numeric are expressed by source
   concept composition in the prelude, not by a compiler-owned implication
   graph.

   A trailing requires clause is a bounded conjunction of concept applications
   whose arguments name visible non-pack generic type parameters. It can
   express exact multi-type relationships, such as
   `std::sentinel_for<Sentinel, Iterator>`,
   and its facts are active while the symbolic body is checked. Concrete
   instantiation substitutes and validates every application again. The current
   structural concepts prove only their compiler-defined exact operator shapes:
   read-only input iterator dereference plus mutable prefix increment,
   iterator/sentinel inequality, and exact read-only dereference-referent
   compatibility for accumulation.
   Public concepts compose private declaration-identity-bound capabilities;
   public names are not compiler-recognized.

   Inline and trailing constraints affect validity only. They do not
   distinguish overload signatures, rank candidates, provide SFINAE, or select
   specializations. A trailing clause is semantically rejected on an operator
   or a virtual, pure, overriding, or interface method. Concept disjunction,
   negation, general requires-expressions, arbitrary expression requirements,
   and specialization are not implemented.

   A class or struct may follow its type parameters with immutable `uint64_t`
   value parameters, such as `class array<T, uint64_t N>`. Every class value
   argument is an integer literal or an in-scope value parameter. Value
   parameters participate in exact class type identity and may be used as
   fixed-array extents or nested generic arguments. Although an identifier in
   a generic argument is syntactically also a type, semantic analysis resolves
   it from the target declaration's parameter kind. Type parameters must
   precede value parameters.

   A function, non-polymorphic method, or constructor may use the narrower
   inferred form `uint64_t N` only when `N` is the complete extent of one
   by-value fixed-array parameter. A named fixed array supplies its exact
   extent and a contextual brace argument supplies its written element count.
   Type parameters must be inferred from ordinary typed arguments; braces do
   not synthesize a common type. Constructor-local parameters appear after the
   constructor name. Inferred values participate in concrete function or
   constructor instance identity. Explicit function/constructor value
   arguments, other value types, arbitrary expressions, defaults, value packs,
   and value-generic virtual/operator call surfaces are not implemented.

   A function or method
   may declare one final type pack with `Args...`, bound by one final named,
   immutable, by-value parameter pack such as `Args... args`. The pack may be
   empty. `args...` is permitted only as the final argument of a call to another
   variadic function or method. This makes forwarding explicit without adding
   arbitrary expansion contexts, indexing, multiple packs, class packs,
   reference packs, or C++ forwarding-reference deduction. Source-defined
   `std::vector::emplace_back` uses this bounded form: it constructs an element
   in place but does not promise C++ perfect forwarding, so copyable arguments
   may be copied on entry to the by-value pack.

   One additional expression may iterate that same named pack:
   `(function_call(fixed, args), ...)`. The pattern is exactly one ordinary
   free-function or static-method call, contains the bare pack name exactly
   once as its final argument, and has only named-place fixed arguments. The
   selected target is one non-overloaded generic `void` declaration whose
   final type parameter represents one pack element. Its corresponding value
   parameter is read-only; the fold cannot move from or mutably borrow an
   element. The target is selected symbolically, then every concrete pack
   element is rechecked as one exact specialization. An empty pack is a
   well-formed no-op. Binary/operator folds, member calls, overload selection
   per element, arbitrary fold patterns, multiple pack occurrences, and
   mutable or consuming element access are not implemented.

   Generic class and struct applications always provide every type argument,
   including at constructor calls. Generic function arguments may be explicit
   or inferred exactly from call arguments. For a variadic call, explicit type
   arguments first bind every fixed generic parameter; any remaining explicit
   arguments bind the pack, otherwise each pack element is inferred in order.
   Repeated parameters must infer the same type. Inference does not use return
   context or implicit conversions. A symbolic pack may only forward into
   another final pack, so invalid generic bodies are rejected by GTI rather than
   deferred to generated C++.

   Fixed generic function, method, class, and constructor instances are
   rechecked in typed HIR after concrete substitution. Move-only arguments are
   therefore valid when the body transfers rather than copies them. A concrete
   parameter pack containing any move-only element is one owned unit: its first
   whole-pack expansion consumes it, and a later expansion is a use-after-move
   error. Copyable packs may be expanded more than once. User generic type
   arguments cannot be void. Pack indexing, partial pack movement, general
   iteration beyond the bounded call fold, and `auto`-driven generic deduction
   are not implemented. *)

(* `std::unique_ptr<T>` is a nominal standard-library class over the
   compiler-private `gti_internal::unique_owner<T>` capability.
   `std::make_unique<T>(arguments)` is an ordinary variadic stdlib function;
   typed HIR records and rechecks its concrete instance, including the nested
   allocation and constructor call. The compiler does not recognize the public
   factory name. Ownership transfer is explicit with
   `std::move(owner)`. Dereference uses `*owner`, and owned member access uses
   `owner->member`; both terminate with a stable runtime diagnostic when the
   owner is empty. The wrapper can be a local, function value, field,
   fixed-array element, non-escaping local reference, fixed generic type
   argument, or a once-forwarded variadic pack element. Unique-owner globals
   remain unavailable. An exact `nullptr_t` constructor permits target-typed
   `std::unique_ptr<T> owner = nullptr` initialization, while exact
   `operator=(nullptr_t)` and `reset()` empty an existing mutable owner. These
   rules do not add an implicit class conversion to call,
   constructor-argument, or return-value overload resolution. Explicit
   `std::upcast_unique<Base, Derived>(owner)` consumes a derived owner only
   when `Base` is a public polymorphic base with safe destruction; it does not
   add an implicit owner conversion to overload resolution. *)

(* `std::move(value)` is a compiler-defined explicit move operation for a named
   movable local value, by-value parameter, writable named field path rooted in
   one of those values or mutable `this`, or an in-range constant-index element
   of a directly owned fixed array. It consumes the exact place on every
   reachable path; any later overlapping read is an error until valid plain
   assignment reinitializes that place. Different constant elements remain
   disjoint, but a dynamic index may alias every element and is not movable. A
   method cannot return with a moved receiver place. References, globals,
   already-created lambda capture fields, temporaries, and dynamic indexed
   places are not movable through the current operation. A lambda capture
   initializer may use the separately defined
   `[name = std::move(local)]` form to move an enclosing local or by-value
   parameter into a new closure field. Moving a copyable value is valid but
   still consumes the source, avoiding C++'s observable unspecified
   moved-from state. *)

member-suffix          = ( "." | "->" ) IDENTIFIER ;

index-suffix           = "[" expression "]" ;

increment-suffix       = "++" | "--" ;

primary-expression     = literal
                       | numeric-conversion
                       | layout-query-expression
                       | qualified-name
                       | lambda-expression
                       | unexpected-expression
                       | "this"
                       | "nullptr"
                       | pack-fold-expression
                       | "(" expression ")" ;

pack-fold-expression   = "(" assignment-expression "," "..." ")" ;

(* The assignment-expression in a pack fold is syntactically required to have
   a call as its root. The semantic restrictions above make this a bounded
   pack operation rather than the C++ fold-expression family. *)

lambda-expression      = lambda-capture-list parameter-clause "->" type block ;

lambda-capture-list    = "[" [ lambda-capture { "," lambda-capture } ] "]" ;

lambda-capture         = IDENTIFIER
                       | IDENTIFIER "=" "std" "::" "move"
                         "(" IDENTIFIER ")" ;

(* Lambda parameters and returns are explicit and calls use exact type
   matching. A bare listed capture is an immutable value snapshot of a
   copyable local binding. `[owned = std::move(source)]` is the only init
   capture: it moves one available movable local or by-value parameter into an
   immutable environment field and immediately leaves `source` moved.
   Capture defaults, reference and other init captures, implicit capture,
   `this`, and mutable lambdas are rejected. Lambda values are lexical.
   They may be copied into another local `auto` binding or passed to a direct
   by-value generic parameter whose visible body uses it as a confined
   callable. Calls may require exact `void`, exact `bool`, or an exact
   non-reference value without tracked borrowed state or lambda identity,
   supplied by an explicit initializer, assignment target, condition, or
   enclosing return type. Concrete instantiation checks every invocation
   against the lambda or exact class `operator()` signature. A callable
   parameter declared without `mut` permits only repeatable read-callable
   invocation. `mut Operation operation` permits repeatable mutable invocation
   and accepts either a read-callable target or a class target whose selected
   `operator()` is `mut`. Writing `std::move(operation)()` on a direct by-value
   generic parameter instead declares a confined once-callable use. It accepts
   an exact reusable read- or mut-callable target as well as a class target with
   an exact trailing-`&&` `operator()`, consumes the parameter place, and is
   rejected when any reachable path could use or invoke that place again. A
   callable parameter may pass through another direct by-value generic
   parameter only
   when that selected parameter has a visible, proven confined contract;
   semantics, HIR, and MIR retain the forwarding edge. Once invoked, a confined
   parameter cannot occur in the function's return type. `auto` result
   inference, callable references, reference or borrowed-state results, owned
   escape, and storage in globals or fields are not part of this callable
   layer. *)

unexpected-expression  = "unexpected" "(" assignment-expression ")" ;

numeric-conversion     = ( integer-type | "float" | "double" )
                         "(" assignment-expression ")" ;

layout-query-expression
                       = layout-query-operator "(" type ")" ;

layout-query-operator  = "sizeof" | "alignof" ;

(* `sizeof(type)` and `alignof(type)` are reserved-word operators with one
   parenthesized type operand. Expression operands and unparenthesized forms
   are not grammar alternatives. Both produce an exact `uint64_t` frontend
   constant from the selected GTI target layout; `alignof` reports ABI
   alignment, not preferred alignment.

   The bounded operand set is a primitive scalar, one-level raw pointer, a
   transparent alias to a supported type, or a recursively supported fixed
   array with concrete positive extents. Pointer layout is independent of
   whether its pointee is itself queryable. Bare `void`, `nullptr_t`,
   references, enums, classes, structs, interfaces, expected values,
   compiler-private types, direct symbolic type parameters, symbolic or zero
   extents, and size overflow are rejected semantically. No source record
   currently has a layout-stable opt-in.

   `layout-query-expression` is deliberately absent from
   `array-extent-expression`. A named non-negative `constexpr uint64_t`
   initialized by a query may be used as an extent through the existing
   IDENTIFIER form. *)

(* Numeric conversions use familiar functional-cast spelling but are GTI
   operations. Integer-to-integer and floating-to-integer conversions are checked
   before the native conversion is performed. Invalid dynamic values terminate
   with a GTI runtime error. Floating-to-integer conversion truncates toward
   zero; integer-to-floating conversion rounds to the selected binary32 or
   binary64 destination using round-to-nearest, ties-to-even. `double` to
   `float` requires this explicit conversion form. Integer literals outside
   the destination range are semantic
   errors. Bool, char, string-view, class, expected, pointer, and reference
   conversions are not provided by this syntax. *)

(* `return value;` constructs the success state of an expected return type.
   `return unexpected(error);` constructs its error state. A bare `return;`
   constructs success only for `expected<void, E>`.
*)

literal                = INT_LITERAL
                       | FLOAT_LITERAL
                       | CHARACTER_LITERAL
                       | STRING_LITERAL
                       | "true"
                       | "false" ;

(* FLOAT_LITERAL is one or more decimal digits, `.`, and one or more decimal
   digits, optionally followed by `d` or `D`. Exponents, other suffixes,
   hexadecimal forms, leading/trailing-dot forms, infinity, and NaN spellings
   are not accepted. The complete decimal digits are rounded directly to
   IEEE-754 binary32 when unsuffixed or binary64 when suffixed, using
   round-to-nearest, ties-to-even. Finite-range overflow is a lexical error;
   underflow rounds to a subnormal value or positive zero. *)
