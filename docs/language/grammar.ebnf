(* GTI language grammar.

   Terminals are written with their source spelling when the lexer has a fixed
   lexeme, and with the TokenKind name for token classes such as IDENTIFIER or
   INT_LITERAL. PATH_COMPONENT is `[A-Za-z_][A-Za-z0-9_]*` and may have the
   same spelling as a GTI keyword because it occurs inside a standard-library
   path. This file intentionally follows the current token surface in
   include/gti/token.h.

   IDENTIFIER values beginning with `__gti_` are reserved for compiler-
   generated names and are rejected during lexing. C++20/C++23 core keyword
   spellings are also excluded from IDENTIFIER. `delete` is accepted only as
   the special-member policy token. These restrictions do not apply to
   PATH_COMPONENT.

   A source unit is strict UTF-8 and may begin with one UTF-8 byte-order mark.
   The BOM is discarded before the first grammar symbol while all token spans
   retain their original byte offsets. LF and CRLF each separate logical
   lines; a lone CR is invalid. IDENTIFIER and fixed token spellings are ASCII.
   Non-ASCII scalar values are accepted only in comments and STRING_LITERAL;
   CHARACTER_LITERAL continues to denote exactly one 8-bit code unit.

   INT_LITERAL accepts decimal digits, hexadecimal `0x`/`0X` digits, and
   binary `0b`/`0B` digits. Every spelling is decoded as one unsigned
   magnitude no larger than uint64_t before semantic type selection.

   Recursive raw pointers use C++-familiar `T*`/`const T*` spelling with
   per-layer qualification. Inert address formation from an admitted checked
   place is safe; raw projections and memory/native-call operations require
   lexical `unsafe` permission.

   Whitespace, ordinary `//` line comments, and non-nesting `/* ... */` block
   comments are discarded between tokens. Contiguous `///` lines immediately
   before a declaration are retained as that declaration's Markdown metadata.
   A block comment may span lines and ends at the first `*/`; an unterminated
   block comment is a lexical error. Comment delimiters inside string and
   character literals are literal content.
*)

source-file            = [ module-declaration ]
                         { include-directive | import-declaration | declaration }
                         END_OF_FILE ;

module-declaration     = "export" "module" IDENTIFIER ";" ;
import-declaration     = [ "export" ] "import"
                         ( IDENTIFIER [ "." IDENTIFIER ] | STRING_LITERAL ) ";" ;
export-declaration     = "export" declaration ;
(* Imports and the module header are unconditional source-unit-level syntax.
   Exports apply to namespace-scope API declarations only and require a module
   interface. Duplicate export modifiers and exported static declarations are
   invalid. An exported namespace exports its child declarations, not private
   imported dependencies. Class member access is unchanged. A first import
   component `std` names the standard library: `import std.name;` selects the
   module interface of `<std/name>`, and the bare `import std;` is invalid. *)

include-directive      = [ "export" ] "#include"
                         ( STRING_LITERAL | angle-include-path )
                         [ ";" ] ;
(* `export #include` is valid only in a module interface and republishes that
   one legacy unit, but not its own includes, to the interface's importers. *)

angle-include-path     = "<" PATH_COMPONENT "/" PATH_COMPONENT
                         { "/" PATH_COMPONENT } ">" ;

(* Source loading resolves include directives into a graph of independently
   parsed source units before assembling `program`. Quoted paths are relative
   .gti files. Paths such as `<std/array>` resolve to `std/array.gti` beneath
   the compiler-managed standard-library root and never search the project or
   native C++ include paths. A non-`std` first component is a package alias and
   resolves only through the direct dependency graph explicitly supplied by
   project mode; direct compilation does not discover it from a manifest.
   Quoted paths cannot cross package boundaries when that graph is active.
   All forms are loaded once and may only appear at
   top level. A trailing semicolon is optional. Include cycles are invalid. A
   source unit sees its own declarations, direct includes, and the implicit
   standard prelude; an include's dependencies are not re-exported. This is
   dependency loading, not textual macro preprocessing. Only the entry source
   unit may declare the top-level `main` function.
*)

program                = { declaration } END_OF_FILE ;

declaration            = conditional-declaration
                       | export-declaration
                       | configuration-directive
                       | compile-error-directive
                       | static-assert-declaration
                       | concept-declaration
                       | conformance-declaration
                       | compiler-concept-declaration
                       | class-declaration
                       | enum-declaration
                       | namespace-declaration
                       | type-alias-declaration
                       | extern-c-declaration
                       | [ function-contract-attributes ] macro-declaration
                       | native-function-attributes function-declaration
                       | function-contract-attributes function-declaration
                       | [ runtime-binding ] function-declaration
                       | out-of-class-method-definition
                       | static-variable-declaration
                       | variable-declaration
                       | empty-declaration ;

empty-declaration      = ";" ;

unsafe-function-modifier = "unsafe" ;
(* GTI free functions, ordinary source constructors and non-polymorphic instance/static methods;
   not special-member policies, destructors, operators, virtual/interface-instance/override methods,
   runtime bindings, extern-C declarations or hosted main. Every call requires a
   lexical unsafe block. The modifier grants no unsafe permission to the body
   and cannot be erased by callback or safe function-item conversion. *)

function-contract-attributes = function-contract-attribute
                              { function-contract-attribute } ;
function-contract-attribute = "[[" function-contract-name
                              { "," function-contract-name } "]]" ;
function-contract-name = "test" | "noreturn" | "track_caller" | "discardable" | "thread_confined_callback"
                       | "borrowed_from" "(" ( IDENTIFIER | "this" ) ")" ;
(* test: defined, safe, non-generic namespace-scope void functions with no
   parameters or attribute arguments. Explicit test targets discover these
   functions and execute them separately; ordinary compilation does not run them.
   noreturn/track_caller: defined, non-polymorphic GTI functions only, except trusted compiler
   intrinsic declarations; operator annotations are rejected semantically.
   noreturn forbids normal returns and reachable
   fallthrough. track_caller propagates the external caller location through
   direct calls. Neither changes the declared result type.
   discardable permits ignoring a non-void function or method result; it
   does not change evaluation, failure, cleanup, borrowing or the result type.
   borrowed_from selects one checked reference parameter, the single external
   dependency of a by-value carrier parameter, or a non-static
   receiver as the returned reference's owner. Safe returns must preserve it.
   On a declaration whose result type is a generic parameter it binds only the
   instances whose substituted result is a checked reference, and it may name
   a final parameter pack: the one reference element of the expanded pack in
   that instance owns the result. Protocol operations may state this contract;
   their implementations preserve the selected parameter position.
   A direct raw dereference returned inside lexical unsafe may assert that
   relationship, retaining known lifetime/access contradictions. *)

conditional-declaration
                       = conditional-start { declaration }
                         { "#elif" compile-condition { declaration } }
                         [ "#else" { declaration } ] "#endif" ;

conditional-start      = "#if" compile-condition
                       | "#ifdef" IDENTIFIER
                       | "#ifndef" IDENTIFIER ;

configuration-directive
                       = ( "#define" | "#undef" ) IDENTIFIER ;

compile-condition      = compile-or ;
compile-or             = compile-and { "||" compile-and } ;
compile-and            = compile-unary { "&&" compile-unary } ;
compile-unary          = "!" compile-unary | compile-primary ;
compile-primary        = "defined" "(" IDENTIFIER ")"
                       | target-condition
                       | "(" compile-condition ")" ;

target-condition       = "target" "." target-property
                         ( "==" | "!=" ) STRING_LITERAL ;

target-property        = "os" | "vendor" | "arch" ;

compile-error-directive
                       = "#error" STRING_LITERAL ;

static-assert-declaration
                       = "static_assert" "(" assignment-expression
                         [ "," STRING_LITERAL ] ")" ";" ;

(* Compile-time conditionals are parsed as GTI syntax. Every branch must be
   syntactically valid, but only the branch selected by the target and
   source-ordered valueless configuration flags is analyzed and emitted.
   `#define` and `#undef` never substitute tokens or carry values. An active
   `#error` emits its string as a GTI diagnostic; an inactive one has no
   semantic effect. Directives do not lower to C++ preprocessor directives.
   Includes cannot appear inside a compile-time
   conditional. *)

(* A static assertion is a compile-time declaration with no symbol or runtime
   effect. Its condition must resolve to exact bool and must be evaluable by
   GTI's bounded constexpr evaluator. A dependent assertion in a generic
   declaration is evaluated once for each canonical concrete instance. *)

namespace-declaration  = "namespace" IDENTIFIER
                         ( { "::" IDENTIFIER } namespace-body
                         | namespace-alias ) ;

(* A namespace path is shorthand for nested namespace declarations, with
   each component counting toward the ordinary parser nesting limit.
   Namespace alias declarations still introduce a single identifier. *)

namespace-body         = "{" { declaration } "}" ;

namespace-alias        = "=" qualified-name ";" ;

type-alias-declaration = "using" IDENTIFIER "=" [ "mut" ] type ";" ;
(* A mutable associated type definition must name a checked reference.
   Ordinary reference aliases remain outside the implemented alias surface. *)

native-function-type   = "(" [ type { "," type } ] ")" "->" type ;

concept-declaration    = [ concept-explanation ] "concept" IDENTIFIER
                         "<" concept-parameter-list ">"
                         ( "=" constraint-expression | concept-body ) ";" ;
concept-explanation    = "[[" "unsatisfied" "(" STRING_LITERAL ")" "]]" ;
(* The explanation is nonempty and the declaration's only attribute.
   Compiler-bound concepts take none. *)

concept-body           = "{" { concept-member } "}" ;
concept-member         = "typename" IDENTIFIER ";"
                       | function-declaration ;
(* A concept with a body takes one or more type parameters. A member
   function is a prototype ending in ';' with no generic parameters, requires
   clause, defaults, modifiers, attributes or receiver qualifier. *)

conformance-declaration
                       = "for" [ generic-parameter-clause ] "concept"
                         concept-application
                         "{" { conformance-member } "}" ";" ;
conformance-member     = type-alias-declaration
                       | function-declaration ;
(* A conformance block appears at namespace scope. It gives one pattern per
   concept parameter: a concrete type, or one class or enum template,
   pointer or fixed-length array type applied to block
   parameters. Every block parameter appears in some pattern, and a repeated
   parameter binds one type. It defines each associated type with a type
   alias and each
   operation with a function body; the block's parameters and concept
   application apply to every function, which therefore declares no generic
   parameters, requires clause or default argument of its own. A projection
   `Concept<Type>::name` is a qualified type, and `Concept<Type>::operation`
   is a call target. *)

concept-parameter-list = IDENTIFIER { "," IDENTIFIER } ;

concept-application    = qualified-name "<" type { "," type } ">" ;

constraint-expression = constraint-disjunction ;
constraint-disjunction
                       = constraint-conjunction
                         { ( "||" | "or" ) constraint-conjunction } ;
constraint-conjunction = constraint-primary
                         { ( "&&" | "and" ) constraint-primary } ;
constraint-primary     = concept-application
                       | constraint-predicate
                       | expression-requirement
                       | "(" constraint-expression ")" ;

constraint-predicate   = concept-application "("
                         [ assignment-expression
                           { "," assignment-expression } ] ")" ;
expression-requirement = "requires" [ "(" [ requirement-parameter
                         { "," requirement-parameter } ] ")" ]
                         "{" requirement-check { requirement-check } "}" ;
requirement-parameter  = [ "mut" ] type IDENTIFIER ;
requirement-check      = [ "unsafe" ] "{" assignment-expression "}"
                         "->" type ";" ;
(* A requirement's `mut` parameters must be references. The result is an exact
   owned non-borrowed type, not a C++ result concept. Ordinary expression rules
   apply without executing code or mutating caller flow. The historical direct
   nongeneric member call with a checked receiver and all argument bindings in
   declaration order retains its exact signature-matching contract.
   An unsafe requirement preserves the caller obligation in generic bodies;
   it accepts safe or unsafe implementations. An ordinary requirement accepts
   only safe implementations. Requirements are also boolean primary expressions.
   Predicate calls must be exact bool constants under existing constexpr rules;
   general expressions and negation are not direct constraint leaves. *)

compiler-concept-declaration
                       = compiler-constraint-binding "concept" IDENTIFIER
                         "<" concept-parameter-list ">" ";" ;

compiler-constraint-binding
                       = "@" "compiler_constraint" "(" STRING_LITERAL ")" ;

(* Source concepts are namespace-scoped declarations over one or more distinct
   type parameters. Their right-hand side is a non-empty bounded Boolean
   expression, and every application argument must name one of that
   declaration's type parameters or a closed exact type. An application
   supplies the referenced concept's exact arity and may map, reorder, or reuse
   the enclosing parameters. Concepts may be referenced
   before their declaration; cycles are invalid. Negation, arbitrary expression
   requirements beyond the member signature above, concept specialization, and
   constraint-based overload ranking are not part of this layer.

   `@compiler_constraint` is reserved syntax. Semantic analysis accepts it only
   for compiler-owned concepts in the trusted prelude's `gti_internal`
   namespace. Each binding maps one declaration to one irreducible unary fact
   or exact structural relationship. Ordinary source cannot create or name a
   binding directly. Compiler-trusted standard-library units may compose a
   bound declaration into public source concepts. *)

enum-declaration       = "enum" [ "class" ] IDENTIFIER
                         [ generic-parameter-clause ]
                         [ ":" integer-type ]
                         "{" [ enumerator { "," enumerator } [ "," ] ] "}"
                         ";" ;

enumerator             = IDENTIFIER [ parameter-clause ]
                         [ "=" signed-integer-literal ] ;

signed-integer-literal = [ "+" | "-" ] INT_LITERAL ;

(* GTI supports scoped enums only. The optional `class` keyword is a spelling
   choice with no semantic effect: `enum E` and `enum class E` are identical.
   Enumerators are addressed through
   `EnumName::value` (or a namespace-qualified/aliased enum name) and are not
   injected into the surrounding namespace. Each enum is a distinct nominal
   type: it does not implicitly convert to integers or bool and participates
   only in exact initialization, exact calls, and equality with the same enum
   type. The backing type defaults to int32_t and may be an explicit fixed
   integral primitive. This first layer confines explicit values to signed
   integer literals; duplicate names and values outside the backing range are
   invalid, while duplicate numeric values are allowed.

   If any enumerator has a parameter clause, the declaration is a payload
   enum. A payload enum has no explicit backing type or enumerator initializer.
   A payload alternative is constructed as `EnumName::case(arguments)`; a
   unit alternative is the value `EnumName::case` and is not called. Payload
   field restrictions and exhaustive switch patterns are semantic rules. *)

(* Payload enums may declare ordinary type parameters, a suffix of uint64_t
   value parameters, or one final type pack. Defaults and inline constraints
   use the nominal generic rules. The declaration identity, canonical type
   arguments and value arguments identify each concrete enum. Generic
   integral-only enums are not supported. A concrete alternative may be named
   as `Message<int, 3>::item`, including in construction and switch patterns;
   namespace qualification and transparent aliases preserve exact identity.
   Arguments belong to the owner, not the alternative. There is no enum CTAD
   or partial specialization. Substitution must leave each actual payload field
   inside the same admitted family as a nongeneric payload enum. *)

(* Type aliases are transparent namespace or class-member names for complete
   types. They are available regardless of declaration order in their direct
   declaring scope and cannot themselves declare generic parameters. A class-
   scoped alias follows the surrounding access section and the default access
   of its class key. A public alias on a non-generic owner may be named as
   `Owner::Name`; an alias in a generic owner may use that owner's parameters
   in member signatures and may be selected through `Owner<Args>::Name` in
   type contexts, including chained alias qualifiers. Member aliases do not
   themselves accept generic arguments. Exact class definitions still reject
   aliases, and direct specialized-alias constructor expressions are outside
   this type-context syntax.
   Class aliases are direct members and are not inherited through base types.

   Alias cycles and direct reference aliases are invalid; keeping `&` at each
   binding use site preserves explicit borrow syntax. Reference components in
   generic or function-signature metadata do not create stored borrows. The standard
   prelude defines `std::size_t` as `uint64_t`, `std::ptrdiff_t` as `int64_t`,
   and `std::string_view` as the compiler-defined counted text-view type.

   `(P...) -> R` names a nullable native C function-pointer shape only when it
   is the direct target of a namespace-scope `using` declaration. Later uses
   name that alias; anonymous callback parameters, returns, locals, and fields
   are semantically invalid. Its recursively admitted ABI family and exact
   GTI-function conversion rules are specified in `native-c-interop.md`. *)

extern-c-declaration   = "extern" STRING_LITERAL "{"
                         { extern-c-function-declaration | extern-c-variable-declaration } "}" ;

extern-c-variable-declaration
                       = [ native-link-name-attribute ] [ "mut" ] type
                         IDENTIFIER ";" ;

extern-c-function-declaration
                       = [ native-function-attributes ]
                         [ "static" ] [ "mut" ] type IDENTIFIER
                         [ generic-parameter-clause ]
                         parameter-clause ";" ;

native-function-attributes
                       = native-function-attribute
                         { native-function-attribute } ;

native-function-attribute
                       = native-c-array-attribute
                       | native-link-name-attribute
                       | "[[" "discardable" "]]" ;

native-c-array-attribute
                       = "[[" "c_array" "(" IDENTIFIER ")" "]]" ;

native-link-name-attribute
                       = "[[" "link_name" "(" STRING_LITERAL ")" "]]" ;

(* The linkage string must decode to exactly `"C"`. The block is valid only at
   namespace scope and may contain bodyless free-function declarations or
   foreign variable declarations. Foreign variables cannot have initializers;
   `mut` denotes writable native storage and its absence read-only storage.
   A foreign declaration creates no GTI initialization or cleanup obligation.
   The supported storage types and unsafe access contract are specified in
   `native-c-interop.md`.
   Semantic analysis rejects generics, `static`, writable returns, duplicate
   native attributes, overloading or redeclaration of a program-global C
   symbol, and every parameter or return type outside the bounded native ABI.
   `[[link_name("symbol")]]` keeps source lookup on the declared IDENTIFIER
   while binding the decoded portable C identifier `symbol`; without it the
   source identifier is the link symbol.

   Returns are limited to `void`, target-correct C scalar families, fixed-width
   integer types, `bool`, `float`, `double`, valid `[[c_abi]]` records,
   `c_string`, exact named native function types, and recursive raw pointers
   whose terminal pointee is `void`,
   one of those scalar types,
   `c_string`, a valid native record, a `[[c_opaque]]` handle or exact named
   native callback. `[[c_array(count)]]` supplies a separate count contract
   without changing pointer type identity. Its parameter must be an immutable
   one-level pointer to a writable fixed-width integer. Parameters are
   immutable by-value instances of the same scalar and native-record types,
   the admitted pointer types, plus `std::string_view` as a non-retained
   counted input buffer. Pointer-slot addresses are ordinary inert raw values,
   with native calls and slot dereference requiring `unsafe`. Each
   raw-pointer pointee may be independently qualified with `const`. `int`,
   `uint`, suffix-less fixed-width spellings, and transparent aliases follow
   their resolved fixed-width type. GTI char, enums, ordinary complete
   classes, expected,
   references, arrays, packs, string-view returns, native variables and
   anonymous/general function pointers are not
   part of this contract. `GTI-S2073` owns malformed C-array pairs and
   pointer depth is no longer a contextual ABI exception. Calling a
   pointer-bearing C declaration requires an `unsafe`
   block; scalar-only calls and the counted string-view case remain safe. The
   exact function identifier is the native C symbol; a containing GTI namespace
   affects source lookup but does not qualify or mangle that symbol. See
   `native-c-interop.md` and `raw-pointers.md`. *)

runtime-binding        = "@" "runtime" "(" STRING_LITERAL ")" ;

(* Runtime bindings are a legacy compiler-owned, bodyless declaration surface
   restricted to a closed set of validated host-service identities. The
   standard prelude declares its native runtime entry points through the
   bounded `extern "C"` surface above. `@runtime` is not a general FFI.
*)

class-declaration      = [ declaration-attributes ] [ class-attributes ]
                         ( ordinary-class-declaration
                         | exact-class-specialization ) ;

ordinary-class-declaration
                       = class-key IDENTIFIER
                         [ generic-parameter-clause
                         | generic-signature-pattern-clause ] [ base-clause ]
                         ( "{" { class-member } "}" ";" | ";" ) ;

(* A headerless patterned primary, not an exact specialization. Bare
   unqualified type leaves declare binders; builtins and qualified type names
   refer to existing types. At least one binder and at most one type pack are
   required. Concrete arguments match exactly after binder substitution.
   Complete single-signature definitions may share a name only for disjoint
   receiver qualifiers, subject to same-kind/package/visibility rules. *)
generic-signature-pattern-clause
                       = "<" function-signature
                         { "," type } ">" ;

exact-class-specialization
                       = class-key qualified-specialization-name
                         generic-argument-clause [ base-clause ]
                         "{" { class-member } "}" ";" ;

qualified-specialization-name
                       = IDENTIFIER "::" qualified-name ;

class-attributes       = "[[" class-attribute
                         { "," class-attribute } "]]" ;

class-attribute        = IDENTIFIER [ "(" IDENTIFIER ")" ] ;
(* An argument is valid only for unsafe_transfer/unsafe_share and names one
   non-pack type parameter of the annotated class/struct. `attribute` marks a
   struct as an attribute type; `reflect_private` opens a class or struct's
   private fields to reflected access. *)

(* A declared attribute names an `[[attribute]]` struct by qualified name and
   initializes its fields positionally or by designator with constant
   expressions. It annotates a class-like declaration or an instance field;
   the compiler records the constant and gives it no meaning. *)
declaration-attributes = "[[" declaration-attribute
                         { "," declaration-attribute } "]]" ;

declaration-attribute  = qualified-name [ "(" [ attribute-arguments ] ")" ] ;

attribute-arguments    = expression { "," expression }
                       | designated-attribute-argument
                         { "," designated-attribute-argument } ;

designated-attribute-argument
                       = "." IDENTIFIER "=" expression ;

class-key              = "class" | "struct" | "interface" | "union" ;

base-clause            = ":" base-specifier { "," base-specifier } ;

base-specifier         = [ "public" | "protected" | "private" ] base-type ;

class-member           = conditional-class-members
                       | nested-class-declaration
                       | configuration-directive
                       | compile-error-directive
                       | static-assert-declaration
                       | type-alias-declaration
                       | mutable-field-group
                       | access-specifier
                       | constructor-declaration
                       | destructor-declaration
                       | [ function-contract-attributes ] operator-declaration
                       | [ function-contract-attributes ] method-declaration
                       | static-variable-declaration
                       | [ declaration-attributes ] variable-declaration
                       | empty-declaration ;

(* Named class/struct definitions nest in a non-generic class/struct.
   Anonymous records, nested interface/union declarations, and capturing an
   enclosing generic's arguments are not admitted by this slice. *)
nested-class-declaration = [ declaration-attributes ] [ class-attributes ]
                          ( "class" | "struct" ) IDENTIFIER
                          [ generic-parameter-clause
                          | generic-signature-pattern-clause ] [ base-clause ]
                          ( "{" { class-member } "}" ";" | ";" ) ;

conditional-class-members
                       = conditional-start { class-member }
                         { "#elif" compile-condition { class-member } }
                         [ "#else" { class-member } ] "#endif" ;

mutable-field-group    = "mut" "{" mutable-field-group-item
                         { mutable-field-group-item } "}" ;

mutable-field-group-item
                       = conditional-mutable-field-group-items
                       | configuration-directive
                       | compile-error-directive
                       | grouped-field-declaration
                       | empty-declaration ;

conditional-mutable-field-group-items
                       = conditional-start { mutable-field-group-item }
                         { "#elif" compile-condition
                           { mutable-field-group-item } }
                         [ "#else" { mutable-field-group-item } ] "#endif" ;

grouped-field-declaration
                       = type IDENTIFIER { array-extent }
                         [ "=" initializer-expression
                         | direct-initializer ] ";" ;

access-specifier       = ( "public" | "protected" | "private" ) ":" ;

(* A `mut { ... }` member is admitted only in a complete class or struct. Each
   direct grouped field has exactly the semantics of the same declaration with
   a leading `mut`; the group introduces no name, scope, storage, layout, or
   runtime boundary. The surrounding access section applies to every grouped
   field. Groups cannot contain access labels, static or constexpr fields,
   methods, constructors, destructors, operators, nested groups, or an
   explicitly repeated `mut`, and no semicolon follows the closing brace.

   Class members are private by default and struct members are public by
   default. An access specifier changes the visibility of following members.
   A union is always public and semantic analysis restricts it to passive
   instance fields; the shared parser surface keeps malformed declarations
   recoverable for one focused diagnostic.
   Private members are accessible in their declaring type and lexical nested
   types. Protected members additionally admit derived contexts; instance
   access requires a receiver of that accessing derived type or a descendant.

   Inheritance is intentionally narrower than C++. Every base must be written
   with explicit `public` access. A class or struct may have at most one
   state-bearing class/struct base and any number of interface bases. An
   interface may inherit only interfaces. Duplicate bases, inheritance cycles,
   and diamonds are invalid. Private and protected inheritance are accepted
   by the parser only so semantics can require explicit public inheritance.

   An interface is a public instance behavior-only contract. It cannot contain
   fields, constructors, destructors or instance method bodies. Its static
   methods are ordinary receiver-free functions with ordinary access labels,
   constraints, defaults and definition-closure rules, not virtual requirements.
   Every interface instance method is public and a declaration-only signature
   ending with `;`. The enclosing `interface` makes it implicitly virtual and pure, so
   the C++ pure specifier `= 0;` is redundant and ill-formed in an interface.

   An attribute list may precede only a class, struct, union, or interface. Semantics
   accepts `no_transfer`, `no_share`, `unsafe_transfer`, and `unsafe_share` on
   ordinary classes/structs; interfaces instead accept `transfer` and `share`
   requirements. A non-generic passive struct or union may use `c_abi` instead to opt
   into the closed native C record contract. It then contains only public
   instance fields from the admitted scalar, recursive pointer, fixed-array,
   callback and nested native-record family, with no field initializers,
   bases, access sections,
   methods, static fields, constructors, cleanup, or copy/move policies.
   Initialization belongs in a safe wrapper or native factory. `c_abi` cannot be
   combined with a concurrency capability attribute. The alternative
   declaration-only class form is accepted solely for
   `[[c_opaque]] struct Name;`: it is nongeneric, baseless, has no layout or
   members, and may appear only behind raw-pointer indirection. Other incomplete
   type declarations are rejected with `GTI-S2065`. Identifier syntax is
   deliberately broader so unknown, misplaced, duplicate, and conflicting
   attributes receive a recoverable semantic diagnostic rather than a parser
   cascade (`GTI-S2059` for capability policy, `GTI-S2064` for C ABI records,
   and `GTI-S2065` for opaque handles).

   A class or struct may contain any number of read-only or mutable reference
   fields, including paths nested through nominal carrier fields. Constructors
   bind each direct reference from an exact reference parameter with matching
   access; nested carriers bind from exact carrier parameters. Independent or
   proven disjoint origins may coexist. Overlapping dependencies conflict when
   either requires exclusive access. Copies retain every shared dependency when
   the complete carrier is copyable; any exclusive dependency makes it
   noncopyable. Moves transfer the complete dependency set. Assignment cannot
   reseat it. Unambiguous constructors, receiver/parameter returns and selected
   stored-field accessors retain field-wise origins through concrete generic
   substitution, calls and cleanup. Cleanup-owning carriers retain their
   external dependencies until their owned fields and cleanup have drained.
   Inherited borrowed state, global/static/captured storage, arrays of carriers
   and ambiguous return origins remain outside this contract. The full current
   lifetime and escape contract is specified in ownership-and-lifetimes.md. *)

(* `implicit` is contextual: it is a modifier only here, before an ordinary
   constructor's name or `constexpr`, and an identifier everywhere else. *)
constructor-declaration
                       = [ "implicit" | "unsafe" ] [ "constexpr" ] IDENTIFIER
                         [ generic-parameter-clause ] parameter-clause
                         [ requires-clause ]
                         [ constructor-initializer-list ] block
                       | IDENTIFIER "(" ")" default-member-specifier
                       | IDENTIFIER special-constructor-parameter-clause
                         special-member-specifier ;

special-constructor-parameter-clause
                       = "(" base-type ( "&" | "&&" ) [ IDENTIFIER ] ")" ;

special-member-specifier
                       = "=" ( "default" | "delete" ) ";" ;

default-member-specifier
                       = "=" "default" ";" ;

constructor-initializer-list
                       = ":" constructor-initializer
                         { "," constructor-initializer } ;

constructor-initializer
                       = base-type "(" [ initializer-expression
                         { "," initializer-expression } ] ")" ;

destructor-declaration = "~" IDENTIFIER "(" ")"
                         ( block | default-member-specifier ) ;

method-declaration     = [ unsafe-function-modifier ]
                         [ "virtual" ] [ "static" ] [ "constexpr" ]
                         [ "mut" ] type IDENTIFIER
                         [ generic-parameter-clause ]
                         parameter-clause [ call-receiver-qualifier ] [ requires-clause ]
                         [ "override" ]
                         method-terminator ;

operator-declaration   = [ "virtual" ] [ "constexpr" ] [ "mut" ] type "operator"
                         call-operator parameter-clause
                         [ call-receiver-qualifier ] [ requires-clause ]
                         [ "override" ] method-terminator
                       | [ "virtual" ] [ "constexpr" ] [ "mut" ] type "operator"
                         non-call-overloadable-operator parameter-clause
                         [ call-receiver-qualifier ] [ requires-clause ] [ "override" ]
                         method-terminator
                       | conversion-operator-declaration ;

(* A conversion operator is named by its target type, which is also its
   result; `Target()` here is the target and its empty parameter clause, not
   a function signature type. `implicit` is contextual: it is a modifier only
   first in a conversion operator, before `virtual` or `constexpr`, and admits
   the conversion in declaration initialization. *)
conversion-operator-declaration
                       = [ "implicit" ] [ "virtual" | "constexpr" ] "operator"
                         conversion-target parameter-clause
                         [ call-receiver-qualifier ] [ requires-clause ]
                         [ "override" ] method-terminator ;

conversion-target      = ( raw-pointer-base | base-type ) { array-extent }
                         [ "&" ] ;

method-terminator      = block | ";" | pure-specifier ;

pure-specifier         = "=" INT_LITERAL ";" ;

call-operator          = "(" ")" ;

call-receiver-qualifier
                       = "mut" | "&&" ;

non-call-overloadable-operator
                       = "*" | "->" | "++" | "--" | "="
                       | "+" | "-" | "/" | "%"
                       | "+=" | "-=" | "*=" | "/=" | "%="
                       | "~" | "&" | "|" | "^" | "<<" | ">>"
                       | "&=" | "|=" | "^=" | "<<=" | ">>="
                       | "[" "]"
                       | "==" | "!=" | "<" | "<=" | ">" | ">=" ;

function-declaration   = [ unsafe-function-modifier ] [ "static" ]
                         [ "constexpr" ] [ "mut" ] type IDENTIFIER
                         [ generic-parameter-clause ]
                         parameter-clause [ requires-clause ]
                         ( block | ";" ) ;

macro-declaration      = "#macro" [ type ] IDENTIFIER [ generic-parameter-clause ]
                         parameter-clause [ requires-clause ] block ;
(* A namespace-scope typed macro has an implicit void or explicit typed result and
   ordinary name(args) invocation syntax. Its value expression parameters are
   checked by exact type and expanded at each use, not eagerly initialized.
   Generic final packs, defaults and constraints retain the ordinary signature
   rules. track_caller may precede #macro; macro/function overload mixtures
   at one qualified name are invalid. The current body profile admits blocks,
   ordinary branches, automatic locals, local writes/loops and macro-local
   returns. Fresh caller lambda arguments retain their ordinary callable
   identity and capture rules. Reference/tracked-borrowed results, introduced
   propagation, body lambda definitions, member, constexpr and foreign forms
   are not admitted. [[deferred]] is no
   longer accepted; #define remains valueless configuration, not replacement
   macro syntax. See execution.md's typed statement macro contract. *)

requires-clause        = "requires" constraint-expression ;

out-of-class-method-definition
                       = [ unsafe-function-modifier ] [ "constexpr" ]
                         [ "mut" ] type qualified-name "::" IDENTIFIER
                         parameter-clause [ "mut" | "&&" ] block ;
(* An existing ordinary method of a non-generic class/struct, or a static
   interface method, must match exactly. No new member is introduced. Access,
   static/virtual/override, attributes and defaults stay on its declaration.
   Generic methods/owners, constructors, destructors and operators remain
   inline in this slice. *)

(* A leading `mut` on a function declaration requires a reference return.
   A free/static borrowed return is accepted when every reachable return
   derives either from one eligible read-only parameter (read-only result only)
   or from one exact namespace-global/non-generic-static place. The latter may
   be writable in the single-threaded profile and retains its exact projection
   path for caller-side conflict checking. *)

generic-parameter-clause
                       = "<" generic-parameter
                         { "," generic-parameter } ">" ;

generic-parameter      = [ generic-constraint ] IDENTIFIER [ "..." ]
                         [ "=" type ]
                       | ( "uint64_t" | "uint64" ) IDENTIFIER
                         [ "=" generic-value-expression ] ;

generic-value-expression
                       = generic-value-additive ;

generic-value-additive = generic-value-multiplicative
                         { ( "+" | "-" ) generic-value-multiplicative } ;

generic-value-multiplicative
                       = generic-value-primary
                         { ( "*" | "/" | "%" ) generic-value-primary } ;

generic-value-primary  = INT_LITERAL | IDENTIFIER
                       | "(" generic-value-expression ")" ;

generic-constraint     = qualified-name ;

parameter-clause       = "(" [ parameter-list ] ")" ;

parameter-list         = parameter { "," parameter } ;

parameter              = [ "mut" ] type [ "..." ] [ IDENTIFIER ]
                         { array-extent }
                         [ "=" assignment-expression ] ;

(* Default arguments form one trailing parameter suffix. They are admitted on
   ordinary free functions, non-polymorphic ordinary/static methods, and
   ordinary constructors. Operators, lambdas, payload-enum fields, packs,
   runtime/intrinsic and extern-C declarations, virtual/interface surfaces,
   and the main entry point do not admit them. A default expression is resolved
   in its declaration scope and cannot name an ordinary callable parameter,
   `this`, or an instance member. Reference, raw-pointer, C-string, and
   borrowed-state parameters stay explicit; defaulted parameters are owned or
   plain values. *)

(* A constructor name must match its owning class or struct. Constructor calls
   use `Type(arguments)` and are never implicit conversions. Constructors form
   overload sets by exact parameter types; parameter names and by-value `mut`
   do not distinguish signatures. A constructor initializer names either the
   one state-bearing base or an immediate field. The base initializer comes
   first and uses exact constructor matching; field initializers then appear in
   field declaration order. Omitted bases require an accessible constructor
   callable with zero explicit arguments. A field initializer supplies a
   default when a constructor omits that field. All initialization runs before
   a body that cannot return.
   When no declared constructor is callable with zero explicit arguments, the
   compiler generates `Type()` if every field has a declaration initializer
   or is a nominal field with an accessible exact default construction,
   even when other constructor overloads exist.

   The exact declaration `Type() = default;` explicitly selects that same
   structural operation. It has no parameters, generic parameters, requires
   clause, initializer list, or source body and is valid only when the
   compiler-generated operation would be available. Its written access still
   governs source construction. `= delete` is not an ordinary-constructor
   policy in the current language.

   Copy/move construction and assignment are derived independently from
   lifecycle traits rather than C++ special-member suppression. A class or
   struct may make its copy and move construction policy explicit with one
   public `Type(Type&) = default|delete;` and one public
   `Type(Type&&) = default|delete;` declaration. `T&&` is confined to that move
   policy and is not a general reference or forwarding-reference type.
   Defaulting cannot make a structurally unavailable operation available.
   Custom copy and move bodies are unsupported. Movement remains a
   compiler-controlled ownership transfer; explicit clone methods express
   user-defined duplication. Copy/move assignment remains an independently
   derived operation.

   A class or struct may declare one public destructor, either a `~Type()` body
   or `~Type() = default;`. A defaulted destructor selects structural
   reverse-order field and base destruction and does not create a source
   cleanup body or active-drop state. A body is automatically invoked, has an
   implicitly mutable receiver, cannot return or take parameters, and runs
   before reverse-order field destruction. Cleanup-owning values are
   noncopyable; compiler-generated moves transfer an active-drop state so the
   source cleanup body runs exactly once. `= delete` is not available for
   destructors, and manual destructor calls are not syntax. Field immutability
   remains a GTI semantic rule and is not delegated to the C++ representation.

   Methods have read-only receivers by default. A trailing `mut` permits writes
   to mutable fields and requires a mutable object at the call site. The exact
   trailing `&&` receiver qualifier consumes an owned temporary or explicitly
   moved receiver. It is available on ordinary instance methods, `operator()`,
   and value-producing arithmetic/bitwise operators, not on free/static
   functions or as a general rvalue-reference type. A leading `mut` is valid only for a reference return from
   a mutable method. It makes the returned receiver-derived place writable.
   Inside a method or destructor, `this` names the current non-null object and
   uses ordinary `.` member access; it is not a source-level raw pointer. `self`
   remains an IDENTIFIER. *)

(* A class or struct method becomes a virtual root with `virtual`; a pure root
   ends with the exact spelling `= 0;`. Interface signatures instead end with
   `;` and are implicitly virtual and pure. An implementation of an inherited
   virtual signature must use `override`. Parameter types, receiver mutability,
   operator identity, and return type must match exactly; covariant returns and
   method-level generics are not part of virtual dispatch. An override may
   satisfy identical contracts inherited from multiple interfaces.

   A type with an unimplemented pure contract is abstract and cannot be
   constructed by value. Derived-to-base conversion is available only when an
   explicit base reference is initialized or returned; ordinary calls retain
   exact argument matching and objects never slice into base values. Every
   polymorphic type has compiler-generated virtual destruction even though GTI
   exposes no destructor qualifier. *)

(* A static method has no receiver, cannot use `this`, cannot have a trailing
   `mut` qualifier, and cannot overload an instance method with the same name.
   Static operator overloads are invalid. Static data members are owned by the
   class or struct rather than an object, require an in-class initializer, and
   are accessed as `Type::member`; object access is rejected. The current
   qualified-expression grammar does not support static members on generic
   classes or structs, except the exact collection-protocol hooks selected with
   their concrete owner by that protocol. A static method may return a reference from one exact
   global/static place under the reference rules below. Static members do not
   participate in object layout, construction, generated special members, or
   destruction. *)

(* Operator overloads are class or struct members and cannot have method type
   parameters or runtime bindings. `operator*` with no parameters is checked
   dereference and `operator->` takes no parameters; both return checked
   references. Unary `operator+`, `operator-`, and `operator~` take no
   parameters. Binary `operator+`, `operator-`, `operator*`, `operator/`,
   `operator%`, `operator&`, `operator|`, `operator^`, `operator<<`, and
   `operator>>` take one exact-match parameter. These value-producing
   operators use a read-only or trailing-`&&` consuming receiver and return an
   owned non-void value, not a reference or receiver-tied borrowed state.

   `operator=`, `operator[]`, the compound operators `+=`, `-=`, `*=`, `/=`,
   `%=`, `&=`, `|=`, `^=`, `<<=`, and `>>=`, and comparisons `==`, `!=`, `<`,
   `<=`, `>`, and `>=` take one exact-match parameter. Compound operators
   return void and use a mutable receiver with trailing `mut`; GTI never
   synthesizes one from a related value operator. `operator=` also requires a
   mutable receiver. Prefix `operator++` and `operator--` take no parameters,
   return void, and require a mutable receiver; postfix overloading is not
   provided.
   `operator()` takes any number of exact-match parameters and may return any
   otherwise-valid function return type. In addition to the
   ordinary read-only and trailing-`mut` forms, it may use trailing `&&` to
   declare a consuming once-callable receiver. That form is invoked from an
   owned movable temporary or an explicitly moved named local, by-value
   parameter, supported writable field, or constant-index fixed-array element.
   A consuming form cannot return a reference or tracked borrowed state.
   Consuming methods and call operators may be virtual, pure, overriding, or
   interface requirements; overrides preserve the exact receiver qualifier.
   Comparisons and contextual `operator bool` return bool and use a read-only
   receiver.
   `operator->`
   performs one checked reference step; recursive proxy lookup is not provided.
   The member after `->` is looked up on the referenced type, which need not
   be a class (a `std::string_view&` result supplies the view's members).
   `operator bool` participates implicitly only in conditions, logical
   `and`/`or` (`&&`/`||`), and `!`. A conversion operator `operator T()` takes
   no parameters and uses a read-only, `mut`, or `&&` receiver; `T(value)`
   calls it explicitly, and an `implicit` one also converts a declaration's
   initializer (static-semantics.md, section 3.9.2). Operator operands are
   evaluated left to right. No free operators, implicit argument conversions,
   argument-dependent lookup, reversed-operand search, conversion ranking, or
   synthesized related candidates are provided.
   Read-only, mutable, and consuming `operator()` overloads may coexist when
   their exact signatures and receiver qualifiers distinguish them. Other
   value-producing operators may pair read-only and consuming forms. *)

(* Functions and methods may share a name when their normalized parameter type
   lists differ. Return types, parameter names, and by-value parameter
   mutability do not distinguish overloads. An ordinary method may pair
   read-only, trailing-`mut`, and trailing-`&&` overloads with the same parameter
   types. A read-only receiver can select only the read-only member; a mutable receiver
   prefers the mutable member when both match. An owned temporary or explicit
   `std::move(value)` receiver prefers an otherwise exact consuming overload;
   invoking that overload consumes the source under ordinary path-sensitive
   move-state rules. Calls require one unique exact
   parameter match after generic substitution, apart from the bounded raw-
   pointer `nullptr` and added-pointee-`const` compatibility. GTI performs no
   other implicit argument conversions and has no general conversion-ranking
   or best-match rules. A declaration with trailing defaults is viable when the
   supplied argument count is between its required and total parameter counts;
   only supplied arguments participate in exact matching. Defaults do not
   distinguish overload identities or rank otherwise-exact candidates, so two
   viable exact candidates remain ambiguous. Runtime bindings and the main
   entry point are not overloadable.

   Every reachable path through a non-void function, method, operator, or
   lambda must return a value. Active target-condition branches participate in
   this check. A loop prevents fallthrough only when it is proven not to exit.
   The top-level main entry point retains C++'s defined implicit return of
   zero. It is a definition with signature `int main()` or
   `int main(int, std::vector<std::string>)`. Parameter names and ordinary
   by-value `mut` qualifiers do not affect that identity, and aliases may name
   the exact types. The owned argument form requires the canonical imported
   standard-library string and vector identities. No native `char**` or other
   pointer-shaped main signature is provided. *)

variable-declaration   = [ "constexpr" ] [ "mut" ] type IDENTIFIER
                         { array-extent }
                         [ "=" initializer-expression
                         | direct-initializer ] ";" ;

structured-binding-declaration
                       = "auto" "[" IDENTIFIER
                         { "," IDENTIFIER } "]"
                         "=" initializer-expression ";" ;

static-variable-declaration
                       = "static" [ "constexpr" ] [ "mut" ] type IDENTIFIER
                         { array-extent }
                         [ "=" initializer-expression
                         | direct-initializer ] ";" ;

(* At namespace scope, `static` gives a variable or function source-unit
   internal linkage: it is visible only inside the file that declares it and
   may reuse a name used by another source unit. `main` cannot be static.
   Block-scope static declarations are intentionally not supported. *)

(* `constexpr` bindings are immutable and initialized; class and struct fields
   must also be static. The compiler-owned evaluator supports fixed-width
   integers, IEEE-754 binary32 float, IEEE-754 binary64 double, bool, char,
   string_view, nullptr_t, exact scoped enums, concrete fixed arrays,
   structural class/struct values, checked integer operations,
   binary32/binary64 arithmetic and comparisons, read-only aggregate
   observation, and explicit numeric conversions. Bounded constexpr free
   functions, methods, and ordinary constructors admit concrete non-pack
   generic instances, automatic supported values, structured control flow,
   recursion, and calls to available constexpr definitions. Evaluation has one
   4096-step budget and a 64-call-depth limit.

   `if constexpr` requires a computed bool and analyzes and lowers only its
   selected branch. Completed function closures execute supported fixed-array
   operations, passive aggregate mutation, read-only references and read-only
   operators through verified MIR. Generic packs, polymorphism, mutable
   reference/receiver execution, allocation, payload enums, unions, inherited
   or cleanup-owning aggregates, and unsupported runtime/intrinsic/C calls
   remain outside the constant-execution profiles. Native C++ constant evaluation
   is never the GTI semantic authority. *)

direct-initializer     = "{" [ assignment-expression
                         { "," assignment-expression } [ "," ] ] "}"
                       | designated-initializer ;

designated-initializer = "{" designated-initializer-entry
                         { "," designated-initializer-entry } [ "," ] "}" ;

designated-initializer-entry
                       = "." IDENTIFIER "=" brace-initializer-element ;

type                   = ( raw-pointer-base | base-type )
                         { array-extent } [ "&" ]
                         [ "(" [ signature-parameter
                         { "," signature-parameter } ] ")"
                         [ signature-receiver ] ] ;

signature-parameter    = [ "mut" ] type [ "..." ] ;
(* A signature parameter's explicit mut prefix requires a reference type. *)

function-signature     = ( raw-pointer-base | base-type )
                         { array-extent } [ "&" ]
                         "(" [ signature-parameter
                         { "," signature-parameter } ] ")"
                         [ signature-receiver ] ;

signature-receiver     = "mut" | "&&" ;

(* The final parenthesized suffix forms a GTI function-signature type. It is
   type metadata usable in aliases/generic arguments, not an object or a native
   callback pointer. It has no implicit function/array parameter decay. *)

raw-pointer-base       = [ "const" ] base-type "*" { [ "const" ] "*" } ;

base-type              = primitive-type
                       | user-type
                       | expected-type
                       | native-function-type
                       | "auto"
                       | "nullptr_t"
                       | "void" ;

(* `auto` is accepted only on an initialized local variable declaration,
   including either form of for-loop binding. It infers the initializer's
   complete type without implicit conversion and is immutable unless preceded
   by `mut`. The `auto&` and `mut auto&` reference forms infer checked references
   in initialized ordinary locals and range-for element declarations, using
   the same referent and lifetime rules as explicit references. They do not
   extend temporary lifetimes or introduce reference-to-reference types.
   `auto&&` is not supported. Inference is not valid for globals, fields,
   parameters, return types, or array declarators. Plain `auto` never silently
   infers a reference. A braced initializer does not provide a type by itself.
   Inferred values retain their ownership traits, so move-only lvalues still
   require an explicit `std::move`. A lambda initializer also requires an
   immutable binding. *)

(* Raw pointers are recursive, nullable and non-owning.
   `const` is valid here only when followed by `*` and makes the pointee
   read-only. Leading declaration `mut` controls whether the pointer binding
   may be reseated; it does not change pointee access. `T* const*` points to a
   read-only pointer slot, unlike `const T**`, whose final object is read-only.
   Locals, parameters, fields, aliases, generic arguments and unannotated
   returns use the same type family. A checked reference may name a pointer
   slot (`T*&`, `mut const T*&`) except one with native layout: a fixed
   pointer-array element or a native record or union field. Anonymous
   function-pointer declarators, pointer-to-array types and implicit array
   decay remain rejected. Fixed arrays may contain nested pointer values.
   Raw-pointer variables and fields declared with a pointer type require an
   explicit initializer, normally `nullptr`.

   Carrying, copying, assigning, passing, returning, null comparison, compatible
   equality, adding outer qualification and address formation are safe.
   Dereference, indexing, arrow access, pointer arithmetic, and a
   pointer-bearing C call require a lexical `unsafe` block. Raw pointers own no
   storage and create no semantic loan. See `raw-pointers.md`. *)

(* A structured binding is one immutable local declaration. Its initializer
   is evaluated once into a hidden owned value, and each visible name denotes
   a read-only projection of that value. The first layer accepts exact-arity
   fixed arrays and flat class/struct values whose direct instance fields are
   all public. It rejects `mut auto`, `auto&`, nested patterns, inherited
   fields, stored references, untyped braced initializers, and partial moves
   of an individual name. Structured bindings are not valid at namespace or
   class scope or in a for-loop initializer. *)

(* Positional direct initialization is confined to class and struct
   declarations. The declared type supplies one exact construction target,
   without C++ list preference, implicit conversion or CTAD. Empty braces select
   zero-argument construction. Parenthesized block-scope declarations remain
   invalid so `Type name(arguments)` cannot acquire declaration ambiguity.

   A typed struct destination additionally supplies context for designated
   construction (`Point p{.x = 1}` or `Point p = {.x = 1}`). Designators are
   unique public instance fields in declaration order; missing fields need
   declaration defaults, and positional/designated entries cannot mix. The
   admitted struct has no declared constructor, base or unsupported borrowed,
   array or native-layout field. Nested entries receive their field's exact
   type. This is not an untyped general expression.

   A class-typed `C values = {elements}` may instead use the source-defined
   `collection_init`/`collection_insert` protocol, including nested designated
   elements. Fixed-array destinations retain their array initialization rules.
   See static-semantics.md for exact hook and ownership constraints. *)

array-extent           = "[" array-extent-expression "]" ;

array-extent-expression
                       = array-extent-additive-expression ;

array-extent-additive-expression
                       = array-extent-multiplicative-expression
                         { ( "+" | "-" )
                           array-extent-multiplicative-expression } ;

array-extent-multiplicative-expression
                       = array-extent-primary-expression
                         { ( "*" | "/" | "%" )
                           array-extent-primary-expression } ;

array-extent-primary-expression
                       = INT_LITERAL | IDENTIFIER
                       | "(" array-extent-expression ")" ;

initializer-expression
                       = expression | array-initializer | designated-initializer ;

brace-initializer-element
                       = assignment-expression | array-initializer
                       | designated-initializer ;

array-initializer      = "{" [ brace-initializer-element
                         { "," brace-initializer-element } [ "," ] ] "}" ;

(* C++ declarator spelling is canonical for declarations: `int values[4]`.
   Array suffixes may remain attached to a type where no declarator exists,
   such as a generic type argument or array return type. Every extent is either
   a checked arithmetic expression over integer literals and earlier
   non-negative integer constexpr bindings, or one in-scope uint64_t value
   parameter, and is part of the exact type. Concrete arithmetic supports `+`,
   `-`, `*`, `/`, `%`, and parentheses; overflow, negative results, and zero
   divisors are semantic errors. A value parameter must be the complete extent
   until symbolic compile-time expressions are represented in type identity.
   Variable-length arrays are not supported.

   Fixed arrays are inline contiguous values with no pointer decay. An array
   of recursive raw-pointer elements is still an array and does not expose the
   array's address. A non-empty
   initializer must provide exactly one value per element; `{}` value-initializes
   every element and requires a default-initializable element type. Elements
   initialize in increasing index order and destroy in decreasing index order;
   nested initializer temporaries remain in the declaration's full-expression.
   Array copy, move, assignment, and destruction follow the element type.
   Bindings remain immutable unless declared `mut`.

   Indexing accepts integer expressions. Constant out-of-range indexes are
   semantic errors and invalid dynamic indexes terminate with a stable runtime
   diagnostic. `array.size()` returns the compile-time extent as
   `std::size_t` (canonically `uint64_t`) without storing a runtime length. Fixed
   arrays do not expose `.data()`. *)

expected-type          = "expected" "<" type "," type ">" ;

(* `void` is accepted syntactically as a type and restricted semantically to
   function return types, raw-pointer terminal pointees, generic/signature
   metadata and the value position of `expected<void, E>`. It has no object
   storage, reference referent or value parameter. The error type E cannot be
   void. `void*` is opaque:
   it may be carried, compared, passed, and returned, but not dereferenced,
   indexed, used for member access, or used in pointer arithmetic. GTI does not
   implicitly convert between a typed pointer and `void*`.

   `T&` is a non-null read-only borrow and `mut T&` is a writable borrow.
   References may be parameters and local bindings and must bind an addressable
   place. A method may return `T&` only when every returned value is derived
   from `this`; the resulting borrow is tied to the receiver and cannot be
   retained from a temporary receiver. A free function or static method may
   return a read-only reference derived from one eligible `T&` parameter, or a
   read-only/writable reference derived from one exact global/static place in
   the single-threaded profile. Temporary global call borrows end at the full
   expression; retained writable aliases conflict until their lexical scope
   ends. A move-only owner with a retained borrow cannot be moved, replaced, or
   passed to a mutable method until the loan ends. Nominal multi-origin and
   nested carrier fields use the stored-reference contract above; they are not
   general nested-reference types. Reference globals, whole fixed-array
   references and references to native-layout pointer slots remain
   unsupported.

   Public sparse storage uses ordinary class, generic, call and unsafe-block
   syntax over the general typed object-lifetime operations. The former private
   sparse-storage type and operation family have no compiler syntax or identity.

   Initialized-prefix storage is also ordinary GTI policy over region leases,
   general construction/destruction/relocation, and checked borrowing. The
   private `prefix_storage` type and operation family are retired. Sparse and
   prefix policies differ in their live-slot model, not compiler syntax or
   public-library name recognition.
*)

primitive-type         = integer-type | "float" | "double" | "bool" | "char" ;

integer-type           = signed-integer-type | unsigned-integer-type ;

signed-integer-type    = "int" | "int8_t" | "int16_t" | "int32_t"
                       | "int64_t"
                       | "int8" | "int16" | "int32" | "int64" ;

unsigned-integer-type  = "uint" | "uint8_t" | "uint16_t" | "uint32_t"
                       | "uint64_t"
                       | "uint8" | "uint16" | "uint32" | "uint64" ;

(* `char` is one exact unsigned 8-bit character code unit and remains distinct
   from `uint8_t`. It supports initialization, assignment, and equality with
   another `char`; it does not participate in arithmetic or integer
   constraints. Explicit `uint8_t(character)` extraction and `char(uint8_t)`
   construction preserve the same eight code-unit bits and cannot fail. Neither
   is implicit, makes `char` numeric or performs Unicode conversion. A
   CHARACTER_LITERAL must decode to exactly one code unit and supports `\\`,
   `\'`, `\"`, `\n`, `\r`, `\t`, and `\0` escapes.

   A STRING_LITERAL has type `std::string_view`. It is an immutable counted
   view over static literal storage, so embedded zero bytes are preserved and
   copying the view does not allocate. A view provides `size()`, `empty()`, and
   checked read-only integer indexing that returns `char` by value. A constant
   out-of-range literal index is a semantic error; a dynamic out-of-range index
   terminates with a stable runtime diagnostic.

   The former unqualified `string` keyword is removed. `std::string` is an
   ordinary source-defined standard-library class imported with
   `#include <std/string>`. It owns `char` storage, is move-only to prevent
   implicit allocating copies, and provides explicit `clone()` when duplication
   is intended. `string.view()` returns a dynamic `std::string_view` whose
   single read-only owner dependency is tracked through local copies and exact
   factory/relay calls. The owner cannot be moved, destroyed, or invalidated
   while that view is live. Dynamic views cannot escape a local owner or be
   assigned/reseated, nested in fields, arrays, or dynamic storage, or combine
   multiple owners. Literal views remain ownerless static-storage values. *)

(* The `_t` fixed-width spellings are canonical. Their suffix-less forms are
   exact compatibility aliases and the formatter rewrites them to `_t`.
   Both spelling families are lexer-owned primitive types; neither requires a
   source include or a `std::` qualifier.
   `int` is an exact alias for `int32_t`; `uint` is an exact alias for
   `uint32_t`. Integer literals use int32_t, int64_t, or uint64_t according to
   their value, and may initialize any integer type when they are in range.
   Variable conversions may widen only when every source value fits the
   destination. As in C++, arithmetic promotes all 8- and 16-bit integers to
   int32_t. Mixed
   signed/unsigned operands use GTI's exact common-type rules and reject
   combinations that could reinterpret a negative value as unsigned. Native
   conversions do not define those rules.

   `%`, `~`, `&`, `^`, `|`, `<<`, and `>>` accept integers only. Modulo and
   binary bitwise operators use the arithmetic promotion and safe common-type
   rules above. A shift returns the promoted left operand type. Shift counts
   must be nonnegative and smaller than that type's width. Invalid dynamic
   divisors and shift counts terminate with a GTI runtime error. Signed
   minimum modulo -1 is 0, left shift wraps by bit pattern, and signed right
   shift is arithmetic.

   Signed and unsigned `+`, `-`, and `*` terminate on overflow. Integer `/`
   terminates on zero or signed minimum divided by -1. Unary negation and
   increment/decrement use the same checked arithmetic. Compound assignment
   evaluates its target place once, applies the corresponding checked rule,
   then checks conversion back to the target type. An integer target requires
   an integer right operand. *)

user-type              = qualified-name [ generic-argument-clause ]
                         { "::" IDENTIFIER [ generic-argument-clause ] } ;
(* Specializations may qualify direct public type aliases. Alias members are
   not alias templates; arguments on those members receive a semantic error. *)

generic-argument-clause
                       = "<" [ generic-argument
                         { "," generic-argument } ] ">" ;

generic-argument       = type [ "..." ] | generic-value-expression ;

qualified-name         = IDENTIFIER { "::" IDENTIFIER } ;

block                  = "{" { block-item } "}" ;

block-item             = conditional-block-items
                       | configuration-directive
                       | compile-error-directive
                       | static-assert-declaration
                       | structured-binding-declaration
                       | variable-declaration
                       | statement ;

conditional-block-items
                       = conditional-start { block-item }
                         { "#elif" compile-condition { block-item } }
                         [ "#else" { block-item } ] "#endif" ;

statement              = block
                       | unsafe-statement
                       | if-statement
                       | do-while-statement
                       | while-statement
                       | for-statement
                       | range-for-statement
                       | constexpr-for-statement
                       | switch-statement
                       | loop-control-statement
                       | return-statement
                       | discarded-expression-statement
                       | expression-statement ;

unsafe-statement       = "unsafe" block ;

(* `unsafe` grants permission for the raw-pointer operations enumerated by the
   type contract only within its ordinary lexical block. Blocks may nest. A
   lambda body starts a new safety context and therefore requires its own
   `unsafe` block. Unsafe code remains subject to all ordinary type, access,
   initialization, ownership, and control-flow checks. The programmer must
   prove pointer validity, lifetime, alignment, type, initialization, bounds,
   provenance, writable access, and native-call requirements as applicable;
   violating one of those obligations is undefined behavior. *)

if-statement           = "if" [ "constexpr" ] "(" expression ")" statement
                         [ "else" statement ] ;

while-statement        = "while" "(" expression ")" statement ;

do-while-statement     = "do" statement "while" "(" expression ")" ";" ;

(* A do-while body executes at least once. `continue` evaluates the condition
   before the next iteration, while `break` exits directly. The condition uses
   the same exact contextual-bool rule and lexical cleanup guarantees as other
   loops. *)

for-statement          = "for" "(" for-init [ expression ] ";" [ expression ] ")"
                         statement ;

for-init               = variable-declaration | expression-statement ;

range-for-statement    = "for" "(" range-for-declaration ":" expression ")"
                         statement ;

range-for-declaration  = [ "mut" ] type IDENTIFIER { array-extent } ;

constexpr-for-statement = "constexpr" "for" "(" [ "mut" ] type IDENTIFIER ":"
                          expression ")" statement ;

(* Compile-time iteration. The expression is a value whose class type has
   exactly one type pack as its generic arguments; the body is analysed once
   per pack element with the binding initialized to a default-constructed
   element, each copy in its own scope and in order. A sequence type that
   depends on an open generic parameter defers the expansion to each concrete
   instance, like a dependent `if constexpr`. No runtime loop exists. *)

(* Range-based for uses an ordinary structural protocol rather than a
   compiler-known stdlib type. An addressable range is borrowed; an admitted
   owned temporary is transferred into hidden loop storage. A nominal read
   range provides exact zero-argument `begin()` and `end()` members; mutable
   traversal selects `begin_mut()` under its exclusive owner loan. `begin()`
   returns an iterator value; `end()` may return a distinct sentinel value. The
   iterator provides an exact `operator!=(Sentinel&)` with one read-only
   sentinel reference parameter, plus `operator*()` and mutable prefix
   `operator++()` operations. The dereference operator returns a checked
   reference; a by-value loop binding copies that element, while `T&`/`auto&`
   and their leading-`mut` forms bind with the declared access. The compiler
   resolves every operation in semantics and lowers it through HIR/MIR; it does
   not invoke C++ range lookup or recognize `std::vector`/`std::array` names.
   `continue` executes the selected increment operation before the next test.
   Fixed arrays use a separate exact indexed strategy, not invented member
   calls. Ordinary nominal iterators retain checked owner dependencies under
   the same stored-reference rules as user-defined views. Shared copies retain
   independent positions; exclusive carriers move their loans and are
   noncopyable. Range lowering additionally retains traversal and per-element
   child loans, ending the element before increment or every exit. General
   proxy iterators and paired mutable subranges need separate contracts. *)

switch-statement       = "switch" "(" expression ")"
                         "{" { switch-item } "}" ;

switch-item            = switch-label | block-item ;

switch-label           = "case" ( logical-or-expression | payload-borrow-pattern ) ":" | "default" ":" ;
payload-borrow-pattern = qualified-name "(" payload-pattern-binding
                         { "," payload-pattern-binding } ")" ;
payload-pattern-binding = IDENTIFIER | [ "mut" ] "auto" "&" IDENTIFIER ;

(* Switch subjects are concrete integer, char, or scoped-enum values. Case
   labels must be compile-time literals, explicitly converted integer
   literals, or enumerators whose type exactly matches the subject; labels do
   not perform implicit conversions. Duplicate values and duplicate default
   labels are invalid. Adjacent labels form one arm. Every executable arm must
   terminate on every path with an explicit break, return, or a valid continue
   inside an enclosing loop, so GTI has no implicit fallthrough. Each arm is a
   lexical scope even without source braces. A payload-enum label is either a
   unit alternative or `EnumName::case(bindings...)`. Bindings are immutable
   values local to that arm. Over a named subject they are copies and
   require a copyable field; over a consumed subject (a prvalue or an
   explicit `std::move`) they take their fields by move.
   `auto& name` is a shared payload borrow, and `mut auto& name` is an
   exclusive borrow requiring mutable stable enum storage, so neither applies
   to a consumed subject;
   omitting the binding produces a tag-only pattern that can observe a
   move-only alternative. Without `default`, every payload variant must appear
   exactly once. *)

loop-control-statement = ( "break" | "continue" ) ";" ;

(* `break` exits the nearest enclosing loop or switch. `continue` advances the
   nearest enclosing loop to its next iteration and remains invalid in a
   switch that is not itself inside a loop. *)

return-statement       = "return" [ initializer-expression ] ";" ;

discarded-expression-statement
                       = "[[" "discard" "]]" expression ";" ;

(* A discarded-expression statement must contain a call to a function with a
   non-void return type. Non-void function results are otherwise required to be
   used by the surrounding expression, stored, passed, or returned, unless the
   selected declaration explicitly permits omission with `[[discardable]]`.
*)

expression-statement   = [ expression ] ";" ;

(* Expression precedence follows C++ for the currently tokenized operators.
   Precedence does not import C++ evaluation order: GTI evaluates operands,
   call arguments, and initializer constituents strictly left to right under
   Execution Section 4.2. Assignment targets are checked semantically,
   evaluated first and once; syntactically the left side is parsed as a
   logical-or expression. The comma operator sequences its operands but does
   not end the enclosing full-expression.
*)

expression             = comma-expression ;

comma-expression       = assignment-expression { "," assignment-expression } ;

assignment-expression  = conditional-expression
                         [ assignment-operator initializer-expression ] ;

(* Semantic analysis requires a mutable place on the left, including a
   mutable-reference call result or a parenthesized mutable place. An owned
   value result and a read-only reference are not assignment targets. *)

assignment-operator    = "=" | "+=" | "-=" | "*=" | "/=" | "%="
                       | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

conditional-expression = logical-or-expression
                         [ "?" expression ":" assignment-expression ] ;

(* Conditional expressions evaluate the condition first and exactly one arm.
   The condition uses GTI's exact contextual-bool rule. Both arms must have the
   same exact type, and the result is always a value: place arms copy, while a
   move-only place requires explicit `std::move`. Result types containing
   borrowed state remain invalid until MIR can merge branch-selected loans.
*)

logical-or-expression  = logical-and-expression
                         { ( "or" | "||" ) logical-and-expression } ;

logical-and-expression = bitwise-or-expression
                         { ( "and" | "&&" ) bitwise-or-expression } ;

bitwise-or-expression  = bitwise-xor-expression
                         { "|" bitwise-xor-expression } ;

bitwise-xor-expression = bitwise-and-expression
                         { "^" bitwise-and-expression } ;

bitwise-and-expression = equality-expression
                         { "&" equality-expression } ;

equality-expression    = relational-expression
                         { ( "==" | "!=" ) relational-expression } ;

relational-expression  = shift-expression
                         { ( "<" | "<=" | ">" | ">=" ) shift-expression } ;

shift-expression       = additive-expression
                         { ( "<<" | ">>" ) additive-expression } ;

additive-expression    = multiplicative-expression
                         { ( "+" | "-" ) multiplicative-expression } ;

multiplicative-expression
                       = unary-expression
                         { ( "*" | "/" | "%" ) unary-expression } ;

unary-expression       = ( "!" | "+" | "-" | "*" | "&" | "~" | "++" | "--" | "?" )
                         unary-expression
                       | postfix-expression ;

postfix-expression     = primary-expression { postfix-suffix } ;

postfix-suffix         = call-suffix | member-suffix | index-suffix
                       | increment-suffix ;

call-suffix            = [ generic-argument-clause ]
                         "(" [ argument-list ] ")" ;

argument-list          = call-argument { "," call-argument }
                       | { call-argument "," } pack-expansion ;

call-argument          = brace-initializer-element ;

pack-expansion         = IDENTIFIER "..." ;

(* A call evaluates its callable/receiver once, then evaluates written
   arguments from left to right. Any omitted trailing default expressions are
   evaluated next in parameter order, once for that call. Parameters are
   initialized from those values from left to right. A concrete final pack
   contributes elements at its written position in pack order. Invocation
   begins only after every parameter is live. Defaults belong to the call's
   enclosing full-expression and are lowered at the caller; a backend cannot
   delegate their evaluation to native default-argument syntax.

   A brace argument is not a general expression or `std::initializer_list`.
   It requires one selected exact by-value fixed-array parameter `T[N]` and
   initializes that owned value under the element type and extent supplied by
   the parameter. It does not infer a common element type, prefer a list
   overload, perform CTAD, or add implicit conversions. Empty braces
   value-initialize the selected fixed array. Contextual braces are currently
   available for named function/method calls and constructors, not generic
   `operator()` dispatch. *)

(* Generic declarations introduce named type parameters. A type parameter may
   have one namespace-resolved unary, non-structural concept before its name,
   such as
   `T minimum<std::totally_ordered T>(T left, T right)`. The numeric constraints
   are `std::numeric`, `std::signed_numeric`, `std::integral`,
   `std::signed_integral`, `std::unsigned_integral`, and
   `std::floating_point`. Lifecycle constraints are `std::copyable`,
   `std::movable`, and `std::default_initializable`; comparison constraints are
   `std::equality_comparable` and `std::totally_ordered`. `std::ordered` remains
   a compatibility spelling for total ordering. These public concepts are
   declared by the implicit standard prelude and are available without an
   explicit include. User source may compose them with `concept` declarations.

   Numeric constraints classify integer and floating primitive subsets.
   Lifecycle constraints inspect GTI construction and assignment availability.
   A nominal class satisfies `std::equality_comparable` only when it has exact public,
   read-only bool `operator==` and `operator!=` members taking one read-only
   reference to its own concrete type. `std::totally_ordered` additionally
   requires `operator<`, `operator<=`, `operator>`, and `operator>=` with the
   same shape. No operator is synthesized and no implicit conversion satisfies
   a capability. A constrained type parameter may use its guaranteed operators
   while its generic body is checked. `T(value)` is a checked numeric conversion
   when T satisfies `std::numeric` or a stronger numeric constraint; `T()` is
   valid when T satisfies `std::default_initializable`.

   Every explicit or inferred concrete argument must satisfy its parameter's
   constraint, and every element bound to a constrained pack is checked.
   Passing one symbolic type parameter to another requires the source's
   resolved capability set to contain the destination set. Relationships such
   as signed integral implying integral and numeric are expressed by source
   concept composition in the prelude, not by a compiler-owned implication
   graph.

   A trailing requires clause is a bounded Boolean expression of concept
   applications whose arguments are visible non-pack generic type parameters
   or closed exact types containing no unresolved type/value parameter. It can
   express exact multi-type relationships, such as
   `std::sentinel_for<Sentinel, Iterator>`,
   and its facts are active while the symbolic body is checked. Concrete
   instantiation substitutes and validates every application again. The current
   structural concepts prove only their compiler-defined exact operator shapes:
   read-only input iterator dereference plus mutable prefix increment,
   iterator/sentinel inequality, and exact read-only dereference-referent
   compatibility for accumulation.
   Public concepts compose private declaration-identity-bound capabilities;
   public names are not compiler-recognized.

   Inline and trailing constraints affect validity only. They do not
   distinguish overload signatures, rank candidates, provide SFINAE, or select
   specializations. A generic constructor may declare inferred local type
   parameters and carry the same inline and trailing requirements. Its local
   parameters cover only its parameters, requirements, initializer list,
   defaults, and body; they are never explicit call arguments and do not
   escape to later class members. One final constructor-local type pack with
   its named by-value parameter pack is implemented through ordered owned
   argument staging, including exact final-field construction. This is not a
   pack of uint64_t generic values. Constructor-local `uint64_t` remains
   restricted to an inferred fixed-array extent.

   A trailing clause is semantically rejected on an operator
   or a virtual, pure, overriding, or interface method. Concept negation,
   general requires-expressions, arbitrary expression requirements,
   and concept, partial, or constraint-selected specialization are not
   implemented.

   A class or struct may follow its type parameters with immutable `uint64_t`
   value parameters, such as `class array<T, uint64_t N>`. Type and value
   parameters may have a trailing declaration-owned default suffix. A type
   default is a visible exact type (including void metadata) and may use earlier parameters. A
   value default and written value argument are closed `uint64_t` expressions
   over integer literals, earlier visible namespace `constexpr uint64_t`
   bindings with closed arithmetic initializers, and earlier or enclosing value
   parameters using parentheses and `+`, `-`, `*`, `/`, or `%`. Checked
   constant evaluation rejects overflow, underflow, division by zero, and
   modulo by zero. Value parameters
   participate in exact class type identity and may be used as fixed-array
   extents or nested generic arguments.
   Although an identifier in a generic argument is syntactically also a type,
   semantic analysis resolves it from the target declaration's parameter kind.
   Type parameters must precede value parameters.

   A function, non-polymorphic method, or constructor may use the narrower
   `uint64_t N` form when `N` is the complete extent of one by-value fixed-array
   parameter. A named fixed array supplies its exact extent and a contextual
   brace argument supplies its written element count. An ordinary function or
   non-polymorphic method call may instead write a generic suffix: every type
   argument first, then every written `uint64_t` value. Inference runs from
   ordinary call arguments before declaration defaults fill any still-unbound
   trailing parameters. Braces and ordinary callable-parameter default
   expressions do not synthesize or infer a generic argument.
   Constructor-local parameters appear after the constructor name and remain
   inference-only. Inferred and explicit values participate in concrete
   function or constructor instance identity. Generic packs cannot have or
   coexist with generic defaults. Other value types, unrestricted
   value-generic expressions, value packs, explicit/defaulted constructor-local
   values, and value-generic virtual/operator call surfaces are not
   implemented.

   A function or method
   may declare one final type pack with `Args...`, bound by one final named,
   immutable parameter pack such as `Args... args`. Concrete elements can be
   owned values or exact read-only/mutable references. The pack may be
   empty. `args...` is permitted only as the final argument of a call to another
   variadic function or method. This makes forwarding explicit without adding
   arbitrary expansion contexts, indexing, multiple packs,
   reference-pack declarators or C++
   forwarding-reference deduction. Concrete expansions also feed exact lambda
   and nominal call-operator signatures. Source-defined
   `std::vector::emplace_back` uses this bounded form: it constructs an element
   in place but does not promise C++ perfect forwarding, so copyable arguments
   may be copied on entry to the by-value pack.

   A function or method type pack may alternatively be bound by an explicit
   type-list expansion in a formal parameter type: Tag<R(Args...)>& deduces
   the exact signature tail, and Types<Args...>& deduces a nominal type list.
   Repeated patterns and explicitly supplied pack elements must agree. If a
   named value pack is also present, its deduced list must agree as well,
   including exact reference elements. Metadata-only packs add no runtime
   arguments. Decorated reference-pack declarators and overload ranking are
   not introduced; signature-pattern primaries have their separate syntax.

   Classes and structs may separately own one final type pack, without value
   parameters or defaults. A bare type-list expansion `Args...` may be the
   final signature parameter or the final argument feeding another class's
   final type pack. It cannot occupy a fixed slot, be decorated, or be used
   as storage. Empty all-pack applications admit `Types<>` and `Types<>()`.
   Methods, including operator() and interface/virtual methods, may bind the
   owner's pack with a final immutable by-value Args... args parameter. Call
   arguments must match the owner's prescribed list rather than deducing a
   new class signature. Method-local fixed generic parameters may coexist.
   Value-pack elements must be non-void object types or references, not bare
   signatures. Signature-first patterned primaries additionally decompose
   their public arguments as described above. Constructor owner packs and
   more general reference forwarding remain incomplete work.

   One additional expression may iterate that same named pack:
   `(function_call(fixed, args), ...)`. The pattern is exactly one ordinary
   free-function call, contains the bare pack name exactly
   once as its final argument, and has only named-place fixed arguments. The
   selected target is one non-overloaded generic `void` declaration whose
   final type parameter represents one pack element. Its corresponding value
   parameter is read-only; the fold cannot move from or mutably borrow an
   element. The target is selected symbolically, then every concrete pack
   element is rechecked as one exact specialization. An empty pack is a
   well-formed no-op. Binary/operator folds, member calls, overload selection
   per element, arbitrary fold patterns, multiple pack occurrences, and
   mutable or consuming element access are not implemented.

   Generic class and struct applications provide every non-defaulted argument,
   including at constructor calls; declaration defaults complete the suffix.
   Generic function arguments may be explicit
   or inferred exactly from call arguments. For a variadic call, explicit type
   arguments first bind every fixed generic parameter; any remaining explicit
   arguments bind the pack, otherwise each pack element is inferred in order.
   Repeated parameters must infer the same type. Inference does not use return
   context or implicit conversions. A symbolic pack may only forward into
   another final pack, so invalid generic bodies are rejected by GTI rather than
   deferred to generated C++.

   Fixed generic function, method, class, and constructor instances are
   rechecked in typed HIR after concrete substitution. Move-only arguments are
   therefore valid when the body transfers rather than copies them. A concrete
   parameter pack containing any move-only element is one owned unit: its first
   whole-pack expansion consumes it, and a later expansion is a use-after-move
   error. Copyable packs may be expanded more than once. Generic type arguments
   may be void metadata, but concrete object types and value-pack elements
   cannot be void. Pack indexing, partial pack movement, general
   iteration beyond the bounded call fold, and `auto`-driven generic deduction
   are not implemented.

   An exact class or struct specialization is instead written at package scope
   with a qualified primary and a complete concrete argument list, such as
   `class std::hash<Widget> { ... };`. It declares no generic parameters and
   supplies a complete body. Semantic analysis canonicalizes aliases and value
   arguments, selects the specialization independently of source order, and
   applies the package-coherence rule. Interfaces, unions, partial patterns,
   symbolic arguments, forward specializations, and constraint-based
   specialization selection are not implemented. *)

(* `std::unique_ptr<T>` is a nominal standard-library class over the
   compiler-private `gti_internal::unique_owner<T>` capability.
   `std::make_unique<T>(arguments)` is an ordinary variadic stdlib function;
   typed HIR records and rechecks its concrete instance, including the nested
   allocation and constructor call. The compiler does not recognize the public
   factory name. Ownership transfer is explicit with
   `std::move(owner)`. Dereference uses `*owner`, and owned member access uses
   `owner->member`; both terminate with a stable runtime diagnostic when the
   owner is empty. The wrapper can be a local, function value, field,
   fixed-array element, non-escaping local reference, fixed generic type
   argument, or a once-forwarded variadic pack element. Unique-owner globals
   remain unavailable. An exact `nullptr_t` constructor permits target-typed
   `std::unique_ptr<T> owner = nullptr` initialization, while exact
   `operator=(nullptr_t)` and `reset()` empty an existing mutable owner. These
   rules do not add an implicit class conversion to call,
   constructor-argument, or return-value overload resolution. Explicit
   `std::upcast_unique<Base, Derived>(owner)` consumes a derived owner only
   when `Base` is a public polymorphic base with safe destruction; it does not
   add an implicit owner conversion to overload resolution. *)

(* `std::move(value)` is a compiler-defined explicit move operation for a named
   movable local value, by-value parameter, writable named field path rooted in
   one of those values or mutable `this`, or an in-range constant-index element
   of a directly owned fixed array. It consumes the exact place on every
   reachable path; any later overlapping read is an error until valid plain
   assignment reinitializes that place. Different constant elements remain
   disjoint, but a dynamic index may alias every element and is not movable. A
   non-consuming method must restore moved receiver state before returning;
   an explicitly consuming receiver has its separate transfer contract.
   References, globals,
   already-created lambda capture fields, temporaries, and dynamic indexed
   places are not movable through the current operation. A lambda capture
   initializer may use the separately defined
   `[name = std::move(local)]` form to move an enclosing local or by-value
   parameter into a new closure field. Moving a copyable value is valid but
   still consumes the source, avoiding C++'s observable unspecified
   moved-from state. *)

member-suffix          = ( "." | "->" ) IDENTIFIER ;

index-suffix           = "[" expression "]" ;

increment-suffix       = "++" | "--" ;

primary-expression     = literal
                       | numeric-conversion
                       | layout-query-expression
                       | member-requirement
                       | qualified-name
                       | lambda-expression
                       | generic-qualified-enumerator
                       | unexpected-expression
                       | "this"
                       | "nullptr"
                       | pack-fold-expression
                       | unsafe-expression
                       | "(" expression ")" ;

unsafe-expression      = "unsafe" "{" expression "}" ;

(* In expression position, a single operand has the ordinary grouping value,
   place, borrowing and full-expression rules plus lexical unsafe permission.
   No trailing semicolon, statements or local declarations occur inside it.
   At statement start, unsafe-statement retains its block grammar. Lambda
   bodies reset permission. See raw-pointers.md for the scope/cleanup contract. *)

pack-fold-expression   = "(" assignment-expression "," "..." ")" ;

generic-qualified-enumerator
                       = qualified-name generic-argument-clause
                         "::" IDENTIFIER ;

(* The assignment-expression in a pack fold is syntactically required to have
   a call as its root. The semantic restrictions above make this a bounded
   pack operation rather than the C++ fold-expression family. *)

lambda-expression      = lambda-capture-list parameter-clause "->" type block ;

lambda-capture-list    = "[" [ lambda-capture { "," lambda-capture } ] "]" ;

lambda-capture         = IDENTIFIER
                       | "&" IDENTIFIER
                       | "mut" "&" IDENTIFIER
                       | IDENTIFIER "=" "std" "::" "move"
                         "(" IDENTIFIER ")" ;

(* Lambda parameters and returns are explicit and calls use exact type
   matching. A bare listed capture is an immutable value snapshot of a
   copyable local binding. `[owned = std::move(source)]` is the only init
   capture: it moves one available movable local or by-value parameter into an
   immutable environment field and immediately leaves `source` moved.
   `[&name]` borrows a named addressable binding read-only; `[mut &name]`
   borrows it exclusively and makes invocation require a mutable receiver.
   Borrow dependencies survive concrete generic transport and field storage.
   Capture defaults, other init captures, implicit capture, `this`, and a
   trailing C++ `mutable` keyword are rejected. Lambda values are lexical.
   They may be copied into another local `auto` binding or passed to a direct
   by-value or checked-reference generic parameter whose visible body uses it as a confined
   callable. Calls may require exact `void`, exact `bool`, or an exact
   non-reference value without tracked borrowed state or lambda identity,
   supplied by an explicit initializer, assignment target, condition, or
   enclosing return type. A direct nested call used as an argument of another
   open callable can instead obtain its exact non-void result from concrete
   instantiation. A direct callable arm of an inferred conditional initializer
   can likewise defer its result to concrete instantiation, where the existing
   arm-compatibility rules apply; reference, borrowed-state and lambda results remain excluded.
   Concrete instantiation checks every invocation
   against the lambda or exact class `operator()` signature. A callable
   parameter declared without `mut` permits only repeatable read-callable
   invocation. `mut Operation operation` and `mut Operation& operation` permit repeatable mutable invocation
   and accepts either a read-callable target or a class target whose selected
   `operator()` is `mut`. Writing `std::move(operation)()` on a direct by-value
   generic parameter instead declares a confined once-callable use. It accepts
   an exact reusable read- or mut-callable target as well as a class target with
   an exact trailing-`&&` `operator()`, consumes the parameter place, and is
   rejected when any reachable path could use or invoke that place again. A
   callable parameter may pass through another direct by-value or checked-reference generic
   parameter only
   when that selected parameter has a visible, proven confined contract;
   semantics, HIR, and MIR retain the forwarding edge. Once invoked, a confined
   parameter cannot occur in the function's return type under that confined
   contract. Checked-reference parameters retain caller ownership and ordinary
   borrow access and exclusivity; they cannot be consumed or escape. General
   open callable result inference outside these contexts and unsupported borrowed results
   remain excluded. Separately, exact owned generic transport permits ordinary
   callable retention, returns, owned captures and fields; source-defined
   owning wrappers provide read/mut/once erasure. Those profiles preserve exact
   callable identity, movement and cleanup rather than escaping confinement
   implicitly. Globals remain unavailable for cleanup-owning callable state.
   See ownership-and-lifetimes.md and concepts.md for current boundaries. *)

unexpected-expression  = "unexpected" "(" assignment-expression ")" ;

numeric-conversion     = ( integer-type | "float" | "double" | "char" | "bool" )
                         "(" assignment-expression ")" ;
(* `bool(value)` and a numeric spelling applied to a class value call that
   class's conversion operator to the named type. *)

layout-query-expression
                       = layout-query-operator "(" type ")" ;

layout-query-operator  = "sizeof" | "alignof" ;

(* `sizeof(type)` and `alignof(type)` are reserved-word operators with one
   parenthesized type operand. Expression operands and unparenthesized forms
   are not grammar alternatives. Both produce an exact `uint64_t` frontend
   constant from the selected GTI target layout; `alignof` reports ABI
   alignment, not preferred alignment.

   The bounded operand set is an admitted scalar, recursive raw pointer,
   integral scoped enum, passive union, concrete `[[c_abi]]` record, transparent
   alias to an admitted type, or recursively supported fixed array with
   concrete positive extents. Pointer layout does not require a queryable
   pointee. Bare `void`, `nullptr_t`, references, ordinary classes/structs,
   interfaces, payload enums, expected values, compiler-private types, direct
   symbolic parameters, symbolic/zero extents and size overflow are rejected.
   The separate general `std::layout_of<T>()` library contract is not an
   expansion of these type-only operator operands.

   `layout-query-expression` is deliberately absent from
   `array-extent-expression`. A named non-negative `constexpr uint64_t`
   initialized by a query may be used as an extent through the existing
   IDENTIFIER form. *)

(* Numeric conversions use familiar functional-cast spelling but are GTI
   operations. Integer-to-integer and floating-to-integer conversions are checked
   before the native conversion is performed. Invalid dynamic values terminate
   with a GTI runtime error. Floating-to-integer conversion truncates toward
   zero; integer-to-floating conversion rounds to the selected binary32 or
   binary64 destination using round-to-nearest, ties-to-even. `double` to
   `float` requires this explicit conversion form. Integer literals outside
   the destination range are semantic
   errors. The separate lossless `char`/`uint8_t` code-unit pair is admitted;
   bool, string-view, class, expected, pointer and reference conversions are
   not provided by this numeric syntax. *)

(* `return value;` constructs the success state of an expected return type.
   `return unexpected(error);` constructs its error state. A bare `return;`
   constructs success only for `expected<void, E>`.
*)

literal                = INT_LITERAL
                       | FLOAT_LITERAL
                       | CHARACTER_LITERAL
                       | STRING_LITERAL
                       | "true"
                       | "false" ;

(* FLOAT_LITERAL is one or more decimal digits, `.`, and one or more decimal
   digits, optionally followed by `d` or `D`. Exponents, other suffixes,
   hexadecimal forms, leading/trailing-dot forms, infinity, and NaN spellings
   are not accepted. The complete decimal digits are rounded directly to
   IEEE-754 binary32 when unsuffixed or binary64 when suffixed, using
   round-to-nearest, ties-to-even. Finite-range overflow is a lexical error;
   underflow rounds to a subnormal value or positive zero. *)
